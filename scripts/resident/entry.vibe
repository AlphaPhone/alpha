// spec/agent/plugins/bundle.md, "A consumer entry ships only as a named package's code inside the source root, and passes the same load smoke as the generated entry"; spec/agent/plugins/bundle.md, "A host module is named only for a bundled package that is not an agent module, and runs with its entry's services over the resident's platform layer"; spec/agent/plugins/profile.md, "A host service never takes an agent service's name"; spec/agent/host/process.md
import { runAgentCli, type AgentPlugin, type ModuleFactory } from "@elizaos/agent-host"
import { localInferenceModule, localInferencePluginName } from "@elizaos/plugin-local-inference"
import * as localInference from "@elizaos/plugin-local-inference"
import { AndroidInferenceEngine, androidInferenceLayer } from "@elizaos/os"
import * as assistant from "@elizaos/plugin-personal-assistant"
import * as calendar from "@elizaos/plugin-calendar"
import * as inbox from "@elizaos/plugin-inbox"
import * as notes from "@elizaos/plugin-notes"
import * as files from "@elizaos/plugin-files"
import * as workflow from "@elizaos/plugin-workflow"
import * as maps from "@elizaos/plugin-maps"
import * as browser from "@elizaos/plugin-browser"
import { inferenceSocket, namesAlphaView, residentServices, residentStateDirectory, savedPlaceFiles } from "./bridges.ts"

type PluginModule = { readonly default?: unknown; readonly plugin?: unknown }

function entry(packageName: string, module: PluginModule) {
  return { packageName, plugin: module.default ?? module.plugin }
}

/** Maps with Alpha's own views named, so a request for one of them is never routed as travel, and the assistant's saved places kept under the resident's state directory. */
const mapsWithHost: AgentPlugin = {
  ...maps.mapsPlugin,
  init: async (config, runtime) => {
    await maps.mapsPlugin.init?.(config, runtime)
    maps.registerMapsViews(runtime, namesAlphaView)
    maps.registerMapsSavedPlaces(runtime, savedPlaceFiles(residentStateDirectory))
  },
}

/** Local inference over the device engine the host services provide on the app process's inference socket. */
const localInferenceHosted: ModuleFactory<AndroidInferenceEngine> = effect (context) => {
  const engine = try AndroidInferenceEngine
  return try localInferenceModule(engine)(context)
}

/** Alpha's resident agent: the bundled plugins, the workflow device and native digest bridges, and local inference hosted over the device's own engine. */
runAgentCli({
  bundled: [
    entry("@elizaos/plugin-personal-assistant", assistant),
    entry("@elizaos/plugin-calendar", calendar),
    entry("@elizaos/plugin-inbox", inbox),
    entry("@elizaos/plugin-notes", notes),
    entry("@elizaos/plugin-files", files),
    entry("@elizaos/plugin-workflow", workflow),
    { packageName: "@elizaos/plugin-maps", plugin: mapsWithHost },
    entry("@elizaos/plugin-browser", browser),
    entry(localInferencePluginName, localInference),
  ],
  runtimeServices: residentServices,
  hostModules: new Map([[localInferencePluginName, localInferenceHosted]]),
  hostServices: () => androidInferenceLayer(inferenceSocket()),
})
