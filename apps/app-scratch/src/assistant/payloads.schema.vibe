// spec/assistant/conversation.md, "Story: Talk to my agent and approve what it proposes"; spec/assistant/reply.md, "A recognized tool block outside a fence becomes its card; inside a fence it stays code"; spec/assistant/emailCard.md, "Story: Send an email my agent drafted, from the chat"; spec/assistant/withdrawal.md, "Story: Give up on a request without it happening later"; spec/assistant/search.md, "Story: Find something I said in an earlier chat"; spec/assistant/context.md, "Story: Let my agent know where I am when I allow it"; spec/assistant/entry.md, "Story: Summon my assistant from anywhere on the phone"
import { ProposalWords, StoredProposal } from "../telephony/comms.schema.vibe"

/** A conversation as the resident lists it. */
export schema ConversationRow {
  readonly id: Schema.NonEmptyString
  readonly roomId: Schema.NonEmptyString
  readonly title?: string
  readonly updatedAt?: string
}

/** The resident's conversation list. */
export schema ConversationList { readonly conversations: readonly ConversationRow[] }

/** A created or forked conversation. */
export schema CreatedConversation { readonly conversation: ConversationRow }

/** One stored message of a conversation. */
export schema HistoryRow {
  readonly id: Schema.NonEmptyString
  readonly role: "user" | "assistant" | "system"
  readonly text: string
  readonly createdAt?: string
  readonly clientMessageId?: string
  readonly source?: string
}

/** A page of history, newest last. */
export schema HistoryPage { readonly messages: readonly HistoryRow[]; readonly hasMore?: boolean }

/** One search hit across the owner's conversations. */
export schema SearchHit {
  readonly id: Schema.NonEmptyString
  readonly conversationId: Schema.NonEmptyString
  readonly text: string
  readonly snippet?: string
  readonly createdAt?: string
}

/** A page of search hits. */
export schema SearchPage { readonly messages: readonly SearchHit[] }

/** What a device proposal asks the phone to do, as the agent's review routes give it. */
export schema ProposalPayload {
  readonly operation: Schema.Unknown
  readonly requestMessageId?: string
  readonly workflow?: Schema.Unknown
  readonly calendarAgendaSource?: Schema.Unknown
}

/** The execution of a claimed proposal: the agent's own attempt id, which every receipt and review names. */
export schema ProposalExecution { readonly attemptId: Schema.NonEmptyString }

/** A device proposal as the agent's `/api/client-devices/proposals` routes give it. */
export schema WireProposal {
  readonly id: Schema.NonEmptyString
  readonly digest: string
  readonly state: string
  readonly expiresAt: string
  readonly payload: ProposalPayload
  readonly execution?: ProposalExecution
}

/** The proposals of this device the agent lists. */
export schema PendingListing { readonly proposals: readonly WireProposal[] }

/** What a proposal route answers: the proposal as it now stands. */
export schema ProposalAnswer { readonly digest: string; readonly proposal: Schema.Unknown }

/** A proposal the claim committed: executing under the agent's attempt id. */
export schema ClaimedProposal { readonly state: "executing"; readonly execution: ProposalExecution }

/** The claim route's answer: the proposal now executing under the agent's attempt id. */
export schema ClaimAnswer { readonly digest: string; readonly proposal: ClaimedProposal }

/** A Browser open, read only for its address. */
export schema BrowserOpen { readonly type: "browser_navigate"; readonly url: string }

/** What Android says about an assist invocation it handed to the renderer. */
export schema AssistInvocation {
  readonly origin: "assist" | "listener" | "system" | "power" | "none"
  readonly cold?: boolean
}

/** What `Agent.takeInvocation` says of the assistant surface's own launch, consumed on read. */
export schema SurfaceLaunch {
  readonly assistant: boolean
  readonly invocation?: "assist" | "listener" | null
  readonly locked?: boolean
}

/** The location permission as `ElizaLocation.checkPermissions` reports it. */
export schema LocationPermission { readonly location: string }

/** The coordinates of one position fix. */
export schema Coordinates { readonly latitude: number; readonly longitude: number; readonly accuracy: number }

/** A position fix of `ElizaLocation.getCurrentPosition`. */
export schema PositionFix { readonly coords: Coordinates; readonly timestamp: number }

/** One file saved beside a sent message, its bytes as base64. */
export schema SavedFile { readonly id: string; readonly name: string; readonly mimeType: string; readonly data: string }

/** The chat attachments saved beside one sent message. */
export schema SavedAttachments { readonly requestText: string; readonly displayText?: string; readonly files: readonly SavedFile[] }

/** The open comms card kept on the phone: Telephony's card words, the one decoder of that record. */
export const OpenSuggestion = ProposalWords

/** The comms suggestion kept on the phone across a restart: Telephony's `alpha-proposal:v1` record, the one decoder of that record. */
export const StoredSuggestion = StoredProposal

/** A workflow run a reply announced in its `[WORKFLOW]` block. */
export schema WorkflowBlock { readonly workflowId: Schema.NonEmptyString; readonly runId: Schema.NonEmptyString; readonly title?: string }

/** The body of a reply's `[FORM]` block, which the transcript hides. */
export schema FormBlockBody { readonly id: string; readonly fields: readonly Schema.Unknown[] }

/** The email an agent action staged in its result data. */
export schema StagedEmail { readonly to?: string | readonly string[]; readonly subject?: string; readonly body: string }

/** The native agent bridge's answer to a plain request. */
export schema BridgeAnswer { readonly status: Schema.Int; readonly data?: Schema.Unknown }

/** The workflow step a device proposal is bound to, as the agent's proposal payload names it. */
export schema WorkflowStepBinding {
  readonly workflowId: Schema.NonEmptyString
  readonly versionId: Schema.NonEmptyString
  readonly runId: Schema.NonEmptyString
  readonly stepId: Schema.NonEmptyString
  readonly specDigest: string
}

/** The renderer binding of a view the agent prepared or a command it sent, as the view routes take it back. */
export schema ViewBinding {
  readonly clientId: Schema.NonEmptyString
  readonly requestId: Schema.NonEmptyString
  readonly viewId: Schema.NonEmptyString
  readonly viewType: "gui"
  readonly installationId: Schema.NonEmptyString
}

/** A view an agent action prepared for this renderer: the completed-action handoff of its result values. */
export schema ViewHandoff {
  readonly mode?: string
  readonly viewId: Schema.NonEmptyString
  readonly viewPath?: string
  readonly viewType?: string
  readonly label?: string
  readonly subview?: boolean
  readonly completedActionDelivered?: boolean
  readonly completedActionHandoffId?: string
  readonly navigationPrepared: true
  readonly navigationBinding: ViewBinding
}

/** The claim route's answer: the claim id that settles it. */
export schema ViewClaim { readonly claimId: Schema.NonEmptyString }

/** The result route's answer: whether the host took the result. */
export schema ViewResultAnswer { readonly accepted: boolean }

/** One agent command in a view, as the resident's `view-interact` feed gives it for this renderer. */
export schema ViewInteraction {
  readonly type: "view:interact"
  readonly viewType: "gui"
  readonly viewId: Schema.NonEmptyString
  readonly requestId: Schema.NonEmptyString
  readonly installationId: Schema.NonEmptyString
  readonly capability: string
  readonly params?: Schema.Unknown
}

/** The state of one email card as its shelf keeps it. */
export schema ShelvedCard {
  readonly state: "DraftEmail" | "SendingEmail" | "SentEmail" | "RejectedEmail" | "UncertainEmail" | "DeclinedEmail"
  readonly version: Schema.Int
  readonly dispatchedVersion: Schema.Int
  readonly dispatches: Schema.Int
  readonly account: boolean
  readonly recipients: boolean
  readonly body: boolean
  readonly typing: boolean
}

/** One email card kept on its conversation's shelf: its row id, the owner turn it answers, its fields as last shown and its card. */
export schema ShelvedEmail {
  readonly id: Schema.NonEmptyString
  readonly messageId: string
  readonly ownerTurn?: string
  readonly to: string
  readonly subject: string
  readonly text: string
  readonly card: ShelvedCard
}

/** A conversation's email shelf (`inbox-drafts:v1:chat:`). */
export schema EmailShelfRecord { readonly v: 1; readonly cards: readonly ShelvedEmail[] }
