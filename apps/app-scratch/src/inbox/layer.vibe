// spec/inbox/accounts.md, "Story: Choose which Gmail account my Inbox shows"; spec/inbox/drafts.md, "Story: Keep the drafts I wrote before this version"; spec/inbox/operations.md, "Story: Change or send from my mailbox once, as I reviewed it"; spec/platform/storage.md, "A stored value that is not a state is held for review and never written over"
import { machine as accountsMachine } from "../../gen/inbox__accounts.effect.vibe"
import { machine as mailboxMachine } from "../../gen/inbox__mailbox.effect.vibe"
import { machine as readerMachine } from "../../gen/inbox__reader.effect.vibe"
import { machine as selectionMachine } from "../../gen/inbox__selection.effect.vibe"
import { machine as suggestionsMachine } from "../../gen/inbox__suggestions.effect.vibe"
import { machine as noticesMachine } from "../../gen/inbox__notices.effect.vibe"
import { decodeState as decodeDrafts, machine as draftsMachine, stored as storedDrafts } from "../../gen/inbox__drafts.effect.vibe"
import { decodeState as decodeJournal, machine as journalMachine, stored as storedJournal } from "../../gen/inbox__operations.effect.vibe"
import { storedOrHeld } from "../platform/device-storage.vibe"
import { keys, mailHeld, mailStore } from "./store.vibe"
import { layer as gmail } from "./gmail.vibe"
import { layer as saved } from "./saved.vibe"
import { layer as accounts } from "./accounts.vibe"
import { layer as reader } from "./reader.vibe"
import { layer as mailbox } from "./mailbox.vibe"
import { layer as operations } from "./operations.vibe"
import { layer as composer } from "./composer.vibe"
import { layer as selection } from "./selection.vibe"
import { layer as notices } from "./notices.vibe"
import { mailSenderFill } from "./handoffs.vibe"
import { layer as suggestions } from "./suggestions.vibe"
import { previousDrafts } from "./previous.vibe"

export { Gmail } from "./gmail.vibe"
export { SavedMail } from "./saved.vibe"
export { InboxAccounts } from "./accounts.vibe"
export { Reader } from "./reader.vibe"
export { Mailbox } from "./mailbox.vibe"
export { MailOperations } from "./operations.vibe"
export { MailComposer } from "./composer.vibe"
export { MailSelection } from "./selection.vibe"
export { MailNoticesShell } from "./notices.vibe"
export { MailSuggestions } from "./suggestions.vibe"
export { emailShareTarget } from "./shareTarget.vibe"
export { assistantEmail, assistantEmailSender, cameraEmailTarget, mailSenderFill } from "./handoffs.vibe"
export { inboxBack } from "./back.vibe"
export { inboxCapabilities } from "./handoffs.vibe"
export { keepPreviousDrafts } from "./previous.vibe"
export type { ComposerBack } from "./composer.vibe"

/** The drafts and operation journal kept in the phone's mail store, each held for review and started fresh where what is kept is not a state. */
export const mailMachines = Layer.provide(
  Layer.mergeAll(
    storedOrHeld(keys.drafts, decodeDrafts, storedDrafts(keys.drafts), draftsMachine()),
    storedOrHeld(keys.operations, decodeJournal, storedJournal(keys.operations), journalMachine()),
  ),
  Layer.provideMerge(mailHeld, mailStore),
)

/** The Inbox's machines: memory for what is read, the phone's mail store for drafts and operations. */
export const machines = Layer.mergeAll(
  accountsMachine(), mailboxMachine(), readerMachine(), selectionMachine(), suggestionsMachine(), noticesMachine(), mailMachines,
)

/**
 * Every Inbox service, over the platform's Native, Resident, Cloud, Build and KeyValueStore, the account area's
 * CloudSession and GoogleAccounts, the shell's Navigation, Overview and ShellMail (which the layer fills with Inbox's send of chat-reviewed email), the assistant's Assistant, the browser's BrowserAgent, files' FilePicker and settings' Preferences; it also brings the previous version's drafts into each account's Drafts.
 */
export const layer = Layer.provideMerge(
  Layer.mergeAll(selection, notices, suggestions, mailSenderFill, previousDrafts),
  Layer.provideMerge(composer,
    Layer.provideMerge(operations,
      Layer.provideMerge(mailbox,
        Layer.provideMerge(reader,
          Layer.provideMerge(accounts,
            Layer.provideMerge(Layer.mergeAll(gmail, saved), machines))))))
)
