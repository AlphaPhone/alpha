// spec/browser/session.md, "Story: Keep my place with the Browser's layers and Back"; spec/browser/reviews.md, "Back denies the newest open review first, and is Browser's to pass on only when no review is open"; spec/browser/reading.md, "Back closes the excerpt review the owner sees: Ask about page is closed, and a local reading is stopped"
import { assert, it } from "@effect/vitest"
import { BrowserReading } from "../../src/browser/reading.vibe"
import { BrowserReviews } from "../../src/browser/reviews.vibe"
import { BrowserTabs } from "../../src/browser/session.vibe"
import { fakeHost, loadPage, sessionOf, settledTabs } from "./fakes.vibe"

// spec/browser/reviews.md, "Back denies the newest open review first, and is Browser's to pass on only when no review is open"
it.live("Back denies the newest confirmation, then closes the excerpt review, then Browser's layers, and is the shell's after that", () => effect {
  const fake = try fakeHost({ answers: { readingSupport: () => ({ available: true }), reviewQuestion: () => ({ text: "Bread needs flour, water, salt and time." }) } })
  try scoped(effect {
    provide fake.live {
      const tabs = try BrowserTabs
      const reviews = try BrowserReviews
      const reading = try BrowserReading
      try settledTabs(tabs)
      try loadPage(tabs, fake.events, try sessionOf(fake.calls), "https://example.test/bread", "2", 1)
      try timeout(Stream.runHead(Stream.filter(reading.changes, (r) => r.support !== "SupportUnknown")), "2 seconds")

      const older = fork reviews.confirm("browser-clear-site", "ClearSiteData", "example.test")
      try timeout(Stream.runHead(Stream.filter(reviews.changes, (r) => r.open.length === 1)), "1 second")
      const newer = fork reviews.confirm("browser-clear-data", "ClearBrowsingData", "history, cookies and tabs")
      try timeout(Stream.runHead(Stream.filter(reviews.changes, (r) => r.open.length === 2)), "1 second")
      const firstBack = try reviews.back()
      const newest = try join newer
      const secondBack = try reviews.back()
      const oldest = try join older
      const noReview = try reviews.back()

      try reading.askAboutPage()
      try timeout(Stream.runHead(Stream.filter(reading.changes, (r) => r.phase === "Reviewing")), "1 second")
      const readingBack = try reading.back()
      const afterReading = Option.map(try timeout(Stream.runHead(Stream.filter(reading.changes, (r) => r.phase === "NotReading")), "1 second"), (r) => r.phase)
      const noReading = try reading.back()

      try tabs.dispatch({ type: "toggleMenu" })
      const menuBack = try tabs.back()
      const shellBack = try tabs.back()
      try Effect.try(() => assert.deepStrictEqual(
        { firstBack, newest, secondBack, oldest, noReview, readingBack, afterReading, noReading, menuBack, shellBack, drafts: (try Ref.get(fake.drafts)).length },
        { firstBack: true, newest: false, secondBack: true, oldest: false, noReview: false, readingBack: true, afterReading: Option.some("NotReading"), noReading: false, menuBack: true, shellBack: false, drafts: 0 },
      ))
    }
  })
})
