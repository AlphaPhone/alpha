// spec/cloud/registration.md, "Story: Admit only Alpha Phone, signed by Alpha's release certificate"
import type { CloudEnvironment, CloudProfile } from "@elizaos/cloud/profile"
import { credentialTtlDays, registeredSigners, registrationProblems } from "../gen/cloud__registration.effect.vibe"
import data from "../deployment.json" with { type: "json" }

/** One client entry of an `elizaos-cloud serve --seed` document. */
export interface SeedClient {
  readonly clientId: string
  readonly displayName: string
  readonly androidPackage: string
  readonly certFingerprints: ReadonlyArray<string>
  readonly signInReturn: string
  readonly billingReturn: string
  readonly connectReturn: string
  readonly nativeGoogle: boolean
}

/** Alpha's release certificate, and the previous one an approved rotation keeps registered. */
export interface ReleaseSigner {
  readonly signerSha256: string
  readonly apkSigningRotation?: { readonly approval?: string; readonly previousSignerSha256?: string }
}

/** A certificate is not 64 lower-case hex characters, or the registration would break the registry's rules. */
export error RegistrationInvalid { problem: string }

/** Alpha's release certificate, as `apps/cloud/deployment.json` records it. */
export const releaseSigner: ReleaseSigner = data.releaseSigner

const dayMs = 24 * 60 * 60 * 1000

/** `AB:CD:…`, as App Links and eliza's registry write a certificate, from 64 lower-case hex characters. */
export effect function colonFingerprint(hex: string): string!RegistrationInvalid {
  if (!/^[0-9a-f]{64}$/.test(hex)) throw new RegistrationInvalid({ problem: "certificate fingerprints must be 64 lower-case hex characters" })
  return hex.toUpperCase().replace(/(..)(?=.)/g, "$1:")
}

/** The certificates registered for a release signer: its own, and the previous one while an approved rotation keeps it. */
export effect function releaseFingerprints(signer: ReleaseSigner): ReadonlyArray<string>!RegistrationInvalid {
  const rotation = signer.apkSigningRotation
  const listed = registeredSigners({ release: signer.signerSha256, previous: rotation?.previousSignerSha256 ?? "", rotationApproved: rotation?.approval === "approved" })
  const result: string[] = []
  for (const value of listed) result.push(try colonFingerprint(value))
  return result
}

function returnProblem(url: string, api: string): "malformed" | "onApi" | undefined {
  const parsed = URL.parse(url)
  if (parsed === null || parsed.protocol !== "https:" || parsed.search || parsed.hash || parsed.username || parsed.password || parsed.port || parsed.origin + parsed.pathname !== url) return "malformed"
  return parsed.origin === api ? "onApi" : undefined
}

/** What eliza's registry would refuse of a registration on an environment whose API origin is `api`. */
export function problemsOf(client: SeedClient, api: string) {
  const returns = [client.signInReturn, client.billingReturn, client.connectReturn]
  const found = returns.map((url) => returnProblem(url, api))
  return registrationProblems(
    new Set(returns).size === returns.length,
    found.filter((problem) => problem === "onApi").length,
    found.filter((problem) => problem === "malformed").length,
    client.certFingerprints.length,
    new Set(client.certFingerprints).size === client.certFingerprints.length,
    client.certFingerprints.filter((fingerprint) => !/^(?:[0-9A-F]{2}:){31}[0-9A-F]{2}$/.test(fingerprint)).length,
    /^[a-zA-Z_]\w*(?:\.[a-zA-Z_]\w*)+$/.test(client.androidPackage),
  )
}

/** Alpha Phone's registration on one environment of the profile, refused where eliza's registry would refuse it. */
export effect function environmentRegistration(profile: CloudProfile, environment: CloudEnvironment, signer: ReleaseSigner = releaseSigner): SeedClient!RegistrationInvalid {
  const settings = profile.environments[environment]
  const client: SeedClient = {
    ...data.client,
    certFingerprints: try releaseFingerprints(signer),
    signInReturn: settings.web + data.returns.signIn,
    billingReturn: settings.web + data.returns.billing,
    connectReturn: settings.web + data.returns.connect,
    nativeGoogle: settings.google?.nativeSignIn ?? false,
  }
  const problems = problemsOf(client, settings.api)
  if (problems.length > 0) throw new RegistrationInvalid({ problem: problems.join(", ") })
  return client
}

/** The `--seed` document `elizaos-cloud serve` accepts for a staging Cloud. */
export function seedDocument(client: SeedClient): { readonly clients: ReadonlyArray<SeedClient> } {
  return { clients: [client] }
}

/** The NATIVE_CLIENT_REGISTRY value the Worker of one environment reads, as JSON. */
export function registryVariable(client: SeedClient, environment: CloudEnvironment): string {
  return JSON.stringify([{ ...client, environment, credentialTtlMs: credentialTtlDays * dayMs, enabled: true }])
}

/** The reviewed registration file `elizaos-cloud client apply --file` applies to one environment's database. */
export function registrationFile(client: SeedClient, environment: CloudEnvironment) {
  return { environment, clients: [{ ...client, credentialTtlDays }] }
}
