// spec/cloud/rollout.md, "Story: Tell whether a deployed environment is ready"; spec/cloud/rollout.md, "Alpha's own cloud is ready only when each public gate passes: the provisioning smoke reads, then the entitlement keys, Alpha's sign-in configuration, the plans and the sign-in return page on the App Link host"
import type { CloudEnvironment } from "@elizaos/cloud/profile"
import { alphaPackage, assetLinksNameAlpha, type Environment } from "../gen/cloud.effect.vibe"
import { smokeGates, type Gate } from "../gen/cloud__rollout.effect.vibe"
import { entryOf, registrationAt, statementsIn } from "./alpha.vibe"
import { jsonOf } from "./json.ts"
import { publicP256 } from "./keys.ts"

/** One gate's outcome: passed, or why not. */
export interface GateResult {
  readonly gate: Gate
  readonly passed: boolean
  readonly detail: string
}

/** Where an environment of Alpha's own cloud answers: its API origin and its App Link host's origin. */
export interface Origins {
  readonly api: string
  readonly web: string
}

interface Answer { readonly status: number; readonly type: string; readonly text: string }

effect function fetched(url: string): (Answer | string)!!HttpClient.HttpClient {
  return try effect {
    const response = try timeout(Effect.provideService(HttpClient.execute(HttpClientRequest.setHeader(HttpClientRequest.get(url), "cache-control", "no-cache")), FetchHttpClient.RequestInit, { redirect: "manual" }), "15 seconds")
    return { status: response.status, type: response.headers["content-type"] ?? "", text: try response.text }
  } catch (failure) => `unreachable (${failure._tag})`
}

function parsed(text: string): Record<string, unknown> {
  const value = jsonOf(text)
  return value !== null && typeof value === "object" && !Array.isArray(value) ? value as Record<string, unknown> : {}
}

const complete = (document: unknown) => {
  const found = parsed(JSON.stringify(document ?? null))
  return typeof found.title === "string" && typeof found.revision === "string" && Array.isArray(found.sections) && found.sections.length > 0
}

effect function assetLinksFit(text: string, environment: Environment) {
  const statements = statementsIn(jsonOf(text)) catch () => []
  return assetLinksNameAlpha(statements, environment)
}

/** The problem with what a gate's address answered, or undefined when it passes. */
effect function judged(gate: Gate, answer: Answer, at: { readonly name: string; readonly environment: Environment; readonly signInReturn: string }) {
  const body = parsed(answer.text)
  switch (gate) {
    case "ApiHealth": return body.status === "ok" ? undefined : "expected the health answer"
    case "ServiceDocument": {
      const service = parsed(JSON.stringify(body.service ?? null))
      return service.name === at.name && complete(service.terms) && complete(service.privacy) ? undefined : `expected ${at.name}'s Terms and Privacy`
    }
    case "SignInMethods": return body.email === true ? undefined : "the emailed code is not offered"
    case "AssetLinks": {
      if (!/^application\/json\b/i.test(answer.type)) return "not application/json"
      return (try assetLinksFit(answer.text, at.environment)) ? undefined : `${alphaPackage} is not named with this environment's signers alone`
    }
    case "EntitlementKeys": return Array.isArray(body.keys) && body.keys.length > 0 && body.keys.every(publicP256) ? undefined : "expected a nonempty set of public P-256 entitlement keys"
    case "SignInConfiguration": return body.clientId === alphaPackage && body.redirectUri === at.signInReturn && body.codeChallengeMethod === "S256" ? undefined : "expected Alpha's client, its return and S256"
    case "Plans": return Array.isArray(body.plans) && ["plus_monthly", "pro_monthly"].every((key) => (body.plans as ReadonlyArray<unknown>).some((plan) => parsed(JSON.stringify(plan)).key === key)) ? undefined : "expected the Plus and Pro plans"
    case "ReturnPage": {
      const signIn = new URL(at.signInReturn)
      const intent = `intent://${signIn.host}${signIn.pathname}#Intent;scheme=https;package=${alphaPackage};end`
      return /^text\/html\b/i.test(answer.type) && answer.text.includes(`href="${intent}"`) ? undefined : "expected the page that returns to Alpha"
    }
  }
}

function addressOf(gate: Gate, origins: Origins, environment: CloudEnvironment, signInReturn: string): string {
  switch (gate) {
    case "ApiHealth": return `${origins.api}/api/health`
    case "ServiceDocument": return `${origins.api}/api/public/service`
    case "SignInMethods": return `${origins.api}/api/v1/auth/methods`
    case "AssetLinks": return `${origins.web}/.well-known/assetlinks.json`
    case "EntitlementKeys": return `${origins.api}/api/v1/subscription/entitlement-keys`
    case "SignInConfiguration": return `${origins.api}/api/v1/app-auth/mobile/config?${new URLSearchParams({ clientId: alphaPackage, environment, redirectUri: signInReturn })}`
    case "Plans": return `${origins.api}/api/v1/subscriptions/plans`
    case "ReturnPage": return signInReturn
  }
}

/** Each public gate of a deployed environment, in the spec's order, read without a credential. */
export effect function smoke(environment: CloudEnvironment, origins: Origins, name: string) {
  const which: Environment = environment === "production" ? "Production" : "Staging"
  const signInReturn = entryOf(registrationAt(which, new URL(origins.web).host)).signInReturn
  const results: GateResult[] = []
  for (const gate of smokeGates) {
    const answer = try fetched(addressOf(gate, origins, environment, signInReturn))
    const problem = typeof answer === "string" ? answer : answer.status !== 200 ? `HTTP ${answer.status}` : try judged(gate, answer, { name, environment: which, signInReturn })
    results.push({ gate, passed: problem === undefined, detail: problem ?? "HTTP 200" })
  }
  return results
}
