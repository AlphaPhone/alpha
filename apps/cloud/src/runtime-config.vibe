// spec/cloud/index.md, "Story: Launch the resident agent on the deployment's own Cloud"
import { decodeLaunchDocument, type LaunchDocument } from "@elizaos/agent/launch"
import type { CloudEnvironment } from "@elizaos/cloud/profile"
import { alphaModel, launchFits } from "../gen/cloud.effect.vibe"
import { cloudEnvironments, type Table } from "./profile.vibe"

/** The resident agent's launch would use another Cloud, another model, a credential in its document or remote embeddings. */
export error RuntimeConfigInvalid { environment: string; api: string }

/** The resident agent's cloud model backend on the Cloud whose API origin is `api`, with Alpha's model. */
export function cloudModel(api: string): Extract<LaunchDocument["model"], { readonly backend: "cloud" }> {
  return { backend: "cloud", cloudBaseUrl: api, smallModel: alphaModel, largeModel: alphaModel, imageModel: alphaModel }
}

const syntheticAccount = { userId: "11111111-1111-4111-8111-111111111111", organizationId: "22222222-2222-4222-8222-222222222222" }

/** A launch document of the agent on the Cloud at `api`: cloud backend, local embeddings, no credential. */
export function cloudLaunchDocument(api: string): string {
  return JSON.stringify({
    schema: 1,
    character: { name: "Alpha", system: "Cloud runtime configuration check." },
    policy: { actions: { allowed: ["REPLY"] }, plugins: { load: [] } },
    model: cloudModel(api),
    account: syntheticAccount,
    embeddings: "local",
    embeddingDimensions: 384,
    callerRole: "owner",
  })
}

/** One launch the check accepted: the environment, the Cloud it reaches, its models and where embeddings run. */
export interface RuntimeConfigReport {
  readonly environment: CloudEnvironment
  readonly cloudBaseUrl: string
  readonly model: string
  readonly embeddings: string
}

effect function checked(environment: CloudEnvironment, api: string): RuntimeConfigReport!RuntimeConfigInvalid {
  const text = cloudLaunchDocument(api)
  const launch = decodeLaunchDocument(text) catch effect () => { throw new RuntimeConfigInvalid({ environment, api }) }
  const cloud = launch.model.backend === "cloud" ? launch.model : undefined
  const fits = launchFits({
    cloudBackend: cloud !== undefined,
    onApiOrigin: cloud?.cloudBaseUrl === api && URL.parse(api)?.origin === api && api.startsWith("https://"),
    smallModel: cloud?.smallModel ?? "",
    largeModel: cloud?.largeModel ?? "",
    localEmbeddings: launch.embeddings === "local",
    carriesCredential: /apiKey|credential|token/i.test(text),
  })
  if (!fits || cloud === undefined) throw new RuntimeConfigInvalid({ environment, api })
  return { environment, cloudBaseUrl: cloud.cloudBaseUrl, model: cloud.largeModel, embeddings: launch.embeddings }
}

/** Decodes, as the agent does, each environment's launch on the Cloud its phones address and on its cutover candidate. */
export effect function checkRuntimeConfig(table: Table): ReadonlyArray<RuntimeConfigReport>!RuntimeConfigInvalid {
  const reports: RuntimeConfigReport[] = []
  for (const environment of cloudEnvironments) {
    for (const api of new Set([table[environment].addressed.api, table[environment].candidate.api])) reports.push(try checked(environment, api))
  }
  return reports
}
