// spec/cloud/index.md, "Story: Serve one reviewed profile"; spec/cloud/index.md, "Story: Move phones to Alpha Cloud only when the owner takes the cutover"
import { parseProfile, type CloudEnvironment, type CloudProfile, type EnvironmentProfile, type ProfileInvalid } from "@elizaos/cloud/profile"
import { deployment } from "@repo/deployment"
import { alphaAudience, alphaCapabilities, alphaCloudName, alphaModel, alphaModelMaxOutputTokens, candidatesApart, cutover, type Cutover, type Hosts, type Row } from "../gen/cloud.effect.vibe"
import data from "../deployment.json" with { type: "json" }

/** The two environments every deployment has. */
export const cloudEnvironments: ReadonlyArray<CloudEnvironment> = ["production", "staging"]

/** The environment variable each provider secret is read from; the profile names them and never holds one. */
export const secretNames = {
  digest: "CLOUD_DIGEST_KEY",
  sealing: "CLOUD_SEALING_KEY",
  entitlement: "CLOUD_ENTITLEMENT_KEY",
  mail: "RESEND_API_KEY",
  google: "GOOGLE_CLIENT_SECRET",
  stripe: "STRIPE_SECRET_KEY",
  stripeWebhook: "STRIPE_WEBHOOK_SECRET",
  inference: "CEREBRAS_API_KEY",
  speech: "CARTESIA_API_KEY",
  maps: "GOOGLE_MAPS_API_KEY",
} as const

const Paragraphs = Schema.NonEmptyArray(Schema.String)
const LegalDocument = Schema.Struct({ title: Schema.String, revision: Schema.String, sections: Schema.NonEmptyArray(Schema.Struct({ title: Schema.String, paragraphs: Paragraphs })) })
const PublicKey = Schema.Struct({ kid: Schema.String, kty: Schema.Literal("EC"), crv: Schema.Literal("P-256"), x: Schema.String, y: Schema.String })
const PlanIds = Schema.Struct({ priceId: Schema.String, productId: Schema.String })
const EnvironmentInputs = Schema.Struct({
  databaseIdentity: Schema.String,
  documents: Schema.Struct({ terms: LegalDocument, privacy: LegalDocument }),
  entitlement: Schema.Struct({ keyId: Schema.String, publicKeys: Schema.NonEmptyArray(PublicKey) }),
  google: Schema.Struct({ clientId: Schema.String, serverClientId: Schema.String, nativeSignIn: Schema.Boolean }),
  billing: Schema.Struct({ publishableKey: Schema.String, plans: Schema.Struct({ plus_monthly: PlanIds, pro_monthly: PlanIds }) }),
  speech: Schema.Struct({
    defaultVoiceId: Schema.String, defaultModelId: Schema.String, voiceIds: Schema.NonEmptyArray(Schema.String), modelIds: Schema.NonEmptyArray(Schema.String),
    microsPerCharacter: Schema.Int, microsPerSecond: Schema.Int, languageCodes: Schema.Array(Schema.String),
  }),
  maps: Schema.Struct({ coverage: Schema.String, datasetRevision: Schema.String }),
  worker: Schema.optionalKey(Schema.Struct({
    plan: Schema.Literals(["plus_monthly", "pro_monthly"]),
    embeddingModel: Schema.String, embeddingUpstreamModel: Schema.String,
    chatInputMicrosPer1k: Schema.Int, chatOutputMicrosPer1k: Schema.Int, embeddingInputMicrosPer1k: Schema.Int,
    maxCompletionTokens: Schema.Int, speechDailySessionLimit: Schema.Int,
  })),
})

/** The reviewed public values an operator records per environment: database receipt, documents, public keys and provider ids. */
export const OperatorInputs = Schema.Struct({ schema: Schema.Literal(1), production: EnvironmentInputs, staging: EnvironmentInputs })
/** The decoded operator inputs. */
export type OperatorInputs = typeof OperatorInputs.Type
/** One environment's operator inputs. */
export type EnvironmentInputs = typeof EnvironmentInputs.Type

/** The operator inputs file is missing, unreadable or not the recorded shape. */
export error OperatorInputsInvalid { problem: string }
/** `packages/deployment` holds no hosted row for an environment, or a table the cutover rules refuse. */
export error DeploymentInvalid { problem: string }

/** What each environment's phone addresses, and Alpha Cloud's own hosts: both from `packages/deployment`. */
export interface Table {
  readonly production: Row
  readonly staging: Row
  readonly cutover: Cutover
}

effect function rowOf(environment: CloudEnvironment): Row!DeploymentInvalid {
  const row = deployment(environment) catch effect (failure) => { throw new DeploymentInvalid({ problem: failure._tag }) }
  if (row.kind !== "hosted") throw new DeploymentInvalid({ problem: `${environment} is not a hosted deployment` })
  return {
    addressed: { api: row.cloud, web: `https://${row.appLinkHost}` },
    candidate: { api: row.cutoverCandidate.cloud, web: `https://${row.cutoverCandidate.appLinkHost}` },
  }
}

/** The deployment table, refused when its environments are split across the cutover or Alpha Cloud's two share an origin. */
export effect function deploymentTable(): Table!DeploymentInvalid {
  const production = try rowOf("production")
  const staging = try rowOf("staging")
  const state = cutover(production, staging)
  if (state === "Split") throw new DeploymentInvalid({ problem: "the cutover is taken in one environment and not the other" })
  if (!candidatesApart(production, staging)) throw new DeploymentInvalid({ problem: "Alpha Cloud's production and staging share an origin" })
  return { production, staging, cutover: state }
}

/** Alpha Cloud's own hosts per environment: each environment's cutover candidate. */
export function alphaHosts(table: Table): Readonly<Record<CloudEnvironment, Hosts>> {
  return { production: table.production.candidate, staging: table.staging.candidate }
}

function environmentProfile(environment: CloudEnvironment, hosts: Hosts, inputs: EnvironmentInputs): EnvironmentProfile {
  return {
    name: alphaCloudName,
    api: hosts.api,
    web: hosts.web,
    entitlementAudience: alphaAudience,
    mailSender: data.mailSender,
    databaseIdentity: inputs.databaseIdentity,
    firstPartyOrigins: [hosts.web],
    capabilities: alphaCapabilities as EnvironmentProfile["capabilities"],
    documents: inputs.documents,
    signIn: { smsCountries: [], smsHourlyBudget: 0 },
    mail: { kind: "https", url: "https://api.resend.com/emails", apiKeyEnv: secretNames.mail },
    sms: { kind: "none" },
    digestKeyEnv: secretNames.digest,
    sealing: { currentKeyId: `alpha-${environment}-seal-1`, keys: [{ keyId: `alpha-${environment}-seal-1`, env: secretNames.sealing }] },
    entitlement: { keyId: inputs.entitlement.keyId, signingKeyEnv: secretNames.entitlement, publicKeys: inputs.entitlement.publicKeys },
    google: {
      clientId: inputs.google.clientId,
      serverClientId: inputs.google.serverClientId,
      clientSecretEnv: secretNames.google,
      nativeSignIn: inputs.google.nativeSignIn,
      accountsUrl: "https://accounts.google.com/o/oauth2/v2/auth",
      tokenUrl: "https://oauth2.googleapis.com/token",
      revokeUrl: "https://oauth2.googleapis.com/revoke",
      jwksUrl: "https://www.googleapis.com/oauth2/v3/certs",
      apiUrl: "https://www.googleapis.com",
      issuers: ["https://accounts.google.com", "accounts.google.com"],
    },
    billing: {
      apiUrl: "https://api.stripe.com",
      secretKeyEnv: secretNames.stripe,
      webhookSecretEnv: secretNames.stripeWebhook,
      publishableKey: inputs.billing.publishableKey,
      plans: inputs.billing.plans,
    },
    inference: {
      providers: [{ id: "cerebras", baseUrl: "https://api.cerebras.ai/v1", apiKeyEnv: secretNames.inference }],
      models: [{ id: alphaModel, provider: "cerebras", upstreamModel: alphaModel, vision: false, defaultMaxTokens: alphaModelMaxOutputTokens }],
    },
    speech: {
      provider: "cartesia",
      baseUrl: "https://api.cartesia.ai",
      realtimeUrl: "wss://api.cartesia.ai/stt/websocket",
      apiKeyEnv: secretNames.speech,
      tts: {
        defaultVoiceId: inputs.speech.defaultVoiceId,
        defaultModelId: inputs.speech.defaultModelId,
        voiceIds: inputs.speech.voiceIds,
        modelIds: inputs.speech.modelIds,
        microsPerCharacter: inputs.speech.microsPerCharacter,
      },
      stt: { languageCodes: inputs.speech.languageCodes, microsPerSecond: inputs.speech.microsPerSecond },
    },
    maps: { provider: "google", baseUrl: "https://maps.googleapis.com", apiKeyEnv: secretNames.maps, coverage: inputs.maps.coverage, datasetRevision: inputs.maps.datasetRevision },
  }
}

/** Alpha Cloud's whole profile for the operator's reviewed inputs on Alpha Cloud's hosts, before eliza's deployment rules judge it. */
export function alphaCloudProfile(inputs: OperatorInputs, hosts: Readonly<Record<CloudEnvironment, Hosts>>): CloudProfile {
  return {
    version: 1,
    name: alphaCloudName,
    environments: {
      production: environmentProfile("production", hosts.production, inputs.production),
      staging: environmentProfile("staging", hosts.staging, inputs.staging),
    },
  }
}

/** Decodes the operator inputs, refusing any field the shape does not name. */
export effect function operatorInputs(input: unknown): OperatorInputs!OperatorInputsInvalid {
  return Schema.decodeUnknownEffect(OperatorInputs, { onExcessProperty: "error" })(input) catch effect (failure) => {
    throw new OperatorInputsInvalid({ problem: failure.message })
  }
}

/** The profile for the operator's inputs, only when eliza's deployment rules accept it. */
export effect function alphaProfile(input: unknown, hosts: Readonly<Record<CloudEnvironment, Hosts>>): CloudProfile!(OperatorInputsInvalid | ProfileInvalid) {
  return try parseProfile(alphaCloudProfile(try operatorInputs(input), hosts))
}
