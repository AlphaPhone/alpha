// spec/cloud/rollout.md, "Story: Render a deployment only when it is provisioned"; spec/cloud/rollout.md, "The API Worker's bindings repeat its profile's origins and database, and its registry is Alpha's registration of that environment"
import type { CloudEnvironment, CloudProfile } from "@elizaos/cloud"
import type { Registration } from "../gen/cloud.effect.vibe"
import { renderAccepted, renderProblems, type ResourceId } from "../gen/cloud__rollout.effect.vibe"
import { entryOf } from "./alpha.vibe"
import { sha256Hex } from "./digest.ts"

/** `apps/cloud/resources.json`: one environment's Cloudflare account, zone, Worker name and database binding. */
export interface CloudResources {
  readonly workerName: string
  readonly accountId: string
  readonly zone: string
  readonly hyperdriveId: string
}

/** A resource id is unprovisioned, a host lies outside the zone, or a host of the shipped Eliza Cloud leaked in. */
export error RenderRefused { problem: string }

const elizaHost = /(?:^|[^a-z0-9-])((?:[a-z0-9-]+\.)*(?:eliza\.app|elizacloud\.ai))(?![a-z0-9.-])/i

/** The first host of the shipped Eliza Cloud the text names, if any. */
export function leakedElizaHost(text: string): string | undefined {
  return elizaHost.exec(text)?.[1]
}

/** Whether a Cloudflare id was provisioned: 32 lower-case hex characters that are not a placeholder of zeros and two digits. */
export function resourceId(value: string): ResourceId {
  if (!/^[0-9a-f]{32}$/.test(value)) return "Malformed"
  return /^0{30}[0-9]{2}$/.test(value) ? "Placeholder" : "Provisioned"
}

const hostOf = (origin: string) => URL.parse(origin)?.host ?? origin
const inZone = (host: string, zone: string) => host === zone || host.endsWith("." + zone)

/** The profile text the API Worker reads from its assets: byte for byte the text CLOUD_PROFILE_SHA256 names. */
function profileText(profile: CloudProfile): string {
  return JSON.stringify(profile)
}

/** The static assets directory of one environment's API Worker, beside its Wrangler file: eliza's pages and the profile. */
export function assetsDirectory(environment: CloudEnvironment): string {
  return `./assets.${environment}`
}

/** Where a rendered Wrangler file finds each Worker's entry and the API Worker's assets. */
export interface RenderPaths {
  readonly apiMain: string
  readonly edgeMain: string
  readonly assets: string
}

/** The NATIVE_CLIENT_REGISTRY eliza's Worker reads: Alpha's registration of the environment, enabled, exactly as `client apply` writes it. */
function registryVariable(registration: Registration, environment: CloudEnvironment): string {
  return JSON.stringify([{ ...entryOf(registration), environment, enabled: true }])
}

/** The plain variables of one environment's API Worker: its profile's origins and database, Alpha's registration, and the plan the Worker sells. */
function apiVars(profile: CloudProfile, environment: CloudEnvironment, registration: Registration): Readonly<Record<string, string>> {
  const settings = profile.environments[environment]
  const plan = settings.billing?.plans.plus_monthly
  const signIn = entryOf(registration).signInReturn
  return {
    CLOUD_PROFILE_SHA256: sha256Hex(profileText(profile)),
    CLOUD_ENVIRONMENT: environment,
    PUBLIC_API_ORIGIN: settings.api,
    WEB_ORIGIN: settings.web,
    CLOUD_IDENTITY_DIGEST: settings.databaseIdentity,
    NATIVE_CLIENT_REGISTRY: registryVariable(registration, environment),
    NATIVE_CLIENT_ID: registration.clientId,
    NATIVE_AUTH_CALLBACK: signIn,
    EMAIL_FROM: `${settings.name} <${settings.mailSender}>`,
    GOOGLE_CLIENT_ID: settings.google?.clientId ?? "",
    GOOGLE_CONNECT_CLIENT_ID: settings.google?.clientId ?? "",
    STRIPE_PLAN: "plus_monthly",
    STRIPE_PRICE_ID: plan?.priceId ?? "",
    STRIPE_PRODUCT_ID: plan?.productId ?? "",
  }
}

/** The plain variables of one environment's web host Worker: the origins it forwards between, the same as its API Worker's. */
function edgeVars(profile: CloudProfile, environment: CloudEnvironment): Readonly<Record<string, string>> {
  const settings = profile.environments[environment]
  return { CLOUD_ENVIRONMENT: environment, PUBLIC_API_ORIGIN: settings.api, WEB_ORIGIN: settings.web }
}

/** Why one environment cannot be rendered for these resources, in order; empty when it can. */
export function problemsRendering(profile: CloudProfile, environment: CloudEnvironment, resources: CloudResources) {
  const settings = profile.environments[environment]
  return renderProblems(resourceId(resources.accountId), resourceId(resources.hyperdriveId), inZone(hostOf(settings.api), resources.zone), inZone(hostOf(settings.web), resources.zone))
}

function filled(value: unknown, tokens: Readonly<Record<string, unknown>>): unknown {
  if (typeof value === "string") {
    const whole = /^\{\{(\w+)\}\}$/.exec(value)
    if (whole && Object.hasOwn(tokens, whole[1])) return tokens[whole[1]]
    return value.replace(/\{\{(\w+)\}\}/g, (match, name: string) => Object.hasOwn(tokens, name) ? String(tokens[name]) : match)
  }
  if (Array.isArray(value)) return value.map((item) => filled(item, tokens))
  if (value !== null && typeof value === "object") return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, filled(item, tokens)]))
  return value
}

/** Both Workers' configurations of one environment, and the profile text the API Worker's assets carry. */
export interface RenderedEnvironment {
  readonly api: unknown
  readonly edge: unknown
  readonly profile: string
}

/** Renders both Workers of one environment from their templates, refused while a resource is unprovisioned or a host of the shipped Eliza Cloud leaks in. */
export effect function renderEnvironment(templates: { readonly api: unknown; readonly edge: unknown }, profile: CloudProfile, environment: CloudEnvironment, resources: CloudResources, registration: Registration, paths: RenderPaths): RenderedEnvironment!RenderRefused {
  const problems = problemsRendering(profile, environment, resources)
  const settings = profile.environments[environment]
  const shared = { workerName: resources.workerName, accountId: resources.accountId, hyperdriveId: resources.hyperdriveId, apiHost: hostOf(settings.api), webHost: hostOf(settings.web) }
  const rendered = {
    api: filled(templates.api, { ...shared, main: paths.apiMain, assetsDirectory: paths.assets, vars: apiVars(profile, environment, registration) }),
    edge: filled(templates.edge, { ...shared, main: paths.edgeMain, vars: edgeVars(profile, environment) }),
    profile: profileText(profile),
  }
  const leak = leakedElizaHost(JSON.stringify(rendered))
  if (!renderAccepted(problems, leak !== undefined)) throw new RenderRefused({ problem: [...problems, ...(leak === undefined ? [] : [`names ${leak}`])].join(", ") })
  return rendered
}
