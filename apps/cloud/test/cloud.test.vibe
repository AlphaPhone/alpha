module node {
  import { createHash, randomBytes } from "node:crypto"
  import http from "node:http"
  import type { AddressInfo } from "node:net"
  import { runInNewContext } from "node:vm"

  type Plans = Readonly<Record<"plus_monthly" | "pro_monthly", { readonly priceId: string; readonly productId: string }>>

  /**
   * The payment provider's catalog, read only: what the cloud checks before it serves billing. Payments cost money and
   * cannot be undone, so the local cloud reads this one; its amounts are eliza's plans (`.eliza/spec/cloud/billing/plans.md`).
   * @throws {never}
   */
  export function catalog(plans: Plans): Promise<{ origin: string; close: () => Promise<void> }> {
    const cents = { plus_monthly: 3_000, pro_monthly: 10_000 }
    const monthly = { interval: "month", interval_count: 1, usage_type: "licensed", trial_period_days: null }
    const listed = new Map<string, object>()
    for (const [plan, { priceId, productId }] of Object.entries(plans) as [keyof Plans, Plans[keyof Plans]][]) {
      listed.set(`/v1/products/${productId}`, { object: "product", id: productId, livemode: false, active: true })
      listed.set(`/v1/prices/${priceId}`, {
        object: "price", id: priceId, product: productId, unit_amount: cents[plan], currency: "usd", recurring: monthly,
        type: "recurring", billing_scheme: "per_unit", transform_quantity: null, livemode: false, active: true,
      })
    }
    const server = http.createServer((request, response) => {
      const found = listed.get(request.url ?? "")
      response.writeHead(found === undefined ? 404 : 200, { "content-type": "application/json" }).end(JSON.stringify(found ?? { error: { type: "invalid_request_error" } }))
    })
    const close = () => new Promise<void>((closed) => { server.close(() => closed()); server.closeAllConnections() })
    return new Promise((done) => server.listen(0, "127.0.0.1", () => done({ origin: `http://127.0.0.1:${(server.address() as AddressInfo).port}`, close })))
  }

  /** Fresh random text, as a device makes for a state or a verifier. @throws {never} */
  export function random(): string {
    return randomBytes(32).toString("base64url")
  }

  /** The S256 challenge of `verifier`. @throws {never} */
  export function challengeOf(verifier: string): string {
    return createHash("sha256").update(verifier, "ascii").digest("base64url")
  }

  /** What the return page's markup holds: its inline scripts, its policy by directive, whether it sends a referrer, and the elements that would load or submit anything. @throws {never} */
  export function returnPageParts(html: string) {
    const scripts = [...html.matchAll(/<script([^>]*)>([\s\S]*?)<\/script>/g)].map((found) => ({ attributes: (found[1] ?? "").trim(), text: found[2] ?? "" }))
    const policies = [...html.matchAll(/<meta http-equiv="Content-Security-Policy" content="([^"]*)">/g)].map((found) => found[1] ?? "")
    const policy = Object.fromEntries((policies[0] ?? "").split(";").map((part) => part.trim().split(/\s+/)).map(([name, ...sources]) => [name ?? "", sources]))
    return {
      scripts, policies: policies.length, policy,
      hashes: scripts.map((script) => `'sha256-${createHash("sha256").update(script.text, "utf8").digest("base64")}'`),
      noReferrer: /<meta name="referrer" content="no-referrer">/.test(html),
      loads: [...html.matchAll(/<(?:link|img|iframe|form|object|embed|audio|video|source)\b/gi)].length,
    }
  }

  /** Runs the return page's script at `href`: the address it leaves, its message, and the link it offers, if any. @throws {never} */
  export function returnPageAt(script: string, href: string) {
    const url = new URL(href)
    const shown = { message: "checking", link: undefined as string | undefined }
    const message = { set textContent(text: string) { shown.message = text } }
    const link = { set href(target: string) { shown.link = target }, set hidden(_hidden: boolean) {} }
    const location = { get search() { return url.search }, get pathname() { return url.pathname }, get href() { return url.href } }
    const history = { replaceState: (_state: unknown, _title: string, target: string) => { url.href = new URL(target, url).href } }
    const document = { getElementById: (id: string) => (id === "message" ? message : id === "return" ? link : null) }
    runInNewContext(script, { location, history, document, URL, URLSearchParams })
    return { address: url.href, ...shown }
  }
}
import { catalog, challengeOf, random, returnPageAt, returnPageParts } from node

/** The cloud stopped, or said nothing of serving, before its deadline. */
error NotServing { output: string }

/** What eliza's client was refused with. */
error Refusal { cause: unknown }

/** `@repo/deployment` names an environment Alpha registers with a local cloud. */
error NotHosted { name: string }

/** A gate's answer was not what Alpha needs. */
error GateRefused { gate: Gate; answer: string }

const owner = "owner@alpha.test"
const alpha = stagingSeed.clients[0]

/**
 * eliza's own cloud command from the pinned checkout, in a cleared environment (only PATH and HOME), under Alpha's staging
 * profile and seed, over a PGlite directory of the run, on a port the system gives it: what it serves at, once it says so.
 */
effect function serving(cloud: string, run: string) {
  const spawner = try ChildProcessSpawner
  const environment = { PATH: try Config.String("PATH"), HOME: try Config.String("HOME") }
  const child = try spawner.spawn(ChildProcess.make("node", [
    "--no-warnings", `--env-file=${run}/secrets.env`, "dist/src/main.js", "serve", "--profile", `${run}/profile.json`, "--environment", "staging",
    "--store", `pglite:${run}/cloud.pglite`, "--seed", `${run}/seed.json`, "--port", "0", "--host", "127.0.0.1",
  ], { cwd: cloud, env: environment, stdin: "ignore" }))
  const output = try Ref.make("")
  const origin = try Deferred.make<string>()
  try fork.scoped (child.all |> Stream.decodeText(%) |> Stream.runForEach(%, (text) => effect {
    try Ref.update(output, (before) => before + text)
    const said = /url: '(http:\/\/127\.0\.0\.1:\d+)'/.exec(try Ref.get(output))
    if (said !== null) try Deferred.succeed(origin, said[1] ?? "")
  }))
  const stopped = effect {
    try child.exitCode
    throw new NotServing({ output: try Ref.get(output) })
  }
  const served = effect {
    return timeout(Deferred.await(origin), "180 seconds") catch effect () => { throw new NotServing({ output: try Ref.get(output) }) }
  }
  return try raceFirst(served, stopped)
}

/** Each gate of the local check, in order: what it asks the cloud, and what Alpha needs it to answer. */
effect function gatesOf(local: string, name: string) {
  const at = (route: string, body?: unknown, credential?: string) => tryPromise({
    try: () => said<Record<string, unknown>>(`${local}${route}`, { body, headers: credential === undefined ? {} : { authorization: `Bearer ${credential}` }, within: 20_000 }),
    catch: (cause) => new GateRefused({ gate: "Health", answer: String(cause) }),
  })
  const held = { session: "", key: "" }
  const binding = { clientId: alpha.clientId, environment: "staging", redirectUri: alpha.signInReturn }
  return (gate: Gate) => effect {
    const refuse = (answer: unknown) => new GateRefused({ gate, answer: JSON.stringify(answer) })
    switch (gate) {
      case "Health": {
        const answer = try at("/api/health")
        if (answer.status !== "ok") throw refuse(answer)
        return
      }
      case "ServiceDocument": {
        const answer = try at("/api/public/service")
        if ((answer.service as { name?: string } | undefined)?.name !== name) throw refuse(answer)
        return
      }
      case "SignInMethods": {
        const answer = try at("/api/v1/auth/methods")
        if (answer.email !== true) throw refuse(answer)
        return
      }
      case "AssetLinks": {
        const answer = try at("/.well-known/assetlinks.json")
        if (!assetLinksNameAlpha(try statementsIn(answer), "Staging")) throw refuse(answer)
        return
      }
      case "EmailedCode": {
        const verifier = random()
        try at("/api/v1/auth/email/code/send", { email: owner, clientId: alpha.clientId, codeChallenge: challengeOf(verifier), codeChallengeMethod: "S256" })
        const mail = try at(`/api/test/inbox/${encodeURIComponent(owner)}`)
        const code = /\b(\d{6})\b/.exec(String(mail.text))?.[1]
        if (code === undefined) throw refuse(mail)
        const signed = try at("/api/v1/auth/email/code/verify", { email: owner, code, clientId: alpha.clientId, codeVerifier: verifier })
        if (signed.status !== "signed_in" || typeof signed.accessToken !== "string") throw refuse(signed)
        held.session = signed.accessToken
        return
      }
      case "DeviceKey": {
        const [verifier, state] = [random(), random()]
        const granted = try at("/api/v1/app-auth/connect", { ...binding, state, flow: "mobile_pkce", codeChallengeMethod: "S256", codeChallenge: challengeOf(verifier) }, held.session)
        const redeemed = { ...binding, state, code: granted.code, codeVerifier: verifier }
        const minted = try at("/api/v1/app-auth/mobile/token", { ...redeemed, grantType: "authorization_code" })
        const acknowledged = try at("/api/v1/app-auth/mobile/ack", { ...redeemed, credentialId: minted.credentialId, secret: minted.secret })
        if (acknowledged.status !== "acknowledged" || typeof minted.secret !== "string") throw refuse(acknowledged)
        held.key = minted.secret
        return
      }
      case "KeyedReads": {
        const client = createCloudClient({ baseUrl: local, credential: () => held.key })
        const read = try tryPromise({
          try: async () => ({ account: await client.account(), entitlement: await client.entitlement(), plans: await client.plans() }),
          catch: (cause) => refuse(String(cause)),
        })
        if (read.account.email !== owner || read.entitlement === "" || read.plans.map((plan) => plan.key).join() !== "plus_monthly,pro_monthly") throw refuse(read)
        return
      }
      case "BillingRefused": {
        const client = createCloudClient({ baseUrl: local, credential: () => held.key })
        const refusal = try (tryPromise({ try: () => client.billingPortal(), catch: (cause) => new Refusal({ cause }) }) |> flip(%))
        if ((refusal.cause as { failure?: { tag?: string } }).failure?.tag !== "CloudCredentialInvalid") throw refuse(String(refusal.cause))
        return
      }
    }
  }
}

describe(`Check Alpha's contract on my computer (spec/cloud/local.md, "Story: Check Alpha's contract on my computer")`, () => {
  it.live("refuses a profile off this computer, then serves Alpha's staging profile through every gate in order", () => effect {
    const files = try FileSystem.FileSystem
    const cloud = try Effect.try(() => prepared().cloud)
    const profile = try profileNamed("staging")
    const settings = profile.environments.staging
    const prices = try acquireRelease(tryPromise(() => catalog(settings.billing!.plans)), (opened) => promise(() => opened.close()))
    const run = try files.makeTempDirectoryScoped({ prefix: "alpha-cloud-" })
    const local = { ...settings, billing: { ...settings.billing!, apiUrl: prices.origin } }
    try files.writeFileString(`${run}/profile.json`, JSON.stringify({ ...profile, environments: { ...profile.environments, staging: local } }))
    try files.writeFileString(`${run}/seed.json`, JSON.stringify(stagingSeed))
    const fixture = try files.readFileString(`${cloud}/test/fixtures/secrets.env`)
    try files.writeFileString(`${run}/secrets.env`, `${fixture}\nSTRIPE_SECRET_KEY=sk_test_local\nSTRIPE_WEBHOOK_SECRET=whsec_local\n`)
    provide machine() {
      const check = try Machine
      // spec/cloud/local.md, "The local cloud starts only for a profile whose database, mail, text messages and providers are all on this computer, and stops with every part together"
      const hosted = (try profileNamed("production")).environments.staging
      const refused = check.send({ type: "start", loopback: loopbackOnly(hosted) }) catch (failure) => failure._tag
      try Effect.try(() => assert.strictEqual(refused, "Rejected"))
      try check.send({ type: "start", loopback: loopbackOnly(local) })
      const origin = try serving(cloud, run)
      // spec/cloud/local.md, "Each gate is tried only after every gate before it passed; a failed gate ends the check"
      const pass = try gatesOf(origin, settings.name)
      try check.send({ type: "beginCheck" })
      const failures: string[] = []
      for (let index = 0; index < gates && (try check.get()).checking; index += 1) {
        const ended = try exit(timeout(pass(gateAt(index)), "60 seconds"))
        if (Exit.isFailure(ended)) failures.push(`${gateAt(index)}: ${Cause.pretty(ended.cause)}`)
        try check.send({ type: "gate", ok: Exit.isSuccess(ended) })
      }
      const { passed, failed } = try check.get()
      try Effect.try(() => assert.deepStrictEqual({ passed, failed, failures }, { passed: gates, failed: false, failures: [] }))
      try check.send({ type: "stop" })
    }
  } |> scoped(%) |> Effect.provide(%, NodeServices.layer), 600_000)
})

const holds = (assertion: () => void) => Effect.try(assertion)

describe(`Alpha's own cloud waits, ready, for the cutover (spec/cloud/index.md, "Story: Keep Alpha's own cloud ready for the cutover")`, () => {
  it.effect("accepts the candidate's profile at the candidates' hosts with Alpha's services, sender and model, and refuses one that strays", () => effect {
    const hosts = try candidates()
    const profile = try profileNamed("candidate")
    try holds(() => assert.deepStrictEqual(candidateProblems(profile, hosts), []))
    const production = profile.environments.production
    const [model] = production.inference!.models
    const strayed: typeof profile = { ...profile, environments: { ...profile.environments, production: {
      ...production, capabilities: production.capabilities.filter((capability) => capability !== "maps"),
      mailSender: "sign-in@mail.alphacompute.invalid",
      inference: { ...production.inference!, models: [{ ...model, defaultMaxTokens: 4096 }] },
    } } }
    try holds(() => assert.deepStrictEqual(candidateProblems(strayed, hosts).map((problem) => problem.split(":")[0]), ["production", "production", "production"]))
    try holds(() => assert.deepStrictEqual(candidateProblems(profile, { production: hosts.production, staging: hosts.production }).length > 0, true))
    const shipped = (profiled("profile/staging.json") catch (failure) => failure._tag)
    try holds(() => assert.strictEqual(shipped, "CandidateRefused"))
  } |> Effect.provide(%, NodeServices.layer))
})

describe(`Alpha's screens reach the cloud through eliza's policy (spec/cloud/index.md, "Story: Reach my account's services from the app")`, () => {
  it.effect("loads every route of Alpha's table, refuses a sign-in or session route, and covers eliza's managed Gmail client", () => effect {
    try holds(() => assert.deepStrictEqual(tableProblems(), []))
    const [group] = elizaCloudRoutes
    try holds(() => assert.deepStrictEqual(group?.routes.find((route) => route.path === "/api/v1/eliza/google/status"), { method: "GET", path: "/api/v1/eliza/google/status", query: [{ key: "side", accepts: { kind: "any" } }, { key: "grantId", accepts: { kind: "any" } }] }))
    const refused = tableProblems([
      { verb: "Get", path: "/api/public/service", query: [] },
      { verb: "Post", path: "/api/v1/subscriptions/cancel", query: [] },
      { verb: "Get", path: "/api/v1/nowhere", query: [] },
    ])
    try holds(() => assert.deepStrictEqual(refused, [
      "GET /api/public/service: belongs to sign-in",
      "POST /api/v1/subscriptions/cancel: needs an account session",
      "GET /api/v1/nowhere: matches 0 of eliza's device routes",
    ]))
    const files = try FileSystem.FileSystem
    const client = try files.readFileString(`${(try Effect.try(() => prepared())).root}/packages/plugin-inbox/src/client/index.vibe`)
    const google = "/api/v1/eliza/google"
    const sent = [...client.matchAll(/`\$\{(google|inbox)\}([^`?]*)(?:\?\$\{query\((\{[^`]*?\})\)\})?`/gs)].filter((found) => found[0] !== "`${google}/gmail/inbox-v1`").map((found) => ({
      path: (found[1] === "google" ? google : `${google}/gmail/inbox-v1`) + found[2].replace(/\$\{encodeURIComponent\(\w+\)\}/g, "{}"),
      keys: [...new Set([...(found[3] ?? "").matchAll(/(?:^|[{,])\s*([A-Za-z]+)(?=\s*[:,}])/g)].map((key) => key[1]))].sort(),
    }))
    const listed = (group?.routes ?? []).map((route) => ({ path: route.path.replace(/\{\w+\}/g, "{}"), keys: ((route as { readonly query?: ReadonlyArray<{ readonly key: string }> }).query ?? []).map((rule) => rule.key).sort() }))
    try holds(() => assert.ok(sent.length >= 13, `found ${sent.length} paths of the managed Gmail client`))
    try holds(() => assert.deepStrictEqual(sent.filter((want) => !listed.some((have) => have.path === want.path && have.keys.join() === want.keys.join())), []))
  } |> Effect.provide(%, NodeServices.layer))
})

const templates = {
  api: { name: "{{workerName}}", assets: { directory: "{{assetsDirectory}}", binding: "ASSETS" }, routes: [{ pattern: "{{apiHost}}", custom_domain: true }], hyperdrive: [{ binding: "HYPERDRIVE", id: "{{hyperdriveId}}" }], vars: "{{vars}}" },
  edge: { name: "{{workerName}}-edge", routes: [{ pattern: "{{webHost}}", custom_domain: true }], services: [{ binding: "API", service: "{{workerName}}" }], vars: "{{vars}}" },
}
const paths = { apiMain: "../dist/src/worker.js", edgeMain: "../dist/src/edge.js", assets: "./assets.production" }

describe(`Alpha's own cloud is rendered only when provisioned (spec/cloud/rollout.md, "Story: Render a deployment only when it is provisioned")`, () => {
  it.effect("renders both Workers of a provisioned environment on the candidate's hosts, refuses a placeholder resource, and catches a shipped Eliza Cloud host", () => effect {
    const profile = try profileNamed("candidate")
    const registration = registrationOn(profile, "production")
    const rendered = try renderEnvironment(templates, profile, "production", resources.production, registration, paths)
    const api = rendered.api as { name: string; routes: ReadonlyArray<{ pattern: string }>; vars: Record<string, string> }
    const edge = rendered.edge as { routes: ReadonlyArray<{ pattern: string }>; services: ReadonlyArray<{ service: string }>; vars: Record<string, string> }
    try holds(() => assert.deepStrictEqual([api.routes[0]?.pattern, edge.routes[0]?.pattern, edge.services[0]?.service], ["api.alphacompute.cc", "cloud.alphacompute.cc", api.name]))
    // spec/cloud/rollout.md, "The API Worker's bindings repeat its profile's origins and database, and its registry is Alpha's registration of that environment"
    const settings = profile.environments.production
    const registry = try Effect.try(() => JSON.parse(api.vars.NATIVE_CLIENT_REGISTRY ?? "[]") as unknown)
    try holds(() => assert.deepStrictEqual(
      [api.vars.PUBLIC_API_ORIGIN, api.vars.WEB_ORIGIN, api.vars.CLOUD_IDENTITY_DIGEST, registry, api.vars.CLOUD_PROFILE_SHA256, api.vars.CLOUD_PROFILE],
      [settings.api, settings.web, settings.databaseIdentity, [{ ...entryOf(registration), environment: "production", enabled: true }], sha256Hex(rendered.profile), undefined]))
    try holds(() => assert.deepStrictEqual(edge.vars, { CLOUD_ENVIRONMENT: "production", PUBLIC_API_ORIGIN: settings.api, WEB_ORIGIN: settings.web }))
    try holds(() => assert.ok(!JSON.stringify(rendered).includes('STRIPE_SECRET_KEY":')))
    try holds(() => assert.deepStrictEqual(problemsRendering(profile, "staging", resources.staging), ["DatabaseUnprovisioned"]))
    const staging = (renderEnvironment(templates, profile, "staging", resources.staging, registrationOn(profile, "staging"), paths) catch (failure) => failure._tag)
    try holds(() => assert.strictEqual(staging, "RenderRefused"))
    try holds(() => assert.deepStrictEqual([leakedElizaHost("https://api.eliza.app/x"), leakedElizaHost("https://api.alphacompute.cc")], ["api.eliza.app", undefined]))
  })
})

describe(`The API Worker serves one reviewed profile (spec/cloud/rollout.md, "Story: Serve one reviewed profile from the API Worker")`, () => {
  it.effect(`serves only the profile its assets hold under the pinned digest, and asks the caller to retry otherwise (spec/cloud/rollout.md, "The API Worker serves only while the profile in its assets is the text its pinned digest names, and otherwise asks the caller to retry")`, () => effect {
    const profile = JSON.stringify({ version: 1, name: "Alpha Cloud" })
    const holding = (text: string | undefined) => ({ fetch: (request: Request) => Promise.resolve(new URL(request.url).pathname === `/${PROFILE_ASSET}` && text !== undefined ? new EdgeResponse(text) : new EdgeResponse("Not Found", { status: 404 })) })
    const read = (text: string | undefined, pinned: string) => tryPromise(() => readProfileAsset(holding(text), pinned))
    const reads = [try read(profile, sha256Hex(profile)), try read(`${profile} `, sha256Hex(profile)), try read(undefined, sha256Hex(profile)), try read(profile, "")]
    try holds(() => assert.deepStrictEqual(reads, [profile, undefined, undefined, undefined]))
    const env = { CLOUD_PROFILE_SHA256: sha256Hex(profile), ASSETS: holding(undefined) } as unknown as Parameters<typeof alphaCloudWorker.fetch>[1]
    const answer = try tryPromise(() => alphaCloudWorker.fetch(new EdgeRequest("https://api.alphacompute.cc/api/health"), env))
    try holds(() => assert.deepStrictEqual([answer.status, answer.headers.get("retry-after")], [503, "30"]))
  })
})

describe(`The web host returns the owner to the app (spec/cloud/rollout.md, "Story: Bring me back to the app when its link did not open")`, () => {
  const env: EdgeEnv = { CLOUD_ENVIRONMENT: "production", PUBLIC_API_ORIGIN: "https://api.alphacompute.cc", WEB_ORIGIN: "https://cloud.alphacompute.cc", API: { fetch: () => Promise.reject(new Error("unreachable")) } }

  it.effect("hands its own addresses to the API Worker as the web host, answers its health, and refuses every other address", () => effect {
    const routeOf = (address: string) => edgeRouteOf(new URL(address), env)
    const signIn = routeOf("https://cloud.alphacompute.cc/alphaphone/auth/callback?state=x")
    try holds(() => assert.deepStrictEqual([signIn.route, signIn.target?.href], ["Forward", "https://api.alphacompute.cc/alphaphone/auth/callback?state=x"]))
    try holds(() => assert.deepStrictEqual(["https://cloud.alphacompute.cc/health", "https://other.alphacompute.cc/x", "http://cloud.alphacompute.cc/x", "https://user:pass@cloud.alphacompute.cc/"].map((address) => routeOf(address).route), ["Health", "NotFound", "NotFound", "NotFound"]))
    const seen: string[] = []
    const api = { fetch: (request: Request) => { seen.push(`${request.url} ${request.headers.get("x-forwarded-host") ?? ""}`); return Promise.resolve(EdgeResponse.json({ ok: true })) } }
    const answered = try tryPromise(() => edgeWorker.fetch(new EdgeRequest("https://cloud.alphacompute.cc/.well-known/assetlinks.json"), { ...env, API: api }))
    try holds(() => assert.deepStrictEqual([answered.status, seen], [200, ["https://api.alphacompute.cc/.well-known/assetlinks.json cloud.alphacompute.cc"]]))
    const down = try tryPromise(() => edgeWorker.fetch(new EdgeRequest("https://cloud.alphacompute.cc/alphaphone/auth/callback"), env))
    try holds(() => assert.deepStrictEqual([down.status, down.headers.get("retry-after")], [503, "30"]))
    const refused = try tryPromise(() => edgeWorker.fetch(new EdgeRequest("https://elsewhere.example/alphaphone/auth/callback"), env))
    try holds(() => assert.strictEqual(refused.status, 404))
  })

  it.effect(`names the web host it was asked for and passes no forwarding or hop-by-hop header (spec/cloud/rollout.md, "The API Worker is told the web host it was asked for, and gets none of the caller's forwarding or hop-by-hop headers")`, () => effect {
    const sent = try Effect.try(() => forwardedHeaders(new EdgeHeaders({ host: "cloud.alphacompute.cc", "x-forwarded-host": "evil.example", forwarded: "host=evil.example", connection: "keep-alive", accept: "text/html" }), "cloud.alphacompute.cc"))
    try holds(() => assert.deepStrictEqual(Object.fromEntries(sent), { accept: "text/html", "x-forwarded-host": "cloud.alphacompute.cc", "x-forwarded-proto": "https" }))
  })
})

const provided = { DATABASE_URL: "postgres://alpha:secret@db.example:5432/alpha", RESEND_API_KEY: "re_x", GOOGLE_CLIENT_SECRET: "g", GOOGLE_CONNECT_CLIENT_SECRET: "g", STRIPE_SECRET_KEY: "sk_test_x", STRIPE_WEBHOOK_SECRET: "whsec_x", CEREBRAS_API_KEY: "c", CARTESIA_API_KEY: "k", GOOGLE_MAPS_API_KEY: "m" }

/** The secrets of `file` as one rollout reads them, frozen as CI's are or not. */
effect function settledIn(file: string, frozen: boolean) {
  provide rollout() {
    if (frozen) try (try Rollout).send({ type: "freeze" })
    return try settledSecrets(file, "staging")
  }
}

describe(`Secrets stay private and fit their environment (spec/cloud/rollout.md, "Story: Keep every secret private and fitting its environment")`, () => {
  it.effect("refuses a secrets file inside the checkout or readable by others, generates internal keys once and never in a frozen rollout, and refuses a test payment key in production", () => effect {
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const directory = try files.makeTempDirectoryScoped({ prefix: "alpha-cloud-secrets-" })
    const file = path.join(directory, "staging.env")
    try files.writeFileString(file, Object.entries(provided).map(([name, value]) => `${name}=${value}`).join("\n"), { mode: 0o644 })
    const open = readSecrets(file) catch (failure) => failure._tag
    try files.chmod(file, 0o600)
    const frozen = settledIn(file, true) catch (failure) => failure._tag === "OperatorFailed" ? failure.problem : failure._tag
    const first = try settledIn(file, false)
    const second = try settledIn(file, false)
    const publicKey = try Effect.try(() => entitlementPublicKey(first.values.CLOUD_ENTITLEMENT_KEY ?? ""))
    const inside = readSecrets(path.join(path.dirname(import.meta.dirname), "inside.env")) catch (failure) => failure._tag
    const usage = operate("deploy", ["--environment", "staging"]) catch (failure) => failure._tag
    try holds(() => assert.deepStrictEqual([open, inside, usage], ["OperatorFailed", "OperatorFailed", "UsageInvalid"]))
    try holds(() => assert.ok(typeof frozen === "string" && frozen.includes("CLOUD_SEALING_KEY is missing")))
    try holds(() => assert.deepStrictEqual(second.values, first.values))
    try holds(() => assert.deepStrictEqual(first.entitlementPublicKey, publicKey))
    try holds(() => assert.deepStrictEqual(Object.keys(workerSecrets(first.values)).sort(), ["CARTESIA_API_KEY", "CEREBRAS_API_KEY", "CLOUD_DIGEST_KEY", "CLOUD_ENTITLEMENT_KEY", "CLOUD_SEALING_KEY", "EMAIL_CODE_SECRET", "GOOGLE_CLIENT_SECRET", "GOOGLE_CONNECT_CLIENT_SECRET", "GOOGLE_CONNECT_TOKEN_KEY", "GOOGLE_MAPS_API_KEY", "RESEND_API_KEY", "STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET"]))
    try holds(() => assert.deepStrictEqual(secretProblems(first.values, "production"), ["STRIPE_SECRET_KEY must be a live key in production"]))
    try holds(() => assert.deepStrictEqual(secretProblems({ ...generated(provided), RESEND_API_KEY: "https://api.eliza.app" }, "staging"), ["RESEND_API_KEY names a deployed Eliza Cloud host"]))
  } |> scoped(%) |> Effect.provide(%, NodeServices.layer))
})

describe(`Provisioning creates only what is missing (spec/cloud/rollout.md, "Story: Create an environment's Cloudflare resources once")`, () => {
  it.effect("creates the database binding once, finds it again by name on a rerun, records it, and refuses a binding that is not the one recorded", () => effect {
    const account = resources.production.accountId
    const cloudflare = try acquireRelease(tryPromise(() => startCloudflare({ account, zone: "alphacompute.cc", token: "cf-token" })), (started) => promise(() => started.stop()))
    const files = try FileSystem.FileSystem
    const path = try Path.Path
    const ids = { ...resources.staging }
    const at = { ids, sibling: resources.production, apiHost: "api-staging.alphacompute.cc", webHost: "cloud-staging.alphacompute.cc", databaseUrl: provided.DATABASE_URL, accountId: account, token: "cf-token", base: cloudflare.base }
    const preflight = (reconcileResources({ ...at, creating: false }) catch (failure) => failure.problem)
    try holds(() => assert.strictEqual(preflight, "record the account and Hyperdrive IDs (provision --write) before deploying"))
    const created = try reconcileResources({ ...at, creating: true })
    const again = try reconcileResources({ ...at, creating: true })
    try holds(() => assert.deepStrictEqual([cloudflare.hyperdrives.length, again, cloudflare.hyperdrives[0]?.caching.disabled], [1, created, true]))
    try holds(() => assert.notStrictEqual(created.hyperdriveId, ids.hyperdriveId))
    const directory = try files.makeTempDirectoryScoped({ prefix: "alpha-cloud-resources-" })
    const file = path.join(directory, "resources.json")
    try files.writeFileString(file, JSON.stringify(resources))
    try recordResources(file, "staging", ids, created)
    const text = try files.readFileString(file)
    const recorded = (try Effect.try(() => JSON.parse(text) as typeof resources)).staging
    const rechecked = try reconcileResources({ ...at, ids: created, creating: false })
    try holds(() => assert.deepStrictEqual([recorded, rechecked], [created, created]))
    const foreign = (reconcileResources({ ...at, ids: { ...created, hyperdriveId: "c".repeat(32) }, creating: false }) catch (failure) => failure.problem)
    try holds(() => assert.strictEqual(foreign, "the Hyperdrive alpha-test-api-staging-db is not the one recorded"))
  } |> scoped(%) |> Effect.provide(%, [NodeServices.layer, FetchHttpClient.layer]), 30_000)
})

describe(`A deployed environment is ready when every public gate passes (spec/cloud/rollout.md, "Story: Tell whether a deployed environment is ready")`, () => {
  it.live("serves the candidate's staging profile from eliza's own cloud command, and every gate passes through the API host and the web host Worker", () => effect {
    const files = try FileSystem.FileSystem
    const cloud = try Effect.try(() => prepared().cloud)
    const profile = try profileNamed("candidate")
    const settings = profile.environments.staging
    const prices = try acquireRelease(tryPromise(() => catalog(settings.billing!.plans)), (opened) => promise(() => opened.close()))
    const run = try files.makeTempDirectoryScoped({ prefix: "alpha-cloud-candidate-" })
    const local = { ...settings, mail: { kind: "loopback" as const }, billing: { ...settings.billing!, apiUrl: prices.origin } }
    try files.writeFileString(`${run}/profile.json`, JSON.stringify({ ...profile, environments: { ...profile.environments, staging: local } }))
    try files.writeFileString(`${run}/seed.json`, JSON.stringify({ clients: [entryOf(registrationOn(profile, "staging"))] }))
    const fixture = try files.readFileString(`${cloud}/test/fixtures/secrets.env`)
    try files.writeFileString(`${run}/secrets.env`, [fixture, ...Object.entries({ ...provided, STRIPE_SECRET_KEY: "sk_test_local" }).filter(([name]) => name !== "DATABASE_URL").map(([name, value]) => `${name}=${value}`)].join("\n") + "\n")
    const origin = try serving(cloud, run)
    const reach = hosting(origin, { api: settings.api, web: settings.web })
    const gates = try (smoke("staging", { api: settings.api, web: settings.web }, settings.name) |> Effect.provide(%, FetchHttpClient.layer) |> Effect.provideService(%, FetchHttpClient.Fetch, reach))
    try holds(() => assert.deepStrictEqual(gates.filter((gate) => !gate.passed), []))
    try holds(() => assert.strictEqual(gates.length, 8))
  } |> scoped(%) |> Effect.provide(%, NodeServices.layer), 600_000)
})

describe(`Alpha's app is registered with each cloud it talks to (spec/cloud/index.md, "Story: Register Alpha's app with the cloud")`, () => {
  it.effect("registers Alpha's package once per hosted environment at its App Link host, with the release signer in production and its returns off the API origin, and serves asset links that name it alone", () => effect {
    for (const [name, environment] of [["staging", "Staging"], ["production", "Production"]] as const) {
      const row = try deployment(name)
      if (row.kind !== "hosted") throw new NotHosted({ name })
      const settings = (try profileNamed(row.profile)).environments[row.profile]
      try holds(() => assert.ok(profileFits(row, { api: settings.api, webHost: settings.web.replace(/^https:\/\//, "") }), `${name}: the profile answers at its deployment's cloud`))
      const registration = registrationAt(environment, row.appLinkHost)
      try holds(() => assert.deepStrictEqual(
        [registration.clientId, registration.androidPackage, registration.displayName, registration.certFingerprints[0], registration.signInReturn, registration.billingReturn],
        [alphaPackage, alphaPackage, alphaName, releaseSigner, { origin: `https://${row.appLinkHost}`, path: "/alphaphone/auth/callback" }, { origin: `https://${row.appLinkHost}`, path: "/alphaphone/billing/return" }]))
      try holds(() => assert.ok(returnsOffApi(registration, settings.api)))
      try holds(() => assert.ok(assetLinksNameAlpha(try assetLinks(registration, settings.api), environment)))
      const debugSigned = { ...registration, certFingerprints: [...registration.certFingerprints, "00:".repeat(31) + "00"] }
      try holds(() => assert.ok(!assetLinksNameAlpha(try assetLinks(debugSigned, settings.api), environment), `${name}: a signer the environment does not trust is refused`))
      if (environment === "Staging") try holds(() => assert.deepStrictEqual(stagingSeed.clients, [entryOf(registration)]))
    }
  } |> Effect.provide(%, NodeServices.layer))
})

describe(`Alpha's return page hands an authorization back to the app (spec/cloud/index.md, "Story: Come back to Alpha after authorizing a connection in my browser")`, () => {
  const page = "../app/public/delegation-return.html"

  it.effect(`runs one inline script its policy names by hash, sends no referrer and loads nothing else (spec/cloud/index.md, "The return page runs only its own hashed script, sends no referrer and loads nothing else")`, () => effect {
    const parts = returnPageParts(try (try FileSystem.FileSystem).readFileString(page))
    try holds(() => assert.deepStrictEqual([parts.scripts.length, parts.scripts[0]?.attributes, parts.policies], [1, "", 1]))
    try holds(() => assert.deepStrictEqual(
      [parts.policy["script-src"], parts.policy["default-src"], parts.policy["base-uri"], parts.policy["form-action"], parts.noReferrer, parts.loads],
      [parts.hashes, ["'none'"], ["'none'"], ["'none'"], true, 0]))
  } |> Effect.provide(%, NodeServices.layer))

  it.effect(`clears its address and offers Alpha's link only for a well-formed return with one result (spec/cloud/index.md, "The return page clears the query from its address, and hands back only a well-formed return with exactly one result")`, () => effect {
    const [script] = returnPageParts(try (try FileSystem.FileSystem).readFileString(page)).scripts
    const state = "A".repeat(43)
    const well = { given: 2, repeated: false, unknown: false, stateValid: true, hasCode: true, codeFits: true, hasError: false, hasDescription: false, descriptionFits: true }
    const cases = [
      { query: `?state=${state}&code=granted`, shape: well, link: `alphaphone://cloud-delegation?state=${state}&code=granted` },
      { query: `?state=${state}&error=access_denied&error_description=declined`, shape: { ...well, given: 3, hasCode: false, hasError: true, hasDescription: true }, link: `alphaphone://cloud-delegation?state=${state}&error=access_denied` },
      { query: "", shape: { ...well, given: 0, hasCode: false, stateValid: false }, link: undefined },
      { query: `?state=${state}&code=granted&error=access_denied`, shape: { ...well, given: 3, hasError: true }, link: undefined },
      { query: `?state=${state}&code=granted&code=again`, shape: { ...well, given: 3, repeated: true }, link: undefined },
      { query: `?state=${state}&code=granted&next=elsewhere`, shape: { ...well, given: 3, unknown: true }, link: undefined },
      { query: `?state=short&code=granted`, shape: { ...well, stateValid: false }, link: undefined },
      { query: `?state=${state}&code=${"c".repeat(4097)}`, shape: { ...well, codeFits: false }, link: undefined },
      { query: `?state=${state}&code=granted&error_description=stray`, shape: { ...well, given: 3, hasDescription: true }, link: undefined },
      { query: `?state=${state}&error=access_denied&error_description=${"d".repeat(2001)}`, shape: { ...well, given: 3, hasCode: false, hasError: true, hasDescription: true, descriptionFits: false }, link: undefined },
    ]
    for (const { query, shape, link } of cases) {
      const shown = returnPageAt(script?.text ?? "", `https://return.alpha.test/delegation-return.html${query}`)
      const answer = returnAnswer(shape)
      try holds(() => assert.strictEqual(shown.address, "https://return.alpha.test/delegation-return.html", query))
      try holds(() => assert.strictEqual(shown.link, link, query))
      try holds(() => assert.strictEqual(shown.link !== undefined, answer === "Continue" || answer === "Cancelled", query))
      try holds(() => assert.strictEqual(/reopened/.test(shown.message), answer === "Reopened", query))
      try holds(() => assert.strictEqual(/cancelled/.test(shown.message), answer === "Cancelled", query))
    }
  } |> Effect.provide(%, NodeServices.layer))
})
