      "firstPartyOrigins": [
        "https://eliza.app"
      ],
      "capabilities": [
        "billing"
      ],
      "documents": {
        "terms": {
          "title": "Alpha Terms",
          "revision": "2026-11-23",
          "sections": [
            {
              "title": "Your phone and its agent",
              "paragraphs": [
                "Alpha is a personal agent phone. Its agent runs on the phone; this cloud supplies sign-in, model inference, speech and the services the agent asks for on your behalf."
              ]
            },
            {
              "title": "Your plan",
              "paragraphs": [
                "A paid plan renews each month until you cancel it, and a cancellation takes effect when the paid period ends."
              ]
            }
          ]
        },
        "privacy": {
          "title": "Alpha Privacy",
          "revision": "2026-11-23",
          "sections": [
            {
              "title": "What the cloud keeps",
              "paragraphs": [
                "The cloud keeps your account, your sign-in methods, the devices signed in to it and what each paid request cost. It does not keep your conversations with Alpha."
              ]
            },
            {
              "title": "Your choices",
              "paragraphs": [
                "You may sign a device out, disconnect Google, or ask for your account to be deleted at any time."
              ]
            }
          ]
        }
      },
      "signIn": {
        "smsCountries": [
          "+1"
        ],
        "smsHourlyBudget": 100
      },
