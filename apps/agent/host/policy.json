{
  "schema": 1,
  "actions": {
    "allowed": [
      "REPLY", "IGNORE", "NONE", "PROPOSE_DEVICE_ACTION", "VIEWS",
      "NOTES_LIST", "NOTES_GET", "NOTES_CREATE", "NOTES_UPDATE", "NOTES_DELETE", "NOTES_MOVE", "NOTES_RESTORE",
      "WORKFLOW",
      "MAPS_PLACE", "MAPS_ROUTE", "MAPS_NAVIGATION_START", "MAPS_NAVIGATION_REROUTE", "MAPS_NAVIGATION_STOP",
      "MAPS_SELECT", "MAPS_SAVE", "MAPS_SAVED", "MAPS_SHARE", "MAPS_WHERE_AM_I", "MAPS_COVERAGE",
      "BROWSER"
    ],
    "refused": {
      "CALCULATE": "The old phone's agent had no calculator: develop's plugins registered no calculate action."
    }
  },
  "plugins": {
    "load": [
      "@elizaos/plugin-personal-assistant", "@elizaos/plugin-calendar", "@elizaos/plugin-inbox", "@elizaos/plugin-notes",
      "@elizaos/plugin-files", "@elizaos/plugin-workflow", "@elizaos/plugin-maps", "@elizaos/plugin-browser",
      "@elizaos/agent/device-actions", "@elizaos/agent/reply-draft", "@elizaos/agent/approvals", "@elizaos/agent/notifications",
      "@elizaos/agent/views", "@elizaos/agent/scheduled-tasks", "@elizaos/agent/tasks", "@elizaos/agent/triggers", "@elizaos/agent/surface"
    ]
  }
}
