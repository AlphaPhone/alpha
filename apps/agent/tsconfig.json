{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowArbitraryExtensions": true,
    "types": [
      "node"
    ],
    "rootDir": ".",
    "rootDirs": [
      ".",
      ".vibe/declarations"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "test",
    "gen/*.ts",
    "gen/*.vibe",
    "*.config.ts"
  ],
  "vibe": {
    "sidecarDir": ".vibe/declarations"
  }
}
