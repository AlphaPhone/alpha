// spec/agent/index.md, "A browser can confirm only its own recording cleanup"; spec/agent/index.md, "Only the phone's native channel can verify that a reviewed recording was erased"
import type { LocalRoute } from "@elizaos/agent"
import type { ModuleContext } from "@elizaos/agent-host"
import { notesRecordingCleanupHost } from "@elizaos/plugin-notes"
// eslint-disable-next-line @typescript-eslint/consistent-type-imports -- CleanupReceipt is the schema `schema CleanupRequest` decodes with, a value the projection ESLint reads does not show
import { CleanupReceipt, type NotesTrashRecordingCleanup } from "@elizaos/plugin-notes-client"

schema CleanupScope { userId: string; organizationId: string; agentId: string; epoch: Schema.Int }
schema CleanupRequest { phase: "prepare" | "confirm"; receipt: CleanupReceipt; scope: CleanupScope }

const readCleanup = Schema.decodeUnknownOption(CleanupRequest, { onExcessProperty: "error" })
const readBrowserCleanup = Schema.decodeUnknownOption(CleanupReceipt, { onExcessProperty: "error" })
const browserAudio = /^browser-audio-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/

function exactReceipt(a: NotesTrashRecordingCleanup, b: NotesTrashRecordingCleanup): boolean {
  return a.operationId === b.operationId && a.noteId === b.noteId && a.audioId === b.audioId && a.deletedAt === b.deletedAt
}

function owns(context: ModuleContext, scope: CleanupScope): boolean {
  const account = context.launch.account
  return account !== undefined && account.userId === scope.userId && account.organizationId === scope.organizationId
    && context.runtime.agentId === scope.agentId && context.epoch === scope.epoch
}

/**
 * One resident launch may verify only the canonical receipt being confirmed by that native request.
 * @public main.vibe imports it by name in the generated host entry.
 */
export function makeNativeNotesCleanup(path: string) {
  const proving = new WeakMap<AbortSignal, NotesTrashRecordingCleanup>()
  const unavailable = { status: 409, body: { status: "unavailable" } }
  type Host = NonNullable<ReturnType<typeof notesRecordingCleanupHost>>
  effect function confirm(host: Host, receipt: NotesTrashRecordingCleanup, signal: AbortSignal): boolean!! {
    return Effect.ensuring(effect {
      try sync(() => { proving.set(signal, receipt) })
      return try tryPromise(() => host.acknowledgeTrashRecordingCleanup(receipt, signal))
    }, sync(() => { proving.delete(signal) })) catch () => false
  }
  return {
    browserRoute(context: ModuleContext, path: string, maxBodyBytes: number): LocalRoute {
      return {
        method: "POST", path, maxBodyBytes,
        handler: ({ body, signal }) => runPromise(effect {
          if (context.launch.account === undefined) return { status: 403, body: { status: "wrong-scope" } }
          const receipt = Option.getOrUndefined(readBrowserCleanup(body))
          if (receipt === undefined || !browserAudio.test(receipt.audioId)) return { status: 400, body: { status: "invalid" } }
          const host = notesRecordingCleanupHost(context.runtime)
          if (host === undefined) return { status: 503, body: { status: "unavailable" } }
          const pending = tryPromise(() => host.canVerifyRecordingCleanup(receipt, signal)) catch () => false
          if (!pending || signal.aborted) return unavailable
          const confirmed = try confirm(host, receipt, signal)
          return confirmed ? { status: 200, body: { status: "confirmed" } } : unavailable
        }, { signal }),
      }
    },
    verifyRecordingCleanup(receipt: NotesTrashRecordingCleanup, signal?: AbortSignal): Promise<boolean> {
      const proof = signal === undefined ? undefined : proving.get(signal)
      return Promise.resolve(proof !== undefined && exactReceipt(proof, receipt))
    },
    route(context: ModuleContext): LocalRoute {
      return {
        method: "POST", path,
        handler: ({ body, signal }) => runPromise(effect {
          const input = Option.getOrUndefined(readCleanup(body))
          if (input === undefined) return { status: 400, body: { status: "invalid" } }
          if (!owns(context, input.scope)) return { status: 403, body: { status: "wrong-scope" } }
          const host = notesRecordingCleanupHost(context.runtime)
          if (host === undefined) return { status: 503, body: { status: "unavailable" } }
          const { receipt } = input
          const pending = tryPromise(() => host.canVerifyRecordingCleanup(receipt, signal)) catch () => false
          if (!pending || signal.aborted) return unavailable
          if (input.phase === "prepare") return { status: 200, body: { status: "pending" } }
          const confirmed = try confirm(host, receipt, signal)
          return confirmed ? { status: 200, body: { status: "confirmed" } } : unavailable
        }, { signal }),
      }
    },
  }
}
