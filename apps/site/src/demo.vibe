// spec/site/index.md, "Story: Walk through what Alpha does"
import * as Demo from "../gen/site.effect.vibe"
import { type Event, ticking } from "../gen/site.effect.vibe"

const untimed = 0

export const demo = Layer.provide(Layer.effect(Demo.Machine, effect {
  const inner = try Demo.Machine
  effect function send(event: Event) {
    const now = try Clock.currentTimeMillis
    return try inner.send({ ...event, now })
  }
  const told = (event: Event) => ignore(send(event))
  const receive = (input: unknown) => flatMap(Demo.decodeEvent(input), send)
  // spec/site/index.md, "When the page opens the phone is on Home and starts to play"
  try told({ type: "start", now: untimed })
  // spec/site/index.md, "A beat moves on once its time has come, and a scene's last beat leads to the next scene, the spoken note back to Home"
  const due = Stream.switchMap(inner.changes, (state) => ticking(state)
    ? Stream.fromEffect(effect {
      for (;;) {
        const wait = state.due - (try Clock.currentTimeMillis)
        if (wait <= 0) break
        try sleep(wait)
      }
    })
    : Stream.empty)
  try fork.scoped Stream.runForEach(due, () => told({ type: "tick", now: untimed }))
  return {
    changes: inner.changes,
    get: () => inner.get(),
    send,
    receive,
  }
}), Demo.machine())
