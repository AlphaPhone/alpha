// spec/notes/collection.md, "A collection is bound to one owner, and a new owner or a retirement starts over"; spec/notes/recordingOpen.md, "A read starts only while Notes can be shown and none is in flight, and opens Notes at most once per tap"; spec/notes/share.md, "One document operation runs at a time, and its receipt shows only in its own visible visit"; spec/notes/webSource.md, "One action per dialog, only while the dialog is fresh over the note it reviewed"; spec/notes/listFilter.md, "A turn names the list only while the plain list is in front, owned and settled"; spec/notes/attachment.md, "A document's grant is released only when neither a saved note nor Trash still refers to it"; spec/notes/recorder.md, "Another owner or leaving Notes detaches the view and keeps the recording"; spec/notes/trash.md, "An earlier device Trash row comes into the canonical Trash once, and the device slot clears only after every row is settled"; spec/notes/list.md, "A Notes route opens one note or shows one list filter, and the plain list otherwise"
import { CloudSession, ownerOf } from "../account/layer.vibe"
import { Machine as EditorMachine } from "../../gen/notes__editor.effect.vibe"
import { Machine as TrashMachine } from "../../gen/notes__trash.effect.vibe"
import { Foreground, type ForegroundState } from "../shell/foreground.vibe"
import { Navigation } from "../shell/navigation.vibe"
import { Notices } from "../shell/notices.vibe"
import { audioLayer } from "./audio.vibe"
import { cleanupLayer } from "./cleanup.vibe"
import { clientLayer } from "./client.vibe"
import { NotesCollection, collectionLayer } from "./collection.vibe"
import { draftsLayer } from "./drafts.vibe"
import { NotesEditor, editorLayer } from "./editor.vibe"
import { foldersLayer } from "./folders.vibe"
import { importLegacyTrash } from "./legacyTrash.vibe"
import { notesRouteRequest } from "./list.vibe"
import { type ListScene, NotesListFilter, listFilterLayer } from "./listFilter.vibe"
import { organizeLayer } from "./organize.vibe"
import { NotesHandoff, handoffLayer, originsLayer } from "./origins.vibe"
import { NotesRecorder, recorderLayer } from "./recorder.vibe"
import { recordingOpenLayer } from "./recordingOpen.vibe"
import { NotesShare, shareLayer } from "./share.vibe"
import { NotesSources, sourceReferences, sourcesLayer } from "./sources.vibe"
import { trashLayer } from "./trash.vibe"

const records = Layer.provideMerge(Layer.mergeAll(editorLayer, handoffLayer), Layer.provideMerge(collectionLayer, Layer.merge(clientLayer, draftsLayer)))
const devices = Layer.provideMerge(Layer.mergeAll(trashLayer, cleanupLayer, recorderLayer, audioLayer, originsLayer, shareLayer, sourcesLayer, recordingOpenLayer), records)
const agent = Layer.provideMerge(organizeLayer, Layer.provideMerge(Layer.mergeAll(foldersLayer, listFilterLayer), devices))

effect function openUnlessShown(editor: NotesEditor.Shape, noteId: string) {
  const machine = try EditorMachine
  const state = try machine.get()
  if (state.present && state.draftId === noteId) return
  try editor.leave(noteId)
}

const followOwner = Layer.effectDiscard(effect {
  const session = try CloudSession
  const collection = try NotesCollection
  const recorder = try NotesRecorder
  const filter = try NotesListFilter
  const editor = try NotesEditor
  const handoff = try NotesHandoff
  const sources = try NotesSources
  const notices = try Notices
  // spec/notes/editor.md: an edit an owner change closed before it was saved is named, never dropped silently.
  try fork.scoped Stream.runForEach(editor.unsaved, (title) => notices.show(`Your edit to “${title}” wasn’t saved because the account changed.`, { failure: true }))
  try fork.scoped Stream.runForEach(handoff.requests, (request) =>
    request.kind === "open-notes" && request.noteId !== undefined ? openUnlessShown(editor, request.noteId) : Effect.void)
  try fork.scoped Stream.runForEach(Stream.changesWith(collection.snapshots, (a, b) => a?.snapshot.revision === b?.snapshot.revision && a?.owner === b?.owner),
    () => filter.collectionChanged())
  try fork.scoped Stream.runForEach(Stream.changes(Stream.map(collection.snapshots, (owned) => owned?.owner)), (owner) =>
    owner === undefined ? Effect.void : Effect.asVoid(importLegacyTrash()))
  try fork.scoped Stream.runForEach(Stream.changes(Stream.map(collection.snapshots, (owned) => owned === undefined ? undefined : sourceReferences(owned.snapshot).sort().join("\n"))),
    (references) => references === undefined ? Effect.void : Effect.asVoid(sources.releaseUnused()))
  const owners = Stream.changes(Stream.map(session.changes, (current) => ownerOf(current)))
  try fork.scoped Stream.runForEach(owners, (number) => effect {
    const current = number === 0 ? undefined : try session.ownerKey("notes")
    if (current === undefined) {
      try recorder.ownerChanged(false)
      try filter.ownerLost()
      try collection.retire()
      return
    }
    try collection.bind(current)
    try recorder.ownerChanged(true)
  })
})

function sceneOf(state: ForegroundState, editing: boolean, trashOpen: boolean): ListScene {
  return { onList: state.visible && state.view === "notes" && !editing && !trashOpen, sensitive: state.locked || !state.visible, obstructed: state.modal && state.chat === "closed" }
}

const followForeground = Layer.effectDiscard(effect {
  const foreground = try Foreground
  const recorder = try NotesRecorder
  const share = try NotesShare
  const sources = try NotesSources
  const filter = try NotesListFilter
  const editor = try NotesEditor
  const trash = try TrashMachine
  const collection = try NotesCollection
  const inNotes = (state: ForegroundState) => state.visible && state.view === "notes"
  try fork.scoped Stream.runForEach(Stream.changesWith(foreground.changes, (a, b) => a.view === b.view && a.visible === b.visible), (state) => effect {
    const open = state.view === "notes"
    try share.visit(open)
    try share.visibility()
    try sources.page(open, state.visible)
    if (inNotes(state)) {
      try filter.newVisit()
      try recorder.adopt()
      // spec/notes/collection.md: the collection is read again when the owner enters Notes or Alpha returns on Notes.
      try collection.refresh()
    }
  })
  const scenes = Stream.map(Stream.zipLatest(Stream.zipLatest(foreground.changes, editor.drafts), trash.changes), ([[state, draft], view]) => sceneOf(state, draft !== undefined, view.opened))
  try fork.scoped Stream.runForEach(Stream.changesWith(scenes, (a, b) => a.onList === b.onList && a.sensitive === b.sensitive && a.obstructed === b.obstructed), (scene) => filter.scene(scene))
})

const routeKey = "notes:"

const followRoutes = Layer.effectDiscard(effect {
  const navigation = try Navigation
  const collection = try NotesCollection
  const editor = try NotesEditor
  const handoff = try NotesHandoff
  const machine = try EditorMachine
  const routeNow = (nav: { readonly places: readonly { readonly app: string; readonly route: string }[] }) => nav.places.find((place) => place.app === "notes")?.route ?? ""
  const owners = Stream.changes(Stream.map(collection.snapshots, (owned) => owned?.owner))
  const asked = Stream.changes(Stream.map(Stream.zipLatest(navigation.changes, owners), ([nav, owner]) =>
    nav.app === "notes" && owner !== undefined ? `${owner}\n${routeKey}${routeNow(nav)}` : ""))
  try fork.scoped Stream.runForEach(asked, (key) => effect {
    if (key === "") return
    const request = notesRouteRequest(key.slice(key.indexOf("\n") + 1 + routeKey.length))
    if (request.filter !== undefined) try handoff.showFilter(request.filter)
    if (request.noteId !== undefined) try openUnlessShown(editor, request.noteId)
  })
  const shown = Stream.changes(Stream.map(machine.changes, (state) => state.present ? state.draftId : ""))
  let closed = ""
  try fork.scoped Stream.runForEach(shown, (noteId) => effect {
    const left = closed
    closed = noteId
    const nav = try navigation.get()
    if (nav.app !== "notes") return
    const route = routeNow(nav)
    if (noteId !== "" && route !== noteId) try navigation.send({ type: "setRoute", route: noteId })
    if (noteId === "" && left !== "" && route === left) try navigation.send({ type: "setRoute", route: "" })
  })
})

export { scannedNoteHandoff } from "./handoffs.vibe"
export { NotesHandoff, NotesOrigins, type NotesRequest } from "./origins.vibe"
export { NotesOrganize } from "./organize.vibe"
export { NotesRecordingOpen } from "./recordingOpen.vibe"

/** Every Notes service and machine; it needs the platform's Native, Resident, Build and KeyValueStore, the account's CloudSession, voice's VoiceRoute and RecordingTranscriber, and the shell's Foreground, Navigation and Notices. */
export const layer = Layer.provideMerge(Layer.mergeAll(followOwner, followForeground, followRoutes), agent)
