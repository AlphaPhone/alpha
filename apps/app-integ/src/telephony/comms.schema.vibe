// spec/telephony/comms.md, "A proposal restored from the phone's own store is shown, never approved, until Alpha proposes it again"; spec/assistant/approvals.md, "A card restored from the phone's own store is shown but never executed"
const safeText = (value: string) => value.isWellFormed() && !/[\p{Cc}‪-‮⁦-⁩]/u.test(value.replace(/\n/g, " "))

/** The words of the open proposal's card as Alpha's reply showed them: its line, its title and its detail. */
export const ProposalWords = Schema.Struct({
  text: Schema.String.check(Schema.isMaxLength(4000), Schema.makeFilter(safeText)),
  title: Schema.String.check(Schema.isMaxLength(500), Schema.makeFilter(safeText)),
  detail: Schema.String.check(Schema.isMaxLength(2000), Schema.makeFilter(safeText)),
})

/** The phone's comms record (`alpha-proposal:v1`): the subject last briefed and at most one open card, kept only to redraw it. */
export const StoredProposal = Schema.Struct({
  v: Schema.Literal(1),
  briefed: Schema.NullOr(Schema.String.check(Schema.isMaxLength(512))),
  open: Schema.NullOr(ProposalWords),
})
