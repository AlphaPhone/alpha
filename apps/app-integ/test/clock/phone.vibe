/** One plugin call the phone received. */
export interface Call {
  readonly plugin: string
  readonly method: string
  readonly args: unknown
}

/** What a plugin method answers: a reply, or a refusal the plugin raises. */
export type Handler = (args: unknown) => unknown

/** A handler's answer that makes the plugin refuse the call, as a lost answer looks to Alpha. */
export interface Refusal {
  readonly refused: string
}

/** Refuses the call with `message`. */
export const refuse = (message: string): Refusal => ({ refused: message })

function refusal(value: unknown): value is Refusal {
  return typeof value === "object" && value !== null && "refused" in value && typeof value.refused === "string"
}

/** A phone whose plugins answer from `handlers`, keyed `Plugin.method`, and that records every call. */
export function fakePhone(handlers: Record<string, Handler>) {
  const calls: Call[] = []
  const layer = Layer.succeed(Native, {
    available: (plugin: string) => succeed(Object.keys(handlers).some((key) => key.startsWith(`${plugin}.`))),
    invoke: (plugin: string, method: string, args?: unknown) => effect {
      calls.push({ plugin, method, args })
      const handler = handlers[`${plugin}.${method}`]
      if (handler === undefined) throw new NativeUnavailable({ plugin, method })
      const answer = try Effect.try({ try: () => handler(args), catch: (error) => new NativeFailed({ plugin, method, message: String(error) }) })
      if (refusal(answer)) throw new NativeFailed({ plugin, method, message: answer.refused })
      return answer
    },
    listen: () => Stream.empty,
  })
  return { calls, layer }
}

/** The build Clock runs in. */
export const build = (variant: "launcher" | "aosp" | "browser", testMocks = false) => Layer.succeed(Build, { info: { version: "0.1.0", variant, testMocks } })

/** The shell's navigation, remembering where it was sent; only the members Clock uses answer. */
export function fakeNavigation() {
  const opened: Array<{ readonly app: string; readonly route?: string }> = []
  const nav = () => {
    const last = opened.at(-1)
    return last === undefined ? navInitial : { ...navInitial, app: last.app, places: [{ app: last.app, route: last.route ?? "", inner: false }] }
  }
  const shape = {
    open: (app: string, route?: string) => sync(() => { opened.push({ app, route }); return true }),
    get: () => sync(nav),
    changes: Stream.empty,
  }
  return { opened, layer: Layer.succeed(Navigation, shape as unknown as Navigation.Shape) }
}

/** One of Alpha's own notices as the phone lists it now, for the assistant's notice question. */
export type Listed = (id: string) => { readonly id: string; readonly revision: string } | undefined

/**
 * The assistant: a composer that is quiet unless `busy` writes a reply or `holding` keeps a draft, the drafts reviewed
 * questions opened, a notice question that drafts only for an askable notice still `listed` at the revision asked, and
 * a question review that remembers each question it was asked to review and each one dismissed.
 */
export function fakeAssistant(busy = false, holding = false, listed?: Listed) {
  const asked: string[] = []
  const reviews: AskSource[] = []
  const dismissed: number[] = []
  const composer = { transcript: Stream.make({ conversation: null, rows: [], hasMore: false, typing: busy }) }
  const assistant = { holdingDraft: () => succeed(holding), holdingDraftChanges: Stream.make(holding), openWith: (draft: string) => sync(() => { asked.push(draft) }) }
  const flows = {
    askAboutNotice: (noticeId: string, revision: string, kind: string, question: string) => sync(() => {
      const now = listed === undefined ? { id: noticeId, revision } : listed(noticeId)
      if (kind !== "ValidNotice" || holding || now === undefined || now.revision !== revision || question.trim() === "") return false
      asked.push(question)
      return true
    }),
  }
  const draft = {
    review: Stream.make(undefined),
    askAbout: (source: AskSource) => sync(() => { reviews.push(source) }),
    dismiss: (id: number) => sync(() => { dismissed.push(id) }),
  }
  return {
    asked,
    reviews,
    dismissed,
    layer: Layer.mergeAll(
      Layer.succeed(Composer, composer as unknown as Composer.Shape),
      Layer.succeed(Assistant, assistant as unknown as Assistant.Shape),
      Layer.succeed(AssistantFlows, flows as unknown as AssistantFlows.Shape),
      Layer.succeed(AssistantDraft, draft as unknown as AssistantDraft.Shape),
    ),
  }
}

/** Settings' device facts with every fact unread, as before Android answers. */
export const fakeFacts = Layer.succeed(DeviceFacts, { read: () => succeed(factsInitial.read) } as unknown as DeviceFacts.Shape)

/** The signed-in Cloud account `organization:user`, or none. */
export function session(ownerId: string | undefined) {
  const [organizationId, userId] = (ownerId ?? ":").split(":")
  const current = ownerId === undefined ? sessionInitial : { ...sessionInitial, phase: "SignedIn", generation: 1, account: { ...sessionInitial.account, organizationId, userId } }
  return Layer.succeed(CloudSession, { current: () => succeed(current), changes: Stream.make(current) } as unknown as CloudSession.Shape)
}

/** The workflows area's runs, remembering each run it opened and answering the route Workflows shows it under. */
export function fakeRuns() {
  const opened: string[] = []
  const shape = { open: (runId: string) => sync(() => { opened.push(runId); return `run/${runId}` }) }
  return { opened, layer: Layer.succeed(WorkflowRuns, shape as unknown as WorkflowRuns.Shape) }
}

/** The notes area's back-links, remembering each record it was told to forget. */
export function fakeOrigins() {
  const forgotten: Array<{ readonly kind: string; readonly id: string }> = []
  const shape = { forget: (kind: string, id: string) => sync(() => { forgotten.push({ kind, id }) }) }
  return { forgotten, layer: Layer.succeed(NotesOrigins, shape as unknown as NotesOrigins.Shape) }
}

/** The shell's side of the assistant: an unlocked, visible, non-private screen and the agent identity Clock binds reviews to. */
export function fakeHost(signedIn = true) {
  const identity = { origin: "resident", owner: "owner-1", agent: "agent-1", session: "credential-1", installationId: "install-1", enrollmentId: "enroll-1" }
  const screen = { exposure: { privateView: false, locked: false, hidden: false, connectionDialog: false }, observation: { view: "clock", revision: 1, sensitive: false }, onCalendar: false, contextKey: "clock:" }
  const shape = { identity: () => succeed(signedIn ? identity : undefined), screen: () => succeed(screen) }
  return Layer.succeed(AssistantHost, shape as unknown as AssistantHost.Shape)
}

/** The Reminders screen, counting the refreshes an agent change asked for, with `chosen` the reminder it shows under the name the agent gave. */
export function fakeReminders(chosen?: { readonly id: string; readonly name: string }) {
  const refreshes: number[] = []
  const shape = { refresh: () => sync(() => { refreshes.push(refreshes.length + 1) }) }
  const page = { chosen: (name: string) => succeed(chosen !== undefined && chosen.name.toLowerCase() === name.trim().toLowerCase() ? chosen.id : undefined) }
  return {
    refreshes,
    layer: Layer.merge(Layer.succeed(Reminders, shape as unknown as Reminders.Shape), Layer.succeed(RemindersPage, page as unknown as RemindersPage.Shape)),
  }
}

/** Every Clock machine, in memory, and Settings' unread device facts. */
export const machines = Layer.mergeAll(
  fakeFacts, page(), ringer(), alarms(), timers(), stopwatch(), world(), handoff(), history(), reminders(), journal(), drafts(), taps(), shade(), canonical(), workflow(), deletions(), mirror(), notices(),
)
