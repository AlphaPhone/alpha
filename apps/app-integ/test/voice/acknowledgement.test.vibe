// spec/voice/acknowledgement.md, "Story: Hear that Alpha is working on it, never over its answer"
import { assert, it } from "@effect/vitest"
import { readReplyStream } from "@elizaos/agent/client"
import { acknowledgement, voiceReplyHooks } from "../../src/voice/acknowledgement.vibe"
import { Speech, SpeechInterrupted, type SpeakOptions } from "../../src/voice/speech.vibe"
import { initial as speechInitial } from "../../gen/voice__speech.ts"
import { acknowledged, audible, cancel, ended, initial, replyMayStart, replyReady } from "../../gen/voice__acknowledgement.ts"

/** One line the fake speaker was asked to say: whether it was stopped, and its start report. */
interface Said {
  readonly line: string
  stopped: boolean
  finished: boolean
  readonly start: () => void!!
  readonly end: Deferred.Deferred<void>
}

/** A reply-channel speaker that records each line and plays until it is stopped or told to finish; `startsAtOnce` false is a line still being synthesised. */
function speaker(said: Said[], startsAtOnce: boolean) {
  const fake = {
    changes: Stream.never,
    get: () => Effect.succeed(speechInitial),
    effect speak(text: string, _channel: "Replies" | "Reading" | "AppSpeech" | "CloudReading", options?: SpeakOptions) {
      const end = try Deferred.make<void>()
      const entry: Said = { line: text, stopped: false, finished: false, start: options?.onStarted ?? (() => sync(() => undefined)), end }
      said.push(entry)
      if (startsAtOnce) try entry.start()
      try onInterrupt(Deferred.await(end), () => sync(() => { entry.stopped = true; entry.finished = true }))
      if (entry.stopped) throw new SpeechInterrupted({ reason: "stopped", started: startsAtOnce })
    },
    speakPieces: () => Effect.void,
    speakReviewed: () => Effect.void,
    speakOnPhone: () => Effect.void,
    effect stop(_channel: "Replies" | "Reading" | "AppSpeech" | "CloudReading") {
      for (const entry of said) {
        if (entry.finished) continue
        entry.stopped = true
        entry.finished = true
        try Deferred.succeed(entry.end, undefined)
      }
    },
    entry: () => Effect.succeed("EntryAllowed" as const),
    bindStream: () => Effect.void,
    warmDevice: () => Effect.void,
    warmCloud: () => Effect.void,
    setMuted: () => Effect.succeed(true),
  }
  return Layer.succeed(Speech, fake)
}

effect function finishLine(entry: Said | undefined) {
  if (entry === undefined || entry.finished) return
  entry.finished = true
  try Deferred.succeed(entry.end, undefined)
}

effect function settle() {
  for (let round = 0; round < 20; round += 1) try Effect.yieldNow
}

const clear = () => true

it.effect(`a cue speaks only the agent's acknowledgment, once a turn (spec/voice/acknowledgement.md, "Only the agent's acknowledgment, of 1 to 120 characters, is spoken, and only once a turn")`, () => effect {
  const said: Said[] = []
  provide speaker(said, true) {
    const cue = try acknowledgement()
    try cue.acknowledged("   ", clear)
    try cue.acknowledged("x".repeat(121), clear)
    try cue.acknowledged("Sure.", clear)
    try cue.acknowledged("A second line", clear)
    try settle()
    try finishLine(said[0])
    try settle()
    try cue.idle()
    try cue.acknowledged("Too late", clear)
    try settle()
    try Effect.try(() => assert.deepStrictEqual(said.map((entry) => entry.line), ["Sure."]))
  }
})

it.effect(`the cue speaks as soon as the acknowledgment arrives, with no clock time passing (spec/voice/acknowledgement.md, "The cue speaks as soon as the acknowledgment arrives, and only with the microphone retired or held open for barge-in")`, () => effect {
  const said: Said[] = []
  provide speaker(said, true) {
    const cue = try acknowledgement()
    try cue.acknowledged("Let me check your calendar.", clear)
    try settle()
    const atOnce = { lines: said.map((entry) => entry.line), audible: try cue.audible() }
    try finishLine(said[0])
    try settle()
    try cue.idle()
    try Effect.try(() => assert.deepStrictEqual(atOnce, { lines: ["Let me check your calendar."], audible: true }))
  }
})

it.effect(`a cue still being synthesised is dropped at once, and a late start cannot hold the reply (spec/voice/acknowledgement.md, "A reply ready before the cue is audible drops it at once")`, () => effect {
  const said: Said[] = []
  provide speaker(said, false) {
    const cue = try acknowledgement()
    try cue.acknowledged("Looking that up.", clear)
    try settle()
    const asked = said.length
    try cue.idle()
    const droppedAtOnce = said[0]?.stopped
    try said[0]!.start()
    try settle()
    const heard = try cue.audible()
    try cue.idle()
    try Effect.try(() => assert.deepStrictEqual({ asked, droppedAtOnce, heard }, { asked: 1, droppedAtOnce: true, heard: false }))
  }
})

it.effect(`an audible cue finishes before the reply speaks (spec/voice/acknowledgement.md, "An audible cue finishes before the reply speaks, but never holds a ready reply more than 2.5 seconds")`, () => effect {
  const said: Said[] = []
  provide speaker(said, true) {
    const cue = try acknowledgement()
    try cue.acknowledged("Checking your notes.", clear)
    try settle()
    const heard = try cue.audible()
    let replied = false
    const reply = fork effect {
      try cue.idle()
      replied = true
    }
    try settle()
    const waited = !replied && said[0]?.stopped === false
    try finishLine(said[0])
    try settle()
    try join reply
    try TestClock.adjust("3 seconds")
    try settle()
    try Effect.try(() => assert.deepStrictEqual({ heard, waited, replied, cut: said[0]?.stopped }, { heard: true, waited: true, replied: true, cut: false }))
  }
})

it.effect(`a cue still playing at the bound is cut and the reply goes on (spec/voice/acknowledgement.md, "An audible cue finishes before the reply speaks, but never holds a ready reply more than 2.5 seconds")`, () => effect {
  const said: Said[] = []
  provide speaker(said, true) {
    const cue = try acknowledgement()
    try cue.acknowledged("Let me check your calendar.", clear)
    try settle()
    let replied = false
    const reply = fork effect {
      try cue.idle()
      replied = true
    }
    try settle()
    try TestClock.adjust("2499 millis")
    try settle()
    const beforeTheBound = { replied, cut: said[0]?.stopped }
    try TestClock.adjust("1 millis")
    try settle()
    try join reply
    try Effect.try(() => assert.deepStrictEqual({ beforeTheBound, replied, cut: said[0]?.stopped }, { beforeTheBound: { replied: false, cut: false }, replied: true, cut: true }))
  }
})

it.effect(`Stop cuts a playing cue at once and nothing restarts it (spec/voice/acknowledgement.md, "A turn abort, Stop, speaking over it or voice retiring stops the cue at once, and nothing restarts it")`, () => effect {
  const said: Said[] = []
  provide speaker(said, true) {
    const cue = try acknowledgement()
    try cue.acknowledged("Checking your calendar.", clear)
    try settle()
    try cue.cancel()
    const stopped = said[0]?.stopped
    try cue.acknowledged("Checking again.", clear)
    try settle()
    try cue.idle()
    try Effect.try(() => assert.deepStrictEqual({ stopped, lines: said.length }, { stopped: true, lines: 1 }))
  }
})

it.effect(`a recorded clip's microphone must be closed before the cue (spec/voice/acknowledgement.md, "The cue speaks as soon as the acknowledgment arrives, and only with the microphone retired or held open for barge-in")`, () => effect {
  const said: Said[] = []
  provide speaker(said, true) {
    const open = try acknowledgement()
    try open.acknowledged("Checking your calendar.", () => false)
    try settle()
    const whileOpen = said.length
    let closed = true
    try open.acknowledged("Checking your calendar.", () => closed)
    closed = false
    try settle()
    const reopenedBeforeItStarted = said.length
    const retired = try acknowledgement()
    try retired.acknowledged("Checking your calendar.", clear)
    try settle()
    try finishLine(said[0])
    try settle()
    try retired.idle()
    try Effect.try(() => assert.deepStrictEqual({ whileOpen, reopenedBeforeItStarted, spoken: said.length }, { whileOpen: 0, reopenedBeforeItStarted: 0, spoken: 1 }))
  }
})

it.effect(`the cue model never lets a reply start over an audible cue (spec/voice/acknowledgement.md, "An audible cue finishes before the reply speaks, but never holds a ready reply more than 2.5 seconds")`, () => effect {
  const taken = acknowledged(initial, 22, true)
  const playing = audible(taken)
  const waiting = replyReady(playing)
  const silenced = replyReady(taken)
  try Effect.try(() => assert.deepStrictEqual({
    waiting: [waiting.speaking, replyMayStart(waiting, 0), replyMayStart(waiting, 2499)],
    afterItsEnd: replyMayStart(ended(waiting), 0),
    atItsBound: replyMayStart(waiting, 2500),
    silenced: [silenced.used, silenced.heard, replyMayStart(silenced, 0)],
    stopped: [cancel(playing).speaking, replyMayStart(cancel(playing), 0)],
    unclear: acknowledged(initial, 22, false).used,
    tooLong: acknowledged(initial, 121, true).used,
  }, {
    waiting: [true, false, false], afterItsEnd: true, atItsBound: true, silenced: [true, 0, true],
    stopped: [false, true], unclear: false, tooLong: false,
  }))
})

it.effect(`a turn aborted before its cue is audible says nothing (spec/voice/acknowledgement.md, "A turn abort, Stop, speaking over it or voice retiring stops the cue at once, and nothing restarts it")`, () => effect {
  const said: Said[] = []
  provide speaker(said, false) {
    const cue = try acknowledgement()
    try cue.acknowledged("Checking your notes.", clear)
    try settle()
    try cue.cancel()
    try TestClock.adjust("1 second")
    try settle()
    try cue.idle()
    const audibleAfter = try cue.audible()
    try Effect.try(() => assert.deepStrictEqual({ asked: said.length, stopped: said[0]?.stopped, audible: audibleAfter }, { asked: 1, stopped: true, audible: false }))
  }
})

it.effect(`a cue that already ended lets the reply start at once, and the turn never repeats it (spec/voice/acknowledgement.md, "Only the agent's acknowledgment, of 1 to 120 characters, is spoken, and only once a turn")`, () => effect {
  const said: Said[] = []
  provide speaker(said, true) {
    const cue = try acknowledgement()
    try cue.acknowledged("Checking your saved notes.", clear)
    try settle()
    try finishLine(said[0])
    try settle()
    const endedBeforeTheReply = !(try cue.audible())
    try cue.idle()
    try cue.acknowledged("Different words", clear)
    try settle()
    try Effect.try(() => assert.deepStrictEqual({ endedBeforeTheReply, lines: said.map((entry) => entry.line), cut: said[0]?.stopped }, { endedBeforeTheReply: true, lines: ["Checking your saved notes."], cut: false }))
  }
})

const encoder = new TextEncoder()

/** A reply stream as the agent writes it: the cue as text, its acknowledgment, a restart, a tool, the reply; `beforeTool` runs just before the tool frame. */
async function* agentStream(beforeTool: () => void): AsyncGenerator<Uint8Array> {
  const frame = (value: unknown) => encoder.encode(`data: ${JSON.stringify(value)}\n\n`)
  yield frame({ type: "status", activity: "thinking" })
  yield frame({ type: "token", text: "Let me check your calendar." })
  yield frame({ type: "acknowledgment", text: "Let me check your calendar." })
  yield frame({ type: "token", fullText: "" })
  await new Promise((resolve) => setTimeout(resolve, 0))
  beforeTool()
  yield frame({ type: "tool", name: "CALENDAR", label: "Using Calendar" })
  yield frame({ type: "token", text: "You have two meetings." })
  yield frame({ type: "reply_ready", fullText: "You have two meetings.", actionResults: [] })
  yield frame({ type: "done", fullText: "You have two meetings.", messageId: "m1", userMessageId: "u1", agentName: "Alpha", actionResults: [] })
}

it.live("a voice turn speaks the agent's acknowledgment before its tool runs, and the cue's own text never readies the reply (spec/voice/acknowledgement.md, \"A reply ready before the cue is audible drops it at once\")", () => effect {
  const said: Said[] = []
  provide speaker(said, true) {
    const cue = try acknowledgement()
    let beforeTool: readonly string[] = []
    let firstTexts = 0
    const hooks = voiceReplyHooks(cue, clear, () => { firstTexts += 1 })
    const outcome = try promise(() => readReplyStream(agentStream(() => { beforeTool = said.map((entry) => entry.line) }), hooks))
    try settle()
    const waitedForTheCue = !said[0]?.stopped && (try cue.audible())
    try finishLine(said[0])
    try cue.idle()
    try Effect.try(() => assert.deepStrictEqual(
      { beforeTool, waitedForTheCue, firstTexts, lines: said.map((entry) => entry.line), cut: said[0]?.stopped, reply: outcome.kind === "Done" ? outcome.text : outcome.kind },
      { beforeTool: ["Let me check your calendar."], waitedForTheCue: true, firstTexts: 1, lines: ["Let me check your calendar."], cut: false, reply: "You have two meetings." },
    ))
  }
})
