{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "lib": ["es2024", "dom", "dom.iterable"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "jsx": "react-jsx",
    // Calendar requests use the pinned SDK's generated named-read machine.
    "rootDir": "../..",
    "rootDirs": [".", ".vibe/declarations"],
    "outDir": "dist",
    "noEmitOnError": true,
    "rewriteRelativeImportExtensions": true,
    // The upstream build produces the pinned SDK declarations this project typechecks against.
    "plugins": [{ "name": "@effect/language-service" }]
  },
  "include": ["src", "test", "gen/*.ts", "gen/*.vibe"],
  // A story's metadata imports its type from the tool, outside rootDir; the stories read it (`pnpm stories`).
  "exclude": ["src/**/*.meta.tsx"],
  "vibe": {
    "sidecarDir": ".vibe/declarations",
    // Generated renderer models use Effect's pinned persistence API.
    "severities": { "EK38130": "suggestion" }
  }
}
