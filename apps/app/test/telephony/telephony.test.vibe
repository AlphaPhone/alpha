// spec/telephony/common.md, "A question for Alpha leaves the bar only once a turn took it"; spec/telephony/callBar.md, "The bar shows only on a trusted reading, where it may show, while a call is live"; spec/assistant/receipts.md, "An action is reconciled as applied only with its exact saved receipt, and only a handoff may stay unresolved"; spec/telephony/phone.md, "Story: Read my recent calls while Phone is open"; spec/telephony/drafts.md, "Story: Send only what I reviewed, once"; spec/telephony/contacts.md, "Story: Change only the contact I reviewed"; spec/telephony/actions.md, "Story: Call or text only the person I approved"; spec/telephony/callBar.md, "Story: See my live call over every view"
import { assert, it } from "@effect/vitest"
import { Machine as CallBarMachine, barPhase } from "../../gen/telephony__callBar.effect.vibe"
import { Machine as ContactsMachine } from "../../gen/telephony__contacts.effect.vibe"
import { Machine as DraftsMachine, slotOf } from "../../gen/telephony__drafts.effect.vibe"
import { Machine as PhoneMachine } from "../../gen/telephony__phone.effect.vibe"
import { Assistant } from "../../src/assistant/assistant.vibe"
import { contactChangeLines, TelephonyActions } from "../../src/telephony/actions.vibe"
import { Machine as ActionsMachine } from "../../gen/telephony__actions.effect.vibe"
import { barEligibleIn } from "../../src/telephony/front.vibe"
import { askFromList } from "../../src/telephony/list-ask.vibe"
import { advertisedOf, classOf, handoffOf } from "../../src/telephony/operations.vibe"
import { CallWatch } from "../../src/telephony/call-bar.vibe"
import { ContactsView } from "../../src/telephony/contacts.vibe"
import { DraftSends } from "../../src/telephony/drafts.vibe"
import { PhoneView } from "../../src/telephony/phone.vibe"
import { fakePhone, until } from "./fakes.vibe"

it.live("Read my recent calls and call a number myself (spec/telephony/phone.md, \"Story: Call a number myself\")", () => effect {
  const fake = fakePhone()
  provide fake.layer {
    const view = try PhoneView
    const phone = try PhoneMachine
    const visit = fork view.visit()
    // spec/telephony/phone.md, "Only the latest read publishes, and rows already shown stay until it answers"
    try until(phone.changes, (p) => p.access === "LogNeeded")
    try view.refresh(true)
    const read = try phone.get()
    // spec/telephony/phone.md, "Dial hands one number at a time to Telecom, and only from the showing it started in"
    try view.dial("call me")
    try view.dial("415-555-0100")
    const dialed = try phone.get()
    try Fiber.interrupt(visit)
    const left = try phone.get()
    try Effect.try(() => assert.deepStrictEqual({
      read: [read.access, read.recents.map((r) => [r.title, r.kind, r.fresh])],
      dialed: [dialed.notice, dialed.dialing],
      left: [left.shown, left.recents.length, left.number],
      calls: fake.calls.filter((c) => ["requestAccess", "placeCall", "dial"].includes(c)),
    }, {
      read: ["LogGranted", [["Maya Chen", "MissedCall", true]]],
      dialed: [{ tag: "Placement", outcome: "DialerOpened" }, false],
      left: [false, 0, ""],
      calls: ["requestAccess", "placeCall", "dial"],
    }))
  }
})

it.live("Send only what I reviewed, once (spec/telephony/drafts.md, \"Story: Send only what I reviewed, once\")", () => effect {
  const fake = fakePhone()
  provide fake.layer {
    const drafts = try DraftsMachine
    const sends = try DraftSends
    const thread = "thread:1"
    try drafts.send({ type: "ownerTyped", thread, recipients: ["4155550100"], text: "On my" }, "Owner")
    // spec/telephony/drafts.md, "Alpha's draft goes only into an unoccupied slot addressed to exactly the same people, and keeps one Undo"
    const elsewhere = try sends.placeAlphaDraft(thread, ["4155550111"], "Hi")
    const placed = try sends.placeAlphaDraft(thread, ["4155550100"], "Running late")
    const alphaSend = (drafts.send({ type: "sendStarted", thread, operationId: "op1", kind: "SmsSend", sim: 7 }, "Alpha") catch () => "Rejected")
    const drafted = slotOf((try drafts.get()).slots, thread)
    // spec/telephony/drafts.md, "An accepted send clears the slot, a definite refusal releases its operation, and an unknown outcome keeps it"
    try sends.send(thread)
    const unknown = slotOf((try drafts.get()).slots, thread)
    const blocked = try sends.placeAlphaDraft(thread, ["4155550100"], "Another")
    try sends.send(thread)
    const settled = slotOf((try drafts.get()).slots, thread)
    try Effect.try(() => assert.deepStrictEqual({
      placed: [elsewhere, placed, alphaSend, drafted.author, drafted.undo],
      unknown: [unknown.outcome, unknown.operation.tag, unknown.text, blocked],
      settled: [settled.text, settled.operation.tag, fake.sent()],
    }, {
      placed: ["unavailable", "drafted", "Rejected", "ByAlpha", { tag: "UndoTo", undoText: "On my", undoAuthor: "ByOwner" }],
      unknown: ["Unconfirmed", "BoundOperation", "Running late", "occupied"],
      settled: ["", "NoOperation", 1],
    }))
  }
})

it.live("Change only the contact I reviewed (spec/telephony/contacts.md, \"Story: Change only the contact I reviewed\")", () => effect {
  const fake = fakePhone()
  provide fake.layer {
    const view = try ContactsView
    const contacts = try ContactsMachine
    const visit = fork view.visit()
    try until(contacts.changes, (c) => c.rows.length === 1 && !c.loading)
    try view.open("7")
    try until(contacts.changes, (c) => c.detail.tag === "DetailRead")
    try view.edit("Editing")
    try contacts.send({ type: "edited" })
    try view.save({ displayName: "Maya Chen", givenName: "Maya", familyName: "Chen", phoneNumbers: [{ number: "4155550100", type: "mobile" }], emailAddresses: [] })
    const lost = try contacts.get()
    // spec/telephony/contacts.md, "A write holds the gate while it runs, and a lost answer blocks every write until an explicit read that began after it"
    try view.read("", false)
    const automatic = try contacts.get()
    try view.read("", true)
    const explicit = try contacts.get()
    try Fiber.interrupt(visit)
    try Effect.try(() => assert.deepStrictEqual(
      { lost: [lost.gate, lost.editor.tag, lost.notice], automatic: automatic.gate, explicit: explicit.gate },
      { lost: ["WriteUnsettled", "EditorClosed", "OutcomeUnknown"], automatic: "WriteUnsettled", explicit: "WriteIdle" },
    ))
  }
})

it.live("Call only the person I approved (spec/telephony/actions.md, \"Story: Call or text only the person I approved\")", () => effect {
  const fake = fakePhone()
  provide fake.layer {
    const actions = try TelephonyActions
    // spec/telephony/actions.md, "An action starts once per operation ID, and a number the owner did not write is refused"
    const ungrounded = try actions.run({ type: "phone_call", target: { kind: "number", number: "4155550199" } }, "op-1", { text: "call 415-555-0100" })
    const repeated = (actions.run({ type: "phone_call", target: { kind: "number", number: "4155550100" } }, "op-1", { text: "call 415-555-0100" }) catch (e) => e._tag)
    // spec/telephony/actions.md, "An effect dispatches only after a fresh call-state reading allows it"
    try sync(() => { fake.world.callState = { inCall: true, emergency: null, emergencyLive: true, watching: true } })
    const emergency = try actions.run({ type: "phone_call", target: { kind: "number", number: "4155550100" } }, "op-2", { text: "call 415-555-0100" })
    try Effect.try(() => assert.deepStrictEqual(
      { ungrounded: ungrounded.settled, repeated, emergency: emergency.settled, placed: fake.calls.filter((c) => c === "placeCall").length },
      { ungrounded: "Refused", repeated: "AlreadyRan", emergency: "Refused", placed: 0 },
    ))
  }
})

it.live("See my live call over every view (spec/telephony/callBar.md, \"Story: See my live call over every view\")", () => effect {
  const fake = fakePhone()
  provide fake.layer {
    const watch = try CallWatch
    const bar = try CallBarMachine
    try watch.eligible(true)
    try sync(() => { fake.world.ongoing = { calls: [{ id: "c1", state: "active", connectedAt: 1000 }] } })
    try watch.refresh()
    const live = barPhase(try bar.get())
    // spec/telephony/callBar.md, "Return and End act only on the call the bar shows, and End is asked once"
    try watch.end("c1")
    try sync(() => { fake.world.ongoing = { calls: [{ id: "c1", state: "active", connectedAt: 1000, extra: 1 }] } })
    try watch.refresh()
    const untrusted = barPhase(try bar.get())
    try Effect.try(() => assert.deepStrictEqual(
      { live, untrusted, ended: fake.calls.filter((c) => c === "AlphaOngoingCall.endCall").length },
      { live: "LiveBar", untrusted: "NoBar", ended: 1 },
    ))
  }
})

const QUESTION = "what should I say back to her?"
const asked: string[] = []
const heard = (taken: boolean) => Layer.succeed(Assistant, {
  commsAsks: Stream.never,
  askComms: (key: string, text: string) => sync(() => (asked.push(`${key}|${text}`), taken)),
} as unknown as Assistant.Shape)

it.live("A question a turn took leaves the bar (spec/telephony/common.md, \"A question for Alpha leaves the bar only once a turn took it\")", () => effect {
  const fake = fakePhone()
  const layer = Layer.merge(fake.layer, heard(true))
  provide layer {
    const phone = try PhoneMachine
    asked.length = 0
    try phone.send({ type: "queryTyped", typed: QUESTION })
    const line = try askFromList("phone", "phone:recents:", QUESTION)
    const after = (try phone.get()).listQuery
    // The same text asked again is a new question for the assistant, not a route it already followed.
    try phone.send({ type: "queryTyped", typed: QUESTION })
    try askFromList("phone", "phone:recents:", QUESTION)
    try Effect.try(() => assert.deepStrictEqual(
      { line, after: after.tag, opened: fake.calls.filter((c) => c.startsWith("navigation.open:assistant")), asked },
      { line: null, after: "NoQuery", opened: ["navigation.open:assistant:comms:phone:recents:", "navigation.open:assistant:comms:phone:recents:"],
        asked: [`phone:recents:|${QUESTION}`, `phone:recents:|${QUESTION}`] },
    ))
  }
})

it.live("A question no turn took stays where it was typed (spec/telephony/common.md, \"A question for Alpha leaves the bar only once a turn took it\")", () => effect {
  const fake = fakePhone()
  const layer = Layer.merge(fake.layer, heard(false))
  provide layer {
    const phone = try PhoneMachine
    try phone.send({ type: "queryTyped", typed: QUESTION })
    const line = try askFromList("phone", "phone:recents:", QUESTION)
    const after = (try phone.get()).listQuery
    try Effect.try(() => assert.deepStrictEqual(
      { line, after },
      { line: null, after: { tag: "OwnerQuery", typed: QUESTION } },
    ))
  }
})

it("The call bar stays off Android's assistant surface only (spec/telephony/callBar.md, \"The bar shows only on a trusted reading, where it may show, while a call is live\")", () => {
  const front = { visible: true, locked: false, screen: "home" as const, view: "assistant", shade: false, chat: "closed" as const, modal: false }
  assert.deepStrictEqual(
    [barEligibleIn(front), barEligibleIn({ ...front, assistantSurface: true }), barEligibleIn({ ...front, assistantSurface: false, locked: true })],
    [true, false, false],
  )
})

it("Calls, texts, reads and contact changes are reviewed comms acts, and only reads may not stay unresolved (spec/assistant/receipts.md, \"An action is reconciled as applied only with its exact saved receipt, and only a handoff may stay unresolved\")", () => {
  assert.deepStrictEqual(
    {
      classes: [classOf({ type: "contact_show", query: "maya" }), classOf({ type: "phone_keypad" }), classOf({ type: "phone_call", target: { kind: "number", number: "4155550100" } }), classOf({ type: "messages_read_selected" })],
      handoffs: [handoffOf({ type: "sms_send", recipients: ["4155550100"], body: "hi", subscriptionId: 1 }), handoffOf({ type: "phone_dial", target: { kind: "number", number: "4155550100" } }), handoffOf({ type: "contact_update", query: "maya", set: { displayName: "Maya" } }), handoffOf({ type: "messages_read_selected" }), handoffOf({ type: "sms_latest_sender" })],
      advertised: advertisedOf(["sms.send.v1", "sms.latest-sender.v2", "phone.call.v1"], ["sms.send.v1", "sms.latest-sender.v2", "calendar.create.v1"]),
    },
    {
      classes: ["OpenView", "OpenView", "CommsAct", "CommsAct"],
      handoffs: [true, true, true, false, false],
      advertised: ["sms.send.v1"],
    },
  )
})

it("A contact change says in words what it renames, removes, adds and keeps (spec/telephony/actions.md, \"A name is looked up on the phone and the owner picks the exact number, even for one match\")", () => {
  const before = { id: "1", lookup: "k1", version: "a".repeat(64), displayName: "Test Alpha", givenName: "Test", familyName: "Alpha", starred: false, phoneNumbers: [{ number: "+14155550100", type: "mobile" as const }], emailAddresses: [{ address: "ta@example.com", type: "home" as const }] }
  const draft = (phoneNumbers: { number: string; type: "mobile" | "work" }[], displayName = "Test Alpha") => ({ displayName, phoneNumbers, emailAddresses: [{ address: "TA@example.com", type: "home" as const }] })
  const next = { number: "4155550101", type: "mobile" as const }
  const marks = (lines: ReturnType<typeof contactChangeLines>) => lines.map((line) => [line.change, line.text])
  assert.deepStrictEqual({
    // A replace names the number that goes as removed, never as if it stays; an address differing only in case is kept.
    replace: marks(contactChangeLines(before, draft([next]))),
    // An add keeps the old number however it is written.
    add: marks(contactChangeLines(before, draft([{ number: "(415) 555-0100", type: "mobile" }, next]))),
    rename: marks(contactChangeLines(before, draft([before.phoneNumbers[0]!], "T. Alpha"))),
  }, {
    replace: [["remove", "+14155550100"], ["add", "4155550101"], ["keep", "TA@example.com"]],
    add: [["keep", "(415) 555-0100"], ["add", "4155550101"], ["keep", "TA@example.com"]],
    rename: [["rename", "Test Alpha"], ["keep", "+14155550100"], ["keep", "TA@example.com"]],
  })
})

it.live("A new contact's Add anyway review never says more contacts match (spec/telephony/actions.md, \"A name is looked up on the phone and the owner picks the exact number, even for one match\")", () => effect {
  const fake = fakePhone()
  provide fake.layer {
    const actions = try TelephonyActions
    const machine = try ActionsMachine
    // Eleven contacts match the new contact's name: a listing would say more than ten match, a twin search does not.
    try sync(() => {
      fake.world.contacts = Array.from({ length: 11 }, (_, at) => ({ id: String(at + 1), lookup: `k${at + 1}`, name: `Maya ${at + 1}`, revision: "r1", starred: false, phones: [`41555502${String(at).padStart(2, "0")}`], emails: [] }))
    })
    const run = fork actions.run({ type: "contact_create", contact: { displayName: "Maya", phoneNumbers: ["4155550200"], emailAddresses: [] } }, "op-twin", { text: "add Maya 415-555-0200" })
    try until(machine.changes, (a) => a.ongoing.tag === "Choosing" || a.ongoing.tag === "Finished")
    const choosing = try machine.get()
    const review = try actions.review()
    try actions.dismiss()
    const done = try Fiber.join(run)
    try Effect.try(() => assert.deepStrictEqual(
      { candidates: choosing.ongoing.tag === "Choosing" ? choosing.ongoing.candidates.map((c) => [c.candidateId, c.title]) : [], more: review.more, settled: done.settled },
      { candidates: [["add-anyway", "Maya 1"]], more: undefined, settled: "OwnerCancelled" },
    ))
  }
})
