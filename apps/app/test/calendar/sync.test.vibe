// spec/calendar/sync.md, "Story: Change Calendar sync only from a review of the current link"; spec/calendar/sync.md, "Story: Sync only with my consent for what I reviewed"; spec/calendar/nativeSync.md, "Story: Turn device sync on only through Android's consent, and off for every review at once"; spec/calendar/googleLink.md, "Story: Link a Google calendar I can write to, and be told it is synced only when it is"; spec/calendar/googleLink.md, "Story: Choose how Google reaches my calendar"; spec/calendar/disconnect.md, "Story: Revoke Google's access without waiting on Calendar"; spec/calendar/linkedLocal.md, "Story: Let sync change my local calendar only where I have not changed it since"
import { describe, it } from "@effect/vitest"
import type { LinkedCalendarSemanticEvent } from "@elizaos/plugin-calendar/linked-sync"
import { NativeFailed } from "../../src/platform/native.vibe"
import { bindCalendar, readCalendar } from "../../src/calendar/binding.vibe"
import { crossesToPhone, linkedLocalCalls } from "../../src/calendar/linkedLocal.vibe"
import { CalendarSync } from "../../src/calendar/sync.vibe"
import { binding, calendarOver, same } from "./harness.vibe"
import { CalendarAgentFake, DeviceCalendarFake } from "./resident-fake.ts"

/** The agent's routes, remembering every request. */
class CountingAgent extends CalendarAgentFake {
  seen: string[] = []

  override json(method: string, path: string, body: unknown): { status: number; data: unknown } {
    this.seen.push(`${method} ${path}`)
    return super.json(method, path, body)
  }
}

const event: LinkedCalendarSemanticEvent = { title: "Run", description: "", location: "", startAt: "2026-11-20T10:00:00.000Z", endAt: "2026-11-20T11:00:00.000Z",
  timeZone: "UTC", isAllDay: false, attendees: [{ email: "ada@example.com", optional: false }] }
const REVISION = "a".repeat(64)

describe("Google Calendar sync (spec/calendar/sync.md, spec/calendar/googleLink.md, spec/calendar/nativeSync.md, spec/calendar/disconnect.md, spec/calendar/linkedLocal.md)", () => {
  it.effect("a review that cannot read the link changes nothing (spec/calendar/sync.md, \"Story: Change Calendar sync only from a review of the current link\")", () => effect {
    const agent = new CountingAgent()
    provide calendarOver(agent, new DeviceCalendarFake()) {
      try bindCalendar(binding)
      try readCalendar(false, false)
      const sync = try CalendarSync
      try sync.change("PauseSync")
      const view = try sync.view()
      try same([view.review, agent.seen.some((line) => !line.startsWith("GET "))], [undefined, false])
    }
  })

  it.effect("consent follows a review of this owner at the current local revision (spec/calendar/sync.md, \"Story: Sync only with my consent for what I reviewed\")", () => effect {
    provide calendarOver(new CalendarAgentFake(), new DeviceCalendarFake()) {
      try bindCalendar(binding)
      try readCalendar(false, false)
      const sync = try CalendarSync
      try sync.bind(binding, false)
      try sync.giveConsent()
      const unreviewed = (try sync.view()).control.consent
      try sync.reviewConsent()
      try sync.localChanged()
      try sync.giveConsent()
      const stale = (try sync.view()).control.consent
      try sync.reviewConsent()
      try sync.giveConsent()
      const given = (try sync.view()).control.consent
      try same([unreviewed, stale, given, try sync.word()], [false, false, true, "paused"])
    }
  })

  it.effect("device sync turns on only after Android's own review prepared it (spec/calendar/nativeSync.md, \"Story: Turn device sync on only through Android's consent, and off for every review at once\")", () => effect {
    const phone = new DeviceCalendarFake()
    provide calendarOver(new CalendarAgentFake(), phone) {
      const sync = try CalendarSync
      try sync.deviceEnable()
      try same([(try sync.view()).device.durable === "ConsentEnabled", phone.calls.filter((call) => call === "sync").length <= 1], [false, true])
    }
  })

  it.effect("a read-only grant links nothing and writes nothing (spec/calendar/googleLink.md, \"Story: Link a Google calendar I can write to, and be told it is synced only when it is\")", () => effect {
    const agent = new CountingAgent()
    provide calendarOver(agent, new DeviceCalendarFake()) {
      try bindCalendar(binding)
      try readCalendar(false, false)
      const sync = try CalendarSync
      try sync.link("ReadOnlyGrant", [])
      try same([(try sync.view()).link.phase === "WritingControl", agent.seen.some((line) => !line.startsWith("GET "))], [false, false])
    }
  })

  it.effect("no grant sends nothing, and a write grant is the only one that reviews the link (spec/calendar/googleLink.md, \"Story: Choose how Google reaches my calendar\")", () => effect {
    const agent = new CountingAgent()
    provide calendarOver(agent, new DeviceCalendarFake()) {
      try bindCalendar(binding)
      try readCalendar(false, false)
      const before = agent.seen.length
      try (try CalendarSync).link("NoGoogleGrant", [])
      try same(agent.seen.length, before)
    }
  })

  it.live("Google's access is revoked even while Calendar's cleanup cannot run (spec/calendar/disconnect.md, \"Story: Revoke Google's access without waiting on Calendar\")", () => effect {
    provide calendarOver(new CalendarAgentFake(), new DeviceCalendarFake()) {
      let revoked = false
      try (try CalendarSync).disconnect("ReviewNoControl", true, sync(() => {
        revoked = true
        return true
      }))
      try sleep("50 millis")
      try same(revoked, true)
    }
  })

  it.effect("the phone's calendar is changed only for a bound controller and an event that keeps every field (spec/calendar/linkedLocal.md, \"Story: Let sync change my local calendar only where I have not changed it since\")", () => effect {
    const calls: string[] = []
    const native = {
      available: () => succeed(true),
      invoke: (plugin: string, method: string, args?: unknown) => {
        const kind = String((args as { kind?: unknown } | undefined)?.kind ?? method)
        calls.push(kind)
        if (kind === "get") return succeed({ status: "pending" } as unknown)
        if (kind === "apply") return succeed({ status: "conflict" } as unknown)
        return Effect.fail(new NativeFailed({ plugin, method, message: "unexpected" }))
      },
      listen: () => Stream.empty,
    }
    let bound = true
    const port = linkedLocalCalls(native, { lease: "00000000-0000-4000-8000-000000000000", binding: {} }, () => bound, new AbortController().signal)
    // spec/calendar/linkedLocal.md, "Sync fields keep only what both sides can say"
    try same([crossesToPhone(event), crossesToPhone({ ...event, recurrence: ["RRULE:FREQ=MONTHLY"] }), crossesToPhone({ ...event, attendees: [{ email: "x", optional: false }] })], [true, false, false])
    const lossy = effect { try port.apply("7", { ...event, title: " " }, REVISION); return "applied" } catch (error) => error._tag === "LinkedLocalRefused" ? error.status : error._tag
    const pending = effect { try port.get("7"); return "read" } catch (error) => error._tag === "LinkedLocalRefused" ? error.status : error._tag
    const changed = effect { try port.apply("7", event, REVISION); return "applied" } catch (error) => error._tag === "LinkedLocalRefused" ? error.status : error._tag
    bound = false
    const before = calls.length
    const unbound = effect { try port.get("7"); return "read" } catch (error) => error._tag
    try same([lossy, pending, changed, unbound, calls.length === before, calls.includes("delete")], ["unsupported", "pending", "conflict", "LinkedLocalAborted", true, false])
  })
})
