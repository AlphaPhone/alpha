// spec/calendar/deviceSync.md, "Story: Sync my phone's calendar only with the Google calendar I chose, for the account I use"
import { describe, it } from "@effect/vitest"
import { initial as sessionInitial } from "../../gen/account__session.ts"
import { Native, NativeUnavailable } from "../../src/platform/native.vibe"
import { memoryStore } from "../../src/platform/storage.vibe"
import { legacySelectionKey, syncIdentity, unreadyReason } from "../../src/calendar/deviceSync.vibe"
import { SYNC_SETTINGS_SLOT, calendarLinkStorage } from "../../src/calendar/linkStorage.vibe"
import { canonicalSyncRecurrence } from "../../src/calendar/syncRecurrence.ts"
import { same } from "./harness.vibe"

const signedIn = { ...sessionInitial, loaded: true, phase: "SignedIn" as const, generation: 3,
  account: { userId: "6f1d0c2a-1b2c-4d3e-8f4a-5b6c7d8e9f01", organizationId: "1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d", credentialId: "key-1", expiresAt: 0 } }
const agent = { owner: "owner-1", session: 4, agentId: "agent-1", usable: true }
const chosen = { connectionId: "0f6c2a8e-3b1d-4c5e-9a7f-1e2d3c4b5a69", providerCalendarId: "primary", name: "Primary", account: "owner@example.com" }

/** A phone without the secure store: checkpoints go to the WebView's private storage. */
const browserPhone = Layer.succeed(Native, {
  available: () => succeed(false),
  invoke: (plugin: string, method: string) => Effect.fail(new NativeUnavailable({ plugin, method })),
  listen: () => Stream.empty,
})

/** A phone whose secure store keeps slots in `slots`. */
function securePhone(slots: Map<string, string>) {
  return Layer.succeed(Native, {
    available: (plugin: string) => succeed(plugin === "ElizaSecureStore"),
    invoke: (plugin: string, method: string, args?: unknown) => sync(() => {
      const input = args as { key: string; expected?: string | null; value?: string | null }
      if (method === "get") return slots.has(input.key) ? { ok: true, value: slots.get(input.key) } : { ok: false, error: "not_found" }
      if ((slots.get(input.key) ?? null) !== (input.expected ?? null)) return { ok: false, error: "conflict" }
      if (input.value === null || input.value === undefined) slots.delete(input.key)
      else slots.set(input.key, input.value)
      return { ok: true, outcome: "written" }
    }),
    listen: () => Stream.empty,
  })
}

describe("device Calendar sync (spec/calendar/deviceSync.md)", () => {
  // spec/calendar/deviceSync.md, "A pass is prepared only for a signed-in production Cloud account with an agent and a chosen Google calendar"
  it.effect("a pass needs the phone, a production account, its agent and a chosen calendar (spec/calendar/deviceSync.md, \"A pass is prepared only for a signed-in production Cloud account with an agent and a chosen Google calendar\")", () => effect {
    try same([
      unreadyReason(true, true, true, true, true),
      unreadyReason(true, true, true, true, false),
      unreadyReason(false, true, true, true, true),
      unreadyReason(true, false, true, true, true),
      unreadyReason(true, true, true, false, true),
    ], [
      undefined,
      "Device Calendar sync requires Android.",
      "Connect your Cloud account and agent before enabling Calendar sync.",
      "Device Calendar sync requires the production Cloud account; no other environment was used.",
      "Choose a Google calendar for sync first.",
    ])
  })

  // spec/calendar/deviceSync.md, "A pass belongs to the identity it was prepared under; a changed account, key, Cloud session, choice or agent session retires it"
  it.effect("the identity changes with the key, the sign-in, the choice and the agent session, and is empty while any is missing (spec/calendar/deviceSync.md, \"A pass belongs to the identity it was prepared under; a changed account, key, Cloud session, choice or agent session retires it\")", () => effect {
    const base = syncIdentity(signedIn, agent, chosen)
    try same([
      base !== "",
      syncIdentity({ ...signedIn, account: { ...signedIn.account, credentialId: "key-2" } }, agent, chosen) !== base,
      syncIdentity({ ...signedIn, generation: 4 }, agent, chosen) !== base,
      syncIdentity(signedIn, agent, { ...chosen, providerCalendarId: "team" }) !== base,
      syncIdentity(signedIn, { ...agent, session: 5 }, chosen) !== base,
      syncIdentity(sessionInitial, agent, chosen),
      syncIdentity(signedIn, { ...agent, usable: false }, chosen),
      syncIdentity(signedIn, agent, undefined),
    ], [true, true, true, true, true, "", "", ""])
  })

  // spec/calendar/deviceSync.md, "The owner may choose only a calendar it can write, of a Google account that granted Calendar changes"
  it.effect("the earlier Alpha's choice is read only under the account it names (spec/calendar/deviceSync.md, \"The owner may choose only a calendar it can write, of a Google account that granted Calendar changes\")", () => effect {
    try same(legacySelectionKey(signedIn), `alpha.google-calendar-selection.v1:${JSON.stringify(["production", signedIn.account.userId, signedIn.account.organizationId])}`)
  })

  // spec/calendar/deviceSync.md, "Checkpoints are kept only in the encrypted slot of their own name, never above 4 MiB"
  it.effect("a checkpoint is written only over the value read, only under its own name and never above 4 MiB (spec/calendar/deviceSync.md, \"Checkpoints are kept only in the encrypted slot of their own name, never above 4 MiB\")", () => effect {
    provide Layer.merge(browserPhone, memoryStore) {
      const storage = try calendarLinkStorage()
      const first = try promise(() => storage.compareExchange(SYNC_SETTINGS_SLOT, null, { version: 1, enabled: false }))
      const stale = try promise(() => storage.compareExchange(SYNC_SETTINGS_SLOT, null, { version: 1, enabled: true }))
      const read = try promise(() => storage.read(SYNC_SETTINGS_SLOT))
      const misnamed = try promise(() => storage.read("calendar-linked-sync:v1:short").then(() => "read", () => "refused"))
      const oversized = try promise(() => storage.compareExchange(SYNC_SETTINGS_SLOT, read, { blob: "x".repeat(4 * 1024 * 1024) }).then(() => "written", () => "refused"))
      try same([first.status, stale.status, read, misnamed, oversized], ["saved", "conflict", { version: 1, enabled: false }, "refused", "refused"])
    }
  })

  // spec/calendar/deviceSync.md, "Checkpoints are kept only in the encrypted slot of their own name, never above 4 MiB"
  it.effect("on the phone a checkpoint lives in the secure store's slot of that name (spec/calendar/deviceSync.md, \"Checkpoints are kept only in the encrypted slot of their own name, never above 4 MiB\")", () => effect {
    const slots = new Map<string, string>()
    provide Layer.merge(securePhone(slots), memoryStore) {
      const storage = try calendarLinkStorage()
      const empty = try promise(() => storage.read(SYNC_SETTINGS_SLOT))
      const saved = try promise(() => storage.compareExchange(SYNC_SETTINGS_SLOT, null, { version: 1, enabled: true }))
      const raced = try promise(() => storage.compareExchange(SYNC_SETTINGS_SLOT, { version: 1, enabled: false }, { version: 1, enabled: false }))
      try same([empty, saved.status, raced.status, slots.get(SYNC_SETTINGS_SLOT)], [null, "saved", "conflict", JSON.stringify({ version: 1, enabled: true })])
    }
  })

  // spec/calendar/linkedLocal.md, "Sync fields keep only what both sides can say"
  it.effect("Google's recurrence reads back in the one form Alpha writes, and lines it cannot say stay as they were (spec/calendar/linkedLocal.md, \"Sync fields keep only what both sides can say\")", () => effect {
    try same([
      canonicalSyncRecurrence(["RRULE:BYDAY=TU,MO,WE,FR,TH;FREQ=WEEKLY"], false),
      canonicalSyncRecurrence(["RRULE:FREQ=DAILY", "EXDATE:20261122T100000Z,20261121T100000Z,20261121T100000Z"], false),
      canonicalSyncRecurrence(["RRULE:FREQ=WEEKLY", "EXDATE;VALUE=DATE:20261127"], true),
      canonicalSyncRecurrence(["RRULE:FREQ=MONTHLY;BYMONTHDAY=3"], false),
      canonicalSyncRecurrence([], false),
    ], [
      ["RRULE:FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR"],
      ["RRULE:FREQ=DAILY", "EXDATE:20261121T100000Z,20261122T100000Z"],
      ["RRULE:FREQ=WEEKLY", "EXDATE;VALUE=DATE:20261127"],
      ["RRULE:FREQ=MONTHLY;BYMONTHDAY=3"],
      [],
    ])
  })
})
