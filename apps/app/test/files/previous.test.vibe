// spec/files/recent.md, "Story: Come back to the document I had open"
// @vitest-environment happy-dom
import { assert, it } from "@effect/vitest"
import { Machine as RecentMachine } from "../../gen/files__recent.effect.vibe"
import { FilesPreview } from "../../src/files/preview.vibe"
import { type Call, device, files } from "./harness.vibe"

const PREVIOUS_RECENT = "alpha.files.recent.v1"
const PREVIOUS_OPEN = "alpha.files.open.v1"

/** A phone whose selected-documents registry still holds `held`, the grants the previous Alpha took. */
function phone(held: Set<string>, calls: Call[]) {
  return device((plugin, method, args) =>
    plugin === "AlphaFiles" ? (method === "storageState" ? { status: "ready", access: "granted" } : { status: "ready", entries: [], truncated: false })
    : plugin === "DailyApps" ? (
      method === "describeSelected" ? (held.has(args.selectionId) ? { status: "selected", selectionId: args.selectionId, name: "lease.txt", mimeType: "text/plain" } : { status: "unavailable" })
      : method === "readSelected" ? { status: "read", text: "lease", mimeType: "text/plain", bytes: 5 }
      : method === "restoreSelected" ? { status: "selected", selectionId: "s2" }
      : method === "forgetSelected" ? ((held.delete(args.selectionId)), {})
      : undefined)
    : undefined, calls)
}

it.live("Recent and the document open in the previous Alpha are kept once, newest first (spec/files/recent.md, \"A phone updated from the previous Alpha keeps its Recent and the document it had open\")", () => effect {
  try sync(() => {
    globalThis.localStorage.setItem(PREVIOUS_RECENT, JSON.stringify([
      { key: "selected:s1", kind: "selected", name: "lease.txt", mimeType: "text/plain", openedAt: 10, selectionId: "s1", status: "ready" },
      { key: "scan-pdf:Receipt.pdf", kind: "scan-pdf", name: "Receipt.pdf", mimeType: "application/pdf", openedAt: 30, status: "saved" },
      { key: "selected:s2", kind: "selected", name: "lease.txt", mimeType: "text/plain", openedAt: 20, selectionId: "s2", status: "ready" },
      { key: "selected:s3", kind: "selected", name: "old.txt", mimeType: "text/plain", openedAt: 5, selectionId: "s3", status: "revoked" },
      { key: "bad", kind: "folder", name: "x", mimeType: "", openedAt: 1, status: "ready" },
    ]))
    globalThis.localStorage.setItem(PREVIOUS_OPEN, "s2")
  })
  const calls: Call[] = []
  provide files(phone(new Set(["s1", "s2"]), calls), false) {
    const preview = try FilesPreview
    const recent = try RecentMachine
    const adopted = try recent.get()
    const left = try sync(() => [globalThis.localStorage.getItem(PREVIOUS_RECENT), globalThis.localStorage.getItem(PREVIOUS_OPEN)])
    try preview.enter()
    try preview.restoreOpen()
    const shown = try preview.get()
    try Effect.try(() => assert.deepStrictEqual(
      { rows: adopted.rows.map((r) => [r.key, r.kind, r.status, r.selection]), grants: adopted.grants, restore: adopted.restoreOpen, left,
        shown: [shown.shown, shown.doc.selection] },
      { rows: [["scan:Receipt.pdf", "ScanPdf", "Saved", ""], ["picked:s2", "PickedDoc", "Ready", "s2"], ["picked:s1", "PickedDoc", "Ready", "s1"], ["picked:s3", "PickedDoc", "Revoked", ""]],
        grants: ["s2", "s1"], restore: "s2", left: [null, null], shown: [true, "s2"] },
    ))
  }
})
