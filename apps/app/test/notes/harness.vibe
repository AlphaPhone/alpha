// spec/notes/collection.md, "Story: Read my notes under the account I am signed in as"
import { CloudSession } from "../../src/account/layer.vibe"
import { initial as signedOut } from "../../gen/account__session.effect.vibe"
import { sendsOf } from "../../gen/voice__route.effect.vibe"
import { Build } from "../../src/platform/build.vibe"
import { Native, NativeFailed } from "../../src/platform/native.vibe"
import { Resident } from "../../src/platform/resident.vibe"
import { memoryStore } from "../../src/platform/storage.vibe"
import { Foreground, type ForegroundState } from "../../src/shell/foreground.vibe"
import { VoiceRoute, VoiceRouteFailed, type RouteAttempt } from "../../src/voice/route.vibe"
import { NotesCollection } from "../../src/notes/collection.vibe"
import { layer } from "../../src/notes/layer.vibe"
import type { DeviceFake, NotesAgentFake } from "./resident-fake.ts"

/** Home with nothing over it. */
export const home: ForegroundState = { visible: true, locked: false, screen: "home", view: "", shade: false, chat: "closed", modal: false }

/** The Notes app in front with nothing over it. */
export const inNotes: ForegroundState = { ...home, view: "notes" }

/** Run assertions as an effect, so a failed one fails the test. */
export effect function check(run: () => void) {
  try Effect.try(run)
}

/** The platform, account, voice and shell services the Notes layer needs, over the in-memory resident and device. */
export function fakes(agent: NotesAgentFake, device: DeviceFake, shown?: SubscriptionRef.SubscriptionRef<ForegroundState>) {
  return Layer.mergeAll(
    Layer.succeed(Resident, {
      status: () => succeed("running" as const),
      ensureRunning: () => Effect.void,
      json: (method: "GET" | "POST" | "PUT" | "PATCH" | "DELETE", path: string, body?: unknown) => sync(() => agent.json(method, path, body)),
      stream: () => Stream.empty,
    }),
    Layer.succeed(Native, {
      available: (plugin: string) => sync(() => device.available(plugin)),
      invoke: (plugin: string, method: string, args?: unknown) => Effect.try({
        try: () => device.invoke(plugin, method, (args ?? {}) as Record<string, unknown>),
        catch: (error) => new NativeFailed({ plugin, method, message: String(error), code: (error as { code?: string }).code }),
      }),
      listen: () => Stream.empty,
    }),
    Layer.succeed(Build, { info: { version: "test", variant: "browser", testMocks: true } }),
    Layer.succeed(CloudSession, {
      changes: Stream.make({ ...signedOut, phase: "SignedIn" as const, generation: 1 }),
      notices: Stream.empty,
      current: () => succeed({ ...signedOut, phase: "SignedIn" as const, generation: 1 }),
      owner: () => succeed(1),
      ownerKey: (key: string) => succeed(`alpha/1/${key}`),
      run: () => Effect.void, adopt: () => Effect.void, attempt: () => Effect.void, signOut: () => succeed(true), rejected: () => Effect.void, admit: () => Effect.void,
    }),
    Layer.succeed(VoiceRoute, {
      changes: Stream.empty,
      route: () => succeed("Cloud" as const),
      account: () => succeed({ kind: "cloud" as const, environment: "test", credentialId: "credential-test" }),
      observeAccount: () => Effect.void,
      observeLimit: () => Effect.void,
      probeOnDevice: () => succeed(false),
      run: <A>(attempt: RouteAttempt<A>) => mapError(attempt("Cloud", () => Effect.void), (cause) => new VoiceRouteFailed({ route: "Cloud", cause })),
      privacy: () => succeed("ViaCloud" as const),
      sends: () => succeed(sendsOf("Cloud")),
    }),
    shown === undefined
      ? Layer.succeed(Foreground, { changes: Stream.make(home), get: () => succeed(home) })
      : Layer.succeed(Foreground, { changes: SubscriptionRef.changes(shown), get: () => SubscriptionRef.get(shown) }),
    memoryStore,
  )
}

/** The whole Notes layer over the fakes. */
export const notesOver = (agent: NotesAgentFake, device: DeviceFake, shown?: SubscriptionRef.SubscriptionRef<ForegroundState>) =>
  Layer.provide(layer, fakes(agent, device, shown))

/** The first snapshot of the bound collection. */
export effect function bound() {
  const collection = try NotesCollection
  return try timeout(Stream.runHead(Stream.filter(collection.snapshots, (owned) => owned !== undefined)), "5 seconds")
}

/** Wait until a stream of states reaches one the test is waiting for. */
export effect function until<A>(changes: Stream.Stream<A>, ok: (value: A) => boolean) {
  return try timeout(Stream.runHead(Stream.filter(changes, ok)), "5 seconds")
}
