// spec/browser/session.md, "Story: Browse in tabs"; spec/browser/session.md, "Story: Keep my normal tabs and history across restarts"; spec/browser/session.md, "Story: Clear my browsing data"; spec/browser/session.md, "Story: Let the agent open and drive my tabs"; spec/browser/session.md, "Story: Find text in a page"
import { assert, it } from "@effect/vitest"
import { BrowserTabs } from "../../src/browser/session.vibe"
import { BrowserAgent } from "../../src/browser/agent.vibe"
import { BrowserReviews } from "../../src/browser/reviews.vibe"
import { BrowserEgress } from "../../src/browser/egress.vibe"
import { typedAddress } from "../../src/browser/address.ts"
import { snapshotOf } from "../../gen/browser__session.effect.vibe"
import { callsTo, fakeHost, report, settledTabs, shownBrowser } from "./fakes.vibe"

// spec/browser/session.md, "Story: Browse in tabs"
it.live("browse in tabs: a typed address loads in its own WebView, only a normal tab's page enters history, and eight tabs are the limit", () => effect {
  const fake = try fakeHost()
  try scoped(effect {
    provide fake.live {
      const tabs = try BrowserTabs
      const started = try settledTabs(tabs)
      const session = (try callsTo(fake.calls, "browsingState"))[0]?.args.session as string
      const typed = typedAddress("example.test/news")
      try tabs.dispatch({ type: "startEditing" })
      try tabs.dispatch({ type: "submitAddress", facts: typed.facts, url: typed.href })
      try report(fake.events, session, { id: started.cur, sequence: 1, navigation: "1", url: "https://example.test/news", title: "News", committed: true })

      // spec/browser/session.md, "A tab's page is the native host's latest report for it, and a private tab stays private"
      const priv = "bprivate"
      try tabs.dispatch({ type: "openTab", id: priv, profile: "Private" })
      try tabs.dispatch({ type: "submitAddress", facts: typedAddress("secret.test").facts, url: "https://secret.test/" })
      try report(fake.events, session, { id: priv, sequence: 2, navigation: "1", url: "https://secret.test/", title: "Secret", committed: true })
      try report(fake.events, "another-session", { id: priv, sequence: 3, navigation: "2", url: "https://forged.test/", committed: true })

      // spec/browser/page.md, "Credential-like text is never searched, and text over the length limit is never opened"
      try tabs.dispatch({ type: "startEditing" })
      try tabs.dispatch({ type: "submitAddress", facts: typedAddress("ann:pw@evil.test").facts, url: "" })

      // spec/browser/session.md, "A new tab, normal or private, opens selected with its address field, unless eight are open"
      for (const n of [1, 2, 3, 4, 5, 6, 7]) try tabs.dispatch({ type: "openTab", id: `extra${n}`, profile: "Normal" })
      const after = try tabs.get()
      try Effect.try(() => assert.deepStrictEqual({
        created: (try callsTo(fake.calls, "create")).map((c) => c.args.private),
        navigated: (try callsTo(fake.calls, "navigate")).map((c) => c.args.url),
        visits: after.visits.map((v) => v.url),
        privatePage: after.tabs.find((t) => t.id === priv)?.page.url,
        tabCount: after.tabs.length,
        saved: snapshotOf(after).tabs.some((t) => t.id === priv),
        toasts: (try Ref.get(fake.toasts)).length >= 2,
      }, {
        created: [false, true],
        navigated: ["https://example.test/news", "https://secret.test/"],
        visits: ["https://example.test/news"],
        privatePage: "https://secret.test/",
        tabCount: 8,
        saved: false,
        toasts: true,
      }))
    }
  })
})

// spec/browser/session.md, "Story: Keep my normal tabs and history across restarts"; spec/browser/persistence.md, "Nothing is written until the saved record was read or cleared, and then the current snapshot counts as written"
it.live("restore saved tabs into an untouched launch, and never write over a record that could not be read", () => effect {
  const saved = { history: ["https://example.test/"], tabs: [{ id: "bsaved", url: "https://example.test/", title: "Example" }], cur: "bsaved" }
  const restored = try fakeHost({ answers: { browsingState: () => saved } })
  try scoped(effect {
    provide restored.live {
      const state = try settledTabs(try BrowserTabs)
      try Effect.try(() => assert.deepStrictEqual(
        { tabs: state.tabs.map((t) => [t.id, t.restoreUrl, t.stage]), cur: state.cur, visits: state.visits.map((v) => v.url) },
        { tabs: [["bsaved", "https://example.test/", "Unborn"]], cur: "bsaved", visits: ["https://example.test/"] },
      ))
    }
  })
  const unreadable = try fakeHost({ answers: { browsingState: () => new Error("Saved tabs and history could not be read. They were not changed.") } })
  try scoped(effect {
    provide unreadable.live {
      const tabs = try BrowserTabs
      const state = try settledTabs(tabs)
      try tabs.dispatch({ type: "openTab", id: "bnew", profile: "Normal" })
      try sleep("50 millis")
      try Effect.try(() => assert.deepStrictEqual(
        { hydration: state.hydration, writes: (try callsTo(unreadable.calls, "saveBrowsingState")).length },
        { hydration: "ReadFailed", writes: 0 },
      ))
    }
  })
})

// spec/browser/session.md, "Story: Clear my browsing data"; spec/browser/reviews.md, "Story: Confirm only what I can see"
it.live("clear browsing data only after the owner confirms it on the unlocked phone, keeping private tabs", () => effect {
  const fake = try fakeHost({ answers: { clearBrowsingData: () => ({ closed: [] }) } })
  try scoped(effect {
    provide fake.live {
      const tabs = try BrowserTabs
      const reviews = try BrowserReviews
      try settledTabs(tabs)
      try tabs.dispatch({ type: "openTab", id: "bpriv", profile: "Private" })
      const clearing = fork tabs.clearBrowsingData()
      try timeout(Stream.runHead(Stream.filter(reviews.changes, (r) => r.open.length > 0)), "1 second")
      try reviews.approve("browser-clear-data")
      try join clearing
      const cleared = try tabs.get()

      // spec/browser/reviews.md, "Hiding Alpha or locking the phone ends every open review as not confirmed"
      try SubscriptionRef.set(fake.foreground, { ...shownBrowser, locked: true })
      try sleep("20 millis")
      const refused = try reviews.confirm("browser-clear-site", "ClearSiteData", "example.test")
      try Effect.try(() => assert.deepStrictEqual(
        { cleared: (try callsTo(fake.calls, "clearBrowsingData")).length, kept: cleared.tabs.map((t) => t.profile), visits: cleared.visits.length, refused },
        { cleared: 1, kept: ["Private"], visits: 0, refused: false },
      ))
    }
  })
})

// spec/browser/session.md, "Story: Let the agent open and drive my tabs"; spec/browser/agent.md, "Story: Go back, forward or reload only on the page I was looking at"
it.live("the agent opens in the untouched tab, and a view command is reported dispatched, never finished, and refused on a changed page", () => effect {
  const fake = try fakeHost()
  try scoped(effect {
    provide fake.live {
      const tabs = try BrowserTabs
      const agent = try BrowserAgent
      const started = try settledTabs(tabs)
      const session = (try callsTo(fake.calls, "browsingState"))[0]?.args.session as string
      const opened = try agent.openApproved("https://example.test/", false)
      const refusedHttp = agent.openApproved("http://example.test/", false) catch (error) => error._tag
      try report(fake.events, session, { id: opened.tab, sequence: 1, navigation: "7", url: "https://example.test/", committed: true, canBack: true })
      try opened.present
      const selection = try agent.selection()
      const dispatched = try agent.command({ subaction: "back" }, selection)
      try report(fake.events, session, { id: opened.tab, sequence: 2, navigation: "8", url: "https://example.test/next", committed: true, canBack: true })
      const stale = try agent.command({ subaction: "back" }, selection)
      const stop = try agent.command({ subaction: "stop" }, undefined)
      try Effect.try(() => assert.deepStrictEqual(
        { reused: opened.tab === started.cur, refusedHttp, dispatched, stale: stale.ok ? "ok" : stale.code, stop: stop.ok ? "ok" : stop.code,
          commands: (try callsTo(fake.calls, "command")).map((c) => [c.args.command, c.args.navigation]) },
        { reused: true, refusedHttp: "BrowserOpenRefused", dispatched: { ok: true, data: { dispatched: true, completed: false, requiresReadback: true } },
          stale: "STALE_REF", stop: "UNSUPPORTED", commands: [["back", "7"]] },
      ))
    }
  })
})

// spec/browser/session.md, "Story: Find text in a page"; spec/browser/egress.md, "Story: Share or keep the page I am looking at"
it.live("find searches only the tab that still shows the bar, and a page egress needs the settled page", () => effect {
  const fake = try fakeHost()
  try scoped(effect {
    provide fake.live {
      const tabs = try BrowserTabs
      const egress = try BrowserEgress
      const started = try settledTabs(tabs)
      const session = (try callsTo(fake.calls, "browsingState"))[0]?.args.session as string
      try egress.copyLink()
      try tabs.dispatch({ type: "startEditing" })
      try tabs.dispatch({ type: "submitAddress", facts: typedAddress("example.test").facts, url: "https://example.test/" })
      try report(fake.events, session, { id: started.cur, sequence: 1, navigation: "1", url: "https://example.test/", committed: true })
      try tabs.dispatch({ type: "openFind" })
      try tabs.typeFind("mil")
      try tabs.typeFind("milk")
      try sleep("250 millis")
      try PubSub.publish(fake.events, { name: "findResult", event: { session, id: started.cur, count: 3, index: 1, done: true } })
      try sleep("20 millis")
      const found = (try tabs.get()).find
      try tabs.dispatch({ type: "openTab", id: "bother", profile: "Normal" })
      try tabs.typeFind("ignored")
      try sleep("200 millis")
      try Effect.try(() => assert.deepStrictEqual(
        { searches: (try callsTo(fake.calls, "find")).map((c) => c.args.query), found: [found.count, found.index], copyRefused: (try Ref.get(fake.toasts)).includes("Load the current page before copying its link.") },
        { searches: ["milk"], found: [3, 1], copyRefused: true },
      ))
    }
  })
})

// spec/browser/agent.md, "The native call names the admitted revision, is sent at most once per claim, and its result is a dispatch, never a finished page"
it.live("a view command whose native receipt names another tab or session is not reported dispatched, and is never sent again", () => effect {
  const fake = try fakeHost({ answers: { command: () => ({ session: "another-session", id: "b-other" }) } })
  try scoped(effect {
    provide fake.live {
      const tabs = try BrowserTabs
      const agent = try BrowserAgent
      try settledTabs(tabs)
      const session = (try callsTo(fake.calls, "browsingState"))[0]?.args.session as string
      const opened = try agent.openApproved("https://example.test/", false)
      try report(fake.events, session, { id: opened.tab, sequence: 1, navigation: "7", url: "https://example.test/", committed: true, canBack: true })
      try opened.present
      const answer = try agent.command({ subaction: "back" }, try agent.selection())
      try Effect.try(() => assert.deepStrictEqual(
        { ok: answer.ok, code: answer.ok ? "" : answer.code, sent: (try callsTo(fake.calls, "command")).length },
        { ok: false, code: "UNAVAILABLE", sent: 1 },
      ))
    }
  })
})
