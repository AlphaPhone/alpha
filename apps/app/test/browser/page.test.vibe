// spec/browser/page.md, "Story: Type an address or search words"; spec/browser/page.md, "Story: Know what each tab shows"; spec/browser/session.md, "Story: Keep my place with the Browser's layers and Back"
import { assert, it } from "@effect/vitest"
import { BrowserTabs } from "../../src/browser/session.vibe"
import { callsTo, fakeHost, loadPage, report, sessionOf, settledTabs } from "./fakes.vibe"

// spec/browser/page.md, "Story: Type an address or search words"
it.live("what the owner types opens the site it names, searches plain words, and never searches a username or password", () => effect {
  const fake = try fakeHost()
  try scoped(effect {
    provide fake.live {
      const tabs = try BrowserTabs
      try settledTabs(tabs)
      for (const text of ["example.test/news", "bread recipes", "me@home", "ann:pw@evil.test", "http://plain.test/"]) {
        try tabs.dispatch({ type: "startEditing" })
        try tabs.enter(text)
      }
      const navigated = (try callsTo(fake.calls, "navigate")).map((c) => String(c.args.url))
      try Effect.try(() => assert.deepStrictEqual({
        address: navigated[0],
        searches: navigated.slice(1, 3).map((url) => URL.parse(url)?.searchParams.get("q")),
        credentialsSearched: navigated.some((url) => url.includes("evil.test") || url.includes("pw")),
        upgraded: navigated[3],
        refused: (try Ref.get(fake.toasts)).includes("Enter search words or a valid HTTP or HTTPS address without a username or password."),
      }, {
        address: "https://example.test/news",
        searches: ["bread recipes", "me@home"],
        credentialsSearched: false,
        upgraded: "https://plain.test/",
        refused: true,
      }))
    }
  })
})

// spec/browser/session.md, "A link the owner taps outside Browser opens in a new tab and is never searched"
it.live("a link tapped in another app opens in a new tab, and text that is not a web address opens nothing", () => effect {
  const fake = try fakeHost()
  try scoped(effect {
    provide fake.live {
      const tabs = try BrowserTabs
      const started = try settledTabs(tabs)
      try tabs.openLink("https://example.test/article")
      try tabs.openLink("call me later")
      try tabs.openLink("https://ann:pw@evil.test/")
      try sleep("20 millis")
      const after = try tabs.get()
      try Effect.try(() => assert.deepStrictEqual({
        tabs: after.tabs.length,
        selectedNew: after.cur !== started.cur,
        navigated: (try callsTo(fake.calls, "navigate")).map((c) => c.args.url),
      }, { tabs: 2, selectedNew: true, navigated: ["https://example.test/article"] }))
    }
  })
})

// spec/browser/page.md, "Story: Know what each tab shows"
it.live("a tab shows the native host's latest report for it: a late report, another session's report or a profile change move nothing", () => effect {
  const fake = try fakeHost()
  try scoped(effect {
    provide fake.live {
      const tabs = try BrowserTabs
      try settledTabs(tabs)
      const session = try sessionOf(fake.calls)
      try tabs.dispatch({ type: "openTab", id: "bpriv", profile: "Private" })
      const id = try loadPage(tabs, fake.events, session, "https://example.test/second", "2", 5)
      try report(fake.events, session, { id, sequence: 4, navigation: "1", url: "https://example.test/first", committed: true })
      try report(fake.events, "another-session", { id, sequence: 9, navigation: "9", url: "https://forged.test/", committed: true })
      try report(fake.events, session, { id, sequence: 6, navigation: "2", url: "https://example.test/second", committed: true, private: false })
      const tab = (try tabs.get()).tabs.find((t) => t.id === id)
      try Effect.try(() => assert.deepStrictEqual(
        { url: tab?.page.url, sequence: tab?.page.sequence, profile: tab?.profile, visits: (try tabs.get()).visits.length },
        { url: "https://example.test/second", sequence: 6, profile: "Private", visits: 0 },
      ))
    }
  })
})

// spec/browser/session.md, "Back closes the find bar, then editing, the switcher, the menu, the library and the share sheet, then goes back in the page, and otherwise is the shell's"
it.live("Back closes Browser's layers one at a time, then goes back in the page, then is the shell's", () => effect {
  const fake = try fakeHost()
  try scoped(effect {
    provide fake.live {
      const tabs = try BrowserTabs
      try settledTabs(tabs)
      const session = try sessionOf(fake.calls)
      const id = try loadPage(tabs, fake.events, session, "https://example.test/", "1", 1)
      try report(fake.events, session, { id, sequence: 2, navigation: "2", url: "https://example.test/next", committed: true, canBack: true })
      try tabs.dispatch({ type: "openFind" })
      try tabs.dispatch({ type: "showTabs" })
      const taken: boolean[] = []
      const covered: boolean[] = []
      for (const _ of [1, 2, 3]) {
        taken.push(try tabs.back())
        const now = try tabs.get()
        covered.push(now.find.tab !== "" || now.layers.tabsOpen)
      }
      try report(fake.events, session, { id, sequence: 3, navigation: "1", url: "https://example.test/", committed: true, canBack: false })
      taken.push(try tabs.back())

      // spec/browser/session.md, "Opening the menu, the switcher or the library ends address editing, and the menu never covers editing"
      try tabs.dispatch({ type: "startEditing" })
      try tabs.dispatch({ type: "toggleMenu" })
      const layered = (try tabs.get()).layers
      try Effect.try(() => assert.deepStrictEqual({
        taken, covered,
        commands: (try callsTo(fake.calls, "command")).map((c) => [c.args.command, c.args.navigation]),
        cleared: (try callsTo(fake.calls, "clearFind")).length,
        editingUnderMenu: layered.editing && layered.menu,
      }, {
        taken: [true, true, true, false],
        covered: [true, false, false],
        commands: [["back", "2"]],
        cleared: 1,
        editingUnderMenu: false,
      }))
    }
  })
})
