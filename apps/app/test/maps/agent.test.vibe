// spec/maps/guidance.md, "Story: Reroute the guidance I started only when my agent asks, from a fresh fix"; spec/maps/agentSurface.md, "Story: Let my agent bring Maps forward only when I can see it"; spec/maps/selectedRead.md, "Story: Let the agent see only what the Maps screen shows now"; spec/maps/delivery.md, "Story: Carry my agent's Maps requests to the phone once"; spec/maps/cards.md, "Story: Answer my agent's Maps question with one tap"
import { assert, it } from "@effect/vitest"
import type { ExecutorCall } from "@elizaos/agent/client"
import { Machine as CardsMachine } from "../../gen/maps__cards.effect.vibe"
import { Machine as ConnectionMachine } from "../../gen/maps__connection.effect.vibe"
import { Machine as DeliveryMachine } from "../../gen/maps__delivery.effect.vibe"
import { Machine as GuidanceMachine } from "../../gen/maps__guidance.effect.vibe"
import { Machine as ScreenMachine } from "../../gen/maps__screen.effect.vibe"
import { Machine as SurfaceMachine } from "../../gen/maps__agentSurface.effect.vibe"
import { MapsAgent, mapsDeviceCapabilities } from "../../src/maps/agent.vibe"
import { MapsContent } from "../../src/maps/content.vibe"
import { MapsHandoff } from "../../src/maps/handoff.vibe"
import { MapsSession } from "../../src/maps/layer.vibe"
import { MapsNavigation } from "../../src/maps/navigation.vibe"
import { operationPorts } from "../../src/maps/operations.vibe"
import { MapsPlane } from "../../src/maps/plane.vibe"
import { MapsScreen } from "../../src/maps/screen.vibe"
import { ferry, fixAt, harness, pier, until } from "./fakes.vibe"

const open = { id: "alpha-osm", data: "OpenStreetMap" }
const offer = (message: number) => ({ message, revision: 0 })
const pierCard = {
  kind: "place" as const, attribution: "© data",
  place: { name: "Pier 39", latitude: pier.latitude, longitude: pier.longitude, provider: "alpha-osm", providerPlaceId: "p1", categories: [] },
}

/** Maps installed and a result for "pier" shown with its details. */
effect function shownPier() {
  const screen = try MapsScreen
  const machine = try ScreenMachine
  try (try MapsSession).open()
  try until((try ConnectionMachine).changes, (s) => s.phase === "Installed")
  try screen.typeQuery("pier")
  try screen.submitSearch()
  try until(machine.changes, (s) => s.search === "Ready")
  try screen.pickResult(0)
  return try until(machine.changes, (s) => s.details === "Ready")
}

it.live("A reroute plans from a fresh fix and keeps the route when the fix is not good enough (spec/maps/guidance.md, \"Story: Reroute the guidance I started only when my agent asks, from a fresh fix\"; spec/maps/guidance.md, \"A reroute belongs to its session; a failed or late one keeps the current route\")", () => effect {
  const h = try harness(open)
  provide h.layer {
    const screen = try MapsScreen
    const machine = try ScreenMachine
    const navigation = try MapsNavigation
    const guidance = try GuidanceMachine
    const content = try MapsContent
    try shownPier()
    try screen.openDirections()
    try screen.editOrigin("37.79550, -122.39370")
    try screen.submitOrigin()
    try until(machine.changes, (s) => s.route === "Ready")
    try navigation.start()
    const started = try until(guidance.changes, (g) => g.phase === "Guiding")
    const early = navigation.reroute() catch (e) => e.message
    try Queue.offer(h.fixes, fixAt(ferry))
    try until(guidance.changes, (g) => g.fixUsable)
    try navigation.reroute()
    const rerouted = try until(guidance.changes, (g) => g.phase === "Guiding" && g.route !== started.route)
    const routeId = (try content.get()).guidance?.route.id
    try Queue.offer(h.fixes, fixAt(ferry, 300))
    try until(guidance.changes, (g) => !g.fixUsable)
    const coarse = navigation.reroute() catch (e) => e.message
    const kept = try guidance.get()
    try Effect.try(() => assert.deepStrictEqual(
      { early, rerouted: [rerouted.session === started.session, rerouted.step, routeId], coarse, kept: kept.route === rerouted.route },
      {
        early: "The phone has no precise, up-to-date location, so it kept the current route.", rerouted: [true, 0, "detour"],
        coarse: "The phone has no precise, up-to-date location, so it kept the current route.", kept: true,
      },
    ))
  }
})

it.live("Maps is blocked by a ringing call and admitted over the launcher (spec/maps/agentSurface.md, \"Story: Let my agent bring Maps forward only when I can see it\"; spec/maps/agentSurface.md, \"Maps opens at most once per request, only over an unblocked launcher, and the answer waits for the open to commit or two seconds\")", () => effect {
  const h = try harness(open)
  provide h.layer {
    const surface = try SurfaceMachine
    try (try MapsSession).open()
    try SubscriptionRef.update(h.shell, (s) => ({ ...s, ringing: true, view: "phone" }))
    // One shell change is two surface steps, the block and then the view: wait for both.
    const ringing = try until(surface.changes, (s) => s.blocked && s.view !== "HomeView")
    const refused = try surface.send({ type: "requestMaps" })
    try SubscriptionRef.update(h.shell, (s) => ({ ...s, ringing: false, view: "maps" }))
    const clear = try until(surface.changes, (s) => !s.blocked && s.view === "MapsView")
    const admitted = try surface.send({ type: "requestMaps" })
    try Effect.try(() => assert.deepStrictEqual(
      { ringing: ringing.view, refused: refused.last, clear: clear.view, admitted: [admitted.last, admitted.opens] },
      { ringing: "AppView", refused: "NotShown", clear: "MapsView", admitted: ["Admitted", 0] },
    ))
  }
})

it.live("The agent reads only the selection its approved card showed (spec/maps/selectedRead.md, \"Story: Let the agent see only what the Maps screen shows now\"; spec/maps/selectedRead.md, \"A read is approved only for the selection the card showed, and its result is uploaded only while that selection is still shown\")", () => effect {
  const h = try harness(open)
  provide h.layer {
    const agent = try MapsAgent
    const screen = try MapsScreen
    const machine = try ScreenMachine
    try shownPier()
    try sleep("20 millis")
    const reviewed = try agent.review()
    const approved = try agent.approve()
    const read = try agent.readSelected()
    try agent.review()
    try agent.approve()
    try screen.pickResult(1)
    try until(machine.changes, (s) => s.details === "Ready")
    try sleep("20 millis")
    const stale = try agent.readSelected()
    try screen.closePlace()
    try sleep("20 millis")
    const search = try agent.review()
    try Effect.try(() => assert.deepStrictEqual(
      { reviewed, approved, place: read?.includes('"kind":"map-place"'), stale, search },
      { reviewed: true, approved: true, place: true, stale: undefined, search: false },
    ))
  }
})

it.live("The agent's reviewed Maps read runs once for the place its card named, and not after the selection moved (spec/maps/selectedRead.md, \"A read is approved only for the selection the card showed, and its result is uploaded only while that selection is still shown\"; spec/maps/selectedRead.md, \"The context revision changes exactly when what is shown changes, and clears when Maps is not in front\")", () => effect {
  const h = try harness(open)
  provide h.layer {
    const agent = try MapsAgent
    const screen = try MapsScreen
    const machine = try ScreenMachine
    const ports = try operationPorts
    const call = undefined as unknown as ExecutorCall
    try shownPier()
    try sleep("20 millis")
    const shown = try agent.context()
    const op = { type: "maps_read_selected", target: shown }
    const valid = ports.validate(op) !== undefined
    const done = (try promise(() => ports.execute(op, call))) as { kind: string; result?: { fields?: { kind?: string; label?: string; providerRevision?: string } } }
    try screen.pickResult(1)
    try until(machine.changes, (s) => s.details === "Ready")
    try sleep("20 millis")
    const moved = try agent.context()
    const stale = (try promise(() => ports.execute(op, call))) as { kind: string; code?: string }
    try Effect.try(() => assert.deepStrictEqual(
      {
        id: shown?.id.startsWith("maps_"), kind: shown?.kind, valid, done: [done.kind, done.result?.fields?.kind, done.result?.fields?.label, done.result?.fields?.providerRevision],
        sameId: moved?.id === shown?.id, stale: [stale.kind, stale.code], card: ports.describe(op).title, receipt: ports.summarize(op, "Applied"),
      },
      {
        id: true, kind: "map-place", valid: true, done: ["applied", "map-place", "Pier 39", "r1"],
        sameId: false, stale: ["refused", "not_dispatched"], card: "Share the place shown in Maps", receipt: "Shared the place shown in Maps.",
      },
    ))
  }
})

it.live("A redelivered navigation applies its effect once, and a lost claim applies nothing (spec/maps/delivery.md, \"Story: Carry my agent's Maps requests to the phone once\"; spec/maps/delivery.md, \"A navigation effect runs only under a returned claim, and a redelivery never runs it twice\")", () => effect {
  const claimed = try harness(open, { claim: { claimId: "claim-1" } })
  const applied = try Ref.make(0)
  const once = try Effect.provide(effect {
    const agent = try MapsAgent
    try agent.deliver(1, 7, { viewId: "maps" }, Ref.update(applied, (n) => n + 1))
    try agent.deliver(2, 7, { viewId: "maps" }, Ref.update(applied, (n) => n + 1))
    return [try Ref.get(applied), claimed.residentCalls.filter((p) => p === "/api/views/interact-result").length, (try (try DeliveryMachine).get()).applied] as const
  }, claimed.layer)
  const lost = try harness(open, { claim: { claimId: "" } })
  const unknown = try Effect.provide(effect {
    const agent = try MapsAgent
    try agent.deliver(1, 8, { viewId: "maps" }, Ref.update(applied, (n) => n + 1))
    return [(try (try DeliveryMachine).get()).claimPhase, lost.residentCalls.filter((p) => p === "/api/views/interact-result").length] as const
  }, lost.layer)
  const total = try Ref.get(applied)
  try Effect.try(() => assert.deepStrictEqual(
    { once, unknown, total },
    { once: [1, 2, [7]], unknown: ["ClaimUnknown", 0], total: 1 },
  ))
})

it.live("One tap answers the newest question once, and a card's map opens once (spec/maps/cards.md, \"Story: Answer my agent's Maps question with one tap\"; spec/maps/cards.md, \"A tap sends one answer while the composer is quiet; a draft or an edit says why it waits; a failed send asks again\"; spec/maps/cards.md, \"Only the newest agent message offers its choice and its card, in the session and conversation that showed them\")", () => effect {
  const h = try harness(open)
  provide h.layer {
    const handoff = try MapsHandoff
    const cards = try CardsMachine
    const sent = try Ref.make(0)
    const send = map(Ref.update(sent, (n) => n + 1), () => true)
    try (try MapsSession).open()
    try until((try ConnectionMachine).changes, (s) => s.phase === "Installed")
    try handoff.agentReply(true)
    try handoff.answerChoice(offer(1), send)
    try handoff.answerChoice(offer(1), send)
    const answered = try Ref.get(sent)
    try handoff.agentReply(true)
    try handoff.setComposer({ busy: false, typing: false, recording: false, draft: true, editing: false, hidden: false, sheetOpen: false })
    try handoff.answerChoice(offer(2), send)
    const draft = try cards.get()
    try handoff.openCard(pierCard, offer(1))
    try handoff.openCard(pierCard, offer(2))
    try handoff.openCard(pierCard, offer(2))
    const shown = try until((try ScreenMachine).changes, (s) => s.choice === "AgentChoice")
    const afterDraft = try Ref.get(sent)
    try Effect.try(() => assert.deepStrictEqual(
      { answered, afterDraft, notice: draft.notice, opened: h.opened.filter((a) => a === "maps").length, shown: shown.choice },
      { answered: 1, afterDraft: 1, notice: "DraftOpen", opened: 1, shown: "AgentChoice" },
    ))
  }
})

it.live("Every message counts however long the chat runs, and a card counted before the chat moved no longer opens (spec/maps/cards.md, \"Only the newest agent message offers its choice and its card, in the session and conversation that showed them\")", () => effect {
  const h = try harness(open)
  provide h.layer {
    const handoff = try MapsHandoff
    try (try MapsSession).open()
    try until((try ConnectionMachine).changes, (s) => s.phase === "Installed")
    for (let i = 0; i < 4; i++) {
      try handoff.ownerMessage()
      try handoff.agentReply(false)
    }
    const counted = (try (try CardsMachine).get()).newest
    try handoff.chatMoved(1, 2)
    try handoff.openCard(pierCard, offer(8))
    const stale = h.opened.filter((a) => a === "maps").length
    try handoff.agentReply(false)
    try handoff.openCard(pierCard, offer(9))
    const shown = try until((try ScreenMachine).changes, (s) => s.choice === "AgentChoice")
    try Effect.try(() => assert.deepStrictEqual(
      { counted, stale, opened: h.opened.filter((a) => a === "maps").length, shown: shown.choice },
      { counted: 8, stale: 0, opened: 1, shown: "AgentChoice" },
    ))
  }
})

it.live("Back closes the credits sheet, then the rename field, then the place and the search, and only then leaves Maps (spec/maps/screen.md, \"Back closes one layer at a time\")", () => effect {
  const h = try harness(open)
  provide h.layer {
    try shownPier()
    const session = try MapsSession
    const plane = try MapsPlane
    const content = try MapsContent
    try plane.mount(1, "WorldMap")
    try plane.openInfo()
    const credits = try session.back()
    const shownId = (try content.get()).shown?.id ?? 0
    try content.update((c) => ({ ...c, renaming: { id: shownId, text: "Sea lions" } }))
    const rename = try session.back()
    const renaming = (try content.get()).renaming
    const place = try session.back()
    const choice = (try (try ScreenMachine).get()).choice
    const search = try session.back()
    const leaves = try session.back()
    const infoClosed = !(try plane.closeInfo())
    try Effect.try(() => assert.deepStrictEqual(
      { credits, infoClosed, rename, renaming, place, choice, search, leaves },
      { credits: true, infoClosed: true, rename: true, renaming: undefined, place: true, choice: "NoChoice", search: true, leaves: false },
    ))
  }
})

it.effect("The selected read is advertised only when the agent offers it (spec/maps/selectedRead.md, \"Story: Let the agent see only what the Maps screen shows now\")", () => effect {
  try Effect.try(() => assert.deepStrictEqual(
    { offered: mapsDeviceCapabilities(["files.browser.v1", "maps.selected-read.v1"]), absent: mapsDeviceCapabilities(["files.browser.v1"]) },
    { offered: ["maps.selected-read.v1"], absent: [] },
  ))
})
