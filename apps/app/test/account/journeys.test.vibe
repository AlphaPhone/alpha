import { type Answer, type Calls, account, cloudAnswers, expiresAt, found, names, now, providerStatus, signedInNative, snapshot, until } from "./platform.vibe"

/** A signed-out host whose next sign-in stores `key-2`. */
function signedOutNative(held: { key: boolean }): Record<string, Answer> {
  return {
    ...signedInNative,
    "AlphaCloudSignIn.credentialIdentity": () => (held.key ? { credentialId: "key-2", expiresAt } : { refuse: "signed-out" }),
    "AlphaCloudSignIn.startGoogle": () => {
      held.key = true
      return { status: "authenticated", expiresAt, credentialId: "key-2", accountCreated: true }
    },
    "AlphaCloudSignIn.startEmail": { attemptId: "attempt-1", expiresAt, resendAt: now },
    "AlphaCloudSignIn.verifyEmail": (args: unknown) => {
      if ((args as { code?: string }).code !== "123456") return { refuse: "invalid-code" }
      held.key = true
      return { status: "authenticated", expiresAt, credentialId: "key-2", accountCreated: null, previousSignIn: "unconfirmed" }
    },
    "AlphaCloudSignIn.resumeMfa": { active: true }
  }
}

// spec/account/session.md, "Story: Keep my sign-in working until I sign out"
it.live(`A renewal replaces the key of the same account, and a refused key asks for a new sign-in (spec/account/session.md, "Story: Keep my sign-in working until I sign out")`, () => effect {
  const renewed = { ...signedInNative, "AlphaCloudSignIn.renewSignIn": { status: "renewed", expiryWarning: false, expiresAt: expiresAt + 1000, credentialId: "key-9" } }
  const refused = { ...signedInNative, "AlphaCloudSignIn.renewSignIn": { status: "sign-in-required", expiryWarning: true, keyRefused: true } }
  const first = try scoped(effect {
    provide account([], renewed) {
      const session = try CloudSession
      fork.scoped session.run()
      return try found(try until(session.changes, (s) => s.renewals >= 1))
    }
  })
  const second = try scoped(effect {
    provide account([], refused) {
      const session = try CloudSession
      fork.scoped session.run()
      return try found(try until(session.changes, (s) => s.phase === "KeyRefused"))
    }
  })
  try Effect.try(() => assert.deepStrictEqual(
    { renewed: [first.account.credentialId, first.account.userId, first.generation, first.phase], refused: [second.expiryWarning, second.account.credentialId] },
    { renewed: ["key-9", "user-1", 1, "SignedIn"], refused: [true, "key-1"] }
  ))
})

// spec/account/session.md, "Story: Hear why a sign-in from the browser did not finish"
it.live(`A retained incomplete return is told once startup has settled (spec/account/session.md, "Story: Hear why a sign-in from the browser did not finish")`, () => effect {
  provide account([], signedInNative, cloudAnswers, { events: { "AlphaCloudSignIn.signInIncomplete": [{ code: "storage" }, { code: "unknown-code" }] } }) {
    try scoped(effect {
      const session = try CloudSession
      fork.scoped session.run()
      const told = try found(try until(session.changes, (s) => s.notices >= 1))
      try Effect.try(() => assert.deepStrictEqual({ notices: told.notices, waiting: told.waiting, phase: told.phase }, { notices: 1, waiting: "NoNotice", phase: "SignedIn" }))
    })
  }
})

// spec/account/session.md, "A sign-in that completed while Cloud could not be reached is adopted once Cloud names its account"
it.effect(`A sign-in completed while Cloud was unreachable is adopted with its news once Cloud names the account (spec/account/session.md, "Story: Sign in once for Cloud's managed services")`, () => effect {
  let reachable = false
  const cloud: Record<string, Answer> = { ...cloudAnswers, "GET /api/v1/user": () => reachable ? cloudAnswers["GET /api/v1/user"] : undefined }
  provide account([], signedInNative, cloud, { events: { "AlphaCloudSignIn.signInCompleted": [{ accountCreated: true }] } }) {
    try scoped(effect {
      const session = try CloudSession
      fork.scoped session.run()
      try TestClock.adjust("1 second")
      const before = try session.current()
      reachable = true
      try TestClock.adjust("1 minute")
      const after = try session.current()
      try Effect.try(() => assert.deepStrictEqual(
        { before: before.phase, after: [after.phase, after.account.userId, after.account.credentialId, after.created] },
        { before: "SignedOut", after: ["SignedIn", "user-1", "key-1", true] },
      ))
    })
  }
})

// spec/account/session.md, "Story: Use Cloud only for managed services"
it.live(`Only managed routes leave the phone (spec/account/session.md, "Story: Use Cloud only for managed services")`, () => effect {
  provide account([]) {
    try scoped(effect {
      const session = try CloudSession
      fork.scoped session.run()
      try until(session.changes, (s) => s.loaded)
      const refused = (route: "HandOffRoute" | "PairingRoute" | "FundsRoute" | "MapsRoute") => Effect.match(session.admit(route), { onFailure: () => true, onSuccess: () => false })
      const got1 = try refused("HandOffRoute")
      const got2 = try refused("PairingRoute")
      const got3 = try refused("FundsRoute")
      const got4 = try refused("MapsRoute")
      try Effect.try(() => assert.deepStrictEqual(
        { handOff: got1, pairing: got2, funds: got3, maps: got4 },
        { handOff: true, pairing: true, funds: false, maps: false }
      ))
    })
  }
})

// spec/account/signIn.md, "Story: Choose how to sign in"
it.live(`A signed-out phone shows the required page with the methods the host reports (spec/account/signIn.md, "Story: Choose how to sign in")`, () => effect {
  const calls: Calls = []
  provide account(calls, signedOutNative({ key: false })) {
    try scoped(effect {
      const session = try CloudSession
      const signIn = try SignInScreen
      fork.scoped session.run()
      fork.scoped signIn.run()
      const shown = try found(try until(signIn.changes, (s) => s.screen === "Choose" && s.methods.known))
      // spec/account/signIn.md, "The automatic page checks readiness once, and an owner's check keeps the agent running"
      const probes = names(calls).filter((n) => n === "AlphaCloudSignIn.status").length
      try Effect.try(() => assert.deepStrictEqual(
        { entry: entryOf(shown), methods: shown.methods, net: shown.net, probes, started: calls.some((c) => c.name === "AlphaCloudSignIn.startGoogle" || c.name === "AlphaCloudSignIn.startEmail") },
        { entry: "RequiredEntry", methods: { known: true, google: true, email: true, phone: false }, net: "NetOnline", probes: 1, started: false }
      ))
    })
  }
})

// spec/account/signIn.md, "Story: Sign in with Google"
it.live(`Google signs in a new account and keeps the agent running (spec/account/signIn.md, "Story: Sign in with Google")`, () => effect {
  const calls: Calls = []
  provide account(calls, signedOutNative({ key: false })) {
    try scoped(effect {
      const session = try CloudSession
      const signIn = try SignInScreen
      fork.scoped session.run()
      fork.scoped signIn.run()
      try until(signIn.changes, (s) => s.screen === "Choose" && s.methods.known)
      try signIn.google()
      // spec/account/session.md, "A new account, and an earlier sign-in left unconfirmed, are told for the sign-in that reported them"
      const signedIn = try found(try until(session.changes, (s) => s.phase === "SignedIn"))
      const screen = try signIn.current()
      try Effect.try(() => assert.deepStrictEqual(
        { credential: signedIn.account.credentialId, created: signedIn.created, prior: signedIn.priorUnconfirmed, screen: screen.screen, held: signedIn.holder,
          ensured: names(calls).lastIndexOf("Resident.ensureRunning") > names(calls).indexOf("AlphaCloudSignIn.startGoogle") },
        { credential: "key-2", created: true, prior: false, screen: "ScreenClosed", held: "Free", ensured: true }
      ))
    })
  }
})

// spec/account/signIn.md, "Story: Sign in with Google"
it.live(`A second verification the host kept is offered once resumed (spec/account/signIn.md, "Story: Sign in with Google")`, () => effect {
  const calls: Calls = []
  const retained = { status: "mfa", method: "sms", attemptId: "attempt-9", expiresAt: now + 600000 }
  provide account(calls, signedOutNative({ key: false }), cloudAnswers, { events: { "AlphaCloudSignIn.signInMfaRequired": [retained] } }) {
    try scoped(effect {
      const session = try CloudSession
      const signIn = try SignInScreen
      fork.scoped session.run()
      fork.scoped signIn.run()
      // spec/account/signIn.md, "A second verification the host kept after its wait ended is offered once the host resumes it"
      const step = try found(try until(signIn.changes, (s) => s.screen === "FactorStep"))
      try Effect.try(() => assert.deepStrictEqual(
        { factor: step.factor, attempt: step.attempt, resumed: calls.find((c) => c.name === "AlphaCloudSignIn.resumeMfa")?.args },
        { factor: "SmsFactor", attempt: 1, resumed: { attemptId: "attempt-9", environment: "production" } }
      ))
    })
  }
})

// spec/account/signIn.md, "Story: Sign in with a code"
it.live(`A wrong code keeps the step and the right one signs in (spec/account/signIn.md, "Story: Sign in with a code")`, () => effect {
  const calls: Calls = []
  provide account(calls, signedOutNative({ key: false })) {
    try scoped(effect {
      const session = try CloudSession
      const signIn = try SignInScreen
      fork.scoped session.run()
      fork.scoped signIn.run()
      try until(signIn.changes, (s) => s.screen === "Choose" && s.methods.known)
      try signIn.submit(" owner@example.com ")
      try until(signIn.changes, (s) => s.screen === "CodeStep" && s.work === "NoWork")
      // spec/account/signIn.md, "A wrong code keeps the step, a spent code leaves only Resend, and any other failure returns to the choice"
      try signIn.verify("000000")
      const wrong = try signIn.current()
      try signIn.verify("123 456")
      const signedIn = try found(try until(session.changes, (s) => s.phase === "SignedIn"))
      try Effect.try(() => assert.deepStrictEqual({
        sent: calls.find((c) => c.name === "AlphaCloudSignIn.startEmail")?.args,
        wrong: [wrong.screen, wrong.fault, wrong.attempt],
        verified: calls.filter((c) => c.name === "AlphaCloudSignIn.verifyEmail").map((c) => (c.args as { code: string }).code),
        prior: signedIn.priorUnconfirmed, created: signedIn.created
      }, {
        sent: { environment: "production", email: "owner@example.com", requestId: (calls.find((c) => c.name === "AlphaCloudSignIn.startEmail")?.args as { requestId: string }).requestId },
        wrong: ["CodeStep", "WrongCode", 1],
        verified: ["000000", "123456"],
        prior: true, created: false
      }))
    })
  }
})

// spec/account/signIn.md, "Story: Sign in with a code"
it.effect(`A typed phone number reads as the international number the host takes (spec/account/signIn.md, "Story: Sign in with a code")`, () => effect {
  // spec/account/signIn.md, "A typed phone number is sent in international form"
  const typed = [" (415) 555-0100 ", "415.555.0100", "1-415-555-0100", "+1 415 555 0100", "0044 20 7946 0958", "+44 (20) 7946-0958", "020 7946 0958", "+1 (415) 555-010a", "4155550100x"]
  try Effect.try(() => assert.deepStrictEqual(typed.map(internationalNumber), [
    "+14155550100", "+14155550100", "+14155550100", "+14155550100", "+442079460958", "+442079460958", "02079460958", "+1415555010a", "4155550100x"
  ]))
})

