})

// spec/account/signIn.md, "Story: Sign in with a code"
it.live(`Back during a verification adopts the key the host stored, and otherwise returns to the choice (spec/account/signIn.md, "Story: Sign in with a code")`, () => effect {
  // The host commits (or not) and then holds its answer until Back's cancel reaches it, as a phone does when Back loses the race.
  effect function backDuring(commits: boolean) {
    const calls: Calls = []
    const held = { key: false }
    const asked = try Deferred.make<void>()
    const cancelled = try Deferred.make<void>()
    const host = {
      ...signedOutNative(held),
      "AlphaCloudSignIn.credentialIdentity": () => (held.key ? { environment: "production", credentialId: "key-2", expiresAt } : { environment: "production", credentialId: null }),
      "AlphaCloudSignIn.verifyEmail": () => {
        held.key = commits
        const refusal = new NativeFailed({ plugin: "AlphaCloudSignIn", method: "verifyEmail", message: "cancelled", code: "cancelled" })
        return Effect.andThen(Deferred.succeed(asked, undefined), Effect.flatMap(Deferred.await(cancelled), () => Effect.fail(refusal)))
      },
      "AlphaCloudSignIn.cancel": () => Effect.as(Deferred.succeed(cancelled, undefined), {})
    }
    return try scoped(effect {
      provide account(calls, host) {
        const session = try CloudSession
        const signIn = try SignInScreen
        fork.scoped session.run()
        fork.scoped signIn.run()
        try until(signIn.changes, (s) => s.screen === "Choose" && s.methods.known)
        try signIn.submit("owner@example.com")
        try until(signIn.changes, (s) => s.screen === "CodeStep" && s.work === "NoWork")
        fork.scoped signIn.verify("123456")
        try Deferred.await(asked)
        const took = try signIn.back()
        const screen = try signIn.current()
        const signedIn = commits ? (try found(try until(session.changes, (s) => s.phase === "SignedIn"))).account.credentialId : (try session.current()).phase
        return { took, screen: [screen.screen, screen.work, screen.adoptedByBack, screen.fault], signedIn, cancelled: names(calls).includes("AlphaCloudSignIn.cancel") }
      }
    })
  }
  // spec/account/signIn.md, "Back during a verification adopts a key the host already stored"
  const committed = try backDuring(true)
  // spec/account/signIn.md, "Back ends the step in flight, then the code step, then the dialog; the required page keeps its chooser"
  const refused = try backDuring(false)
  try Effect.try(() => assert.deepStrictEqual({ committed, refused }, {
    committed: { took: true, screen: ["ScreenClosed", "NoWork", true, "NoFault"], signedIn: "key-2", cancelled: true },
    refused: { took: true, screen: ["Choose", "NoWork", false, "NoFault"], signedIn: "SignedOut", cancelled: true }
  }))
})

// spec/account/signIn.md, "Story: Leave sign-in"
it.live(`Back from the code step cancels the attempt and keeps the address (spec/account/signIn.md, "Story: Leave sign-in")`, () => effect {
  const calls: Calls = []
  provide account(calls, signedOutNative({ key: false })) {
    try scoped(effect {
      const session = try CloudSession
      const signIn = try SignInScreen
      fork.scoped session.run()
      fork.scoped signIn.run()
      try until(signIn.changes, (s) => s.screen === "Choose" && s.methods.known)
      try signIn.submit("owner@example.com")
      try until(signIn.changes, (s) => s.screen === "CodeStep")
      try signIn.back()
      const left = try signIn.current()
      // spec/account/signIn.md, "Back ends the step in flight, then the code step, then the dialog; the required page keeps its chooser"
      try signIn.back()
      const kept = try signIn.current()
      try Effect.try(() => assert.deepStrictEqual(
        { left: [left.screen, left.prefill, left.attempt], cancelled: names(calls).includes("AlphaCloudSignIn.cancel"), kept: [kept.screen, entryOf(kept)] },
        { left: ["Choose", true, 0], cancelled: true, kept: ["Choose", "RequiredEntry"] }
      ))
    })
  }
})

// spec/account/signIn.md, "Story: Leave sign-in"
it.live(`Back from the chooser the owner opened while signed out closes sign-in and leaves Account (spec/account/signIn.md, "Story: Leave sign-in")`, () => effect {
  const calls: Calls = []
  provide account(calls, signedOutNative({ key: false }), cloudAnswers, { variant: "browser" }) {
    try scoped(effect {
      const session = try CloudSession
      const signIn = try SignInScreen
      const presentation = try AccountPresentation
      fork.scoped session.run()
      fork.scoped signIn.run()
      try until(session.changes, (s) => s.startupResolved)
      try signIn.open()
      const opened = try found(try until(signIn.changes, (s) => s.screen === "Choose" && s.methods.known))
      // spec/account/signIn.md, "Back ends the step in flight, then the code step, then the dialog; the required page keeps its chooser"
      const leaves = try presentation.back()
      const closed = try signIn.current()
      const rested = try presentation.back()
      try Effect.try(() => assert.deepStrictEqual(
        { opened: entryOf(opened), leaves, closed: [closed.screen, entryOf(closed)], rested },
        { opened: "OpenedEntry", leaves: false, closed: ["ScreenClosed", "NoEntry"], rested: false }
      ))
    })
  }
})

// spec/account/signIn.md, "Story: Read the service's terms before signing in"
it.live(`Terms are shown only as the service's plain published text (spec/account/signIn.md, "Story: Read the service's terms before signing in")`, () => effect {
  const document = { title: "Terms", revision: "r1", sections: [{ title: "Use", paragraphs: ["Plain text."] }] }
  const published = { ...cloudAnswers, "GET /api/public/service": { success: true, version: 1, service: { name: "Eliza Cloud", terms: document, privacy: { ...document, title: "Privacy" } } } }
  const later = { ...cloudAnswers, "GET /api/public/service": { success: true, version: 2, service: { name: "Eliza Cloud", terms: document, privacy: document } } }
  const shown = try scoped(effect { provide account([], signedInNative, published) { return try (try SignInScreen).serviceInfo() } })
  const unknown = try scoped(effect { provide account([], signedInNative, later) { return try (try SignInScreen).serviceInfo() } })
  const missing = try scoped(effect { provide account([]) { return try (try SignInScreen).serviceInfo() } })
  try Effect.try(() => assert.deepStrictEqual({ name: shown?.name, privacy: shown?.privacy.title, unknown, missing }, { name: "Eliza Cloud", privacy: "Privacy", unknown: undefined, missing: undefined }))
})

