  const calls: Calls = []
  const host = {
    ...signedOutNative({ key: false }),
    "AlphaCloudSignIn.status": { inApp: true, methodsKnown: true, google: true, email: true, phone: true },
    "AlphaCloudSignIn.startPhone": { attemptId: "attempt-1", expiresAt, resendAt: now }
  }
  provide account(calls, host) {
    try scoped(effect {
      const session = try CloudSession
      const signIn = try SignInScreen
      fork.scoped session.run()
      fork.scoped signIn.run()
