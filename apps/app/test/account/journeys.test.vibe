// spec/account/plan.md, "Story: See a plan change soon after I make it"
it.live(`Coming back from a payment page checks the plan once at once (spec/account/plan.md, "Story: See a plan change soon after I make it")`, () => effect {
  const calls: Calls = []
  provide account(calls) {
    try scoped(effect {
      const session = try CloudSession
      const entitlement = try Entitlement
      fork.scoped session.run()
      fork.scoped entitlement.run()
      try until(entitlement.changes, (a) => a.binding === "CloudBound" && !a.recheck.reading)
      const before = names(calls).filter((n) => n === "GET /api/v1/billing/limits").length
      // spec/account/plan.md, "A check runs at most once a minute, once at once after a real network return, and once after a payment page"
      try entitlement.foreground(true)
      const quiet = names(calls).filter((n) => n === "GET /api/v1/billing/limits").length
      try entitlement.paymentPageOpened()
      try entitlement.foreground(false)
      try entitlement.foreground(true)
      const checked = try found(try until(entitlement.changes, (a) => a.writes >= 2 && !a.recheck.reading))
      try Effect.try(() => assert.deepStrictEqual(
        { quiet: quiet === before, again: names(calls).filter((n) => n === "GET /api/v1/billing/limits").length > before, permit: checked.recheck.paymentReturn },
        { quiet: true, again: true, permit: false }
      ))
    })
  }
})

// spec/account/billing.md, "Story: Choose or change my plan in Alpha"
it.live(`Subscribing opens Stripe's page and Cloud's confirmation on return activates the plan (spec/account/billing.md, "Story: Choose or change my plan in Alpha")`, () => effect {
  const calls: Calls = []
  const plans = { plans: [{ key: "plus_monthly", name: "Plus", amountCents: 3000, currency: "usd", interval: "month", allowance: { amountUsd: "25" } }] }
  const cloud = {
    ...cloudAnswers,
    "GET /api/v1/subscriptions/plans": plans,
    "GET /api/v1/referrals": { code: "ALPHA-1", total_referrals: 0, is_active: true },
    "POST /api/v1/subscriptions/checkout": { status: "open", commandId: "cmd-1", checkoutUrl: "https://checkout.stripe.com/c/pay/plus", sessionId: "cs-1", expiresAt: now + 600000 },
    "POST /api/v1/subscriptions/checkout/confirm": { status: "completed", commandId: "cmd-1" }
  }
  provide account(calls, signedInNative, cloud) {
    try scoped(effect {
      const session = try CloudSession
      const entitlement = try Entitlement
      const membership = try Membership
      fork.scoped session.run()
      fork.scoped entitlement.run()
      fork.scoped membership.run()
      try until(membership.changes, (b) => b.owner === 1)
      // spec/account/billing.md, "The plans and the current plan are read when the manager opens"
      try membership.openManager()
      try until(membership.changes, (b) => b.manager === "ManagerShown")
      // spec/account/billing.md, "Subscribing opens Stripe's checkout, and only Cloud's confirmation on return activates the plan"
      try membership.subscribe("Plus")
      const waiting = try found(try until(membership.changes, (b) => b.checkout.tag === "AwaitingReturn"))
      try entitlement.foreground(false)
      try entitlement.foreground(true)
      const active = try found(try until(membership.changes, (b) => b.outcome === "PlanActive"))
      try Effect.try(() => assert.deepStrictEqual({
        asked: (calls.find((c) => c.name === "POST /api/v1/subscriptions/checkout")?.args as { planKey?: string } | undefined)?.planKey,
        opened: calls.filter((c) => c.name === "CloudServices.openExternal").map((c) => (c.args as { url: string }).url),
        waitingCurrent: waiting.current, current: active.current, checkout: active.checkout.tag,
        confirmed: calls.find((c) => c.name === "POST /api/v1/subscriptions/checkout/confirm")?.args
      }, {
        asked: "plus_monthly", opened: ["https://checkout.stripe.com/c/pay/plus"], waitingCurrent: { tag: "NoPaidPlan" },
        current: { tag: "OnPlan", plan: "Plus", endsAtPeriodEnd: false, paymentDue: false }, checkout: "NoCheckout", confirmed: { sessionId: "cs-1" }
      }))
    })
  }
})

// spec/account/billing.md, "Story: Redeem a membership code"
it.live(`A refused code says so and is sent only once, to the redemption (spec/account/billing.md, "Story: Redeem a membership code")`, () => effect {
  const calls: Calls = []
  provide account(calls) {
    try scoped(effect {
      const session = try CloudSession
      const membership = try Membership
      fork.scoped session.run()
      fork.scoped membership.run()
      try until(membership.changes, (b) => b.owner === 1)
      const started = try membership.redeem("  GIFT-CODE-7  ")
      const settled = try found(try until(membership.changes, (b) => b.redeem.tag === "RedeemIdle" && b.outcome !== "NoOutcome"))
      const carrying = calls.filter((c) => JSON.stringify(c.args ?? null).includes("GIFT-CODE-7")).map((c) => c.name)
      try Effect.try(() => assert.deepStrictEqual({ started, outcome: settled.outcome, carrying }, { started: true, outcome: "CodeRefused", carrying: ["POST /api/v1/subscription/redeem"] }))
    })
  }
})

// spec/account/billing.md, "Story: Share or enter a referral code"
it.live(`A referral code is applied once, trimmed (spec/account/billing.md, "Story: Share or enter a referral code")`, () => effect {
  const calls: Calls = []
  provide account(calls, signedInNative, { ...cloudAnswers, "POST /api/v1/referrals/apply": { success: true } }) {
    try scoped(effect {
      const session = try CloudSession
      const membership = try Membership
      fork.scoped session.run()
      fork.scoped membership.run()
      try until(membership.changes, (b) => b.owner === 1)
      try membership.applyReferral("  REF-1234 ")
      const applied = try found(try until(membership.changes, (b) => b.outcome === "ReferralApplied"))
      try membership.applyReferral("no spaces allowed here")
      try Effect.try(() => assert.deepStrictEqual(
        { sent: calls.filter((c) => c.name === "POST /api/v1/referrals/apply").map((c) => c.args), referring: applied.referring },
        { sent: [{ code: "REF-1234" }], referring: false }
      ))
    })
  }
})

// spec/account/sheet.md, "Story: Look after my account in one place"
it.live(`Sign-out is confirmed only for the reviewed account, and Home closes the sheet (spec/account/sheet.md, "Story: Look after my account in one place")`, () => effect {
  const calls: Calls = []
  provide account(calls) {
    try scoped(effect {
      const session = try CloudSession
      const sheet = try AccountSheet
      fork.scoped session.run()
      fork.scoped sheet.run()
      try until(sheet.changes, (s) => s.owner === 1)
      try sheet.show()
      try sheet.askSignOut()
      try sheet.close()
      const dismissed = names(calls).includes("DELETE /api/v1/api-keys/current")
      try sheet.show()
      try sheet.askSignOut()
      const reviewing = try sheet.current()
      try sheet.confirmSignOut()
      const after = try found(try until(sheet.changes, (s) => s.owner === 0))
      try sheet.returnHome()
      const home = try sheet.current()
      try Effect.try(() => assert.deepStrictEqual(
        { dismissed, reviewOwner: reviewing.reviewOwner, revoked: names(calls).includes("DELETE /api/v1/api-keys/current"), confirmed: after.confirmed, home: [home.open, home.covered] },
        { dismissed: false, reviewOwner: 1, revoked: true, confirmed: 1, home: [false, false] }
      ))
    })
  }
})

// spec/account/sheet.md, "Story: Notice what needs my attention"
it.live(`A plan that needs attention is a Home notice until dismissed (spec/account/sheet.md, "Story: Notice what needs my attention")`, () => effect {
  provide account([], signedInNative, { ...cloudAnswers, "GET /api/v1/billing/limits": snapshot(0) }) {
    try scoped(effect {
      const session = try CloudSession
      const entitlement = try Entitlement
      const sheet = try AccountSheet
      fork.scoped session.run()
      fork.scoped entitlement.run()
      fork.scoped sheet.run()
      const needed = try found(try until(sheet.changes, (s) => s.planRequired))
      try sheet.covered(true)
      const covered = try sheet.current()
      try sheet.covered(false)
      try sheet.dismissPlan()
      const dismissed = try sheet.current()
      const got5 = try entitlement.current()
      try Effect.try(() => assert.deepStrictEqual(
        { needed: needed.planRequired, coveredHides: covered.covered, dismissed: dismissed.planDismissed, admission: got5.notice },
        { needed: true, coveredHides: true, dismissed: true, admission: "NeedsPlanNotice" }
      ))
    })
  }
})

// spec/account/google.md, "Story: Use and remove my Google access"
it.live(`A disconnect is confirmed only by reading the accounts back (spec/account/google.md, "Story: Use and remove my Google access")`, () => effect {
  const calls: Calls = []
  const connected = { connectionId: "conn-1", email: "owner@example.com", grantedCapabilities: ["google.basic_identity", "google.gmail.triage", "google.gmail.manage"] }
  const state = { connected: true }
  const cloud = {
    ...cloudAnswers,
    "GET /api/v1/eliza/google/accounts?side=owner": () => ({ accounts: state.connected ? [connected] : [] }),
    "POST /api/v1/eliza/google/disconnect": () => {
      state.connected = false
      return { success: true }
    }
  }
  provide account(calls, signedInNative, cloud) {
    try scoped(effect {
      const session = try CloudSession
      const google = try GoogleAccounts
      fork.scoped session.run()
      fork.scoped google.run()
      try until(google.changes, (g) => g.owner === 1)
      try google.open("SettingsPanel")
      try until(google.changes, (g) => g.account !== 0 && !g.readPending)
      // spec/account/google.md, "Cached mail needs read access, and a review needs change access"
      try google.showCache()
      try google.prepareReview()
      const using = try google.current()
      // spec/account/google.md, "A disconnect is confirmed only by reading the accounts back"
      try google.disconnect()
      const gone = try found(try until(google.changes, (g) => g.outcome !== "NoDisconnect"))
      try Effect.try(() => assert.deepStrictEqual(
        { using: [using.cacheVisible, using.review], gone: [gone.outcome, gone.account, gone.readGrant, gone.cacheVisible], asked: calls.find((c) => c.name === "POST /api/v1/eliza/google/disconnect")?.args },
        { using: [true, true], gone: ["Disconnected", 0, false, false], asked: { side: "owner", connectionId: "conn-1" } }
      ))
    })
  }
})

// spec/account/agentAccess.md, "Story: Choose what the agent may change through Google"
it.live(`The switches are published in order, and an outdated change is refused (spec/account/agentAccess.md, "Story: Choose what the agent may change through Google")`, () => effect {
  const calls: Calls = []
  provide account(calls) {
    try scoped(effect {
      const access = try GoogleAgentAccess
      try access.run()
      const published = try access.current()
      try access.set("GmailChanges", false, published.revision)
      try access.set("CalendarEdits", false, published.revision)
      const after = try access.current()
      try Effect.try(() => assert.deepStrictEqual({
        writes: calls.filter((c) => c.name === "Agent.setGoogleAgentAccess").map((c) => c.args),
        after: [after.saved, after.host, after.refused, after.hostUnconfirmed]
      }, {
        writes: [{ gmailChanges: true, calendarEdits: true }, { gmailChanges: false, calendarEdits: true }],
        after: [{ gmailChanges: false, calendarEdits: true }, { gmailChanges: false, calendarEdits: true }, 1, false]
      }))
    })
  }
})

// spec/account/delegation.md, "Story: Let Cloud run my hosted results"
it.live(`Authorizing keeps the pending record in the account's slot and opens Cloud's page (spec/account/delegation.md, "Story: Let Cloud run my hosted results")`, () => effect {
  const calls: Calls = []
  // spec/account/delegation.md, "The authorization page is the deployment's own"
  const authUrl = `https://eliza.app/app-auth/authorize?state=${"s".repeat(43)}`
  const slots = new Map<string, string>()
  const native = {
    ...signedInNative,
    "ElizaSecureStore.get": (args: unknown) => ({ value: slots.get((args as { key: string }).key) ?? null }),
    "ElizaSecureStore.compareAndExchange": (args: unknown) => {
      const { key, expected, value } = args as { key: string; expected: string | null; value: string | null }
      if ((slots.get(key) ?? null) !== expected) return { exchanged: false }
      if (value === null) slots.delete(key)
      else slots.set(key, value)
      return { exchanged: true }
    }
  }
  const resident = {
    "POST /api/workflow/hosted/cloud-delegation/revocations": { grants: [] },
    "POST /api/workflow/hosted/cloud-delegation/start": { authUrl, expiresAt: new Date(now + 600000).toISOString() }
  }
  provide account(calls, native, cloudAnswers, { resident }) {
    try scoped(effect {
      const session = try CloudSession
      const delegation = try CloudDelegation
      fork.scoped session.run()
      fork.scoped delegation.run()
      try until(delegation.changes, (d) => d.owner === 1)
      try delegation.start(true, false)
      const waiting = try found(try until(delegation.changes, (d) => d.record === "WaitingRecord" && d.running === "NoStep"))
      const saved = calls.find((c) => c.name === "ElizaSecureStore.compareAndExchange")?.args as { key: string; value: string } | undefined
      try Effect.try(() => assert.deepStrictEqual({
        kinds: (calls.find((c) => c.name === "POST /api/workflow/hosted/cloud-delegation/start")?.args as { kinds?: Array<string> } | undefined)?.kinds,
        slot: saved?.key.startsWith("account-delegation:v1:"), never: names(calls).some((n) => n.startsWith("AlphaConnection.secure")), phase: saved === undefined ? undefined : (JSON.parse(saved.value) as { phase: string }).phase,
        opened: calls.filter((c) => c.name === "CloudServices.openExternal").map((c) => (c.args as { url: string }).url),
        grant: waiting.grant, cloud: waiting.cloud
      }, { kinds: ["email"], slot: true, never: false, phase: "waiting", opened: [authUrl], grant: false, cloud: "CloudWaiting" }))
    })
  }
})

// spec/account/provider.md, "Story: Use my own keys instead of Cloud"
it.live(`Own keys go to the host only, and switching back keeps them (spec/account/provider.md, "Story: Use my own keys instead of Cloud")`, () => effect {
  const calls: Calls = []
  const key = "csk-test-key-0123456789"
  const host = { mode: "cloud" as "cloud" | "own", text: false, voice: false, revision: 1 }
  const status = () => providerStatus(host.mode, host.text, host.voice, `r${host.revision}`)
  const native = {
    ...signedInNative,
    "Agent.providerStatus": status,
    "Agent.configureProvider": () => {
      host.mode = "own"
      host.text = true
      host.revision += 1
      return status()
    },
    "Agent.selectProvider": (args: unknown) => {
      if ((args as { expectedRevision?: string }).expectedRevision !== `r${host.revision}`) return { refuse: "stale" }
      host.mode = (args as { mode: "cloud" | "own" }).mode
      host.revision += 1
      return status()
    }
  }
  provide account(calls, native) {
    try scoped(effect {
      const session = try CloudSession
      const provider = try AiProvider
      fork.scoped session.run()
      fork.scoped provider.run()
      try until(provider.changes, (p) => p.known && p.signedIn)
      // spec/account/provider.md, "Saving keys selects them, and adds a key only on the host's word"
      try provider.save(` ${key} `, "")
      const saved = try provider.current()
      // spec/account/provider.md, "Switching keeps both keys, needs a saved text key for own keys and a sign-in for Cloud"
      try provider.choose("CloudRoute")
      const back = try provider.current()
      // spec/account/provider.md, "A key is removed only after its own review, and shown only in the host's secure dialog"
      try provider.confirmRemove()
      const carrying = calls.filter((c) => JSON.stringify(c.args ?? null).includes(key)).map((c) => c.name)
      try Effect.try(() => assert.deepStrictEqual({
        saved: [saved.route, saved.textKey, saved.voiceKey, saved.fault], back: [back.route, back.textKey, back.switches],
        carrying, chose: calls.find((c) => c.name === "Agent.selectProvider")?.args,
        removedWithoutReview: names(calls).includes("Agent.removeProviderKey")
      }, {
        saved: ["OwnRoute", true, false, "NoProviderFault"], back: ["CloudRoute", true, 1],
        carrying: ["Agent.configureProvider"], chose: { mode: "cloud", expectedRevision: "r2", requestId: "lease-1" },
        removedWithoutReview: false
      }))
    })
  }
})

// spec/account/provider.md, "A voice key alone is changed in place, keeping the saved text key and the route"
it.live(`A voice key alone changes in place, never resending the text key or switching route (spec/account/provider.md, "A voice key alone is changed in place, keeping the saved text key and the route")`, () => effect {
  const calls: Calls = []
  const voice = "sk_car_test-voice-0123456789"
  const host = { mode: "own" as "cloud" | "own", text: true, voice: false, revision: 1, lose: false }
  const status = () => providerStatus(host.mode, host.text, host.voice, `r${host.revision}`)
  const native = {
    ...signedInNative,
    "Agent.providerStatus": status,
    "Agent.editProviderKeys": (args: unknown) => {
      const edit = args as { textKey?: string; voiceKey?: string; expectedRevision?: string }
      if (edit.expectedRevision !== `r${host.revision}` || edit.textKey !== undefined) return { refuse: "stale" }
      host.voice = true
      host.revision += 1
      return host.lose ? { refuse: "lost" } : status()
    }
  }
  provide account(calls, native) {
    try scoped(effect {
      const session = try CloudSession
      const provider = try AiProvider
      fork.scoped session.run()
      fork.scoped provider.run()
      try until(provider.changes, (p) => p.known && p.signedIn && p.textKey)
      try provider.save("", ` ${voice} `)
      const edited = try provider.current()
      host.lose = true
      try provider.save("", voice)
      const readBack = try provider.current()
      try Effect.try(() => assert.deepStrictEqual({
        edited: [edited.route, edited.textKey, edited.voiceKey, edited.edits, edited.saves, edited.fault],
        readBack: [readBack.work, readBack.route, readBack.textKey, readBack.voiceKey, readBack.lost, readBack.fault],
        sent: calls.filter((c) => c.name === "Agent.editProviderKeys").map((c) => c.args),
        configured: names(calls).includes("Agent.configureProvider"), switched: names(calls).includes("Agent.selectProvider")
      }, {
        edited: ["OwnRoute", true, true, 1, 0, "NoProviderFault"],
        readBack: ["ProviderIdle", "OwnRoute", true, true, 1, "NoProviderFault"],
        sent: [
          { voiceKey: voice, expectedRevision: "r1", requestId: "lease-1" },
          { voiceKey: voice, expectedRevision: "r2", requestId: "lease-1" }
        ],
        configured: false, switched: false
      }))
    })
  }
})
