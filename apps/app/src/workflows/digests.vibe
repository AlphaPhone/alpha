// spec/app/digests/index.md, "Story: See my digests"; spec/app/digests/index.md, "Story: Receive results without losing or repeating one"; spec/app/digests/schedules.md, "Story: Keep my digest schedules"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { type WorkflowRequest, WorkflowAdmissionRejected, WorkflowHttpError, WorkflowLifecycleRejected, WorkflowResponseInvalid, type DigestLoop, type DigestResult, type DigestSource, type DigestSpec, digestSourceState, hostedDigestProtocol, missedRunNowOffers } from "@elizaos/plugin-workflow-client"
import * as List from "../../gen/app__workflows__list.effect.vibe"
import * as Plan from "../../gen/app__digests__schedules.effect.vibe"
import type { Change, Effect as Out, Event, Template } from "../../gen/app__digests__schedules.effect.vibe"
import { canFile } from "../../gen/app__workflows__request.effect.vibe"
import { Agent } from "../platform/index.vibe"
import { Device } from "../platform/index.vibe"
import { launchOwnerAt, sameResidentOwner } from "../platform/index.vibe"
import { type Job, answer, applying, following, reacting, started, together } from "../runtime/index.vibe"
import { Attempts } from "../runtime/index.vibe"
import { createShelf } from "../runtime/index.vibe"
import { Time } from "../runtime/index.vibe"
import { WorkflowsApi, checkedWorkflowRequest, localTimeZone } from "./api.vibe"
import { DigestHistory, digestScope } from "./brief.vibe"
import { Rows } from "./list.vibe"

interface Numbered<T> { readonly number: number; readonly record: T }

export interface DigestView {
  readonly owner: number
  readonly loops: readonly Numbered<DigestLoop>[]
  readonly sources: readonly Numbered<DigestSource>[]
  readonly results: readonly DigestResult[]
  readonly partial: boolean
  readonly capable: boolean
}

export interface DigestWordsSnapshot {
  readonly view: DigestView
  readonly zoneOwner: number
  readonly zone: string
  readonly observedAt: number
}

const empty: DigestView = { owner: 0, loops: [], sources: [], results: [], partial: false, capable: false }
const emptySnapshot: DigestWordsSnapshot = { view: empty, zoneOwner: 0, zone: "", observedAt: 0 }

export service DigestWords {
  view(owner: number): DigestView!!
  store(value: DigestView, observedAt?: number): void!!
  number(owner: number, key: string): number!!
  zone(owner: number): string!!
  reviewZone(owner: number, zone: string): void!!
  tick(now: number): void!!
  snapshot(this: void): DigestWordsSnapshot
  subscribe(this: void, listener: () => void): () => void
}

const words = Layer.sync(DigestWords, () => {
  const shelf = createShelf<DigestWordsSnapshot>(emptySnapshot)
  const numbers = new Map<string, number>()
  let known = 0
  let next = 0
  return {
    view: (owner: number) => sync(() => {
      const shown = shelf.get().view
      return shown.owner === owner ? shown : empty
    }),
    store: (value: DigestView, observedAt?: number) => sync(() => {
      shelf.update((cur) => ({ ...cur, view: value, ...(observedAt === undefined ? {} : { observedAt }) }))
    }),
    zone: (owner: number) => sync(() => {
      const cur = shelf.get()
      return cur.zoneOwner === owner ? cur.zone : ""
    }),
    reviewZone: (owner: number, zone: string) => sync(() => {
      shelf.update((cur) => ({ ...cur, zoneOwner: owner, zone }))
    }),
    tick: (now: number) => sync(() => {
      shelf.update((cur) => cur.observedAt === now ? cur : { ...cur, observedAt: now })
    }),
    snapshot: shelf.snapshot,
    subscribe: shelf.subscribe,
    number: (owner: number, key: string) => sync(() => {
      if (owner !== known) { known = owner; numbers.clear() }
      const number = numbers.get(key) ?? ++next
      numbers.set(key, number)
      return number
    }),
  }
})

/** Build a hosted digest protocol client that verifies `ownsRequest` before and after every request. */
export function ownedDigestProtocol(request: WorkflowRequest, ownsRequest: boolean!!) {
  return hostedDigestProtocol(checkedWorkflowRequest(request, ownsRequest))
}

type Needs = Agent | Device | Rows | WorkflowsApi | DigestWords | DigestHistory | List.Machine | Plan.Machine | KeyValueStore.KeyValueStore | Time

effect function read(ticket: number, owner: number): Event!!Needs {
  const fail: Event = { type: "schedulesRead", ticket, ok: false, count: 0, standing: "NoSchedule", template: "Morning",
    hour: 8, minute: 0, zone: 0, source: 0, missed: 0, evening: false }
  const rows = try Rows
  const identity = launchOwnerAt() catch () => undefined
  const { request } = try WorkflowsApi
  const plan = try Plan.Machine
  const fallback = { ...fail, missed: (try plan.get()).missed }
  if (identity === undefined || !(try rows.sameDigestOwner(identity, owner))) return fallback
  const agent = try Agent
  const ownsRequest = effect {
    const confirmed = Effect.provideService(launchOwnerAt(), Agent, agent) catch () => undefined
    return sameResidentOwner(identity, confirmed) && (try rows.sameDigestOwner(identity, owner))
  }
  const protocol = ownedDigestProtocol(request, ownsRequest)
  const supported = (protocol.capabilities() catch () => undefined)
  if (supported === undefined) return fallback
  const payload = effect {
    if (!supported.digests) return { ...empty, owner }
    const history = try DigestHistory
    const found = try all({
      loops: Effect.orElseSucceed(protocol.loops(), () => undefined),
      sources: Effect.orElseSucceed(protocol.sources(), () => undefined),
      results: history.sync(identity, protocol),
    }, { concurrency: 3 })
    const cached = found.results.rows ?? []
    const view = try DigestWords
    const loops: Numbered<DigestLoop>[] = []
    for (const record of found.loops ?? []) {
      if (!record.removed) loops.push({ number: try view.number(owner, `loop:${record.id}`), record })
    }
    const sources: Numbered<DigestSource>[] = []
    for (const record of found.sources ?? []) sources.push({ number: try view.number(owner, `source:${record.id}`), record })
    return {
      owner, loops, sources,
      results: [...cached].sort((a, b) => b.cursor - a.cursor),
      partial: found.loops === undefined || found.sources === undefined || !found.results.current, capable: true,
    } satisfies DigestView
  }
  const current = try payload
  if (!(try ownsRequest)) return fallback
  const now = try (try Time).now()
  const state = try plan.get()
  const listing = try (try List.Machine).get()
  const selected = current.loops.find((item) => item.number === state.row)?.record
  const offers = missedRunNowOffers(current.results, current.loops.map((item) => item.record), current.sources.map((item) => item.record), now)
  const newestMissed = selected === undefined ? state.missed : current.results.reduce((best, entry) =>
    entry.workflowId === selected.id && offers.has(entry.runId) && entry.cursor > best ? entry.cursor : best, state.missed)
  if (state.owner !== owner || listing.owner !== owner || listing.place.tag !== "ListingDigests" ||
    !Plan.canSchedulesRead(state, ticket, current.loops.length, newestMissed, 8, 0, 0)) return fallback
  try (try DigestWords).store(current, now)
  const source = current.sources.find((item) => item.record.id === selected?.spec.sourceId)
  const time = selected?.spec.localTime?.match(/^(\d{2}):(\d{2})$/)
  const hours = Number(time?.[1] ?? 8)
  const minutes = Number(time?.[2] ?? 0)
  return {
    ...fallback, ok: !current.partial || current.loops.length > 0, count: current.loops.length, template: selected?.spec.template === "evening" ? "Evening" : "Morning",
    hour: hours <= 23 ? hours : 8, minute: minutes <= 59 ? minutes : 0, source: source?.number ?? 0, missed: newestMissed,
    standing: selected === undefined ? "NoSchedule" : selected.sourceState === "expired" || selected.sourceState === "revoked" ? "SourceLapsed" : selected.active ? "Active" : "Paused",
    evening: supported.nativeEvening,
  }
}

const digestZone = localTimeZone

const Saved = Schema.Struct({ receipt: Schema.Struct({
  mutationId: Schema.NonEmptyString, workflowId: Schema.NonEmptyString, versionId: Schema.NonEmptyString,
}) })

const HeldDigestChange = Schema.fromJsonString(Schema.Struct({
  id: Schema.Int,
  wanted: Schema.Literals(["Create", "Pause", "Resume", "Remove"]),
  mutationId: Schema.NonEmptyString,
  workflowId: Schema.optionalKey(Schema.NonEmptyString),
  versionId: Schema.optionalKey(Schema.NonEmptyString),
  template: Schema.optionalKey(Schema.Literals(["morning", "evening"])),
  sourceId: Schema.optionalKey(Schema.NonEmptyString),
  localTime: Schema.optionalKey(Schema.NonEmptyString),
  timeZone: Schema.optionalKey(Schema.NonEmptyString),
  existingLoopIds: Schema.optionalKey(Schema.Array(Schema.String)),
}))

const HeldDigestRun = Schema.fromJsonString(Schema.Struct({
  id: Schema.Int,
  occurrence: Schema.Int,
  workflowId: Schema.NonEmptyString,
  versionId: Schema.NonEmptyString,
  submissionId: Schema.NonEmptyString,
}))

const digestChangeKey = (scope: string) => `${scope}/schedule-change`
const digestRunKey = (scope: string) => `${scope}/schedule-run`

effect function change(id: number, wanted: Change, template: Template, hour: number, minute: number, source: number): Event!!(Needs | Attempts) {
  const machine = try Plan.Machine
  const current = try machine.get()
  const identity = launchOwnerAt() catch () => undefined
  const { request, workflow } = try WorkflowsApi
  const store = try KeyValueStore.KeyValueStore
  const failed: Event = { type: "changeAnswered", id, applied: false }
  if (identity === undefined || !(try (try Rows).sameDigestOwner(identity, current.owner))) return failed
  const words = try DigestWords
  const view = try words.view(current.owner)
  const selected = view.loops.find((item) => item.number === current.row)?.record
  const grant = view.sources.find((item) => item.number === source)?.record
  const now = try (try Time).now()
  const zone = try words.zone(current.owner)
  const scope = digestScope(identity)
  const key = digestChangeKey(scope)
  const rawPrior = (store.get(key) catch () => "unreachable")
  const prior = rawPrior === undefined || rawPrior === "unreachable"
    ? undefined : (Schema.decodeUnknownEffect(HeldDigestChange)(rawPrior) catch () => undefined)
  if (current.change.again && (prior === undefined || prior.id !== id || prior.wanted !== wanted)) return { type: "changeUnanswered" }
  if (!current.change.again && rawPrior !== undefined) return { type: "changeUnanswered" }
  const mutationId = prior?.mutationId ?? (try (try Attempts).key(id))
  const reaffirmed = launchOwnerAt() catch () => undefined
  if (!sameResidentOwner(identity, reaffirmed) || !(try (try Rows).sameDigestOwner(identity, current.owner))) return failed
  let dispatched = current.change.again
  const applied = effect {
    if (wanted === "Remove") {
      if (selected === undefined) return false
      const keep = effect (recordedMutation: string) => {
        store.set(key, JSON.stringify({
          id, wanted, mutationId: recordedMutation, workflowId: selected.id, versionId: selected.versionId,
        })) catch effect () => { throw new WorkflowResponseInvalid({ message: "Could not retain digest removal" }) }
        dispatched = true
      }
      const removed = try workflow.lifecycle(selected.id, selected.versionId, "remove", keep)
      return removed.workflowId === selected.id
    }
    if (wanted === "Create" && (grant === undefined || zone === "" || digestSourceState(grant, now) !== "current")) return false
    if (wanted !== "Create" && selected === undefined) return false
    const spec: DigestSpec | undefined = wanted === "Create" && grant !== undefined
      ? { version: 1, template: template === "Morning" ? "morning" : "evening", sourceId: grant.id, sourceRevision: grant.revision,
          timeZone: zone, localTime: `${String(hour).padStart(2, "0")}:${String(minute).padStart(2, "0")}`, enabled: true }
      : selected === undefined ? undefined : { ...selected.spec, enabled: wanted === "Resume" }
    if (spec === undefined) return false
    if (!current.change.again) {
      store.set(key, JSON.stringify({
        id, wanted, mutationId,
        ...(selected === undefined ? {} : { workflowId: selected.id, versionId: selected.versionId }),
        template: spec.template, sourceId: spec.sourceId, localTime: spec.localTime, timeZone: spec.timeZone,
        ...(wanted === "Create" ? { existingLoopIds: view.loops.map((item) => item.record.id) } : {}),
      })) catch effect () => { throw new WorkflowResponseInvalid({ message: "Could not retain digest change" }) }
    }
    dispatched = true
    const protocol = hostedDigestProtocol(request)
    const target = wanted === "Create" || selected === undefined ? {} : { id: selected.id, expectedVersionId: selected.versionId }
    const result = try protocol.mutate("loops", { ...target, mutationId, confirmed: true, spec })
    const reply = try Schema.decodeUnknownEffect(Saved)(result)
    return reply.receipt.mutationId === mutationId && (wanted === "Create" || reply.receipt.workflowId === selected?.id)
  } catch (failure) => !dispatched || failure instanceof WorkflowLifecycleRejected ||
    (failure instanceof WorkflowHttpError && [400, 401, 403, 404, 409, 422].includes(failure.status)) ? false : undefined
  const confirmed = launchOwnerAt() catch () => undefined
  if (applied === undefined || !sameResidentOwner(identity, confirmed) ||
    !(try (try Rows).sameDigestOwner(identity, current.owner))) return { type: "changeUnanswered" }
  try ignore(store.remove(key))
  return { ...failed, applied }
}

effect function loadDigestCheck(keyOf: (scope: string) => string) {
  const machine = try Plan.Machine
  const current = try machine.get()
  const identity = launchOwnerAt() catch () => undefined
  if (identity === undefined || !(try (try Rows).sameDigestOwner(identity, current.owner))) return undefined
  const store = try KeyValueStore.KeyValueStore
  const key = keyOf(digestScope(identity))
  const raw = (store.get(key) catch () => undefined)
  return { machine, current, identity, store, key, raw }
}

effect function checkChange(ticket: number, id: number): Event!!Needs {
  const failed: Event = { type: "changeChecked", ticket, ok: false, found: false }
  const ctx = try loadDigestCheck(digestChangeKey)
  if (ctx === undefined) return failed
  const { machine, current, identity, store, key, raw } = ctx
  const held = raw === undefined ? undefined : (Schema.decodeUnknownEffect(HeldDigestChange)(raw) catch () => undefined)
  if (held === undefined || held.id !== id) return failed
  const { request, workflow } = try WorkflowsApi
  const found: boolean | undefined = effect {
    if (held.wanted === "Remove") {
      if (held.workflowId === undefined || held.versionId === undefined) return false
      const receipt = try workflow.reconcileLifecycle(held.workflowId, held.versionId, held.mutationId, "remove")
      return receipt !== null
    }
    const loops = try hostedDigestProtocol(request).loops()
    if (held.wanted === "Create") {
      const prior = new Set(held.existingLoopIds ?? [])
      return loops.some((loop) => !loop.removed && !prior.has(loop.id) &&
        (held.template === undefined || loop.spec.template === held.template) &&
        (held.sourceId === undefined || loop.spec.sourceId === held.sourceId) &&
        (held.localTime === undefined || loop.spec.localTime === held.localTime) &&
        (held.timeZone === undefined || loop.spec.timeZone === held.timeZone))
    }
    const target = loops.find((loop) => loop.id === held.workflowId)
    if (target === undefined || target.removed) return false
    const wantEnabled = held.wanted === "Resume"
    return target.versionId !== held.versionId && target.spec.enabled === wantEnabled
  } catch () => undefined
  const confirmed = launchOwnerAt() catch () => undefined
  const live = try machine.get()
  if (found === undefined || !sameResidentOwner(identity, confirmed) ||
    !(try (try Rows).sameDigestOwner(identity, current.owner)) || !Plan.canChangeChecked(live, ticket)) return failed
  if (found) try ignore(store.remove(key))
  return { type: "changeChecked", ticket, ok: true, found }
}

effect function runDigest(id: number, occurrence: number): Event!!Needs {
  const refused: Event = { type: "runNowAnswered", id, applied: false }
  const lost: Event = { type: "runNowUnanswered" }
  const machine = try Plan.Machine
  const current = try machine.get()
  const identity = launchOwnerAt() catch () => undefined
  if (identity === undefined || !(try (try Rows).sameDigestOwner(identity, current.owner))) return refused
  const view = try (try DigestWords).view(current.owner)
  const selected = view.loops.find((item) => item.number === current.row)?.record
  if (selected === undefined || selected.removed || !selected.active) return refused
  const store = try KeyValueStore.KeyValueStore
  const { workflow } = try WorkflowsApi
  const key = digestRunKey(digestScope(identity))
  const rawPrior = (store.get(key) catch () => "unreachable")
  const prior = rawPrior === undefined || rawPrior === "unreachable"
    ? undefined : (Schema.decodeUnknownEffect(HeldDigestRun)(rawPrior) catch () => undefined)
  if (current.runNow.again && (prior === undefined || prior.id !== id || prior.workflowId !== selected.id || prior.versionId !== selected.versionId)) return lost
  if (!current.runNow.again && rawPrior !== undefined) return lost
  let dispatched = current.runNow.again
  const hold = effect (submissionId: string) => {
    store.set(key, JSON.stringify({ id, occurrence, workflowId: selected.id, versionId: selected.versionId, submissionId }))
      catch effect () => { throw new WorkflowResponseInvalid({ message: "Could not retain digest run" }) }
    dispatched = true
  }
  const outcome = effect {
    if (prior !== undefined) try workflow.resubmit(selected.id, selected.versionId, prior.submissionId)
    else try workflow.run(selected.id, selected.versionId, hold)
    return "accepted" as const
  } catch (failure) => !dispatched || failure instanceof WorkflowAdmissionRejected ||
    (failure instanceof WorkflowHttpError && [400, 401, 403, 404, 409, 422].includes(failure.status))
    ? "refused" as const : "unknown" as const
  const confirmed = launchOwnerAt() catch () => undefined
  if (!sameResidentOwner(identity, confirmed) || !(try (try Rows).sameDigestOwner(identity, current.owner)) || outcome === "unknown") return lost
  if (outcome === "accepted" || !current.runNow.again) try ignore(store.remove(key))
  return { type: "runNowAnswered", id, applied: outcome === "accepted" }
}

effect function checkRun(ticket: number, id: number): Event!!Needs {
  const failed: Event = { type: "runNowChecked", ticket, ok: false, found: false }
  const ctx = try loadDigestCheck(digestRunKey)
  if (ctx === undefined) return failed
  const { machine, current, identity, store, key, raw } = ctx
  const held = raw === undefined ? undefined : (Schema.decodeUnknownEffect(HeldDigestRun)(raw) catch () => undefined)
  if (held === undefined || held.id !== id) return failed
  const { workflow } = try WorkflowsApi
  const answer = (workflow.reconcile(held.workflowId, held.versionId, held.submissionId) catch () => undefined)
  const confirmed = launchOwnerAt() catch () => undefined
  const live = try machine.get()
  if (answer === undefined || !sameResidentOwner(identity, confirmed) ||
    !(try (try Rows).sameDigestOwner(identity, current.owner)) || !Plan.canRunNowChecked(live, ticket)) return failed
  const found = answer !== null
  if (found) try ignore(store.remove(key))
  return { type: "runNowChecked", ticket, ok: true, found }
}

function carry(fx: Out): Job<Event, Needs, []> {
  return match (fx) {
    when { tag: "ReadSchedules", let ticket, let owner }: answer("scheduled digests", read(ticket, owner), {
      type: "schedulesRead", ticket, ok: false, count: 0, standing: "NoSchedule", template: "Morning", hour: 8, minute: 0, zone: 0, source: 0, missed: 0, evening: false,
    });
    when { tag: "AskAgent", let id, change: let wanted, let template, let hour, let minute, let source }:
      answer("change digest schedule", change(id, wanted, template, hour, minute, source), { type: "changeUnanswered" });
    when { tag: "ReadChangeRecord", let ticket, let id }: answer("check digest schedule", checkChange(ticket, id), { type: "changeChecked", ticket, ok: false, found: false });
    when { tag: "RunDigest", let id, let occurrence }: answer("run digest", runDigest(id, occurrence), { type: "runNowUnanswered" });
    when { tag: "ReadRunRecord", let ticket, let id }: answer("check digest result", checkRun(ticket, id), { type: "runNowChecked", ticket, ok: false, found: false });
  }
}

const place = applying(List.Machine, (state) => ({ owner: state.owner, open: state.place.tag === "ListingDigests" }),
  effect ({ owner, open }: { owner: number; open: boolean }) => {
    const model = try Plan.Machine
    if ((try model.get()).owner !== owner) {
      try (try DigestWords).store(empty)
      try ignore(model.send({ type: "ownerChanged", owner }))
    }
    try ignore(model.send({ type: open ? "openPanel" : "closePanel" }))
  })

const saving = following(Plan.Machine, (state) => Plan.canSendChange(state), Plan.Machine,
  (ready): Event | undefined => ready ? { type: "sendChange" } : undefined)

const sendingRunNow = following(Plan.Machine, (state) => Plan.canSendRunNow(state), Plan.Machine,
  (ready): Event | undefined => ready ? { type: "sendRunNow" } : undefined)

const clearReleased = applying(
  Plan.Machine,
  (state) => ({ owner: state.owner, changeFree: canFile(state.change), runFree: canFile(state.runNow) }),
  effect ({ owner, changeFree, runFree }: { owner: number; changeFree: boolean; runFree: boolean }) => {
    if (owner <= 0 || (!changeFree && !runFree)) return
    const identity = launchOwnerAt() catch () => undefined
    if (identity === undefined || !(try (try Rows).sameDigestOwner(identity, owner))) return
    const store = try KeyValueStore.KeyValueStore
    const scope = digestScope(identity)
    if (changeFree) try ignore(store.remove(digestChangeKey(scope)))
    if (runFree) try ignore(store.remove(digestRunKey(scope)))
  },
)

const digestClock = started(effect {
  const plan = try Plan.Machine
  const device = try Device
  const time = try Time
  const words = try DigestWords
  const visible = Stream.concat(Stream.fromEffect(device.showing()), device.visible)
  const open = Stream.map(plan.changes, (state) => state.open)
  const active = Stream.changes(Stream.map(Stream.zipLatest(open, visible), ([isOpen, isShown]) => isOpen && isShown))
  try Stream.runDrain(Stream.switchMap(active, (running) => running ? Stream.concat(
    Stream.fromEffectDrain(effect { try words.tick(try time.now()) }),
    Stream.fromEffectRepeat(effect {
      try sleep("60 seconds")
      try words.tick(try time.now())
    }),
  ) : Stream.empty))
}, "updating digest freshness clock while panel is visible")

export effect function newDigest(): void!!(Plan.Machine | DigestWords) {
  const plan = try Plan.Machine
  const state = try plan.get()
  if (!Plan.canOpenEditor(state, 0)) return
  try (try DigestWords).reviewZone(state.owner, digestZone())
  try ignore(plan.send({ type: "openEditor", zone: 0 }))
}

export effect function pickDigestSource(source: number): void!!(Plan.Machine | DigestWords | Time) {
  const plan = try Plan.Machine
  const state = try plan.get()
  const words = try (try DigestWords).view(state.owner)
  const selected = words.sources.find((item) => item.number === source)?.record
  const fresh = selected !== undefined && digestSourceState(selected, try (try Time).now()) === "current"
  try ignore(plan.send({ type: "pickSource", source, fresh }))
}

export effect function backDigests(): boolean!!Plan.Machine {
  const plan = try Plan.Machine
  const state = try plan.get()
  if (Plan.canCancelRunNow(state)) { try ignore(plan.send({ type: "cancelRunNow" })); return true }
  if (Plan.canCancelReview(state)) { try ignore(plan.send({ type: "cancelReview" })); return true }
  if (Plan.canCloseEditor(state)) { try ignore(plan.send({ type: "closeEditor" })); return true }
  return false
}

export const digests = together(reacting(Plan, { carry }), words, place, saving, sendingRunNow, clearReleased, digestClock)
