// spec/app/workflows/clock.md, "Story: Describe an alarm for Clock"; spec/app/workflows/clock.md, "Story: Review, then hand over to Clock"; spec/app/workflows/clock.md, "Story: Know what happened"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Clock from "../../gen/app__workflows__clock.effect.vibe"
import type { Effect as Out, Event, Handoff, Receipt } from "../../gen/app__workflows__clock.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { type ClockRequest, type ClockStatus, PhoneClock } from "../platform/clock.vibe"
import { Device } from "../platform/device.vibe"
import { type Job, answer, following, hearing, reacting, together } from "../runtime/reactor.vibe"

/** The label as the owner typed it: the spec counts its characters, this holds them until Clock is asked. */
export service Label {
  set(text: string): void!!
  get(): string!!
}

const label = Layer.sync(Label, () => {
  let typed = ""
  return {
    set: (text: string) => sync(() => { typed = text }),
    get: () => sync(() => typed),
  }
})

/** What Alpha remembers of the last handoff on this phone: its kind and what Clock answered, never more. */
schema Kept {
  readonly kind: "SetAlarm" | "ShowAlarms" | "Snooze" | "Dismiss"
  readonly receipt: "ClockOpened" | "ClockUnavailable" | "ClockDenied" | "ClockFailed" | "Unclear"
}

const keptKey = "alpha.clock.lastHandoff"
const decodeKept = Schema.decodeUnknownEffect(Schema.fromJsonString(Kept))

const receipts: Readonly<Record<ClockStatus, Receipt>> = {
  opened: "ClockOpened", unavailable: "ClockUnavailable", denied: "ClockDenied", failed: "ClockFailed", unknown: "Unclear",
}

effect function remember(kept: Kept): boolean!!KeyValueStore.KeyValueStore {
  return effect { try (try KeyValueStore.KeyValueStore).set(keptKey, JSON.stringify(kept)); return true } catch () => false
}

// spec/app/workflows/clock.md, "Only the newest read is taken: it shows the last handoff and what Clock answered, and once a phone is known to carry repeat days it stays known"
/** The last handoff kept on this phone, and whether Clock is handed repeat days: eliza's bridge carries them wherever it carries a Clock. */
effect function readHistory(ticket: number): Event!!(KeyValueStore.KeyValueStore | PhoneClock) {
  const repeats = (try PhoneClock).present
  return effect {
    const text = try (try KeyValueStore.KeyValueStore).get(keptKey)
    if (text === undefined) return { type: "historyRead", ticket, ok: true, repeats, lastKind: "SetAlarm", lastReceipt: "NoReceipt" }
    const kept = try decodeKept(text)
    return { type: "historyRead", ticket, ok: true, repeats, lastKind: kept.kind, lastReceipt: kept.receipt }
  } catch () => ({ type: "historyRead", ticket, ok: false, repeats, lastKind: "SetAlarm", lastReceipt: "NoReceipt" })
}

// spec/app/workflows/clock.md, "Confirm records one handoff of what was shown, before Clock is opened"
/** Keep the handoff before Clock is opened, as unknown until Clock answers: a restart then shows it unknown, never opened. */
effect function keep(id: number, kind: Handoff): Event!!KeyValueStore.KeyValueStore {
  return { type: "handoffKept", id, ok: try remember({ kind, receipt: "Unclear" }) }
}

/** What Clock is asked for `fx`, with the label as typed; none where the label held is not the one reviewed. */
function requestOf(fx: Extract<Out, { tag: "OpenClock" }>, typed: string): ClockRequest | undefined {
  return match (fx.kind) {
    when "SetAlarm": typed.length === fx.label || fx.label === 0
      ? { action: "set", hour: fx.hour, minute: fx.minute, label: fx.label === 0 ? "" : typed, ...(fx.days.length === 0 ? {} : { days: [...fx.days].sort((a, b) => a - b) }) }
      : undefined;
    when "ShowAlarms": { action: "show" };
    when "Snooze": { action: "snooze", minutes: fx.snooze };
    when "Dismiss": { action: "dismiss" };
  }
}

// spec/app/workflows/clock.md, "Clock is opened once the handoff is kept, with exactly what was reviewed, and a handoff that could not be kept is not sent"; spec/app/workflows/clock.md, "Clock's answer to the handoff still open ends it: opened, refused, or unknown"
/** Hand the reviewed request to Clock once, keep what Clock answered, and tell the page. */
effect function openClock(fx: Extract<Out, { tag: "OpenClock" }>): Event!!(KeyValueStore.KeyValueStore | PhoneClock | Label) {
  const request = requestOf(fx, try (try Label).get())
  const answered: Receipt = request === undefined ? "ClockFailed" : receipts[try (try PhoneClock).open(request)]
  try remember({ kind: fx.kind, receipt: answered === "ClockFailed" || answered === "ClockOpened" || answered === "ClockUnavailable" || answered === "ClockDenied" ? answered : "Unclear" })
  return { type: "clockAnswered", id: fx.id, answer: answered }
}

function carry(fx: Out): Job<Event, KeyValueStore.KeyValueStore | PhoneClock | Label, []> {
  return match (fx) {
    when { tag: "ReadHistory", let ticket }: answer("history", readHistory(ticket), { type: "historyRead", ticket, ok: false, repeats: false, lastKind: "SetAlarm", lastReceipt: "NoReceipt" });
    when { tag: "KeepHandoff", let id, let kind }: answer(`keep ${id}`, keep(id, kind), { type: "handoffKept", id, ok: false });
    when { tag: "OpenClock" }: answer(`open ${fx.id}`, openClock(fx), { type: "clockAnswered", id: fx.id, answer: "Unclear" });
  }
}

// spec/app/workflows/clock.md, "A restart forgets the page, withdraws a handoff not yet sent, and leaves one that was being opened unknown"
const kept = reacting(Clock, { keep: 1, open: [{ type: "restart" }], carry })

// spec/app/workflows/clock.md, "Leaving Workflows closes the page and forgets what was described"
const left = following(Shell, (shell) => showing(shell, "Workflows"), Clock.Machine, (shown): Event | undefined => (shown ? undefined : { type: "leave" }))

// spec/app/workflows/clock.md, "A review ends when Alpha is hidden or the page is closed, and a handoff not yet sent is withdrawn"
const hidden = hearing(Stream.unwrap(effect { return (try Device).visible }), Clock.Machine, (visible): Event | undefined => (visible ? undefined : { type: "suspend" }))

/** The Clock page of Workflows: kept across restarts, handed over through the phone's Clock, closed when Workflows is left or Alpha is hidden. */
export const clock = together(kept, left, hidden, label)

/** Whether this phone has a Clock to hand a request to, which opening the page is told. */
export effect function clockHere(): boolean!!PhoneClock {
  return (try PhoneClock).present
}

/** Back on the Clock page closes it, waiting for a handoff in flight; with the page closed, Back is not the page's. */
export const back = Clock.Machine.use((machine) =>
  Effect.flatMap(machine.get(), (state) =>
    state.open ? Effect.as(Effect.orElseSucceed(machine.send({ type: "closeClock" }), () => undefined), true) : Effect.succeed(false)))
