// spec/workflows/clockDraft.md, "Story: Set an alarm a workflow suggests, from Workflows"; spec/workflows/clockDraft.md, "The alarm the owner sets in the draft reaches Clock's review exactly: a real time, a short label and distinct days"
import { Machine, initial, machine, validAlarm } from "../../gen/workflows__clockDraft.effect.vibe"
import { Build } from "../platform/build.vibe"
import { type AlarmRequest, WorkflowClockPort } from "./ports.vibe"

/** The Clock draft Workflows opens over itself, handed to Clock once the owner approves it. */
export service WorkflowClockDraft {
  enter(): void!!
  leave(): void!!
  /** Remember that this visit opened the draft, so a retained draft may reopen. */
  remember(): void!!
  open(retained: boolean): boolean!!
  close(): void!!
  visibility(hidden: boolean): void!!
  /** Hand the alarm the owner set to Clock's draft and show Clock's review; false when it is not a valid alarm or Clock offers no review. */
  prepare(request: AlarmRequest): boolean!!
  /** Approve the reviewed draft and hand it to Clock once: "opened" or "unknown" after a handoff, "failed" when the save was retired. */
  approve(): "opened" | "unknown" | "failed" | "refused"!!
  /** What Clock answered a handoff made outside this service. */
  handedOver(opened: boolean): void!!
}

export const clockDraft = Layer.unwrap(effect {
  const build = try Build
  const start = { ...initial, browser: build.info.variant === "browser", mock: build.info.testMocks && build.info.variant === "browser" }
  return Layer.provideMerge(Layer.effect(WorkflowClockDraft, effect {
    const held = try Machine
    const clock = try WorkflowClockPort
    const sent = (event: Parameters<typeof held.send>[0]) => held.send(event) catch () => undefined
    return {
      enter: effect () => { try sent({ type: "enter" }) },
      effect leave() {
        try sent({ type: "leave" })
        try clock.retire()
      },
      remember: effect () => { try sent({ type: "remember" }) },
      effect open(retained: boolean) { return (try sent({ type: "openClock", retained })) !== undefined },
      effect close() {
        try sent({ type: "closeClock" })
        try clock.retire()
      },
      effect visibility(hidden: boolean) {
        try sent({ type: "visibility", hidden })
        if (hidden) try clock.retire()
      },
      effect prepare(request: AlarmRequest) {
        const label = request.label.trim()
        if (!validAlarm(request.hour, request.minute, label.length, [...request.days])) return false
        const exact: AlarmRequest = { hour: request.hour, minute: request.minute, label, days: [...request.days].sort((a, b) => a - b) }
        if (!(try held.get()).shown || !(try clock.prepare(exact))) return false
        return (try sent({ type: "prepare" })) !== undefined
      },
      effect approve() {
        const approved = try sent({ type: "approve" })
        if (approved === undefined || (try held.get()).phase !== "DraftSaving") return "refused"
        try sent({ type: "savedDraft" })
        if ((try held.get()).phase !== "DraftDispatching") return "failed"
        const opened = try clock.confirm()
        try sent({ type: "finishHandoff", opened })
        return opened ? "opened" : "unknown"
      },
      effect handedOver(opened: boolean) { try sent({ type: "finishHandoff", opened }) },
    }
  }), machine(start))
})
