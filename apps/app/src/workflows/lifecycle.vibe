// spec/app/workflows/index.md, "Story: Open a workflow"; spec/app/workflows/index.md, "Story: Change a workflow"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { type RemoteWorkflow, WorkflowActivationRejected, WorkflowHttpError, WorkflowLifecycleRejected, WorkflowMetadataRejected, WorkflowPauseRejected, WorkflowResponseInvalid } from "@elizaos/plugin-workflow-client"
import * as Automations from "../../gen/app__workflows__automations.effect.vibe"
import * as Listing from "../../gen/app__workflows__list.effect.vibe"
import * as Model from "../../gen/app__workflows.effect.vibe"
import type { Change, Effect as Out, Event } from "../../gen/app__workflows.effect.vibe"
import { canFile } from "../../gen/app__workflows__request.effect.vibe"
import { Agent } from "../platform/agent.vibe"
import { ownerAt } from "../platform/owner.vibe"
import { ask } from "../platform/remote.vibe"
import { type Job, answer, applying, following, reacting, together } from "../runtime/reactor.vibe"
import { createShelf } from "../runtime/shelf.vibe"
import { PromptSchema, WorkflowsApi } from "./api.vibe"
import { type WorkflowRow, Rows, refresh } from "./list.vibe"

interface Definition {
  readonly row: number
  readonly version: number
  readonly workflow: RemoteWorkflow
}

export interface DefinitionSnapshot {
  readonly seen?: Definition
  readonly edit?: { readonly row: number; readonly name: string }
  readonly toggling: ReadonlySet<number>
}

const emptyDefinition: DefinitionSnapshot = { toggling: new Set() }

export service DefinitionWords {
  read(row: number): (Definition | undefined)!!
  store(row: number, workflow: RemoteWorkflow): number!!
  rename(row: number, name: string): void!!
  name(row: number): string!!
  setToggling(row: number, active: boolean): void!!
  snapshot(this: void): DefinitionSnapshot
  subscribe(this: void, listener: () => void): () => void
}

const words = Layer.sync(DefinitionWords, () => {
  const shelf = createShelf<DefinitionSnapshot>(emptyDefinition)
  return {
    read: (row: number) => sync(() => {
      const seen = shelf.get().seen
      return seen?.row === row ? seen : undefined
    }),
    store: (row: number, workflow: RemoteWorkflow) => sync(() => {
      const current = shelf.get()
      const seen = current.seen
      const version = seen?.row !== row ? 1 : seen.workflow.versionId === workflow.versionId ? seen.version : seen.version + 1
      shelf.set({ ...current, seen: { row, workflow, version } })
      return version
    }),
    rename: (row: number, name: string) => sync(() => {
      shelf.update((current) => ({ ...current, edit: { row, name } }))
    }),
    name: (row: number) => sync(() => {
      const edit = shelf.get().edit
      return edit?.row === row ? edit.name : ""
    }),
    setToggling: (row: number, active: boolean) => sync(() => {
      shelf.update((current) => {
        const next = new Set(current.toggling)
        if (active) next.add(row)
        else next.delete(row)
        return { ...current, toggling: next }
      })
    }),
    snapshot: shelf.snapshot,
    subscribe: shelf.subscribe,
  }
})

function scheduled(workflow: RemoteWorkflow): boolean {
  const spec = workflow.phoneSpec
  if (workflow.hostedDigest === true) return true
  if (typeof spec !== "object" || spec === null || !("trigger" in spec)) return false
  const trigger = spec.trigger
  return typeof trigger === "object" && trigger !== null && "kind" in trigger && trigger.kind === "time"
}

type Needs = Agent | WorkflowsApi | Rows | Model.Machine | DefinitionWords | Listing.Machine | KeyValueStore.KeyValueStore

const selectedRow = (place: Listing.Place): number => place.tag === "ListingDetail" ? place.row : 0

effect function read(ticket: number, owner: number): Event!!Needs {
  const machine = try Model.Machine
  const list = try Listing.Machine
  const state = try machine.get()
  const failed: Event = { type: "workflowRead", ticket, ok: false, version: Math.max(1, state.version), name: 1, active: false, removed: false, scheduled: false }
  const rows = try Rows
  const target = state.target
  const selected = try rows.row(owner, target)
  const scope = ownerAt() catch () => ""
  if (state.owner !== owner || selected?.kind !== "Routine" || !(try rows.sameOwner(scope, owner))) return failed
  const { workflow } = try WorkflowsApi
  const result = (workflow.detail(selected.id) catch () => undefined)
  const reaffirmed = ownerAt() catch () => ""
  const live = try machine.get()
  if (result === undefined || scope !== reaffirmed || live.target !== target || live.owner !== owner
    || !Model.canWorkflowRead(live, ticket, Math.max(1, live.version), 1) || selectedRow((try list.get()).place) !== target) return failed
  const version = try (try DefinitionWords).store(target, result)
  const name = Math.max(1, Math.min(Model.maxName, result.name.length))
  return { type: "workflowRead", ticket, ok: true, version, name, active: result.active, removed: result.removed, scheduled: scheduled(result) }
}

const HeldChange = Schema.fromJsonString(Schema.Struct({
  id: Schema.Int, mutation: Schema.String, workflowId: Schema.NonEmptyString,
  version: Schema.NonEmptyString, change: Schema.Literals(["TurnOn", "TurnOff", "Rename", "Remove", "Restore"]),
}))

const changeKey = (owner: string, id: string) => `alpha/workflows/change/${encodeURIComponent(owner)}/${encodeURIComponent(id)}`
const TriggerToggleReply = Schema.Struct({ trigger: PromptSchema })

const declined = (failure: unknown) =>
  failure instanceof WorkflowActivationRejected || failure instanceof WorkflowPauseRejected || failure instanceof WorkflowLifecycleRejected
  || failure instanceof WorkflowMetadataRejected || (failure instanceof WorkflowHttpError && [400, 401, 403, 404, 409, 422].includes(failure.status))

effect function loadLifecycleDeps() {
  const machine = try Model.Machine
  const definition = try DefinitionWords
  const rows = try Rows
  const store = try KeyValueStore.KeyValueStore
  const { workflow } = try WorkflowsApi
  const state = try machine.get()
  const scope = ownerAt() catch () => ""
  return { machine, definition, rows, store, workflow, state, scope }
}

effect function changed(id: number, change: Change, version: number, name: number): Event!!Needs {
  const { definition, rows, store, workflow, state, scope } = try loadLifecycleDeps()
  const exact = try definition.read(state.target)
  if (exact?.version !== version || !(try rows.sameOwner(scope, state.owner))) return { type: "changeAnswered", id, applied: false }
  const current = exact.workflow
  const key = changeKey(scope, current.id)
  const rawPrevious = (store.get(key) catch () => "unreachable")
  const previous = rawPrevious === undefined || rawPrevious === "unreachable"
    ? undefined : (Schema.decodeUnknownEffect(HeldChange)(rawPrevious) catch () => undefined)
  if (state.change.again) {
    if (previous === undefined || previous.id !== id || previous.workflowId !== current.id || previous.version !== current.versionId || previous.change !== change) {
      return { type: "changeUnanswered" }
    }
  } else if (rawPrevious !== undefined) {
    return { type: "changeUnanswered" }
  }
  const persist = effect (mutation: string) => {
    store.set(key, JSON.stringify({ id, mutation, workflowId: current.id, version: current.versionId, change }))
      catch effect () => { throw new WorkflowResponseInvalid({ message: "Could not retain the change" }) }
  }
  let dispatched = state.change.again
  const outcome = effect {
    if (change === "TurnOn" || change === "TurnOff") {
      if (!state.change.again) try persist("")
      dispatched = true
      if (change === "TurnOn") try workflow.activate(current.id, current.versionId)
      else try workflow.pause(current.id, current.versionId)
      try ignore(store.remove(key))
    } else {
      const keep = effect (mutation: string) => {
        try persist(mutation)
        dispatched = true
      }
      if (change === "Rename") {
        const text = try definition.name(state.target)
        if (text.length !== name) return "refused"
        try workflow.changeMetadata(current.id, current.versionId, text, current.description, keep)
      } else {
        try workflow.lifecycle(current.id, current.versionId, change === "Remove" ? "remove" : "restore", keep)
      }
      try ignore(store.remove(key))
    }
    return "applied"
  } catch (failure) => !dispatched || declined(failure) ? "refused" : "unknown"
  if ((ownerAt() catch () => "") !== scope || outcome === "unknown") return { type: "changeUnanswered" }
  if (outcome === "refused") try ignore(store.remove(key))
  try refresh()
  return { type: "changeAnswered", id, applied: outcome === "applied" }
}

effect function checked(ticket: number, id: number): Event!!Needs {
  const { machine, definition, rows, store, workflow, state, scope } = try loadLifecycleDeps()
  const failed: Event = { type: "changeChecked", ticket, ok: false, found: false, version: Math.max(1, state.version) }
  const exact = try definition.read(state.target)
  if (exact === undefined || !(try rows.sameOwner(scope, state.owner))) return failed
  const key = changeKey(scope, exact.workflow.id)
  const raw = (store.get(key) catch () => undefined)
  const kept = raw === undefined ? undefined : (Schema.decodeUnknownEffect(HeldChange)(raw) catch () => undefined)
  if (kept === undefined || kept.id !== id || kept.workflowId !== exact.workflow.id) return failed
  const answer = effect {
    if (kept.change === "TurnOn" || kept.change === "TurnOff") {
      const current = try workflow.detail(kept.workflowId)
      const found = kept.change === "TurnOn" ? current.active && !current.removed : !current.active
      return { found, current }
    }
    if (kept.mutation === "") return undefined
    const expected = kept.change === "Rename" ? try workflow.reconcileMetadata(kept.workflowId, kept.version, kept.mutation)
      : try workflow.reconcileLifecycle(kept.workflowId, kept.version, kept.mutation, kept.change === "Remove" ? "remove" : "restore")
    const current = try workflow.detail(kept.workflowId)
    return { found: expected !== null, current }
  } catch () => undefined
  const confirmed = ownerAt() catch () => ""
  const live = try machine.get()
  if (answer === undefined || scope !== confirmed || live.owner !== state.owner || live.target !== state.target
    || !Model.canChangeChecked(live, ticket, Math.max(1, live.version))) return failed
  const version = try definition.store(state.target, answer.current)
  if (answer.found || version !== live.named) try ignore(store.remove(key))
  if (answer.found) try refresh()
  return { type: "changeChecked", ticket, ok: true, found: answer.found, version }
}

function carry(fx: Out): Job<Event, Needs, []> {
  return match (fx) {
    when { tag: "ReadWorkflow", let ticket, let owner }: answer("workflow detail", read(ticket, owner),
      { type: "workflowRead", ticket, ok: false, version: 1, name: 1, active: false, removed: false, scheduled: false });
    when { tag: "AskAgent", let id, let change, let version, let name }: answer("workflow change", changed(id, change, version, name),
      { type: "changeUnanswered" });
    when { tag: "ReadRecord", let ticket, let id }: answer("workflow change receipt", checked(ticket, id),
      { type: "changeChecked", ticket, ok: false, found: false, version: 1 });
  }
}

const focus = applying(
  Listing.Machine,
  (state) => ({ owner: state.owner, row: selectedRow(state.place) }),
  effect ({ owner, row }: { owner: number; row: number }) => {
    const machine = try Model.Machine
    const rows = try Rows
    const held = try machine.get()
    if (held.owner !== owner) try ignore(machine.send({ type: "ownerChanged", owner }))
    const selected = try rows.row(owner, row)
    if (selected?.kind !== "Routine") {
      try ignore(machine.send({ type: "closeWorkflow" }))
      return
    }
    if (row !== held.target) try ignore(machine.send({ type: "selectWorkflow", row }))
    if ((try machine.get()).target === row) try ignore(machine.send({ type: "readWorkflow" }))
  },
)

const sending = following(Model.Machine, Model.canSendChange, Model.Machine, (ready): Event | undefined => (ready ? { type: "sendChange" } : undefined))

export effect function reviewName(row: number, proposed: string, unfinished: boolean, interrupted: boolean): void!!(Model.Machine | DefinitionWords) {
  const machine = try Model.Machine
  const state = try machine.get()
  const name = proposed.trim()
  if (state.target !== row || state.review.showing || name === "" || name.length > Model.maxName) return
  try (try DefinitionWords).rename(row, name)
  if (name.length !== state.renaming) try ignore(machine.send({ type: "editName", chars: name.length }))
  try ignore(machine.send({ type: "reviewChange", wanted: "Rename", unfinished, interrupted }))
}

const clearOnRelease = applying(
  Model.Machine,
  (state) => ({ owner: state.owner, target: state.target, settled: canFile(state.change) }),
  effect ({ owner, target, settled }: { owner: number; target: number; settled: boolean }) => {
    if (!settled || target <= 0 || owner <= 0) return
    const exact = try (try DefinitionWords).read(target)
    const scope = ownerAt() catch () => ""
    if (exact === undefined || !(try (try Rows).sameOwner(scope, owner))) return
    try ignore((try KeyValueStore.KeyValueStore).remove(changeKey(scope, exact.workflow.id)))
  },
)

/** Toggle a Routine or Prompt directly from the list row switch, opening detail only when a scheduled workflow requires review before turning on. */
export effect function toggleListRow(owner: number, row: WorkflowRow): void!!(Needs | Automations.Machine) {
  if (row.removed || (row.kind !== "Routine" && row.kind !== "Prompt")) return
  const listing = try Listing.Machine
  const listState = try listing.get()
  if (listState.owner !== owner || listState.list.status !== "Loaded" || listState.place.tag !== "ListingRows") return
  const rows = try Rows
  const scope = ownerAt() catch () => ""
  if (!(try rows.sameOwner(scope, owner))) return
  if (row.kind === "Routine" && !row.on && scheduled(row.record)) {
    const open: Listing.Event = { type: "openRow", row: row.number }
    if (Listing.canOpenRow(listState, row.number)) try ignore(listing.send(open))
    return
  }
  const definition = try DefinitionWords
  if (definition.snapshot().toggling.has(row.number)) return
  if (row.kind === "Routine") {
    const lifecycleState = try (try Model.Machine).get()
    if (!canFile(lifecycleState.change)) return
  } else {
    const autoState = try (try Automations.Machine).get()
    if (!canFile(autoState.change)) return
  }
  try definition.setToggling(row.number, true)
  try Effect.ensuring(effect {
    if (row.kind === "Routine") {
      const { workflow } = try WorkflowsApi
      const store = try KeyValueStore.KeyValueStore
      const key = changeKey(scope, row.id)
      const change: Change = row.on ? "TurnOff" : "TurnOn"
      if ((store.get(key) catch () => "unreachable") !== undefined) return
      const stored = effect {
        try store.set(key, JSON.stringify({ id: 0, mutation: "", workflowId: row.id, version: row.record.versionId, change }))
        return true
      } catch () => false
      if (!stored) return
      const applied = effect {
        if (row.on) try workflow.pause(row.id, row.record.versionId)
        else try workflow.activate(row.id, row.record.versionId)
        return true
      } catch () => false
      if (applied || (ownerAt() catch () => "") === scope) try ignore(store.remove(key))
    } else {
      const path = `/api/triggers/${encodeURIComponent(row.id)}`
      const req = HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.put(path), { enabled: !row.on, expectedRevision: row.record.revision })
      try ignore(ask(Agent, req, TriggerToggleReply))
    }
    if ((ownerAt() catch () => "") === scope) try refresh()
  }, definition.setToggling(row.number, false))
}

export effect function backLifecycle(): boolean!!Model.Machine {
  const machine = try Model.Machine
  if (!Model.canCancelReview(try machine.get())) return false
  try ignore(machine.send({ type: "cancelReview" }))
  return true
}

export const lifecycle = together(reacting(Model, { carry }), words, focus, sending, clearOnRelease)
