// spec/app/digests/index.md, "Home shows the newest kept result of the owner that ran, finished or failed, through a restart; a result that did not run never replaces it, and a page of another owner never reaches it"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { type DigestResult, type HostedDigestProtocol, digestInbox, latestRetainedBrief } from "@elizaos/plugin-workflow-client"
import { Machine as Shell } from "../../gen/app__shell.effect.vibe"
import { Machine as WorkflowList } from "../../gen/app__workflows__list.effect.vibe"
import { fromAreas, type ToldBrief } from "../home/cards.vibe"
import { Agent } from "../platform/agent.vibe"
import { Device } from "../platform/device.vibe"
import { enableNativeDigestNotices, nativeDigestChanges, nativeDigestsAvailable, type NativeDigestSnapshot, readNativeDigests, syncNativeDigests, writeNativeDigestPreference } from "../platform/hosted-digests.vibe"
import { type ResidentOwner, launchOwnerAt, residentOwnerKey, sameResidentOwner } from "../platform/owner.vibe"
import { started, together } from "../runtime/reactor.vibe"
import { Rows } from "./list.vibe"

/** Old agent-only keys carry no verified owner. Leave their results and consent sealed. */
export function digestScope(owner: ResidentOwner): string {
  return `alpha/workflows/digests-v2/${encodeURIComponent(residentOwnerKey(owner))}`
}

interface DigestRead {
  readonly rows: readonly DigestResult[] | undefined
  readonly current: boolean
}

/** Workflows and Home share one selected inbox. The registered Android host is its own writer. */
export service DigestHistory {
  readonly changes: Stream.Stream<void>
  readonly native: boolean
  read(owner: ResidentOwner): (readonly DigestResult[] | undefined)!!
  sync(owner: ResidentOwner, protocol: HostedDigestProtocol): DigestRead!!
  nativeSnapshot(owner: ResidentOwner): (NativeDigestSnapshot | undefined)!!
  nativeBackground(owner: ResidentOwner, enabled: boolean, lease: string): boolean!!
  nativeEnableNotifications(owner: ResidentOwner, lease: string): boolean!!
}

const history = Layer.effect(DigestHistory, effect {
  const changed = try PubSub.sliding<void>(1)
  const round = (try Semaphore.make(1)).withPermits(1)
  const store = try KeyValueStore.KeyValueStore
  const agent = try Agent
  const deviceInbox = nativeDigestsAvailable()
  const invalidated = sync(() => { PubSub.publishUnsafe(changed, undefined) })
  if (deviceInbox) try fork.scoped Stream.runForEach(nativeDigestChanges(), () => invalidated)

  const inboxFor = (owner: ResidentOwner) => Effect.provideService(digestInbox(digestScope(owner)), KeyValueStore.KeyValueStore, store)
  const nativeEpoch = effect (owner: ResidentOwner): (number | undefined)!! => {
    const current = Effect.provideService(launchOwnerAt(), Agent, agent) catch () => undefined
    if (!sameResidentOwner(owner, current)) return undefined
    const status = agent.life.status() catch () => undefined
    return status?.available && status.state === "running" ? status.epoch : undefined
  }
  const snapshot = effect (owner: ResidentOwner): (NativeDigestSnapshot | undefined)!! => {
    if (!deviceInbox) return undefined
    const epoch = try nativeEpoch(owner)
    if (epoch === undefined) return undefined
    const saved = try readNativeDigests()
    return (try nativeEpoch(owner)) === epoch ? saved : undefined
  }

  let generation = 0
  return {
    changes: Stream.fromPubSub(changed),
    native: deviceInbox,
    read: (owner: ResidentOwner) => round(effect {
      if (deviceInbox) return (try snapshot(owner))?.rows
      const inbox = try inboxFor(owner)
      return inbox.history() catch () => undefined
    }),
    sync: (owner: ResidentOwner, protocol: HostedDigestProtocol) => round(effect {
      if (deviceInbox) {
        const before = try snapshot(owner)
        if (before === undefined) return { rows: undefined, current: false }
        const synced = try syncNativeDigests(before.lease)
        const saved = try snapshot(owner)
        try invalidated
        return saved?.lease === before.lease ? { rows: saved.rows, current: synced } : { rows: undefined, current: false }
      }
      const inbox = try inboxFor(owner)
      const fresh = inbox.sync(protocol, ++generation) catch () => undefined
      const rows = fresh ?? (inbox.history() catch () => undefined)
      try invalidated
      return { rows, current: fresh !== undefined }
    }),
    nativeSnapshot: (owner: ResidentOwner) => round(snapshot(owner)),
    nativeBackground: (owner: ResidentOwner, enabled: boolean, lease: string) => round(effect {
      const before = try snapshot(owner)
      if (before?.support !== "nativeScheduled" || before.lease !== lease) return false
      const saved = try writeNativeDigestPreference(enabled, lease)
      const after = try snapshot(owner)
      try invalidated
      return saved && after?.support === "nativeScheduled" && after.lease === lease && after.backgroundEnabled === enabled
    }),
    nativeEnableNotifications: (owner: ResidentOwner, lease: string) => effect {
      const before = try round(snapshot(owner))
      if (before?.lease !== lease || before.noticesAllowed) return false
      const requested = try enableNativeDigestNotices(lease)
      try invalidated
      return requested
    },
  }
})

/** Project the current owner's saved digest onto Home. This observer only reads the inbox history. */
const brief = started(effect {
  const list = try WorkflowList
  const shell = try Shell
  const rows = try Rows
  const device = try Device
  const { life } = try Agent
  const history = try DigestHistory
  const accounts = Stream.as(Stream.changes(Stream.map(list.changes, (state) => state.owner)), undefined)
  const home = Stream.filter(Stream.changes(Stream.map(shell.changes, (state) => state.trail.length === 0)), (shown) => shown)
  const foreground = Stream.filter(device.visible, (shown) => shown)
  const agent = Stream.catch(Stream.changes(Stream.map(life.changes, (state) => state.available && state.state === "running")), () => Stream.empty)
  const refresh = Stream.merge(Stream.as(Stream.merge(home, foreground), undefined), Stream.merge(accounts, history.changes))
  const signals = Stream.merge(refresh, agent)
  let bound: string | undefined

  const read = effect (available: boolean | void) => {
    const owner = (try list.get()).owner
    const identity = available !== false && owner > 0 ? (launchOwnerAt() catch () => undefined) : undefined
    const scope = identity !== undefined && (try rows.sameDigestOwner(identity, owner)) ? digestScope(identity) : undefined
    if (scope !== bound) {
      bound = scope
      fromAreas.brief(undefined)
    }
    if (identity === undefined || scope === undefined) return
    const saved = try history.read(identity)
    const confirmed = launchOwnerAt() catch () => undefined
    if (!sameResidentOwner(identity, confirmed) || (try list.get()).owner !== owner || !(try rows.sameDigestOwner(identity, owner))) {
      bound = undefined
      fromAreas.brief(undefined)
      return
    }
    if (saved === undefined && !history.native) return
    const latest = latestRetainedBrief(saved)
    const current: ToldBrief | undefined = latest === undefined ? undefined
      : latest.status === "failed" || latest.status === "cancelled"
        ? { outcome: "RunFailed", at: Date.parse(latest.ranAt) }
        : { outcome: "Finished", at: Date.parse(latest.ranAt), summary: latest.summary }
    const previous = fromAreas.snapshot().brief
    if (current?.outcome !== previous?.outcome || current?.at !== previous?.at ||
      (current?.outcome === "Finished" && previous?.outcome === "Finished" && current.summary !== previous.summary)) {
      fromAreas.brief(current)
    }
  }

  fromAreas.brief(undefined)
  try Effect.ensuring(Stream.runDrain(Stream.switchMap(signals, (available) => Stream.fromEffectDrain(read(available)))),
    sync(() => fromAreas.brief(undefined)))
}, "showing the owner's retained digest on Home")

export const digestBrief = together(history, brief)
