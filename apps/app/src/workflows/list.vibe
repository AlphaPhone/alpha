// spec/app/workflows/list.md, "Story: Find a workflow"; spec/app/workflows/list.md, "Story: Keep the list to its owner"
import type { RemoteWorkflow } from "@elizaos/plugin-workflow-client"
import type { Freshness } from "../../gen/app__home__cards.effect.vibe"
import * as List from "../../gen/app__workflows__list.effect.vibe"
import type { Effect as Out, Event, StatusFilter } from "../../gen/app__workflows__list.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { fromAreas } from "../home/cards.vibe"
import type { Shell as ShellState } from "../../gen/app__shell.effect.vibe"
import type { Agent } from "../platform/agent.vibe"
import { Device } from "../platform/device.vibe"
import { type ResidentOwner, launchOwnerOf, ownerAt, residentOwnerKey } from "../platform/owner.vibe"
import { type Job, answer, applying, reacting, started, together } from "../runtime/reactor.vibe"
import { WorkflowsApi, type Prompt, type ScheduledTask, readPrompts, readSchedules, workflowsApi } from "./api.vibe"
import { cronWords, onceWords } from "./when.ts"

type Routine = { readonly kind: "Routine"; readonly record: RemoteWorkflow }
type PromptRow = { readonly kind: "Prompt"; readonly record: Prompt }
type TaskRow = { readonly kind: "Reminder" | "Schedule"; readonly record: ScheduledTask }
type RowContent = Routine | PromptRow | TaskRow

/** `line` is the row's line under its title: when it runs, or where it comes from. */
type UnnumberedRow = RowContent & { readonly id: string; readonly title: string; readonly summary: string; readonly line: string; readonly on: boolean; readonly removed: boolean }
export type WorkflowRow = UnnumberedRow & { readonly number: number }

type Source = "Workflows" | "Removed workflows" | "Prompts" | "Scheduled tasks"

export interface Snapshot {
  readonly owner: number
  readonly rows: ReadonlyArray<WorkflowRow>
  readonly problems: ReadonlyArray<Source>
}

const blank: Snapshot = { owner: 0, rows: [], problems: [] }

export service Rows {
  /** The last payload the list machine read for this owner. */
  view(owner: number): Snapshot!!
  /** The next number for this signed-in owner, or the number already assigned to it. */
  owner(id: string, proof: ResidentOwner | undefined): number!!
  /** Whether `id` names the same resident agent as the request. */
  sameOwner(id: string, number: number): boolean!!
  /** Whether this request still belongs to the verified launch owner. */
  sameDigestOwner(proof: ResidentOwner, number: number): boolean!!
  /** The last payload's visible record, as the row's already assigned number names it. */
  row(owner: number, number: number): (WorkflowRow | undefined)!!
  /** Keep the words read under this ticket; row numbers are stable for a refresh by the same owner. */
  store(owner: number, rows: readonly UnnumberedRow[], problems: readonly Source[]): void!!
  clear(): void!!
}

const rows = Layer.sync(Rows, () => {
  let shown = blank
  let currentOwner = ""
  let currentDigestOwner = ""
  let owner = 0
  let nextRow = 0
  const numbers = new Map<string, number>()
  return {
    view: (wanted: number) => succeed(shown.owner === wanted ? shown : blank),
    owner: (id: string, proof: ResidentOwner | undefined) => sync(() => {
      const verified = proof === undefined ? "" : residentOwnerKey(proof)
      if (currentOwner !== id || currentDigestOwner !== verified) {
        currentOwner = id
        currentDigestOwner = verified
        shown = blank
        numbers.clear()
        owner += 1
      }
      return owner
    }),
    sameOwner: (id: string, number: number) => succeed(id === currentOwner && number === owner),
    sameDigestOwner: (proof: ResidentOwner, number: number) => succeed(residentOwnerKey(proof) === currentDigestOwner && number === owner),
    row: (wanted: number, number: number) => succeed(shown.owner === wanted ? shown.rows.find((row) => row.number === number) : undefined),
    store: (wanted: number, received: readonly UnnumberedRow[], problems: readonly Source[]) => sync(() => {
      if (wanted !== owner) return
      const numbered = received.map((row) => {
        const key = `${row.kind}:${row.id}`
        const number = numbers.get(key) ?? ++nextRow
        numbers.set(key, number)
        return { ...row, number }
      })
      shown = { owner, rows: numbered, problems }
    }),
    clear: () => sync(() => { currentOwner = ""; currentDigestOwner = ""; shown = blank; numbers.clear() }),
  }
})

function routineRow(record: RemoteWorkflow): UnnumberedRow {
  return { kind: "Routine", record, id: record.id, title: record.name, summary: record.description, line: record.removed ? "Workflow" : "automation", on: record.active, removed: record.removed }
}

function promptWhen(record: Prompt, now: number): string {
  switch (record.triggerType) {
    case "cron": return cronWords(record.cronExpression, record.timezone, now)
    case "once": return onceWords(record.scheduledAtIso)
    case "event": return `On ${record.eventKind}`
  }
}

function promptRow(record: Prompt, now: number): UnnumberedRow {
  return { kind: "Prompt", record, id: record.id, title: record.displayName, summary: record.instructions, line: promptWhen(record, now), on: record.enabled, removed: false }
}

function taskWhen(record: ScheduledTask, now: number): string {
  const { trigger } = record
  if (trigger.kind === "once") return onceWords(trigger.atIso)
  if (trigger.kind === "cron") return cronWords(trigger.expression ?? "", trigger.tz === undefined || trigger.tz === "owner_local" ? "" : trigger.tz, now)
  return "Manual"
}

/** A scheduled task's row, named as the agent named it ("Morning check-in", a routine's or reminder's title), never by its kind's identifier. */
function taskRow(record: ScheduledTask, now: number): UnnumberedRow {
  const kind = record.kind === "personal-assistant.reminder" ? "Reminder" : "Schedule"
  const on = record.trigger.kind !== "manual" && ["scheduled", "fired", "acknowledged"].includes(record.state.status)
  return { kind, record, id: record.taskId, title: record.promptInstructions.trim() || "Scheduled task", summary: "", line: taskWhen(record, now), on, removed: false }
}

/** What the list says could not be read: removed workflows only under Removed, the one standing whose rows they would be. */
export function shownUnder(snapshot: Snapshot, standing: StatusFilter): Snapshot {
  return standing === "Removed" ? snapshot : { ...snapshot, problems: snapshot.problems.filter((source) => source !== "Removed workflows") }
}

effect function read(ticket: number, owner: number): Event!!(WorkflowsApi | Agent | Rows | List.Machine) {
  const failed: Event = { type: "listRead", ticket, ok: false, count: 0, complete: false }
  const { workflow } = try WorkflowsApi
  const kept = try Rows
  const expected = try List.Machine
  const before = ownerAt() catch () => ""
  if (!(try kept.sameOwner(before, owner))) return failed
  const received = try all({
    workflows: Effect.orElseSucceed(workflow.list(), () => undefined),
    removed: Effect.orElseSucceed(workflow.removedWorkflows(), () => undefined),
    prompts: Effect.orElseSucceed(readPrompts(), () => undefined),
    schedules: Effect.orElseSucceed(readSchedules(), () => undefined),
  }, { concurrency: "unbounded" })
  const after = ownerAt() catch () => ""
  if (after !== before) {
    const current = try expected.get()
    if (current.owner !== owner || !List.canListRead(current, ticket, 0)) return failed
    try kept.clear()
    return { type: "ownerChanged", owner: 0 }
  }
  const state = try expected.get()
  if (state.owner !== owner || !List.canListRead(state, ticket, 0)) return failed
  const problems: Source[] = []
  if (received.workflows === undefined) problems.push("Workflows")
  if (received.removed === undefined) problems.push("Removed workflows")
  if (received.prompts === undefined) problems.push("Prompts")
  if (received.schedules === undefined) problems.push("Scheduled tasks")
  if (problems.length === 4) return failed
  const now = try Clock.currentTimeMillis
  const found = [
    ...(received.workflows ?? []).filter((record) => !record.removed).map(routineRow),
    ...(received.removed ?? []).map(routineRow),
    ...(received.prompts ?? []).map((record) => promptRow(record, now)),
    ...(received.schedules ?? []).map((record) => taskRow(record, now)),
  ]
  try kept.store(owner, found, problems)
  return { type: "listRead", ticket, ok: true, count: found.length, complete: problems.length === 0 }
}

function carry(fx: Out): Job<Event, Agent | WorkflowsApi | Rows | List.Machine, []> {
  return match (fx) {
    when { tag: "ReadList", let ticket, let owner }: answer("workflows list", read(ticket, owner), { type: "listRead", ticket, ok: false, count: 0, complete: false });
  }
}

export effect function refresh(): void!!(Agent | Rows | List.Machine) {
  const key = ownerAt() catch () => ""
  const store = try Rows
  const list = try List.Machine
  const current = try list.get()
  const proof = key === "" ? undefined : (launchOwnerOf(key) catch () => undefined)
  const owner = key === "" ? 0 : try store.owner(key, proof)
  if (key === "") try store.clear()
  if (owner !== current.owner) try ignore(list.send({ type: "ownerChanged", owner }))
  try ignore(list.send({ type: "readList" }))
}

export effect function backList(): boolean!!List.Machine {
  const machine = try List.Machine
  const current = try machine.get()
  if (List.canDismissFilters(current)) {
    try ignore(machine.send({ type: "dismissFilters" }))
    return true
  }
  if (!List.canClosePlace(current)) return false
  try ignore(machine.send({ type: "closePlace" }))
  return true
}

// spec/app/home/cards.md, "The Workflows card shows the first two enabled rows and how many more, marked when they are not current, stale or partly unavailable, and is not drawn without a row"
const place = (current: ShellState) => showing(current, "Workflows") ? "Workflows" : current.trail.length === 0 ? "Home" : "Away"

const followPage = applying(Shell, (current) => {
  const at = place(current)
  return { at, assistant: at === "Workflows" && current.assistant !== "Bar" }
}, effect ({ at, assistant }) => {
  if (at !== "Workflows") {
    const list = try List.Machine
    try ignore(list.send({ type: "dismissFilters" }))
    while (List.canClosePlace(try list.get())) {
      const closed = (map(list.send({ type: "closePlace" }), () => true) catch () => false)
      if (!closed) break
    }
  }
  if (at === "Home" || (at === "Workflows" && !assistant)) try refresh()
})

const followForeground = started(effect {
  const device = try Device
  const shell = try Shell
  try Stream.runForEach(device.visible, effect (visible) => {
    if (visible && place(try shell.get()) !== "Away") try refresh()
  })
}, "refreshing Workflows on foreground")

const home = applying(List.Machine, (state) => ({ owner: state.owner, read: state.list }), effect ({ owner, read }) => {
  const source = try (try Rows).view(owner)
  const displayed = source.rows.filter((row) => (row.kind === "Routine" || row.kind === "Prompt") && row.on && !row.removed)
    .map((row) => ({ title: row.title, detail: "Enabled" }))
  const freshness: Freshness = read.status === "Failed" ? "Stale"
    : source.problems.some((problem) => problem === "Workflows" || problem === "Prompts") ? "SomeUnavailable"
      : read.status === "Loaded" ? "UpToDate" : "NotCurrent"
  fromAreas.flows({ rows: displayed, freshness })
})

export const listing = together(reacting(List, { carry }), workflowsApi, rows, followPage, followForeground, home)
