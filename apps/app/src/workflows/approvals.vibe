// spec/app/workflows/approvals.md, "Story: Answer a run's approval on the phone"; spec/app/workflows/approvals.md, "A decision whose answer was lost is settled by reading the approval again"
import { type WorkflowApproval, type WorkflowRun, WorkflowHttpError } from "@elizaos/plugin-workflow-client"
import * as Model from "../../gen/app__workflows__approvals.effect.vibe"
import type { Answer, Effect as Out, Event } from "../../gen/app__workflows__approvals.effect.vibe"
import * as Listing from "../../gen/app__workflows__list.effect.vibe"
import * as Sheet from "../../gen/app__workflows__sheet.effect.vibe"
import type { Agent } from "../platform/agent.vibe"
import { ownerAt } from "../platform/owner.vibe"
import { type Job, answer, applying, due, reacting, run, together, untimed } from "../runtime/reactor.vibe"
import { Time } from "../runtime/time.vibe"
import { WorkflowsApi } from "./api.vibe"
import { HistoryWordsPort, type RunVisibility, workflowsVisible } from "./history.vibe"
import { Rows } from "./list.vibe"

interface Pending {
  readonly number: number
  readonly owner: number
  readonly runId: number
  readonly run: WorkflowRun
  readonly approval: WorkflowApproval
}

export function sameAsking(approval: WorkflowApproval, other: WorkflowApproval): boolean {
  return approval.runId === other.runId && approval.workflowId === other.workflowId &&
    approval.workflowVersionId === other.workflowVersionId && approval.nodeId === other.nodeId &&
    approval.iteration === other.iteration && approval.requestDigest === other.requestDigest &&
    approval.expiresAt === other.expiresAt && approval.supported === other.supported &&
    approval.title === other.title && approval.summary === other.summary && approval.operation === other.operation &&
    approval.target === other.target && approval.account === other.account
}

export service ApprovalWords {
  get(): (Pending | undefined)!!
  set(owner: number, runId: number, run: WorkflowRun, approval: WorkflowApproval): Pending!!
  clear(): void!!
}

const kept = Layer.sync(ApprovalWords, () => {
  let next = 0
  let pending: Pending | undefined
  return {
    get: () => succeed(pending),
    set: (owner: number, runId: number, run: WorkflowRun, approval: WorkflowApproval) => sync(() => {
      if (pending?.owner === owner && pending.runId === runId && sameAsking(pending.approval, approval)) return pending
      const found = { owner, runId, run, approval, number: ++next }
      pending = found
      return found
    }),
    clear: () => sync(() => { pending = undefined }),
  }
})

type Needs = Agent | WorkflowsApi | ApprovalWords | Rows | Time | Sheet.Machine | RunVisibility

effect function decided(id: number, runId: number, digest: number, approve: boolean): Event!!Needs {
  const attempted = try (try ApprovalWords).get()
  const failure: Event = { type: "decisionAnswered", id, applied: false }
  if (attempted?.number !== digest || attempted.runId !== runId || (approve && !attempted.approval.supported)) return failure
  const scope = ownerAt() catch () => ""
  const rows = try Rows
  const sheet = try Sheet.Machine
  const time = try Time
  if (!(try rows.sameOwner(scope, attempted.owner)) || !(try workflowsVisible())) return failure
  const { workflow } = try WorkflowsApi
  const receipt = (workflow.approvals(attempted.run) catch () => undefined)
  if (receipt === undefined) return { type: "restart" }
  if (receipt === null || receipt.finished || receipt.cancellationRequested) return failure
  const found = receipt.approvals.find((current) => current.status === "pending" && sameAsking(attempted.approval, current))
  if (found === undefined || (approve && !found.supported) || (ownerAt() catch () => "") !== scope) return failure
  const now = try time.now()
  const live = try sheet.get()
  if (live.runId !== runId || live.owner !== attempted.owner || found.expiresAt === undefined || now >= found.expiresAt ||
    !(try rows.sameOwner(scope, attempted.owner)) || !(try workflowsVisible())) return failure
  const result = effect {
    try workflow.decideApproval(attempted.run, found, approve)
    return "answered"
  } catch (error) => error instanceof WorkflowHttpError && [400, 401, 403, 404, 409, 422].includes(error.status) ? "refused" : "unknown"
  if ((ownerAt() catch () => "") !== scope || result === "unknown") return { type: "restart" }
  return { type: "decisionAnswered", id, applied: result === "answered" }
}

effect function checked(ticket: number, runId: number, digest: number, owner: number): Event!!Needs {
  const failed: Event = { type: "approvalRead", ticket, ok: false, owner, waiting: false, answered: "Unanswered", expires: 0, now: untimed }
  const expected = try (try ApprovalWords).get()
  if (expected?.number !== digest || expected.runId !== runId || owner !== expected.owner) return failed
  const scope = ownerAt() catch () => ""
  if (!(try (try Rows).sameOwner(scope, owner))) return failed
  const { workflow } = try WorkflowsApi
  const receipt = (workflow.approvals(expected.run) catch () => undefined)
  if (receipt === undefined || (ownerAt() catch () => "") !== scope) return failed
  const found = receipt?.approvals.find((approval) => sameAsking(expected.approval, approval))
  const answered: Answer = found?.status === "approved" ? "WasApproved" : found?.status === "denied" ? "WasDenied" : "Unanswered"
  return { type: "approvalRead", ticket, ok: true, owner, waiting: found?.status === "pending" && receipt?.finished === false && !receipt.cancellationRequested,
    answered, expires: found?.expiresAt ?? 0, now: untimed }
}

function carry(fx: Out): Job<Event, Needs, []> {
  return match (fx) {
    when { tag: "Decide", let id, let runId, let digest, let approve }: answer("approval decision", decided(id, runId, digest, approve), { type: "restart" });
    when { tag: "ReadApproval", let ticket, let runId, let digest, let owner }: answer("approval receipt",
      checked(ticket, runId, digest, owner), { type: "approvalRead", ticket, ok: false, owner, waiting: false, answered: "Unanswered", expires: 0, now: untimed });
    when { tag: "WantNotice" }: run("approval notification", succeed(undefined));
    when { tag: "DropNotice" }: run("approval notification", succeed(undefined));
  }
}

const watching = applying(Sheet.Machine, (state) => ({ owner: state.owner, runId: state.runId, loaded: state.output.status === "Loaded", ticket: state.output.ticket }),
  effect ({ owner, runId, loaded }: { owner: number; runId: number; loaded: boolean }) => {
    const approvals = try Model.Machine
    const words = try ApprovalWords
    const state = try approvals.get()
    if (state.owner !== owner) {
      try words.clear()
      try ignore(approvals.send({ type: "ownerChanged", owner }))
    }
    if (runId !== state.runId) try ignore(approvals.send({ type: "closeApproval" }))
    if (runId === 0 || !loaded) return
    const list = try (try Listing.Machine).get()
    if (list.owner !== owner || list.place.tag !== "ListingDetail") return
    const history = try (try HistoryWordsPort).view(owner, list.place.row)
    const open = history.opened
    if (open?.number !== runId) return
    const approval = open.approvals.find((one) => one.status === "pending" && one.expiresAt !== undefined)
    if (approval === undefined || approval.expiresAt === undefined) {
      if (open.raw.finished && state.runId === runId) try ignore(approvals.send({ type: "runEnded", runId }))
      return
    }
    const pending = try words.set(owner, runId, open.raw, approval)
    const live = try approvals.get()
    if (live.digest !== pending.number) try ignore(approvals.send({
      type: "approvalAsked", owner, runId, digest: pending.number, expires: approval.expiresAt, running: !open.raw.finished, now: untimed,
    }))
    try ignore(approvals.send({ type: "openApproval", now: untimed }))
  })

export const approvals = together(
  reacting(Model, { carry, timers: (state) => state.approval === "Waiting" ? [due<Event, []>("approval expires", state.expires, { type: "expire", now: untimed })] : [] }),
  kept,
  watching,
)
