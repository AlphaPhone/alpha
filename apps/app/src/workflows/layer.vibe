// spec/workflows/index.md
import { api } from "./api.vibe"
import { automations } from "./automations.vibe"
import { clockDraft } from "./clock-draft.vibe"
import { definitions } from "./definitions.vibe"
import { digests } from "./digests.vibe"
import { approvalNotices, phoneSteps } from "./notices.vibe"
import { requestRecovery } from "./recovery.vibe"
import { hostedResults } from "./results.vibe"
import { runs, versions } from "./runs.vibe"
import { simulatedWorkflows } from "./simulator.vibe"
import { digestSources } from "./sources.vibe"

const agent = Layer.provideMerge(versions, api)

const services = Layer.mergeAll(
  runs, automations, definitions, approvalNotices, phoneSteps, digests, digestSources, hostedResults, clockDraft, requestRecovery, simulatedWorkflows,
)

/**
 * Workflows' services: WorkflowApi, WorkflowVersions, WorkflowRuns, Automations, WorkflowDefinitions, ApprovalNotices, PhoneSteps,
 * Digests, DigestSourcesService, HostedResults, WorkflowClockDraft, RequestRecovery and SimulatedWorkflows. It needs Resident,
 * Native, Build and KeyValueStore from the platform.
 */
export const layer = Layer.provideMerge(services, agent)
