// spec/assistant/decision.md, "Story: Approve or deny a workflow step once"; spec/workflows/deviceSteps.md, "Story: Approve a phone step only as I reviewed it"
import { type WorkflowApproval, parseWorkflowRun, workflowApprovalProposalId } from "@elizaos/plugin-workflow/client"
import { type StepAnswer, WorkflowStepDecisions } from "../assistant/ports.vibe"
import { WorkflowApi } from "./api.vibe"

function decidable(approval: WorkflowApproval, approved: boolean): boolean {
  return approval.status === "pending" && (!approved || approval.supported)
}

/** The assistant's step decisions over the engine's approval route: one decision on the run's one pending request, read back from its receipt. */
export const stepDecisions = Layer.effect(WorkflowStepDecisions, effect {
  const agent = try WorkflowApi
  const client = agent.workflow
  return {
    effect decide(runId: string, approved: boolean) {
      const answer = (agent.request("GET", `/api/workflow/executions/${runId}`) catch () => undefined)
      const raw = typeof answer === "object" && answer !== null ? (answer as { execution?: unknown }).execution : undefined
      const run = raw === undefined ? undefined : (parseWorkflowRun(raw) catch () => undefined)
      if (run === undefined || run.id !== runId || run.finished) return "unavailable" satisfies StepAnswer
      const receipt = (client.approvals(run) catch () => null)
      if (receipt === null || receipt.finished || receipt.cancellationRequested) return "unavailable" satisfies StepAnswer
      const pending = receipt.approvals.filter((a) => decidable(a, approved))
      const [approval] = pending
      if (approval === undefined || pending.length !== 1) return "unavailable" satisfies StepAnswer
      const id = workflowApprovalProposalId(approval)
      const decided = (client.decideApproval(run, approval, approved) catch () => undefined)
      if (decided === undefined) return "lost" satisfies StepAnswer
      const status = approved ? "approved" : "denied"
      return decided.approvals.some((a) => workflowApprovalProposalId(a) === id && a.status === status && a.requestDigest === approval.requestDigest) ? "recorded" : "lost"
    },
  }
})
