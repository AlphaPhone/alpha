// spec/workflows/deviceSteps.md, "Story: Hear or see a phone step's result only as I reviewed it"; spec/workflows/deviceSteps.md, "Speech and notices run only on the visible, unlocked, non-private screen; speech cut off after its audio began is unknown"; spec/workflows/deviceSteps.md, "A notification step is posted on Android, bound to its run, step and operation; elsewhere it is a notice in Alpha"
import type { ExecutorCall } from "@elizaos/agent/client"
import { readOperation, type DeviceOperation } from "@elizaos/agent/operations"
import type { WorkflowNoticeRoute } from "@elizaos/plugin-workflow/client"
import { type PostedAnswer, type Presented, noticePath, postedOutcome, presentationAdmitted, spokenOutcome } from "../../gen/workflows__deviceSteps.effect.vibe"
import { copy } from "../assistant/presentation.vibe"
import { AssistantHost, type AgentIdentity } from "../assistant/host.vibe"
import { DeviceReview, type OperationPorts } from "../assistant/review.vibe"
import { Native, NativeUnavailable } from "../platform/native.vibe"
import { Notices } from "../shell/notices.vibe"
import { Speech } from "../voice/speech.vibe"
import { WorkflowApi } from "./api.vibe"
import { sha256Hex } from "./ids.ts"
import { PhoneSteps } from "./notices.vibe"
import { NoticePosted } from "./wire.schema.vibe"

type SpeakOperation = Extract<DeviceOperation, { type: "speak_text" }>
type NoticeOperation = Extract<DeviceOperation, { type: "post_notification" }>
type Owned = SpeakOperation | NoticeOperation

const refused = (code: string) => ({ kind: "refused", code })
const applied = { kind: "applied" }
const lost = { kind: "lost" }

/** The speech and notification steps of an approved workflow this area runs, or undefined for every other wire type. */
export function ownedOperation(operation: unknown): Owned | undefined {
  const op = readOperation(operation)?.operation
  return op?.type === "speak_text" || op?.type === "post_notification" ? op as Owned : undefined
}

/** The card's title and detail for a speech or notification step, with the exact text it presents. */
export function describeOwned(op: Owned): { readonly title: string; readonly detail: string } {
  return op.type === "speak_text"
    ? { title: "Read this aloud", detail: op.text }
    : { title: "Post a notification", detail: `${op.title}\n${op.body}` }
}

/** The receipt sentence for a settled speech or notification step. */
export function summarizeOwned(op: Owned, result: "NoResult" | "Applied" | "Failed" | "NotStarted" | "Unknown"): string {
  if (op.type === "speak_text") {
    if (result === "Applied") return "Finished reading the reviewed text aloud."
    if (result === "Failed" || result === "NotStarted") return "Nothing was read aloud."
    return "Alpha can’t tell whether the whole text was read aloud."
  }
  if (result === "Applied") return "Posted the reviewed notification."
  if (result === "Failed" || result === "NotStarted") return "No notification was posted."
  return copy.unconfirmed
}

/** The text a workflow notification's binding hashes: the owner scope, agent session, enrollment, proposal (its id and the digest it was listed under) and operation it was approved for. */
export function workflowNoticeBindingText(route: WorkflowNoticeRoute, identity: AgentIdentity, call: ExecutorCall, proposalDigest: string): string {
  return JSON.stringify([route.scope, route.ownerId, route.agentId, identity.session, route.origin, identity.installationId, identity.enrollmentId, call.proposalId, proposalDigest, call.operationId])
}

const POSTED: Readonly<Record<string, PostedAnswer>> = { succeeded: "PostedSucceeded", failed: "PostedFailed" }

/** Workflows' family of agent device operations for `DeviceExecutors`: an approved step reads its reviewed text aloud or posts its reviewed notification, only on the screen in front. */
export const operationPorts = effect {
  const host = try AssistantHost
  const speech = try Speech
  const notices = try Notices
  const native = try Native
  const agent = try WorkflowApi
  const steps = try PhoneSteps
  const review = try DeviceReview

  effect function admitted() {
    const exposure = (try host.screen()).exposure
    return presentationAdmitted(!exposure.hidden, exposure.locked, exposure.privateView)
  }

  effect function speak(op: SpeakOperation) {
    const front = try admitted()
    if (!front) return refused("screen_not_current")
    const started = try Ref.make(false)
    const spoken = try (effect {
      try speech.speak(op.text, "AppSpeech", { onStarted: () => Ref.set(started, true) })
      return "finished"
    } catch (error) => error._tag === "SpeechInterrupted" && error.started ? "cut" : "silent")
    const outcome: Presented = spokenOutcome(front, spoken === "cut" || (try Ref.get(started)), spoken === "finished")
    if (outcome === "PresentedApplied") return applied
    return outcome === "PresentedUnknown" ? lost : refused("speech_unavailable")
  }

  effect function routeOf() {
    const review = try steps.reviewed()
    if (review === undefined) return undefined
    const scope = agent.scope() catch () => undefined
    if (scope === undefined) return undefined
    const hash = tryPromise(() => sha256Hex(JSON.stringify([scope.origin, scope.ownerId, scope.agentId]))) catch () => ""
    if (hash === "") return undefined
    return { scope: hash, origin: scope.origin, ownerId: scope.ownerId, agentId: scope.agentId, workflowId: review.run.workflowId, runId: review.run.id, versionId: review.run.versionId }
  }

  effect function postOnPhone(op: NoticeOperation, call: ExecutorCall) {
    const unbound = { offered: true, bound: false, outcome: "PresentedRefused" as Presented }
    const route = try routeOf()
    const identity = try host.identity()
    const facts = try review.callFacts(call)
    if (route === undefined || identity === undefined || facts.digest === "" || facts.workflow?.runId !== route.runId) return unbound
    const bindingHash = tryPromise(() => sha256Hex(workflowNoticeBindingText(route, identity, call, facts.digest))) catch () => ""
    if (bindingHash === "") return unbound
    const answer = native.invoke("AlphaNotifications", "postWorkflow", { operationId: call.operationId, bindingHash, title: op.title, body: op.body, route }) catch (error) => error
    if (answer instanceof NativeUnavailable) return { offered: false, bound: true, outcome: "PresentedRefused" as Presented }
    if (answer instanceof Error) return { offered: true, bound: true, outcome: postedOutcome("PostedOther") }
    const posted = Schema.decodeUnknownEffect(NoticePosted)(answer) catch () => undefined
    return { offered: true, bound: true, outcome: postedOutcome(POSTED[posted?.status ?? ""] ?? "PostedOther") }
  }

  effect function post(op: NoticeOperation, call: ExecutorCall) {
    if (!(try admitted())) return refused("screen_not_current")
    const phone = try postOnPhone(op, call)
    if (noticePath(phone.offered, phone.bound) === "AndroidNotice") {
      if (phone.outcome === "PresentedApplied") return applied
      return phone.outcome === "PresentedUnknown" ? lost : refused("notification_unavailable")
    }
    try notices.persist(`${op.title.trim()}: ${op.body.trim()}`)
    return applied
  }

  const ports: OperationPorts = {
    validate: (operation) => ownedOperation(operation),
    execute: (operation: unknown, call: ExecutorCall) => {
      const op = ownedOperation(operation)
      if (op === undefined) return Promise.resolve(refused("unsupported"))
      return runPromise(op.type === "speak_text" ? speak(op) : post(op, call))
    },
    readBack: () => Promise.resolve({ kind: "refused", code: "no_readback" }),
    describe: (operation) => {
      const op = ownedOperation(operation)
      return op === undefined ? { title: "Action", detail: "" } : describeOwned(op)
    },
    classOf: () => "CreateReminder",
    target: () => ({ tag: "NoTarget" }),
    summarize: (operation, result) => {
      const op = ownedOperation(operation)
      return op === undefined ? "" : summarizeOwned(op, result)
    },
  }
  return ports
}
