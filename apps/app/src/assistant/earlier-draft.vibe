// spec/app/assistant/composer.md, "A draft the earlier Alpha kept for the conversation is taken once into an unused slot, and one it was sending comes back for review"; spec/app/platform/adoption.md, "Story: Keep what the earlier Alpha kept"
import { Agent, type Place, adopt, ask, earlierSlot, ownerAt } from "../platform/index.vibe"

module web {
  /** The earlier Alpha bounded a draft's text in UTF-8 bytes. */
  const earlierTextBytes = 64_000

  /** The secure slot the earlier Alpha kept `binding`'s draft in: `assistant-draft:v1:` and the binding's lowercase hex SHA-256. */
  export async function earlierSlotName(binding: string): Promise<string> {
    const digest = new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(binding)))
    return "assistant-draft:v1:" + Array.from(digest, (byte) => byte.toString(16).padStart(2, "0")).join("")
  }

  /**
   * The draft the earlier Alpha kept for `binding`, as this Alpha keeps a slot: exactly a version-1 row for this
   * binding, with `sending` only ever true, taken as one write that landed; nothing for anything else, so another
   * conversation's text is never taken. @throws {never}
   */
  export function earlierDraftOf(raw: string, binding: string): string | undefined {
    try {
      const value: unknown = JSON.parse(raw)
      if (typeof value !== "object" || value === null || Array.isArray(value)) return undefined
      const row = value as Record<string, unknown>
      const keys = Object.keys(row).sort().join(",")
      if (keys !== "binding,revision,text,version" && (keys !== "binding,revision,sending,text,version" || row.sending !== true)) return undefined
      if (row.version !== 1 || row.binding !== binding || typeof row.revision !== "string" || row.revision === "") return undefined
      if (typeof row.text !== "string" || row.text === "" || new TextEncoder().encode(row.text).length > earlierTextBytes) return undefined
      return JSON.stringify({ revision: 1, text: row.text, sending: row.sending === true })
    } catch {
      return undefined
    }
  }
}
import { earlierDraftOf, earlierSlotName } from web

/** Where the earlier Alpha's phone build reached its resident agent: the origin it named each draft's binding under. */
const earlierOrigin = "https://device.alpha.invalid"

const Agents = Schema.Struct({ agents: Schema.Array(Schema.Struct({ id: Schema.NonEmptyString })) })

/**
 * Take the draft the earlier Alpha kept for the conversation `conversation` (the agent's id for it, or null for a new
 * chat) into `slot`, where `slot` holds nothing yet, and whether it was taken. The earlier binding is the one it built:
 * its origin, the owner and the agent the resident names, and the conversation. Anything that cannot be read stays
 * where it is for a later open.
 */
export effect function adoptEarlierDraft(conversation: string | null, slot: Place<string>): boolean!!Agent {
  const owner = ownerAt() catch () => undefined
  const listed = ask(Agent, HttpClientRequest.get("/api/agents"), Agents) catch () => undefined
  if (owner === undefined || listed === undefined || listed.agents.length !== 1) return false
  const binding = JSON.stringify([earlierOrigin, owner, listed.agents[0].id, conversation])
  const name = tryPromise(() => earlierSlotName(binding)) catch () => undefined
  if (name === undefined) return false
  return (try adopt(earlierSlot(name), slot, (raw: string) => Option.fromNullishOr(earlierDraftOf(raw, binding)))) === "Adopted"
}
