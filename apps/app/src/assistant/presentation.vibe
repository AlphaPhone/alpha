// spec/assistant/receipts.md, "A receipt's title says what the journal proves"; spec/assistant/recovery.md, "Try again is offered while the resident is refused with nothing held, and starts it once per tap"; spec/voice/conversation.md, "Out of plan allowance and credits ends voice quietly as Stop does, and the chat gets the one line"; spec/assistant/reply.md, "A failure refused before any output replaces the streamed text; any other failure is added after it"; spec/assistant/reply.md, "A failed reply offers the fix the agent named, and a rate limit shows its live wait, never retrying the message"; spec/assistant/approvals.md, "Story: Decline or let a card expire"; spec/assistant/receipts.md, "A reply cut off after an effect says so, and a queued approval request reads as needing approval"
import type { CutOff, ReceiptTitle } from "../../gen/assistant__receipts.ts"
import type { Refusal } from "../../gen/assistant__recovery.ts"
import { showsWait, waitSeconds, type FailureKind, type PlanAction } from "../../gen/assistant__reply.ts"
import { hostOf } from "./grounding.vibe"

