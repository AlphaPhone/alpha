/** The word a workflow change card shows. */
export const changeWords = {
  Created: "Created", Updated: "Updated", TurnedOn: "Turned on", PausedWord: "Paused", Restored: "Restored", Renamed: "Renamed", RemovedWord: "Removed", Changed: "Changed",
} as const

/** The title of a receipt for what the journal proves. */
export function receiptTitle(title: ReceiptTitle): string {
  switch (title) {
    case "Completed": return "Completed"
    case "NotConfirmed": return "Not confirmed"
    case "NotCompleted": return "Not completed"
    case "NoTitle": return ""
  }
}

/** The label a cut-off reply carries. */
export function cutOffText(cut: CutOff): string {
  switch (cut) {
    case "NotCutOff": return ""
    case "DoneCutOff": return "Done · reply cut off"
    case "NeedsApprovalCutOff": return "Needs your approval · reply cut off"
  }
}

/** A failure kind, from the reply's `failureKind` or `terminalFailure.kind`. */
export function failureKindOf(code: string | undefined): FailureKind {
  switch (code) {
    case "insufficient_credits": return "InsufficientCredits"
    case "missing_capability": return "MissingCapability"
    case "no_provider": return "NoProvider"
    case "provider_issue": return "ProviderIssue"
    case "rate_limited": return "RateLimited"
    case "billing-refused":
    case "subscription-required":
    case "allowance-exhausted": return "PlanLimit"
    default: return "OtherFailure"
  }
}

/** Alpha's sentence for a failed reply. */
export function failureText(kind: FailureKind): string {
  switch (kind) {
    case "InsufficientCredits": return "Your plan is out of credits. Manage your plan to keep chatting."
    case "MissingCapability": return "Your agent can’t do that on this phone yet."
    case "NoProvider": return "No AI provider is set up. Choose one in Settings."
    case "ProviderIssue": return "The AI provider isn’t answering. Try again in a moment."
    case "RateLimited": return "Too many requests right now. Try again in a moment."
    case "PlanLimit": return "Your plan’s allowance is used up. Manage your plan to keep chatting."
    case "OtherFailure": return copy.replyFailed
  }
}

/** The plan card a reply carries, or none. */
export function planCardTitle(action: PlanAction, cloud: string): string {
  switch (action) {
    case "ChoosePlan": return "Choose plan"
    case "SignIn": return `Sign in with ${cloud}`
    case "RetryCloud":
    case "RecheckProvider": return `Check ${cloud} again`
    case "Funding": return "Manage plan"
  }
}

/** A plan action of the wire, or none. */
export function planActionOf(raw: unknown): PlanAction | undefined {
  switch (raw) {
    case "plan": return "ChoosePlan"
    case "retry": return "RetryCloud"
    case "sign-in": return "SignIn"
    case "provider": return "RecheckProvider"
    case "funding": return "Funding"
    default: return undefined
  }
}

/** "Expires at …" in the device's own clock format, or nothing once past. */
export function approvalExpiryText(expiresAt: number, now: number, locale: string | undefined): string {
  if (!Number.isFinite(expiresAt) || expiresAt <= now) return ""
  try {
    return `Expires at ${new Intl.DateTimeFormat(locale, { hour: "numeric", minute: "2-digit" }).format(new Date(expiresAt))}`
  } catch {
    return ""
  }
}

/** The receipt summary shown for an action result, in Alpha's words. */
export function actionResultText(summary: string): string {
  if (summary === "The action could not reach a confirmed result." || summary === "Action did not reach a confirmed result. Check action history before requesting it again.") return copy.unconfirmed
  return summary
}

/** The summary of an approved Browser open. */
export function browserNavigationSummary(url: string): string {
  const host = hostOf(url)
  return host === "" ? "" : `Created a browser tab for ${host}.`
}

/** The summary of a receipt whose upload has not reached the agent yet. */
export function unsyncedSummary(summary: string): string {
  return `${summary.replace(/\.$/, "")}, but it isn't synced yet.`
}

/** A stored system notice in Alpha's words. */
export function systemNoticeText(kind: "model-unavailable" | "runtime-error" | "both", unanswered: boolean): string {
  switch (kind) {
    case "model-unavailable": return "No AI provider · Open Settings"
    case "runtime-error": return unanswered ? "Agent error · Send again" : "Agent degraded"
    case "both": return "No AI provider · Open Settings\nAgent degraded"
  }
}
