// spec/assistant/review.md, "Story: Let my agent act only with my say-so"; spec/assistant/attachments.md, "Story: Attach a photo or file to my message"
import { decodeFilesOperation, describeFilesOperation } from "@elizaos/plugin-files/contract"
import { FilesAgent, type AgentContext } from "../files/agent.vibe"
import { AssistantHost } from "./host.vibe"
import { copy } from "./presentation.vibe"
import type { OperationPorts } from "./review.vibe"

/** A family that runs nothing, for a phone without Files. */
const noFamily: OperationPorts = {
  validate: () => undefined,
  execute: async () => ({ kind: "refused", code: "unsupported" }),
  readBack: async () => ({ kind: "refused", code: "unsupported" }),
  describe: () => ({ title: "Action", detail: "" }),
  classOf: () => "NotesRead",
  target: () => ({ tag: "NoTarget" }),
  summarize: () => "",
}

/** The Files operations the assistant's device review runs, handed to Files' own agent runner; the shell registers this family in `deviceExecutorsLive`. */
export const operationPorts = effect {
  const found = try Effect.serviceOption(FilesAgent)
  if (Option.isNone(found)) return noFamily
  const files = found.value
  const host = try AssistantHost
  const decoded = (operation: unknown) => Effect.runSync(Effect.option(decodeFilesOperation(operation)))
  const contextNow = (): AgentContext => Effect.runSync(effect {
    const screen = try host.screen()
    const view = screen.observation.view
    return { view: view === "home" ? "home" as const : view === "files" ? "files" as const : "other" as const, sensitive: screen.exposure.privateView || screen.exposure.locked, foreground: !screen.exposure.hidden }
  })
  const ports: OperationPorts = {
    validate: (operation) => Option.isSome(decoded(operation)) ? operation : undefined,
    execute: async (operation) => {
      const op = decoded(operation)
      if (Option.isNone(op)) return { kind: "refused", code: "unsupported" }
      const prepared = await runPromise(files.prepare(op.value, contextNow()))
      if (prepared.kind !== "ready") return { kind: "refused", code: prepared.kind === "notAvailable" ? "not_available" : "failed", result: prepared }
      const done = await runPromise(files.run(prepared.op, contextNow(), host.openView("files")))
      return done.status === "succeeded" ? { kind: "applied", result: done } : { kind: "refused", code: "files_failed", result: done }
    },
    readBack: async () => ({ kind: "refused", code: "no_readback" }),
    describe: (operation) => {
      const op = decoded(operation)
      if (Option.isNone(op)) return { title: "Action", detail: "" }
      const described = describeFilesOperation(op.value)
      return { title: described.title, detail: described.description }
    },
    classOf: (operation) => {
      const op = decoded(operation)
      return Option.isSome(op) && (op.value.type === "files_open" || op.value.type === "files_filter") ? "FilesOpen" : "NotesRead"
    },
    target: () => ({ tag: "NoTarget" }),
    summarize: (_operation, result) => result === "Applied" ? "Done in Files." : copy.unconfirmed,
  }
  return ports
}
