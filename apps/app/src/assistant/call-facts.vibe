// spec/assistant/review.md, "The keypad opens directly only for a number I typed, a photo only for my own photo request, and Browser only for an address or search I wrote"; spec/telephony/actions.md, "A view change that shows the outcome waits for the reply that carries it"
import type { ExecutorCall } from "@elizaos/agent/client"
import { Machine as SendsMachine } from "../../gen/assistant__send.effect.vibe"
import { CameraCallFacts } from "../camera/ports.vibe"
import type { TelephonyCalls } from "../telephony/ports.vibe"
import { DeviceReview } from "./review.vibe"

/** Camera's per-call facts from the assistant's review: a photo runs without its card only for the owner's own words in the message it answers. */
export const cameraCallFactsLive = Layer.effect(CameraCallFacts, effect {
  const review = try DeviceReview
  return {
    of: (call: ExecutorCall) => map(review.callFacts(call), (facts) => ({
      reviewed: facts.reviewed, messageId: facts.messageId, ownerText: facts.reviewed ? "" : facts.ownerText,
    })),
  }
})

/** The assistant's part of Telephony's calls, for the shell to fill into `TelephonyCalls`: whether a call was reviewed, the owner's words, and the end of the chat request carrying its reply (#1433). */
export effect function telephonyCallsFromAssistant() {
  const review = try DeviceReview
  const sends = try SendsMachine
  const calls: TelephonyCalls.Shape = {
    of: (call: ExecutorCall) => map(review.callFacts(call), (facts) => ({ reviewed: facts.reviewed, ownerText: facts.ownerText })),
    settled: () => effect {
      if (!(try sends.get()).typing) return
      try Stream.runHead(Stream.filter(sends.changes, (state) => !state.typing))
    },
  }
  return calls
}
