// spec/app/assistant/chats.md, "Story: Find my conversations"; spec/app/assistant/composer.md, "Story: Keep what I am writing"
import type { ConversationRecord } from "@elizaos/agent"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import type { Binding } from "../../gen/app__assistant__composer.effect.vibe"
import { sameArchiveAuthority, type ArchiveAuthority } from "../../gen/app__assistant__attachments.effect.vibe"
import type { MediaCard } from "./media-review.vibe"
import type { Failure, Fix } from "../../gen/app__assistant__reply.ts"
import type { MailQuestion } from "../inbox/mail-context.vibe"
import type { Sighting } from "../platform/location.vibe"
import type { CommsPrompt } from "../phone/comms.vibe"
import type { NoteTranscript } from "../notes/selection.vibe"

/** One file selected by the owner, with the bytes admitted by the Ask Alpha attachment policy. */
export interface Attached {
  readonly id: string
  readonly name: string
  readonly mimeType: string
  readonly data: string
}

/** The batch staged for one concrete send, under the composer's own hold number and binding. */
export interface StagedFiles {
  readonly ticket: number
  readonly hold: number
  readonly binding: Binding
  readonly key?: string
  readonly files: readonly Attached[]
  readonly authority?: ArchiveAuthority
  readonly mail?: MailQuestion
  readonly transcript?: TranscriptAttachment
}

/** The exact note accepted into this composer's conversation. */
export interface TranscriptAttachment {
  readonly offered: NoteTranscript
  readonly binding: Binding
}

/** One message of the conversation showing, as the agent keeps it. */
export interface Line {
  readonly id: string
  readonly mine: boolean
  readonly text: string
  /** The words of the message this one quotes. */
  readonly quote?: string
  /** Why a reply the agent keeps did not finish, as its history says, in Alpha's words. */
  readonly failure?: Failure
  readonly attachments?: readonly Attached[]
}

interface MessagePage {
  readonly conversation: number
  readonly lines: ReadonlyArray<Line>
}

/** A search hit: the conversation it is in, by its number, the message, by its number, and what it says. */
export interface Hit {
  readonly conversation: number
  readonly message: number
  readonly text: string
}

/** A conversation the agent listed, under the number Alpha gives it. */
export interface Known {
  readonly record: ConversationRecord
  readonly title: string
}

/** What the screen shows beside the machines' states: words, which the specs count but never hold. */
export interface Seen {
  /** The messages of each page read, by the ticket that read it; the page showing is the one under the chats' newest ticket. */
  readonly pages: ReadonlyMap<number, MessagePage>
  /** The reply as it is written, until it ends. */
  readonly reply: string
  /** What the agent says it is doing until its reply is written: its acknowledgment, its status or the app its tool uses. */
  readonly label: string
  /** Why the last reply did not finish, the fix the agent named, and how long the provider asked to wait, or -1. */
  readonly failure: { readonly kind: Failure; readonly fix: Fix; readonly waitMs: number } | undefined
  /** The text in the composer's box, which its slot keeps. */
  readonly typed: string
  readonly files: readonly Attached[]
  readonly filesBinding: Binding | undefined
  readonly filesAuthority: ArchiveAuthority | undefined
  readonly transcript: TranscriptAttachment | undefined
  readonly attachmentNotice: string
  readonly preview: { readonly ticket: number; readonly file: Attached } | undefined
  readonly media: ReadonlyArray<MediaCard>
  readonly mediaNote: { readonly conversation: number; readonly text: string } | undefined
  /** The text of a message the slot marks as sending, under review; or the saved copy of a conflict. */
  readonly saved: string
  /** The hits of each search, by the ticket that asked from the first hit. */
  readonly hits: ReadonlyArray<Hit>
  /** The title of each conversation, by its number. */
  readonly titles: ReadonlyMap<number, string>
}

/**
 * The words around the assistant's machines, and the agent's names for what they number: the store a screen reads
 * with `useSyncExternalStore`, and the shell writes. It holds no rule; each machine decides what counts.
 */
export interface Board {
  snapshot(this: void): Seen
  subscribe(this: void, listener: () => void): () => void
  /** The owner typed `text` in the composer's box. */
  type(text: string): void
  /** Hold `text` as the outgoing message for the send in hand. */
  hold(text: string): void
  /** Mark a send waiting for the new conversation to be made. */
  queueSend(): void
  /** The text a send in hand carries, the last text sent, and a send that waits for its conversation to be made. */
  outgoing: string
  lastSent: string
  /** The exact wire text, used only to reconcile a turn without a message ID. */
  lastSentWire: string
  /** The id the last message was posted under, as the agent keeps it, or "" where its post never said. */
  lastSentId: string
  sendWhenMade: boolean
  staged: StagedFiles | undefined
  lastTranscriptOffer: number
  previewFile(file: Attached): number
  bindArchiveAuthority(authority: ArchiveAuthority | undefined): boolean
  /** Keep `sighting` under the `ticket` the locator accepted. */
  rememberPosition(ticket: number, sighting: Sighting): void
  /** Forget any remembered position once the locator has none. */
  forgetPosition(): void
  /** The remembered position for `ticket`, if the locator still holds that ticket. */
  positionFor(ticket: number): Sighting | undefined
  waitingRequest: CommsPrompt | undefined
  postingRequest: CommsPrompt | undefined
  change(patch: Partial<Seen>): void
  /** The number of the conversation the agent names `record`, given the first time it is seen; its title where one is given. */
  numberOf(record: ConversationRecord, title?: string): number
  known(conversation: number): Known | undefined
  /** The number of the message the agent names `id`, given the first time it is seen. */
  messageNumber(id: string): number
  /** The number given to the message the agent names `id`, or 0 for one never seen. */
  numbered(id: string): number
  messageId(message: number): string | undefined
  /** The page under `ticket`, and mutations of a turn's own page. */
  page(ticket: number): ReadonlyArray<Line>
  line(conversation: number, message: number): Line | undefined
  putPage(ticket: number, conversation: number, lines: ReadonlyArray<Line>): void
  /** Take confirmed rows and retire loaded copies of any now-redacted attachment, returning its open preview ticket. */
  takeHistory(ticket: number, conversation: number, lines: readonly Line[], redacted: ReadonlySet<string>): number | undefined
  append(ticket: number, conversation: number, line: Line): void
  rename(ticket: number, line: Line, id: string): void
  drop(ticket: number, line: Line): void
}

export service Talk {
  readonly board: Board
  readonly attachmentLock: Semaphore.Semaphore
}

/** Where the agent's conversations are kept by number, so that the conversation showing is found again after a restart. */
const key = "alpha/assistant/conversations@1"

module pure {
  /** What was kept under `key`, or nothing. @throws {never} */
  export function unkept(text: string | undefined): ReadonlyArray<{ readonly id: string; readonly roomId: string; readonly title: string }> {
    if (text === undefined) return []
    try {
      const found = JSON.parse(text) as { conversations?: unknown }
      return Array.isArray(found.conversations) ? found.conversations.filter((one): one is { id: string; roomId: string; title: string } =>
        typeof one === "object" && one !== null && typeof one.id === "string" && one.id !== "" && typeof one.roomId === "string" && one.roomId !== "" && typeof one.title === "string") : []
    } catch {
      return []
    }
  }
}
import { unkept } from pure

/** The board, with the conversations numbered before kept from the store, and each new one kept there. */
export const talk = Layer.effect(Talk, effect {
  const store = try KeyValueStore.KeyValueStore
  const remembered = unkept(store.get(key) catch () => undefined)
  let archiveAuthority: ArchiveAuthority | undefined
  const records: Known[] = remembered.map((one) => ({ record: { id: one.id, roomId: one.roomId } as ConversationRecord, title: one.title }))
  const messages: string[] = []
  const numbers = new Map<string, number>()
  const listeners = new Set<() => void>()
  let position: { readonly ticket: number; readonly sighting: Sighting } | undefined
  let seen: Seen = {
    pages: new Map(), reply: "", label: "", failure: undefined, typed: "", files: [], filesBinding: undefined, filesAuthority: undefined, transcript: undefined, attachmentNotice: "", preview: undefined, media: [], mediaNote: undefined, saved: "", hits: [],
    titles: new Map(records.map((one, at) => [at + 1, one.title])),
  }
  const keep = () => runFork(ignore(store.set(key, JSON.stringify({ conversations: records.map((one) => ({ id: one.record.id, roomId: one.record.roomId, title: one.title })) }))))
  const board: Board = {
    snapshot: () => seen,
    subscribe: (listener) => {
      listeners.add(listener)
      return () => { listeners.delete(listener) }
    },
    type: (text) => board.change({ typed: text }),
    hold: (text) => { board.outgoing = text },
    queueSend: () => { board.sendWhenMade = true },
    outgoing: "",
    lastSent: "",
    lastSentWire: "",
    lastSentId: "",
    sendWhenMade: false,
    staged: undefined,
    lastTranscriptOffer: 0,
    previewFile: (file) => {
      const ticket = (seen.preview?.ticket ?? 0) + 1
      board.change({ preview: { ticket, file } })
      return ticket
    },
    rememberPosition: (ticket, sighting) => { position = { ticket, sighting } },
    forgetPosition: () => { position = undefined },
    positionFor: (ticket) => (position?.ticket === ticket ? position.sighting : undefined),
    waitingRequest: undefined,
    postingRequest: undefined,
    change: (patch) => {
      seen = { ...seen, ...patch }
      for (const listener of listeners) listener()
    },
    numberOf: (record, title) => {
      const at = records.findIndex((one) => one.record.id === record.id)
      if (at >= 0) {
        if (title !== undefined && records[at]?.title !== title) {
          records[at] = { record, title }
          board.change({ titles: new Map([...seen.titles, [at + 1, title]]) })
          keep()
        }
        return at + 1
      }
      records.push({ record, title: title ?? "Ask Alpha" })
      board.change({ titles: new Map([...seen.titles, [records.length, title ?? "Ask Alpha"]]) })
      keep()
      return records.length
    },
    known: (conversation) => records[conversation - 1],
    messageNumber: (id) => {
      const number = numbers.get(id)
      if (number !== undefined) return number
      messages.push(id)
      numbers.set(id, messages.length)
      return messages.length
    },
    numbered: (id) => numbers.get(id) ?? 0,
    messageId: (message) => messages[message - 1],
    bindArchiveAuthority: (authority) => {
      const previous = archiveAuthority
      if (previous !== undefined && authority !== undefined && sameArchiveAuthority(previous, authority)) return false
      archiveAuthority = authority
      if (previous === undefined) return false
      const pages = new Map(seen.pages)
      let changed = false
      for (const [ticket, page] of pages) {
        if (!page.lines.some((line) => line.attachments !== undefined)) continue
        pages.set(ticket, { ...page, lines: page.lines.map((line) => line.attachments === undefined ? line : { ...line, attachments: undefined }) })
        changed = true
      }
      if (changed || seen.preview !== undefined) board.change({ pages, preview: undefined })
      return true
    },
    page: (ticket) => seen.pages.get(ticket)?.lines ?? [],
    line: (conversation, message) => {
      const id = board.messageId(message)
      if (id === undefined) return undefined
      for (const page of seen.pages.values()) {
        if (page.conversation !== conversation) continue
        const line = page.lines.find((one) => one.id === id)
        if (line !== undefined) return line
      }
      return undefined
    },
    putPage: (ticket, conversation, lines) => {
      board.change({ pages: new Map([...seen.pages, [ticket, { conversation, lines }]]) })
    },
    takeHistory: (ticket, conversation, lines, redacted) => {
      const incoming = new Map(lines.map((line) => [line.id, line]))
      const merged = [...lines, ...board.page(ticket).filter((line) => !incoming.has(line.id))]
      if (redacted.size === 0) {
        board.putPage(ticket, conversation, merged)
        return undefined
      }
      const pages = new Map(seen.pages)
      const preview = seen.preview
      let closed: number | undefined
      for (const [previous, page] of seen.pages) {
        if (page.conversation !== conversation) continue
        let updated = false
        const kept = page.lines.map((line) => {
          const replacement = redacted.has(line.id) ? incoming.get(line.id) : undefined
          if (replacement === undefined) return line
          if (preview !== undefined && line.attachments?.includes(preview.file)) closed = preview.ticket
          updated = true
          return replacement
        })
        if (previous !== ticket && updated) pages.set(previous, { conversation, lines: kept })
      }
      pages.set(ticket, { conversation, lines: merged })
      board.change(closed === undefined ? { pages } : { pages, preview: undefined })
      return closed
    },
    append: (ticket, conversation, line) => {
      const current = board.page(ticket)
      if (!current.some((one) => one.id === line.id)) board.putPage(ticket, conversation, [...current, line])
    },
    rename: (ticket, line, id) => {
      const page = seen.pages.get(ticket)
      if (page === undefined) return
      const existing = page.lines.some((one) => one.id === id)
      board.putPage(ticket, page.conversation, existing ? page.lines.filter((one) => one !== line) : page.lines.map((one) => (one === line ? { ...one, id } : one)))
    },
    drop: (ticket, line) => {
      const page = seen.pages.get(ticket)
      if (page !== undefined) board.putPage(ticket, page.conversation, page.lines.filter((one) => one !== line))
    },
  }
  return { board, attachmentLock: try Semaphore.make(1) }
})
