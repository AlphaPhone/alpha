import { Machine as Chats } from "../../gen/app__assistant__chats.effect.vibe"
import { Machine as Messages } from "../../gen/app__messages.effect.vibe"
import { Machine as Shell, type Detent, type View, agentOpenView, canAgentOpenFilesFrom, showing } from "../../gen/app__shell.effect.vibe"
import * as Layers from "../../gen/app__shell__layers.effect.vibe"
import * as Prefs from "../../gen/app__settings__preferences.effect.vibe"
import type { FileActionReport, FileReview, FilesReadContext } from "../files/agent.vibe"
import { latestSenderResult, sameVoicemail, selectedVoicemail, type VoicemailReadContext, type VoicemailTarget } from "../contacts/reads.vibe"
import { composeRecipient, reviewedCompose, type MessageDraftTarget } from "../messages/agent.vibe"
import { readAgentSms } from "../messages/agent-send.vibe"
import { currentSmsSelection, type MessageSmsRequest, type SmsSelection, type SmsSelectionContext } from "../messages/agent-sim.vibe"
