/** Area-owned equipment and approved executors. The resident protocol never receives a media bridge handle. */
export service MediaExecutors {
  execute(operation: DeviceOperation, call: ExecutorCall, authority: ReviewAuthority): unknown!!
  reviewFiles(operation: DeviceOperation): (FileReview | undefined)!!
  filesContext(): (FilesReadContext | undefined)!!
  static readonly defaultValue = () => ({ execute: () => succeed({ kind: "refused", code: NOT_DISPATCHED }), reviewFiles: () => succeed(undefined), filesContext: () => succeed(undefined) })
}

// spec/app/assistant/context.md, "A turn carries the page Browser hands it for the tab in front, beside the observation, only to a peer that declares it"
/** The page the Browser hands a turn for its tab in front, read by the Browser itself; none where it handed none. */
export service ShownPage {
  read(): unknown!!
  static readonly defaultValue = () => ({ read: () => succeed(undefined) })
}

export interface ReviewAuthority {
  readonly current: () => Promise<boolean>
  readonly continueDraft?: () => Promise<boolean>
  readonly target?: MessageDraftTarget
  readonly sms?: SmsSelection
  readonly files?: FileReview
  readonly reportFiles?: (outcome: FileActionReport) => void
  readonly phone?: ReviewedPhoneContact
}

interface ApprovalScope {
  readonly active: boolean!!
  readonly continueDraft?: boolean!!
  readonly target?: MessageDraftTarget
  readonly sms?: SmsSelection
  readonly files?: FileReview
  readonly reportFiles?: (outcome: FileActionReport) => void
  readonly phone?: ReviewedPhoneContact
}

module native {
  import { registerPlugin } from "@capacitor/core"
  import type { DeviceJournal, JournalEntry } from "@elizaos/agent"

  interface EnrollmentPlugin {
    enrollmentKey(input: { slot: string }): Promise<{ key: string }>
    authority(): Promise<{ active: boolean }>
  }
  interface JournalPlugin {
    get(input: { proposalId: string }): Promise<{ entry: unknown }>
    edit(input: { proposalId: string; expectedRevision: number; next: JournalEntry }): Promise<{ kept: boolean }>
    list(): Promise<{ entries: readonly unknown[] }>
  }
  let enrolled: EnrollmentPlugin | undefined
  let journalPlugin: JournalPlugin | undefined

  /** @throws {never} */
  export function enrollment() { return (enrolled ??= registerPlugin<EnrollmentPlugin>("AlphaMediaEnrollment")) }

  /** @throws {never} */
  export function journal(): DeviceJournal {
    const held = (journalPlugin ??= registerPlugin<JournalPlugin>("ElizaActionJournal"))
    return {
      get: async (proposalId) => {
        const answer = await held.get({ proposalId })
        if (!Object.hasOwn(answer, "entry")) throw new Error("Journal entry missing")
        return answer.entry ?? undefined
      },
      edit: async (proposalId, expectedRevision, next) => (await held.edit({ proposalId, expectedRevision, next })).kept === true,
      list: async () => (await held.list()).entries,
    }
  }

  export async function slotFor(identity: readonly string[]): Promise<string> {
    const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(JSON.stringify(identity)))
    const hex = Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join("")
    return `device:${hex}`
  }
}
import { enrollment, journal, slotFor } from native

const prefix = "/api/client-devices"
const protocol = Schema.Struct({ agentId: Schema.NonEmptyString, identityId: Schema.NonEmptyString, deviceActions: Schema.Struct({ protocol: Schema.Literal(1), capabilities: Schema.Array(Schema.String) }) })
const registration = Schema.Struct({ installationId: Schema.NonEmptyString, enrollmentId: Schema.NonEmptyString })
const context = Schema.Struct({ agentId: Schema.NonEmptyString, installationId: Schema.NonEmptyString, enrollmentId: Schema.NonEmptyString, subjectUserId: Schema.NonEmptyString })
const listed = Schema.Struct({ proposals: Schema.Array(Schema.Struct({ id: Schema.NonEmptyString, digest: Schema.NonEmptyString, state: Schema.String, expiresAt: Schema.String, execution: Schema.optionalKey(Schema.Struct({ attemptId: Schema.NonEmptyString })), payload: Schema.Struct({ operation: Schema.Unknown, requestMessageId: Schema.optionalKey(Schema.String), installationId: Schema.optionalKey(Schema.String), enrollmentId: Schema.optionalKey(Schema.String), workflow: Schema.optionalKey(Schema.Unknown) }) })) })
const claim = Schema.Struct({ digest: Schema.NonEmptyString, proposal: Schema.Struct({ state: Schema.Literal("executing"), execution: Schema.Struct({ attemptId: Schema.NonEmptyString }) }) })

const journalBinding = Schema.Struct({
  proposalId: Schema.NonEmptyString, digest: Schema.NonEmptyString, ownerId: Schema.NonEmptyString,
  agentId: Schema.NonEmptyString, origin: Schema.NonEmptyString, installationId: Schema.NonEmptyString,
  enrollmentId: Schema.NonEmptyString, agentAttemptId: Schema.optionalKey(Schema.NonEmptyString),
})
type Proposal = typeof listed.Type.proposals[number]

/** The device's proposal as it can be shown in the owner's Settings journal. */
export interface ActivityProposal {
  readonly proposal: string
  readonly title: string
  readonly detail: string
  readonly outcome: string
  readonly declinable: boolean
  readonly unsettled: boolean
}

const outcomes: Readonly<Partial<Record<string, string>>> = {
  pending: "Waiting for approval", approved: "Approved", executing: "Outcome still pending", reconciliation_required: "Needs confirmation",
  done: "Finished", rejected: "Declined", expired: "Expired", retryable: "Needs another try", failed: "Failed",
}

const cameraCapabilities = ["camera.capture-photo.v1", "camera.capture-lens.v1", "camera.capture-library-id.v1"]
const photosCapabilities = ["photos.library.v1", "photos.view.v1"]
const filesCapabilities = ["files.browser.v1", "files.shown-target.v1"]
const browserCapabilities = ["browser.open-new-tab.v1", "browser.tabs.show.v1"]
const phoneCapabilities = ["phone.keypad.v1", "phone.dial.v1", "phone.call.v1", "views.telephony.v1", "sms.compose.v1", "sms.compose.v2", "sms.send.v1", "messages.read.v1"]

const needsMessage = (operation: DeviceOperation): boolean => operation.type === "sms_reply_selected" || operation.type === "messages_read_selected"

export type DirectFilesOperation = Extract<DeviceOperation, { type: "files_filter" | "files_open" }>

interface DirectFiles {
  readonly operation: DirectFilesOperation
  readonly files: FilesReadContext
  readonly current: Effect.Effect<boolean>
  readonly report: (note: string) => void
}

type DirectFilesTarget = Pick<MediaCard, "id" | "digest" | "expiresAt" | "operation" | "files">

interface DeviceActionReply {
  readonly directFiles?: DirectFiles
  readonly clientMessageId: string
  readonly sms?: MessageSmsRequest
  readonly actionResults: readonly { readonly action: string; readonly data: unknown }[]
}

function literal(value: string): string {
  return value.trim().replace(/^(?:"([^"]*)"|“([^”]*)”)$/, (_match, straight: string | undefined, curved: string | undefined) => straight ?? curved ?? "")
}

const fileFilterWords = { image: ["images", "photos"], video: ["videos"], audio: ["audio", "audio files"], document: ["documents"], pdf: ["pdfs"], folder: ["folders"] }

/** The owner’s exact Files command, parsed before the turn may ask the agent to act directly. */
export function requestedFilesOperation(authored: string): DirectFilesOperation | undefined {
  const command = authored.trim().replace(/^(?:(?:hey )?alpha[,\s]+)?(?:(?:could|can|would) you\s+)?(?:please\s+)?/i, "")
  const open = /^open (?:the )?(.+?)(?: in Files)?[!?]?$/i.exec(command)
  if (open?.[1] !== undefined) {
    const name = open[1].replace(/^file (?=["“])/i, "").replace(/\.$/, "")
    const position = /^(?:item|result|file) (\d+)$/i.exec(name)
    const path = literal(name)
    const namedFile = path !== name || path.includes("/") || /\.[A-Za-z0-9]{1,12}$/.test(path) || / in Files[.!?]?$/i.test(command)
    if (position === null && !namedFile) return undefined
    const decoded = readOperation(position === null
      ? { type: "files_open", path } : { type: "files_open", shown: Number(position[1]) })?.operation
    return decoded?.type === "files_open" ? decoded : undefined
  }
  const filter = /^(?:show|find|filter)(?: me)? (.+?)\s*[!?]?$/i.exec(command)
  if (filter?.[1] === undefined) return undefined
  const terms = /^(.*?)(?: (?:matching|named|containing) ("[^"]+"|“[^”]+”|.+?))?(?: in ("[^"]+"|“[^”]+”|.+?))?(?: from (\S+))?(?: to (\S+))?$/i.exec(filter[1].replace(/\.$/, ""))
  if (terms === null) return undefined
  const [, kind, search, folder, from, to] = terms
  const item = kind?.toLowerCase()
  const category = Object.entries(fileFilterWords).find(([, names]) => names.some((name) => name === item))?.[0]
  if (category === undefined && item !== "files") return undefined
  const place = folder === undefined ? undefined : literal(folder)
  const decoded = readOperation({ type: "files_filter", ...(category === undefined ? {} : { kind: category }),
    ...(search === undefined ? {} : { text: literal(search) }), ...(place === undefined ? {} : { folder: place === "Internal storage" ? "" : place }),
    ...(from === undefined ? {} : { from }), ...(to === undefined ? {} : { to }) })?.operation
  return decoded?.type === "files_filter" ? decoded : undefined
}

function sameFileOperation(expected: DirectFilesOperation, actual: DeviceOperation): boolean {
  if (expected.type === "files_open" && actual.type === "files_open") {
    return "path" in expected ? "path" in actual && expected.path === actual.path : "shown" in actual && expected.shown === actual.shown
  }
  return expected.type === "files_filter" && actual.type === "files_filter" && expected.kind === actual.kind
    && expected.text === actual.text && expected.folder === actual.folder && expected.from === actual.from && expected.to === actual.to
}

export function sameFiles(before: FilesReadContext, after: FilesReadContext | undefined): boolean {
  if (after === undefined || before.listing !== after.listing || before.search !== after.search) return false
  const { where } = before
  const now = after.where
  return where.inCategory === now.inCategory && where.category === now.category && where.trail.length === now.trail.length
    && where.trail.every((one, index) => one === now.trail[index])
}

type ReplyAction = "Review" | "Direct" | "Conflicted"

/** The resident's review and direct-execution terminals bind distinct authorities to a fresh reply. */
function repliedDeviceActions(actions: DeviceActionReply["actionResults"]): ReadonlyMap<string, ReplyAction> {
  const kept = new Map<string, ReplyAction>()
  for (const { action, data } of actions) {
    if (action !== "PROPOSE_DEVICE_ACTION" || typeof data !== "object" || data === null
      || !("proposalId" in data) || typeof data.proposalId !== "string" || !/^[A-Za-z0-9_-]{1,128}$/.test(data.proposalId)
      || !("state" in data) || data.state !== "pending" || !("executed" in data) || data.executed !== false
      || !("approvalRequired" in data)) continue
    const direct = "directRequest" in data && data.directRequest === true
    const awaiting = "awaitingDeviceExecution" in data && data.awaitingDeviceExecution === true
    const input = "awaitingUserInput" in data && data.awaitingUserInput === true
    const kind = data.approvalRequired === true && input && !direct && !awaiting ? "Review"
      : data.approvalRequired === false && direct && awaiting && !input ? "Direct" : "Conflicted"
    const previous = kept.get(data.proposalId)
    kept.set(data.proposalId, previous === undefined || previous === kind ? kind : "Conflicted")
  }
  return kept
}

function fromThisEnrollment(proposal: Proposal, opened: Session): boolean {
  return proposal.payload.installationId === opened.identity.installationId && proposal.payload.enrollmentId === opened.identity.enrollmentId
}

function reviewFromReply(proposal: Proposal, opened: Session, actions: ReadonlyMap<string, ReplyAction>): boolean {
  return proposal.payload.requestMessageId === undefined && actions.get(proposal.id) === "Review" && fromThisEnrollment(proposal, opened)
}

export function namedReviewQuery(operation: DeviceOperation): string | undefined {
  if (operation.type !== "sms_compose" || !reviewedCompose(operation)) return phoneQuery(operation)
  const recipient = composeRecipient(operation)
  return recipient.kind === "contact" ? recipient.query.trim() : undefined
}

function commsReview(operation: DeviceOperation): boolean {
  switch (operation.type) {
    case "phone_keypad":
    case "sms_send": return true
    case "phone_dial":
    case "phone_call": return operation.target.kind === "number" || operation.target.kind === "contact"
    case "sms_compose": return reviewedCompose(operation)
    default: return false
  }
}

export interface MediaCard {
  readonly id: string
  readonly digest: string
  readonly expiresAt: number
  readonly operation: DeviceOperation
  readonly message: string
  readonly conversation: number
  readonly revision: number
  readonly enrollmentId: string
  readonly title: string
  readonly detail: string
  readonly target?: MessageDraftTarget
  readonly sms?: SmsSelection
  readonly files?: FileReview
  readonly reviewRequest?: string
  readonly phone?: NamedPhoneReview
}

function visibleCards(entries: readonly ({ card: MediaCard; fromTerminal: boolean } | undefined)[], terminalCurrent: boolean): readonly MediaCard[] {
  const firstRead = entries.find((entry) => entry?.card.operation.type === "messages_read_selected")?.card
  const visible: MediaCard[] = []
  for (const entry of entries) {
    if (entry === undefined || (entry.fromTerminal && !terminalCurrent)) continue
    if (entry.card.operation.type !== "messages_read_selected" || entry.card === firstRead) visible.push(entry.card)
  }
  return visible
}

interface Session {
  readonly epoch: number
  readonly identity: JournalIdentity
  readonly headers: RuntimeRequestHeaders
  readonly execute: DeviceExecution<DeviceOperation>
  readonly decide: DeviceAgent["decide"]
}

function operation(raw: unknown) {
  const checked = readOperation(raw)
  if (checked === undefined) return undefined
  const value = checked.operation
  switch (value.type) {
    case "phone_keypad":
    case "sms_reply_selected":
    case "sms_send":
    case "messages_read_selected":
      return value
    case "phone_dial":
    case "phone_call":
      return value.target.kind === "number" || value.target.kind === "contact" ? value : undefined
    case "sms_compose":
      return reviewedCompose(value) ? value : undefined
    case "camera_capture_photo":
    case "photos_filter":
    case "photos_open":
    case "photo_library_search":
    case "photo_library_inspect":
    case "photo_library_select":
    case "photo_library_review":
      return value
    case "files_filter":
    case "files_open":
    case "files_folder_create":
    case "browser_navigate":
    case "browser_tabs_show":
      return value
    case "photos_album_create":
    case "photos_share":
      return value.ids !== undefined && value.ids.length > 0 ? value : undefined
    case "files_share":
    case "files_move":
    case "files_trash":
      return value
    default:
      return notesOperation(value)
  }
}

function composeDetails(value: Extract<DeviceOperation, { type: "sms_compose" }>, recipient: string): string {
  const draftOnly = "draft" in value && value.draft === true
  return `${recipient}\n${value.body}${draftOnly ? "" : "\nTap Send in Messages when you’re ready."}`
}

function words(value: NonNullable<ReturnType<typeof operation>>): { title: string; detail: string } {
  switch (value.type) {
    case "notes_move":
    case "notes_folder_create":
    case "notes_restore": return notesOperationWords(value)
    case "phone_keypad": return { title: "Open the keypad", detail: value.number ?? "Phone" }
    case "phone_dial": return { title: "Open the phone dialer", detail: value.target.kind === "number" ? value.target.number : phoneQuery(value) ?? "Phone" }
    case "phone_call": return { title: "Call", detail: value.target.kind === "number" ? value.target.number : phoneQuery(value) ?? "Phone" }
    case "sms_reply_selected": return { title: "Draft a reply in Messages", detail: value.body }
    case "messages_read_selected": return { title: "Share open messages", detail: "Share up to 20 recent messages from the open conversation with the agent." }
    case "sms_send": return { title: "Review this text on your phone", detail: `${value.recipients.join(", ")}\n${value.body}\nConfirm the text and SIM in Android to send it.` }
    case "sms_compose": {
      const recipient = composeRecipient(value)
      const label = recipient.kind === "number" ? displayNumber(recipient.number) : recipient.query
      return { title: "Open an editable text draft", detail: composeDetails(value, label) }
    }
    case "camera_capture_photo": return { title: "Take a photo", detail: value.lens === undefined ? "Open the viewfinder to review the shot" : `Open the ${value.lens === "front" ? "front" : "rear"} camera to review the shot` }
    case "photos_filter": return { title: "Filter Photos", detail: value.text ?? "Show the requested photos in your library" }
    case "photos_open": return { title: "Open a photo", detail: "Show the requested item in Photos" }
    case "photo_library_search": return { title: "Read photo metadata", detail: "Find matching items in your permitted library" }
    case "photo_library_inspect": return { title: "Read photo details", detail: "Read the requested item’s metadata" }
    case "photo_library_select": return { title: "Select photos", detail: `Select ${value.ids.length} items in Photos` }
    case "photo_library_review": return { title: "Review photo changes", detail: `Review ${value.items.length} items in Photos` }
    case "photos_album_create": return { title: "Review a new album", detail: value.name }
    case "photos_share": return { title: "Review photos to share", detail: "Choose a destination in Photos" }
    case "files_filter": return { title: "Filter Files", detail: filterLabel(value) }
    case "files_open": return { title: "Open a file", detail: "path" in value ? value.path : `Item ${value.shown} in the current list` }
    case "files_folder_create": return { title: "Create a folder", detail: `${value.parent || "Internal storage"}/${value.name}` }
    case "files_share": return { title: "Share in Android", detail: "paths" in value ? value.paths.join(", ") : "Review the selected files" }
    case "files_move": return { title: "Move files", detail: "paths" in value ? `${value.paths.join(", ")} → ${value.dest || "Internal storage"}` : value.dest || "Internal storage" }
    case "files_trash": return { title: "Move to Trash", detail: "paths" in value ? value.paths.join(", ") : "Review the selected files" }
    case "browser_navigate": return { title: "Open a page in Browser", detail: value.url }
    case "browser_tabs_show": return { title: "Show your Browser tabs", detail: "Open the tab list" }
  }
}

/** Enrollment and the proposal protocol share the same live resident identity. */
export service MediaReview {
  session(): (Session | undefined)!!
  filesContext(): (FilesReadContext | undefined)!!
  spokenFiles(session: Session, message: string, request: DirectFiles, actions: DeviceActionReply["actionResults"]): boolean!!
  messageTarget(): (MessageDraftTarget | undefined)!!
  pending(session: Session, message: string, conversation: number, revision: number, target: MessageDraftTarget | undefined, reply: DeviceActionReply): readonly MediaCard[]!!Conversation
  choosePhone(card: MediaCard, choice: number): void!!(Talk | Conversation | Chats)
  /** The owner's answer on the card; `directly` runs an allow-listed card with no review, for the message being answered. */
  decide(card: MediaCard, approve: boolean, directly?: boolean): void!!(Talk | Conversation | Chats)
  /** Same enrollment and custody as the cards, without exposing its tokens or action payloads. */
  history(): (readonly ActivityProposal[] | undefined)!!
  /** Acts only against the exact current proposal and the local receipt the SDK can verify. */
  settle(proposal: string, action: "decline" | "happened" | "did-not-happen"): boolean!!
}

function routes(runtime: Runtime, headers: RuntimeRequestHeaders): DeviceAgent {
  const post = (id: string, step: string, body: unknown) => runtime.request(`${prefix}/proposals/${encodeURIComponent(id)}/${step}`, body, headers)
  return {
    decide: (id, body) => post(id, "decision", { digest: body.digest, decision: body.approved ? "approve" : "reject" }),
    claim: async (id, body) => {
      const raw = await post(id, "claim", { digest: body.digest });
      const decoded = Schema.decodeUnknownOption(claim)(raw);
      if (Option.isNone(decoded) || decoded.value.digest !== body.digest) throw new Error("Claim refused");
      return { attemptId: 1, agentAttemptId: decoded.value.proposal.execution.attemptId };
    },
    receipt: (id, body) => post(id, "receipt", {
      digest: body.digest, attemptId: body.agentAttemptId,
      receipt: { outcome: body.receipt.reported, operationId: body.receipt.operationId, code: body.receipt.code, result: body.receipt.result },
    }),
    reconcile: (id, body) => post(id, "reconciliation", { digest: body.digest, attemptId: body.agentAttemptId, review: body.review, applied: body.applied }),
  }
}

error EnrollmentRefused { reason: string }

type Action = (op: DeviceOperation, call: ExecutorCall) => Promise<unknown>

effect function enrolled(epoch: number, owner: string, image: boolean, runtime: Runtime, executeAction: Action, readBack: Action): Session!unknown {
  const offer = try Schema.decodeUnknownEffect(protocol)(try tryPromise(() => runtime.request(`${prefix}/capabilities`)))
  if (offer.agentId !== owner) throw new EnrollmentRefused({ reason: "Device agent changed" })
  const origin = "https://device.alpha.invalid"
  const slot = try tryPromise(() => slotFor([origin, owner, offer.agentId]))
  const { key } = try tryPromise(() => enrollment().enrollmentKey({ slot }))
  if (!/^[a-f0-9]{64}$/.test(key)) throw new EnrollmentRefused({ reason: "Invalid enrollment key" })
  const capabilities = [
    ...(registered("ElizaCamera") ? cameraCapabilities : []),
    ...(registered("AlphaPhotoLibrary") ? photosCapabilities : []),
    ...(registered("ElizaFiles") ? filesCapabilities : []),
    ...(registered("AlphaNotes") ? ["notes.organize.v1"] : []),
    ...(registered("AlphaBrowser") ? browserCapabilities : []),
    ...(image && registered("ElizaTelephony") ? phoneCapabilities : []),
  ].filter((name) => offer.deviceActions.capabilities.includes(name))
  if (capabilities.length === 0) throw new EnrollmentRefused({ reason: "Media operations are unavailable" })
  const headers = { "x-eliza-device-id": offer.agentId, "x-eliza-device-key": key, "x-eliza-device-capabilities": capabilities.join(",") }
  let raw = tryPromise(() => runtime.request(`${prefix}/context`, undefined, headers)) catch () => undefined
  if (raw === undefined) {
    const answer = try Schema.decodeUnknownEffect(registration)(try tryPromise(() => runtime.request(`${prefix}/register`, { label: "Alpha Phone", capabilities }, headers)))
    if (answer.installationId !== offer.agentId) throw new EnrollmentRefused({ reason: "Another installation answered" })
    raw = try tryPromise(() => runtime.request(`${prefix}/context`, undefined, headers))
  }
  const confirmed = try Schema.decodeUnknownEffect(context)(raw)
  if (confirmed.subjectUserId !== offer.identityId || confirmed.agentId !== offer.agentId || confirmed.installationId !== offer.agentId) throw new EnrollmentRefused({ reason: "Device scope changed" })
  const identity = { origin, ownerId: owner, ...confirmed }
  const agent = routes(runtime, headers)
  const execute = new DeviceExecution<DeviceOperation>({
    identity, agent, journal: journal(), validate: operation,
    execute: executeAction,
    readBack,
  })
  return { epoch, identity, headers, execute, decide: agent.decide }
}

function filesCompletion(outcome: FileActionReport, synced: boolean): string {
  const pending = synced ? "" : " Agent receipt pending."
  if (outcome.kind === "Filter") {
    const count = `${outcome.count} ${outcome.count === 1 ? "item" : "items"}`
    return (outcome.complete ? `Showing ${count} in Files.` : `Files could not finish this search. Showing ${count} from the folders read.`) + pending
  }
  const destination = outcome.kind === "Trash" ? " to Trash" : ""
  return `Moved ${outcome.done} of ${outcome.requested}${destination}.${pending}`
}

function completion(op: DeviceOperation, synced: boolean): string {
  switch (op.type) {
    case "sms_send": return synced ? "Android accepted the text request." : "Android accepted the text request. Agent receipt pending."
    case "sms_compose": return synced ? "Your editable draft is ready in Messages." : "Your draft is ready in Messages. Agent receipt pending."
    case "messages_read_selected": return synced ? "Shared the open messages with the agent." : "Open messages prepared. Agent receipt pending."
    case "photos_album_create":
    case "photos_share":
    case "photo_library_review": return "Continue the review in Photos."
    case "files_share": return "Choose where to share in Android."
    case "files_move":
    case "files_trash": return synced ? "Files shows which items changed." : "Files shows which items changed. Agent receipt pending."
    default: return synced ? "Done" : "Done. Agent receipt pending."
  }
}

// spec/app/approvals/direct.md, "The agent runs directly only what is on the allow-list, for the message being answered, at most four times, by the owner's choice and on a screen that is not protected"
/** A proposal the agent may run without a card for the message being answered: showing the Browser's own tab list, which changes nothing. */
export const direct = (card: MediaCard): boolean => card.operation.type === "browser_tabs_show" && card.reviewRequest === undefined

const notStarted = "Alpha couldn’t start that action."
const sameTarget = (one: MessageDraftTarget | undefined, other: MessageDraftTarget | undefined): boolean =>
  one !== undefined && other !== undefined && one.thread === other.thread && one.ticket === other.ticket

export const mediaReview = Layer.effect(MediaReview, effect {
  const agent = try Agent
  const { runtime, life } = agent
  const executors = try MediaExecutors
  const device = try Device
  const telephony = try Telephony
  const messages = try Messages
  const shell = try Shell
  const layers = try Layers.Machine
  const preferences = try Prefs.Machine
  const smsContext = try Effect.context<SmsSelectionContext>()
  const sameSms = (selection: SmsSelection) => Effect.provideContext(currentSmsSelection(selection), smsContext)
  const lock = try Semaphore.make(1)
  let latest: Session | undefined
  const scopes = new Map<string, ApprovalScope>()
  const pinnedFiles = new Map<string, { readonly digest: string; readonly files: FileReview; readonly expiresAt: number }>()
  const guarded = (operation: DeviceOperation, call: ExecutorCall) => runPromise(effect {
    const scope = scopes.get(call.proposalId)
    if (scope === undefined || !(try scope.active)) return { kind: "refused", code: NOT_DISPATCHED }
    const continueDraft = scope.continueDraft
    return try executors.execute(operation, call, { current: () => runPromise(scope.active), ...(scope.target === undefined ? {} : { target: scope.target }),
      ...(continueDraft === undefined ? {} : { continueDraft: () => runPromise(continueDraft) }),
      ...(scope.sms === undefined ? {} : { sms: scope.sms }), ...(scope.files === undefined ? {} : { files: scope.files }),
      ...(scope.reportFiles === undefined ? {} : { reportFiles: scope.reportFiles }), ...(scope.phone === undefined ? {} : { phone: scope.phone }) })
  })
  const readBack = (operation: DeviceOperation, call: ExecutorCall) => operation.type === "sms_send"
    ? runPromise(readAgentSms(operation, call) |> Effect.provideService(%, Device, device) |> Effect.provideService(%, Telephony, telephony))
    : Promise.resolve(undefined)
  // spec/app/files/index.md, "An explicit request to open or filter Files may act directly on the same idle Files view"
  effect function filesContext(): (FilesReadContext | undefined)!! {
    const prefs = try preferences.get()
    if (!Prefs.free(prefs) || Prefs.asksBeforeActing(prefs, "FilesAction")
      || !(try device.showing()) || !showing(try shell.get(), "Files") || Layers.pageInert(try layers.get())) return undefined
    return try executors.filesContext()
  }
  effect function messageTarget(): (MessageDraftTarget | undefined)!! {
    if (!(try device.showing()) || !showing(try shell.get(), "Messages")) return undefined
    const state = try messages.get()
    return state.front && state.pane === "Conversation" && state.page.status === "Loaded" && state.sms.grant === "Granted" ? { thread: state.thread, ticket: state.page.ticket } : undefined
  }
  effect function session(): (Session | undefined)!! {
    if (!registered("AlphaMediaEnrollment") || !registered("ElizaActionJournal")) return undefined
    const status = life.status() catch () => undefined
    if (status?.state !== "running") { latest = undefined; pinnedFiles.clear(); return undefined }
    if (latest?.epoch === status.epoch) return latest
    pinnedFiles.clear()
    const owner = Effect.provideService(ownerAt(), Agent, agent) catch () => undefined
    const { image } = try device.capabilities()
    latest = owner === undefined ? undefined : (enrolled(status.epoch, owner, image, runtime, guarded, readBack) catch () => undefined)
    const fresh = latest
    if (fresh !== undefined) try ignore(tryPromise(() => fresh.execute.sync()))
    return latest
  }
  effect function proposals(opened: Session): (readonly Proposal[] | undefined)!! {
    const answer = (tryPromise(() => runtime.request(`${prefix}/proposals`, undefined, opened.headers)) |> flatMap(%, Schema.decodeUnknownEffect(listed))) catch () => undefined
    if (answer === undefined || opened !== latest) return undefined
    return answer.proposals
  }
  effect function enrollmentIsCurrent(opened: Session): boolean!! {
    const status = life.status() catch () => undefined
    const owner = Effect.provideService(ownerAt(), Agent, agent) catch () => ""
    const front = (tryPromise(() => enrollment().authority()) |> map(%, (one) => one.active === true)) catch () => false
    return status?.state === "running" && status.epoch === opened.epoch && owner === opened.identity.ownerId && front && (try device.showing())
  }
  effect function reviewContext(revision: number, conversation: Conversation.Shape): boolean!! {
    const showing = (try conversation.get()).context
    const { assistant } = try shell.get()
    return showing.revision === revision && !showing.sensitive && (assistant === "Sheet" || assistant === "Full") && (try device.showing())
  }
  effect function actOnFiles(opened: Session, card: DirectFilesTarget, request: DirectFiles): boolean!! {
    return try lock.withPermits(1)(effect {
      const matching = effect {
        return opened === latest && (try request.current)
          && (try Clock.currentTimeMillis) < card.expiresAt && sameFiles(request.files, try filesContext())
      }
      const active = effect { return (try matching) && (try enrollmentIsCurrent(opened)) && (try matching) }
      if (!(try active)) return false
      const { id, digest, expiresAt, operation } = card
      const checked = readOperation(operation)
      const requestEligible = checked !== undefined && mayRunDirectly(checked, "NoBinding", true)
      const forceReview = Prefs.asksBeforeActing(try preferences.get(), "FilesAction")
      if (!requestEligible || forceReview) return false
      let filesOutcome: FileActionReport | undefined
      scopes.set(id, { active, reportFiles: (outcome) => { filesOutcome = outcome }, ...(card.files === undefined ? {} : { files: card.files }) })
      const done = (tryPromise(() => opened.execute.approve({ id, digest, expiresAt, operation }, {
          live: true, nonsensitive: true, exact: true, forceReview, requestEligible, reviewed: false,
        })) |> ensuring(%, sync(() => { scopes.delete(id) }))) catch () => undefined
      if (done?.kind === "noAuthority" || done?.kind === "invalid") return false
      if (try request.current) {
        const note = done?.kind !== "settled" ? notStarted
          : done.result.tag === "Unknown" ? "The result could not be confirmed. Check before trying again."
          : filesOutcome !== undefined ? filesCompletion(filesOutcome, done.synced)
          : done.result.tag === "Applied" ? done.synced ? "Opened the requested item in Files." : "Opened the requested item in Files. Agent receipt pending."
          : "Nothing changed."
        request.report(note)
      }
      return true
    })
  }
  effect function hasReceipt(opened: Session, proposal: Proposal): boolean!! {
    if (proposal.execution === undefined) return false
    const decoded = (tryPromise(() => journal().get(proposal.id)) |> flatMap(%, Schema.decodeUnknownEffect(journalBinding))) catch () => undefined
    if (decoded === undefined) return false
    const { identity } = opened
    return decoded.proposalId === proposal.id && decoded.digest === proposal.digest && decoded.ownerId === identity.ownerId
      && decoded.agentId === identity.agentId && decoded.origin === identity.origin && decoded.installationId === identity.installationId
      && decoded.enrollmentId === identity.enrollmentId && decoded.agentAttemptId === proposal.execution.attemptId
  }
  const readyToDecline = (proposal: Proposal, at: number) => proposal.state === "pending" && Date.parse(proposal.expiresAt) > at
  const toSettle = (proposal: Proposal) => proposal.state === "executing" || proposal.state === "reconciliation_required"
  effect function recoverText(opened: Session, proposal: Proposal) {
    const attempt = proposal.execution?.attemptId
    if (attempt === undefined || !(try enrollmentIsCurrent(opened))) return undefined
    const recovered = tryPromise(() => opened.execute.recover(proposal.id, { attemptId: 1, agentAttemptId: attempt })) catch () => undefined
    return recovered?.kind === "settled" && recovered.synced && recovered.result.tag !== "Unknown"
      ? recovered.result.tag === "Applied" ? "Phone confirmed the text request" : "The phone did not send the text"
      : undefined
  }
  return {
    session,
    effect history() {
      const opened = try session()
      if (opened === undefined || !(try enrollmentIsCurrent(opened))) return undefined
      const answer = try proposals(opened)
      if (answer === undefined) return undefined
      const at = try Clock.currentTimeMillis
      const rows = try Effect.forEach(answer, effect (proposal) => {
        if (proposal.payload.workflow !== undefined) return undefined
        const outcome = outcomes[proposal.state]
        if (outcome === undefined) return undefined
        const visible = operation(proposal.payload.operation)
        const labelled = visible === undefined ? { title: "Phone action", detail: "" } : words(visible)
        const unsettled = toSettle(proposal) && (try hasReceipt(opened, proposal))
        const text = visible?.type === "sms_send"
        const recovered = text && unsettled ? try recoverText(opened, proposal) : undefined
        return { proposal: proposal.id, ...labelled, outcome: recovered ?? outcome, declinable: readyToDecline(proposal, at), unsettled: unsettled && !text }
      }, { concurrency: 4 })
      if (!(try enrollmentIsCurrent(opened))) return undefined
      return rows.filter((row) => row !== undefined)
    },
    effect settle(id, action) {
      return try lock.withPermits(1)(effect {
        const opened = try session()
        if (opened === undefined || !(try enrollmentIsCurrent(opened))) return false
        const found = (try proposals(opened))?.find((proposal) => proposal.id === id && proposal.payload.workflow === undefined)
        if (found === undefined || !(try enrollmentIsCurrent(opened))) return false
        if (action === "decline") {
          if (!readyToDecline(found, try Clock.currentTimeMillis)) return false
          const result = tryPromise(() => opened.decide(found.id, { digest: found.digest, approved: false })) catch () => undefined
          return result !== undefined
        }
        if (!toSettle(found) || !(try hasReceipt(opened, found))) return false
        if (operation(found.payload.operation)?.type === "sms_send") return (try recoverText(opened, found)) !== undefined
        const result = tryPromise(() => opened.execute.confirmReview(found.id, action === "happened" ? "ReviewedApplied" : "ReviewedNotApplied")) catch () => "refused"
        return result === "sent"
      })
    },
    messageTarget,
    filesContext,
    effect spokenFiles(opened, message, request, results) {
      const actions = repliedDeviceActions(results)
      if (![...actions.values()].some((action) => action === "Direct") || !(try request.current)) return false
      const answer = try proposals(opened)
      const at = try Clock.currentTimeMillis
      const matching = answer?.filter((proposal) => proposal.state === "pending" && proposal.payload.workflow === undefined
        && proposal.payload.requestMessageId === message && actions.get(proposal.id) === "Direct" && fromThisEnrollment(proposal, opened)
        && Date.parse(proposal.expiresAt) > at)
      if (matching === undefined || matching.length !== 1) return false
      const offer = matching[0]
      if (offer === undefined) return false
      const exact = readOperation(offer.payload.operation)
      if (exact === undefined || !sameFileOperation(request.operation, exact.operation) || !mayRunDirectly(exact, "NoBinding", true)) return false
      const op = exact.operation
      const files = op.type === "files_open" ? try executors.reviewFiles(op) : undefined
      if (op.type === "files_open" && files === undefined) return false
      return try actOnFiles(opened, { id: offer.id, digest: offer.digest, expiresAt: Date.parse(offer.expiresAt), operation: op,
        ...(files === undefined ? {} : { files }) }, request)
    },
    effect pending(opened: Session, message: string, conversation: number, revision: number, target: MessageDraftTarget | undefined, reply: DeviceActionReply) {
      const view = try Conversation
      const answer = try proposals(opened)
      if (answer === undefined) return []
      const bound = sameTarget(target, try messageTarget()) ? target : undefined
      const actions = repliedDeviceActions(reply.actionResults)
      const currentReview = answer.some((proposal) => reviewFromReply(proposal, opened, actions)) && (try reviewContext(revision, view))
        && (try enrollmentIsCurrent(opened)) && opened === latest && (try reviewContext(revision, view))
      const at = try Clock.currentTimeMillis
      for (const [id, pin] of pinnedFiles) if (pin.expiresAt <= at) pinnedFiles.delete(id)
      const cards = try Effect.forEach(answer, effect (proposal) => {
        if (proposal.state !== "pending" || proposal.payload.workflow !== undefined) return undefined
        const op = operation(proposal.payload.operation)
        const expiresAt = Date.parse(proposal.expiresAt)
        if (op === undefined || !Number.isFinite(expiresAt) || expiresAt <= at) return undefined
        const filesOperation = op.type.startsWith("files_")
        const request = proposal.payload.requestMessageId
        if (request === undefined) {
          if (!(commsReview(op) || filesOperation) || !currentReview || !reviewFromReply(proposal, opened, actions)) return undefined
        } else if (request !== message || (filesOperation && (!fromThisEnrollment(proposal, opened)
          || (actions.get(proposal.id) !== "Review" && actions.get(proposal.id) !== "Direct")))) return undefined
        const selected = needsMessage(op)
        if (selected && bound === undefined) return undefined
        const sms = op.type === "sms_send" ? reply.sms?.selection : undefined
        if (op.type === "sms_send" && reply.sms !== undefined && (sms === undefined || sms.subscription.id !== op.subscriptionId || !(try sameSms(sms)))) return undefined
        const named = op.type === "files_open" || op.type === "files_share" || op.type === "files_move" || op.type === "files_trash" || op.type === "files_folder_create"
        let files: FileReview | undefined
        if (named) {
          const existing = pinnedFiles.get(proposal.id)
          if (existing !== undefined && existing.digest !== proposal.digest) return undefined
          const resolved = existing?.files ?? (try executors.reviewFiles(op))
          if (opened !== latest) return undefined
          const held = pinnedFiles.get(proposal.id)
          if (held !== undefined && held.digest !== proposal.digest) return undefined
          if (held === undefined && resolved !== undefined && pinnedFiles.size < 256) {
            pinnedFiles.set(proposal.id, { digest: proposal.digest, files: resolved, expiresAt })
          }
          files = pinnedFiles.get(proposal.id)?.files
          if (files === undefined) return undefined
        }
        const detail = words(op)
        const labelled = sms === undefined ? detail : { ...detail, detail: `SIM ${sms.subscription.slot + 1}\n${detail.detail}` }
        const query = namedReviewQuery(op)
        if (query !== undefined && (!(try reviewContext(revision, view)) || !(try enrollmentIsCurrent(opened)) || !(try reviewContext(revision, view)))) return undefined
        const phone = query === undefined ? undefined : try Effect.provideService(phoneContactChoices(query), Telephony, telephony)
        if (phone !== undefined && (opened !== latest || !(try reviewContext(revision, view)))) return undefined
        const card: MediaCard = { id: proposal.id, digest: proposal.digest, operation: op, expiresAt, message, conversation, revision, enrollmentId: opened.identity.enrollmentId, ...labelled,
          ...(selected && bound !== undefined ? { target: bound } : {}),
          ...(sms === undefined ? {} : { sms }),
          ...(request === undefined || filesOperation || phone !== undefined || op.type === "sms_compose" ? { reviewRequest: reply.clientMessageId } : {}),
          ...(phone === undefined ? {} : { phone }),
          ...(files === undefined ? {} : { files, detail: op.type === "files_folder_create" ? labelled.detail : files.targets.map((target) => target.path).join(", ")
            + (op.type === "files_move" ? ` → ${op.dest || "Internal storage"}` : "") }) }
        return { card, fromTerminal: request === undefined }
      }, { concurrency: 4 })
      const visible = visibleCards(cards, currentReview && opened === latest && (try reviewContext(revision, view)))
      const owner = reply.directFiles
      if (owner === undefined || !(try owner.current)) return visible
      const direct = visible.find((card) => {
        const proposal = answer.find((one) => one.id === card.id)
        if (proposal?.payload.requestMessageId !== message || actions.get(card.id) !== "Direct"
          || !fromThisEnrollment(proposal, opened) || !sameFileOperation(owner.operation, card.operation)) return false
        const exact = readOperation(proposal.payload.operation)
        return exact !== undefined && mayRunDirectly(exact, "NoBinding", true)
      })
      if (direct === undefined) return visible
      const current = effect { return (try owner.current) && (try reviewContext(revision, view)) }
      return (try actOnFiles(opened, direct, { ...owner, current })) ? visible.filter((card) => card !== direct) : visible
    },
    effect choosePhone(card: MediaCard, choice: number) {
      const { board } = try Talk
      const view = try Conversation
      const chats = try Chats
      const option = card.phone?.tag === "Choices" ? card.phone.options[choice] : undefined
      const query = namedReviewQuery(card.operation)
      if (option === undefined || query === undefined) return
      effect function shown(opened: Session): boolean!! {
        const time = try Clock.currentTimeMillis
        return opened === latest && card.enrollmentId === opened.identity.enrollmentId
          && board.snapshot().media.includes(card) && card.conversation === (try chats.get()).chosen
          && card.reviewRequest === board.lastSentId && time < card.expiresAt && (try reviewContext(card.revision, view))
      }
      try lock.withPermits(1)(effect {
        const opened = try session()
        if (opened === undefined || !(try shown(opened)) || !(try enrollmentIsCurrent(opened)) || !(try shown(opened))) return
        const phone = try Effect.provideService(pickPhoneContact(query, option), Telephony, telephony)
        if (!(try enrollmentIsCurrent(opened)) || !(try shown(opened))) return
        let detail = card.detail
        if (phone.tag === "Exact") {
          const identity = `${phone.selected.name} · ${displayNumber(phone.selected.number)}`
          detail = card.operation.type === "sms_compose" ? composeDetails(card.operation, identity) : identity
        }
        board.change({ media: board.snapshot().media.map((one) => one === card ? { ...card, phone, detail } : one) })
      })
    },
    effect decide(card: MediaCard, approve: boolean, directly = false) {
      const { board } = try Talk
      const conversation = try Conversation
      const chats = try Chats
      effect function matches(session: Session): boolean!! {
        const showing = (try conversation.get()).context
        const chosen = (try chats.get()).chosen
        const time = try Clock.currentTimeMillis
        if (session !== latest || (card.target !== undefined && !sameTarget(card.target, try messageTarget())) || (card.sms !== undefined && !(try sameSms(card.sms)))
          || card.enrollmentId !== session.identity.enrollmentId || card.conversation !== chosen
          || card.revision !== showing.revision || showing.sensitive || time >= card.expiresAt) return false
        return card.reviewRequest === undefined || (board.lastSentId === card.reviewRequest && (try reviewContext(card.revision, conversation)))
      }
      effect function current(session: Session): boolean!! {
        return (try matches(session)) && (try enrollmentIsCurrent(session)) && (try matches(session))
      }
      effect function canStage(session: Session): boolean!! {
        const context = (try conversation.get()).context
        const where = try shell.get()
        return session === latest && card.enrollmentId === session.identity.enrollmentId && card.conversation === (try chats.get()).chosen
          && card.reviewRequest !== undefined && card.reviewRequest === board.lastSentId && !context.sensitive && (try Clock.currentTimeMillis) < card.expiresAt
          && showing(where, "Messages") && (where.assistant === "Sheet" || where.assistant === "Full") && (try device.showing())
      }
      effect function continueDraft(session: Session): boolean!! {
        return (try canStage(session)) && (try enrollmentIsCurrent(session)) && (try canStage(session))
      }
      try lock.withPermits(1)(effect {
        const unasked = directly && approve && direct(card)
        if ((!unasked && !board.snapshot().media.includes(card)) || (approve && namedReviewQuery(card.operation) !== undefined && card.phone?.tag !== "Exact")) return
        const held = try session()
        const live = held !== undefined && (try current(held))
        if (card.phone !== undefined && !board.snapshot().media.includes(card)) return
        board.change({ media: board.snapshot().media.filter((one) => one !== card) })
        const report = (text: string) => { if (!unasked) board.change({ mediaNote: { conversation: card.conversation, text } }) }
        if (!live || held === undefined) { report("That review expired. Ask again from the current screen."); return }
        if (!approve) {
          const declined = tryPromise(() => held.decide(card.id, { digest: card.digest, approved: false })) catch () => undefined
          report(declined === undefined ? "Alpha couldn’t confirm the decline." : "Declined")
          return
        }
        let filesOutcome: FileActionReport | undefined
        scopes.set(card.id, { active: current(held), reportFiles: (outcome) => { filesOutcome = outcome }, ...(card.operation.type === "sms_compose" ? { continueDraft: continueDraft(held) } : {}), ...(card.target === undefined ? {} : { target: card.target }), ...(card.files === undefined ? {} : { files: card.files }),
          ...(card.sms === undefined ? {} : { sms: card.sms }), ...(card.phone?.tag === "Exact" ? { phone: card.phone.selected } : {}) })
        const { id, digest, expiresAt, operation } = card
        const screen = unasked ? { forceReview: false, reviewed: false } : { forceReview: true, reviewed: true }
        const result = (tryPromise(() => held.execute.approve({ id, digest, expiresAt, operation }, { live: true, nonsensitive: true, exact: true, requestEligible: true, ...screen }))
          |> ensuring(%, sync(() => { scopes.delete(card.id) }))) catch () => undefined
        const note = result?.kind !== "settled" ? notStarted
          : result.result.tag === "Unknown" ? "The result could not be confirmed. Check before trying again."
          : filesOutcome !== undefined ? filesCompletion(filesOutcome, result.synced)
          : result.result.tag === "Applied" ? completion(card.operation, result.synced) : "Nothing changed."
        report(note)
      })
    },
  }
})
