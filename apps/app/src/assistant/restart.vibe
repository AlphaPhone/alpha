// spec/assistant/recovery.md, "Story: Restart my agent when it stopped for review"; spec/assistant/recovery.md, "Restart is offered only while the resident is refused and holds a reviewable recovery, once per tap"
import { restartOffered, restartRuns } from "../../gen/assistant__recovery.effect.vibe"
import { ResidentControl, ResidentRecovery } from "../platform/resident-control.vibe"
import { AssistantHost } from "./host.vibe"
import { copy } from "./presentation.vibe"

/** The composer's guarded restart of an agent the service holds for review. */
export service AgentRestart {
  /** Whether Restart Alpha is offered now, then each change of it. */
  readonly offered: Stream.Stream<boolean>
  /** Whether a restart is running now, then each change of it. */
  readonly busy: Stream.Stream<boolean>
  /** Archive what the service kept and start the agent again; false when it is not offered, the assistant is not in front, nothing is held or the restart failed. */
  restart(): boolean!!
}

/** The restart offer over the resident connection and the agent service's recovery review. */
export const restartLayer = Layer.effect(AgentRestart, effect {
  const control = try ResidentControl
  const recovery = try ResidentRecovery
  const host = try AssistantHost
  const shown = try SubscriptionRef.make(false)
  const running = try SubscriptionRef.make(false)
  let refused = false
  effect function offer() {
    const restarting = try SubscriptionRef.get(running)
    const held = refused && !restarting ? try recovery.review() : { reviewable: false as const }
    try SubscriptionRef.set(shown, restartOffered(refused, held.reviewable, restarting))
  }
  fork.scoped (effect {
    for try (const connection of control.changes) {
      refused = connection.phase === "Refused"
      try offer()
    }
  })
  return {
    offered: SubscriptionRef.changes(shown),
    busy: SubscriptionRef.changes(running),
    restart: () => effect {
      const visible = !(try host.screen()).exposure.hidden
      if (!restartRuns(try SubscriptionRef.get(shown), visible)) return false
      const held = try recovery.review()
      if (!held.reviewable) {
        try offer()
        return false
      }
      try SubscriptionRef.set(running, true)
      try offer()
      const done = map(recovery.restart(held.reviewToken), () => true) catch () => false
      try SubscriptionRef.set(running, false)
      if (!done) try host.toast(copy.restartFailed)
      try offer()
      return done
    },
  }
})
