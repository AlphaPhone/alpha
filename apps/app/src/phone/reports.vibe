// spec/app/phone/index.md, "The phone reports missed calls not yet seen"; spec/app/phone/index.md, "The Voicemail tab is offered only while the carrier's visual voicemail is ready"; spec/app/messages/index.md, "The phone reports how many conversations are unread, for the list and Home"; spec/app/phone/voicemail.md, "The phone reports how many voicemails are unheard, for Home and the tab"
import { Machine as Messages } from "../../gen/app__messages.effect.vibe"
import type { Row } from "../../gen/app__home__cards.effect.vibe"
import { Conversations } from "../messages/messages.vibe"
import { Machine as Phone } from "../../gen/app__phone.effect.vibe"
import { Machine as Voicemail } from "../../gen/app__phone__voicemail.effect.vibe"
import { Machine as Shell } from "../../gen/app__shell.effect.vibe"
import { Device } from "../platform/device.vibe"
import { type Telephony, namesOf, telephony } from "../platform/telephony.vibe"
import { fromAreas } from "../home/cards.vibe"
import { waiting } from "../home/waiting.vibe"
import { applying, contained, started, together } from "../runtime/reactor.vibe"
import { recentsLimit } from "./phone.vibe"
import { clockLength, displayNumber } from "./words.ts"

/** Who called, as Home's Phone card names them: the contact's name, the name the phone cached, or the number. */
const caller = (row: { readonly cachedName: string | null; readonly number: string }, names: ReadonlyMap<string, string>): string =>
  row.number === "" ? "Unknown" : names.get(row.number) ?? (row.cachedName || displayNumber(row.number))

/** The new missed calls grouped by caller, then the unheard voicemail, newest first, as Home's Phone card rows. */
function phoneRows(
  missed: ReadonlyArray<{ readonly cachedName: string | null; readonly number: string; readonly date: number }>,
  unheard: ReadonlyArray<{ readonly cachedName: string | null; readonly number: string; readonly date: number; readonly durationSeconds: number }>,
  names: ReadonlyMap<string, string>,
): Array<Row & { readonly date: number }> {
  const groups = new Map<string, { title: string; count: number; date: number }>()
  for (const call of missed) {
    const key = call.number === "" ? `unknown:${call.date}` : call.number
    const group = groups.get(key)
    if (group === undefined) groups.set(key, { title: caller(call, names), count: 1, date: call.date })
    else groups.set(key, { ...group, count: group.count + 1, date: Math.max(group.date, call.date) })
  }
  return [
    ...[...groups.values()].map((group) => ({ date: group.date, title: group.title, detail: group.count > 1 ? `Missed · ${group.count}` : "Missed" })),
    ...unheard.map((one) => ({ date: one.date, title: caller(one, names), detail: `Voicemail · ${clockLength(one.durationSeconds)}` })),
  ].sort((a, b) => b.date - a.date)
}

// spec/app/home/cards.md, "The Messages and Phone cards show their waiting rows, only on an Alpha image, and are not drawn without a row"
/** The phone's existing native reports are the source of both the counts and the Home card rows. */
effect function report(): void!!(Telephony | Phone | Messages | Voicemail) {
  const calls = telephony("recentCalls", (c) => c.phone.recentCalls({ limit: recentsLimit })) catch () => undefined
  const missed = calls?.calls.filter((call) => call.type === "missed" && call.isNew)
  const threads = telephony("threadPage", (c) => c.messages.threadPage()) catch () => undefined
  const unread = threads?.rows.flatMap((row) => "incomplete" in row || !row.unread ? [] : [row]).sort((a, b) => b.date - a.date)
  const listing = telephony("refreshVoicemail", (c) => c.phone.refreshVoicemail("AutomaticRead")) catch () => undefined
  const unheard = listing?.carrier === "CarrierReady" ? listing.voicemails.filter((one) => !one.heard) : undefined
  if (unread !== undefined) {
    const names = try namesOf("messages", unread.flatMap((row) => row.addresses))
    fromAreas.messages(
      unread.slice(0, 2).map((row) => ({ title: row.addresses.map((address) => names.get(address) ?? displayNumber(address)).join(", ") || "Unknown", detail: row.snippet })),
      unread.length, unread[0]?.date ?? 0,
    )
  }
  if (missed !== undefined || unheard !== undefined) {
    const names = try namesOf("phone", [...(missed ?? []), ...(unheard ?? [])].map((row) => row.number))
    const rows = phoneRows(missed ?? [], unheard ?? [], names)
    const missedCount = missed?.length ?? 0
    const unheardCount = unheard?.length ?? 0
    const said = [missedCount > 0 ? `${missedCount} missed ${missedCount === 1 ? "call" : "calls"}` : "", unheardCount > 0 ? `${unheardCount} voicemail` : ""]
      .filter((part) => part !== "").join(", ")
    fromAreas.phone(rows.slice(0, 2).map(({ title, detail }) => ({ title, detail })), missedCount + unheardCount, rows[0]?.date ?? 0, said)
  }
  if (missed !== undefined) try contained((try Phone).send({ type: "missedReported", count: missed.length }), "missed calls")
  if (unread !== undefined) try contained((try Messages).send({ type: "unreadReported", count: unread.length }), "unread conversations")
  if (listing !== undefined) try contained((try Phone).send({ type: "voicemailReported", ready: listing.carrier === "CarrierReady" }), "visual voicemail")
  if (unheard !== undefined) try contained((try Voicemail).send({ type: "unheardReported", count: unheard.length }), "unheard voicemail")
}

const reporting = started(effect {
  const shell = try Shell
  const device = try Device
  const visible = Stream.concat(Stream.succeed(true), device.visible)
  const home = Stream.map(Stream.zipLatest(Stream.map(shell.changes, (where) => where.trail.length === 0), visible), ([bare, seen]) => bare && seen)
  try Stream.runForEach(Stream.changesWith(home, (a, b) => a === b), effect (shown) => {
    if (shown) try report()
  })
}, "the phone's counts for Home")

// spec/app/home/tiles.md, "Only Phone, Messages and Inbox carry a badge, only when something waits there, and no tile does while Home is being edited"
const messageBadge = applying(Messages, (state) => state.unread, (unread) => sync(() => waiting.tell("Messages", unread > 0 ? `${unread} unread` : undefined)))

const phoneBadge = started(effect {
  const calls = Stream.map((try Phone).changes, (state) => ({ missed: state.missed, ready: state.voicemail }))
  const voicemails = Stream.map((try Voicemail).changes, (state) => state.unheard)
  const badge = Stream.map(Stream.zipLatest(calls, voicemails), ([phone, unheard]) => phone.ready && unheard > 0 ? `${unheard} unheard` : undefined)
  try Stream.runForEach(Stream.changes(badge), (said) => sync(() => waiting.tell("Phone", said)))
}, "badging Home's Phone tile")

/** Refresh Home's cards on foreground, and track the badges from the owning machines. */
export const reports = together(reporting, messageBadge, phoneBadge)

// spec/app/phone/index.md, "One tap on the card opens Recents with the missed calls, and otherwise the Voicemail tab while a voicemail is unheard"
/** Home's calls card, tapped: Phone opens on Recents with the missed calls, or else on the Voicemail tab. */
export effect function openCalls(): void!!(Phone | Voicemail | Shell) {
  const phone = try Phone
  const missed = (try phone.get()).missed
  const unheard = (try (try Voicemail).get()).unheard
  try contained(phone.send(missed > 0 ? { type: "openMissed" } : { type: "openVoicemail", unheard }), "the calls card")
  try contained((try Shell).send({ type: "openView", view: "Phone" }), "the calls card")
}

// spec/app/messages/index.md, "One tap on Home's unread card opens the conversation when exactly one is unread, and the list filtered to the unread ones when several are"
/** Home's unread card, tapped: once Messages shows its list, the one unread conversation opens, or the list of the unread ones. */
export effect function openUnread(): void!!(Telephony | Messages | Conversations | Shell) {
  try contained((try Shell).send({ type: "openView", view: "Messages" }), "the unread card")
  const messages = try Messages
  try Stream.runHead(Stream.filter(messages.changes, (s) => s.front && s.pane === "Threads" && s.sms.grant === "Granted"))
  const page = telephony("threadPage", (c) => c.messages.threadPage()) catch () => undefined
  const unread = (page?.rows ?? []).flatMap((row) => ("incomplete" in row || !row.unread ? [] : [row]))
  const only = unread.length === 1 ? try (try Conversations).of({ id: unread[0].id, addresses: unread[0].addresses }) : 0
  try contained(messages.send({ type: "openUnread", only }), "the unread card")
}
