// spec/app/phone/index.md, "Phone reads the call log whenever Recents comes to the front"; spec/app/messages/index.md, "Messages reads the conversation list each time it comes to the front"; spec/app/contacts/index.md, "Contacts reads the list each time it comes to the front"
import { Machine as Shell, type Shell as Where, type View, showing } from "../../gen/app__shell.effect.vibe"
import { Device } from "../platform/device.vibe"
import { contained, started } from "../runtime/reactor.vibe"

/** Whether `view` is the app on top of the shell's trail. */
export const on = (view: View) => (state: Where) => showing(state, view)

/** Whether Home is in front: no app on the trail. */
export const home = (state: Where) => state.trail.length === 0

/**
 * Tell the machine `target` names whether what `inFront` picks out of the shell is in front while the page is
 * visible, which a locked phone or another app in front hides. `told` makes the fact its event, or none; each change
 * is told once, from Alpha's first state on.
 */
export function visiting<IB, Ev, Refused>(inFront: (state: Where) => boolean, target: Context.Key<IB, { send(event: Ev): unknown!Refused }>, told: (shown: boolean) => Ev | undefined) {
  return started(effect {
    const shell = try Shell
    const device = try Device
    const to = try target
    const visible = Stream.concat(Stream.succeed(true), device.visible)
    const shown = Stream.map(Stream.zipLatest(Stream.map(shell.changes, inFront), visible), ([front, seen]) => front && seen)
    try Stream.runForEach(Stream.changesWith(shown, (a, b) => a === b), effect (now) => {
      const event = told(now)
      if (event !== undefined) try contained(to.send(event), "visiting")
    })
  }, "visiting")
}
