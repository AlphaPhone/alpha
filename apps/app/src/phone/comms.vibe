// spec/app/phone/comms.md, "Story: Address the person or Alpha from one bar"; spec/app/phone/comms.md, "Story: Never lose End"; spec/app/phone/comms.md, "Story: See what Alpha is acting on"; spec/app/phone/comms.md, "Story: Keep what I was asking Alpha"
import { Machine as Shell } from "../../gen/app__shell.effect.vibe"
import { Machine as Strip, shownCall } from "../../gen/app__phone__call.effect.vibe"
import * as Comms from "../../gen/app__phone__comms.effect.vibe"
import type { Event } from "../../gen/app__phone__comms.effect.vibe"
import { Machine as Messages } from "../../gen/app__messages.effect.vibe"
import { Machine as Phone, clear, liveCall } from "../../gen/app__phone.effect.vibe"
import { Machine as Voicemail } from "../../gen/app__phone__voicemail.effect.vibe"
import { contained, following, reacting, started, together } from "../runtime/reactor.vibe"
import { Dialer } from "./phone.vibe"

/** The actual shell app an entry in the communications stage can return to. */
export function commsViewOf(app: Comms.CommsApp): "Phone" | "Messages" | "Contacts" {
  return app === "PhoneApp" ? "Phone" : app === "MessagesApp" ? "Messages" : "Contacts"
}

// spec/app/phone/comms.md, "A proposal kept across a restart is shown, never approved, until Alpha proposes it again"
const machine = reacting(Comms, { keep: 1, open: [{ type: "reopen" }, "Device"] })

/** A request handed from owner-side search to the open Ask Alpha sheet. */
export interface CommsPrompt {
  readonly about: string
  readonly text: string
}

export interface CommsTalkRequest {
  readonly about: string
  readonly view: "Phone" | "Messages" | "Contacts"
}

export service CommsPrompts {
  submit(prompt: CommsPrompt): void!!
  readonly submissions: Stream.Stream<CommsPrompt>
  talk(request: CommsTalkRequest): void!!
  readonly talkRequests: Stream.Stream<CommsTalkRequest>
}

const prompts = Layer.effect(CommsPrompts, effect {
  const queue = try Queue.sliding<CommsPrompt>(1)
  const talk = try Queue.sliding<CommsTalkRequest>(1)
  return {
    submit: (prompt: CommsPrompt) => asVoid(Queue.offer(queue, prompt)), submissions: Stream.fromQueue(queue),
    talk: (request: CommsTalkRequest) => asVoid(Queue.offer(talk, request)), talkRequests: Stream.fromQueue(talk),
  }
})

// spec/app/phone/comms.md, "End is beside the bar when closed, in the call card when open, in the strip when full, and on the voice panel during a voice turn"
const calls = following(Phone, (phone) => ({ live: liveCall(phone), emergencyCall: liveCall(phone) && !clear(phone) }), Comms.Machine, (call): Event => ({ type: "callChanged", ...call }), "Device")

// spec/app/phone/comms.md, "A ring shows its card in the stage, and its Screen it proposal retires when the ring ends"
const rings = following(Strip, (strip) => (strip.calls.some((call) => call.phase === "Ringing") ? shownCall(strip.calls).id : ""), Comms.Machine, (ring): Event => (ring === "" ? { type: "ringEnded" } : { type: "ringStarted", ring }), "Device")

// spec/app/phone/comms.md, "The bar addresses Alpha exactly while the conversation is open, and the left slot holds the other target"
const detents = started(effect {
  const shell = try Shell
  const comms = try Comms.Machine
  try Stream.runForEach(Stream.changes(Stream.map(shell.changes, (where) => where.assistant)), effect (detent) => {
    const state = try comms.get()
    if (detent === "Bar" || detent === "Typing") {
      if (state.height !== "SheetClosed") try contained(comms.send({ type: "chatClosed" }, "Device"), "closing Ask Alpha")
      return
    }
    if (state.height === "SheetClosed") try contained(comms.send({ type: "alphaOpened" }, "Owner"), "opening Ask Alpha")
    const height = detent === "Full" ? "SheetFull" : "SheetOpen"
    if ((try comms.get()).height !== height) try contained(comms.send({ type: "heightChanged", height }, "Device"), "moving the comms sheet")
  })
}, "comms sheet detents")

// spec/app/phone/comms.md, "A view change while the conversation is open keeps the sheet's height and remembers the view it left"
/** The subject on screen, of Phone or Messages in front; Contacts tells its own. */
const subjects = started(effect {
  const shell = try Shell
  const phone = try Phone
  const messages = try Messages
  const comms = try Comms.Machine
  let told = ""
  try Stream.runForEach(Stream.zipLatest(Stream.zipLatest(shell.changes, phone.changes), messages.changes), effect ([[where, dialer], texts]) => {
    const top = where.trail.at(-1)
    const event: Event | undefined = top === "Phone"
      ? { type: "subjectShown", app: "PhoneApp", subject: dialer.tab === "Keypad" ? "KeypadSubject" : "RecentsSubject", key: dialer.tab === "Keypad" ? "phone:keypad:" : "phone:recents:" }
      : top === "Messages"
        ? texts.pane === "Conversation"
          ? { type: "subjectShown", app: "MessagesApp", subject: "ThreadSubject", key: `messages:thread:${texts.thread}` }
          : { type: "subjectShown", app: "MessagesApp", subject: "ListSubject", key: texts.pane === "Picker" ? "messages:new:" : "messages:list:" }
        : undefined
    if (event === undefined || event.type !== "subjectShown" || event.key === told) return
    told = event.key
    try contained(comms.send(event, "Device"), "the subject on screen")
  })
}, "comms subjects")

export service CommsBriefing {
  forSubject(key: string): string!!
  put(key: string, text: string): void!!
}

const briefings = Layer.sync(CommsBriefing, () => {
  let current = { key: "", text: "" }
  return {
    forSubject: (key: string) => sync(() => current.key === key ? current.text : ""),
    put: (key: string, text: string) => sync(() => { current = { key, text } }),
  }
})

// spec/app/phone/comms.md, "A subject is briefed once, only with the conversation open, and never from fixtures"
/** Draw a short local briefing from the facts the phone already admitted to its views. */
const phoneBriefing = started(effect {
  const comms = try Comms.Machine
  const shell = try Shell
  const phone = try Phone
  const voicemail = try Voicemail
  const dialer = try Dialer
  const brief = try CommsBriefing
  const activity = Stream.zipLatest(phone.changes, voicemail.changes)
  try Stream.runForEach(Stream.zipLatest(comms.changes, activity), effect ([stage, [calls, messages]]) => {
    const page = try shell.get()
    if (page.trail.at(-1) !== "Phone" || (page.assistant !== "Sheet" && page.assistant !== "Full")
      || stage.app !== "PhoneApp" || !Comms.canBriefingShown(stage, stage.key, "Device")) return
    const log = calls.log.grant === "Granted" ? (try dialer.get()).source : undefined
    const missed = calls.log.grant === "Granted" ? Math.max(calls.missed, log?.filter((entry) => entry.isNew && entry.type === "missed").length ?? 0) : 0
    const unheard = calls.voicemail ? messages.unheard : 0
    const text = [
      missed > 0 ? `You have ${missed} missed ${missed === 1 ? "call" : "calls"}.` : "",
      unheard > 0 ? `You have ${unheard} new ${unheard === 1 ? "voicemail" : "voicemails"}.` : "",
    ].filter((line) => line !== "").join(" ")
    if (text === "") return
    try brief.put(stage.key, text)
    if (!(try contained(comms.send({ type: "briefingShown", key: stage.key }, "Device"), "showing the Phone briefing"))) try brief.put("", "")
  })
}, "briefing Phone from its reported facts")

/** The stage of Phone, Messages and Contacts: kept across restarts, told of calls, rings, the subject on screen and Ask Alpha lowering. */
export const comms = together(machine, prompts, calls, rings, detents, subjects, briefings, phoneBriefing)
