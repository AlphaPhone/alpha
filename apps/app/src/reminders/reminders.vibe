// spec/app/reminders/index.md, "Story: Organize reminders across smart views and custom lists"; spec/app/reminders/index.md, "Story: Create, update, flag, move, complete and delete reminders with Undo"; spec/app/reminders/index.md, "Story: Sync with the resident agent and recover across restarts"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Reminders from "../../gen/app__reminders.effect.vibe"
import type { DeleteMode, Effect as Out, Event } from "../../gen/app__reminders.effect.vibe"
import * as Alerts from "../../gen/app__reminders__alerts.effect.vibe"
import * as Editor from "../../gen/app__reminders__editor.effect.vibe"
import * as Toasts from "../../gen/app__notices__toasts.effect.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import { Said, offer, say, withdraw } from "../notices/toasts.vibe"
import { Agent } from "../platform/agent.vibe"
import { Device } from "../platform/device.vibe"
import { PhoneReminders } from "../platform/reminders.vibe"
import { ask, attemptedWith } from "../platform/remote.vibe"
import { type Attempts, fresh } from "../runtime/attempts.vibe"
import { type Job, answer, contained, due, reacting, started, stop, together, untimed } from "../runtime/reactor.vibe"
import { Time } from "../runtime/time.vibe"
import { buildMachineSyncArgs, pushHomeFromSnapshot, reminderAlerts, syncAlertsWithSnapshot } from "./alerts.vibe"
import { clearPersistedDraft, reminderEditor } from "./editor.vibe"
import {
  type ReminderRecurrence,
  advanceDueDate,
  civilDayFromString,
  civilDayNumber,
} from "./recurrence.ts"
import {
  AlertBannerShelf,
  EditorDraftShelf,
  type PendingRequest,
  type ReminderEditorFields,
  RemindersLedger,
  RemindersNowShelf,
  RemindersShelf,
  remindersShelves,
} from "./shelf.vibe"
import {
  DEFAULT_LIST_ID,
  type ReminderItemRecord,
  type ReminderListColor,
  type ReminderListIcon,
  type ReminderListRecord,
  type ReminderPriority,
  type RemindersSnapshot,
  normalizeSnapshot,
  priorityToSpec,
  recurrenceToSpec,
} from "./store.ts"

const snapshotKey = "alpha.reminders.snapshot@1"

const ListColorSchema = Schema.Literals(["accent", "blue", "green", "amber", "rose", "violet"])
const ListIconSchema = Schema.Literals(["list", "home", "work", "shopping", "heart", "star", "bookmark", "bolt"])
const RecurrenceSchema = Schema.Literals(["none", "daily", "weekdays", "weekly", "monthly", "yearly"])
const PrioritySchema = Schema.Literals(["none", "low", "medium", "high"])

const SubtaskSchema = Schema.Struct({
  id: Schema.String,
  title: Schema.String,
  done: Schema.Boolean,
})

const ListSchema = Schema.Struct({
  id: Schema.String,
  name: Schema.String,
  color: ListColorSchema,
  icon: ListIconSchema,
  isDefault: Schema.Boolean,
  order: Schema.Number,
  createdAtMs: Schema.Number,
  updatedAtMs: Schema.Number,
})

const ItemSchema = Schema.Struct({
  id: Schema.String,
  listId: Schema.String,
  title: Schema.String,
  notes: Schema.String,
  dueDate: Schema.NullOr(Schema.String),
  dueMinute: Schema.NullOr(Schema.Number),
  alertMinutes: Schema.NullOr(Schema.Number),
  recurrence: RecurrenceSchema,
  priority: PrioritySchema,
  flagged: Schema.Boolean,
  subtasks: Schema.Array(SubtaskSchema),
  completed: Schema.Boolean,
  completedAtMs: Schema.NullOr(Schema.Number),
  snoozedUntilMs: Schema.NullOr(Schema.Number),
  notifiedAtMs: Schema.NullOr(Schema.Number),
  agentTaskId: Schema.NullOr(Schema.String),
  revision: Schema.Number,
  createdAtMs: Schema.Number,
  updatedAtMs: Schema.Number,
})

const SnapshotSchema = Schema.Struct({
  version: Schema.Number,
  updatedAtMs: Schema.Number,
  lists: Schema.Array(ListSchema),
  items: Schema.Array(ItemSchema),
})

const SnapshotJsonSchema = Schema.fromJsonString(SnapshotSchema)

type RemindersEnv =
  | Reminders.Machine
  | KeyValueStore.KeyValueStore
  | Alerts.Machine
  | AlertBannerShelf
  | RemindersShelf
  | RemindersNowShelf
  | RemindersLedger
  | Time
  | Toasts.Machine
  | Said
  | PhoneReminders

function buildItemSpec(
  store: RemindersShelf["store"],
  listId: string,
  dueDate: string | null,
  dueMinute: number | null,
  recurrence: ReminderRecurrence,
  priority: ReminderPriority,
  flagged: boolean,
  now: number,
) {
  return {
    listId: Math.max(1, store.specIdForList(listId)),
    hasDue: dueDate !== null,
    dueDay: civilDayFromString(dueDate) ?? civilDayNumber(now),
    hasDueTime: dueMinute !== null,
    dueMinute: dueMinute ?? 0,
    repeat: recurrenceToSpec(recurrence),
    priority: priorityToSpec(priority),
    flagged,
  }
}

effect function commitListMutation(
  nextAttempt: number,
  event: Event,
  nextSnapshot: RemindersSnapshot,
  now: number,
): void!!RemindersEnv {
  const ledger = try RemindersLedger
  const ok = try sendChecked(event)
  if (!ok) {
    ledger.pendingWrites.delete(nextAttempt)
    return
  }
  const after = try (try Reminders.Machine).get()
  try persistAndBroadcast(nextSnapshot, now, after.nextListId, after.nextItemId)
}

effect function persistViewAndBroadcast(
  view: ReturnType<RemindersShelf["store"]["snapshot"]>,
  nowMs: number,
): void!!(KeyValueStore.KeyValueStore | Alerts.Machine | AlertBannerShelf | RemindersShelf | PhoneReminders | RemindersLedger) {
  const encoded = Effect.try(() => JSON.stringify(view.snapshot)) catch () => undefined
  if (encoded !== undefined) try ignore((try KeyValueStore.KeyValueStore).set(snapshotKey, encoded))
  pushHomeFromSnapshot(view.snapshot, view.hiddenIds, nowMs)
  try syncAlertsWithSnapshot(view.snapshot, nowMs)
}

effect function persistAndBroadcast(
  snapshot: RemindersSnapshot,
  nowMs: number,
  minNextListId = 2,
  minNextItemId = 1,
): ReturnType<RemindersShelf["store"]["snapshot"]>!!(KeyValueStore.KeyValueStore | Alerts.Machine | AlertBannerShelf | RemindersShelf | PhoneReminders | RemindersLedger) {
  const store = (try RemindersShelf).store
  const view = store.replace(snapshot, null, minNextListId, minNextItemId)
  try persistViewAndBroadcast(view, nowMs)
  return view
}

effect function syncMachineFromSnapshot(
  snapshot: RemindersSnapshot,
  nowMs: number,
): void!!(Reminders.Machine | Alerts.Machine | AlertBannerShelf | RemindersShelf | RemindersNowShelf | KeyValueStore.KeyValueStore | PhoneReminders | RemindersLedger) {
  ;(try RemindersNowShelf).shelf.set(nowMs)
  const machine = try Reminders.Machine
  const before = try machine.get()
  const view = try persistAndBroadcast(snapshot, nowMs, before.nextListId, before.nextItemId)
  const today = civilDayNumber(nowMs)
  if (Reminders.canSetToday(before, today)) try contained(machine.send({ type: "setToday", day: today }), "advancing reminders today")
  const afterToday = try machine.get()
  const syncArgs = buildMachineSyncArgs(view, afterToday.nextListId, afterToday.nextItemId, nowMs)
  if (Reminders.canApplySync(afterToday, syncArgs.syncedLists, syncArgs.nextListId, syncArgs.syncedItems, syncArgs.nextItemId)) {
    try contained(machine.send({ type: "applySync", ...syncArgs }), "hydrating reminders machine from snapshot")
  }
}

effect function fetchSnapshot(
  ticket: number,
): Event!!(Agent | KeyValueStore.KeyValueStore | Alerts.Machine | AlertBannerShelf | RemindersShelf | RemindersNowShelf | Time | Reminders.Machine | PhoneReminders | RemindersLedger) {
  const now = try (try Time).now()
  const store = (try RemindersShelf).store
  return effect {
    const raw = try ask(Agent, HttpClientRequest.get("/api/alpha/reminders"), SnapshotSchema)
    const normalized = normalizeSnapshot(raw)
    try syncMachineFromSnapshot(normalized, now)
    store.setSyncError(null)
    return { type: "synced", ticket, ok: true }
  } catch () => {
    store.setSyncError("Offline — changes kept locally")
    return { type: "synced", ticket, ok: false }
  }
}

function buildWriteRequest(req: Exclude<PendingRequest, { readonly kind: "clearCompleted" }>, key: string): HttpClientRequest.HttpClientRequest {
  switch (req.kind) {
    case "createItem":
      return HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post("/api/alpha/reminders/items"), { ...req.item, idempotencyKey: key })
    case "updateItem":
      return HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.patch(`/api/alpha/reminders/items/${encodeURIComponent(req.item.id)}`), { ...req.item, idempotencyKey: key })
    case "completeItem":
      return HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post(`/api/alpha/reminders/items/${encodeURIComponent(req.id)}/complete`), { item: req.item, idempotencyKey: key })
    case "reopenItem":
      return HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post(`/api/alpha/reminders/items/${encodeURIComponent(req.id)}/reopen`), { idempotencyKey: key })
    case "restoreItem":
      return HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post(`/api/alpha/reminders/items/${encodeURIComponent(req.id)}/restore`), { item: req.item, idempotencyKey: key })
    case "snoozeItem":
      return HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post(`/api/alpha/reminders/items/${encodeURIComponent(req.id)}/snooze`), { untilMs: req.snoozedUntilMs, idempotencyKey: key })
    case "deleteItem":
      return HttpClientRequest.delete(`/api/alpha/reminders/items/${encodeURIComponent(req.id)}`, { urlParams: { idempotencyKey: key } })
    case "createList":
      return HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post("/api/alpha/reminders/lists"), { ...req.list, idempotencyKey: key })
    case "updateList":
      return HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.patch(`/api/alpha/reminders/lists/${encodeURIComponent(req.list.id)}`), { ...req.list, idempotencyKey: key })
    case "deleteList":
      return HttpClientRequest.delete(`/api/alpha/reminders/lists/${encodeURIComponent(req.id)}`, { urlParams: { mode: req.mode === "CascadeItems" ? "cascade" : "reassign", idempotencyKey: key } })
  }
}

effect function flushWrite(attemptId: number): Event!!(Agent | Attempts | RemindersLedger) {
  const ledger = try RemindersLedger
  const pending = ledger.pendingWrites.get(attemptId)
  ledger.pendingWrites.delete(attemptId)
  if (pending === undefined) return { type: "writeAnswered", attemptId, confirmed: true, known: true }
  if (pending.kind === "clearCompleted") {
    let allConfirmed = true
    let allKnown = true
    for (const id of pending.ids) {
      const outcome = try attemptedWith(
        Agent,
        (key) => HttpClientRequest.delete(`/api/alpha/reminders/items/${encodeURIComponent(id)}`, { urlParams: { idempotencyKey: `${key}:${id}` } }),
        attemptId,
      )
      if (!outcome.confirmed) allConfirmed = false
      if (!outcome.known) allKnown = false
    }
    return { type: "writeAnswered", attemptId, confirmed: allConfirmed, known: allKnown }
  }
  const outcome = try attemptedWith(Agent, (key) => buildWriteRequest(pending, key), attemptId)
  return { type: "writeAnswered", attemptId, confirmed: outcome.confirmed, known: outcome.known }
}

effect function commitDeleteWrite(
  attemptId: number,
  itemSpecId: number,
): Event!!(Agent | Attempts | KeyValueStore.KeyValueStore | Alerts.Machine | AlertBannerShelf | RemindersShelf | Reminders.Machine | Time | Toasts.Machine | Said | PhoneReminders | RemindersLedger) {
  const ledger = try RemindersLedger
  const store = (try RemindersShelf).store
  const held = ledger.getActiveUndo()
  if (held !== undefined && held.kind === "delete") {
    ledger.setActiveUndo(undefined)
    try withdraw("reminders", held.about)
    store.setHidden(new Set())
    const now = try (try Time).now()
    const current = store.snapshot().snapshot
    const next: RemindersSnapshot = {
      ...current,
      version: current.version + 1,
      updatedAtMs: now,
      items: current.items.filter((item) => item.id !== held.itemId),
    }
    const state = try (try Reminders.Machine).get()
    try persistAndBroadcast(next, now, state.nextListId, state.nextItemId)
    const outcome = try attemptedWith(Agent, (key) => HttpClientRequest.delete(`/api/alpha/reminders/items/${encodeURIComponent(held.itemId)}`, { urlParams: { idempotencyKey: key } }), attemptId)
    return { type: "writeAnswered", attemptId, confirmed: outcome.confirmed, known: outcome.known }
  }
  const found = store.findItemBySpecId(itemSpecId)
  if (found === undefined) return { type: "writeAnswered", attemptId, confirmed: true, known: true }
  const outcome = try attemptedWith(Agent, (key) => HttpClientRequest.delete(`/api/alpha/reminders/items/${encodeURIComponent(found.id)}`, { urlParams: { idempotencyKey: key } }), attemptId)
  return { type: "writeAnswered", attemptId, confirmed: outcome.confirmed, known: outcome.known }
}

function carry(
  fx: Out,
): Job<Event, Agent | Attempts | KeyValueStore.KeyValueStore | Alerts.Machine | AlertBannerShelf | RemindersShelf | RemindersNowShelf | RemindersLedger | Time | Reminders.Machine | Toasts.Machine | Said | PhoneReminders, []> {
  return match (fx) {
    when { tag: "SyncFetch", let ticket }: answer("sync", fetchSnapshot(ticket), { type: "synced", ticket, ok: false });
    when { tag: "WriteItem", let attemptId }: answer(`write:${attemptId}`, flushWrite(attemptId), { type: "writeAnswered", attemptId, confirmed: false, known: false });
    when { tag: "WriteList", let attemptId }: answer(`write:${attemptId}`, flushWrite(attemptId), { type: "writeAnswered", attemptId, confirmed: false, known: false });
    when { tag: "CommitDelete", let attemptId, let itemId }: answer(`delete:${attemptId}`, commitDeleteWrite(attemptId, itemId), { type: "writeAnswered", attemptId, confirmed: false, known: false });
    when { tag: "WakeUndo" }: stop("wake");
  }
}

function timers(state: Reminders.Reminders) {
  return state.undo.holding === "Held"
    ? [due<Event, []>("undo", state.undo.until, { type: "expireUndo", now: untimed })]
    : []
}

effect function sendChecked(event: Event): boolean!!Reminders.Machine {
  const machine = try Reminders.Machine
  return try Effect.match(machine.send(event), { onFailure: () => false, onSuccess: () => true })
}

effect function settlePendingUndoBeforeWrite(): void!!RemindersEnv {
  const machine = try Reminders.Machine
  const ledger = try RemindersLedger
  const cur = try machine.get()
  if (cur.undo.holding === "Held" && cur.write.outcome !== "Sent") {
    const held = ledger.getActiveUndo()
    const wasDelete = cur.undoData.kind === "UndoDelete"
    if (held !== undefined) {
      try withdraw("reminders", held.about)
      if (held.kind === "complete") ledger.setActiveUndo(undefined)
    }
    const expired = try sendChecked({ type: "expireUndo", now: cur.undo.until })
    if (expired && wasDelete) {
      try ignore(Stream.runHead(Stream.filter(machine.changes, (s) => !Reminders.writing(s))))
    }
  }
}

effect function undoHeldAction(): void!!RemindersEnv {
  const machine = try Reminders.Machine
  const ledger = try RemindersLedger
  const store = (try RemindersShelf).store
  const held = ledger.getActiveUndo()
  if (held === undefined) return
  const now = try (try Time).now()
  const state = try machine.get()
  if (!Reminders.canUndoAction(state, now)) return
  if (held.kind === "delete") {
    const ok = try sendChecked({ type: "undoAction", now })
    if (!ok) return
    ledger.setActiveUndo(undefined)
    try withdraw("reminders", held.about)
    store.setHidden(new Set())
    pushHomeFromSnapshot(store.snapshot().snapshot, new Set(), now)
    try say(`Restored “${held.prior.title}”`)
    return
  }
  const nextAttempt = state.write.id + 1
  ledger.pendingWrites.set(nextAttempt, { kind: "restoreItem", id: held.itemId, item: held.prior })
  const ok = try sendChecked({ type: "undoAction", now })
  if (!ok) {
    ledger.pendingWrites.delete(nextAttempt)
    return
  }
  ledger.setActiveUndo(undefined)
  try withdraw("reminders", held.about)
  const current = store.snapshot().snapshot
  const next: RemindersSnapshot = {
    ...current,
    version: current.version + 1,
    updatedAtMs: now,
    items: current.items.map((item) => (item.id === held.itemId ? { ...held.prior, updatedAtMs: now } : item)),
  }
  const after = try machine.get()
  try persistAndBroadcast(next, now, after.nextListId, after.nextItemId)
  try say(`Restored “${held.prior.title}”`)
}

effect function captureUndo(): (void!!)!!RemindersEnv {
  const layer = Layer.mergeAll(
    Layer.succeed(Reminders.Machine, try Reminders.Machine),
    Layer.succeed(KeyValueStore.KeyValueStore, try KeyValueStore.KeyValueStore),
    Layer.succeed(Alerts.Machine, try Alerts.Machine),
    Layer.succeed(AlertBannerShelf, try AlertBannerShelf),
    Layer.succeed(RemindersShelf, try RemindersShelf),
    Layer.succeed(RemindersNowShelf, try RemindersNowShelf),
    Layer.succeed(RemindersLedger, try RemindersLedger),
    Layer.succeed(Time, try Time),
    Layer.succeed(Toasts.Machine, try Toasts.Machine),
    Layer.succeed(Said, try Said),
    Layer.succeed(PhoneReminders, try PhoneReminders),
  )
  return Effect.provide(undoHeldAction(), layer)
}

/** Trigger an immediate refresh from the resident agent (called on app focus or after Ask Alpha turns). */
export effect function syncRemindersNow(): void!!Reminders.Machine {
  const machine = try Reminders.Machine
  const state = try machine.get()
  if (Reminders.canAgentChanged(state)) try contained(machine.send({ type: "agentChanged" }), "syncing reminders after agent turn")
}

/** Manually refresh reminders from the resident agent. */
export effect function refreshRemindersList(): void!!Reminders.Machine {
  const machine = try Reminders.Machine
  if (Reminders.canRefresh(try machine.get())) try contained(machine.send({ type: "refresh" }), "refreshing reminders")
}

/** Input for creating a reminder item from Quick Add or the Editor sheet. */
export interface CreateReminderInput {
  readonly listId: string
  readonly title: string
  readonly notes?: string
  readonly dueDate?: string | null
  readonly dueMinute?: number | null
  readonly alertMinutes?: number | null
  readonly recurrence?: ReminderRecurrence
  readonly priority?: ReminderPriority
  readonly flagged?: boolean
  readonly subtasks?: readonly { readonly id: string; readonly title: string; readonly done: boolean }[]
}

/** Create a new reminder item, gating via the Reminders machine before persisting to local store/Home/Alerts. */
export effect function createReminderItem(input: CreateReminderInput): (ReminderItemRecord | undefined)!!RemindersEnv {
  const title = input.title.trim()
  if (title === "") return undefined
  try settlePendingUndoBeforeWrite()
  const now = try (try Time).now()
  const machine = try Reminders.Machine
  const store = (try RemindersShelf).store
  const ledger = try RemindersLedger
  const currentView = store.snapshot()
  const current = currentView.snapshot
  const targetList = current.lists.find((list) => list.id === input.listId) ?? current.lists[0]
  const listId = targetList?.id ?? DEFAULT_LIST_ID
  const dueDate = input.dueDate ?? null
  const dueMinute = dueDate !== null ? (input.dueMinute ?? null) : null
  const recurrence: ReminderRecurrence = dueDate !== null ? (input.recurrence ?? "none") : "none"
  const priority: ReminderPriority = input.priority ?? "none"
  const flagged = input.flagged ?? false
  const alertMinutes = dueDate !== null ? (input.alertMinutes === undefined ? 0 : input.alertMinutes) : null
  const item: ReminderItemRecord = {
    id: `rem_${fresh()}`,
    listId,
    title,
    notes: (input.notes ?? "").trim(),
    dueDate,
    dueMinute,
    alertMinutes,
    recurrence,
    priority,
    flagged,
    subtasks: (input.subtasks ?? []).map((sub) => ({ ...sub })),
    completed: false,
    completedAtMs: null,
    snoozedUntilMs: null,
    notifiedAtMs: null,
    agentTaskId: null,
    revision: 1,
    createdAtMs: now,
    updatedAtMs: now,
  }
  const state = try machine.get()
  const spec = buildItemSpec(store, listId, dueDate, dueMinute, recurrence, priority, flagged, now)
  if (!Reminders.canCreateItem(state, spec)) return undefined
  const assignedItemSpecId = state.nextItemId
  const nextAttempt = state.write.id + 1
  ledger.pendingWrites.set(nextAttempt, { kind: "createItem", item })
  const ok = try sendChecked({ type: "createItem", spec })
  if (!ok) {
    ledger.pendingWrites.delete(nextAttempt)
    return undefined
  }
  const nextItemSpecIds = new Map(currentView.itemSpecIds)
  nextItemSpecIds.set(item.id, assignedItemSpecId)
  const nextSnapshot: RemindersSnapshot = {
    ...current,
    version: current.version + 1,
    updatedAtMs: now,
    items: [...current.items, item],
  }
  const view = store.replaceWithIds(nextSnapshot, currentView.listSpecIds, nextItemSpecIds, null)
  try persistViewAndBroadcast(view, now)
  return item
}

function replaceItemInSnapshot(current: RemindersSnapshot, updated: ReminderItemRecord, now: number): RemindersSnapshot {
  return {
    ...current,
    version: current.version + 1,
    updatedAtMs: now,
    items: current.items.map((item) => (item.id === updated.id ? updated : item)),
  }
}

effect function prepareItemEdit(
  id: string,
): ({ readonly current: RemindersSnapshot; readonly existing: ReminderItemRecord; readonly now: number; readonly itemSpecId: number } | undefined)!!RemindersEnv {
  try settlePendingUndoBeforeWrite()
  const store = (try RemindersShelf).store
  const current = store.snapshot().snapshot
  const existing = current.items.find((item) => item.id === id)
  if (existing === undefined) return undefined
  const itemSpecId = store.specIdForItem(id)
  if (itemSpecId <= 0) return undefined
  const now = try (try Time).now()
  return { current, existing, now, itemSpecId }
}

effect function updateReminderItem(id: string, patch: Partial<CreateReminderInput>): (ReminderItemRecord | undefined)!!RemindersEnv {
  const ctx = try prepareItemEdit(id)
  if (ctx === undefined) return undefined
  const { current, existing, now, itemSpecId } = ctx
  const title = patch.title !== undefined ? patch.title.trim() : existing.title
  if (title === "") return undefined
  const dueDate = patch.dueDate !== undefined ? patch.dueDate : existing.dueDate
  const dueMinute = dueDate !== null ? (patch.dueMinute !== undefined ? patch.dueMinute : existing.dueMinute) : null
  const recurrence: ReminderRecurrence = dueDate !== null ? (patch.recurrence !== undefined ? patch.recurrence : existing.recurrence) : "none"
  const alertMinutes = dueDate !== null ? (patch.alertMinutes !== undefined ? patch.alertMinutes : existing.alertMinutes) : null
  const listId = patch.listId !== undefined && current.lists.some((l) => l.id === patch.listId) ? patch.listId : existing.listId
  const updated: ReminderItemRecord = {
    ...existing,
    listId,
    title,
    notes: patch.notes !== undefined ? patch.notes.trim() : existing.notes,
    dueDate,
    dueMinute,
    alertMinutes,
    recurrence,
    priority: patch.priority ?? existing.priority,
    flagged: patch.flagged ?? existing.flagged,
    subtasks: patch.subtasks !== undefined ? patch.subtasks.map((sub) => ({ ...sub })) : existing.subtasks,
    revision: existing.revision + 1,
    updatedAtMs: now,
  }
  const machine = try Reminders.Machine
  const store = (try RemindersShelf).store
  const ledger = try RemindersLedger
  const state = try machine.get()
  const spec = buildItemSpec(store, listId, dueDate, dueMinute, recurrence, updated.priority, updated.flagged, now)
  if (!Reminders.canUpdateItem(state, itemSpecId, spec)) return undefined
  const nextAttempt = state.write.id + 1
  ledger.pendingWrites.set(nextAttempt, { kind: "updateItem", item: updated })
  const ok = try sendChecked({ type: "updateItem", itemId: itemSpecId, spec })
  if (!ok) {
    ledger.pendingWrites.delete(nextAttempt)
    return undefined
  }
  const after = try machine.get()
  try persistAndBroadcast(replaceItemInSnapshot(current, updated, now), now, after.nextListId, after.nextItemId)
  return updated
}

/** Save the current Editor draft (creating or updating the reminder), detecting conflicts and settling the Editor machine. */
export effect function saveReminderDraft(): (ReminderItemRecord | undefined)!!(RemindersEnv | Editor.Machine | EditorDraftShelf) {
  const editor = try Editor.Machine
  const fields: ReminderEditorFields = (try EditorDraftShelf).shelf.snapshot()
  const state = try editor.get()
  if (!Editor.canSave(state)) return undefined
  try contained(editor.send({ type: "save" }), "saving reminder draft")
  if (fields.itemId !== null) {
    const existing = (try RemindersShelf).store.findItem(fields.itemId)
    if (existing !== undefined && existing.revision > fields.revision) {
      const savingState = try editor.get()
      if (Editor.canConflicted(savingState, existing.revision)) {
        try contained(editor.send({ type: "conflicted", held: existing.revision }), "recording reminder edit conflict")
      }
      return undefined
    }
  }
  const payload: CreateReminderInput = {
    listId: fields.listId,
    title: fields.title,
    notes: fields.notes,
    dueDate: fields.dueDate,
    dueMinute: fields.dueMinute,
    alertMinutes: fields.alertMinutes,
    recurrence: fields.recurrence,
    priority: fields.priority,
    flagged: fields.flagged,
    subtasks: fields.subtasks,
  }
  const saved = fields.itemId === null ? try createReminderItem(payload) : try updateReminderItem(fields.itemId, payload)
  if (saved !== undefined) {
    const after = try editor.get()
    if (Editor.canLanded(after)) try contained(editor.send({ type: "landed" }), "landing reminder draft")
    else if (Editor.canClose(after)) try contained(editor.send({ type: "close" }), "closing reminder draft")
    try clearPersistedDraft()
  }
  return saved
}

/** Toggle completion of a reminder: recurring items advance to their next date, and a 5s Undo toast is offered. */
export effect function toggleReminderComplete(id: string): void!!RemindersEnv {
  const ctx = try prepareItemEdit(id)
  if (ctx === undefined) return
  const { current, existing, now, itemSpecId } = ctx
  const completing = !existing.completed
  const recurring = completing && existing.recurrence !== "none" && existing.dueDate !== null
  const nextDueDate = recurring && existing.dueDate !== null ? advanceDueDate(existing.dueDate, existing.recurrence) : existing.dueDate
  const updated: ReminderItemRecord = recurring
    ? { ...existing, dueDate: nextDueDate, subtasks: existing.subtasks.map((sub) => ({ ...sub, done: false })), snoozedUntilMs: null, notifiedAtMs: null, revision: existing.revision + 1, updatedAtMs: now }
    : { ...existing, completed: completing, completedAtMs: completing ? now : null, snoozedUntilMs: null, revision: existing.revision + 1, updatedAtMs: now }
  const machine = try Reminders.Machine
  const ledger = try RemindersLedger
  const state = try machine.get()
  const nextDueDay = civilDayFromString(nextDueDate) ?? (civilDayFromString(existing.dueDate) ?? civilDayNumber(now)) + 1
  if (!Reminders.canToggleComplete(state, itemSpecId, nextDueDay)) return
  const nextAttempt = state.write.id + 1
  ledger.pendingWrites.set(nextAttempt, completing ? { kind: "completeItem", id, item: updated } : { kind: "reopenItem", id })
  const ok = try sendChecked({ type: "toggleComplete", itemId: itemSpecId, nextDueDay, at: now })
  if (!ok) {
    ledger.pendingWrites.delete(nextAttempt)
    return
  }
  const after = try machine.get()
  try persistAndBroadcast(replaceItemInSnapshot(current, updated, now), now, after.nextListId, after.nextItemId)
  if (completing) {
    const about = ledger.nextUndoAbout()
    ledger.setActiveUndo({ kind: "complete", itemId: id, prior: existing, about })
    const message = recurring ? `Completed “${existing.title}” · Next ${nextDueDate}` : `Completed “${existing.title}”`
    try offer(message, "reminders", about, try captureUndo())
  }
}

/** Toggle the flagged state of a reminder item. */
export effect function toggleReminderFlag(id: string): void!!RemindersEnv {
  const ctx = try prepareItemEdit(id)
  if (ctx === undefined) return
  const { current, existing, now, itemSpecId } = ctx
  const updated: ReminderItemRecord = { ...existing, flagged: !existing.flagged, revision: existing.revision + 1, updatedAtMs: now }
  const machine = try Reminders.Machine
  const ledger = try RemindersLedger
  const state = try machine.get()
  if (!Reminders.canToggleFlag(state, itemSpecId)) return
  const nextAttempt = state.write.id + 1
  ledger.pendingWrites.set(nextAttempt, { kind: "updateItem", item: updated })
  const ok = try sendChecked({ type: "toggleFlag", itemId: itemSpecId })
  if (!ok) {
    ledger.pendingWrites.delete(nextAttempt)
    return
  }
  const after = try machine.get()
  try persistAndBroadcast(replaceItemInSnapshot(current, updated, now), now, after.nextListId, after.nextItemId)
}

/** Delete a reminder item immediately from view and hold for 5 seconds with an Undo toast. */
export effect function deleteReminderItem(id: string): void!!RemindersEnv {
  const ctx = try prepareItemEdit(id)
  if (ctx === undefined) return
  const { current, existing, now, itemSpecId } = ctx
  const machine = try Reminders.Machine
  const store = (try RemindersShelf).store
  const ledger = try RemindersLedger
  const state = try machine.get()
  if (!Reminders.canDeleteItem(state, itemSpecId)) return
  const ok = try sendChecked({ type: "deleteItem", itemId: itemSpecId, at: now })
  if (!ok) return
  const about = ledger.nextUndoAbout()
  ledger.setActiveUndo({ kind: "delete", itemId: id, prior: existing, about })
  const hidden = new Set([id])
  store.setHidden(hidden)
  pushHomeFromSnapshot(current, hidden, now)
  try offer(`Deleted “${existing.title}”`, "reminders", about, try captureUndo())
}

/** Clear all completed reminders via the Reminders machine and `Attempts`. */
export effect function clearCompletedReminders(): void!!RemindersEnv {
  try settlePendingUndoBeforeWrite()
  const store = (try RemindersShelf).store
  const ledger = try RemindersLedger
  const machine = try Reminders.Machine
  const current = store.snapshot().snapshot
  const completed = current.items.filter((item) => item.completed)
  if (completed.length === 0) return
  const state = try machine.get()
  if (!Reminders.canClearCompleted(state)) return
  const nextAttempt = state.write.id + 1
  ledger.pendingWrites.set(nextAttempt, { kind: "clearCompleted", ids: completed.map((item) => item.id) })
  const ok = try sendChecked({ type: "clearCompleted" })
  if (!ok) {
    ledger.pendingWrites.delete(nextAttempt)
    return
  }
  const now = try (try Time).now()
  const remaining = current.items.filter((item) => !item.completed)
  const after = try machine.get()
  try persistAndBroadcast({ ...current, version: current.version + 1, updatedAtMs: now, items: remaining }, now, after.nextListId, after.nextItemId)
  try say(`Cleared ${completed.length} completed ${completed.length === 1 ? "reminder" : "reminders"}`)
}

/** Create a custom list with name, semantic color, and icon. */
export effect function createReminderList(name: string, color: ReminderListColor, icon: ReminderListIcon): (ReminderListRecord | undefined)!!RemindersEnv {
  const trimmed = name.trim()
  if (trimmed === "") return undefined
  try settlePendingUndoBeforeWrite()
  const now = try (try Time).now()
  const store = (try RemindersShelf).store
  const ledger = try RemindersLedger
  const machine = try Reminders.Machine
  const currentView = store.snapshot()
  const current = currentView.snapshot
  const state = try machine.get()
  if (!Reminders.canCreateList(state)) return undefined
  const assignedListSpecId = state.nextListId
  const list: ReminderListRecord = {
    id: `list_${fresh()}`,
    name: trimmed,
    color,
    icon,
    isDefault: false,
    order: current.lists.length,
    createdAtMs: now,
    updatedAtMs: now,
  }
  const nextAttempt = state.write.id + 1
  ledger.pendingWrites.set(nextAttempt, { kind: "createList", list })
  const ok = try sendChecked({ type: "createList" })
  if (!ok) {
    ledger.pendingWrites.delete(nextAttempt)
    return undefined
  }
  const nextListSpecIds = new Map(currentView.listSpecIds)
  nextListSpecIds.set(list.id, assignedListSpecId)
  const view = store.replaceWithIds(
    { ...current, version: current.version + 1, updatedAtMs: now, lists: [...current.lists, list] },
    nextListSpecIds,
    currentView.itemSpecIds,
    null,
  )
  try persistViewAndBroadcast(view, now)
  return list
}

/** Rename or restyle an existing custom list. */
export effect function updateReminderList(id: string, name: string, color: ReminderListColor, icon: ReminderListIcon): void!!RemindersEnv {
  const trimmed = name.trim()
  if (trimmed === "") return
  try settlePendingUndoBeforeWrite()
  const now = try (try Time).now()
  const store = (try RemindersShelf).store
  const ledger = try RemindersLedger
  const machine = try Reminders.Machine
  const current = store.snapshot().snapshot
  const existing = current.lists.find((list) => list.id === id)
  if (existing === undefined) return
  const listSpecId = store.specIdForList(id)
  const state = try machine.get()
  if (listSpecId <= 0 || !Reminders.canRenameList(state, listSpecId)) return
  const updated: ReminderListRecord = { ...existing, name: trimmed, color, icon, updatedAtMs: now }
  const nextAttempt = state.write.id + 1
  ledger.pendingWrites.set(nextAttempt, { kind: "updateList", list: updated })
  try commitListMutation(
    nextAttempt,
    { type: "renameList", listId: listSpecId },
    { ...current, version: current.version + 1, updatedAtMs: now, lists: current.lists.map((list) => (list.id === id ? updated : list)) },
    now,
  )
}

/** Delete a custom list, either reassigning its items to the default Reminders list or deleting them. */
export effect function deleteReminderList(id: string, mode: DeleteMode): void!!RemindersEnv {
  try settlePendingUndoBeforeWrite()
  const store = (try RemindersShelf).store
  const ledger = try RemindersLedger
  const machine = try Reminders.Machine
  const current = store.snapshot().snapshot
  const target = current.lists.find((list) => list.id === id)
  if (target === undefined || target.isDefault || target.id === DEFAULT_LIST_ID) return
  const listSpecId = store.specIdForList(id)
  const state = try machine.get()
  if (listSpecId <= 1 || !Reminders.canDeleteList(state, listSpecId)) return
  const now = try (try Time).now()
  const defaultId = current.lists.find((list) => list.isDefault)?.id ?? DEFAULT_LIST_ID
  const nextLists = current.lists.filter((list) => list.id !== id)
  const nextItems = mode === "CascadeItems"
    ? current.items.filter((item) => item.listId !== id)
    : current.items.map((item) => (item.listId === id ? { ...item, listId: defaultId, revision: item.revision + 1, updatedAtMs: now } : item))
  const nextAttempt = state.write.id + 1
  ledger.pendingWrites.set(nextAttempt, { kind: "deleteList", id, mode })
  try commitListMutation(
    nextAttempt,
    { type: "deleteList", listId: listSpecId, mode },
    { ...current, version: current.version + 1, updatedAtMs: now, lists: nextLists, items: nextItems },
    now,
  )
}

const remindersNowTicker = started(effect {
  const time = try Time
  const device = try Device
  const shell = try Shell.Machine
  const alerts = try Alerts.Machine
  const reminders = try Reminders.Machine
  const nowShelf = (try RemindersNowShelf).shelf
  const publishNow = effect {
    const now = try time.now()
    nowShelf.set(now)
    const today = civilDayNumber(now)
    const state = try reminders.get()
    if (Reminders.canSetToday(state, today)) try contained(reminders.send({ type: "setToday", day: today }), "advancing reminders day")
  }
  try publishNow
  const active = Stream.changes(Stream.mergeAll(
    [
      Stream.map(device.visible, () => undefined),
      Stream.map(shell.changes, () => undefined),
      Stream.map(alerts.changes, () => undefined),
    ],
    { concurrency: "unbounded" },
  ))
  try Stream.runDrain(Stream.switchMap(active, () => Stream.fromEffect(effect {
    const onReminders = Shell.showing(try shell.get(), "Reminders")
    const hasBanner = (try alerts.get()).bannerId > 0
    if (!onReminders && !hasBanner) return
    while (true) {
      try publishNow
      const now = try time.now()
      const nextMinute = (Math.floor(now / 60_000) + 1) * 60_000
      try time.until(nextMinute)
      const stillOnReminders = Shell.showing(try shell.get(), "Reminders")
      const stillBanner = (try alerts.get()).bannerId > 0
      if (!stillOnReminders && !stillBanner) return
    }
  })))
}, "reminders minute clock")

const hydrated = started(effect {
  const now = try (try Time).now()
  ;(try RemindersNowShelf).shelf.set(now)
  const raw = (try KeyValueStore.KeyValueStore).get(snapshotKey) catch () => undefined
  if (raw !== undefined) {
    const decoded = Schema.decodeUnknownOption(SnapshotJsonSchema)(raw)
    if (Option.isSome(decoded)) try syncMachineFromSnapshot(decoded.value, now)
  }
  const machine = try Reminders.Machine
  if (Reminders.canRefresh(try machine.get())) try contained(machine.send({ type: "refresh" }), "initial reminders sync")
}, "hydrating reminders store")

const desk = reacting(Reminders, {
  keep: 1,
  open: [{ type: "reopen" }],
  carry,
  timers,
})

/** Resident Reminders layer (shelves, desk, due-time alerting, draft editor, minute clock, and hydration), ready for `resident.vibe`. */
export const remindersResident = together(remindersShelves, desk, reminderAlerts, reminderEditor, remindersNowTicker, hydrated)

/** Machines and scoped shelves required by the Reminders area screen. */
export type RemindersMachines =
  | Reminders.Machine
  | Alerts.Machine
  | Editor.Machine
  | RemindersShelf
  | AlertBannerShelf
  | EditorDraftShelf
  | RemindersNowShelf
  | RemindersLedger
