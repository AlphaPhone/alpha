// spec/app/reminders/alerts.md, "Story: Alert on due reminders and act from the banner"
import type { AndroidReminderOperation } from "@elizaos/os-bridges"
import type { ReminderItemRecord, RemindersSnapshot } from "@repo/launcher-records"
import type * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Alerts from "../../gen/app__reminders__alerts.effect.vibe"
import type { AlertEffect as Out, Event } from "../../gen/app__reminders__alerts.effect.vibe"
import type { Machine as Toasts } from "../../gen/app__notices__toasts.effect.vibe"
import { type Said, say } from "../notices/toasts.vibe"
import { Agent } from "../platform/agent.vibe"
import { PhoneReminders } from "../platform/reminders.vibe"
import { attemptedWith, outcomeOf } from "../platform/remote.vibe"
import { Attempts } from "../runtime/attempts.vibe"
import { type Job, answer, contained, due, reacting, run, together, untimed } from "../runtime/reactor.vibe"
import { externalStore } from "../runtime/store.ts"
import { Time } from "../runtime/time.vibe"
import { alertInstantMs, dueInstantMs, snoozeTargetMs } from "./recurrence.ts"
import { persistReminderSnapshot } from "./snapshot.vibe"
import { completeReminderOccurrence, remindersStore } from "./store.ts"

/** Optional native Android reminder alarm bridge wired by the integrator without coupling Reminders to platform internals. */
export interface NativeRemindersPort {
  schedule(input: { readonly id: string; readonly title: string; readonly body: string; readonly at: number; readonly dueAt: number }): Promise<unknown>
  cancel(id: string): Promise<unknown>
  list(): Promise<unknown>
  pendingTap(): Promise<{ readonly token?: string; readonly id?: string }>
  consumeTap(token: string): Promise<unknown>
}

let nativePort: NativeRemindersPort | undefined

/** Register an optional native Android reminders adapter for hardware alarm scheduling. */
export function setNativeRemindersPort(port: NativeRemindersPort | undefined): void {
  nativePort = port
}

/** Banner snapshot observed synchronously by the global AlertBanner overlay. */
interface RingingBannerState {
  readonly specId: number
  readonly revision: number
  readonly item: ReminderItemRecord
}

const banner = externalStore<RingingBannerState | undefined>(undefined)

/** External store for the currently ringing due-reminder notification banner. */
export const alertBannerStore = {
  snapshot: banner.snapshot,
  subscribe: banner.subscribe,
  reset(): void {
    banner.set(undefined)
  },
}

effect function syncBannerFromMachine(): void!!Alerts.Machine {
  const state = try (try Alerts.Machine).get()
  if (state.bannerId === 0) {
    banner.set(undefined)
    return
  }
  const entry = Alerts.entryOf(state.entries, state.bannerId)
  const item = remindersStore.findItemBySpecId(state.bannerId)
  if (entry.phase === "Ringing" && item !== undefined && !item.completed) {
    banner.set({ specId: state.bannerId, revision: entry.revision, item })
  } else {
    banner.set(undefined)
  }
}

effect function armNative(id: number, at: number): void!!PhoneReminders {
  const item = remindersStore.findItemBySpecId(id)
  if (item === undefined) return
  const dueAt = item.snoozedUntilMs === null ? dueInstantMs(item.dueDate, item.dueMinute) ?? at : at
  const port = nativePort
  if (port !== undefined) {
    try ignore(tryPromise(() => port.schedule({ id: item.id, title: item.title, body: item.notes, at, dueAt })))
    return
  }
  const phone = try PhoneReminders
  if (phone.present) {
    try ignore(phone.schedule({ id: item.id, title: item.title, body: item.notes, at, dueAt, alertMinutes: item.alertMinutes }))
  }
}

module binding {
  import type { AndroidReminderOperation } from "@elizaos/os-bridges"

  /** Bind exactly the native operation the renderer is about to ask Android to make. */
  export async function hash(operation: AndroidReminderOperation): Promise<string> {
    const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(JSON.stringify(operation)))
    return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join("")
  }
}
import { hash } from binding

effect function snoozeNative(id: number, at: number, itemRevision: number, attemptId: number): void!!(PhoneReminders | Attempts) {
  const item = alertedItem(id, itemRevision)
  const phone = try PhoneReminders
  if (item === undefined || item.snoozedUntilMs !== at || !phone.present) return
  const dueAt = dueInstantMs(item.dueDate, item.dueMinute)
  const list = phone.list() catch () => undefined
  const alarm = list?.reminders.find((row) => row.id === item.id && row.target.reminderId === item.id && row.target.occurrenceId === row.occurrenceId
    && !row.undated && row.dueAt === dueAt && row.title === item.title && row.body === item.notes && row.alertMinutes === item.alertMinutes)
  if (alarm === undefined) return
  const operation: AndroidReminderOperation = { type: "reminder_snooze", target: alarm.target }
  const operationId = try (try Attempts).key(attemptId)
  const bindingHash = tryPromise(() => hash(operation)) catch () => undefined
  if (bindingHash === undefined || alertedItem(id, itemRevision)?.snoozedUntilMs !== at) return
  try ignore(phone.operate({ operationId, bindingHash, operation }))
}

effect function cancelNative(item: ReminderItemRecord): void!!PhoneReminders {
  const port = nativePort
  if (port !== undefined) {
    try ignore(tryPromise(() => port.cancel(item.id)))
    return
  }
  const phone = try PhoneReminders
  if (!phone.present) return
  const list = phone.list() catch () => undefined
  const alarm = list?.reminders.find((row) => row.id === item.id && row.target.reminderId === item.id && row.target.occurrenceId === row.occurrenceId)
  if (alarm === undefined) return
  const operation: AndroidReminderOperation = { type: "reminder_cancel", target: alarm.target }
  const bindingHash = tryPromise(() => hash(operation)) catch () => undefined
  if (bindingHash === undefined) return
  try ignore(phone.cancel({ id: item.id, target: alarm.target, operationId: `cancel-${item.id}-${item.revision}`, bindingHash }))
}

effect function syncBannerAction(
  id: number,
  attemptId: number,
  mutate: (row: ReminderItemRecord, now: number) => ReminderItemRecord | undefined,
  build: (item: ReminderItemRecord, now: number, key: string) => HttpClientRequest.HttpClientRequest,
): Event!!(Agent | Time | Attempts) {
  const item = remindersStore.findItemBySpecId(id)
  if (item === undefined) return { type: "syncAnswered", id, attemptId, confirmed: false, known: true }
  const now = try (try Time).now()
  const changed = mutate(item, now)
  if (changed === undefined) return { type: "syncAnswered", id, attemptId, confirmed: false, known: true }
  const snap = remindersStore.snapshot().snapshot
  const updated = snap.items.map((row) => (row.id === item.id ? changed : row))
  remindersStore.replace({ ...snap, updatedAtMs: now, items: updated })
  const outcome = try attemptedWith(Agent, (key) => build(item, now, key), attemptId)
  return { type: "syncAnswered", id, attemptId, confirmed: outcome.confirmed, known: outcome.known }
}

effect function syncComplete(id: number, attemptId: number): Event!!(Agent | Time | Attempts) {
  return try syncBannerAction(
    id,
    attemptId,
    completeReminderOccurrence,
    (item, _now, key) => HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post(`/api/alpha/reminders/items/${encodeURIComponent(item.id)}/complete`), { idempotencyKey: key }),
  )
}

effect function syncSnooze(id: number, until: number, attemptId: number): Event!!(Agent | Time | Attempts) {
  return try syncBannerAction(
    id,
    attemptId,
    (row, now) => ({ ...row, snoozedUntilMs: until, revision: row.revision + 1, updatedAtMs: now }),
    (item, _now, key) => HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post(`/api/alpha/reminders/items/${encodeURIComponent(item.id)}/snooze`), { untilMs: until, idempotencyKey: key }),
  )
}

function alertedItem(id: number, itemRevision: number): ReminderItemRecord | undefined {
  const item = remindersStore.findItemBySpecId(id)
  const view = remindersStore.snapshot()
  return item !== undefined && item.revision === itemRevision && !view.hiddenIds.has(item.id)
    && !item.completed && item.dueDate !== null && item.alertMinutes !== null ? item : undefined
}

/** Snooze only the active alerted reminder revision selected in Calendar. */
export effect function snoozeSelectedReminder(itemId: string, itemRevision: number): void!!(Alerts.Machine | Time) {
  const id = remindersStore.specIdForItem(itemId)
  if (alertedItem(id, itemRevision)?.id !== itemId) return
  const now = try (try Time).now()
  const until = snoozeTargetMs(now, "10m")
  const alerts = try Alerts.Machine
  if (Alerts.canSnoozeFromCalendar(try alerts.get(), id, itemRevision, until, now)) {
    try contained(alerts.send({ type: "snoozeFromCalendar", id, itemRevision, until, now }), "snoozing the selected reminder")
  }
}

effect function storeCalendarSnooze(id: number, itemRevision: number, until: number, attemptId: number): Event!!(Agent | Time | Attempts | KeyValueStore.KeyValueStore | Toasts | Said) {
  const declined: Event = { type: "calendarSnoozeSaved", id, attemptId, itemRevision, stored: false, confirmed: false, known: true }
  const item = alertedItem(id, itemRevision)
  if (item === undefined) return declined
  const key = try (try Attempts).key(attemptId)
  const agent = try Agent
  const outcome = effect {
    try agent.call(HttpClientRequest.bodyJsonUnsafe(
      HttpClientRequest.post(`/api/alpha/reminders/items/${encodeURIComponent(item.id)}/snooze`),
      { untilMs: until, expectedRevision: itemRevision, idempotencyKey: key },
    ))
    return { confirmed: true, known: true, changed: false }
  } catch (failure) => ({
    ...outcomeOf(failure),
    changed: failure._tag === "Refused" && (failure.status === 404 || failure.status === 409),
  })
  const { confirmed, known } = outcome
  const now = try (try Time).now()
  if (outcome.changed) {
    try say("Changed", true)
    return { ...declined, confirmed, known }
  }
  if (until <= now || alertedItem(id, itemRevision)?.id !== item.id) return { ...declined, confirmed, known }
  const snapshot = remindersStore.snapshot().snapshot
  try persistReminderSnapshot({
    ...snapshot, version: snapshot.version + 1, updatedAtMs: now,
    items: snapshot.items.map((row) => row.id === item.id
      ? { ...row, snoozedUntilMs: until, notifiedAtMs: null, revision: row.revision + 1, updatedAtMs: now }
      : row),
  }, now)
  try say("Snoozed 10 minutes")
  return { type: "calendarSnoozeSaved", id, attemptId, itemRevision: item.revision + 1, stored: true, confirmed, known }
}

effect function syncDismiss(id: number, attemptId: number): Event!!(Agent | Time | Attempts) {
  return try syncBannerAction(
    id,
    attemptId,
    (row, now) => ({ ...row, notifiedAtMs: now, updatedAtMs: now }),
    (item, now, key) => HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.patch(`/api/alpha/reminders/items/${encodeURIComponent(item.id)}`), { notifiedAtMs: now, idempotencyKey: key }),
  )
}

function carry(fx: Out): Job<Event, Agent | Time | Attempts | Alerts.Machine | PhoneReminders | KeyValueStore.KeyValueStore | Toasts | Said, []> {
  return match (fx) {
    when { tag: "RingBanner" }: run("ring", syncBannerFromMachine());
    when { tag: "ClearBanner" }: run("clear", syncBannerFromMachine());
    when { tag: "Arm", let id, let at }: run(`arm ${id}`, armNative(id, at));
    when { tag: "ArmCalendarSnooze", let id, let at, let itemRevision, let attemptId }: run(`arm ${id}`, snoozeNative(id, at, itemRevision, attemptId));
    when { tag: "SyncComplete", let id, let attemptId }: answer(`complete ${attemptId}`, syncComplete(id, attemptId), { type: "syncAnswered", id, attemptId, confirmed: false, known: false });
    when { tag: "SyncSnooze", let id, let until, let attemptId }: answer(`snooze ${attemptId}`, syncSnooze(id, until, attemptId), { type: "syncAnswered", id, attemptId, confirmed: false, known: false });
    when { tag: "StoreCalendarSnooze", let id, let itemRevision, let until, let attemptId }: answer(`snooze selected ${attemptId}`, storeCalendarSnooze(id, itemRevision, until, attemptId), { type: "calendarSnoozeSaved", id, attemptId, itemRevision, stored: false, confirmed: false, known: false });
    when { tag: "SyncDismiss", let id, let attemptId }: answer(`dismiss ${attemptId}`, syncDismiss(id, attemptId), { type: "syncAnswered", id, attemptId, confirmed: false, known: false });
  }
}

function timers(state: Alerts.Alerts) {
  return state.entries
    .filter((entry) => Alerts.isWaiting(entry) && entry.requestedSnooze === 0)
    .map((entry) => due<Event, []>(`alert:${entry.id}`, entry.dueAt, { type: "fire", id: entry.id, now: untimed }))
}

/** Reconcile the resident alerts machine with the latest reminders snapshot at `nowMs`. */
export effect function syncAlertsWithSnapshot(snapshot: RemindersSnapshot, nowMs: number): void!!(Alerts.Machine | PhoneReminders) {
  const alerts = try Alerts.Machine
  const activeSpecIds = new Set<number>()
  for (const item of snapshot.items) {
    const specId = remindersStore.specIdForItem(item.id)
    if (specId <= 0) continue
    const triggerAt = item.completed ? null : alertInstantMs(item.dueDate, item.dueMinute, item.alertMinutes, item.snoozedUntilMs)
    if (triggerAt === null) {
      const state = try alerts.get()
      if (Alerts.canCancelAlert(state, specId)) try contained(alerts.send({ type: "cancelAlert", id: specId }), "cancelling alert")
      try cancelNative(item)
      continue
    }
    activeSpecIds.add(specId)
    const state = try alerts.get()
    const existing = Alerts.hasEntry(state.entries, specId) ? Alerts.entryOf(state.entries, specId) : undefined
    if (existing !== undefined && existing.phase === "Ringing") continue
    if (existing !== undefined && existing.dueAt === triggerAt && Alerts.isWaiting(existing)) continue
    const nextRevision = existing === undefined ? Math.max(1, item.revision) : Math.max(existing.revision + 1, item.revision)
    if (triggerAt > nowMs) {
      if (Alerts.canSchedule(state, specId, triggerAt, nextRevision, nowMs)) {
        try contained(alerts.send({ type: "schedule", id: specId, dueAt: triggerAt, revision: nextRevision, now: nowMs }), "scheduling alert")
      }
    }
  }
  const latest = try alerts.get()
  for (const entry of latest.entries) {
    if (!activeSpecIds.has(entry.id) && Alerts.canCancelAlert(latest, entry.id)) {
      try contained(alerts.send({ type: "cancelAlert", id: entry.id }), "removing stale alert")
    }
  }
  try syncBannerFromMachine()
}

/** Resident due-time alerting layer, kept across restarts and armed via `Time.until`. */
export const reminderAlerts = together(
  reacting(Alerts, { keep: 2, open: [{ type: "reopen" }], carry, timers }),
)
