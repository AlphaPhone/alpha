// spec/app/reminders/alerts.md, "Story: Alert on due reminders and act from the banner"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Reminders from "../../gen/app__reminders.effect.vibe"
import * as Alerts from "../../gen/app__reminders__alerts.effect.vibe"
import type { AlertEffect as Out, Event } from "../../gen/app__reminders__alerts.effect.vibe"
import { fromAreas } from "../home/cards.vibe"
import { Agent } from "../platform/agent.vibe"
import { PhoneReminders } from "../platform/reminders.vibe"
import { attemptedWith } from "../platform/remote.vibe"
import type { Attempts } from "../runtime/attempts.vibe"
import { type Job, answer, contained, due, reacting, run, together, untimed } from "../runtime/reactor.vibe"
import { Time } from "../runtime/time.vibe"
import { advanceDueDate, alertInstantMs, civilDayFromString, civilDayNumber, dueInstantMs, snoozeTargetMs } from "./recurrence.ts"
import { AlertBannerShelf, RemindersLedger, RemindersShelf, type RingingBannerState } from "./shelf.vibe"
import {
  type ReminderItemRecord,
  type RemindersSnapshot,
  isItemOverdue,
  priorityToSpec,
  recurrenceToSpec,
} from "./store.ts"

export type { RingingBannerState }

const snapshotKey = "alpha.reminders.snapshot@1"

effect function syncBannerFromMachine(): void!!(Alerts.Machine | AlertBannerShelf | RemindersShelf) {
  const state = try (try Alerts.Machine).get()
  const banner = (try AlertBannerShelf).shelf
  const store = (try RemindersShelf).store
  if (state.bannerId === 0) {
    banner.set(undefined)
    return
  }
  const entry = Alerts.entryOf(state.entries, state.bannerId)
  const item = store.findItemBySpecId(state.bannerId)
  if (entry.phase === "Ringing" && item !== undefined && !item.completed) {
    banner.set({ specId: state.bannerId, revision: entry.revision, item })
  } else {
    banner.set(undefined)
  }
}

effect function armNative(id: number, at: number): void!!(PhoneReminders | RemindersShelf | RemindersLedger) {
  const store = (try RemindersShelf).store
  const ledger = try RemindersLedger
  const item = store.findItemBySpecId(id)
  if (item === undefined) return
  const phone = try PhoneReminders
  if (phone.present) {
    const occurrenceId = `${item.id}:${at}`
    const revision = String(item.revision)
    const bindingHash = `${item.id}:${revision}:${at}`
    ledger.armedNative.set(item.id, { occurrenceId, bindingHash, revision })
    try ignore(phone.schedule({ id: item.id, title: item.title, body: item.notes, at, dueAt: at, alertMinutes: item.alertMinutes }))
  }
}

effect function cancelNative(item: ReminderItemRecord): void!!(PhoneReminders | RemindersLedger) {
  const ledger = try RemindersLedger
  const phone = try PhoneReminders
  const remembered = ledger.armedNative.get(item.id)
  ledger.armedNative.delete(item.id)
  if (phone.present) {
    const occurrenceId = remembered?.occurrenceId ?? `${item.id}:${item.updatedAtMs}`
    const revision = remembered?.revision ?? String(item.revision)
    const bindingHash = remembered?.bindingHash ?? `${item.id}:${revision}`
    const target = { sourceId: item.id, sourceRevision: revision, reminderId: item.id, occurrenceId, revision }
    try ignore(phone.cancel({ id: item.id, target, operationId: `cancel-${item.id}-${revision}`, bindingHash }))
  }
}

function pushHomeFromSnapshot(snapshot: RemindersSnapshot, hiddenIds: ReadonlySet<string>, nowMs: number): void {
  const dated = snapshot.items
    .filter((item) => !hiddenIds.has(item.id) && item.dueDate !== null)
    .map((item) => ({
      due: dueInstantMs(item.dueDate, item.dueMinute) ?? nowMs,
      overdue: isItemOverdue(item, nowMs),
      done: item.completed,
      title: item.title,
    }))
  fromAreas.reminders(dated)
}

/** Build a valid machine `applySync` payload from a normalized `RemindersStoreView`. */
export function buildMachineSyncArgs(
  view: ReturnType<RemindersShelf["store"]["snapshot"]>,
  minNextListId: number,
  minNextItemId: number,
  nowMs: number,
) {
  const lists = view.snapshot.lists.slice(0, 32).map((list) => ({
    id: Math.max(1, view.listSpecIds.get(list.id) ?? 1),
    isDefault: list.isDefault || list.id === "default",
    revision: 1,
  }))
  const validListSpecIds = new Set(lists.map((l) => l.id))
  let nextListId = Math.max(2, minNextListId)
  for (const l of lists) if (l.id >= nextListId) nextListId = l.id + 1
  const items = view.snapshot.items.slice(0, 200).flatMap((item) => {
    const specId = view.itemSpecIds.get(item.id) ?? 0
    if (specId <= 0) return []
    const rawListSpec = Math.max(1, view.listSpecIds.get(item.listId) ?? 1)
    const listId = validListSpecIds.has(rawListSpec) ? rawListSpec : 1
    const hasDue = item.dueDate !== null
    const dueDay = hasDue ? (civilDayFromString(item.dueDate) ?? civilDayNumber(nowMs)) : 0
    const hasDueTime = hasDue && item.dueMinute !== null && item.dueMinute >= 0 && item.dueMinute < 1440
    const dueMinute = hasDueTime ? (item.dueMinute ?? 0) : 0
    const repeat = hasDue ? recurrenceToSpec(item.recurrence) : "NoRepeat"
    return [{
      id: specId,
      listId,
      hasDue,
      dueDay,
      hasDueTime,
      dueMinute,
      repeat,
      priority: priorityToSpec(item.priority),
      flagged: item.flagged,
      completed: item.completed,
      snoozedUntil: item.snoozedUntilMs ?? 0,
      revision: Math.max(1, item.revision),
    }]
  })
  let nextItemId = Math.max(1, minNextItemId)
  for (const it of items) if (it.id >= nextItemId) nextItemId = it.id + 1
  return { syncedLists: lists, nextListId, syncedItems: items, nextItemId }
}

effect function syncBannerAction(
  id: number,
  attemptId: number,
  mutate: (row: ReminderItemRecord, now: number) => ReminderItemRecord,
  build: (updated: ReminderItemRecord, now: number, key: string) => HttpClientRequest.HttpClientRequest,
): Event!!(Agent | Time | Attempts | KeyValueStore.KeyValueStore | RemindersShelf | Reminders.Machine | Alerts.Machine | AlertBannerShelf | PhoneReminders | RemindersLedger) {
  const store = (try RemindersShelf).store
  const item = store.findItemBySpecId(id)
  if (item === undefined) return { type: "syncAnswered", id, attemptId, confirmed: false, known: true }
  const now = try (try Time).now()
  const nextItem = mutate(item, now)
  const snap = store.snapshot().snapshot
  const nextSnapshot: RemindersSnapshot = {
    ...snap,
    version: snap.version + 1,
    updatedAtMs: now,
    items: snap.items.map((row) => (row.id === item.id ? nextItem : row)),
  }
  const machine = try Reminders.Machine
  const before = try machine.get()
  const view = store.replace(nextSnapshot, null, before.nextListId, before.nextItemId)
  const encoded = Effect.try(() => JSON.stringify(view.snapshot)) catch () => undefined
  if (encoded !== undefined) try ignore((try KeyValueStore.KeyValueStore).set(snapshotKey, encoded))
  pushHomeFromSnapshot(view.snapshot, view.hiddenIds, now)
  const syncArgs = buildMachineSyncArgs(view, before.nextListId, before.nextItemId, now)
  if (Reminders.canApplySync(before, syncArgs.syncedLists, syncArgs.nextListId, syncArgs.syncedItems, syncArgs.nextItemId)) {
    try contained(machine.send({ type: "applySync", ...syncArgs }), "syncing banner action to reminders machine")
  }
  try syncAlertsWithSnapshot(view.snapshot, now)
  const outcome = try attemptedWith(Agent, (key) => build(nextItem, now, key), attemptId)
  return { type: "syncAnswered", id, attemptId, confirmed: outcome.confirmed, known: outcome.known }
}

effect function syncComplete(id: number, attemptId: number): Event!!(Agent | Time | Attempts | KeyValueStore.KeyValueStore | RemindersShelf | Reminders.Machine | Alerts.Machine | AlertBannerShelf | PhoneReminders | RemindersLedger) {
  return try syncBannerAction(
    id,
    attemptId,
    (row, now) => {
      if (row.recurrence !== "none" && row.dueDate !== null) {
        return {
          ...row,
          dueDate: advanceDueDate(row.dueDate, row.recurrence),
          subtasks: row.subtasks.map((sub) => ({ ...sub, done: false })),
          completed: false,
          completedAtMs: null,
          snoozedUntilMs: null,
          notifiedAtMs: null,
          revision: row.revision + 1,
          updatedAtMs: now,
        }
      }
      return { ...row, completed: true, completedAtMs: now, snoozedUntilMs: null, revision: row.revision + 1, updatedAtMs: now }
    },
    (updated, _now, key) => HttpClientRequest.bodyJsonUnsafe(
      HttpClientRequest.post(`/api/alpha/reminders/items/${encodeURIComponent(updated.id)}/complete`),
      { item: updated, idempotencyKey: key },
    ),
  )
}

effect function syncSnooze(id: number, until: number, attemptId: number): Event!!(Agent | Time | Attempts | KeyValueStore.KeyValueStore | RemindersShelf | Reminders.Machine | Alerts.Machine | AlertBannerShelf | PhoneReminders | RemindersLedger) {
  return try syncBannerAction(
    id,
    attemptId,
    (row, now) => ({ ...row, snoozedUntilMs: until, revision: row.revision + 1, updatedAtMs: now }),
    (updated, _now, key) => HttpClientRequest.bodyJsonUnsafe(
      HttpClientRequest.post(`/api/alpha/reminders/items/${encodeURIComponent(updated.id)}/snooze`),
      { untilMs: until, idempotencyKey: key },
    ),
  )
}

effect function syncDismiss(id: number, attemptId: number): Event!!(Agent | Time | Attempts | KeyValueStore.KeyValueStore | RemindersShelf | Reminders.Machine | Alerts.Machine | AlertBannerShelf | PhoneReminders | RemindersLedger) {
  return try syncBannerAction(
    id,
    attemptId,
    (row, now) => ({ ...row, notifiedAtMs: now, updatedAtMs: now }),
    (updated, now, key) => HttpClientRequest.bodyJsonUnsafe(
      HttpClientRequest.patch(`/api/alpha/reminders/items/${encodeURIComponent(updated.id)}`),
      { notifiedAtMs: now, idempotencyKey: key },
    ),
  )
}

/** Snooze the currently ringing banner using a fresh `Time.now()` reading so snooze duration never uses a stale render timestamp. */
export effect function snoozeAlertFromBanner(
  specId: number,
  expectedRevision: number,
  preset: "10m" | "1h" | "tomorrow",
): boolean!!(Alerts.Machine | Time) {
  const alerts = try Alerts.Machine
  const now = try (try Time).now()
  const until = snoozeTargetMs(now, preset)
  const state = try alerts.get()
  if (!Alerts.canSnoozeFromBanner(state, specId, expectedRevision, until, now)) return false
  try contained(alerts.send({ type: "snoozeFromBanner", id: specId, expectedRevision, until, now }), "snoozing reminder from banner")
  return true
}

function carry(fx: Out): Job<Event, Agent | Time | Attempts | KeyValueStore.KeyValueStore | RemindersShelf | Reminders.Machine | Alerts.Machine | AlertBannerShelf | PhoneReminders | RemindersLedger, []> {
  return match (fx) {
    when { tag: "RingBanner" }: run("ring", syncBannerFromMachine());
    when { tag: "ClearBanner" }: run("clear", syncBannerFromMachine());
    when { tag: "Arm", let id, let at }: run(`arm ${id}`, armNative(id, at));
    when { tag: "SyncComplete", let id, let attemptId }: answer(`complete ${attemptId}`, syncComplete(id, attemptId), { type: "syncAnswered", id, attemptId, confirmed: false, known: false });
    when { tag: "SyncSnooze", let id, let until, let attemptId }: answer(`snooze ${attemptId}`, syncSnooze(id, until, attemptId), { type: "syncAnswered", id, attemptId, confirmed: false, known: false });
    when { tag: "SyncDismiss", let id, let attemptId }: answer(`dismiss ${attemptId}`, syncDismiss(id, attemptId), { type: "syncAnswered", id, attemptId, confirmed: false, known: false });
  }
}

function timers(state: Alerts.Alerts) {
  return state.entries
    .filter((entry) => Alerts.isWaiting(entry))
    .map((entry) => due<Event, []>(`alert:${entry.id}`, entry.dueAt, { type: "fire", id: entry.id, now: untimed }))
}

/** Reconcile the resident alerts machine with the latest reminders snapshot at `nowMs`. */
export effect function syncAlertsWithSnapshot(snapshot: RemindersSnapshot, nowMs: number): void!!(Alerts.Machine | AlertBannerShelf | RemindersShelf | PhoneReminders | RemindersLedger) {
  const alerts = try Alerts.Machine
  const store = (try RemindersShelf).store
  const activeSpecIds = new Set<number>()
  for (const item of snapshot.items) {
    const specId = store.specIdForItem(item.id)
    if (specId <= 0) continue
    const triggerAt = item.completed ? null : alertInstantMs(item.dueDate, item.dueMinute, item.alertMinutes, item.snoozedUntilMs)
    const alreadyAcknowledged = triggerAt !== null && item.notifiedAtMs !== null && item.notifiedAtMs >= triggerAt
    if (triggerAt === null || triggerAt <= 0 || alreadyAcknowledged) {
      const state = try alerts.get()
      if (Alerts.canCancelAlert(state, specId)) try contained(alerts.send({ type: "cancelAlert", id: specId }), "cancelling alert")
      try cancelNative(item)
      continue
    }
    activeSpecIds.add(specId)
    const state = try alerts.get()
    const existing = Alerts.hasEntry(state.entries, specId) ? Alerts.entryOf(state.entries, specId) : undefined
    if (existing !== undefined && existing.phase === "Ringing") continue
    if (existing !== undefined && existing.dueAt === triggerAt && Alerts.isWaiting(existing)) continue
    if (existing !== undefined && existing.phase === "Dismissed" && existing.dueAt === triggerAt) continue
    const nextRevision = existing === undefined ? Math.max(1, item.revision) : Math.max(existing.revision + 1, item.revision)
    if (Alerts.canSchedule(state, specId, triggerAt, nextRevision, nowMs)) {
      try contained(alerts.send({ type: "schedule", id: specId, dueAt: triggerAt, revision: nextRevision, now: nowMs }), "scheduling alert")
    }
  }
  const latest = try alerts.get()
  for (const entry of latest.entries) {
    if (!activeSpecIds.has(entry.id) && Alerts.canCancelAlert(latest, entry.id)) {
      try contained(alerts.send({ type: "cancelAlert", id: entry.id }), "removing stale alert")
    }
  }
  try syncBannerFromMachine()
}

/** Resident due-time alerting layer, kept across restarts and armed via `Time.until`. */
export const reminderAlerts = together(
  reacting(Alerts, { keep: 1, open: [{ type: "reopen" }], carry, timers }),
)
