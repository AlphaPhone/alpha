// spec/app/passwords/index.md, "Story: Unlock my passwords"; spec/app/passwords/index.md, "Story: Add, change and delete a password"; spec/app/passwords/index.md, "Story: Recover a damaged vault"; spec/app/passwords/index.md, "Story: Fill passwords in"; spec/app/passwords/entry.md, "Story: Write a password entry"
import { filterEntries, normalizeWebsite, PasswordsClientError, type PasswordEntrySummary, type PasswordsStatus } from "@elizaos/os-bridges"
import * as Passwords from "../../gen/app__passwords.effect.vibe"
import type { Effect as Out, Event, Found, Result, Service as AutofillService } from "../../gen/app__passwords.effect.vibe"
import * as Settings from "../../gen/app__settings.effect.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import * as Layers from "../../gen/app__shell__layers.effect.vibe"
import { Device, registered, passwordsOf, type SystemSettings } from "../platform/index.vibe"
import { type Job, answer, contained, due, reacting, run, started, together, untimed, Time } from "../runtime/index.vibe"

/** The password manager sheet's layer id in the shell's stack. */
export const passwordsLayer = "passwords"

/** Non-secret metadata for a single saved password entry shown in the unlocked list. */
export interface SavedPasswordSummary {
  readonly id: string
  readonly name: string
  readonly username: string
  readonly websites: readonly string[]
  readonly revision: number
}

/** Non-secret form fields kept beside the password machine while editing an entry. */
export interface EntryDraft {
  readonly editingId?: string
  readonly name: string
  readonly username: string
  readonly website: string
}

/** Pluggable vault backend (native Android ElizaPasswords plugin or in-memory dev/test vault). */
export interface PasswordsBackend {
  unlock(): Promise<{ readonly ok: boolean; readonly windowMs: number; readonly damaged?: boolean }>
  lock(): Promise<void>
  list(): Promise<{ readonly found: Found; readonly entries: readonly SavedPasswordSummary[] }>
  save(draft: EntryDraft, password: string, generate: boolean, chars: number): Promise<Result>
  remove(id: string): Promise<Result>
  reset(): Promise<Result>
  status(): Promise<{ readonly service: AutofillService; readonly browserFill: boolean }>
  openAutofillSettings(): Promise<void>
  fill(origin: number, host: string): Promise<boolean>
}

/** Backup v2 contract readiness check; refuses backup grants when Google identity unlinks mid-approval. */
export interface BackupReadiness {
  readonly contractVersion: 2
  readonly ready: boolean
  readonly reason?: "identity_unlinked" | "vault_damaged" | "vault_locked"
}

/** Snapshot published to Passwords UI components (contains zero secret password strings). */
export interface PasswordVaultSnapshot {
  readonly entries: readonly SavedPasswordSummary[]
  readonly draft: EntryDraft
  readonly observationPaused: boolean
  readonly origins: ReadonlyMap<number, string>
  readonly lastFilledOrigin: number | undefined
  readonly backup: BackupReadiness
}

/** Holds non-secret summaries, form metadata, origin registry and backend hooks beside the Passwords machine. */
export service PasswordVault {
  backend(): PasswordsBackend
  setBackend(next: PasswordsBackend): void
  setEntries(entries: readonly SavedPasswordSummary[]): void
  setDraft(next: Partial<EntryDraft>): EntryDraft
  resetDraft(entry?: SavedPasswordSummary): EntryDraft
  setObservationPaused(paused: boolean): void
  registerOrigin(origin: number, host: string): void
  originHost(origin: number): string | undefined
  recordFill(origin: number): void
  evaluateBackup(input: { readonly googleLinked: boolean; readonly damaged: boolean; readonly locked: boolean }): BackupReadiness
  snapshot(): PasswordVaultSnapshot
  subscribe(listener: () => void): () => void
}

const emptyDraft: EntryDraft = { name: "", username: "", website: "" }

function mapService(status: PasswordsStatus): AutofillService {
  if (status.autofill.supported === false) return "Unsupported"
  if (status.autofill.selected === "this-app") return "Alpha"
  if (status.autofill.selected === "other") return "Other"
  if (status.autofill.selected === "none") return "NoService"
  return "NoService"
}

function toSummary(entry: PasswordEntrySummary): SavedPasswordSummary {
  return {
    id: entry.id,
    name: entry.label,
    username: entry.username,
    websites: entry.bindings.map((b) => b.display || b.facet),
    revision: entry.revision,
  }
}

function createNativeBackend(): PasswordsBackend {
  const client = passwordsOf()
  return {
    async unlock() {
      try {
        const res = await client.unlock()
        const windowMs = typeof res.unlockRemainingMs === "number" && res.unlockRemainingMs > 0 ? res.unlockRemainingMs : 60_000
        return { ok: true, windowMs }
      } catch (err) {
        if (err instanceof PasswordsClientError && err.code === "key-invalidated") {
          return { ok: false, windowMs: 60_000, damaged: true }
        }
        return { ok: false, windowMs: 60_000 }
      }
    },
    async lock() {
      await client.lock()
    },
    async list() {
      try {
        const rows = await client.list()
        return { found: "Listed", entries: rows.map(toSummary) }
      } catch (err) {
        if (err instanceof PasswordsClientError && err.code === "locked") return { found: "FoundLocked", entries: [] }
        return { found: "Unreadable", entries: [] }
      }
    },
    async save(draft, password, generate, chars) {
      try {
        const websites = draft.website.split(",").map((s) => normalizeWebsite(s.trim())).filter((s): s is string => typeof s === "string" && s.length > 0)
        await client.save({
          ...(draft.editingId ? { id: draft.editingId } : {}),
          label: draft.name.trim(),
          username: draft.username.trim(),
          websites: websites.length > 0 ? websites : [draft.website.trim()],
          ...(generate ? { generate: { length: chars } } : password ? { password } : {}),
        })
        return "Done"
      } catch (err) {
        if (err instanceof PasswordsClientError && err.code === "locked") return "WasLocked"
        if (err instanceof PasswordsClientError) return "Refused"
        return "Lost"
      }
    },
    async remove(id) {
      try {
        await client.remove(id)
        return "Done"
      } catch (err) {
        if (err instanceof PasswordsClientError && err.code === "locked") return "WasLocked"
        if (err instanceof PasswordsClientError) return "Refused"
        return "Lost"
      }
    },
    async reset() {
      try {
        await client.reset()
        return "Done"
      } catch (err) {
        if (err instanceof PasswordsClientError) return "Refused"
        return "Lost"
      }
    },
    async status() {
      const s = await client.status()
      return { service: mapService(s), browserFill: true }
    },
    async openAutofillSettings() {
      await client.openAutofillSettings()
    },
    async fill(_origin, _host) {
      return true
    },
  }
}

function createMemoryBackend(): PasswordsBackend {
  let unlocked = false
  let nextId = 1
  const items = new Map<string, SavedPasswordSummary>()
  return {
    async unlock() {
      unlocked = true
      return { ok: true, windowMs: 60_000 }
    },
    async lock() {
      unlocked = false
    },
    async list() {
      if (!unlocked) return { found: "FoundLocked", entries: [] }
      return { found: "Listed", entries: [...items.values()] }
    },
    async save(draft, _password, _generate, _chars) {
      if (!unlocked) return "WasLocked"
      const id = draft.editingId ?? `pw-${nextId++}`
      const existing = items.get(id)
      const websites = draft.website.split(",").map((s) => s.trim()).filter((s) => s.length > 0)
      items.set(id, {
        id,
        name: draft.name.trim(),
        username: draft.username.trim(),
        websites,
        revision: (existing?.revision ?? 0) + 1,
      })
      return "Done"
    },
    async remove(id) {
      if (!unlocked) return "WasLocked"
      if (!items.has(id)) return "Refused"
      items.delete(id)
      return "Done"
    },
    async reset() {
      items.clear()
      unlocked = false
      return "Done"
    },
    async status() {
      return { service: "NoService", browserFill: true }
    },
    async openAutofillSettings() {},
    async fill(_origin, host) {
      return [...items.values()].some((item) => item.websites.some((site) => site === host))
    },
  }
}

/** Filters non-secret saved password summaries by name, username and websites. */
export function matchingPasswords(entries: readonly SavedPasswordSummary[], query: string): readonly SavedPasswordSummary[] {
  const trimmed = query.trim().toLowerCase()
  if (!trimmed) return entries
  const asEliza: PasswordEntrySummary[] = entries.map((e) => ({
    id: e.id,
    label: e.name,
    username: e.username,
    bindings: e.websites.map((site) => ({ kind: "web" as const, facet: site, display: site })),
    updatedAt: 0,
    revision: e.revision,
  }))
  const filtered = filterEntries(asEliza, trimmed)
  const kept = new Set(filtered.map((item) => item.id))
  if (kept.size > 0) return entries.filter((e) => kept.has(e.id))
  return entries.filter((e) =>
    e.name.toLowerCase().includes(trimmed)
    || e.username.toLowerCase().includes(trimmed)
    || e.websites.some((site) => site.toLowerCase().includes(trimmed)))
}

const vaultService = Layer.sync(PasswordVault, () => {
  let activeBackend: PasswordsBackend = registered("ElizaPasswords") ? createNativeBackend() : createMemoryBackend()
  let entries: readonly SavedPasswordSummary[] = []
  let draft: EntryDraft = emptyDraft
  let observationPaused = false
  const origins = new Map<number, string>()
  let lastFilledOrigin: number | undefined
  let backup: BackupReadiness = { contractVersion: 2, ready: false, reason: "vault_locked" }
  const listeners = new Set<() => void>()
  let cached: PasswordVaultSnapshot = { entries, draft, observationPaused, origins: new Map(origins), lastFilledOrigin, backup }
  const notify = () => {
    cached = { entries, draft, observationPaused, origins: new Map(origins), lastFilledOrigin, backup }
    for (const listener of listeners) listener()
  }
  return {
    backend: () => activeBackend,
    setBackend: (next: PasswordsBackend) => { activeBackend = next },
    setEntries: (next: readonly SavedPasswordSummary[]) => {
      entries = next
      notify()
    },
    setDraft: (next: Partial<EntryDraft>) => {
      draft = { ...draft, ...next }
      notify()
      return draft
    },
    resetDraft: (entry?: SavedPasswordSummary) => {
      draft = entry === undefined ? emptyDraft : { editingId: entry.id, name: entry.name, username: entry.username, website: entry.websites.join(", ") }
      notify()
      return draft
    },
    setObservationPaused: (paused: boolean) => {
      observationPaused = paused
      notify()
    },
    registerOrigin: (origin: number, host: string) => {
      origins.set(origin, host)
      notify()
    },
    originHost: (origin: number) => origins.get(origin),
    recordFill: (origin: number) => {
      lastFilledOrigin = origin
      notify()
    },
    evaluateBackup: (input: { readonly googleLinked: boolean; readonly damaged: boolean; readonly locked: boolean }) => {
      backup = !input.googleLinked
        ? { contractVersion: 2, ready: false, reason: "identity_unlinked" }
        : input.damaged
          ? { contractVersion: 2, ready: false, reason: "vault_damaged" }
          : input.locked
            ? { contractVersion: 2, ready: false, reason: "vault_locked" }
            : { contractVersion: 2, ready: true }
      notify()
      return backup
    },
    snapshot: () => cached,
    subscribe: (listener: () => void) => {
      listeners.add(listener)
      return (): void => { listeners.delete(listener) }
    },
  }
})

type Needs = PasswordVault | Passwords.Machine | Device | SystemSettings | Time

effect function performUnlock(): Event!!(PasswordVault | Time) {
  const vault = try PasswordVault
  const now = try (try Time).now()
  const res = tryPromise(() => vault.backend().unlock()) catch () => ({ ok: false, windowMs: 60_000, damaged: false })
  if (res.damaged) return { type: "keyLost" }
  return { type: "unlocked", ok: res.ok, now, window: Math.max(1, res.windowMs) }
}

effect function performReadList(ticket: number): Event!!PasswordVault {
  const vault = try PasswordVault
  const res = tryPromise(() => vault.backend().list()) catch () => ({ found: "Unreadable" as Found, entries: [] as readonly SavedPasswordSummary[] })
  if (res.found === "Listed") vault.setEntries(res.entries)
  else vault.setEntries([])
  return { type: "listed", ticket, found: res.found, count: res.entries.length }
}

effect function performSave(task: number, password: string, generate: boolean, chars: number): Event!!PasswordVault {
  const vault = try PasswordVault
  const draft = vault.snapshot().draft
  const result = tryPromise(() => vault.backend().save(draft, password, generate, chars)) catch (): Result => "Lost"
  return { type: "answered", task, result }
}

effect function performRemove(task: number): Event!!PasswordVault {
  const vault = try PasswordVault
  const id = vault.snapshot().draft.editingId
  if (id === undefined) return { type: "answered", task, result: "Refused" }
  const result = tryPromise(() => vault.backend().remove(id)) catch (): Result => "Lost"
  return { type: "answered", task, result }
}

effect function performReset(task: number): Event!!PasswordVault {
  const vault = try PasswordVault
  const result = tryPromise(() => vault.backend().reset()) catch (): Result => "Lost"
  if (result === "Done") vault.setEntries([])
  return { type: "answered", task, result }
}

effect function performStatus(ticket: number): Event!!PasswordVault {
  const vault = try PasswordVault
  const res = tryPromise(() => vault.backend().status()) catch () => ({ service: "NoService" as AutofillService, browserFill: true })
  return { type: "statusRead", ticket, service: res.service, browserFill: res.browserFill }
}

effect function openAutofill(): Event!!(PasswordVault | SystemSettings) {
  const vault = try PasswordVault
  try ignore(tryPromise(() => vault.backend().openAutofillSettings()))
  return { type: "settingsClosed" }
}

function carry(fx: Out): Job<Event, Needs, []> {
  return match (fx) {
    when { tag: "Observe", let paused }: run("passwords-observe", effect {
      (try PasswordVault).setObservationPaused(paused)
      try (try Device).mark("sensitive", paused ? "passwords" : undefined)
    });
    when { tag: "Unlock" }: answer("passwords-unlock", performUnlock(), { type: "unlocked", ok: false, now: untimed, window: 60_000 });
    when { tag: "LockVault" }: run("passwords-lock", effect {
      const vault = try PasswordVault
      vault.setEntries([])
      try ignore(tryPromise(() => vault.backend().lock()))
    });
    when { tag: "ReadList", let ticket }: answer(`passwords-list-${ticket}`, performReadList(ticket), { type: "listed", ticket, found: "Unreadable", count: 0 });
    when { tag: "Save", let task, let password, let generate, let chars }: answer(`passwords-save-${task}`, performSave(task, password, generate, chars), { type: "answered", task, result: "Lost" });
    when { tag: "Remove", let task }: answer(`passwords-remove-${task}`, performRemove(task), { type: "answered", task, result: "Lost" });
    when { tag: "Reset", let task }: answer(`passwords-reset-${task}`, performReset(task), { type: "answered", task, result: "Lost" });
    when { tag: "Status", let ticket }: answer(`passwords-status-${ticket}`, performStatus(ticket), { type: "statusRead", ticket, service: "NoService", browserFill: false });
    when { tag: "AutofillSettings" }: answer("passwords-autofill", openAutofill(), { type: "settingsClosed" });
    when { tag: "Fill", let origin }: run(`passwords-fill-${origin}`, effect {
      const vault = try PasswordVault
      const host = vault.originHost(origin) ?? ""
      const filled = tryPromise(() => vault.backend().fill(origin, host)) catch () => false
      if (filled) vault.recordFill(origin)
    });
  }
}

// spec/app/passwords/index.md, "Alpha going to the background locks the vault and forgets the form; coming back shows the pages locked"
const visibility = started(effect {
  const machine = try Passwords.Machine
  const device = try Device
  try Stream.runForEach(device.visible, effect (visible) => {
    const state = try machine.get()
    if (!visible && Passwords.canBackground(state)) {
      try contained(machine.send({ type: "background" }), "locking passwords on background")
    } else if (visible && Passwords.canComeBack(state)) {
      try contained(machine.send({ type: "comeBack" }), "returning to passwords")
    }
  })
}, "passwords visibility lifecycle")

const lifecycle = started(effect {
  const machine = try Passwords.Machine
  const layers = try Layers.Machine
  const shell = try Shell.Machine
  const settings = try Settings.Machine

  const openStream = Stream.changes(Stream.map(
    Stream.zipLatest(layers.changes, Stream.zipLatest(shell.changes, settings.changes)),
    ([layerState, [shellState, settingsState]]) =>
      Layers.listed(layerState, passwordsLayer) || (Shell.showing(shellState, "Settings") && settingsState.page === "PasswordsPage"),
  ))
  try Stream.runForEach(openStream, effect (isOpen) => {
    const state = try machine.get()
    if (isOpen && Passwords.canEnter(state)) {
      try contained(machine.send({ type: "enter" }), "entering passwords")
    } else if (!isOpen && Passwords.canLeave(state)) {
      try contained(machine.send({ type: "leave" }), "leaving passwords")
    }
  })
}, "passwords page lifecycle")

/** Open the Password manager overlay sheet. */
export effect function openPasswords(): void!!Layers.Machine {
  const layers = try Layers.Machine
  if (!Layers.listed(try layers.get(), passwordsLayer)) {
    try contained(layers.send({ type: "openLayer", id: passwordsLayer, kind: "SheetLayer", covers: true }), "opening Passwords")
  }
}

/** Close the Password manager overlay sheet. */
export effect function closePasswords(): void!!Layers.Machine {
  const layers = try Layers.Machine
  if (Layers.listed(try layers.get(), passwordsLayer)) {
    try contained(layers.send({ type: "closeLayer", id: passwordsLayer }), "closing Passwords")
  }
}

/** Notify the vault that a Browser sign-in field on `origin` (`host`) has gained focus. */
export effect function focusSignInField(origin: number, host: string): boolean!!(Passwords.Machine | PasswordVault) {
  const vault = try PasswordVault
  vault.registerOrigin(origin, host)
  const machine = try Passwords.Machine
  if (!Passwords.canFieldFocused(try machine.get(), origin)) return false
  return try contained(machine.send({ type: "fieldFocused", origin }), "focusing browser sign-in field")
}

/** Ask the vault to fill a saved password strictly into the focused Browser site `origin`. */
export effect function fillSignInField(origin: number): boolean!!Passwords.Machine {
  const machine = try Passwords.Machine
  if (!Passwords.canFill(try machine.get(), origin)) return false
  return try contained(machine.send({ type: "fill", origin }), "filling browser password")
}

/** Resident passwords machine and vault service, handling sensitive-screen marking, auto-lock and browser autofill. */
export const passwords = together(
  reacting(Passwords, {
    carry,
    timers: (state) => state.lock === "Unlocked" && state.until > 0
      ? [due<Event, []>("passwords-expire", state.until, { type: "expire", now: state.until })]
      : [],
  }),
  vaultService,
  visibility,
  lifecycle,
)
