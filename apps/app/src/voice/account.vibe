// spec/app/voice/index.md, "Signing in, out or to another account changes the route, invalidates warmup, and ends a running conversation"
import * as Voice from "../../gen/app__voice.effect.vibe"
import { Device } from "../platform/device.vibe"
import { type CloudSignIn, VoiceBridge } from "../platform/voice.vibe"
import { contained, started } from "../runtime/reactor.vibe"

module pure {
  /** The number the route tells a Cloud key by: the same for the same key on every launch, and never 0, which is no key. @throws {never} */
  export function keyNumber(credential: string): number {
    let hash = 0x811c9dc5
    for (let at = 0; at < credential.length; at += 1) hash = Math.imul(hash ^ credential.charCodeAt(at), 0x01000193)
    return (hash >>> 1) + 1
  }
}
import { keyNumber } from pure

/** What voice is told where the phone's sign-in names another Cloud account or key than its route holds; nothing where the sign-in is unknown or an own key routes speech. */
function changed(voice: Voice.Voice, account: CloudSignIn): Voice.Event | undefined {
  if (account.kind === "unknown") return undefined
  if (voice.route.account !== "SignedOut" && voice.route.account !== "CloudAccount") return undefined
  const told: Voice.Event = account.kind === "signedIn"
    ? { type: "accountChanged", account: "CloudAccount", key: keyNumber(account.credential) }
    : { type: "accountChanged", account: "SignedOut", key: 0 }
  return told.account === voice.route.account && told.key === voice.route.key ? undefined : told
}

/** Voice told the phone's Cloud account: at launch, on each return to the foreground and when a sign-in settles. */
export const signedIn = started(effect {
  const bridge = try VoiceBridge
  const device = try Device
  const voice = try Voice.Machine
  const read = effect {
    const event = changed(try voice.get(), try bridge.account())
    if (event === undefined) return
    try bridge.forgetAccount()
    try contained(voice.send(event), "voice hearing the account")
  }
  try read
  try Stream.runForEach(Stream.merge(Stream.filter(device.visible, (shown) => shown), bridge.signIns), () => read)
}, "voice following the account")
