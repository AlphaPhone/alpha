// spec/app/voice/index.md, "Story: Hold a spoken conversation"; spec/app/voice/index.md, "The speech pipeline warms on startup, foreground return and account readiness without opening the microphone"; spec/app/voice/index.md, "A reply that needs the owner's review in chat keeps voice listening with the microphone open"; spec/app/voice/index.md, "An active voice conversation may ask the shell to open Home or any admitted screen"; spec/app/shell/index.md, "Agent navigation shows an admitted app or Home without lowering Ask Alpha"; spec/app/voice/index.md, "A spoken reply says a written date, clock time, range and percentage in words"; spec/app/voice/index.md, "A turn Cloud refuses because the account is out of funds ends voice quietly, as Stop does"; spec/app/assistant/reply.md, "The agent's turn tag is never drawn, copied, quoted, emailed or spoken, and a reply still being written holds back what may become one"
import { TurnController, type ConversationRecord, type TurnContext, type TurnResult, type TurnTransport } from "@elizaos/agent"
import { Machine as Conversation, type Context as Screen } from "../../gen/app__assistant.effect.vibe"
import { Machine as Chats } from "../../gen/app__assistant__chats.effect.vibe"
import { sendsOpenDocument } from "../../gen/app__assistant__context.effect.vibe"
import { Machine as Phone, clear } from "../../gen/app__phone.effect.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import * as Layers from "../../gen/app__shell__layers.effect.vibe"
import * as Voice from "../../gen/app__voice.effect.vibe"
import type { Field } from "../../gen/app__voice__dictation.ts"
import { Agent, isCloudFundsRefusal } from "../platform/agent.vibe"
import { Device } from "../platform/device.vibe"
import { Views, delivery, pageIn, preparedIn, resendWithoutMode } from "../assistant/views.vibe"
import { filesOnlyHeaders, MediaReview, sameFiles } from "../assistant/media-review.vibe"
import { Talk, type Attached, type DraftSeat } from "../assistant/talk.vibe"
import type { MessageSmsRequest } from "../messages/agent-sim.vibe"
import { SystemSettings } from "../platform/systemSettings.vibe"
import { type VoiceEvent, VoiceBridge } from "../platform/voice.vibe"
import { fresh } from "../runtime/attempts.vibe"
import { type Job, answer, applying, contained, due, following, hearing, reacting, run, started, stream, together, untimed } from "../runtime/reactor.vibe"
import { signedIn } from "./account.vibe"
import { replyBlocks } from "../assistant/words.ts"
import { replyWords } from "@repo/ui"
import { dictationClock } from "./dictation-clock.vibe"

const views: ReadonlyArray<Shell.View> = [
  "Phone", "Messages", "Inbox", "Calendar", "Clock", "Reminders", "Browser", "Camera", "Photos", "Maps", "Notes", "Contacts", "Files", "Workflows", "Wallet", "Settings",
]

export function placeOf(view: Shell.View | undefined): number {
  if (view === undefined) return 1
  const at = views.indexOf(view)
  return at >= 0 ? at + 2 : 1
}

export function viewOfPlace(place: number): Shell.View | undefined {
  return place >= 2 ? views[place - 2] : undefined
}

interface SpokenNavigation {
  readonly session: number
  readonly turn: number
  readonly place: number
  readonly sourceRoute: number
  readonly opened: Deferred.Deferred<boolean>
  readonly apply: Effect.Effect<boolean>
  readonly decline: Effect.Effect<void>
}

export interface SpokenChatLease {
  readonly session: number
  readonly turn: number
  readonly record: ConversationRecord
  readonly authority: DraftSeat["authority"]
  readonly conversation: number
  readonly current: boolean!!
  readonly verified: boolean!!
  readonly retired: Stream.Stream<void>
  settle(result: Extract<TurnResult, { kind: "Replied" }>, spoken: string): void!!
}

export interface VoiceMemory {
  chat: { readonly writer: Semaphore.Semaphore; readonly begin: (session: number, turn: number, current: boolean!!) => (SpokenChatLease | undefined)!! } | undefined
  heardText: { readonly session: number; readonly turn: number; readonly text: string } | undefined
  lastReply: string
  readonly queuedSentences: string[]
  dispatchedSentences: number
  playbackTurn: number
  playbackEpoch: number
  readonly playLock: Semaphore.Semaphore
  dictatedText: string
  dictatedDurationMs: number | undefined
  fillTarget: { readonly field: Field; readonly filling: number; readonly apply: (words: string) => void!! } | undefined
  spokenNavigation: SpokenNavigation | undefined
  /** The observation and the open Files document a turn sent now from `shown` takes with it, read as Ask Alpha reads them. */
  screen: ((shown: Screen) => {
    readonly metadata: TurnContext | undefined
    readonly sms: MessageSmsRequest | undefined
    readonly attachment: Attached | undefined
  }!!) | undefined
  /** Whether the turn's spoken acknowledgment is queued and not yet handed to speech. */
  cueWaiting: boolean
  enqueueSentence(turn: number, text: string): void
  /** Queue the turn's acknowledgment to speak at once, before any sentence of its reply. */
  enqueueCue(turn: number, text: string): void
  dequeueSentence(turn: number): { readonly text: string; readonly append: boolean } | undefined
  clearQueued(): void
}

export service VoiceWords {
  readonly memory: VoiceMemory
}

export const voiceWords = Layer.effect(VoiceWords, effect {
  const playLock = try Semaphore.make(1)
  const memory: VoiceMemory = {
    chat: undefined,
    heardText: undefined,
    lastReply: "",
    queuedSentences: [],
    dispatchedSentences: 0,
    playbackTurn: 0,
    playbackEpoch: 0,
    playLock,
    dictatedText: "",
    dictatedDurationMs: undefined,
    fillTarget: undefined,
    spokenNavigation: undefined,
    screen: undefined,
    cueWaiting: false,
    enqueueSentence(turn: number, text: string) {
      if (memory.playbackTurn !== turn) {
        memory.playbackTurn = turn
        memory.queuedSentences.length = 0
        memory.dispatchedSentences = 0
        memory.cueWaiting = false
      }
      // spec/app/assistant/reply.md, "A spoken acknowledgment starts at once; a reply ready before it is audible drops it, and an audible one finishes before the reply, within 2.5 s"
      if (memory.cueWaiting) memory.queuedSentences.shift()
      memory.cueWaiting = false
      memory.queuedSentences.push(text)
    },
    enqueueCue(turn: number, text: string) {
      if (memory.playbackTurn !== turn) {
        memory.playbackTurn = turn
        memory.queuedSentences.length = 0
        memory.dispatchedSentences = 0
      }
      if (memory.queuedSentences.length > 0 || memory.dispatchedSentences > 0) return
      memory.cueWaiting = true
      memory.queuedSentences.push(text)
    },
    dequeueSentence(turn: number) {
      if (memory.playbackTurn !== turn) return undefined
      const text = memory.queuedSentences.shift()
      if (text === undefined) return undefined
      memory.cueWaiting = false
      const append = memory.dispatchedSentences > 0
      memory.dispatchedSentences += 1
      return { text, append }
    },
    clearQueued() {
      memory.playbackEpoch += 1
      memory.queuedSentences.length = 0
      memory.dispatchedSentences = 0
      memory.cueWaiting = false
    },
  }
  return { memory }
})

// spec/app/voice/index.md, "Using the transcript fills the field dictation started in, and dictation never sends"
export effect function openDictation<R>(field: Field, apply: (words: string) => void!!R): boolean!!(Voice.Machine | VoiceWords | R) {
  const voice = try Voice.Machine
  const { memory } = try VoiceWords
  const context = try Effect.context<R>()
  const filling = (try voice.get()).recorder.filled + 1
  if (!(try contained(voice.send({ type: "openRecorder", target: field }), "opening dictation"))) return false
  memory.dictatedText = ""
  memory.dictatedDurationMs = undefined
  memory.fillTarget = { field, filling, apply: (words) => Effect.provideContext(apply(words), context) }
  return true
}

module pure {
  import { normalizePhoneNumber } from "@elizaos/os-bridges"
  import { clockWords, meridiemOf, twelveHour } from "../../gen/app__voice.ts"
  import { withoutTurnTags } from "../assistant/words.ts"

  /** An explicit spoken number before the message body. @throws {never} */
  export function addressedSms(spoken: string) {
    const command = /^(?:please\s+)?(?:text|send (?:a )?text to)\s+(\+?[0-9][0-9 ().-]{4,36}[0-9])\s*(?:[,;:]\s*|\s+saying\s+)\S[\s\S]*$/iu.exec(spoken)
    if (command?.[1] === undefined) return undefined
    const number = normalizePhoneNumber(command[1])
    return number !== null && number.replace(/\D/g, "").length >= 7 ? number : undefined
  }

  /** The approval instruction is local while the owner must approve on the phone. @throws {never} */
  export function smsConfirmation(spoken: string): boolean {
    return /^(?:(?:yes|okay|ok|please)[,\s]+)*send\s+this\s+text[.!?]?$/iu.test(spoken)
  }

  const navigateTag = /\[NAVIGATE:([a-zA-Z]+)\]/i

  /** @throws {never} */
  export function requestedDestination(text: string): string | undefined {
    const found = navigateTag.exec(text)
    return found?.[1]
  }

  /** The reply's speakable text, without the agent's turn tag: each run of spaces is one space and each line break is kept as one, so no spoken form joins two lines. @throws {never} */
  export function speakableText(text: string): string {
    return withoutTurnTags(text)
      .replace(/\[NAVIGATE:[a-zA-Z]+\]/gi, "")
      .replace(/\[(APPROVAL|PROPOSAL|REVIEW|DRAFT|CALENDAR_APPROVAL|EMAIL_DRAFT)[^\]]*\]/gi, "")
      .replace(/:[ \t]*(?=\r?\n)/g, ".")
      .replace(/\s*\n\s*/g, "\n")
      .replace(/[^\S\n]+/g, " ")
      .trimStart()
  }

  const weekdays = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
  const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"]
  const ordinals = [
    "", "first", "second", "third", "fourth", "fifth", "sixth", "seventh", "eighth", "ninth", "tenth",
    "eleventh", "twelfth", "thirteenth", "fourteenth", "fifteenth", "sixteenth", "seventeenth", "eighteenth", "nineteenth", "twentieth",
    "twenty-first", "twenty-second", "twenty-third", "twenty-fourth", "twenty-fifth", "twenty-sixth", "twenty-seventh", "twenty-eighth",
    "twenty-ninth", "thirtieth", "thirty-first",
  ]
  const ones = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine",
    "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen"]
  const tens = ["", "", "twenty", "thirty", "forty", "fifty"]

  function numberWords(n: number): string {
    if (n < 20) return ones[n] ?? String(n)
    return n % 10 === 0 ? tens[n / 10] ?? String(n) : `${tens[Math.floor(n / 10)] ?? ""} ${ones[n % 10] ?? ""}`
  }

  function namesPattern(names: readonly string[]): string {
    return names.flatMap((name) => (name.length > 3 ? [name, name.slice(0, 3)] : [name])).flatMap((name) => [name, name.toUpperCase()]).join("|")
  }

  const weekdayNames = namesPattern(weekdays)
  const monthNames = `${namesPattern(months)}|Sept|SEPT`
  const namedDate = new RegExp(
    String.raw`\b(?:(${weekdayNames})\.?,?[ \t]+)?(${monthNames})\.?[ \t]+(0?[1-9]|[12]\d|3[01])(?:st|nd|rd|th)?(?![\p{L}\d/-]|[.:]\d)`,
    "gu",
  )
  const clock = String.raw`(?:0?[1-9]|1[0-2])(?::[0-5]\d)?`
  const bareClock = String.raw`(?:[01]?\d|2[0-3]):[0-5]\d`
  const meridiem = String.raw`[ \t]*[aApP]\.?[ \t]*[mM](?:\.(?=[ \t]*[,;!?–—−-]|[ \t]+(?:\p{Ll}|[tT][oO][ \t])))?`
  const rangeSeparator = String.raw`(?:[ \t]*[-–—−][ \t]*|[ \t]+[tT][oO][ \t]+)`
  const clockEnd = String.raw`(?![\p{L}\d:/-]|\.\d)`
  const clockStart = String.raw`(?<![\p{L}\d:+./−-])`
  const clockRange = new RegExp(String.raw`${clockStart}(?:(${clock}(?:${meridiem})?)${rangeSeparator}(${clock}${meridiem})|(${bareClock})${rangeSeparator}(${bareClock}))${clockEnd}`, "gu")
  const clockWithMeridiem = new RegExp(String.raw`${clockStart}(${clock}${meridiem})${clockEnd}`, "gu")
  const bareClockTime = new RegExp(String.raw`${clockStart}${bareClock}${clockEnd}`, "gu")
  const unfinishedWeekday = new RegExp(String.raw`\b(?:${weekdayNames})\.,?(?:[ \t]+([A-Z][A-Za-z]*)\.?(?:[ \t]+0)?)?[ \t]*$`, "u")
  const unfinishedMonth = new RegExp(String.raw`\b(?:${monthNames})\.(?:[ \t]+0)?[ \t]*$`, "u")
  const unfinishedClock = new RegExp(String.raw`${clockStart}${clock}[ \t]*[ap](?:\.|\.?[ \t]*m\.(?:[ \t]+t(?:o)?)?)[ \t]*$`, "iu")

  function hidePeriods(text: string): string {
    return text.replaceAll(".", "·")
  }

  /** Returns complete written sentences and how much of the unchanged input they consumed. @throws {never} */
  export function takeCompleteSentences(buffer: string, final: boolean): { readonly ready: readonly string[]; readonly consumed: number } {
    const scan = (final ? buffer : buffer
      .replace(unfinishedWeekday, (tail, month?: string) =>
        month === undefined || months.some((name) => name.startsWith(month) || name.toUpperCase().startsWith(month)) ? hidePeriods(tail) : tail)
      .replace(unfinishedMonth, hidePeriods)
      .replace(unfinishedClock, hidePeriods))
      .replace(namedDate, hidePeriods)
      .replace(clockRange, hidePeriods)
      .replace(clockWithMeridiem, hidePeriods)
    const ready: string[] = []
    let consumed = 0
    for (const boundary of scan.matchAll(/[.!?](?=\s|$)\s*/g)) {
      if (!final && boundary[0] === "." && boundary.index + 1 === scan.length && /\d/.test(scan.charAt(boundary.index - 1))) break
      ready.push(buffer.slice(consumed, boundary.index + 1).trim())
      consumed = boundary.index + boundary[0].length
    }
    if (final) {
      const tail = buffer.slice(consumed).trim()
      if (tail !== "") ready.push(tail)
      consumed = buffer.length
    }
    return { ready, consumed }
  }

  function clockSaid(value: string): string {
    const found = /^(\d{1,2})(?::(\d{2}))?[ \t]*([ap])?/i.exec(value)
    if (found === null) return value
    const hour = Number(found[1])
    const minute = Number(found[2] ?? "0")
    const written = found[3] === undefined ? "NoMeridiem" : found[3].toLowerCase() === "p" ? "Afternoon" : "Morning"
    const period = meridiemOf(hour, written)
    const suffix = period === "Afternoon" ? " P M" : period === "Morning" ? " A M" : ""
    switch (clockWords(hour, minute, written, found[2] !== undefined)) {
      case "NoonWord": return "noon"
      case "MidnightWord": return "midnight"
      case "HourAndMinutes": return `${numberWords(twelveHour(hour))} ${minute < 10 ? "oh " : ""}${numberWords(minute)}${suffix}`
      case "HourOClock": return `${numberWords(twelveHour(hour))} o'clock`
      case "HourAlone": return `${numberWords(twelveHour(hour))}${suffix}`
    }
  }

  /** What Alpha says for a sentence of its reply: dates, clock times, ranges and percentages in words. @throws {never} */
  export function spokenForm(sentence: string): string {
    return sentence
      .replace(namedDate, (_, day: string | undefined, month: string, date: string) => {
        const fullDay = day === undefined ? undefined : weekdays.find((name) => name.toLowerCase().startsWith(day.toLowerCase()))
        const fullMonth = months.find((name) => name.toLowerCase().startsWith(month.toLowerCase())) ?? month
        return `${fullDay === undefined ? "" : `${fullDay}, `}${fullMonth} ${ordinals[Number(date)] ?? date}`
      })
      .replace(clockRange, (_, from?: string, to?: string, fromBare?: string, toBare?: string) => `${clockSaid(from ?? fromBare ?? "")} to ${clockSaid(to ?? toBare ?? "")}`)
      .replace(clockWithMeridiem, clockSaid)
      .replace(bareClockTime, clockSaid)
      .replace(/(?<![\p{L}\d:./-])(\d{1,2})[ \t]*[-–][ \t]*(\d{1,2})(?![\p{L}\d:/-]|\.\d)/gu, "$1 to $2")
      .replace(/(?<=\d)[ \t]?%(?![\p{L}\d])/gu, " percent")
      .replace(/(?<=\p{L}):(?=[ \t]+\S)/gu, ",")
      .replace(/\s+/g, " ")
  }
}
import { addressedSms, requestedDestination, smsConfirmation, speakableText, spokenForm, takeCompleteSentences } from pure

function placeForDestination(name: string): number | undefined {
  const lowered = name.toLowerCase()
  if (lowered === "home") return 1
  const matched = views.find((view) => view.toLowerCase() === lowered)
  return matched === undefined ? undefined : placeOf(matched)
}

// spec/app/assistant/context.md, "A spoken turn carries what a typed turn sent at that moment would, the view claim included"
function sendVoiceTurn(session: number, turn: number): Stream.Stream<Voice.Event, never, Agent | VoiceWords | Voice.Machine | Shell.Machine> {
  const post = (queue: Queue.Queue<Voice.Event, Cause.Done>, lease: SpokenChatLease, spoken: string, finishLocally: () => void) => effect {
    const { runtime } = try Agent
    const { memory } = try VoiceWords
    const voice = try Voice.Machine
    const chat = Option.getOrUndefined(try Effect.serviceOption(Talk))?.board
    const { record } = lease
    const rendering = try Effect.serviceOption(Views)
    const conversation = Option.getOrUndefined(try Effect.serviceOption(Conversation))
    const chats = Option.getOrUndefined(try Effect.serviceOption(Chats))
    const shell = try Shell.Machine
    const views = Option.getOrUndefined(rendering)
    const asked = views === undefined ? 0 : try views.begin()
    const source = try shell.get()
    const sourceRoute = source.route
    const screen = conversation === undefined ? undefined : try conversation.get()
    const chatPage = chats === undefined ? undefined : try chats.get()
    const shownChat = chatPage?.chosen
    const showingAtSource = screen?.context.showing
    const sourceView = source.trail.at(-1)
    const told = views !== undefined && screen !== undefined && screen.observing && !screen.context.sensitive
      && (showingAtSource?.tag === "App" ? showingAtSource.view === sourceView : showingAtSource?.tag === "Home" && sourceView === undefined)
    const observed = told && screen !== undefined && memory.screen !== undefined ? try memory.screen(screen.context) : undefined
    const recipient = addressedSms(spoken)
    const existing = chat?.snapshot().media
    if (existing?.some((card) => card.spokenSms !== undefined && card.decision !== "Deciding")) {
      chat?.change({ media: existing.filter((card) => card.spokenSms === undefined || card.decision === "Deciding") })
    }
    const room = chatPage?.chosen === lease.conversation && chatPage.page.status === "Loaded" ? record : undefined
    const selection = observed?.sms?.selection
    const smsReview = recipient === undefined || selection === undefined || room === undefined ? undefined
      : Option.getOrUndefined(try Effect.serviceOption(MediaReview))
    const handset = smsReview === undefined ? undefined : Option.getOrUndefined(try Effect.serviceOption(Phone))
    const smsCurrent = effect {
      if (room === undefined || chat === undefined || chatPage === undefined || chats === undefined || handset === undefined
        || conversation === undefined || screen === undefined || views === undefined || !(try lease.current)) return false
      const visible = try conversation.get()
      const chosen = try chats.get()
      const activeRoom = chat.known(chosen.chosen)?.record
      const speech = try voice.get()
      const where = try shell.get()
      return visible.observing && !visible.context.sensitive && visible.context.revision === screen.context.revision
        && where.route === sourceRoute && (where.assistant === "Sheet" || where.assistant === "Full") && (try views.current()) === asked
        && chosen.chosen === chatPage.chosen && chosen.page.ticket === chatPage.page.ticket && chosen.page.status === "Loaded"
        && activeRoom?.id === room.id && activeRoom.roomId === room.roomId && speech.session === session && speech.turn >= turn
        && Voice.talking(speech) && speech.phase !== "Paused" && clear(try handset.get())
    }
    const smsSession = smsReview !== undefined && (try smsCurrent) ? try smsReview.session() : undefined
    const sms = smsSession !== undefined && smsSession.capabilities.has("sms.send.v1") && (try smsCurrent)
      && recipient !== undefined && selection !== undefined && room !== undefined && chatPage !== undefined && screen !== undefined
      ? { opened: smsSession, recipient, selection, room, conversation: chatPage.chosen, revision: screen.context.revision } : undefined
    let streamed = false
    const transport: TurnTransport = {
      request(path, body, headers) {
        if (body !== undefined) streamed = false
        return runtime.request(path, body, headers)
      },
      stream(path, body, signal, headers) {
        streamed = true
        return runtime.stream(path, body, signal, headers)
      },
    }
    const controller = new TurnController(transport)
    try ignore(tryPromise(() => controller.bind(record)))
    let shown = ""
    let said = 0
    const say = (sentence: string) => {
      memory.enqueueSentence(turn, spokenForm(replyWords(sentence, true)))
      Queue.offerUnsafe(queue, { type: "sentence", session, turn })
    }
    const sayFrom = (written: string, final: boolean) => {
      const split = takeCompleteSentences(written.slice(said), final)
      said += split.consumed
      for (const sentence of split.ready) say(sentence)
    }
    let awaitingFiles = false
    let proposing = false
    let usedDirect = false
    const feed = (written: string, provisional: boolean) => {
      if (provisional || proposing || sms !== undefined) return
      const clean = speakableText(replyBlocks(written, true).words)
      if (clean.length <= shown.length) return
      shown = clean
      sayFrom(clean, false)
    }
    const observation = observed
    const current = conversation === undefined ? undefined : try conversation.get()
    const currentTurn = Voice.canSentence(try voice.get(), session, turn)
    const sameScreen = told && current !== undefined && current.observing && !current.context.sensitive && current.context.revision === screen?.context.revision
    const showing = current?.context.showing
    const file = observation?.attachment
    const entailsAttachment = sendsOpenDocument("Spoken", {
      filesShowing: sameScreen && showing?.tag === "App" && showing.view === "Files",
      readable: file?.mimeType === "text/plain",
      sensitive: current?.context.sensitive ?? true,
      currentTurn,
    })
    if (!currentTurn) {
      Queue.endUnsafe(queue)
      return
    }
    const images = entailsAttachment && file !== undefined ? [{ data: file.data, mimeType: file.mimeType, name: file.name }] : []
    // spec/app/files/index.md, "An explicit request to open or filter Files may act directly on the same idle Files view"
    const alreadyInFiles = showing?.tag === "App" && showing.view === "Files"
    const selected = observation?.metadata?.observation?.selectedObject
    const mayAskFiles = sms === undefined && sameScreen && images.length === 0 && selected?.kind !== "document"
    const review = sms === undefined && sameScreen ? Option.getOrUndefined(try Effect.serviceOption(MediaReview)) : undefined
    const files = review === undefined || !mayAskFiles || !alreadyInFiles ? undefined : try review.filesContext()
    const origin = review === undefined || !mayAskFiles || alreadyInFiles ? undefined : try review.filesOrigin(true)
    const enrolled = review === undefined ? undefined : try review.session()
    const target = review === undefined || enrolled === undefined ? undefined : try review.messageTarget()
    const voicemail = review === undefined || enrolled === undefined ? undefined : try review.voicemailTarget()
    const currentRequest = effect {
      return (try lease.current)
        && controller.conversation?.id === record.id && controller.conversation?.roomId === record.roomId
        && Voice.canSentence(try voice.get(), session, turn)
        && (views === undefined || (try views.current()) === asked)
        && (chats === undefined || (try chats.get()).chosen === shownChat)
    }
    const stillTalking = effect {
      if (conversation === undefined || chats === undefined || shownChat === undefined || views === undefined) return false
      const now = try conversation.get()
      return now.observing && !now.context.sensitive && (try currentRequest)
    }
    const atSource = effect { return (try stillTalking) && conversation !== undefined && (try conversation.get()).context.revision === screen?.context.revision }
    const readyToSend = review !== undefined && (files !== undefined ? sameFiles(files, try review.filesContext())
      : origin !== undefined && (try review.filesOrigin(true))?.route === origin.route)
    const direct = enrolled !== undefined && readyToSend && (try atSource) ? enrolled : undefined
    if (!(try lease.verified) || !(try currentRequest)) { finishLocally(); return }
    if (sms !== undefined && !(try smsCurrent)) { finishLocally(); return }
    const admittedScreen = direct === undefined ? sameScreen : try atSource
    // spec/app/assistant/reply.md, "One brief acknowledgment at most, only from the agent's acknowledgment frame, before any tool runs": it is said at once, with no hold, as the turn's first line.
    let cued = false
    let toolRan = false
    const cue = (text: string) => {
      if (sms !== undefined || cued || toolRan || said > 0 || shown !== "") return
      const line = spokenForm(speakableText(text)).trim()
      if (line === "") return
      cued = true
      memory.enqueueCue(turn, line)
      Queue.offerUnsafe(queue, { type: "sentence", session, turn })
    }
    const hooks = {
      onPreview: feed, onAcknowledgment: cue,
      onTool: (name: string) => {
        toolRan = true
        if (name === "PROPOSE_DEVICE_ACTION") {
          proposing = true
          awaitingFiles = usedDirect
        }
      },
    }
    const sent = effect (files: typeof direct) => {
      usedDirect = files !== undefined
      proposing = false
      awaitingFiles = false
      const metadata = admittedScreen ? { ...observation?.metadata, ...(views === undefined ? {} : delivery(views.clientId, files === undefined ? undefined : "direct-files-only-v1")) } : {}
      const headers = sms === undefined
        ? (files === undefined ? ((try atSource) ? enrolled?.headers : undefined) : filesOnlyHeaders(files))
        : { ...sms.opened.headers, "x-eliza-device-capabilities": "sms.send.v1" }
      return tryPromise(() => controller.send({
        text: spoken, channelType: "VOICE_DM", ...(images.length === 0 ? {} : { images }), ...(Object.keys(metadata).length === 0 ? {} : { metadata }),
      }, { stream: hooks, ...(headers === undefined ? {} : { headers }) })) catch () => undefined
    }
    const retired = Stream.merge(lease.retired, Stream.as(Stream.filter(voice.changes, (current) => !Voice.canSentence(current, session, turn)), undefined))
    const stopped = Effect.as(Stream.runHead(retired), undefined)
    const result = try Effect.ensuring(Effect.raceFirst(effect {
      const first = try sent(direct)
      return resendWithoutMode(first, direct !== undefined) && (try lease.verified) && (try currentRequest) ? try sent(undefined) : first
    }, stopped), effect {
      if (controller.pending) try ignore(tryPromise(() => controller.interrupt()))
    })
    if (!(try currentRequest)) {
      Queue.offerUnsafe(queue, { type: "replyEnds", session, turn, asks: false })
      Queue.endUnsafe(queue)
      return
    }
    if (isCloudFundsRefusal(result)) {
      memory.lastReply = ""
      Queue.offerUnsafe(queue, { type: "refusedForFunds", session, turn })
      Queue.endUnsafe(queue)
      return
    }
    if (result?.kind === "Replied") try lease.settle(result, spoken)
    let filesReport: string | undefined
    if (usedDirect && direct !== undefined && review !== undefined && awaitingFiles && streamed
      && result?.kind === "Replied" && result.reply.userMessageId !== undefined && result.reply.failureKind === undefined) {
      const message = result.reply.userMessageId
      const report = (note: string) => { filesReport = note }
      if (files !== undefined) try review.spokenFiles(direct, message, { files, current: atSource, report }, result.reply.actionResults)
      if (origin !== undefined && conversation !== undefined && screen !== undefined && (try atSource)) {
        const open = (source: Effect.Effect<boolean>) => openRouteForVoice(placeOf("Files"), origin.route, session, turn, effect {
          return (try source) && Shell.canAgentOpenFilesFrom(try shell.get(), origin.source, origin.panel, origin.route, true)
        }, memory, voice, shell)
        const changes = Stream.merge(Stream.map(conversation.changes, () => undefined), Stream.map(voice.changes, () => undefined))
        try review.spokenFilesFrom(direct, message, { origin, current: stillTalking, report },
          { view: conversation, revision: screen.context.revision, moved: succeed(true), open, changes }, result.reply.actionResults)
      }
    }
    if (!Voice.canSentence(try voice.get(), session, turn)) {
      Queue.endUnsafe(queue)
      return
    }
    let smsShown = false
    if (sms !== undefined && smsReview !== undefined && chat !== undefined && streamed && result?.kind === "Replied"
      && result.reply.userMessageId !== undefined && result.reply.failureKind === undefined && (try smsCurrent)) {
      const card = try smsReview.spokenSms(sms.opened, result.reply.userMessageId, result.reply.actionResults, {
        recipient: sms.recipient, selection: sms.selection, conversation: sms.conversation, revision: sms.revision,
        room: sms.room, session, current: smsCurrent,
      })
      if (card !== undefined && (try smsCurrent) && Voice.canSentence(try voice.get(), session, turn)) {
        chat.change({ media: [...chat.snapshot().media, card] })
        smsShown = true
      }
    }
    const finalText = sms !== undefined ? (smsShown ? "Review the text on your phone." : "I couldn’t prepare the text for review.")
      : filesReport ?? (result?.kind === "Replied" ? result.reply.text : "")
    if (sms === undefined && !awaitingFiles && result?.kind === "Replied" && result.reply.failureKind === undefined) {
      const actions = result.reply.actionResults
      const page = admittedScreen && views !== undefined ? pageIn(actions, views.clientId) : undefined
      const prepared = admittedScreen && views !== undefined ? preparedIn(actions, views.clientId) : undefined
      const held = page !== undefined ? { asked, page } : prepared !== undefined ? { asked, handoff: prepared } : undefined
      if (views !== undefined && held !== undefined) {
        const sameSource = effect { return (try atSource) && (try shell.get()).route === sourceRoute }
        try views.spoken(held, sameSource, (place) =>
          openRouteForVoice(placeOf(place === "Home" ? undefined : place), sourceRoute, session, turn, atSource, memory, voice, shell))
      } else if (!actions.some((action) => action.action === "VIEWS")) {
        const requested = requestedDestination(finalText)
        const place = requested === undefined ? undefined : placeForDestination(requested)
        if (place !== undefined) try openRouteForVoice(place, sourceRoute, session, turn, currentRequest, memory, voice, shell)
      }
    }
    if (!Voice.canSentence(try voice.get(), session, turn)) {
      Queue.endUnsafe(queue)
      return
    }
    let asks = smsShown
    if (!usedDirect && review !== undefined && enrolled !== undefined && chat !== undefined && chats !== undefined
      && chatPage !== undefined && chatPage.around === 0 && conversation !== undefined && screen !== undefined && streamed
      && result?.kind === "Replied" && result.reply.userMessageId !== undefined && result.reply.failureKind === undefined
      && (try atSource) && (try shell.get()).route === sourceRoute && (try lease.verified)) {
      const message = result.reply.userMessageId
      const revision = screen.context.revision
      const pageTicket = chatPage.page.ticket
      const reply = {
        clientMessageId: result.clientMessageId, conversationId: record.id, pageTicket, actionResults: result.reply.actionResults,
        spoken: { session, current: lease.verified },
        ...(observation?.sms === undefined ? {} : { sms: observation.sms }),
        ...(voicemail === undefined ? {} : { voicemail }),
      }
      const before = try shell.get()
      let panelRoute = sourceRoute
      if (before.assistant === "Bar" && (try review.hasSpokenReview(enrolled, message, reply))) {
        const raised = try contained(shell.send({ type: "raise", detent: "Sheet" }, (state) => state.route === sourceRoute
          && state.assistant === "Bar" && Effect.runSync(atSource)), "showing the review from Talk")
        if (raised) panelRoute += 1
      }
      const panel = try shell.get()
      if ((panel.assistant === "Sheet" || panel.assistant === "Full") && panel.route === panelRoute && (try atSource)
        && (try chats.get()).page.ticket === pageTicket) {
        const cards = try Effect.provideService(review.pending(enrolled, message, lease.conversation, revision, target, reply), Conversation, conversation)
        if (cards.length > 0 && (try atSource) && (try lease.verified) && (try shell.get()).route === panelRoute && (try chats.get()).page.ticket === pageTicket) {
          const existing = chat.snapshot().media
          chat.change({ media: [...existing, ...cards.filter((card) => !existing.some((same) => same.id === card.id && same.digest === card.digest))] })
          asks = true
        }
      }
    }
    memory.lastReply = finalText
    if (asks) {
      Queue.offerUnsafe(queue, { type: "replyEnds", session, turn, asks: true })
      Queue.endUnsafe(queue)
      return
    }
    const full = speakableText(replyBlocks(finalText).words)
    sayFrom(full.length >= shown.length ? full : shown, true)
    Queue.offerUnsafe(queue, { type: "replyEnds", session, turn, asks: false })
    Queue.endUnsafe(queue)
  }
  return Stream.callback<Voice.Event, never, Agent | VoiceWords | Voice.Machine | Shell.Machine>((queue) => effect {
    const { memory } = try VoiceWords
    const voice = try Voice.Machine
    const chat = Option.getOrUndefined(try Effect.serviceOption(Talk))?.board
    const heard = memory.heardText
    memory.heardText = undefined
    const spoken = heard?.session === session && heard.turn === turn ? heard.text.trim() : ""
    const finishLocally = (words?: string) => {
      if (words !== undefined) {
        memory.enqueueSentence(turn, words)
        Queue.offerUnsafe(queue, { type: "sentence", session, turn })
      }
      Queue.offerUnsafe(queue, { type: "replyEnds", session, turn, asks: false })
      Queue.endUnsafe(queue)
    }
    if (spoken === "" || !Voice.canSentence(try voice.get(), session, turn)) {
      finishLocally()
      return
    }
    if (smsConfirmation(spoken)) {
      const card = chat?.snapshot().media.find((one) => one.spokenSms !== undefined)
      const open = card?.spokenSms !== undefined && (try card.spokenSms.current)
      finishLocally(open ? "Tap Approve on the text review." : "There’s no text open for review.")
      return
    }
    const shared = memory.chat
    if (shared !== undefined) {
      const current = effect { return Voice.canSentence(try voice.get(), session, turn) }
      const carried = try shared.writer.withPermitsIfAvailable(1)(effect {
        const abandoned = Effect.as(Stream.runHead(Stream.filter(voice.changes, (state) => !Voice.canSentence(state, session, turn))), undefined)
        const lease = try Effect.raceFirst(shared.begin(session, turn, current), abandoned)
        if (lease === undefined) return false
        try post(queue, lease, spoken, finishLocally)
        return true
      })
      if (Option.isSome(carried) && carried.value) return
    }
    finishLocally()
  })
}

// spec/app/voice/index.md, "An active voice conversation may ask the shell to open Home or any admitted screen"; spec/app/voice/index.md, "An exact spoken Files request may follow its own leased navigation once"; spec/app/shell/index.md, "Only a spoken move from its exact source route is marked as Talk's navigation"
effect function openRouteForVoice(place: number, sourceRoute: number, session: number, turn: number, current: Effect.Effect<boolean>,
  memory: VoiceMemory, voice: Voice.Machine.Shape, shell: Shell.Machine.Shape): boolean!! {
  const before = try shell.get()
  if (before.route !== sourceRoute || memory.spokenNavigation !== undefined || !(try current)) return false
  const target = viewOfPlace(place)
  if (target === undefined ? !Shell.canAgentGoHome(before) : Shell.showing(before, target)) return true
  if (!Voice.canAgentNavigates(try voice.get(), session, turn, place, sourceRoute)) return false
  const opened = try Deferred.make<boolean>()
  const allowed = () => Effect.runSync(current)
  let lease: SpokenNavigation
  let reserved = false
  const owns = (now: Voice.Voice) => now.session === session && now.turn === turn && now.claim === place && now.claimRoute === sourceRoute + 1
  const apply = effect {
    const guard = () => {
      const now = Effect.runSync(voice.get())
      return reserved && memory.spokenNavigation === lease && !Deferred.isDoneUnsafe(opened)
        && owns(now) && Voice.canSentence(now, session, turn) && allowed()
    }
    return target === undefined
      ? try contained(shell.send({ type: "agentHomeSpoken", route: sourceRoute }, guard), "going Home for Talk")
      : try contained(shell.send({ type: "agentOpenSpoken", view: target, route: sourceRoute }, guard), "opening the view for Talk")
  }
  const decline = effect {
    if (memory.spokenNavigation !== lease || (try Deferred.isDone(opened))) return
    const held = reserved
    reserved = false
    if (held) try contained(voice.send({ type: "claimReleased", session }, owns), "releasing the spoken route")
    try Deferred.succeed(opened, false)
  }
  lease = { session, turn, place, sourceRoute, opened, apply, decline }
  memory.spokenNavigation = lease
  return try Effect.ensuring(effect {
    const claimed = try contained(voice.send({ type: "agentNavigates", session, turn, place, sourceRoute }, (now) => {
      reserved = memory.spokenNavigation === lease && Voice.canAgentNavigates(now, session, turn, place, sourceRoute) && allowed()
      return reserved
    }), "claiming the spoken route")
    if (!claimed) return false
    return try Deferred.await(opened)
  }, effect {
    try decline
    if (memory.spokenNavigation === lease) memory.spokenNavigation = undefined
  })
}

effect function navigateLeased(session: number, turn: number, place: number, sourceRoute: number): void!!VoiceWords {
  const lease = (try VoiceWords).memory.spokenNavigation
  if (lease === undefined || lease.session !== session || lease.turn !== turn || lease.place !== place || lease.sourceRoute !== sourceRoute) return
  try Effect.ensuring(effect {
    if (try lease.apply) try Deferred.succeed(lease.opened, true)
  }, lease.decline)
}

effect function dictationVisible(): boolean!!(Device | Layers.Machine | VoiceBridge) {
  if (!(try (try Device).showing()) || Layers.assistantInert(try (try Layers.Machine).get())) return false
  return try (try VoiceBridge).dictationForeground()
}

function carryVoice(fx: Voice.Effect): Job<Voice.Event, Agent | Device | Layers.Machine | VoiceBridge | VoiceWords | SystemSettings | Shell.Machine | Voice.Machine, []> {
  return match (fx) {
    when { tag: "Prewarm", let network }: run("prewarm", effect { try (try VoiceBridge).prewarm(network) });
    when { tag: "HoldEngine" }: run("holdEngine", effect { try (try VoiceBridge).holdEngine() });
    when { tag: "ReleaseEngineHold" }: run("releaseEngineHold", effect { try (try VoiceBridge).releaseEngineHold() });
    when { tag: "AskMicrophone" }: answer("permission", effect {
      const grant = try (try VoiceBridge).requestPermission()
      return { type: "answerPrompt", granted: grant === "granted" }
    }, { type: "answerPrompt", granted: false });
    when { tag: "OpenSettings" }: run("openSettings", effect { try (try SystemSettings).open("AppPermissions", "") });
    when { tag: "Listen", let session, let network }: answer("mic", effect {
      const opened = effect { try (try VoiceBridge).openMic(session, network); return true } catch () => false
      return opened ? { type: "micOpened", session } : { type: "micFailed", session }
    }, { type: "micFailed", session });
    when { tag: "SetSpeakerOutput", let session, let speakerTicket, let muted }: answer(`speaker ${session}:${speakerTicket}`, effect {
      const confirmed = try (try VoiceBridge).setSpeakerMuted(session, muted)
      return { type: "speakerSet", session, speakerTicket, muted, confirmed }
    }, { type: "speakerSet", session, speakerTicket, muted, confirmed: false });
    when { tag: "CloseMicrophone", let session }: answer("mic", effect {
      const closed = effect { try (try VoiceBridge).closeMic(session); return true } catch () => false
      return closed ? { type: "micClosed", session } : { type: "micCloseFailed", session }
    }, { type: "micCloseFailed", session });
    when { tag: "Send", let session, let turn }: stream(`send ${session}:${turn}`, sendVoiceTurn(session, turn), { type: "replyEnds", session, turn, asks: false });
    when { tag: "Play", let session, let turn }: answer(`play ${session}:${turn}:${fresh()}`, effect {
      const { memory } = try VoiceWords
      const bridge = try VoiceBridge
      const voice = try Voice.Machine
      const epoch = memory.playbackEpoch
      const current = effect {
        return memory.playbackEpoch === epoch && Voice.canSentencePlayed(try voice.get(), session, turn)
      }
      try Semaphore.withPermit(memory.playLock, effect {
        if (!(try current)) return
        try bridge.awaitSpeechOutputWarmup(session)
        if (!(try current)) return
        const piece = memory.dequeueSentence(turn)
        if (piece !== undefined) try ignore(bridge.playSentence(session, turn, piece.text, piece.append))
      })
      return { type: "sentencePlayed", session, turn }
    }, { type: "sentencePlayed", session, turn });
    when { tag: "Hush", let turn }: run("hush", effect {
      (try VoiceWords).memory.clearQueued()
      try (try VoiceBridge).hush(turn)
    });
    when { tag: "Shut", let session }: answer("shut", effect {
      (try VoiceWords).memory.clearQueued()
      const confirmed = try (try VoiceBridge).shut(session)
      return { type: "stopped", confirmed }
    }, { type: "stopped", confirmed: false });
    when { tag: "Navigate", let session, let turn, let place, let sourceRoute }: run("spoken navigation", navigateLeased(session, turn, place, sourceRoute));
    when { tag: "Record", let ticket }: answer("record", effect {
      const current = try (try Voice.Machine).get()
      if (Voice.canRecordingStarted(current, ticket)) {
        const { memory } = try VoiceWords
        memory.dictatedText = ""
        memory.dictatedDurationMs = undefined
      }
      const started = effect { try (try VoiceBridge).startRecording(ticket); return true } catch () => false
      return started ? { type: "recordingStarted", ticket } : { type: "recordingFailed", ticket, failure: "NoMicrophone" }
    }, { type: "recordingFailed", ticket, failure: "NoMicrophone" });
    when { tag: "Transcribe", let ticket, let network, let automatic }: answer("transcribe", effect {
      if (automatic && !(try dictationVisible())) return { type: "transcribed", ticket, failure: "AgentUnavailable" } as Voice.Event
      const result = try (try VoiceBridge).transcribe(ticket, network, automatic)
      if (result.kind === "lost") return { type: "clipLost", ticket }
      const trimmed = result.kind === "recognized" ? result.text.trim() : ""
      const failure = result.kind === "obscured" ? "AgentUnavailable" : result.kind === "failed" ? "Recognition" : trimmed === "" ? "NoSpeech" : "NoFailure"
      const current = try (try Voice.Machine).get()
      if (Voice.canTranscribed(current, ticket, failure)) {
        const { memory } = try VoiceWords
        memory.dictatedText = trimmed
        memory.dictatedDurationMs = result.durationMs
      }
      return { type: "transcribed", ticket, failure } as Voice.Event
    }, { type: "transcribed", ticket, failure: "Recognition" });
    when { tag: "Abandon", let recording }: run(`abandon ${recording}`, effect { try (try VoiceBridge).abandon(recording) });
    when { tag: "Fill", let field, let filling }: run(`fill ${filling}`, effect {
      const { memory } = try VoiceWords
      const target = memory.fillTarget
      if (target?.field !== field || target.filling !== filling) return
      const words = memory.dictatedText.trim()
      memory.fillTarget = undefined
      memory.dictatedText = ""
      memory.dictatedDurationMs = undefined
      if (words !== "") try target.apply(words)
    });
  }
}

const autoPrewarm = started(effect {
  const voice = try Voice.Machine
  try Stream.runForEach(voice.changes, effect (state) => {
    if (!state.warmed && !state.latched && !state.prompting) {
      try contained(voice.send({ type: "prewarm", now: untimed }), "prewarming voice")
    }
  })
}, "auto-prewarming voice")

const visibility = started(effect {
  const device = try Device
  const bridge = try VoiceBridge
  const voice = try Voice.Machine
  try Stream.runForEach(device.visible, effect (shown) => {
    if (shown) {
      try bridge.invalidateCache()
      try contained(voice.send({ type: "returned" }), "voice foreground return")
    } else {
      const current = try voice.get()
      if (current.recorder.field === "MessagesBar" && Voice.canCloseRecorder(current)) try contained(voice.send({ type: "closeRecorder" }), "discarding message dictation in the background")
      try contained(voice.send({ type: "pageHidden" }), "voice page hidden")
    }
  })
}, "voice visibility")

const navigation = started(effect {
  const shell = try Shell.Machine
  const voice = try Voice.Machine
  let last: { readonly place: number; readonly route: number } | undefined
  try Stream.runForEach(shell.changes, effect (state) => {
    const place = placeOf(state.trail.at(-1))
    const previous = last
    last = { place, route: state.route }
    if (previous === undefined || state.route === previous.route) return
    const spoken = state.spokenRoute === state.route
    if (place === previous.place && !spoken) return
    try contained(voice.send({ type: "navigated", place, arrivedRoute: state.route, spoken }), "voice observing navigation")
  })
}, "voice observing shell navigation")

// spec/app/voice/index.md, "A call pauses the conversation: the microphone closes, speech stops, and the turn in flight is dropped"
export const voiceWithCalls = started(effect {
  const phone = try Phone
  const voice = try Voice.Machine
  const calls = Stream.changes(Stream.map(phone.changes, (state) => state.telecom === "OrdinaryCall" || state.telecom === "MaybeEmergencyCall"))
  try Stream.runForEach(Stream.zipLatest(calls, voice.changes), effect ([live, speech]) => {
    if (live && speech.recorder.field === "MessagesBar" && Voice.canCloseRecorder(speech)) try contained(voice.send({ type: "closeRecorder" }), "discarding message dictation during a call")
    else if (live && Voice.canPauseForCall(speech)) try contained(voice.send({ type: "pauseForCall" }), "pausing voice during a call")
    else if (!live && Voice.canCallEnded(speech)) try contained(voice.send({ type: "callEnded" }), "resuming voice after a call")
  })
}, "voice observing calls")

// spec/app/voice/index.md, "A failed conversation ends quietly: why it failed is kept only until voice returns to idle, and nothing is shown"
const quietly = following(Voice.Machine, (voice) => voice.phase === "Failed", Voice.Machine, (failed): Voice.Event | undefined => (failed ? { type: "dismiss" } : undefined))

// spec/app/voice/dictation.md, "A microphone failure ends dictation quietly and a failed transcription keeps its clip"
const dictationQuietly = following(Voice.Machine, (voice) => voice.recorder.stage === "Ready" && voice.recorder.failure !== "NoFailure", Voice.Machine, (failed): Voice.Event | undefined => (failed ? { type: "closeRecorder" } : undefined))

// spec/app/voice/index.md, "Using the transcript fills the field dictation started in, and dictation never sends"
const messageTranscript = following(Voice.Machine, (voice) => voice.recorder.field === "MessagesBar" && Voice.canFill(voice), Voice.Machine,
  (ready): Voice.Event | undefined => ready ? { type: "fill" } : undefined)

const discardedDictation = applying(Voice.Machine, (voice) => voice.recorder, effect (recorder) => {
  if (recorder.stage !== "Closed") return
  const latest = (try (try Voice.Machine).get()).recorder
  if (latest.stage !== "Closed" || latest.ticket !== recorder.ticket) return
  const { memory } = try VoiceWords
  if (memory.fillTarget === undefined || memory.fillTarget.filling <= recorder.filled) return
  memory.fillTarget = undefined
  memory.dictatedText = ""
  memory.dictatedDurationMs = undefined
})

const bridgeEvents = hearing(
  Stream.unwrap(effect {
    const bridge = try VoiceBridge
    const { memory } = try VoiceWords
    const voice = try Voice.Machine
    return Stream.mapEffect(bridge.events, effect (event: VoiceEvent): (Voice.Event | undefined)!!(Device | Layers.Machine | VoiceBridge) => {
      if (event.kind === "speechEnd" || (event.kind === "transcript" && event.final)) {
        const state = try voice.get()
        if (event.text !== "" && state.session === event.session && state.phase === "Listening") {
          memory.heardText = { session: state.session, turn: state.turn, text: event.text }
        }
      }
      return match (event) {
        when { kind: "speechStart", let session }: { type: "speechHeard", session };
        when { kind: "transcript", let session, let final }: final ? { type: "turnEnded", session } : { type: "speechHeard", session };
        when { kind: "speechEnd", let session }: { type: "turnEnded", session };
        when { kind: "bargeIn", let session, let echo }: { type: "bargeIn", session, echo };
        when { kind: "ended", let session, let reason }: reason === "ended"
          ? undefined
          : { type: "speechFailed", session, fault: "NotTheNetwork", wait: 0, deviceReady: false, now: untimed };
        when { kind: "recordingStopped", let ticket, let recorded }: recorded
          ? { type: "recordingStopped", ticket, showing: try dictationVisible(), now: untimed }
          : { type: "recordingFailed", ticket, failure: "NoMicrophone" };
      }
    })
  }),
  Voice.Machine,
  (event) => event,
)

export const voicing = Layer.provideMerge(
  together(
    reacting(Voice, {
      keep: 1,
      open: [{ type: "restart" }],
      carry: carryVoice,
      timers: (v) => (v.retryAt > 0 ? [due("retry", v.retryAt, { type: "retryDue", now: untimed })] : []),
    }),
    autoPrewarm,
    dictationClock,
    visibility,
    navigation,
    bridgeEvents,
    signedIn,
    quietly,
    dictationQuietly,
    messageTranscript,
    discardedDictation,
  ),
  voiceWords,
)
