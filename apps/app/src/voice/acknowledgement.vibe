// spec/voice/acknowledgement.md, "Story: Hear that Alpha is working on it, never over its answer"; spec/assistant/reply.md, "A spoken cue waits 300 ms and is dropped when the reply is ready first; an audible cue finishes before the reply, within 2.5 s"
import { spokenCue } from "../assistant/cue.vibe"
import { Machine, machine, type Activity, type Event } from "../../gen/voice__acknowledgement.effect.vibe"
import { Speech } from "./speech.vibe"

/** A planner status of the turn in flight: its activity and the model's own line for it, if any. */
export interface TurnStatus {
  readonly activity: string
  readonly label?: string
}

/** The one spoken acknowledgement a voice turn may play while its reply is prepared. */
export interface Acknowledgement {
  /** A status of the turn arrived; `microphoneClear` says whether the capture is closed or held open for barge-in. */
  readonly progress: (status: TurnStatus, microphoneClear: () => boolean) => void!!
  /** Reply text is ready: a held or still-prepared cue is dropped, an audible one is given its bound. */
  readonly preempt: () => void!!
  /** Preempt, then settle once the reply may speak: the cue never spoke, ended, or reached its bound. */
  readonly idle: () => void!!
  /** The turn aborted, Stop was pressed, the owner spoke over it or voice retired: the cue stops at once. */
  readonly cancel: () => void!!
  /** Whether the cue is audible now. */
  readonly audible: () => boolean!!
}

/** The cue activity a reply stream's status names. */
export function activityOf(activity: string): Activity {
  if (activity === "thinking") return "Thinking"
  if (activity === "running_action") return "RunningAction"
  if (activity === "running_tool") return "RunningTool"
  return "OtherActivity"
}

/** One turn's acknowledgement: its line admitted over a cue Machine of its own, then held, dropped or bounded by the assistant's `spokenCue` and spoken on the reply channel. */
export effect function acknowledgement() {
  const speech = try Speech
  const held = try Effect.provide(effect { return try Machine }, machine())
  let microphoneClear: () => boolean = () => false
  let released: Fiber.Fiber<void> | undefined

  effect function send(event: Event) {
    return held.send(event) catch () => undefined
  }

  effect function say(line: string, started: void!!) {
    if (!microphoneClear()) return
    const heard = () => effect {
      if ((try send({ type: "audible" })) !== undefined) try started
    }
    try ensuring(effect { speech.speak(line, "Replies", { onStarted: heard }) catch () => undefined }, effect { try send({ type: "ended" }) })
  }

  const cue = try spokenCue(say)

  effect function preempt() {
    const after = try send({ type: "replyReady" })
    if (after === undefined) return
    released = fork.detached cue.replyReady()
  }

  const shape: Acknowledgement = {
    effect progress(status: TurnStatus, clear: () => boolean) {
      const line = status.label?.trim() ?? ""
      const before = try held.get()
      const after = try send({ type: "progress", activity: activityOf(status.activity), labelChars: line.length, microphoneClear: clear() })
      if (after === undefined || before.used || !after.used) return
      microphoneClear = clear
      try cue.say(line)
    },
    preempt,
    effect idle() {
      try preempt()
      const waiting = released
      if (waiting !== undefined) try Fiber.await(waiting)
    },
    effect cancel() {
      try send({ type: "cancel" })
      try cue.cancel()
    },
    effect audible() { return (try held.get()).speaking },
  }
  return shape
}
