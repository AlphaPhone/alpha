// spec/voice/acknowledgement.md, "Story: Hear that Alpha is working on it, never over its answer"
import { Machine, cueHoldMs, cueReplyBoundMs, machine, replyMayStart, type Activity, type Event } from "../../gen/voice__acknowledgement.effect.vibe"
import { Speech } from "./speech.vibe"

/** A planner status of the turn in flight: its activity and the model's own line for it, if any. */
export interface TurnStatus {
  readonly activity: string
  readonly label?: string
}

/** The one spoken acknowledgement a voice turn may play while its reply is prepared. */
export interface Acknowledgement {
  /** A status of the turn arrived; `microphoneClear` says whether the capture is closed or held open for barge-in. */
  readonly progress: (status: TurnStatus, microphoneClear: () => boolean) => void!!
  /** Reply text is ready: a held or still-prepared cue is dropped, an audible one is given its bound. */
  readonly preempt: () => void!!
  /** Preempt, then settle once the reply may speak: an audible cue ended or its bound passed. */
  readonly idle: () => void!!
  /** The turn aborted, Stop was pressed, the owner spoke over it or voice retired: the cue stops at once. */
  readonly cancel: () => void!!
  /** Whether the cue is audible now. */
  readonly audible: () => boolean!!
}

/** The cue activity a reply stream's status names. */
export function activityOf(activity: string): Activity {
  if (activity === "thinking") return "Thinking"
  if (activity === "running_action") return "RunningAction"
  if (activity === "running_tool") return "RunningTool"
  return "OtherActivity"
}

/** One turn's acknowledgement over a cue Machine of its own, spoken on the reply channel. */
export effect function acknowledgement() {
  const speech = try Speech
  const held = try Effect.provide(effect { return try Machine }, machine())
  const over = try Deferred.make<void>()

  effect function send(event: Event) {
    const after = held.send(event) catch () => undefined
    if (after !== undefined && after.stage === "Ended") try Deferred.succeed(over, undefined)
    return after
  }

  effect function speakCue(line: string, microphoneClear: () => boolean) {
    try sleep(cueHoldMs)
    const ready = try send({ type: "holdElapsed", microphoneClear: microphoneClear() })
    if (ready === undefined || ready.stage !== "Preparing") return
    const started = () => effect {
      const heard = try send({ type: "audible" })
      if (heard === undefined) try speech.stop("Replies")
    }
    speech.speak(line, "Replies", { onStarted: started }) catch () => undefined
    try send({ type: "cueEnded" })
  }

  effect function bound() {
    try sleep(cueReplyBoundMs)
    const cut = try send({ type: "boundElapsed" })
    if (cut !== undefined) try speech.stop("Replies")
  }

  effect function preempt() {
    const before = try held.get()
    const after = try send({ type: "replyReady" })
    if (after === undefined) return
    if (before.stage === "Preparing") try speech.stop("Replies")
    if (after.bounded) fork.detached bound()
  }

  const cue: Acknowledgement = {
    effect progress(status: TurnStatus, microphoneClear: () => boolean) {
      const line = status.label?.trim() ?? ""
      const after = try send({ type: "progress", activity: activityOf(status.activity), labelChars: line.length, microphoneClear: microphoneClear() })
      if (after?.stage === "Held") fork.detached speakCue(line, microphoneClear)
    },
    preempt,
    effect idle() {
      try preempt()
      if (replyMayStart(try held.get())) return
      try Deferred.await(over)
    },
    effect cancel() {
      const before = try held.get()
      const after = try send({ type: "cancel" })
      if (after !== undefined && (before.stage === "Preparing" || before.stage === "Audible")) try speech.stop("Replies")
    },
    effect audible() { return (try held.get()).stage === "Audible" },
  }
  return cue
}
