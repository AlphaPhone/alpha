// spec/app/voice/listener.md, "Story: See and control the listener"
import { Sense, parseListenerStatus, parseListenerStopReceipt, type ListenerStatus } from "@elizaos/os-bridges"
import * as Model from "../../gen/app__voice__listener.effect.vibe"
import { Machine as Settings } from "../../gen/app__settings.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { say } from "../notices/toasts.vibe"
import { Device, registered } from "../platform/device.vibe"
import { type Job, answer, reacting, started, stop, together } from "../runtime/reactor.vibe"

type Stop = "pause" | "turnOff"

effect function haveListener(): boolean!!Device {
  const { image } = try (try Device).capabilities()
  return image && registered("ElizaSense")
}

function reportOf(status: Extract<ListenerStatus, { available: true }>): Model.Report {
  return {
    on: status.state !== "OFF" || status.microphoneOpen,
    mic: status.microphoneOpen,
    consent: status.consented,
    fresh: status.listening,
    lost: status.state === "STOPPED_INDICATOR_LOST",
    paused: status.state === "PAUSED_USER",
  }
}

function failed(ticket: number): Model.Event { return { type: "failed", ticket } }

effect function read(ticket: number, stop?: Stop): Model.Event!!Device {
  if (!(try haveListener())) return failed(ticket)
  const reply = effect {
    const within = try Effect.timeoutOption(tryPromise(() => stop === undefined ? Sense.status() : Sense[stop]()), "5 seconds")
    if (Option.isNone(within)) return failed(ticket)
    const status = stop === undefined ? parseListenerStatus(within.value) : parseListenerStopReceipt(within.value, stop)
    return status.available ? { type: "answered", ticket, report: reportOf(status) } as const : failed(ticket)
  } catch () => failed(ticket)
  return reply
}

function carry(out: Model.Effect): Job<Model.Event, Device, []> {
  return match (out) {
    when { tag: "ReadStatus", let ticket }: answer("listener status", read(ticket), failed(ticket));
    when { tag: "Pause", pausing: let ticket }: answer("pause listener", read(ticket, "pause"), failed(ticket));
    when { tag: "TurnOff", stopping: let ticket }: answer("turn off listener", read(ticket, "turnOff"), failed(ticket));
    when { tag: "StartVoice" }: stop("listener wake");
  }
}

effect function refreshListener(): void!!Model.Machine {
  const machine = try Model.Machine
  if (Model.canRefresh(try machine.get())) try ignore(machine.send({ type: "refresh" }))
}

/** The listener's own screen is the only place that can obtain consent and turn it on. */
export effect function openListenerSettings() {
  if (!(try haveListener()) || !(try (try Device).showing())) return
  const opened = tryPromise(() => Sense.openSettings()) catch () => ({ opened: false })
  if (!opened.opened) try say("Listening settings unavailable", true)
}

const followingDevice = started(effect {
  const listener = try Model.Machine
  if (try haveListener()) try ignore(listener.send({ type: "admit", image: true }))
  const foreground = (try Device).visible
  const views = Stream.zipLatest((try Shell).changes, (try Settings).changes)
  const privacy = Stream.map(views, ([shell, settings]) => showing(shell, "Settings") && settings.page === "Privacy")
  const showingPrivacy = Stream.map(Stream.zipLatest(privacy, foreground), ([shown, visible]) => shown && visible)
  try Stream.runForEach(Stream.filter(Stream.changes(showingPrivacy), (shown) => shown), () => refreshListener())
}, "admitting and refreshing the listener")

export const listener = together(reacting(Model, { carry }), followingDevice)
