// spec/app/voice/listener.md, "Story: See and control the listener"; spec/app/voice/listener.md, "Story: Wake Alpha by voice or with a button"
import * as Listener from "../../gen/app__voice__listener.effect.vibe"
import * as Voice from "../../gen/app__voice.effect.vibe"
import * as Layers from "../../gen/app__shell__layers.effect.vibe"
import { Device } from "../platform/index.vibe"
import { type Job, answer, contained, reacting, run, started, together, untimed } from "../runtime/index.vibe"

/** The phone's always-on wake listener, available only on an Alpha image. */
service ListenerPort {
  status(): Listener.Report!!
  pause(): Listener.Report!!
  turnOff(): Listener.Report!!
}

/** Default stock-Android listener port: reports the listener off because stock Android carries none. */
export const stockListener = Layer.succeed(ListenerPort, {
  status: () => succeed(Listener.quietReport),
  pause: () => succeed(Listener.quietReport),
  turnOff: () => succeed(Listener.quietReport),
})

effect function readStatus(ticket: number): Listener.Event!!ListenerPort {
  const report = try (try ListenerPort).status()
  return { type: "answered", ticket, report } as Listener.Event
}

effect function pauseListener(ticket: number): Listener.Event!!ListenerPort {
  const report = try (try ListenerPort).pause()
  return { type: "answered", ticket, report } as Listener.Event
}

effect function stopListener(ticket: number): Listener.Event!!ListenerPort {
  const report = try (try ListenerPort).turnOff()
  return { type: "answered", ticket, report } as Listener.Event
}

function carry(fx: Listener.Effect): Job<Listener.Event, ListenerPort | Voice.Machine, []> {
  return match (fx) {
    when { tag: "ReadStatus", let ticket }: answer("listener status", readStatus(ticket), { type: "failed", ticket });
    when { tag: "Pause", let pausing }: answer("listener pause", pauseListener(pausing), { type: "failed", ticket: pausing });
    when { tag: "TurnOff", let stopping }: answer("listener turn off", stopListener(stopping), { type: "failed", ticket: stopping });
    when { tag: "StartVoice" }: run("listener start voice", effect {
      try contained((try Voice.Machine).send({ type: "startTalking", now: untimed }), "waking voice from listener")
    });
  }
}

const admitImage = started(effect {
  const device = try Device
  const listener = try Listener.Machine
  const image = (try device.capabilities()).image
  if (Listener.canAdmit(try listener.get(), image)) {
    try contained(listener.send({ type: "admit", image }), "admitting listener on Alpha image")
  }
}, "admitting listener")

const wakeHandOff = started(effect {
  const listener = try Listener.Machine
  const device = try Device
  const layers = try Layers.Machine
  const voice = try Voice.Machine
  try Stream.runForEach(Stream.zipLatestAll(listener.changes, layers.changes, voice.changes), effect ([state, front, speech]) => {
    if (!state.invoked) return
    const hidden = !(try device.showing())
    const dialog = Layers.pageInert(front)
    const prompt = speech.prompting
    const active = speech.phase !== "Idle" && speech.phase !== "Failed"
    if (Listener.canTake(state, hidden, dialog, prompt, active)) {
      try contained(listener.send({ type: "take", hidden, dialog, prompt, active }), "taking queued voice wake")
    }
  })
}, "handling listener wakes")

/** The always-on listener machine for an Alpha image, over `ListenerPort`. */
export const listener = together(
  reacting(Listener, { carry }),
  admitImage,
  wakeHandOff,
)
