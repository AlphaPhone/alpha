// spec/voice/listener.md, "Story: Use the listener only on the image that admits it"; spec/voice/listener.md, "Story: See and stop what the listener is doing"; spec/voice/listener.md, "Story: Start voice from my listener or the power button, once"; spec/voice/listener.md, "Invocations are bound to the agent session the resident verified, and none is taken while no session is bound"; spec/voice/listener.md, "A pending power press is discarded, never kept, while the screen cannot start voice"
import { parseAssistantInvocation, parseInvocationUnlocked, parseListenerStatus, parseListenerStopReceipt, type AssistantInvocation } from "@elizaos/os-bridges"
import { Build } from "../platform/build.vibe"
import { Native } from "../platform/native.vibe"
import { ResidentControl, type ResidentSession } from "../platform/resident-control.vibe"
import { Machine, screenFree, type Event, type Listener as ListenerState, type ListenerMode, type Origin, type Stop } from "../../gen/voice__listener.effect.vibe"
import { sessionKey } from "./ids.ts"
import { newId } from "../platform/ids.ts"
import { SettingsOpened } from "./native.schema.vibe"

/** The listener as Alpha shows it: whether the image has one, what it is doing, whether it listens and holds the microphone, and the Sense bridge's own state. */
export interface ListenerStatus {
  readonly available: boolean
  readonly mode: ListenerMode
  readonly consented: boolean
  readonly listening: boolean
  readonly microphoneOpen: boolean
  readonly state?: string
}

/** A Pause or Turn off answer: the status it leaves, also as `status`, confirmed only when the listener saved it with the microphone closed. */
export interface ListenerStopAnswer extends ListenerStatus {
  readonly confirmed: boolean
  readonly status: ListenerStatus
}

/** What the screen is doing when an invocation is taken. */
export interface InvocationScreen {
  readonly unlocked: boolean
  readonly visible: boolean
  readonly dialogOpen: boolean
  readonly connectionPrompt: boolean
  readonly voiceActive: boolean
  /** The signed-in account a protected power launch was granted for, when the account area knows it; the cold launch is claimed once under it, and a first free take without it settles the launch unclaimed. */
  readonly powerAccountRef?: string
}

/** The always-on listener of the Alpha image: status, Pause, Turn off, its settings, the startup stop and invocations. Never turns listening on. */
export service Listener {
  /** The listener state now and after each change. */
  readonly changes: Stream.Stream<ListenerState>
  /** The listener state at this moment. */
  get(): ListenerState!!
  /** Decide once whether this image admits the listener, and stop a listener left on where it does not. */
  boot(): void!!
  /** Read the listener's status; a read issued before an action or another read is not shown. */
  status(): ListenerStatus!!
  /** Pause listening until the owner resumes it in the listener's own screen. */
  pause(): ListenerStopAnswer!!
  /** Turn listening off; consent is kept, and only the listener's own screen turns it on. */
  turnOff(): ListenerStopAnswer!!
  /** Open the listener's own consent and settings screen. */
  openSettings(): boolean!!
  /** Bind a verified session's opaque authority, or none, to the listener's invocation bridge; the resident's session is bound by itself. */
  bindSession(authority: string | null): void!!
  /** Take the pending invocation once, first claiming the protected power launch that started Alpha cold; true when it starts a voice conversation. A screen that cannot start voice discards a pending power press and that launch instead. */
  takeInvocation(screen: InvocationScreen): boolean!!
}

const SENSE = "ElizaSense"
const STOP_DEADLINE = "5 seconds"
const decodeOpened = Schema.decodeUnknownOption(SettingsOpened)

/** The Sense bridge's state as the mode Alpha shows. */
export function modeOf(state: string | undefined): ListenerMode {
  if (state === undefined) return "Unavailable"
  if (state === "LISTENING") return "ListeningOn"
  if (state === "OFF") return "ListeningOff"
  if (state === "STOPPED_AFTER_ERRORS" || state === "STOPPED_INDICATOR_LOST") return "StoppedByListener"
  if (state.startsWith("PAUSED_")) return "ListeningPaused"
  return "NeedsSetup"
}

function originOf(invocation: AssistantInvocation): Origin {
  if (invocation === null) return "NothingPending"
  if (invocation === "listener") return "ListenerWake"
  if (invocation === "system") return "SystemGesture"
  if (invocation === "power") return "PowerPress"
  return "AssistOnly"
}

const unavailable: ListenerStatus = { available: false, mode: "Unavailable", consented: false, listening: false, microphoneOpen: false }

/** The opaque authority of a verified resident session: its owner, agent, generation and service launch, never a credential. */
export function authorityOf(session: ResidentSession | undefined): string | null {
  return session === undefined ? null : JSON.stringify([session.owner, session.agent, session.generation, session.epoch])
}

/** The listener service over the listener Machine it is given. */
export const listenerService = Layer.effect(Listener, effect {
  const held = try Machine
  const native = try Native
  const build = try Build
  const control = try ResidentControl
  const bindingId = newId()
  let generation = 0
  let boundKey: string | null = null
  let launchSettled = false

  effect function send(event: Event) {
    held.send(event) catch () => undefined
  }

  function statusOf(raw: unknown): ListenerStatus {
    const reply = parseListenerStatus(raw)
    if (!reply.available) return unavailable
    const mode = modeOf(reply.state)
    return { available: mode !== "Unavailable", mode, consented: reply.consented, listening: reply.listening, microphoneOpen: reply.microphoneOpen, state: reply.state }
  }

  function confirmsStop(raw: unknown, stop: Stop): boolean {
    const shown = parseListenerStatus(raw)
    if (!shown.available && shown.reason === "not-installed") return true
    return parseListenerStopReceipt(raw, stop === "TurnOffListening" ? "turnOff" : "pause").available
  }

  effect function admitted() {
    return (try held.get()).image === "ListenerAdmitted"
  }

  effect function boot() {
    if ((try held.get()).booted) return
    const android = build.info.variant !== "browser"
    const declared = android && (try native.available(SENSE)) && build.info.variant === "aosp"
    try send({ type: "boot", aosp: build.info.variant === "aosp", declared, android })
    if ((try held.get()).wakeStop !== "StopPending") return
    const reply = timeout(native.invoke(SENSE, "turnOff", {}), STOP_DEADLINE) catch () => undefined
    const confirmed = reply !== undefined && confirmsStop(reply, "TurnOffListening")
    try send({ type: "wakeStopAnswered", inTime: reply !== undefined, reportedOff: confirmed, microphoneClosed: confirmed })
  }

  effect function status() {
    if (!(try admitted())) return unavailable
    const before = try held.get()
    try send({ type: "beginRead" })
    const token = (try held.get()).issued
    if (token === before.issued) return statusOf(undefined)
    const raw = native.invoke(SENSE, "status", {}) catch () => undefined
    const read = statusOf(raw)
    try send({ type: "readAnswered", token, mode: read.mode, microphoneOpen: read.microphoneOpen })
    const shown = try held.get()
    return { ...read, mode: shown.mode, microphoneOpen: shown.microphoneOpen }
  }

  effect function stopWith(stop: Stop) {
    const before = try held.get()
    try send({ type: "beginStop", stop })
    if (!(try held.get()).busy) {
      const kept: ListenerStatus = { available: before.image === "ListenerAdmitted", mode: before.mode, consented: true, listening: before.mode === "ListeningOn",
        microphoneOpen: before.microphoneOpen }
      const refused: ListenerStopAnswer = { ...kept, confirmed: false, status: kept }
      return refused
    }
    const raw = native.invoke(SENSE, stop === "PauseListening" ? "pause" : "turnOff", {}) catch () => undefined
    const confirmed = raw !== undefined && confirmsStop(raw, stop)
    const read = statusOf(raw)
    try send({ type: "stopAnswered", confirmed, mode: confirmed ? read.mode : before.mode })
    const after = try held.get()
    const status: ListenerStatus = { ...read, available: true, mode: after.mode, listening: after.mode === "ListeningOn", microphoneOpen: after.microphoneOpen }
    const answer: ListenerStopAnswer = { ...status, confirmed, status }
    return answer
  }

  effect function bindSession(authority: string | null) {
    if (!(try admitted())) return
    const key = authority === null ? null : try (tryPromise(() => sessionKey(authority)) catch () => null)
    if (key === boundKey && generation > 0) return
    generation += 1
    const answered = timeout(native.invoke(SENSE, "bindInvocationSession", { generation, bindingId, sessionKey: key }), STOP_DEADLINE) catch () => undefined
    boundKey = answered === undefined ? null : key
    try send({ type: "sessionBound", bound: boundKey !== null })
  }

  effect function followSession() {
    try bindSession(authorityOf(try control.session()))
  }

  effect function claimedLaunch(binding: { readonly generation: number; readonly bindingId: string; readonly sessionKey: string }, accountRef: string | undefined) {
    if (launchSettled) return undefined
    launchSettled = true
    if (accountRef === undefined) return undefined
    const launch = timeout(native.invoke(SENSE, "claimProtectedPowerLaunch", { ...binding, accountRef }), STOP_DEADLINE) catch () => undefined
    return parseAssistantInvocation(launch) === "power" ? launch : undefined
  }

  effect function takeInvocation(screen: InvocationScreen) {
    if (!(try admitted()) || boundKey === null) return false
    const binding = { generation, bindingId, sessionKey: boundKey }
    if (!screenFree(screen.visible, screen.dialogOpen, screen.connectionPrompt, screen.voiceActive)) {
      try send({ type: "powerDiscarded", visible: screen.visible, dialogOpen: screen.dialogOpen, connectionPrompt: screen.connectionPrompt, voiceActive: screen.voiceActive })
      if (!launchSettled) {
        launchSettled = true
        timeout(native.invoke(SENSE, "discardProtectedPowerLaunch", binding), STOP_DEADLINE) catch () => undefined
      }
      timeout(native.invoke(SENSE, "discardProtectedPowerInvocation", binding), STOP_DEADLINE) catch () => undefined
      return false
    }
    const launch = try claimedLaunch(binding, screen.powerAccountRef)
    const raw = launch ?? (timeout(native.invoke(SENSE, "takeInvocation", binding), STOP_DEADLINE) catch () => undefined)
    const origin = originOf(parseAssistantInvocation(raw))
    if (origin === "NothingPending") return false
    const out = held.send({ type: "invocationTaken", origin, unlocked: screen.unlocked && parseInvocationUnlocked(raw), visible: screen.visible,
      dialogOpen: screen.dialogOpen, connectionPrompt: screen.connectionPrompt, voiceActive: screen.voiceActive }) catch () => undefined
    return out !== undefined && out.out.includes("StartVoice")
  }

  fork.detached effect {
    try boot()
    try followSession()
    for try (const _ of control.changes) try followSession()
  }

  return {
    changes: held.changes,
    get: () => held.get(),
    boot,
    status,
    pause: () => stopWith("PauseListening"),
    turnOff: () => stopWith("TurnOffListening"),
    effect openSettings() {
      if (!(try admitted())) return false
      const raw = native.invoke(SENSE, "openSettings", {}) catch () => undefined
      return Option.getOrUndefined(decodeOpened(raw))?.opened === true
    },
    bindSession,
    takeInvocation,
  }
})
