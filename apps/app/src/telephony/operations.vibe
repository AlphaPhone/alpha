// spec/telephony/actions.md, "Story: Call or text only the person I approved"; spec/telephony/actions.md, "A view change that shows the outcome waits for the reply that carries it"; spec/telephony/actions.md, "An action starts once per operation ID, and a number the owner did not write is refused"; spec/telephony/actions.md, "A dispatched effect settles with what the phone answered, and a lost answer is unconfirmed, never nothing"; spec/telephony/actions.md, "A read, a keypad, a filtered list or a draft settles without any effect"; spec/telephony/actions.md, "An unconfirmed text is settled only by the phone's own send record for its operation ID"; spec/assistant/review.md, "A direct effect needs an allow-listed operation of the current message that is not a workflow step, with review-first off"; spec/assistant/receipts.md, "An action is reconciled as applied only with its exact saved receipt, and only a handoff may stay unresolved"; spec/voice/conversation.md, "A reply whose only card is one addressed text keeps voice listening and says the text is ready"
import type { ExecutorCall } from "@elizaos/agent/client"
import type { Op, Target } from "../../gen/assistant__review.effect.vibe"
import type { Result } from "../../gen/assistant__receipts.effect.vibe"
import type { Settled } from "../../gen/telephony__actions.effect.vibe"
import type { OperationPorts } from "../assistant/review.vibe"
import { Navigation } from "../shell/navigation.vibe"
import { AlreadyRan, composeTargetOf, contactNumbersGrounded, contactNumbersOf, grounded, NotATelephonyOperation, telephonyOperationOf, TelephonyActions, type Present, type Refusal, type TelephonyOperation, type TelephonyType } from "./actions.vibe"
import { TelephonyBridges } from "./bridges.vibe"
import { TelephonyCalls } from "./ports.vibe"

const APPLIED: ReadonlySet<Settled> = new Set(["Applied", "EmergencyHandoff"])
const CODES: Record<Settled, string> = {
  Applied: "applied", EmergencyHandoff: "emergency-handoff", NothingFound: "not-found", OwnerCancelled: "cancelled", Unavailable: "unavailable",
  NotDone: "failed", Unconfirmed: "unknown", Refused: "refused", Busy: "busy", Occupied: "occupied", NoneSelected: "none-selected", Stale: "stale",
}

const TITLES: Readonly<Record<TelephonyType, string>> = {
  phone_call: "Call", phone_dial: "Open the dialer", sms_send: "Send a text", mms_send: "Send pictures", sms_compose: "Text",
  sms_reply_selected: "Draft a reply", contact_create: "Add a contact", contact_update: "Change a contact", contact_delete: "Remove a contact",
  messages_read_selected: "Read this conversation", voicemail_read_selected: "Read this voicemail", voicemail_delete_selected: "Delete this voicemail",
  sms_latest_sender: "Check who texted last", phone_keypad: "Open the keypad", contact_show: "Show contacts", contact_read_selected: "Read this contact",
}

/** The guard's own words when it refused (spec/telephony/actions.md, "An effect dispatches only after a fresh call-state reading allows it"). */
export const EMERGENCY_SENTENCE = "Nothing was done during a call that may be an emergency call."
/** A number the owner did not write, refused before anything was looked up. */
export const UNGROUNDED_SENTENCE = "Nothing was called, sent or saved: that number isn't one you wrote."

const SAID: Record<Exclude<Settled, "Applied">, string> = {
  EmergencyHandoff: "Emergency number opened in the dialer.", NothingFound: "No matching contact was found.", OwnerCancelled: "Cancelled.",
  Unavailable: "Not available on this phone right now.", NotDone: "It did not go through.", Unconfirmed: "The phone could not confirm it.",
  Refused: "Nothing was done.", Busy: "Another call is in progress.", Occupied: "A message is already being sent there.",
  NoneSelected: "Nothing is open to act on.", Stale: "The contact changed, so it was left as is.",
}

/** The receipt sentence of each result kind by its status: one short sentence of what the phone observed, never that a call connected or a text was delivered unless the phone said so. */
const SENTENCES: Record<string, Record<string, string>> = {
  "phone-call": {
    placed: "Call started.", "emergency-handoff": "Emergency number opened in the dialer.", "not-found": "No contact with a phone number matched.",
    busy: "Another call is in progress.", cancelled: "Call cancelled.", unavailable: "Calls are unavailable right now.", failed: "The call could not start.",
  },
  "phone-dial": {
    "handed-off": "Phone app opened with the number.", cancelled: "Dial cancelled.", unavailable: "No phone app could open the number.",
    failed: "The phone app could not be opened.",
  },
  "contact-write": {
    saved: "Contact saved.", deleted: "Contact deleted.", "not-found": "No matching contact was found.", stale: "The contact changed, so it was left as is.",
    cancelled: "Contact change cancelled.", unavailable: "Contacts are unavailable right now.", unknown: "The phone could not confirm the contact change.",
    failed: "The contact change failed.",
  },
  "sms-compose": {
    drafted: "Draft added to the conversation, not sent.", submitted: "Message handed to Android.", sent: "Message sent.", delivered: "Message delivered.",
    unknown: "The phone could not confirm the message was sent.", "not-found": "No contact with a phone number matched.", cancelled: "Message cancelled.",
    unavailable: "Messages are unavailable right now.", failed: "The message was not sent.",
  },
  "sms-send": {
    submitted: "Message handed to Android.", sent: "Message sent.", delivered: "Message delivered.", cancelled: "Message cancelled.",
    denied: "The message was not sent because access changed.", failed: "Sending failed, and some parts may have gone out.",
    unknown: "The phone could not confirm the message was sent.",
  },
  "sms-reply": {
    drafted: "Draft added to the open conversation, not sent.", "none-selected": "No conversation is open.", occupied: "That conversation is busy.",
    unavailable: "Drafts are unavailable right now.",
  },
  "voicemail-delete": {
    deleted: "Voicemail deleted.", "none-selected": "No voicemail is open.", cancelled: "Voicemail kept.", unavailable: "Voicemail is unavailable right now.",
    failed: "The voicemail could not be deleted.",
  },
  "contact-show": { shown: "Contacts shows the matching contacts.", "not-found": "No matching contact was found.", unavailable: "Contacts are unavailable right now." },
  "contact-read": { read: "Shared the open contact.", "none-selected": "No contact is open.", unavailable: "Contacts are unavailable right now." },
  "phone-keypad": { opened: "The keypad is open. Nothing was dialed.", unavailable: "Phone is unavailable right now. Nothing was dialed." },
  "sms-latest-sender": {
    found: "Checked who texted last.", empty: "No incoming SMS messages.", "sender-unavailable": "The latest incoming SMS has no readable phone number.", unavailable: "Messages are unavailable right now.",
  },
  "messages-read": { read: "Shared the open thread.", "none-selected": "No message thread is open.", unavailable: "Messages are unavailable right now." },
  "voicemail-read": { read: "Shared the open voicemail.", "none-selected": "No voicemail is open.", unavailable: "Voicemail is unavailable right now." },
}

/** The result kind each operation reports, for an operation whose result carries none (an approved `sms_send` reports the send record itself). */
const RESULT_KIND: Record<string, string> = {
  phone_call: "phone-call", phone_dial: "phone-dial", sms_send: "sms-send", sms_compose: "sms-compose", sms_reply_selected: "sms-reply",
  contact_create: "contact-write", contact_update: "contact-write", contact_delete: "contact-write", voicemail_delete_selected: "voicemail-delete",
  contact_show: "contact-show", contact_read_selected: "contact-read", phone_keypad: "phone-keypad", sms_latest_sender: "sms-latest-sender",
  messages_read_selected: "messages-read", voicemail_read_selected: "voicemail-read",
}

/** What one run settled as, as the receipt reads it: the outcome, the phone's own status where it answered, and why it was refused where it was. */
export interface RunOutcome { readonly settled: Settled; readonly status?: string; readonly refusal?: Refusal }

/** The phone's own status in a run's result, where it carried one. */
export function statusOf(result: unknown): string | undefined {
  return typeof result === "object" && result !== null && "status" in result && typeof result.status === "string" ? result.status : undefined
}

/** The receipt sentence for a run of `type`, from the refusal, the phone's status, the outcome, or else the receipt result alone. */
export function sentenceOf(type: string, outcome: RunOutcome | undefined, result: Result): string {
  if (outcome?.refusal === "emergency") return EMERGENCY_SENTENCE
  if (outcome?.refusal === "ungrounded") return UNGROUNDED_SENTENCE
  const kind = RESULT_KIND[type]
  const byStatus = kind === undefined || outcome?.status === undefined ? undefined : SENTENCES[kind]?.[outcome.status]
  if (byStatus !== undefined) return byStatus
  if (outcome !== undefined) return outcome.settled === "Applied" ? "Done." : SAID[outcome.settled]
  return match (result) {
    when "Applied": "Done.";
    when "Unknown": SAID.Unconfirmed;
    when "Failed": SAID.NotDone;
    when "NotStarted": SAID.Refused;
    default: "";
  }
}

/** The card's title: a draft request says it drafts, and every other text says it sends. */
export function titleOf(op: TelephonyOperation): string {
  if (op.type === "sms_compose") return "draft" in op && op.draft === true ? "Draft a text" : "Send a text"
  return TITLES[op.type]
}

/** The direct-pass class of a telephony operation: only a bare keypad and a filtered Contacts list are views; every call, text, read and contact change is a reviewed comms act. */
export function classOf(op: TelephonyOperation | undefined): Op {
  if (op?.type === "contact_show" || (op?.type === "phone_keypad" && op.number === undefined)) return "OpenView"
  return "CommsAct"
}

/**
 * Whether the operation is a text that sends to the number or numbers its card shows: an `sms_send`, or an `sms_compose` to a
 * number that is not a draft. A text to a contact name still has its recipient chosen on the phone (spec/voice/conversation.md,
 * "A reply whose only card is one addressed text keeps voice listening and says the text is ready").
 */
export function addressedTextOf(op: TelephonyOperation | undefined): boolean {
  if (op?.type === "sms_send") return true
  return op?.type === "sms_compose" && !("draft" in op && op.draft === true) && composeTargetOf(op).kind === "number"
}

const READS: ReadonlySet<string> = new Set(["messages_read_selected", "voicemail_read_selected", "contact_read_selected", "sms_latest_sender"])

/** Whether an unknown outcome of the operation may stay unresolved in action history: every telephony action that is not a read. */
export function handoffOf(op: TelephonyOperation | undefined): boolean {
  return op === undefined || !READS.has(op.type)
}

/**
 * Of the capabilities the agent `offered`, those this phone advertises in `x-eliza-device-capabilities`: only what the device
 * runs (`own`, none off the image) and the agent offered, and the latest-sender v2 form only with v1 itself.
 */
export function advertisedOf(own: readonly string[], offered: readonly string[]): readonly string[] {
  const kept = own.filter((capability) => offered.includes(capability))
  return kept.includes("sms.latest-sender.v1") ? kept : kept.filter((capability) => capability !== "sms.latest-sender.v2")
}

/** Telephony's part of the device capability header, read when a turn is sent, for the shell's DeviceCapabilities. */
export effect function telephonyCapabilities(offered: readonly string[]) {
  const actions = try TelephonyActions
  return advertisedOf((actions.capabilities() catch () => [] as readonly string[]), offered)
}

/** What a telephony operation targets against the owner's words: a written number, a contact name, or nothing. */
export function targetOf(op: TelephonyOperation | undefined, text: string): Target {
  if (op === undefined) return { tag: "NoTarget" }
  if (op.type === "sms_send") return { tag: "NumberTarget", matches: op.recipients.every((n) => grounded(text, { kind: "number", number: n }, op.body)) }
  if (op.type === "phone_keypad" && typeof op.number === "string") return { tag: "NumberTarget", matches: grounded(text, { kind: "number", number: op.number }) }
  if ((op.type === "contact_create" || op.type === "contact_update") && contactNumbersOf(op).length > 0)
    return { tag: "NumberTarget", matches: contactNumbersGrounded(text, contactNumbersOf(op)) }
  if (op.type === "sms_compose") {
    const target = composeTargetOf(op)
    return target.kind === "number"
      ? { tag: "NumberTarget", matches: grounded(text, target, op.body) }
      : { tag: "ContactTarget", nameWritten: text.toLowerCase().includes(target.query.toLowerCase()) }
  }
  const target = "target" in op ? op.target : undefined
  if (target?.kind === "number") return { tag: "NumberTarget", matches: grounded(text, target) }
  const query = target?.kind === "contact" ? target.query : "query" in op ? op.query : undefined
  if (query !== undefined && op.type !== "contact_show") return { tag: "ContactTarget", nameWritten: text.toLowerCase().includes(query.toLowerCase()) }
  return { tag: "NoTarget" }
}

/** The card's detail line: who or what the operation names, never more than the proposal itself carries. */
export function detailOf(op: TelephonyOperation): string {
  if (op.type === "sms_send") return `To ${op.recipients.join(", ")}: ${op.body}`
  if (op.type === "sms_compose") {
    const target = composeTargetOf(op)
    return `To ${target.kind === "number" ? target.number : target.query}: ${op.body}`
  }
  if (op.type === "sms_reply_selected") return op.body
  if (op.type === "contact_create") return op.contact.displayName
  if ("target" in op) return op.target.kind === "number" ? op.target.number : op.target.query
  if ("query" in op) return op.query
  if (op.type === "phone_keypad" && op.number !== undefined) return op.number
  return ""
}

const KEPT = 32

/**
 * The telephony family of the assistant's device executors: each approved operation runs once through TelephonyActions under
 * its operation ID, grounded by the owner's own words, and a view change that shows the outcome follows once its journal entry and
 * receipt settled and the reply carrying it ended.
 */
export const operationPorts = effect {
  const actions = try TelephonyActions
  const bridges = try TelephonyBridges
  const calls = try TelephonyCalls
  const navigation = try Navigation
  const settled = new Map<string, RunOutcome>()
  const shows = new Map<string, Present>()

  function remember(operation: unknown, outcome: RunOutcome) {
    const key = JSON.stringify(operation)
    settled.delete(key)
    settled.set(key, outcome)
    if (settled.size > KEPT) settled.delete(settled.keys().next().value!)
  }

  function hold(operationId: string, present: Present) {
    shows.delete(operationId)
    shows.set(operationId, present)
    if (shows.size > KEPT) shows.delete(shows.keys().next().value!)
  }

  effect function showAfterReply(call: ExecutorCall, present: Present) {
    try calls.settled(call)
    navigation.open(present.app, present.route) catch () => false
  }

  effect function run(operation: unknown, call: ExecutorCall) {
    const facts = try calls.of(call)
    const done = (actions.run(operation, call.operationId, { text: facts.ownerText }) catch (failure) => failure)
    if (done instanceof AlreadyRan) return undefined
    if (done instanceof NotATelephonyOperation) return { kind: "refused" as const, code: "unsupported" }
    remember(operation, { settled: done.settled, status: statusOf(done.result), refusal: done.refusal })
    if (done.settled === "Unconfirmed") return undefined
    if (done.present !== undefined) hold(call.operationId, done.present)
    return APPLIED.has(done.settled)
      ? { kind: "applied" as const, result: done.result }
      : { kind: "refused" as const, code: CODES[done.settled], result: done.result }
  }

  effect function readBack(operation: unknown, call: ExecutorCall) {
    const found = try actions.readBack(operation, call.operationId)
    if (found === undefined) return undefined
    remember(operation, { settled: found.settled, status: statusOf(found.result) })
    return APPLIED.has(found.settled)
      ? { kind: "found" as const, result: found.result }
      : { kind: "refused" as const, code: CODES[found.settled], result: found.result }
  }

  const ports: OperationPorts = {
    validate: (operation) => bridges.offered ? telephonyOperationOf(operation) : undefined,
    execute: (operation, call) => runPromise(run(operation, call)),
    readBack: (operation, call) => runPromise(readBack(operation, call)),
    describe: (operation) => {
      const op = telephonyOperationOf(operation)
      return op === undefined ? { title: "Action", detail: "" } : { title: titleOf(op), detail: detailOf(op) }
    },
    classOf: (operation) => classOf(telephonyOperationOf(operation)),
    target: (operation, text) => targetOf(telephonyOperationOf(operation), text),
    summarize: (operation, result) => {
      const op = telephonyOperationOf(operation)
      return op === undefined ? "" : sentenceOf(op.type, settled.get(JSON.stringify(operation)), result)
    },
    handoff: (operation) => handoffOf(telephonyOperationOf(operation)),
    addressedText: (operation) => addressedTextOf(telephonyOperationOf(operation)),
    present: (_operation, call) => {
      const present = shows.get(call.operationId)
      if (present === undefined) return
      shows.delete(call.operationId)
      runFork(showAfterReply(call, present))
    },
  }
  return ports
}
