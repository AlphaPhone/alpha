// spec/telephony/drafts.md, "Only the owner's Send binds a draft to an operation, and Send again reuses the bound operation"; spec/telephony/drafts.md, "An accepted send clears the slot, a definite refusal releases its operation, and an unknown outcome keeps it"; spec/telephony/drafts.md, "Alpha's draft goes only into an unoccupied slot addressed to exactly the same people, and keeps one Undo"; spec/telephony/drafts.md, "A slot holds at most five JPEG, PNG or GIF pictures within the MMS size, and only the owner attaches them"; spec/telephony/messages.md, "A local bubble lasts until the provider lists its row, the send is refused, or the visit ends"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { MMS_MAX_TOTAL_BYTES, operationIdOf, reviewMms, reviewSms } from "@elizaos/os/bridges/definitions/messages"
import { normalizePhoneNumber } from "@elizaos/os/bridges/definitions/phone"
import type { DirectSmsReview, MmsReview, MmsReviewProblem, SmsHandoffReport, SmsReviewProblem, SmsSendStatus } from "@elizaos/os/bridges/messages"
import type { TelephonyStatus } from "@elizaos/os/bridges/phone"
import {
  Machine as DraftsMachine, maxPictures, occupied, slotOf, type Event as DraftsEvent, type Operation, type Receipt, type SendKind, type Slot,
} from "../../gen/telephony__drafts.effect.vibe"
import { Machine as MessagesMachine, type OutgoingState } from "../../gen/telephony__messages.effect.vibe"
import { callerOf, refusalTag, TelephonyBridges, TelephonyRefused, TelephonyUnavailable } from "./bridges.vibe"
import { newId as newOperationId } from "../platform/ids.ts"
import { CloudSession } from "../account/session.vibe"

/** How long a text Android has only handed to the carrier is watched for the radio's answer. */
export const SMS_SETTLE = { reads: 6, every: "500 millis" } as const
/** The largest picture Messages attaches. */
export const MMS_PICTURE_BYTES = 1024 * 1024
const PICTURE_TYPES: Record<string, string> = { "image/jpeg": "jpg", "image/png": "png", "image/gif": "gif" }

/** Why a draft cannot be sent as it is; nothing was sent. */
export type SendProblem = SmsReviewProblem | MmsReviewProblem | "status-unread" | "picture-unreadable"

/** What became of Alpha's draft for a conversation (`sms_reply_selected`, `sms_compose`). */
export type AlphaDraftPlaced = "drafted" | "none-selected" | "occupied" | "unavailable"

/** The draft slots' effects: the reviewed send, its receipts, Alpha's draft and the pictures. */
export service DraftSends {
  /** The owner's Send tap on the bar, the draft bubble or the strip: one reviewed SMS or MMS. */
  send(thread: string): (SendProblem | undefined)!!
  /** Read back a send's journal record after Android reported it changed. */
  reconcile(operationId: string): void!!
  /** Read back every bound operation, as a return to Messages does. */
  reconcileAll(): void!!
  /** Hand the draft to the system messaging app instead, where the owner sends it. */
  handoff(thread: string): (SmsHandoffReport | undefined)!!
  /** Add a number to the new message's recipients. */
  addRecipient(number: string): void!!
  /** Alpha's draft into a conversation's slot, addressed to exactly its recipients; it never sends. */
  placeAlphaDraft(thread: string, recipients: readonly string[], text: string): AlphaDraftPlaced!!
  /** Attach a picture the owner chose. */
  addPicture(thread: string, contentType: string, bytes: Uint8Array): ("added" | "too-many" | "unsupported" | "too-large")!!
  /** Take a picture off the draft. */
  removePicture(thread: string, pictureName: string): void!!
  /** The SIMs a text may go from, for the owner's choice when no default SMS SIM is set; empty when the status is unread. */
  sims(): readonly SimChoice[]!!
}

/** One SIM the owner may send a text from. */
export interface SimChoice { readonly id: number; readonly label: string }

const ACCEPTED: readonly string[] = ["submitted", "sent", "delivered"]
const RECEIPTS: Record<SmsSendStatus, Receipt> = {
  cancelled: "ReceiptCancelled", denied: "ReceiptDenied", failed: "ReceiptFailed", unknown: "ReceiptUnknown",
  submitted: "ReceiptSubmitted", sent: "ReceiptSent", delivered: "ReceiptDelivered",
}
const PROGRESS: Record<string, OutgoingState> = { submitted: "Handed", sent: "Confirmed", delivered: "Delivery", unknown: "Unsure" }
const REFUSED_BEFORE_SENDING: readonly string[] = ["SmsSendNotAttempted", "InvalidMessageRequest", "SmsSendRefused", "SmsReviewPending", "SmsJournalRefused"]

/** A failed send call: refused before anything was sent, or a lost answer the radio may have acted on. */
export function receiptOfFailure(failure: TelephonyRefused | TelephonyUnavailable): Receipt {
  if (failure instanceof TelephonyUnavailable) return "ReceiptRefused"
  return REFUSED_BEFORE_SENDING.includes(refusalTag(failure)) || failure.code !== undefined ? "ReceiptRefused" : "ReceiptLost"
}

/** The slot under the owner namespace that keeps one attached picture's bytes. */
export function pictureSlot(thread: string, name: string): string {
  return `telephony/pictures/${thread}/${name}`
}

/** The draft sends over the drafts and messages machines, the messages bridge and the picture store. */
export const draftSendsLayer = Layer.effect(DraftSends, effect {
  const bridgeCall = callerOf(try TelephonyBridges)
  const drafts = try DraftsMachine
  const messages = try MessagesMachine
  const store = try KeyValueStore.KeyValueStore
  const session = try CloudSession
  const keyOf = (thread: string, name: string) => session.ownerKey(pictureSlot(thread, name))
  const tell = effect (event: DraftsEvent, by: "Owner" | "Alpha" | "Device") => drafts.send(event, by) catch () => undefined
  const note = effect (event: Parameters<typeof messages.send>[0]) => messages.send(event) catch () => undefined

  effect function pictureBytes(thread: string, slot: Slot) {
    const out: { contentType: string; name: string; bytes: Uint8Array }[] = []
    for (const picture of slot.pictures) {
      const bytes = (store.getUint8Array(try keyOf(thread, picture.pictureName)) catch () => undefined)
      if (bytes === undefined) return undefined
      out.push({ contentType: picture.contentType, name: picture.pictureName, bytes })
    }
    return out
  }

  effect function boundReview(thread: string, slot: Slot, operation: Extract<Operation, { tag: "BoundOperation" }>) {
    const recipients = operation.boundRecipients.map(normalizePhoneNumber).filter((n) => n !== null)
    if (operation.kind === "SmsSend") return { kind: "sms", review: { recipients, body: operation.boundText, subscriptionId: operation.boundSim } satisfies DirectSmsReview } as const
    const attachments = try pictureBytes(thread, slot)
    if (attachments === undefined) return undefined
    return { kind: "mms", review: { recipients, body: operation.boundText, subscriptionId: operation.boundSim, attachments } as MmsReview } as const
  }

  effect function settle(thread: string, operationId: string, status: SmsSendStatus, createdAt: number) {
    try tell({ type: "sendAnswered", thread, operationId, receipt: RECEIPTS[status] }, "Device")
    if (ACCEPTED.includes(status) || status === "unknown") try note({ type: "outgoingAnswered", operationId, progress: PROGRESS[status] ?? "Unsure", createdAt })
    else try note({ type: "outgoingSettled", operationId })
  }

  effect function readBack(thread: string, slot: Slot) {
    const operation = slot.operation
    if (operation.tag !== "BoundOperation" || slot.outcome === "Sending") return
    const id = operationIdOf(operation.operationId)
    const bound = try boundReview(thread, slot, operation)
    if (id === null || bound === undefined) return
    const result = bound.kind === "sms"
      ? (bridgeCall("smsSendResult", (c) => c.messages.smsSendResult(bound.review, id)) catch () => undefined)
      : (bridgeCall("mmsSendResult", (c) => c.messages.mmsSendResult(bound.review, id)) catch () => undefined)
    if (result !== undefined) try settle(thread, operation.operationId, result.status, result.createdAt)
  }

  effect function status() {
    return (bridgeCall("status", (c) => c.messages.status()) catch () => undefined)
  }

  effect function reviewed(slot: Slot, current: TelephonyStatus, thread: string) {
    const subscriptionId = slot.sim >= 0 ? slot.sim : undefined
    if (slot.pictures.length > 0 || slot.recipients.length > 1) {
      const attachments = try pictureBytes(thread, slot)
      if (attachments === undefined) return { problem: "picture-unreadable" } as const
      const checked = reviewMms({ recipients: slot.recipients, body: slot.text, attachments, subscriptionId }, current)
      return "problem" in checked ? { problem: checked.problem } : { kind: "MmsSend" as SendKind, sms: undefined, mms: checked.review }
    }
    const checked = reviewSms({ recipients: slot.recipients, body: slot.text, subscriptionId }, current, "direct")
    if ("problem" in checked) return { problem: checked.problem }
    if (checked.review.subscriptionId === null) return { problem: "sim-required" } as const
    return { kind: "SmsSend" as SendKind, sms: { ...checked.review, subscriptionId: checked.review.subscriptionId } satisfies DirectSmsReview, mms: undefined }
  }

  return {
    effect send(thread: string) {
      const slot = slotOf((try drafts.get()).slots, thread)
      if (slot.operation.tag === "BoundOperation" && slot.outcome === "Unconfirmed") {
        try readBack(thread, slot)
        return undefined
      }
      const current = try status()
      if (current === undefined) return "status-unread"
      const checked = try reviewed(slot, current, thread)
      if ("problem" in checked) return checked.problem
      const operationId = slot.operation.tag === "BoundOperation" ? slot.operation.operationId : newOperationId()
      const id = operationIdOf(operationId)
      const sim = checked.sms?.subscriptionId ?? checked.mms?.subscriptionId ?? -1
      if (id === null || (try tell({ type: "sendStarted", thread, operationId, kind: checked.kind, sim }, "Owner")) === undefined) return undefined
      const at = try Clock.currentTimeMillis
      if (checked.sms !== undefined && checked.sms.recipients.length === 1)
        try note({ type: "outgoingStarted", operationId, toThread: thread, body: checked.sms.body, at })
      const sent = checked.sms !== undefined
        ? (bridgeCall("sendSms", (c) => c.composer.sendSms(checked.sms, id)) catch (failure) => failure)
        : (bridgeCall("sendMms", (c) => c.composer.sendMms(checked.mms!, id)) catch (failure) => failure)
      if (sent instanceof TelephonyRefused || sent instanceof TelephonyUnavailable) {
        try tell({ type: "sendAnswered", thread, operationId, receipt: receiptOfFailure(sent) }, "Device")
        try note({ type: "outgoingSettled", operationId })
        return undefined
      }
      let result = sent
      for (let read = 0; checked.sms !== undefined && result.status === "submitted" && read < SMS_SETTLE.reads; read++) {
        try sleep(SMS_SETTLE.every)
        const again = (bridgeCall("smsSendResult", (c) => c.messages.smsSendResult(checked.sms, id)) catch () => undefined)
        if (again === undefined) break
        result = again
      }
      try settle(thread, operationId, result.status, result.createdAt)
      return undefined
    },
    effect reconcile(operationId: string) {
      const slot = (try drafts.get()).slots.find((s) => s.operation.tag === "BoundOperation" && s.operation.operationId === operationId)
      if (slot !== undefined) try readBack(slot.thread, slot)
    },
    effect reconcileAll() {
      for (const slot of (try drafts.get()).slots) {
        try readBack(slot.thread, slot)
      }
    },
    effect handoff(thread: string) {
      const slot = slotOf((try drafts.get()).slots, thread)
      if (occupied(slot)) return undefined
      const current = try status()
      if (current === undefined) return undefined
      const checked = reviewSms({ recipients: slot.recipients, body: slot.text }, current, "handoff")
      if ("problem" in checked) return undefined
      return (bridgeCall("composeSms", (c) => c.messages.composeSms(checked.review)) catch () => undefined)
    },
    effect addRecipient(number: string) {
      const slot = slotOf((try drafts.get()).slots, "new")
      if (slot.recipients.includes(number)) return
      try tell({ type: "recipientsChanged", thread: "new", recipients: [...slot.recipients, number] }, "Owner")
    },
    effect placeAlphaDraft(thread: string, recipients: readonly string[], text: string) {
      const slot = slotOf((try drafts.get()).slots, thread)
      if (occupied(slot)) return "occupied"
      const placed = try tell({ type: "alphaDrafted", thread, recipients: [...recipients], text: text.trim().slice(0, 1600) }, "Alpha")
      return placed === undefined ? "unavailable" : "drafted"
    },
    effect addPicture(thread: string, contentType: string, bytes: Uint8Array) {
      const extension = PICTURE_TYPES[contentType]
      if (extension === undefined) return "unsupported"
      if (bytes.length === 0 || bytes.length > MMS_PICTURE_BYTES) return "too-large"
      const slot = slotOf((try drafts.get()).slots, thread)
      if (slot.pictures.length >= maxPictures) return "too-many"
      if (slot.pictures.reduce((total, p) => total + p.bytes, 0) + bytes.length > MMS_MAX_TOTAL_BYTES) return "too-large"
      const used = slot.pictures.map((p) => Number(p.pictureName.split(".")[0]?.slice(8) ?? 0))
      const pictureName = `picture-${Math.max(0, ...used) + 1}.${extension}`
      store.set(try keyOf(thread, pictureName), bytes) catch () => undefined
      const added = try tell({ type: "pictureAdded", thread, picture: { pictureName, contentType, bytes: bytes.length } }, "Owner")
      return added === undefined ? "too-many" : "added"
    },
    effect sims() {
      const current = try status()
      return (current?.subscriptions ?? []).map((sim) => ({
        id: sim.id, label: [sim.displayName, sim.carrierName].filter((part) => part !== "").join(" · ") || `SIM ${sim.slot + 1}`,
      }) satisfies SimChoice)
    },
    effect removePicture(thread: string, pictureName: string) {
      if ((try tell({ type: "pictureRemoved", thread, pictureName }, "Owner")) !== undefined)
        store.remove(try keyOf(thread, pictureName)) catch () => undefined
    },
  }
})
