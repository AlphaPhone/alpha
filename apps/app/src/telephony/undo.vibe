// spec/telephony/undo.md, "A deletion is queued once for its window, and Undo is offered only until the window ends"
import { Machine as UndoMachine, type DeletionKind, type Event as UndoEvent } from "../../gen/telephony__undo.effect.vibe"
import { callerOf, TelephonyBridges, TelephonyRefused } from "./bridges.vibe"

const TICK = "1 second"
const WIRE: Record<DeletionKind, "message" | "voicemail" | "contact"> = { MessageDeletion: "message", VoicemailDeletion: "voicemail", ContactDeletion: "contact" }

/** How a confirmed delete was handed to the phone: queued with its Undo token, refused before anything changed, or with no answer. */
export type Deferred = { readonly queued: true; readonly token: string } | { readonly queued: false; readonly refused: boolean }

/** Deferred deletions with Undo, over the phone's deletion window. */
export service DeletionUndo {
  /** Queue a confirmed delete of `ids`; the rows leave the list at once. */
  defer(kind: DeletionKind, ids: readonly string[]): Deferred!!
  /** Undo a queued delete while its window lasts; true when the phone kept the rows. */
  undo(token: string): boolean!!
  /** Count the windows down for as long as it runs. */
  run(): void!!
}

/** Undo over its machine and the bridge's `deferDelete` and `undoDelete`. */
export const deletionUndoLayer = Layer.effect(DeletionUndo, effect {
  const bridgeCall = callerOf(try TelephonyBridges)
  const undo = try UndoMachine
  const tell = (event: UndoEvent) => undo.send(event) catch () => undefined
  return {
    effect defer(kind: DeletionKind, ids: readonly string[]) {
      try tell({ type: "ticked", at: try Clock.currentTimeMillis })
      const answer = try (bridgeCall("deferDelete", (c) => c.messages.deferDelete(WIRE[kind], [...ids])) catch (failure) => failure)
      if (answer instanceof TelephonyRefused) return { queued: false, refused: answer.code !== undefined } satisfies Deferred
      try tell({ type: "deletionQueued", token: answer.token, kind })
      return { queued: true, token: answer.token } satisfies Deferred
    },
    effect undo(token: string) {
      if ((try undo.get()).queued.every((q) => q.token !== token)) return false
      const answer = try (bridgeCall("undoDelete", (c) => c.messages.undoDelete(token)) catch () => "too-late" as const)
      if (answer === "undone") {
        try tell({ type: "undoAsked", token })
        return true
      }
      try tell({ type: "undoRefused", token })
      return false
    },
    effect run() {
      while (true) {
        try tell({ type: "ticked", at: try Clock.currentTimeMillis })
        try sleep(TICK)
      }
    },
  }
})
