// spec/app/telephony/messages.md, "Story: Read my conversations while Messages is open"; spec/app/telephony/drafts.md, "Story: Send only what I reviewed, once"
import type { AddressBookRow } from "@elizaos/os/bridges/contacts"
import type { MessageId, MessageRow as Row, OperationId, SmsSendStatus, ThreadCursor, ThreadId, ThreadRow as Listed } from "@elizaos/os/bridges/messages"
import type { PhoneNumber } from "@elizaos/os/bridges/phone"
import * as Drafts from "../../gen/app__telephony__drafts.effect.vibe"
import type { Effect as SendOut, Event as DraftEvent, Receipt } from "../../gen/app__telephony__drafts.effect.vibe"
import * as Messages from "../../gen/app__telephony__messages.effect.vibe"
import type { Choice, DeleteOutcome, Effect as Out, Event, MessageRow, PageAnswer, ThreadRow } from "../../gen/app__telephony__messages.effect.vibe"
import { Telephony, TelephonyRefused, telephony } from "../platform/telephony.vibe"
import { Attempts } from "../runtime/attempts.vibe"
import { type Job, answer, reacting, run, stop, stream, together, untimed } from "../runtime/reactor.vibe"
import { placed } from "./phone.vibe"
import { visiting } from "./visit.vibe"

/** A conversation as the list shows it; one the phone could not report whole keeps its place without content. */
function threadOf(row: Listed): ThreadRow {
  return "incomplete" in row
    ? { id: row.id, title: "", addresses: [], snippet: "", date: row.date, unread: false, complete: false }
    : { id: row.id, title: row.addresses.join(", "), addresses: row.addresses, snippet: row.snippet, date: row.date, unread: row.unread, complete: true }
}

// spec/app/telephony/messages.md, "A sent text reads Delivered only on the radio's confirmed delivery report, and a picture message never does"
function messageOf(row: Row): MessageRow {
  if ("incomplete" in row) return { id: row.id, kind: row.kind === "mms" ? "MmsKind" : "SmsKind", threadId: row.threadId, outgoing: false, condition: "Received", date: row.date, body: "", pictures: 0, complete: false }
  const outgoing = row.direction === "outgoing"
  const status = row.status === "failed" ? "OutFailed" : row.status === "pending" ? "OutPending" : "OutSent"
  const kind = row.kind === "mms" ? "MmsKind" : "SmsKind"
  return {
    id: row.id, kind, threadId: row.threadId, outgoing, condition: Messages.conditionOf(kind, outgoing, status, row.deliveryReport === "complete" || row.status === "delivered"),
    date: row.date, body: row.body, pictures: row.attachments, complete: true,
  }
}

/** What a refused read means: the SMS grant is missing, or the phone could not read its messages. */
function refusedPage(failure: unknown): PageAnswer {
  return failure instanceof TelephonyRefused && failure.code === "permission-required" ? { tag: "NoSmsAccess" } : { tag: "SmsUnreadable" }
}

/** Whether Alpha holds the SMS role, the only app Android lets keep read state. */
const roleHeld = Effect.orElseSucceed(Effect.map(telephony("status", (c) => c.messages.status()), (status) => status.roles.sms.held), () => false)

// spec/app/telephony/messages.md, "Only the latest read publishes, and a conversation shows only its own messages"
/** `pages` pages of the conversation list, or of one conversation's messages, read under `ticket`. */
effect function page(ticket: number, threadId: string, pages: number, asking: boolean): Event!!Telephony {
  const read: PageAnswer = effect {
    if (asking) try telephony("requestAccess", (c) => c.phone.requestAccess("sms"))
    const held = try roleHeld
    if (threadId === "") {
      let rows: Listed[] = []
      let cursor: ThreadCursor | undefined
      let more = false
      for (let left = pages; left > 0; left--) {
        const found = try telephony("threadPage", (c) => c.messages.threadPage(cursor))
        rows = [...rows, ...found.rows]
        more = found.next !== null
        if (found.next === null) break
        cursor = found.next
      }
      return { tag: "ThreadsPage", threads: rows.map(threadOf), hasMore: more, roleHeld: held } satisfies PageAnswer
    }
    const found = try telephony("messagePage", (c) => c.messages.messagePage(threadId as ThreadId))
    return { tag: "MessagesPage", messages: found.rows.map(messageOf).toReversed(), hasOlder: found.next !== null, roleHeld: held } satisfies PageAnswer
  } catch (failure) => refusedPage(failure)
  return { type: "pageAnswered", ticket, answer: read, at: untimed }
}

// spec/app/telephony/messages.md, "Delete passes the exact listed row after confirmation, and an unconfirmed delete keeps the row and blocks another"
effect function deleted(id: number, rowId: string): Event!!(Telephony | Messages.Machine) {
  const row = (try (try Messages.Machine).get()).rows.find((one) => one.id === rowId)
  const result: DeleteOutcome = row === undefined ? "RowMissing" : effect {
    const answered = try telephony("deleteMessage", (c) => c.messages.deleteMessage({ id: rowId as MessageId, kind: row.kind === "MmsKind" ? "mms" : "sms", threadId: row.threadId as ThreadId, date: row.date }))
    return answered.status === "queued" ? "Removed" : answered.status === "not-found" ? "RowMissing" : answered.status === "stale" ? "RowChanged" : "RowInSend"
  } catch (failure) => (failure instanceof TelephonyRefused && failure.code === undefined && failure.tag === "" ? "RemovalUnknown" : "RowChanged")
  return { type: "deleteAnswered", id, result }
}

// spec/app/telephony/messages.md, "The recipient picker reads contacts only while a new message is open, and answers only its latest query"
effect function picks(ticket: number, query: string): Event!!Telephony {
  const choose = (row: AddressBookRow): Choice[] => ("incomplete" in row ? [] : row.phones.map((number) => ({ key: `${row.id}:${number}`, title: row.name, number })))
  const found = effect {
    try telephony("open", (c) => c.contacts.open())
    const page = try telephony("list", (c) => c.contacts.list({ query, limit: 20 }))
    return { choices: page.contacts.flatMap(choose), more: page.next !== null, needsAccess: false }
  } catch (failure) => ({ choices: [], more: false, needsAccess: failure instanceof TelephonyRefused && failure.tag === "ContactReadRefused" })
  return { type: "pickerAnswered", ticket, ...found }
}

/** Each change the providers report while Messages shows, as a read again. */
const changes: Stream.Stream<Event, never, Telephony> = Stream.callback<Event, never, Telephony>((queue) => Effect.asVoid(acquireRelease(
  Effect.orElseSucceed(telephony("observeMessages", (c) => c.messages.observeMessages(() => { Queue.offerUnsafe(queue, { type: "providerChanged" }) })), () => undefined),
  (unsubscribe) => (unsubscribe === undefined ? Effect.void : ignore(tryPromise(() => unsubscribe()))),
)))

function carry(fx: Out): Job<Event, Telephony | Messages.Machine, []> {
  const failed = (ticket: number): Event => ({ type: "pageAnswered", ticket, answer: { tag: "SmsUnreadable" }, at: untimed })
  return match (fx) {
    when { tag: "ReadThreads", let ticket, let pages }: answer("page", page(ticket, "", pages, false), failed(ticket));
    when { tag: "ReadMessages", let ticket, let threadId, let pages }: answer("page", page(ticket, threadId, pages, false), failed(ticket));
    when { tag: "AskSms", let ticket }: answer("page", page(ticket, "", 1, true), failed(ticket));
    when { tag: "Listen" }: stream("listen", changes, { type: "providerChanged" });
    when { tag: "Unlisten" }: stop("listen");
    when { tag: "MarkRead", let threadId, let through }: run("read", ignore(telephony("markThreadRead", (c) => c.messages.markThreadRead(threadId as ThreadId, through))));
    when { tag: "DeleteMessage", let id, let rowId }: answer(`delete ${id}`, deleted(id, rowId), { type: "deleteAnswered", id, result: "RemovalUnknown" });
    when { tag: "PickContacts", let ticket, let query }: answer("picks", picks(ticket, query), { type: "pickerAnswered", ticket, choices: [], more: false, needsAccess: false });
    when { tag: "Place", let id, let number }: answer(`place ${id}`, Effect.map(placed(number), (result): Event => ({ type: "callAnswered", id, result })), { type: "callAnswered", id, result: "CallUnconfirmed" });
  }
}

const conversations = reacting(Messages, { carry })

const shown = visiting("Messages", Messages.Machine, (showing): Event => ({ type: "show", showing }))

const receipts: Record<SmsSendStatus, Receipt> = {
  cancelled: "ReceiptCancelled", denied: "ReceiptDenied", failed: "ReceiptFailed", unknown: "ReceiptUnknown",
  submitted: "ReceiptSubmitted", sent: "ReceiptSent", delivered: "ReceiptDelivered",
}

// spec/app/telephony/drafts.md, "An accepted send clears the draft, a definite refusal releases its operation, and an unknown outcome keeps it"
/** The owner's send under its operation's key, which the phone's journal answers again, and never sends twice. */
effect function sent(fx: SendOut): DraftEvent!!(Telephony | Attempts) {
  const operationId = (try (try Attempts).key(fx.operation)) as OperationId
  const receipt: Receipt = effect {
    const status = try telephony("status", (c) => c.messages.status())
    const sim = fx.sim >= 0 ? fx.sim : status.defaultSmsSubscriptionId ?? status.subscriptions?.[0]?.id
    if (sim === undefined) return "ReceiptRefused" satisfies Receipt
    const result = try telephony("sendSms", (c) => c.messages.sendSms({ recipients: fx.recipients as PhoneNumber[], body: fx.text, subscriptionId: sim }, operationId))
    return receipts[result.status]
  } catch (failure) => (failure instanceof TelephonyRefused && failure.code === undefined && failure.tag === "" ? "ReceiptLost" : "ReceiptRefused")
  return { type: "sendAnswered", thread: fx.thread, operation: fx.operation, receipt }
}

function send(fx: SendOut): Job<DraftEvent, Telephony, [by: "Device"]> {
  return answer(`send ${fx.thread}`, sent(fx), { type: "sendAnswered", thread: fx.thread, operation: fx.operation, receipt: "ReceiptLost" }, "Device")
}

// spec/app/telephony/drafts.md, "When Alpha opens again, a send that was under way reads unconfirmed and keeps its operation"
const drafts = reacting(Drafts, { keep: 1, open: [{ type: "reopen" }, "Device"], carry: send })

/** Messages and the owner's drafts: resident, since Contacts and Alpha hand Messages a number, and kept drafts are taken up when Alpha opens. */
export const messages = together(conversations, shown, drafts)
