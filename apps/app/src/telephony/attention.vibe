// spec/app/telephony/attention.md, "Story: See what is new from Home"
import type { ThreadRow as Listed } from "@elizaos/os/bridges/messages"
import * as Attention from "../../gen/app__telephony__attention.effect.vibe"
import type { AttentionRead, Effect as Out, Event, NewMissed, NewVoicemail, UnreadThread } from "../../gen/app__telephony__attention.effect.vibe"
import { Telephony, telephony } from "../platform/telephony.vibe"
import { type Job, answer, due, reacting, together, untimed } from "../runtime/reactor.vibe"
import { home, visiting } from "./visit.vibe"
import { recentsLimit } from "./phone.vibe"

/** Each source read on its own: one that fails is unread, never "nothing new". */
effect function sources(ticket: number): Event!!Telephony {
  const threads = Effect.map(telephony("threadPage", (c) => c.messages.threadPage()), (page) => page.rows.flatMap((row: Listed): UnreadThread[] =>
    "incomplete" in row || !row.unread ? [] : [{ threadId: row.id, title: row.addresses.join(", "), snippet: row.snippet, date: row.date }])) catch () => undefined
  const calls = Effect.map(telephony("recentCalls", (c) => c.phone.recentCalls({ limit: recentsLimit })), (page) => page.calls.flatMap((call): NewMissed[] =>
    call.type === "missed" && call.isNew ? [{ callerKey: call.number, title: call.cachedName ?? call.number, date: call.date }] : [])) catch () => undefined
  const voicemail = Effect.map(telephony("refreshVoicemail", (c) => c.phone.refreshVoicemail("AutomaticRead")), (listing) => listing.carrier !== "CarrierReady" ? undefined : listing.voicemails.flatMap((one): NewVoicemail[] =>
    one.heard ? [] : [{ voicemailId: one.id, title: one.cachedName ?? one.number, date: one.date, seconds: one.durationSeconds }])) catch () => undefined
  const read: AttentionRead = {
    threadsOk: threads !== undefined, unreadRows: threads ?? [],
    callsOk: calls !== undefined, missedRows: calls ?? [],
    voicemailOk: voicemail !== undefined, voicemailRows: voicemail ?? [],
  }
  return { type: "readAnswered", ticket, read, at: untimed }
}

const unread: AttentionRead = { threadsOk: false, unreadRows: [], callsOk: false, missedRows: [], voicemailOk: false, voicemailRows: [] }

function carry(fx: Out): Job<Event, Telephony, []> {
  return answer("read", sources(fx.ticket), { type: "readAnswered", ticket: fx.ticket, read: unread, at: untimed })
}

// spec/app/telephony/attention.md, "A card exists only for a source that was read and has something new"
function timers(state: Attention.Attention) {
  return state.homeShown && state.sources.status !== "Loading" ? [due<Event, []>("refresh", state.due, { type: "refresh", now: untimed })] : []
}

const machine = reacting(Attention, { carry, timers })

const shown = visiting(home, Attention.Machine, (showing): Event => ({ type: "show", showing }))

/** What Home's Messages and Phone cards show: resident, read while Home is in front, again every thirty seconds. */
export const attention = together(machine, shown)
