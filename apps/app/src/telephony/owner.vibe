import { CloudSession } from "../account/layer.vibe"

/** The stored key of one of telephony's machines, under the signed-in account's owner namespace. */
export effect function telephonyKey(name: string) {
  return try (try CloudSession).ownerKey(`telephony/${name}`)
}
