// spec/telephony/drafts.md, "Story: Write to someone, in my own words or Alpha's"; spec/telephony/drafts.md, "What I wrote signed out becomes the account's that signs in, only where that account kept nothing"; spec/telephony/comms.md, "Story: See what Alpha is acting on"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { adoptsDeviceSlot, type Kept } from "../../gen/telephony__drafts.effect.vibe"
import { CloudSession, ownerOf } from "../account/layer.vibe"
import { ownerKey } from "../platform/storage.vibe"

/** A machine's state kept under the key of whoever is signed in when it is read or written, and the owner changes that republish it. */
export interface OwnerKept<S> {
  load(): S!unknown
  keep(next: S): void!!
  readonly owners: Stream.Stream<number>
}

/**
 * One machine's stored state, bound to the owner signed in at each read and write rather than at layer build,
 * so a start signed out never lands the next owner's drafts under the wrong key. What was kept signed out moves to
 * the first account that reads it with nothing of its own, and leaves the phone's namespace. `decode` refuses what is not a state.
 */
export effect function ownerKept<S>(name: string, start: S, decode: (input: unknown) => S!unknown) {
  const session = try CloudSession
  const store = try KeyValueStore.KeyValueStore
  const slot = `telephony/${name}`
  const deviceKey = ownerKey("device", slot)

  effect function parsed(raw: string | undefined) {
    if (raw === undefined) return undefined
    return try (decode(try Effect.try(() => JSON.parse(raw) as unknown)) catch () => undefined)
  }

  effect function adopt(key: string, mine: string | undefined) {
    if (key === deviceKey) return mine
    const left = try (store.get(deviceKey) catch () => undefined)
    if (left === undefined) return mine
    const state = try parsed(left)
    const device: Kept = state === undefined ? "KeptDamaged" : "KeptState"
    if (!adoptsDeviceSlot(device, mine === undefined ? "NothingKept" : "KeptState")) return mine
    try (store.set(key, left) catch () => undefined)
    try (store.remove(deviceKey) catch () => undefined)
    return left
  }

  effect function load() {
    const key = try session.ownerKey(slot)
    const found = try adopt(key, try store.get(key))
    return found === undefined ? start : try decode(try Effect.try(() => JSON.parse(found) as unknown))
  }
  effect function keep(next: S) {
    try orDie(store.set(try session.ownerKey(slot), JSON.stringify(next)))
  }
  const owners = Stream.drop(Stream.changesWith(Stream.map(session.changes, ownerOf), (a, b) => a === b), 1)
  return { load, keep, owners } satisfies OwnerKept<S>
}
