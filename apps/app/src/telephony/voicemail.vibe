// spec/app/telephony/voicemail.md, "Story: See my voicemail only when my carrier offers it"; spec/app/telephony/voicemail.md, "Story: Hear a voicemail"; spec/app/telephony/voicemail.md, "Story: Delete one voicemail I chose"
import type { ListedVoicemail, VoicemailId, VoicemailListing } from "@elizaos/os/bridges/phone"
import { Machine as Bar, callHolds } from "../../gen/app__telephony__callBar.effect.vibe"
import { Machine as PhoneMachine, type Event as PhoneEvent } from "../../gen/app__telephony__phone.effect.vibe"
import * as Voicemail from "../../gen/app__telephony__voicemail.effect.vibe"
import type { Effect as Out, Event, VoicemailAnswer, VoicemailRow, VoicemailWritten } from "../../gen/app__telephony__voicemail.effect.vibe"
import { Telephony, TelephonyRefused, telephony } from "../platform/telephony.vibe"
import { type Job, answer, following, reacting, run, together } from "../runtime/reactor.vibe"
import { visiting } from "./visit.vibe"

/** One voicemail as the tab lists it. */
function rowOf(entry: ListedVoicemail): VoicemailRow {
  return {
    id: entry.id, number: entry.number, title: entry.cachedName ?? "", date: entry.date, seconds: entry.durationSeconds,
    fresh: !entry.heard, hasAudio: entry.audio === "AudioOnPhone", carrierText: entry.carrierTranscript ?? "",
  }
}

/** What the voicemail store answered, as the tab takes it: its carrier, its rows and whether its write gate holds. */
function listedOf(listing: VoicemailListing): VoicemailAnswer {
  return { tag: "VoicemailListed", carrier: listing.carrier, voicemails: listing.voicemails.map(rowOf), blocked: listing.gate !== "WriteIdle" }
}

// spec/app/telephony/voicemail.md, "Rows exist only for a ready carrier, and a failed read is never an empty list"
effect function listed(ticket: number, explicit: boolean): Event!!Telephony {
  const read = Effect.map(telephony("refreshVoicemail", (c) => c.phone.refreshVoicemail(explicit ? "ExplicitRead" : "AutomaticRead")), listedOf) catch (): VoicemailAnswer => ({ tag: "VoicemailUnreadable" })
  return { type: "listAnswered", ticket, answer: read }
}

// spec/app/telephony/voicemail.md, "Opening a voicemail asks for its audio once, and a carrier transcript is shown as it is"
/** The open voicemail's audio, kept in memory as a playable source; none where the phone could not give it. */
effect function audio(ticket: number, voicemail: string): Event!!Telephony {
  const id = voicemail as VoicemailId
  const source = effect {
    const fetched = try telephony("fetchVoicemailAudio", (c) => c.phone.fetchVoicemailAudio(id))
    if (fetched !== "ready") return ""
    const found = try telephony("voicemailAudio", (c) => c.phone.voicemailAudio(id))
    return `data:${found.mimeType};base64,${found.data}`
  } catch () => ""
  return { type: "audioAnswered", ticket, source }
}

// spec/app/telephony/voicemail.md, "Only a removal the provider confirmed (eliza stages it in the deletion window, whose own notice offers Undo), or a voicemail already gone, takes the row away"
effect function deleted(id: number, voicemail: string): Event!!Telephony {
  const written: VoicemailWritten = effect {
    const report = try telephony("deleteVoicemail", (c) => c.phone.deleteVoicemail(voicemail as VoicemailId))
    return report.status === "queued" ? "VoicemailRemoved" : "VoicemailGone"
  } catch (failure) => (failure instanceof TelephonyRefused && failure.code === undefined && failure.tag === "" ? "VoicemailUnconfirmed" : "VoicemailKept")
  return { type: "deleteAnswered", id, written }
}

function carry(fx: Out): Job<Event, Telephony, []> {
  return match (fx) {
    when { tag: "ReadVoicemail", let ticket, let explicit }: answer("list", listed(ticket, explicit), { type: "listAnswered", ticket, answer: { tag: "VoicemailUnreadable" } });
    when { tag: "FetchAudio", let ticket, let voicemail }: answer("audio", audio(ticket, voicemail), { type: "audioAnswered", ticket, source: "" });
    when { tag: "Transcribe", let ticket }: answer("transcript", succeed<Event>({ type: "transcriptAnswered", ticket, ready: false, words: "" }), { type: "transcriptAnswered", ticket, ready: false, words: "" });
    when { tag: "MarkHeard", let voicemail }: run(`heard ${voicemail}`, ignore(telephony("markVoicemailHeard", (c) => c.phone.markVoicemailHeard(voicemail as VoicemailId))));
    when { tag: "DeleteVoicemail", let id, let voicemail }: answer(`delete ${id}`, deleted(id, voicemail), { type: "deleteAnswered", id, written: "VoicemailUnconfirmed" });
  }
}

const machine = reacting(Voicemail, { carry })

const shown = visiting("Phone", Voicemail.Machine, (showing): Event => ({ type: "show", showing }))

// spec/app/telephony/phone.md, "The Voicemail tab exists only while the carrier's visual voicemail is ready"
const carrier = following(Voicemail.Machine, (state) => state.shown && state.carrier === "CarrierReady", PhoneMachine, (ready): PhoneEvent => ({ type: "carrierRead", ready }))

// spec/app/telephony/voicemail.md, "Playing marks a voicemail heard, and nothing plays during a call"
const calls = following(Bar, callHolds, Voicemail.Machine, (inCall): Event => ({ type: "callChanged", inCall }))

/** The Voicemail tab: in memory, read while Phone is in front, telling Phone whether the carrier offers it, and paused by a call. */
export const voicemail = together(machine, shown, carrier, calls)
