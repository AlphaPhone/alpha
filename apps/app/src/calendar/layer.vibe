// spec/calendar/index.md
// Every Calendar service, over the platform's Native, Resident, Build and KeyValueStore.
import { stored as presentationStored } from "../../gen/calendar__presentation.effect.vibe"
import { machine as agentMachine } from "../../gen/calendar__agent.effect.vibe"
import { machine as deviceMachine } from "../../gen/calendar__device.effect.vibe"
import { machine as selectionMachine } from "../../gen/calendar__selection.effect.vibe"
import { machine as draftMachine } from "../../gen/calendar__drafts.effect.vibe"
import { machine as heldMachine } from "../../gen/calendar__deletions.effect.vibe"
import { machine as reviewMachine } from "../../gen/calendar__approvals.effect.vibe"
import { machine as actionMachine } from "../../gen/calendar__deviceActions.effect.vibe"
import { machine as preservationMachine } from "../../gen/calendar__preservation.effect.vibe"
import { stored as controlStored } from "../../gen/calendar__sync.effect.vibe"
import { machine as linkMachine } from "../../gen/calendar__googleLink.effect.vibe"
import { stored as nativeStored } from "../../gen/calendar__nativeSync.effect.vibe"
import { machine as disconnectMachine } from "../../gen/calendar__disconnect.effect.vibe"
import { ownerKey } from "../platform/storage.vibe"
import { agentLayer } from "./agent.vibe"
import { approvalsLayer } from "./approvals.vibe"
import { deletionsLayer } from "./deletions.vibe"
import { deviceLayer } from "./device.vibe"
import { draftsLayer } from "./drafts.vibe"
import { homeLayer } from "./home.vibe"
import { preservationLayer } from "./preservation.vibe"
import { requestsLayer } from "./requests.vibe"
import { syncLayer } from "./sync.vibe"

/** Sources the owner hid in Calendar, which Home also leaves out. */
const hidden = new Set<string>()

/** Hide or show a source on Calendar and Home. */
export function setSourceHidden(sourceKey: string, hide: boolean): void {
  if (hide) hidden.add(sourceKey)
  else hidden.delete(sourceKey)
}

const preserved = Layer.provideMerge(preservationLayer, preservationMachine())
const agent = Layer.provideMerge(agentLayer, Layer.merge(agentMachine(), preserved))

/** Calendar's services: the screen's presentation, the agent Calendar, device calendars, drafts, held deletions, approvals, agent requests, sync and Home's agenda. */
export const layer = Layer.mergeAll(
  presentationStored(ownerKey("device", "calendar/presentation")),
  agent,
  Layer.provide(approvalsLayer, Layer.merge(reviewMachine(), agent)),
  Layer.provide(homeLayer(() => hidden), agent),
  Layer.provide(syncLayer, Layer.mergeAll(controlStored(ownerKey("device", "calendar/sync")), linkMachine(), nativeStored(ownerKey("device", "calendar/device-sync")), disconnectMachine(), agent)),
  Layer.provideMerge(deviceLayer, Layer.merge(deviceMachine(), selectionMachine())),
  Layer.provideMerge(draftsLayer, draftMachine()),
  Layer.provideMerge(deletionsLayer, heldMachine()),
  Layer.provideMerge(requestsLayer, actionMachine()),
)
