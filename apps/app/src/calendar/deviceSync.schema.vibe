// spec/calendar/deviceSync.md, "The owner may choose only a calendar it can write, of a Google account that granted Calendar changes"; spec/calendar/deviceSync.md, "Checkpoints are kept only in the encrypted slot of their own name, never above 4 MiB"
// Decoders for what device Calendar sync reads back from storage it does not own outright.

const Connection = Schema.String.check(Schema.isPattern(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i))
const Clean = (max: number) => Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(max), Schema.isPattern(/^[^\u0000-\u001f\u007f]*$/))

/** The Google calendar device sync writes to: its connection, its calendar, and the names the owner chose it by. */
export const SyncSelection = Schema.Struct({
  connectionId: Connection,
  providerCalendarId: Clean(1024),
  name: Clean(512),
  account: Clean(320),
})

/** The choice as Alpha keeps it for one Cloud account. */
export const SelectionDocument = Schema.Struct({ version: Schema.Literal(1), selection: SyncSelection })

/** The choice as the earlier Alpha kept it, under the Cloud account it names. */
export const LegacySelectionDocument = Schema.Struct({
  version: Schema.Literal(1),
  owner: Clean(2048),
  selection: Schema.Struct({
    connectionId: Connection,
    sourceId: Clean(8192),
    providerCalendarId: Clean(1024),
    name: Clean(512),
    account: Clean(320),
  }),
})

/** `ElizaSecureStore.get` as linked sync's checkpoints read it: the slot's text, an empty slot, or a refusal. */
export const SlotRead = Schema.Union([
  Schema.Struct({ ok: Schema.Literal(true), value: Schema.String }),
  Schema.Struct({ ok: Schema.Literal(false), error: Schema.String }),
  Schema.Struct({ value: Schema.optionalKey(Schema.NullOr(Schema.String)) }),
])

/** `ElizaSecureStore.compareAndExchange`: written, a conflict or another refusal, or the phone's plain `{ exchanged }`. */
export const SlotExchange = Schema.Union([
  Schema.Struct({ ok: Schema.Literal(true), outcome: Schema.String }),
  Schema.Struct({ ok: Schema.Literal(false), error: Schema.String, outcome: Schema.optionalKey(Schema.String) }),
  Schema.Struct({ exchanged: Schema.Boolean }),
])

export type SyncSelectionRecord = typeof SyncSelection.Type

export const decodeSelection = Schema.decodeUnknownEffect(Schema.fromJsonString(SelectionDocument))
export const decodeLegacySelection = Schema.decodeUnknownEffect(Schema.fromJsonString(LegacySelectionDocument))
export const decodeOffered = Schema.decodeUnknownOption(SyncSelection)
export const decodeSlotRead = Schema.decodeUnknownEffect(SlotRead)
export const decodeSlotExchange = Schema.decodeUnknownEffect(SlotExchange)
