// spec/app/calendar/deletions.md, "Story: Undo a deletion before it is sent"
import * as View from "../../gen/app__calendar.effect.vibe"
import * as Held from "../../gen/app__calendar__deletions.effect.vibe"
import type { Effect as Out, Event, Reach } from "../../gen/app__calendar__deletions.effect.vibe"
import * as Editor from "../../gen/app__calendar__editor.effect.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import * as Notices from "../../gen/app__notices__toasts.effect.vibe"
import { type Due, type Job, contained, due, following, hearing, reacting, started, tell, together } from "../runtime/reactor.vibe"
import { shown } from "./shown.ts"

const released = new Map<number, { readonly reach: Reach; readonly revision: number; readonly version: string; readonly answer: string }>()

/** The reach of a deletion currently sending or awaiting reread, defaulting to one event. */
export function releasedReach(id: number): Reach {
  return released.get(id)?.reach ?? "OneEvent"
}

// spec/app/calendar/deletions.md, "Confirming a deletion holds it; a deletion still waiting is sent first, so the only Undo shown is the newest"; spec/app/calendar/deletions.md, "A refused send shows the event again and says it was not deleted; a sent deletion hides it until a read no longer has it unchanged"; spec/app/calendar/deletions.md, "A deletion is sent only when its window ended with its notice gone, when the owner leaves, when a newer one is confirmed, or when the owner sends one a restart paused, at the revision confirmed"
/** A released deletion goes to the editor at the revision the owner confirmed, which sends it once; one the editor cannot take now ends refused, and its event shows again. */
function carry(fx: Out): Job<Event, Editor.Machine, []> {
  const row = shown.find(fx.id) ?? shown.lastSeen(fx.id)
  released.set(fx.id, { reach: fx.reach, revision: fx.revision, version: row?.version ?? "", answer: row?.answer ?? "" })
  const remove: Editor.Event = {
    type: "deleteEvent", id: fx.id, revision: fx.revision,
    scope: fx.reach === "WholeSeries" ? "WholeSeries" : fx.reach === "FromThisOn" ? "ThisAndFollowing" : "ThisOne", repeating: row?.recurring ?? false,
  }
  return tell(`release ${fx.id}`, Editor.Machine, [remove], { refused: { type: "ended", id: fx.id, done: false } })
}

/** Emits whenever either calendar source transitions to or advances a loaded read. */
export function loadedReads(view: View.Machine.Shape) {
  const loaded = Stream.filter(view.changes, (s) => s.phone.status === "Loaded" || s.google.status === "Loaded")
  return Stream.changesWith(
    loaded,
    (a, b) =>
      a.phone.status === b.phone.status
      && a.phone.ticket === b.phone.ticket
      && a.google.status === b.google.status
      && a.google.ticket === b.google.ticket,
  )
}

// spec/app/calendar/deletions.md, "A refused send shows the event again and says it was not deleted; a sent deletion hides it until a read no longer has it unchanged"
const observed = started(effect {
  const view = try View.Machine
  const held = try Held.Machine
  try Stream.runForEach(
    loadedReads(view),
    effect () => {
      const d = try held.get()
      if (d.hiding === 0) {
        if (d.sending === 0 && released.size > 0) released.clear()
        return
      }
      const state = try view.get()
      const prior = shown.find(d.hiding) ?? shown.lastSeen(d.hiding)
      const source = prior?.source === "Phone" ? state.phone : state.google
      if (source.status !== "Loaded") return
      const found = shown.find(d.hiding)
      const expected = released.get(d.hiding)
      const unchanged = found !== undefined
        && (expected === undefined
          ? found.revision === d.revision
          : found.revision === expected.revision && (expected.version === "" || found.version === expected.version) && found.answer === expected.answer)
      try contained(held.send({ type: "readShows", id: d.hiding, unchanged }), "checking whether a hidden deletion changed")
      if (!unchanged) released.delete(d.hiding)
    },
  )
}, "observing calendar reads for hidden deletions")

// spec/app/calendar/deletions.md, "The window ends only once its Undo notice is no longer shown"
/** The Undo notice lasts the window; once it has gone, the window ends. A deletion a restart paused waits for the owner. */
function timers(state: Held.Deletions): ReadonlyArray<Due<Event, []>> {
  if (state.waiting === 0 || state.paused) return []
  return state.notice
    ? [due<Event, []>("notice", state.undo.until, { type: "noticeGone" })]
    : [due<Event, []>("window", state.undo.until, { type: "windowEnded", now: state.undo.until })]
}

/** Whether Alpha's page is in front, each time that changes. */
const away = Stream.unwrap(effect {
  return Stream.filter(Stream.changes(Stream.map((try Shell.Machine).changes, (shell) => Shell.showing(shell, "Calendar"))), (front) => !front)
})

// spec/app/calendar/deletions.md, "Leaving Calendar sends a waiting deletion at once"
const left = hearing(away, Held.Machine, (): Event => ({ type: "leave" }))

// spec/app/calendar/deletions.md, "The Undo window is ten seconds, scaled by Android's timeout setting"
const scaled = following(Notices.Machine, (notices) => notices.scale, Held.Machine, (scale): Event | undefined => (scale >= 100 ? { type: "scaleChanged", scale } : undefined))

// spec/app/calendar/deletions.md, "A restart pauses a deletion still in its window; the owner sends it or keeps the event"
/** Calendar's deletions: kept on the phone with their Undo window across a restart, which pauses one still waiting, and released to the editor. */
export const deletions = together(reacting(Held, { keep: 1, open: [{ type: "restart" }], carry, timers }), left, scaled, observed)
