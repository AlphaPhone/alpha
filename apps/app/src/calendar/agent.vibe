// spec/app/calendar/agent.md, "Story: Let the agent read my calendar"; spec/app/calendar/agent.md, "Story: Approve what the agent changes"; spec/app/calendar/agent.md, "Story: Know what the agent's change did"
import * as Changes from "../../gen/app__calendar__agent.effect.vibe"
import type { Actor, Effect as Out, Event, Query, Reply } from "../../gen/app__calendar__agent.effect.vibe"
import { Agent } from "../platform/agent.vibe"
import { ask, attemptedWith } from "../platform/remote.vibe"
import { Attempts } from "../runtime/attempts.vibe"
import { type Job, answer, reacting, run, stream } from "../runtime/reactor.vibe"
import { Time } from "../runtime/time.vibe"
import { type Row, shown } from "./shown.ts"
import { civilDay, dayStart, zone } from "./time.ts"

const base = "/api/lifeops/calendar"

/** What a read of the agent's calendar says, as far as Calendar asks: whether Google answered. */
schema Answered { readonly state: "complete" | "partial" | "unavailable" }

/** What a read back finds of one event: whether it is listed. */
schema Listed { readonly events: ReadonlyArray<{ readonly id: string }> }

/** The window the agent's reads cover: today and the six days after. */
function week(now: number) {
  const today = civilDay(now)
  return { timeMin: new Date(dayStart(today)).toISOString(), timeMax: new Date(dayStart(today + 7)).toISOString(), timeZone: zone() }
}

// spec/app/calendar/agent.md, "The agent reads events or free time directly, at any moment, and only the newest answer counts"
effect function read(ticket: number, query: Query): Event!!(Agent | Time) {
  const window = week(try (try Time).now())
  const path = query === "FreeTime" ? `${base}/next-context` : `${base}/feed`
  const answered = ask(Agent, HttpClientRequest.get(path, { urlParams: window }), Answered) catch () => undefined
  return { type: "feedAnswered", ticket, ok: answered !== undefined && answered.state !== "unavailable" }
}

const replies: Readonly<Record<Reply, string>> = { NoReply: "", Going: "accepted", Maybe: "tentative", NotGoing: "declined" }

// spec/app/calendar/agent.md, "What is sent is exactly the change approved, for the revision the agent selected"
/** The request that carries an approved change under its idempotency key: the event as the agent selected it. */
function request(change: Out & { tag: "Send" }, row: Row | undefined, key: string) {
  const event = encodeURIComponent(row?.key ?? "")
  const version = String(change.revision)
  const scope = change.series ? "all" : "this"
  switch (change.change) {
    case "Create":
      return HttpClientRequest.post(`${base}/events`) |> HttpClientRequest.bodyJsonUnsafe(%, { title: row?.title ?? "", startAt: new Date(row?.begin ?? 0).toISOString(), endAt: new Date(row?.end ?? 0).toISOString(), timeZone: zone(), idempotencyKey: key })
    case "Update":
      return HttpClientRequest.patch(`${base}/events/${event}`) |> HttpClientRequest.bodyJsonUnsafe(%, { title: row?.title, recurrenceScope: scope, expectedProviderVersion: version, idempotencyKey: key })
    case "Delete":
      return HttpClientRequest.delete(`${base}/events/${event}`, { urlParams: { recurrenceScope: scope, expectedProviderVersion: version, idempotencyKey: key, cancellationMode: "organizer_cancel" } })
    case "Respond":
      return HttpClientRequest.post(`${base}/events/${event}/response`) |> HttpClientRequest.bodyJsonUnsafe(%, { responseStatus: replies[change.reply], expectedProviderVersion: version, idempotencyKey: key })
  }
}

// spec/app/calendar/agent.md, "A change Google confirms is read back; a refused or unknown one ends there and is reported"
effect function send(change: Out & { tag: "Send" }): Event!!(Agent | Attempts) {
  const row = shown.find(change.id)
  const { confirmed, known } = try attemptedWith(Agent, (key) => request(change, row, key), change.attempt)
  return { type: "sent", attempt: change.attempt, confirmed, known }
}

// spec/app/calendar/agent.md, "The read back says whether the change is there, and the agent is told"
/** The read back's answer, or nothing where the agent could not be read: the change then waits to be read back after a restart. */
function readBack(ticket: number, id: number): Stream.Stream<Event, never, Agent | Time> {
  return Stream.unwrap(effect {
    const key = shown.find(id)?.key ?? ""
    const window = week(try (try Time).now())
    const listed = ask(Agent, HttpClientRequest.get(`${base}/feed`, { urlParams: window }), Listed) catch () => undefined
    return listed === undefined ? Stream.empty : Stream.succeed<Event>({ type: "readBack", ticket, present: listed.events.some((event) => event.id === key) })
  })
}

const world: Actor = "World"

function carry(fx: Out): Job<Event, Agent | Time, [by: Actor]> {
  return match (fx) {
    when { tag: "Ask", let ticket, let query }: answer("ask", read(ticket, query), { type: "feedAnswered", ticket, ok: false }, world);
    when { tag: "Send" }: answer(`send ${fx.attempt}`, send(fx), { type: "sent", attempt: fx.attempt, confirmed: false, known: false }, world);
    when { tag: "ReadBack", let ticket, let id }: stream("read back", readBack(ticket, id), { type: "restart" }, world);
    when { tag: "Report" }: run("report", succeed(undefined), world);
  }
}

/** The agent's changes to the owner's Google Calendar: kept across restarts, which end what was in flight. */
export const changes = reacting(Changes, { keep: 1, open: [{ type: "restart" }, world], carry })
