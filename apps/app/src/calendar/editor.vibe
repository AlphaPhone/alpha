// spec/app/calendar/editor.md, "Story: Write an event"; spec/app/calendar/editor.md, "Story: Keep my draft through a restart"; spec/app/calendar/editor.md, "Story: Never create an event twice"; spec/app/calendar/editor.md, "Story: Delete an event, or answer an invitation"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Editor from "../../gen/app__calendar__editor.effect.vibe"
import type { Effect as Out, Event, Scope } from "../../gen/app__calendar__editor.effect.vibe"
import * as View from "../../gen/app__calendar.effect.vibe"
import type { AndroidCalendarDeletionScope, AndroidCalendarEditorFields, CalendarPick } from "@elizaos/os/bridges/calendar"
import { PhoneCalendar, type Written } from "../platform/calendar.vibe"
import { Attempts } from "../runtime/attempts.vibe"
import { type Job, answer, contained, reacting, run, started, together } from "../runtime/reactor.vibe"
import { Time } from "../runtime/time.vibe"
import { type Row, shown } from "./shown.ts"
import { dayStart, zone } from "./time.ts"

/** What the owner typed into the form, kept on the phone as it is typed: the spec counts the edits, this holds them. */
export schema Fields {
  readonly title: string
  readonly place: string
  readonly notes: string
  readonly begin: number
  readonly end: number
  readonly allDay: boolean
  readonly people: string
}

/** The form a new event opens with on `day`: an hour from nine. */
export function blank(day: number): Fields {
  const nine = dayStart(day) + 9 * 3_600_000
  return { title: "", place: "", notes: "", begin: nine, end: nine + 3_600_000, allDay: false, people: "" }
}

/** Where the form's fields are kept, and the creation identity of a create whose outcome is unknown. */
const formKey = "alpha.calendar.form"
const creationKey = "alpha.calendar.creation"

const decodeFields = Schema.decodeUnknownEffect(Schema.fromJsonString(Fields))

/** The fields kept on the phone, or a blank form for `day` where none are. */
export effect function kept(day: number): Fields!!KeyValueStore.KeyValueStore {
  const text = (try KeyValueStore.KeyValueStore).get(formKey) catch () => undefined
  return text === undefined ? blank(day) : (decodeFields(text) catch () => blank(day))
}

/** Keep `fields` on the phone; whether the phone kept them. */
effect function keep(fields: Fields): boolean!!KeyValueStore.KeyValueStore {
  return ((try KeyValueStore.KeyValueStore).set(formKey, JSON.stringify(fields)) |> Effect.as(%, true)) catch () => false
}

// spec/app/calendar/editor.md, "Each edit is counted and kept on the phone at once, unless the phone failed to keep the draft"
/** The owner typed into the form: keep it on the phone, then count the edit; a store that refuses says so. */
export effect function typed(fields: Fields, edit: Event) {
  const editor = try Editor.Machine
  if (!(try keep(fields))) try contained(editor.send({ type: "keepFailed" }), "saying the draft was not kept")
  try contained(editor.send(edit), "counting an edit of the event")
}

/** An event of the phone as eliza's calendar review picks it. */
function pickOf(row: Row): CalendarPick {
  return {
    event: { id: row.key, calendarId: row.calendarId, title: row.title, body: row.notes, location: row.place, begin: row.begin, end: row.end, allDay: row.allDay, recurring: row.recurring },
    calendar: { id: row.calendarId, writable: true, local: true },
  }
}

function fieldsOf(fields: Fields): AndroidCalendarEditorFields {
  return { title: fields.title.trim(), body: fields.notes, location: fields.place, begin: fields.begin, end: fields.end }
}

const refused: Written = { confirmed: false, known: true }

/** Which occurrences eliza's deletion review takes; it has no "this and following". */
function deletionScope(scope: Scope, recurring: boolean): AndroidCalendarDeletionScope | undefined {
  return scope === "ThisOne" ? (recurring ? "occurrence" : "event") : scope === "WholeSeries" ? "series" : undefined
}

// spec/app/calendar/editor.md, "Saving sends the form once, as a new numbered write built on the revision its edits began from"; spec/app/calendar/editor.md, "No create is sent while an earlier one is in doubt, unless the owner asked for a separate event"
/** Carry out write `attempt`: a create under its own creation identity, a change or a deletion through the phone's review. */
effect function send(attempt: number, kind: "Create" | "Update" | "Remove" | "Reply", id: number, scope: Scope): Written!!(PhoneCalendar | KeyValueStore.KeyValueStore | Attempts | Time | Editor.Machine) {
  const phone = try PhoneCalendar
  const fields = try kept(0)
  if (kind === "Create") {
    const creation = try (try Attempts).key(attempt)
    try ignore((try KeyValueStore.KeyValueStore).set(creationKey, creation))
    return try phone.create(fieldsOf(fields), creation, (try (try Editor.Machine).get()).separate)
  }
  const row = shown.find(id)
  if (row === undefined || row.source !== "Phone" || kind === "Reply") return refused
  if (kind === "Update") return try phone.update(pickOf(row), fieldsOf(fields))
  const which = deletionScope(scope, row.recurring)
  if (which === undefined) return refused
  const staged = try phone.stage(pickOf(row), which)
  if (Option.isNone(staged)) return refused
  try (try Time).until(staged.value)
  return try phone.dispatch(row.key)
}

// spec/app/calendar/editor.md, "While a create is in doubt its form waits; checking the phone's receipts finds it or not"
/** Whether the phone's receipts say the create in doubt was made. */
effect function receipts(ticket: number): Event!!(PhoneCalendar | KeyValueStore.KeyValueStore) {
  const creation = (try KeyValueStore.KeyValueStore).get(creationKey) catch () => undefined
  if (creation === undefined) return { type: "receiptsChecked", ticket, found: false }
  const found = (try PhoneCalendar).created(creation) catch () => false
  return { type: "receiptsChecked", ticket, found }
}

// spec/app/calendar/editor.md, "Such a form is handed to Android Calendar and closes; Alpha writes nothing of it"
effect function handOff() {
  const fields = try kept(0)
  const people = fields.people.split(",").map((person) => person.trim()).filter((person) => person !== "")
  try (try PhoneCalendar).handOff({ ...fieldsOf(fields), allDay: fields.allDay, timeZone: zone(), attendees: people })
}

// spec/app/calendar/index.md, "The owner reads again whenever a source can be read"
/** How write `attempt` ended; the calendar then reads its day again, which shows the write or releases its doubt. */
effect function written(attempt: number, kind: "Create" | "Update" | "Remove" | "Reply", id: number, scope: Scope): Event!!(PhoneCalendar | KeyValueStore.KeyValueStore | Attempts | Time | Editor.Machine | View.Machine) {
  const outcome = try send(attempt, kind, id, scope)
  try contained((try View.Machine).send({ type: "refresh" }), "reading the day again after a write")
  return { type: "written", attempt, ...outcome }
}

function carry(fx: Out): Job<Event, PhoneCalendar | KeyValueStore.KeyValueStore | Time | Editor.Machine | View.Machine, []> {
  return match (fx) {
    when { tag: "Send", let attempt, let kind, let id, let scope }:
      answer(`write ${attempt}`, written(attempt, kind, id, scope), { type: "written", attempt, confirmed: false, known: false });
    when { tag: "Answer", let attempt }: answer(`answer ${attempt}`, succeed<Event>({ type: "written", attempt, ...refused }), { type: "written", attempt, confirmed: false, known: false });
    when { tag: "HandOff" }: run("hand off", Effect.ignore(handOff()));
    when { tag: "CheckReceipts", let ticket }: answer("receipts", receipts(ticket), { type: "receiptsChecked", ticket, found: false });
    when { tag: "KeepDraft" }:
      answer("keep", effect { return (try keep(try kept(0))) ? ({ type: "draftKept" } as Event) : ({ type: "keepFailed" } as Event) }, { type: "keepFailed" });
  }
}

// spec/app/calendar/editor.md, "A read of the event releases the doubt; a form waiting on it then shows the event as it now is"
/** Each read of the phone's day tells the form what it found of the event it edits or holds in doubt. */
const reread = started(effect {
  const view = try View.Machine
  const editor = try Editor.Machine
  try Stream.runForEach(Stream.changesWith(Stream.filter(view.changes, (s) => s.phone.status === "Loaded"), (a, b) => a.phone.ticket === b.phone.ticket), effect (s) => {
    const form = try editor.get()
    for (const id of [form.target, form.latched]) {
      if (id === 0) continue
      const row = shown.of("Phone", s.phoneDay).find((candidate) => candidate.id === id)
      try contained(editor.send(row === undefined ? { type: "eventMissing", id } : { type: "eventRead", id, revision: row.revision }), "telling the form what the read found")
    }
  })
}, "following the phone's reads for the form")

/** The editor: kept on the phone across restarts, which ends what was in flight; its writes go to the phone's calendar once. */
export const editor = together(
  reacting(Editor, { keep: 1, open: [{ type: "restart" }], carry }),
  reread,
)
