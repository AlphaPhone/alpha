// spec/calendar/selection.md, "Story: Let the assistant know which day I am looking at"
import { Machine as PresentationMachine } from "../../gen/calendar__presentation.effect.vibe"
import { dayObservable } from "../../gen/calendar__selection.effect.vibe"
import { Foreground } from "../shell/foreground.vibe"
import { AgentCalendar } from "./agent.vibe"
import { calendarWall, deviceZone, midnightAfter } from "./time.ts"

/** The civil day Calendar shows, as lookup context for the assistant; no source, selection or read grant comes with it. */
export interface CalendarDayObservation {
  /** The shown day as `YYYY-MM-DD` in `timeZone`. */
  readonly date: string
  readonly timeZone: string
}

/** The day Calendar shows now, or nothing unless a plain, ready day of the current owner is in front, uncovered and unchanged. */
export effect function calendarDayObservation(): CalendarDayObservation | undefined {
  const front = try (try Foreground).get()
  const shown = try (try PresentationMachine).get()
  const agent = try (try AgentCalendar).view()
  const now = try Clock.currentTimeMillis
  const zone = deviceZone()
  const observable = dayObservable(front.visible && !front.locked, front.view === "calendar", front.shade, agent.state.status === "Ready",
    shown.owner !== "" && shown.owner === agent.state.owner, agent.state.write.id !== 0, shown.form !== "NoForm", shown.openEvent !== "",
    shown.view === "MonthView" || shown.datePicker)
  if (!observable || !Number.isSafeInteger(shown.day)) return undefined
  const wall = calendarWall(midnightAfter(now, zone, shown.day), zone)
  return wall === undefined ? undefined : { date: wall.slice(0, 10), timeZone: zone }
}
