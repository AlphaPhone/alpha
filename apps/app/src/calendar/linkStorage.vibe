// spec/calendar/deviceSync.md, "Checkpoints are kept only in the encrypted slot of their own name, never above 4 MiB"; spec/platform/storage.md, "Story: Keep what the earlier Alpha kept in its encrypted slots"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import type { CalendarLinkStorage } from "@elizaos/plugin-calendar/linked-sync"
import { checkpointKept } from "../../gen/calendar__deviceSync.ts"
import { adoptLegacySlot } from "../platform/legacy-slots.vibe"
import { Native } from "../platform/native.vibe"
import { decodeSlotExchange, decodeSlotRead } from "./deviceSync.schema.vibe"

const SECURE = "ElizaSecureStore"
const NAMED = /^calendar-linked-sync:v1:[a-f0-9]{64}$/

/** The slot the owner's device sync opt-in is kept in, under the name the earlier Alpha installed it with. */
export const SYNC_SETTINGS_SLOT = "calendar-linked-sync:v1:7d1f8a65cde513c690bb719ba9fb6e93372b9f0dc6e8a92b40c18245f3b71df9"

/** Linked sync's checkpoint could not be kept: a slot of another name, a document over 4 MiB, or a store that refused. */
export error CheckpointRefused { slot: string; reason: "name" | "size" | "unreadable" | "unwritable" }

/** The UTF-8 size of a checkpoint as it is stored. */
export function checkpointBytes(value: unknown): number {
  return new TextEncoder().encode(JSON.stringify(value)).length
}

/**
 * Linked sync's durable checkpoints: the secure store's encrypted, no-backup slots on the phone, the WebView's private storage
 * elsewhere. Every write is a compare and exchange on the exact value read, and what the earlier Alpha kept in its own slot of
 * that name is carried over before the slot is first read.
 */
export effect function calendarLinkStorage() {
  const native = try Native
  const store = try KeyValueStore.KeyValueStore
  const secure = try native.available(SECURE)
  const adopted = new Set<string>()

  effect function named(slot: string) {
    if (!NAMED.test(slot)) throw new CheckpointRefused({ slot, reason: "name" })
  }

  effect function adopt(slot: string) {
    if (!secure || adopted.has(slot)) return
    const outcome = Effect.provideService(adoptLegacySlot(slot, slot), Native, native) catch () => "NotAdopted" as const
    if (outcome !== "NotAdopted") adopted.add(slot)
  }

  effect function text(slot: string): string | undefined!CheckpointRefused {
    if (!secure) return try (store.get(`alpha.browser.${slot}`) catch effect () => { throw new CheckpointRefused({ slot, reason: "unreadable" }) })
    const raw = try (native.invoke(SECURE, "get", { key: slot }) catch effect () => { throw new CheckpointRefused({ slot, reason: "unreadable" }) })
    const read = try (decodeSlotRead(raw) catch effect () => { throw new CheckpointRefused({ slot, reason: "unreadable" }) })
    if ("ok" in read) {
      if (read.ok) return read.value
      if (read.error === "not_found") return undefined
      throw new CheckpointRefused({ slot, reason: "unreadable" })
    }
    return read.value ?? undefined
  }

  effect function exchange(slot: string, expected: string | undefined, value: string | undefined): boolean!CheckpointRefused {
    if (!secure) {
      const key = `alpha.browser.${slot}`
      const held = try (store.get(key) catch effect () => { throw new CheckpointRefused({ slot, reason: "unreadable" }) })
      if (held !== expected) return false
      try ((value === undefined ? store.remove(key) : store.set(key, value)) catch effect () => { throw new CheckpointRefused({ slot, reason: "unwritable" }) })
      return true
    }
    const raw = try (native.invoke(SECURE, "compareAndExchange", { key: slot, expected: expected ?? null, value: value ?? null })
      catch effect () => { throw new CheckpointRefused({ slot, reason: "unwritable" }) })
    const result = try (decodeSlotExchange(raw) catch effect () => { throw new CheckpointRefused({ slot, reason: "unwritable" }) })
    if ("exchanged" in result) return result.exchanged
    if (result.ok) return true
    if (result.error === "conflict") return false
    throw new CheckpointRefused({ slot, reason: "unwritable" })
  }

  effect function read(slot: string): unknown!CheckpointRefused {
    try named(slot)
    try adopt(slot)
    const held = try text(slot)
    if (held === undefined) return null
    return try (Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Unknown))(held) catch effect () => { throw new CheckpointRefused({ slot, reason: "unreadable" }) })
  }

  effect function compareExchange(slot: string, expected: unknown, value: unknown): { readonly status: "saved" | "conflict" }!CheckpointRefused {
    try named(slot)
    if (!checkpointKept(true, checkpointBytes(value), true)) throw new CheckpointRefused({ slot, reason: "size" })
    try adopt(slot)
    const saved = try exchange(slot, expected === null ? undefined : JSON.stringify(expected), value === null ? undefined : JSON.stringify(value))
    return { status: saved ? "saved" : "conflict" }
  }

  const storage: CalendarLinkStorage = {
    read: (slot) => runPromise(read(slot)),
    compareExchange: (slot, expected, value) => runPromise(compareExchange(slot, expected, value)),
  }
  return storage
}
