// spec/app/calendar/index.md, "Rows shown are for the day the calendar is anchored to, from a source it may read"; spec/app/calendar/agent.md, "The agent proposes one change at a time, for the revision of the event it selected, and the card shows it"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { type RequestsStore, createRequestsStore } from "./requests.ts"
import { Time } from "../runtime/index.vibe"
import { type KeptNumbers, type ShownStore, createShownStore, unreadNumbers } from "./shown.ts"

/** Scoped per-runtime store of Calendar events read from Phone and Google. */
export service Shown: ShownStore {}

/** Scoped per-runtime store of agent Calendar approval requests. */
export service Requests: RequestsStore {}

/**
 * Where the numbers Calendar gave events are kept, so that a deletion or a form kept across a restart names the event it
 * was for. What is there and cannot be decoded is set aside beside it first, and where the store cannot be read nothing is
 * written over it; without numbers it can read, numbering goes on past every earlier start.
 */
const numbersKey = "alpha.calendar.numbers"
const decodeNumbers = Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Struct({ last: Schema.Number, numbers: Schema.Array(Schema.Tuple([Schema.String, Schema.Number])) })))

// spec/app/calendar/deletions.md, "Deletions hold the owner they are for, the deletion under review, the one waiting with its Undo window and whether its notice shows, the one being sent, and the one sent that a read has yet to confirm"
const shownLayer = Layer.effect(Shown, effect {
  const kv = try KeyValueStore.KeyValueStore
  const now = try (try Time).now()
  const got: { readonly stored: string | undefined } | undefined = effect { return { stored: try kv.get(numbersKey) } } catch () => undefined
  const stored = got?.stored
  const read: KeptNumbers | undefined = stored === undefined ? undefined : decodeNumbers(stored) catch () => undefined
  if (stored !== undefined && read === undefined) try ignore(kv.set(`${numbersKey}.unreadable`, stored))
  const kept = read ?? unreadNumbers(now)
  const keep = (numbers: KeptNumbers) => runFork(ignore(kv.set(numbersKey, JSON.stringify(numbers))))
  const store = createShownStore(kept, got === undefined ? undefined : keep)
  try Effect.addFinalizer(() => sync(() => { store.reset() }))
  return store
})

const requestsLayer = Layer.effect(Requests, effect {
  const store = createRequestsStore()
  try Effect.addFinalizer(() => sync(() => { store.reset() }))
  return store
})

/** Scoped Calendar side-stores, created freshly per runtime and reset on scope close. */
export const stores = Layer.mergeAll(shownLayer, requestsLayer)
