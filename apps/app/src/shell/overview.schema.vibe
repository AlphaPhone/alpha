// spec/shell/overview.md, "Rows read on an earlier day are read again at midnight, and a failed read hides them"; spec/shell/overview.md, "The brief card shows the newest retained brief, and says when it failed or did not run"

/** One attendee of a feed event; only its name is used, for initials. */
export schema FeedAttendee { readonly displayName?: string | null; readonly email?: string | null }

/** One event of the agent's calendar feed. */
export schema FeedEvent {
  readonly id: string
  readonly title: string
  readonly startAt: string
  readonly endAt: string
  readonly isAllDay: boolean
  readonly conferenceLink?: string | null
  readonly attendees?: FeedAttendee[]
}

/** `GET /api/lifeops/calendar/feed`: the events, and whether every source answered. */
export schema CalendarFeed {
  readonly events: FeedEvent[]
  readonly state: "complete" | "partial" | "unavailable"
}

/** One workflow of `GET /api/workflow/workflows`; it counts as on while it is active and not removed. */
export schema WorkflowRow { readonly active: boolean; readonly removed?: boolean }

/** `GET /api/workflow/workflows`. */
export schema WorkflowList { readonly workflows: WorkflowRow[] }

/** One prompt of `GET /api/triggers`; it counts as on while it is enabled. */
export schema PromptRow { readonly enabled: boolean }

/** `GET /api/triggers`. */
export schema PromptList { readonly triggers: PromptRow[] }
