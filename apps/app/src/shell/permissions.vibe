// spec/shell/permissions.md, "Story: Grant Alpha what it needs, when I choose"; spec/shell/permissions.md, "An allowed step says how much Android allowed, and a browser request left off says so"; spec/shell/permissions.md, "Back leaves a review and finishes the Ready card; on a first-run step it does nothing"; spec/shell/permissions.md, "A step still checking or asking after twenty seconds can be skipped"; spec/shell/permissions.md, "On the Alpha image, steps Android already granted pass by themselves, and an untouched walkthrough ends on Home"; spec/shell/permissions.md, "An earlier Alpha's walkthrough record is read once, when this one has none"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import {
  Machine as PermissionsMachine, StallSeconds, accessOf as stepAccess, backOf, keyAt, legacySaved, panelShown, passesItself, walkthroughOpens,
  type Access, type Event as PermissionsEvent, type Grant, type Perm, type Permissions as Walkthrough,
} from "../../gen/shell__permissions.effect.vibe"
import { Build } from "../platform/build.vibe"
import { Native } from "../platform/native.vibe"
import { ownerKey } from "../platform/storage.vibe"
import {
  CalendarAccess, CameraAccess, FilesAccess, LegacyWalkthroughMemory, LegacyWalkthroughProgress, LocationAccess, MicrophoneAccess,
  NotificationAccess, PhotoAccess, PlatformCapabilities, SavedProgress,
} from "./native.schema.vibe"
import { Navigation, setHoldBack } from "./navigation.vibe"
import { browserPermissionRequest, browserPermissionStatus, pageEvents, pageHidden, storedValue } from "./page.ts"

/** Where the walkthrough's progress is kept on this device. */
export const PROGRESS_KEY = ownerKey("device", "shell/permission-progress")

/** Where an earlier Alpha kept the walkthrough's position and the prompts it already showed. */
export const LEGACY_PROGRESS_KEY = "alpha:startup-permission-walkthrough:v1"
export const LEGACY_MEMORY_KEY = "alpha.startup-permissions.v1"

/** The navigation hold the walkthrough takes while its panel is shown. */
export const WALKTHROUGH_HOLD = "permissions"

/** What decides whether the walkthrough may open now, from the account area. */
export interface ConnectionFacts {
  readonly account: boolean
  readonly ownKeys: boolean
  readonly signingIn: boolean
  readonly busy: boolean
  readonly residentStarting: boolean
  readonly background: boolean
  /** A new account was made by this sign-in. */
  readonly created: boolean
  /** The account has something the Ready card must show: a connection error, a missing plan, an unavailable agent or an unconfirmed revocation. */
  readonly attention?: boolean
}

const LEGACY_NAMES: Readonly<Record<string, Perm>> = {
  notifications: "PermNotifications", microphone: "PermMicrophone", camera: "PermCamera", location: "PermLocation",
  calendar: "PermCalendar", photos: "PermPhotos", files: "PermFiles",
  browsernotifications: "PermNotifications", browsermicrophone: "PermMicrophone", browsercamera: "PermCamera", browserlocation: "PermLocation",
}

/** The kept progress an earlier Alpha's records stand for, or undefined when there are none. */
export function legacyProgress(progress: LegacyWalkthroughProgress | undefined, memory: LegacyWalkthroughMemory | undefined, native: boolean) {
  if (progress === undefined && memory === undefined) return undefined
  const attempted = Object.entries(memory?.attempted ?? {}).flatMap(([name, shown]) => shown === true && Object.hasOwn(LEGACY_NAMES, name) ? [LEGACY_NAMES[name]] : [])
  const completed = progress?.status === "completed"
  return {
    attempted: [...new Set(attempted)],
    saved: progress === undefined ? 0 : legacySaved(progress.version, completed, progress.step, native),
    done: completed,
    touched: progress?.choices?.includes("skipped") === true,
  }
}

/** The startup access walkthrough, for the account area and Settings. */
export service Permissions {
  /** The connection changed: open the walkthrough for a signed-in account, or return to sign-in. */
  connection(facts: ConnectionFacts): void!!
  /** Allow on the current step: Android asks only now, and only once. */
  allow(): void!!
  /** Moves past the current step; `skip` moves on without its access. */
  next(skip: boolean): void!!
  /** Done on the Ready card. */
  finish(): void!!
  /** Settings → "Set up Alpha access" at one step. */
  reopen(index: number): void!!
  /** Leaves a review opened from Settings. */
  close(): void!!
}

/** What the platform says of one step: its access and, where Android tells, how much it allowed. */
interface Reading {
  readonly access: Access
  readonly grant: Grant
}

interface Bridge {
  readonly status: () => Reading!!
  readonly request: () => void!!
  readonly settings: () => void!!
}

type Answer = "granted" | "denied" | "prompt" | "prompt-with-rationale" | "unsupported"

function accessFrom(answer: Answer, attempted: boolean): Access {
  if (answer === "granted") return "AccessReady"
  if (answer === "unsupported") return "AccessUnavailable"
  return answer === "denied" || attempted ? "AccessSettings" : "AccessAsk"
}

const NO_GRANT: Grant = "GrantNone"

function locationGrant(accuracy: "precise" | "approximate" | "none" | undefined): Grant {
  return accuracy === "precise" ? "GrantPrecise" : accuracy === "approximate" ? "GrantApproximate" : "GrantNone"
}

function photoGrant(scope: "full" | "partial" | "selected" | "denied"): Grant {
  return scope === "full" ? "GrantAll" : scope === "selected" ? "GrantSelected" : scope === "partial" ? "GrantLimited" : "GrantNone"
}

const BROWSER_NAMES: Readonly<Record<Perm, "notifications" | "microphone" | "camera" | "location">> = {
  PermNotifications: "notifications", PermMicrophone: "microphone", PermCamera: "camera", PermLocation: "location",
  PermCalendar: "notifications", PermPhotos: "notifications", PermFiles: "notifications",
}

/** The walkthrough service: each step's platform reader, the owner's request and the kept progress. */
export const permissionsLive = Layer.effect(Permissions, effect {
  const native = try Native
  const build = try Build
  const store = try KeyValueStore.KeyValueStore
  const machine = try PermissionsMachine
  const navigation = try Navigation
  const scope = try Scope.Scope
  const onDevice = build.info.variant !== "browser"
  let stallTimer: Fiber.Fiber<void> | undefined
  let stallStep = ""
  let held = false

  effect function sendTo(event: PermissionsEvent) {
    const sent = machine.send(event) catch () => undefined
    return sent
  }

  effect function attempted(key: Perm) {
    return (try machine.get()).attempted.includes(key)
  }

  effect function nativeAnswer<A>(plugin: string, method: string, decode: (input: unknown) => A!unknown, read: (value: A) => Answer) {
    const value = effect { return read(try decode(try native.invoke(plugin, method))) } catch () => "unsupported" as Answer
    return value
  }

  effect function nativeReading<A>(key: Perm, plugin: string, method: string, decode: (input: unknown) => A!unknown, read: (value: A) => Answer, grant: (value: A) => Grant) {
    const value = effect { return try decode(try native.invoke(plugin, method)) } catch () => undefined
    const access = accessFrom(value === undefined ? "unsupported" : read(value), try attempted(key))
    return { access, grant: value === undefined || access !== "AccessReady" ? NO_GRANT : grant(value) } satisfies Reading
  }

  const plain = (access: Access): Reading => ({ access, grant: NO_GRANT })

  function bridgeFor(key: Perm): Bridge {
    const privacy = () => native.invoke("AlphaDevice", "openSettings", { page: "privacy" }) catch () => undefined
    const quietly = (plugin: string, method: string, args?: unknown) => native.invoke(plugin, method, args) catch () => undefined
    if (!onDevice) {
      const name = BROWSER_NAMES[key]
      return {
        status: effect () => plain(accessFrom(try browserPermissionStatus(name), try attempted(key))),
        request: () => browserPermissionRequest(name),
        settings: () => sync(() => undefined),
      }
    }
    const state = (value: string): Answer => value === "granted" || value === "denied" ? value : value === "prompt" || value === "prompt-with-rationale" ? "prompt" : "unsupported"
    switch (key) {
      case "PermNotifications": return {
        status: effect () => {
          const read = effect { return try Schema.decodeUnknownEffect(NotificationAccess)(try native.invoke("AlphaNotifications", "status")) } catch () => undefined
          if (read === undefined) return plain("AccessUnavailable")
          return plain(read.permissionGranted && read.appEnabled ? "AccessReady" : accessFrom("prompt", try attempted(key) || read.permissionGranted))
        },
        request: () => quietly("DailyApps", "requestPermissions", { permissions: ["notifications"] }),
        settings: () => quietly("AlphaDevice", "openSettings", { page: "notifications" }),
      }
      case "PermMicrophone": return {
        status: effect () => plain(accessFrom(try nativeAnswer("AlphaVoiceCloud", "checkPermissions", Schema.decodeUnknownEffect(MicrophoneAccess), (v) => state(v.microphone)), try attempted(key))),
        request: () => quietly("AlphaVoiceCloud", "requestPermissions", { permissions: ["microphone"] }),
        settings: privacy,
      }
      case "PermCamera": return {
        status: effect () => plain(accessFrom(try nativeAnswer("DailyApps", "checkPermissions", Schema.decodeUnknownEffect(CameraAccess), (v) => state(v.camera)), try attempted(key))),
        request: () => quietly("DailyApps", "requestPermissions", { permissions: ["camera"] }),
        settings: privacy,
      }
      case "PermLocation": return {
        status: () => nativeReading(key, "ElizaLocation", "checkPermissions", Schema.decodeUnknownEffect(LocationAccess), (v) => state(v.location), (v) => locationGrant(v.accuracy)),
        request: () => quietly("ElizaLocation", "requestPermissions"),
        settings: privacy,
      }
      case "PermCalendar": return {
        status: effect () => plain(accessFrom(try nativeAnswer("AlphaCalendar", "checkPermissions", Schema.decodeUnknownEffect(CalendarAccess), (v) => state(v.calendar)), try attempted(key))),
        request: () => quietly("AlphaCalendar", "requestAccess"),
        settings: privacy,
      }
      case "PermPhotos": return {
        status: () => nativeReading(key, "AlphaPhotoLibrary", "scope", Schema.decodeUnknownEffect(PhotoAccess), (v) => v.locked ? "unsupported" : v.scope === "denied" ? "denied" : "granted", (v) => photoGrant(v.scope)),
        request: () => quietly("AlphaPhotoLibrary", "requestAccess"),
        settings: privacy,
      }
      case "PermFiles": return {
        status: effect () => plain(accessFrom(try nativeAnswer("AlphaFiles", "storageState", Schema.decodeUnknownEffect(FilesAccess), (v) => v.access === "denied" ? "prompt" : "granted"), try attempted(key))),
        request: () => quietly("AlphaFiles", "storageRequestAccess"),
        settings: () => quietly("AlphaFiles", "storageRequestAccess", { settings: true }),
      }
    }
  }

  effect function readAll() {
    const state: Walkthrough = try machine.get()
    for (const key of state.keys) {
      const reading = try bridgeFor(key).status()
      try sendTo({ type: "platformStatus", key, access: reading.access, grant: reading.grant })
    }
  }

  effect function save(state: Walkthrough) {
    const saved = {
      attempted: [...state.attempted], saved: state.completed ? state.keys.length : Math.max(0, state.progress), done: state.completed,
      touched: !state.untouched,
    }
    const kept = store.set(PROGRESS_KEY, JSON.stringify(saved)) catch () => false
    if (kept === false) try sendTo({ type: "progressWriteFailed" })
  }

  effect function decodeStored<A>(text: string | null | undefined, decode: (input: unknown) => A!unknown) {
    if (typeof text !== "string") return undefined
    const value = effect { return try decode(try Effect.try(() => JSON.parse(text))) } catch () => undefined
    return value
  }

  effect function stallLater(step: string) {
    try sleep(Duration.seconds(StallSeconds))
    if (stallStep === step) try sendTo({ type: "stall" })
  }

  effect function readImageDefaults() {
    const answer = timeout(native.invoke("DeviceApps", "platformCapabilities"), "1500 millis") catch () => undefined
    const facts = answer === undefined ? undefined : (Schema.decodeUnknownEffect(PlatformCapabilities)(answer) catch () => undefined)
    try sendTo({ type: "imageDefaults", granted: facts?.startupPermissionDefaults === true })
  }

  effect function follow(state: Walkthrough) {
    const step = state.phase === "PhaseWalkthrough" && !state.stalled ? `${state.generation}:${state.target}:${state.progress}` : ""
    if (step !== stallStep) {
      stallStep = step
      if (stallTimer !== undefined) try Fiber.interrupt(stallTimer)
      stallTimer = undefined
      if (step !== "") stallTimer = fork.in(scope) stallLater(step)
    }
    const shown = panelShown(state)
    if (shown !== held) {
      held = shown
      try navigation.send(shown ? { type: "hold", id: WALKTHROUGH_HOLD } : { type: "release", id: WALKTHROUGH_HOLD })
    }
    if (passesItself(state) && state.pending === -1 && stepAccess(state, state.progress) === "AccessReady") {
      const after = try sendTo({ type: "advance", skip: false })
      if (after !== undefined) try save(after)
    }
  }

  const raw = store.get(PROGRESS_KEY) catch () => undefined
  const text = Option.isOption(raw) ? Option.getOrUndefined(raw) : raw
  const kept = try decodeStored(text, Schema.decodeUnknownEffect(SavedProgress))
  const earlier = kept !== undefined || typeof text === "string" ? undefined : legacyProgress(
    try decodeStored(storedValue(LEGACY_PROGRESS_KEY), Schema.decodeUnknownEffect(LegacyWalkthroughProgress)),
    try decodeStored(storedValue(LEGACY_MEMORY_KEY), Schema.decodeUnknownEffect(LegacyWalkthroughMemory)),
    onDevice,
  )
  const restored = kept ?? earlier
  try sendTo({
    type: "restore", native: onDevice, attempted: restored === undefined ? [] : [...restored.attempted], saved: restored?.saved ?? 0,
    done: restored?.done ?? false, touched: restored?.touched === true,
  })
  if (earlier !== undefined) try save(try machine.get())
  if (onDevice) fork.scoped readImageDefaults()
  try readAll()
  fork.scoped (effect { for try (const state of machine.changes) try follow(state) })
  try sync(() => setHoldBack(WALKTHROUGH_HOLD, () => effect {
    switch (backOf(try machine.get())) {
      case "BackCloses": return (try sendTo({ type: "closeTarget" })) !== undefined
      case "BackFinishes": return (try sendTo({ type: "finish" })) !== undefined
      case "BackHeld": return false
    }
  }))
  fork.scoped (effect {
    for try (const _ of pageEvents("visibilitychange", "document")) {
      if (pageHidden()) try sendTo({ type: "suspend" })
      else {
        try sendTo({ type: "resume" })
        try readAll()
      }
    }
  })

  return {
    effect connection(facts: ConnectionFacts) {
      const state = try machine.get()
      const opens = walkthroughOpens(facts.account, facts.ownKeys, facts.signingIn, facts.busy, facts.residentStarting, facts.background)
      if (opens && !state.signedIn) try sendTo({ type: "signIn", created: facts.created })
      else if (!facts.account && !facts.ownKeys && state.signedIn) try sendTo({ type: "signOut" })
      const attention = facts.attention === true
      if ((try machine.get()).attention !== attention) try sendTo({ type: "accountAttention", attention })
    },
    effect allow() {
      const begun = try sendTo({ type: "begin" })
      if (begun === undefined) return
      const key = keyAt(begun, begun.pending)
      const bridge = bridgeFor(key)
      const access = stepAccess(begun, begun.pending)
      if ((try sendTo({ type: "ask" })) !== undefined) {
        try save(try machine.get())
        try bridge.request()
      } else if (access === "AccessSettings" || (begun.target >= 0 && begun.native && access === "AccessReady")) {
        try bridge.settings()
      }
      const reading = try bridge.status()
      try sendTo({ type: "settle", access: reading.access })
      if (reading.access === "AccessReady") try sendTo({ type: "platformStatus", key, access: reading.access, grant: reading.grant })
    },
    effect next(skip: boolean) {
      const after = try sendTo({ type: "advance", skip })
      if (after !== undefined) try save(after)
    },
    effect finish() { try sendTo({ type: "finish" }) },
    effect reopen(index: number) {
      try sendTo({ type: "openTarget", index })
      try readAll()
    },
    effect close() { try sendTo({ type: "closeTarget" }) },
  }
})
