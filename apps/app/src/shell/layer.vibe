// spec/shell/index.md, "Story: Open an app from Home and keep my place"; spec/platform/storage.md, "A stored value that is not a state is held for review and never written over"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { decodeState as decodeNavigation, machine as navigationMachine, stored as storedNavigation } from "../../gen/shell__navigation.effect.vibe"
import { decodeState as decodeFavorites, machine as favoritesMachine, stored as storedFavorites } from "../../gen/shell__favorites.effect.vibe"
import { machine as gesturesMachine } from "../../gen/shell__gestures.effect.vibe"
import { machine as appInfoMachine } from "../../gen/shell__appInfo.effect.vibe"
import { machine as shadeMachine } from "../../gen/shell__shade.effect.vibe"
import { machine as inventoryMachine } from "../../gen/shell__inventory.effect.vibe"
import { machine as toastsMachine } from "../../gen/shell__toasts.effect.vibe"
import { machine as geometryMachine } from "../../gen/shell__geometry.effect.vibe"
import { machine as focusMachine } from "../../gen/shell__focus.effect.vibe"
import { machine as overviewMachine } from "../../gen/shell__overview.effect.vibe"
import { machine as permissionsMachine } from "../../gen/shell__permissions.effect.vibe"
import { machine as recoveryMachine } from "../../gen/shell__recovery.effect.vibe"
import { machine as hapticsMachine } from "../../gen/shell__haptics.effect.vibe"
import { DeviceStorage } from "../platform/device-storage.vibe"
import { ownerKey } from "../platform/storage.vibe"
import { activityLive } from "./activity.vibe"
import { focusLive } from "./focus.vibe"
import { foregroundLive } from "./foreground.vibe"
import { geometryLive } from "./geometry.vibe"
import { hapticsLive } from "./haptics.vibe"
import { launcherLive } from "./launcher.vibe"
import { navigationLive } from "./navigation.vibe"
import { noticesLive } from "./notices.vibe"
import { overviewLive } from "./overview.vibe"
import { permissionsLive } from "./permissions.vibe"
import { recoveryLive } from "./recovery.vibe"
import { shadeLive } from "./shade.vibe"
import { portsLive } from "./ports.vibe"

export { ShellMail, IdleSources, type ReviewedEmail, type QuietFacts } from "./ports.vibe"
export { handoffsLive } from "./handoffs.vibe"
export { operationPorts } from "./operations.vibe"

/** Where the shell keeps its durable machines: the navigation and Home's favorites are the device's, not an account's. */
export const NAVIGATION_KEY = ownerKey("device", "shell/navigation")
export const FAVORITES_KEY = ownerKey("device", "shell/favorites")

/**
 * The machine kept under `key`, unless what is stored there is not a state: then the value is held for the owner's review through
 * DeviceStorage, where the program provides it, and this session runs on a fresh machine in memory, so the value is never written over.
 */
export function keptOrHeld<A, E, R>(key: string, decode: (input: unknown) => unknown!unknown, kept: Layer.Layer<A, E, R>, fresh: Layer.Layer<A>) {
  return Layer.unwrap(effect {
    const store = try KeyValueStore.KeyValueStore
    const found = store.get(key) catch () => undefined
    const text = Option.isOption(found) ? Option.getOrUndefined(found) : found
    if (typeof text !== "string") return kept
    const valid = effect { try decode(try Effect.try(() => JSON.parse(text) as unknown)); return true } catch () => false
    if (valid) return kept
    const storage = try Effect.serviceOption(DeviceStorage)
    if (Option.isSome(storage)) try storage.value.hold(key)
    return fresh
  })
}

const machines = Layer.mergeAll(
  keptOrHeld(NAVIGATION_KEY, decodeNavigation, storedNavigation(NAVIGATION_KEY), navigationMachine()),
  keptOrHeld(FAVORITES_KEY, decodeFavorites, storedFavorites(FAVORITES_KEY), favoritesMachine()),
  gesturesMachine(), appInfoMachine(), shadeMachine(), inventoryMachine(), toastsMachine(), geometryMachine(),
  focusMachine(), overviewMachine(), permissionsMachine(), recoveryMachine(), hapticsMachine(),
)

const foundation = Layer.provideMerge(Layer.mergeAll(navigationLive, noticesLive, hapticsLive, portsLive), machines)

/** Every shell service and Machine (Navigation, Notices, Haptics, Launcher, Shade, Focus, Overview, Permissions, Recovery, Activity, Foreground) and the ports later areas fill (ShellMail, IdleSources), over the platform services. */
export const layer = Layer.provideMerge(
  Layer.mergeAll(launcherLive, shadeLive, geometryLive, focusLive, foregroundLive, overviewLive, permissionsLive, recoveryLive, activityLive),
  foundation,
)
