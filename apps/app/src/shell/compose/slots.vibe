// spec/shell/index.md, "Story: Open an app from Home and keep my place"; spec/files/share.md, "Story: Share the files I selected, to the place I chose"; spec/browser/egress.md, "Story: Share or keep the page I am looking at"; spec/calendar/presentation.md, "Story: Open an event and come back"; spec/workflows/clockDraft.md, "Story: Set an alarm a workflow suggests, from Workflows"; spec/assistant/noticeQuestion.md, "Story: Ask Alpha about a notification"; spec/maps/cards.md, "Story: Answer my agent's Maps question with one tap"
import { AssistantEmail, MapsChatCards, OwnNotices } from "../../assistant/ports.vibe"
import { PageMail } from "../../browser/ports.vibe"
import { CalendarMaps } from "../../calendar/ports.vibe"
import { FileShareTargets } from "../../files/share.vibe"
import { WorkflowClockPort } from "../../workflows/ports.vibe"

/** One port's implementation as it is now: the port's refusing default until the area that provides it is built. */
export interface Cell<S> {
  current: S
}

/** The ports an earlier area reads and a later area provides, each held as a cell the runtime fills once the provider is built. */
export service PortCells {
  /** The slot implementations themselves, which a cell never takes. */
  readonly slots: WeakSet<object>
  readonly fileShare: Cell<FileShareTargets.Shape>
  readonly pageMail: Cell<PageMail.Shape>
  readonly calendarMaps: Cell<CalendarMaps.Shape>
  readonly workflowClock: Cell<WorkflowClockPort.Shape>
  readonly assistantEmail: Cell<AssistantEmail.Shape>
  readonly ownNotices: Cell<OwnNotices.Shape>
  readonly mapsChat: Cell<MapsChatCards.Shape>
}

/** Puts `next` in `cell`, unless `next` is a slot, which would delegate to itself. */
export function fillCell<S extends object>(cells: PortCells.Shape, cell: Cell<S>, next: S): void {
  if (!cells.slots.has(next)) cell.current = next
}

function slot<S extends object>(cells: PortCells.Shape, shape: S): S {
  cells.slots.add(shape)
  return shape
}

const cellsLive = Layer.effect(PortCells, effect {
  return {
    slots: new WeakSet<object>(),
    fileShare: { current: try FileShareTargets },
    pageMail: { current: try PageMail },
    calendarMaps: { current: try CalendarMaps },
    workflowClock: { current: try WorkflowClockPort },
    assistantEmail: { current: try AssistantEmail },
    ownNotices: { current: try OwnNotices },
    mapsChat: { current: try MapsChatCards },
  }
})

const fileShare = Layer.effect(FileShareTargets, effect {
  const cells = try PortCells
  const cell = cells.fileShare
  return slot(cells, {
    emailAccount: (...args: Parameters<FileShareTargets.Shape["emailAccount"]>) => suspend(() => cell.current.emailAccount(...args)),
    email: (...args: Parameters<FileShareTargets.Shape["email"]>) => suspend(() => cell.current.email(...args)),
    get messages() { return cell.current.messages },
    message: (...args: Parameters<FileShareTargets.Shape["message"]>) => suspend(() => cell.current.message(...args)),
    get ask() { return cell.current.ask },
    attachToChat: (...args: Parameters<FileShareTargets.Shape["attachToChat"]>) => suspend(() => cell.current.attachToChat(...args)),
  } satisfies FileShareTargets.Shape)
})

const pageMail = Layer.effect(PageMail, effect {
  const cells = try PortCells
  const cell = cells.pageMail
  return slot(cells, {
    compose: (...args: Parameters<PageMail.Shape["compose"]>) => suspend(() => cell.current.compose(...args)),
  } satisfies PageMail.Shape)
})

const calendarMaps = Layer.effect(CalendarMaps, effect {
  const cells = try PortCells
  const cell = cells.calendarMaps
  return slot(cells, {
    enterFromEvent: (...args: Parameters<CalendarMaps.Shape["enterFromEvent"]>) => suspend(() => cell.current.enterFromEvent(...args)),
  } satisfies CalendarMaps.Shape)
})

const workflowClock = Layer.effect(WorkflowClockPort, effect {
  const cells = try PortCells
  const cell = cells.workflowClock
  return slot(cells, {
    prepare: () => suspend(() => cell.current.prepare()),
    confirm: () => suspend(() => cell.current.confirm()),
    retire: () => suspend(() => cell.current.retire()),
  } satisfies WorkflowClockPort.Shape)
})

const assistantEmail = Layer.effect(AssistantEmail, effect {
  const cells = try PortCells
  const cell = cells.assistantEmail
  return slot(cells, {
    send: (...args: Parameters<AssistantEmail.Shape["send"]>) => suspend(() => cell.current.send(...args)),
    address: () => suspend(() => cell.current.address()),
  } satisfies AssistantEmail.Shape)
})

const ownNotices = Layer.effect(OwnNotices, effect {
  const cells = try PortCells
  const cell = cells.ownNotices
  return slot(cells, {
    current: (...args: Parameters<OwnNotices.Shape["current"]>) => suspend(() => cell.current.current(...args)),
    consume: (...args: Parameters<OwnNotices.Shape["consume"]>) => suspend(() => cell.current.consume(...args)),
  } satisfies OwnNotices.Shape)
})

const mapsChat = Layer.effect(MapsChatCards, effect {
  const cells = try PortCells
  const cell = cells.mapsChat
  return slot(cells, {
    agentReply: (...args: Parameters<MapsChatCards.Shape["agentReply"]>) => suspend(() => cell.current.agentReply(...args)),
    ownerMessage: () => suspend(() => cell.current.ownerMessage()),
  } satisfies MapsChatCards.Shape)
})

/** Every late-filled port as a slot over its cell, placed before the first area that reads one; each answers as its refusing default until filled. */
export const slotsLive = Layer.provideMerge(
  Layer.mergeAll(fileShare, pageMail, calendarMaps, workflowClock, assistantEmail, ownNotices, mapsChat),
  cellsLive,
)
