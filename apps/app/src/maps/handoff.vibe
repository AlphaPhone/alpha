// spec/maps/cards.md, "A card's Map button runs one flow, chosen from what the card carries"; spec/maps/screen.md, "Call is offered only for a dialable number on the build that has Phone, and Copy number only for a place that is not Google's"; spec/maps/cards.md, "Only the newest agent message offers its choice and its card, in the session and conversation that showed them"; spec/maps/cards.md, "A tap sends one answer while the composer is quiet; a draft or an edit says why it waits; a failed send asks again"; spec/maps/eventReturn.md, "One check per tap, and only its reply for the current origin returns, once"; spec/maps/notificationOpen.md, "A read starts only when Maps can be shown and none is in flight, and opens Maps at most once per tap"
import type { MapsCard, MapsCardPlace } from "@elizaos/plugin-maps/cards"
import type { Place } from "@elizaos/plugin-maps/client/contracts"
import { type CardFacts, type Composer, Machine as CardsMachine, flowOf, searchZoom } from "../../gen/maps__cards.effect.vibe"
import { Machine as ReturnMachine, offered, type ReturnReply } from "../../gen/maps__eventReturn.effect.vibe"
import { Machine as OpenMachine } from "../../gen/maps__notificationOpen.effect.vibe"
import { restricted } from "../../gen/maps__vocabulary.effect.vibe"
import { AgentCalendar } from "../calendar/agent.vibe"
import { callOffered } from "../../gen/maps__screen.ts"
import { Build } from "../platform/build.vibe"
import { Native } from "../platform/native.vibe"
import { modelTravel, MapsProvider } from "./cloud.vibe"
import { MapsContent, type Shown } from "./content.vibe"
import { failure, type MapsFailure } from "./failure.vibe"
import { closest, coordinateLabel } from "./geometry.vibe"
import { MapsLocation } from "./location.vibe"
import { CalendarRead, type EventOrigin, NavigationOpen, type Route } from "./maps.schema.vibe"
import { MapsShell, type ShellState } from "./ports.vibe"
import { MapsScreen } from "./screen.vibe"
import { Machine as ScreenMachine } from "../../gen/maps__screen.effect.vibe"

const CLOUD_PROVIDER = "eliza-cloud"

/** Where a chat card's Map button was pressed: its message and the session, conversation and revision that showed it. */
export interface CardOffer {
  readonly message: number
  readonly session: number
  readonly conversation: number
  readonly revision: number
}

/** Maps opened from elsewhere: chat cards and their share choices, a Calendar event, the navigation notification, and Maps' own links out. */
export service MapsHandoff {
  openCard(card: MapsCard, offer: CardOffer): void!!
  answerChoice(offer: CardOffer, send: boolean!!): void!!
  setComposer(composer: Composer): void!!
  agentReply(question: boolean): void!!
  ownerMessage(): void!!
  enterFromEvent(origin: EventOrigin, where: string): void!!
  returnToEvent(): void!!
  readonly returnOffered: Stream.Stream<boolean>
  notificationTapped(): void!!
  goneHome(): void!!
  sharePlace(shown: Shown): void!MapsFailure
  shareRoute(label: string, route: Route): void!MapsFailure
  copyNumber(phone: string): void!MapsFailure
  call(phone: string): void!!
  openWebsite(url: string): void!MapsFailure
  openSettings(): void!MapsFailure
}

/** A card's place as a Maps place: the provider's identity when the card carries one, coordinates otherwise. */
export function cardPlace(p: MapsCardPlace, providerId: string | undefined): { place: Place; lookup: boolean } {
  const lookup = p.provider === CLOUD_PROVIDER || p.provider === providerId
  return {
    place: { providerId: providerId ?? "coordinates", id: lookup ? p.providerPlaceId : "coordinates", name: p.name,
      coordinate: { latitude: p.latitude, longitude: p.longitude }, ...(p.formattedAddress ? { address: p.formattedAddress } : {}),
      attribution: "", fetchedAt: 1 },
    lookup,
  }
}

function factsOf(card: MapsCard): CardFacts {
  switch (card.kind) {
    case "place": return { kind: "PlaceCard", hasPlace: true, hasQuery: false, hasRoute: false, nearMe: false, fromHere: false, nearPoint: false }
    case "places": return { kind: "PlacesCard", hasPlace: false, hasQuery: card.query !== "", hasRoute: false, nearMe: card.near === undefined, fromHere: false, nearPoint: card.near !== undefined }
    case "route": return { kind: "RouteCard", hasPlace: true, hasQuery: false, hasRoute: true, nearMe: false, fromHere: false, nearPoint: false }
    case "handoff": return { kind: "HandoffCard", hasPlace: true, hasQuery: false, hasRoute: false, nearMe: false, fromHere: false, nearPoint: false }
    case "locate": return {
      kind: "LocateCard", hasPlace: card.destination !== undefined, hasQuery: (card.query ?? "") !== "", hasRoute: false,
      nearMe: card.intent === "place-near" || card.destination === undefined, fromHere: card.intent === "route-origin", nearPoint: false,
    }
  }
}

/** Whether the launcher can show Maps for a notification read. */
function canShowMaps(s: ShellState): boolean {
  return s.native && s.live && !s.hidden && !s.suspended && !s.assistantWindow && !s.connectionOpen && s.home && !s.secure && !s.shaded
}

/** Hand-offs over their machines, the screen and the native plugins. */
export const handoffLayer = Layer.effect(MapsHandoff, effect {
  const native = try Native
  const shell = try MapsShell
  const cards = try CardsMachine
  const returns = try ReturnMachine
  const opens = try OpenMachine
  const screen = try ScreenMachine
  const actions = try MapsScreen
  const content = try MapsContent
  const provider = try MapsProvider
  const location = try MapsLocation
  const calendar = try AgentCalendar
  const aosp = (try Build).info.variant === "aosp"

  /** A device event is still there with the same id and start; a canonical one is checked by Calendar for the same owner and revision. */
  effect function checkEvent(origin: EventOrigin) {
    if (origin.version === 2) {
      const view = try calendar.view()
      if (origin.binding !== `${view.state.portOwner}:${view.state.portSession}`) return "OwnerChanged" as const
      const verdict = try calendar.verifyReturn(origin.eventKey, origin.revision, origin.begin)
      return verdict === "ReturnFound" ? "EventFound" as const : verdict === "ReturnMissing" ? "EventMissing" as const
        : verdict === "ReturnOwnerChanged" ? "OwnerChanged" as const : "ReadUnknown" as const
    }
    const raw = native.invoke("AlphaCalendar", "list", { begin: origin.begin - 1, end: origin.begin + 1 }) catch () => undefined
    const read = raw === undefined ? undefined : (Schema.decodeUnknownEffect(CalendarRead)(raw) catch () => undefined)
    const matches = (read?.events ?? []).filter((e) => String(e.id) === origin.id && e.begin === origin.begin).length
    return read === undefined ? "ReadUnknown" as const : read.status === "permission-required" ? "PermissionNeeded" as const
      : read.status !== "ready" ? "ReadUnknown" as const : matches === 1 ? "EventFound" as const : matches === 0 ? "EventMissing" as const : "EventAmbiguous" as const
  }

  effect function flushOpen() {
    const s = opens.send({ type: "flush" }) catch () => undefined
    if (!s?.checking) return
    const before = s.opened
    const raw = native.invoke("AlphaMapsTransport", "consumeNavigationOpen") catch () => undefined
    const read = raw === undefined ? undefined : (Schema.decodeUnknownEffect(NavigationOpen)(raw) catch () => undefined)
    const after = opens.send({ type: "readSettles", ok: read !== undefined, found: read?.open === true }) catch () => undefined
    if (after && after.opened > before) try shell.open("maps")
    if (after?.checking) try flushOpen()
  }

  fork.detached Stream.runForEach(shell.states, (state) => effect {
    const ready = canShowMaps(state)
    if ((try opens.get()).ready !== ready) opens.send({ type: "setReady", on: ready }) catch () => undefined
    if (ready) try flushOpen()
    const inMaps = state.view === "maps"
    const r = try returns.get()
    if (r.inMaps && !inMaps) returns.send({ type: "leaveMaps" }) catch () => undefined
    if (r.inMaps && r.visible === state.hidden) returns.send(state.hidden ? { type: "hideReturn" } : { type: "showReturn" }) catch () => undefined
    const fromCalendar = state.stack.at(-1) === "calendar"
    if (r.inMaps && r.fromCalendar !== fromCalendar) returns.send({ type: "setFromCalendar", on: fromCalendar }) catch () => undefined
  })

  effect function current(start: number) {
    return (try screen.get()).intent === start
  }

  effect function runFlow(card: MapsCard) {
    const start = (try screen.get()).intent
    const coverage = (try content.get()).coverage
    const flow = flowOf(factsOf(card))
    switch (flow) {
      case "ShowPlace": {
        if (card.kind !== "place" && card.kind !== "handoff") return
        const { place, lookup } = cardPlace(card.place, coverage?.providerId)
        return try actions.showAgentPlace(place, lookup)
      }
      case "SearchThere": {
        if (card.kind !== "places" || !card.near) return
        return try actions.handoff(card.query, false, { latitude: card.near.latitude, longitude: card.near.longitude })
      }
      case "SearchNearPhone": {
        const query = card.kind === "places" ? card.query : card.kind === "locate" ? card.query ?? "" : ""
        const fix = location.once("OwnerFix") catch effect (error) => {
          try content.update((c) => ({ ...c, message: error.message }))
          return undefined
        }
        if (!(try current(start))) return
        if (fix) try content.update((c) => ({ ...c, position: fix, viewport: { center: fix.coordinate, zoom: searchZoom } }))
        return try actions.handoff(query, false, fix?.coordinate)
      }
      case "DirectionsFromPhone": {
        if (card.kind !== "locate" || !card.destination) return
        const { place, lookup } = cardPlace(card.destination, coverage?.providerId)
        try actions.showAgentPlace(place, lookup, modelTravel(card.travelMode ?? "drive"))
        return try actions.locate("Flow")
      }
      case "ClosestFromPhone": {
        if (card.kind !== "locate") return
        const fix = location.once("OwnerFix") catch () => undefined
        if (!fix || !(try current(start))) return
        const found = provider.search(card.query ?? "", fix.coordinate) catch () => []
        const best = closest(found, fix.coordinate)
        if (!best || !(try current(start))) return
        try actions.showAgentPlace(best, true, modelTravel(card.travelMode ?? "drive"))
        return try actions.planFrom(fix.coordinate)
      }
      case "DrawRoute": {
        if (card.kind !== "route") return
        const { place, lookup } = cardPlace(card.destination, coverage?.providerId)
        try actions.showAgentPlace(place, lookup, modelTravel(card.travelMode))
        if (!coverage || !(try current(start))) return
        return try actions.planFrom({ latitude: card.origin.latitude, longitude: card.origin.longitude })
      }
      case "NoFlow": return
    }
  }

  effect function share(title: string, text: string) {
    native.invoke("AlphaDevice", "shareText", { title, text }) catch effect () => { throw failure("unavailable", "Android sharing is unavailable.") }
  }

  return {
    effect openCard(card: MapsCard, offer: CardOffer) {
      const opened = cards.send({ type: "openCard", ...offer }) catch () => undefined
      if (!opened) return
      try shell.open("maps")
      fork.detached runFlow(card)
    },
    effect answerChoice(offer: CardOffer, send: boolean!!) {
      const tapped = cards.send({ type: "tapChoice", ...offer }) catch () => undefined
      if (!tapped || !tapped.inflight.includes(offer.message)) return
      const ok = try send
      cards.send({ type: "sendSettles", message: offer.message, ok }) catch () => undefined
    },
    effect setComposer(composer: Composer) { cards.send({ type: "setComposer", composer }) catch () => undefined },
    effect agentReply(question: boolean) { cards.send({ type: "agentReply", question }) catch () => undefined },
    effect ownerMessage() { cards.send({ type: "ownerMessage" }) catch () => undefined },
    effect enterFromEvent(origin: EventOrigin, where: string) {
      returns.send({ type: "enterFromEvent" }) catch () => undefined
      try content.update((c) => ({ ...c, eventOrigin: origin }))
      try actions.handoff(where, true)
    },
    effect returnToEvent() {
      const r = try returns.get()
      const tapped = returns.send({ type: "tapReturn", origin: r.origin }) catch () => undefined
      if (!tapped) return
      const attempt = tapped.active
      const origin = (try content.get()).eventOrigin
      const reply: ReturnReply = origin ? try checkEvent(origin) : "ReadUnknown"
      const after = returns.send({ type: "returnReply", attempt, reply }) catch () => undefined
      if (!after || !origin) return
      if (after.returned > tapped.returned) {
        for (let i = 0; i < 8; i++) if (!(try actions.back())) break
        try content.update((c) => ({ ...c, eventOrigin: undefined }))
        return try shell.open("calendar", `event/${encodeURIComponent(origin.rowId)}?day=${origin.day}`)
      }
      const notice = after.notice === "EventMoved" ? "Event moved" : after.notice === "EventChanged" ? "Event changed" : after.notice === "AllowCalendar" ? "Allow Calendar" : after.notice === "CouldNotCheck" ? "Couldn't check" : ""
      if (notice) try content.update((c) => ({ ...c, message: notice, ...(after.notice === "EventMoved" || after.notice === "EventChanged" ? { eventOrigin: undefined } : {}) }))
    },
    returnOffered: Stream.map(returns.changes, offered),
    effect notificationTapped() {
      opens.send({ type: "tapNotification" }) catch () => undefined
      try flushOpen()
    },
    effect goneHome() {
      opens.send({ type: "cancelOpen" }) catch () => undefined
      native.invoke("AlphaMapsTransport", "clearNavigationOpen") catch () => undefined
    },
    effect sharePlace(shown: Shown) {
      if (restricted(shown.kind)) throw failure("unsupported", "Google Maps results cannot be shared from this phone.")
      const p = shown.coordinate
      const url = `https://www.openstreetmap.org/?mlat=${p.latitude}&mlon=${p.longitude}#map=17/${p.latitude}/${p.longitude}`
      try share(shown.label, `${shown.label}\n${coordinateLabel(p)}\n${url}`)
    },
    effect shareRoute(label: string, route: Route) {
      if ((try content.get()).coverage?.kind === "GoogleProvider") throw failure("unsupported", "Google Maps routes cannot be shared from this phone.")
      try share(`Route to ${label}`, [
        `Route to ${label}`, `${route.mode}: ${coordinateLabel(route.from)} → ${coordinateLabel(route.to)}`,
        `${Math.round(route.distanceMeters)} m · ${Math.round(route.durationSeconds)} s`,
        ...route.steps.map((step, index) => `${index + 1}. ${step.instruction}`), `Traffic: ${route.traffic}`, route.attribution,
      ].join("\n"))
    },
    effect copyNumber(phone: string) {
      const shown = (try content.get()).shown
      if (shown && restricted(shown.kind)) throw failure("unsupported", "Google Maps results cannot be copied from this phone.")
      native.invoke("AlphaDevice", "copyText", { text: phone }) catch effect () => { throw failure("unavailable", "Couldn’t copy") }
      try content.update((c) => ({ ...c, message: "Number copied" }))
    },
    effect call(phone: string) {
      const dial = phone.replace(/[() .-]/g, "")
      if (callOffered(/^\+?[0-9]+$/.test(dial), aosp)) try shell.open("phone", `dial?number=${encodeURIComponent(dial)}`)
    },
    effect openWebsite(url: string) {
      const valid = /^https?:\/\/[^\s/@]+(\/\S*)?$/i.test(url)
      if (!valid) throw failure("invalid-response", "This website address is not valid.")
      native.invoke("DailyApps", "perform", { action: "browser", url }) catch effect () => { throw failure("unavailable", "No installed app can complete this action.") }
    },
    effect openSettings() {
      native.invoke("AlphaDevice", "openSettings", { page: "privacy" }) catch effect () => { throw failure("unavailable", "Couldn’t open settings") }
    },
  }
})
