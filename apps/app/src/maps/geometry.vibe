// spec/maps/guidance.md, "A fix guides only when usable, and only for the current session"; spec/maps/vocabulary.md, "A spoken instruction is keyed by its route, step and distance band"
import type { Reading } from "../../gen/maps__guidance.ts"
import { bandOf } from "../../gen/maps__vocabulary.effect.vibe"
import type { Position } from "@elizaos/plugin-maps-client"
import { distanceToRoute, routeProgress } from "@elizaos/plugin-maps-client"
import type { Coordinate, Route } from "./maps.schema.vibe"

export type { Position }
export { distanceToRoute }

const EARTH = 6371000
const radians = (degrees: number) => degrees * Math.PI / 180

/** The great-circle distance between two points, in meters. */
export function greatCircle(a: Coordinate, b: Coordinate): number {
  const dLat = radians(b.latitude - a.latitude)
  const dLng = radians(b.longitude - a.longitude)
  const h = Math.sin(dLat / 2) ** 2 + Math.cos(radians(a.latitude)) * Math.cos(radians(b.latitude)) * Math.sin(dLng / 2) ** 2
  return 2 * EARTH * Math.asin(Math.min(1, Math.sqrt(h)))
}

/** Each step's position along the route line; a step never lies before the one before it. */
export function maneuverAlong(route: Route): number[] {
  return [...routeProgress(route.from, route).maneuverAlongMeters]
}

/** What a fix means for the route at `step`, as whole meters and milliseconds for the guidance model. */
export function readingOf(fix: Position, route: Route, step: number, marks: ReadonlyArray<number>, now: number): Reading {
  const progress = routeProgress(fix.coordinate, route)
  const target = route.steps[step]?.coordinate ?? route.to
  const mark = marks[step] ?? 0
  return {
    accuracy: Math.max(0, Math.round(fix.accuracyMeters)),
    ageMs: Math.round(now - fix.timestamp),
    precise: fix.precision === "precise",
    toStep: Math.round(greatCircle(fix.coordinate, target)),
    beyond: progress.alongMeters > mark ? Math.round(progress.alongMeters - mark) : 0,
    toRoute: Math.round(progress.offRouteMeters),
    toEnd: Math.round(greatCircle(fix.coordinate, route.to)),
  }
}

/** Remaining distance and time from `fix`, and the distance to the maneuver at `step`. */
export function remaining(fix: Coordinate, route: Route): { meters: number; seconds: number; toStep: (marks: ReadonlyArray<number>, step: number) => number } {
  const progress = routeProgress(fix, route)
  return {
    meters: progress.remainingMeters,
    seconds: progress.remainingSeconds,
    toStep: (marks, step) => Math.max(0, (marks[step] ?? progress.alongMeters + progress.remainingMeters) - progress.alongMeters),
  }
}

/** The voice key of an instruction: route, step and distance band. */
export function instructionKey(routeId: string, step: number, distance: number): string {
  return `${routeId}:${step}:${bandOf(Math.round(distance))}`
}

/** A guidance distance: feet then miles for en-US, meters then kilometers otherwise; "" when unknown. */
export function guidanceDistance(meters: number, locale: string): string {
  if (!Number.isFinite(meters) || meters < 0) return ""
  if (locale === "en-US") {
    const feet = meters * 3.28084
    return feet < 1000 ? `${Math.round(feet / 10) * 10} ft` : `${(meters / 1609.344).toFixed(1)} mi`
  }
  if (meters < 100) return `${Math.round(meters / 5) * 5} m`
  if (meters < 1000) return `${Math.round(meters / 10) * 10} m`
  return `${(meters / 1000).toFixed(1)} km`
}

/** A duration of at least one minute: "N min", or "H h M min" from an hour. */
export function guidanceDuration(seconds: number): string {
  const minutes = Math.max(1, Math.round(seconds / 60))
  if (minutes < 60) return `${minutes} min`
  const hours = Math.floor(minutes / 60)
  const rest = minutes % 60
  return rest ? `${hours} h ${rest} min` : `${hours} h`
}

/** The text spoken for a step: the instruction alone within 50 meters, otherwise preceded by the distance. */
export function spokenInstruction(instruction: string, distance: number, locale: string): string {
  return distance <= 50 ? instruction : `In ${guidanceDistance(distance, locale)}, ${instruction}`
}

/** A coordinate as "lat, lng" to five decimals. */
export function coordinateLabel(point: Coordinate): string {
  return `${point.latitude.toFixed(5)}, ${point.longitude.toFixed(5)}`
}

const COORDINATES = /^([+-]?\d+(?:\.\d+)?)\s*,\s*([+-]?\d+(?:\.\d+)?)$/

/** Text of the form "latitude, longitude" as a valid coordinate, or undefined. */
export function parseCoordinates(text: string): Coordinate | undefined {
  const match = COORDINATES.exec(text.trim())
  if (!match) return undefined
  const latitude = Number(match[1])
  const longitude = Number(match[2])
  return Math.abs(latitude) <= 90 && Math.abs(longitude) <= 180 ? { latitude, longitude } : undefined
}

/** Millionths of a degree, as the saved-places model keeps coordinates. */
export function micro(point: Coordinate): { lat: number; lng: number } {
  return { lat: Math.round(point.latitude * 1e6), lng: Math.round(point.longitude * 1e6) }
}

/** The bounding box of a view, independent of bearing, on a 512-pixel world at zoom 0. */
export function viewportArea(center: Coordinate, zoom: number, width: number, height: number): { north: number; south: number; east: number; west: number } {
  const scale = 512 * 2 ** zoom
  const x = (center.longitude + 180) / 360 * scale
  const sin = Math.sin(radians(Math.max(-85.0511, Math.min(85.0511, center.latitude))))
  const y = (0.5 - Math.log((1 + sin) / (1 - sin)) / (4 * Math.PI)) * scale
  const half = Math.hypot(width, height) / 2
  const lng = (px: number) => px / scale * 360 - 180
  const lat = (py: number) => Math.atan(Math.sinh(Math.PI * (1 - 2 * py / scale))) * 180 / Math.PI
  return {
    north: Math.min(85.0511, lat(y - half)), south: Math.max(-85.0511, lat(y + half)),
    east: Math.min(180, lng(x + half)), west: Math.max(-180, lng(x - half)),
  }
}

/** The closest of `places` to `point` by great-circle distance. */
export function closest<P extends { readonly coordinate: Coordinate }>(places: ReadonlyArray<P>, point: Coordinate): P | undefined {
  return places.reduce<P | undefined>((best, place) => best && greatCircle(best.coordinate, point) <= greatCircle(place.coordinate, point) ? best : place, undefined)
}
