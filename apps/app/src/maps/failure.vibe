// spec/maps/connection.md, "Story: Back off when Maps asks me to wait"; spec/maps/connection.md, "A request may start only on the installed provider, for its account and generation, outside a pause"
import { MapsFailure, type MapsFailureCode } from "@elizaos/plugin-maps/client/contracts"
import type { CloudSignedOut, CloudUnavailable } from "../platform/cloud.vibe"

export { MapsFailure }

/** A failure with the given code and owner-facing message. */
export function failure(code: MapsFailureCode, message: string): MapsFailure {
  return new MapsFailure({ code, message })
}

/** How long to pause after Cloud refuses with 429; the platform's Cloud error names no wait, so one minute. */
export const DEFAULT_PAUSE_MS = 60000

/** The pause a refusal asks for, or undefined when it asks for none. */
export function pauseOf(error: CloudUnavailable | CloudSignedOut): number | undefined {
  return error._tag === "CloudUnavailable" && error.status === 429 ? DEFAULT_PAUSE_MS : undefined
}

/** A Cloud refusal as the owner reads it: sign-in, plan and outages kept apart, never the provider's own text, no automatic retry. */
export function cloudFailure(error: CloudUnavailable | CloudSignedOut): MapsFailure {
  if (error._tag === "CloudSignedOut") return failure("unauthorized", "Sign in to Cloud to use Maps.")
  const code = error.code ?? ""
  if (code === "maps_request_cancelled") return failure("cancelled", "Maps request cancelled.")
  if (code === "maps_allowance_unconfigured") return failure("unconfigured", "Cloud Maps is not available yet.")
  if (code === "maps_funding_changed") return failure("unavailable", "Your plan changed. Try the Maps request again.")
  if (code === "maps_admission_unknown" || code === "already_admitted" || code === "identity_conflict")
    return failure("unavailable", "This Maps request could not be confirmed. It will not retry automatically.")
  switch (error.status) {
    case 0: return failure("offline", "Cloud Maps is unreachable. Check the connection.")
    case 401: return failure("unauthorized", "Sign in to Cloud to use Maps.")
    case 402: return failure("unauthorized", "Add balance or choose a plan to use Maps.")
    case 403: return failure("unauthorized", code === "subscription_required" ? "Maps needs an active Cloud subscription." : "Cloud refused this Maps request.")
    case 404: return failure("unconfigured", "Cloud Maps is not available yet.")
    case 409: return failure("unavailable", "This Maps request could not be confirmed. It will not retry automatically.")
    case 422: return failure("unsupported", code === "no_route" ? "No route is available between these places."
      : code === "unsupported_mode" ? "This travel mode is not available from Cloud Maps." : "This location is outside Cloud Maps coverage.")
    case 429: return code === "allowance_exhausted" || code === "maps_allowance_exhausted"
      ? failure("rate-limited", "You have used your Maps allowance for this period.")
      : failure("rate-limited", "Maps request limit reached. Try again later.")
    case 502: return failure("invalid-response", "Cloud Maps could not complete this request.")
    case 503: return code === "maps_not_configured" ? failure("unconfigured", "Cloud Maps is not available yet.")
      : failure("unavailable", "Cloud Maps is temporarily unavailable. Try again later.")
    default: return failure("unavailable", "Cloud Maps could not complete this request.")
  }
}

/** `value` decoded by `schema`, or the invalid-response failure. */
export effect function decoded<A>(schema: Schema.Codec<A>, value: unknown) {
  return Schema.decodeUnknownEffect(schema)(value) catch effect () => { throw failure("invalid-response", "Cloud Maps sent an invalid response.") }
}
