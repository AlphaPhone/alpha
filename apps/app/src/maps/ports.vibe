// spec/maps/connection.md, "Changing account retires the provider; rebuilding the client for the same account keeps it"; spec/maps/vocabulary.md, "A Google place is never saved, shared, renamed or copied, and Google guidance is never spoken"; spec/maps/agentSurface.md, "Maps opens at most once per request, only over an unblocked launcher, and the answer waits for the open to commit or two seconds"
import type { GuidanceSpeechStopped } from "@elizaos/plugin-maps/client/guidance"

/** The Cloud account Maps requests are made for; undefined when signed out. */
export interface AccountBinding {
  readonly sessionId: string
  readonly credentialId: string
}

/** The signed-in Cloud account as it changes, starting with the current one. */
export service MapsAccount {
  readonly changes: Stream.Stream<AccountBinding | undefined>
  /** Whether the resident agent is running, so coverage can be read for agent navigation from launch. */
  readonly residentReady: Stream.Stream<boolean>
}

/** The phone's speaker route, Cloud speech when signed in and on-device speech otherwise; interrupting the effect stops the speech. */
export service GuidanceSpeaker {
  speak(text: string): void!GuidanceSpeechStopped
}

/** What the launcher shows, for deciding whether Maps may come forward. */
export interface ShellState {
  readonly live: boolean
  readonly hidden: boolean
  readonly suspended: boolean
  readonly assistantWindow: boolean
  readonly connectionOpen: boolean
  readonly home: boolean
  readonly secure: boolean
  readonly shaded: boolean
  readonly ringing: boolean
  readonly native: boolean
  /** The app in front, "maps" when Maps is shown, "home" for Home. */
  readonly view: string
  /** The views beneath the one in front, oldest first. */
  readonly stack: ReadonlyArray<string>
}

/** The launcher, as Maps sees it. */
export service MapsShell {
  readonly states: Stream.Stream<ShellState>
  current(): ShellState!!
  /** Bring an app forward, keeping its state, at `route` inside it. */
  open(app: string, route?: string): void!!
  /** Count a move to Maps the agent's own turn asked for as that turn's own, so the reply is not cancelled by it. */
  admitOwnViewOpen(app: string): void!!
  /** Leave the view in front, as Back does. */
  back(): void!!
}

/** The owner's Location for Alpha switch under Settings → Privacy, which Settings fills; Maps reads no chat location of its own. */
export service MapsPreferences {
  readonly locationForAlpha: Stream.Stream<boolean>
}
