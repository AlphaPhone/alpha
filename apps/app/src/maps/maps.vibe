// spec/app/maps/index.md, "Story: Search for a place"; spec/app/maps/index.md, "Story: Get directions"; spec/app/maps/index.md, "Story: Navigate"; spec/app/maps/index.md, "Story: Connect through my cloud account"
import { CloudError } from "@elizaos/cloud/client"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Screen from "../../gen/app__maps.effect.vibe"
import { readable, shown } from "../../gen/app__maps.effect.vibe"
import type { Effect as Out, Event as Ev, HandOff, Maps as State } from "../../gen/app__maps.effect.vibe"
import * as Credits from "../../gen/app__maps__credits.effect.vibe"
import type { Effect as CreditsOut, Event as CreditsEv } from "../../gen/app__maps__credits.effect.vibe"
import { findTimeoutMs, heldSeconds } from "../../gen/app__maps__connection.effect.vibe"
import type { Basemap } from "../../gen/app__maps__connection.effect.vibe"
import { judged } from "../../gen/app__maps__navigation.effect.vibe"
import type { Offer, Origin, Travel } from "../../gen/app__maps__navigation.effect.vibe"
import type { Saved } from "../../gen/app__maps__places.effect.vibe"
import type { Grant as Allowed } from "../../gen/kit__permission.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { type CloudClient, Cloud } from "../platform/cloud.vibe"
import { type Grant, Location } from "../platform/location.vibe"
import { type Job, answer, applying, following, reacting, run, started, stream, together, untimed } from "../runtime/reactor.vibe"
import { Time } from "../runtime/time.vibe"
import { type Spot, type Way, atlas } from "./atlas.vibe"
import { type Point, coordinateOf, measured, pointOf, tileAt } from "./geometry.ts"

type CloudPlace = Awaited<ReturnType<CloudClient["mapsPlacesSearch"]>>["places"][number]
type Capabilities = Awaited<ReturnType<CloudClient["mapsCapabilities"]>>

module web {
  /** `bytes` as an image the page can draw without asking the network again. @throws {never} */
  export function imageOf(contentType: string, bytes: Uint8Array): string {
    let text = ""
    for (const byte of bytes) text += String.fromCharCode(byte)
    return `data:${contentType};base64,${btoa(text)}`
  }
  /** Hand `url` to the phone, which opens it in the app that owns it. @throws {never} */
  export function opened(url: string): void {
    globalThis.open?.(url, "_blank", "noopener")
  }
  /** The phone's share sheet with `text`, where it has one. */
  export async function shared(title: string, text: string): Promise<void> {
    await globalThis.navigator?.share?.({ title, text })
  }
}
import { imageOf, opened, shared } from web

/** A Maps request the phone did not get an answer to: held back by a wait Cloud named, refused or failed. */
error Unanswered { cause: unknown }

const google = "eliza-cloud-google"
const travelModes = { Drive: "drive", Walk: "walk", Bicycle: "bicycle", Transit: "transit" } as const satisfies Record<Travel, string>
const noOffer: Offer = { drive: false, transit: false, walk: false, bicycle: false }

let heldUntil = 0

// spec/app/maps/connection.md, "A wait Cloud names holds every Maps request back until it ends: a rate limit for at most a day, a spent allowance for at most 400 days, and any other wait one minute"
effect function held(failure: unknown): void!!Time {
  if (!(failure instanceof CloudError)) return
  const why = failure.failure
  const now = try (try Time).now()
  const until = why.tag === "CloudRateLimited" ? why.retryAt : why.tag === "CloudAllowanceExhausted" ? why.resetsAt : undefined
  if (until === undefined && why.tag !== "CloudRateLimited") return
  const wait = why.tag === "CloudRateLimited" ? "RateLimited" : "AllowanceSpent"
  heldUntil = now + heldSeconds(wait, until === undefined ? 0 : Math.ceil((until - now) / 1000)) * 1000
}

/** A call of eliza's cloud client for Maps, refused while a wait Cloud named still holds. */
effect function asked<A>(call: (client: CloudClient, signal: AbortSignal) => Promise<A>): A!Unanswered!(Cloud | Time) {
  const now = try (try Time).now()
  if (now < heldUntil) throw new Unanswered({ cause: "Cloud asked Alpha to wait" })
  const { client } = try Cloud
  const sent: A!Unanswered = tryPromise({ try: (signal) => call(client, signal), catch: (cause) => new Unanswered({ cause }) })
  return try Effect.tapError(sent, (failure) => held(failure.cause))
}

function offerOf(capabilities: Capabilities): Offer {
  if (!capabilities.available) return noOffer
  const modes: ReadonlyArray<string> = capabilities.capabilities.modes
  return { drive: modes.includes("drive"), transit: modes.includes("transit"), walk: modes.includes("walk"), bicycle: modes.includes("bicycle") }
}

function isGoogle(capabilities: Capabilities): boolean {
  return capabilities.available && (capabilities.providerId === google || capabilities.sources.data === "Google Maps")
}

let coverage: Capabilities = { available: false }

// spec/app/maps/connection.md, "Only the newest read's answer is taken, while signed in, and a healthy answer installs the provider for that account"
effect function covered(ticket: number): Ev!!Cloud {
  const { client } = try Cloud
  return effect {
    const found = try tryPromise({ try: (signal) => client.mapsCapabilities({ signal }), catch: (cause) => new Unanswered({ cause }) })
    coverage = found
    if (!found.available) return { type: "answerCoverage", ticket, ok: false, covered: false, google: false, offer: noOffer }
    return { type: "answerCoverage", ticket, ok: true, covered: found.capabilities.map, google: isGoogle(found), offer: offerOf(found) }
  } catch () => ({ type: "answerCoverage", ticket, ok: false, covered: false, google: false, offer: noOffer })
}

/** A provider's place as the atlas keeps it, with its most specific category where the provider names one. */
function spotOf(raw: CloudPlace): Spot {
  const categories: unknown = (raw as { readonly categories?: unknown }).categories
  const category = Array.isArray(categories) && typeof categories[0] === "string" ? categories[0] : ""
  return {
    name: raw.name, category, at: pointOf(raw.coordinate), providerId: raw.providerId, id: raw.id, google: raw.providerId === google,
    address: raw.address, phone: raw.phone, website: raw.website, hours: raw.openingHours,
  }
}

/** Where the screen ranks a search around: the phone's last position, when it has one. */
function near(): { near?: { latitude: number; longitude: number } } {
  const here = atlas.snapshot().here
  return here === undefined ? {} : { near: coordinateOf(here.at) }
}

// spec/app/maps/index.md, "Only the newest search's answer is shown: results, none, or a failure"
effect function searched(ticket: number, query: string): Ev!!(Cloud | Time) {
  return effect {
    const found = try asked((client, signal) => client.mapsPlacesSearch({ query, limit: 10, ...near() }, { signal }))
    const places = found.places.map((raw) => atlas.numberOf(spotOf(raw)))
    atlas.found(places)
    return { type: "answerSearch", ticket, ok: true, found: places.length }
  } catch () => ({ type: "answerSearch", ticket, ok: false, found: 0 })
}

// spec/app/maps/index.md, "The agent's search shows its cards in the conversation and leaves the screen alone"
effect function foundForAgent(query: string): void!!(Cloud | Time) {
  try ignore(asked((client, signal) => client.mapsPlacesSearch({ query, limit: 5, ...near() }, { signal }))
    |> Effect.map(%, (found) => found.places.map((raw) => atlas.numberOf(spotOf(raw)))))
}

function startOf(origin: Origin): Point | undefined {
  const seen = atlas.snapshot()
  return origin === "MyLocation" ? seen.here?.at : origin === "Unset" ? undefined : seen.start
}

// spec/app/maps/index.md, "Routes are asked for the place on screen, under the trip's newest ticket"
effect function planned(ticket: number, origin: Origin, travel: Travel, place: number): Ev!!(Cloud | Time) {
  const from = startOf(origin)
  const to = atlas.spot(place)
  return effect {
    if (from === undefined || to === undefined) throw new Unanswered({ cause: "the route has no start or no end" })
    const found = try asked((client, signal) => client.mapsRoutes({ from: coordinateOf(from), to: coordinateOf(to.at), mode: travelModes[travel] }, { signal }))
    const first = found.routes[0]
    const way: Way = {
      meters: Math.round(first.distanceMeters), seconds: Math.round(first.durationSeconds), line: first.geometry.map(pointOf),
      turns: first.steps.map((step) => ({ instruction: step.instruction, at: pointOf(step.coordinate), meters: Math.round(step.distanceMeters) })),
    }
    atlas.routed(ticket, way)
    return { type: "answerRoute", ticket, ok: true, turns: Math.max(1, way.turns.length) }
  } catch () => ({ type: "answerRoute", ticket, ok: false, turns: 0 })
}

function allowedOf(grant: Grant): Allowed {
  return grant === "precise" ? "Granted" : grant === "approximate" ? "Limited" : grant === "denied" ? "Denied" : "Unasked"
}

// spec/app/maps/index.md, "A fix goes to whoever holds the location"; spec/app/maps/navigation.md, "A fix moves guidance only when it is precise, fresh and close: arrival within 25 meters, a turn passed within 40 meters or beyond 60, the route left beyond 75"
function located(session: number, once: boolean): Stream.Stream<Ev, never, Location | Time | Screen.Machine> {
  return Stream.unwrap(effect {
    const location = try Location
    const time = try Time
    const screen = try Screen.Machine
    const began = try time.now()
    const fixes = location.watch()
      |> Stream.filter(%, (heard) => heard.kind === "fix")
      |> Stream.mapEffect(%, (heard) => effect {
        if (heard.kind !== "fix") return { type: "locationLost", session } satisfies Ev
        const at: Point = { lat: heard.lat, lng: heard.lng }
        atlas.located({ at, accuracy: heard.accuracy, approximate: !heard.precise })
        if (once) return { type: "locationFix", session, fix: "Along" } satisfies Ev
        const { trip } = try screen.get()
        const way = atlas.way(trip.route)
        const ageMs = (try time.now()) - heard.taken
        if (way === undefined) return { type: "locationFix", session, fix: "Along" } satisfies Ev
        const along = measured(at, { line: way.line, turns: way.turns.map((turn) => turn.at) }, trip.turn - 1)
        return { type: "locationFix", session, fix: judged(heard.precise, ageMs, heard.accuracy, along.toEnd, along.toRoute, along.toStep, along.beyond) } satisfies Ev
      })
      |> Stream.catch(%, () => Stream.succeed<Ev>({ type: "locationLost", session }))
    if (!once) return fixes
    const givenUp = Stream.fromEffect(time.until(began + findTimeoutMs) |> Effect.as(%, { type: "findTimedOut", session } satisfies Ev))
    return Stream.merge(Stream.take(fixes, 1), givenUp) |> Stream.take(%, 1)
  })
}

effect function stopped(): void!!Location {
  try ignore((try Location).clear())
}

// spec/app/maps/index.md, "Continuing past the disclosure asks Android, once"
effect function permitted(): Ev!!Location {
  return { type: "observeLocation", grant: allowedOf(try (try Location).request()) }
}

// spec/app/maps/index.md, "\"Use my location\" locates once when allowed, asks when it may, and otherwise opens Settings"
effect function settingsOpened(): void!!Location {
  try ignore((try Location).openSettings())
}

const savedKey = "alpha/maps/saved@1"

interface KeptPlace extends Saved {
  readonly spot: Spot
}

// spec/app/maps/index.md, "Saved places are kept on the phone, and are what survives a restart"
effect function keep(saved: ReadonlyArray<Saved>): void!!KeyValueStore.KeyValueStore {
  const store = try KeyValueStore.KeyValueStore
  const kept: KeptPlace[] = saved.flatMap((entry) => {
    const spot = atlas.spot(entry.place)
    return spot === undefined || spot.google ? [] : [{ ...entry, spot }]
  })
  try ignore(store.set(savedKey, JSON.stringify(kept)))
}

effect function restored(): readonly [Ev]!!KeyValueStore.KeyValueStore {
  const store = try KeyValueStore.KeyValueStore
  const text = (try (store.get(savedKey) |> Effect.orElseSucceed(%, () => undefined))) ?? "[]"
  const parsed: unknown = (() => { try { return JSON.parse(text) } catch { return [] } })()
  const kept = Array.isArray(parsed) ? (parsed as KeptPlace[]) : []
  const saved = kept.map((entry) => ({ place: atlas.numberOf(entry.spot), name: entry.name }))
  return [{ type: "restoreSaved", saved }]
}

// spec/app/maps/index.md, "The card shares the place or the arrival time, opens its website, or opens it in the phone's maps app"
effect function handed(place: number, kind: HandOff): void!!Screen.Machine {
  const spot = atlas.spot(place)
  if (spot === undefined) return
  const where = `${spot.at.lat / 1e6},${spot.at.lng / 1e6}`
  const { trip } = try (try Screen.Machine).get()
  const way = atlas.way(trip.route)
  try ignore(match (kind) {
    when "SharePlace": tryPromise(() => shared(spot.name, `${spot.name}${spot.address === undefined ? "" : `, ${spot.address}`}`));
    when "EtaShare": tryPromise(() => shared(spot.name, `On my way to ${spot.name}${way === undefined ? "" : `, about ${Math.max(1, Math.round(way.seconds / 60))} min away`}`));
    when "Website": sync(() => { if (spot.website !== undefined) opened(spot.website) });
    when "MapsApp": sync(() => opened(`geo:${where}?q=${encodeURIComponent(`${where}(${spot.name})`)}`));
  })
}

const tileColumns = 3
const tileRows = 4

/** Where the camera looks: guidance follows the phone, else the route, the place on the card, the first result or the phone. */
function centreOf(state: State): Point | undefined {
  const seen = atlas.snapshot()
  if (state.trip.guidance === "Going" && seen.here !== undefined) return seen.here.at
  const way = atlas.way(state.trip.route)
  if (state.trip.route !== 0 && way !== undefined) return way.line[Math.floor(way.line.length / 2)]
  const spot = atlas.spot(state.place)
  if (spot !== undefined) return spot.at
  const first = state.results > 0 ? atlas.spot(seen.results[0] ?? 0) : undefined
  return first?.at ?? seen.here?.at
}

// spec/app/maps/index.md, "The map surface says whether it was drawn, and Retry draws it again"; spec/app/maps/credits.md, "A failed tile never breaks a surface whose style has loaded, and a cancelled tile breaks nothing"
effect function drawnTiles(plane: number, basemap: Basemap, centre: Point): boolean!!(Cloud | Time) {
  const zoom = atlas.snapshot().zoom
  if (basemap !== "Cloud" || !coverage.available || !coverage.capabilities.map) {
    atlas.drawn({ plane, zoom, centre, images: [] })
    return true
  }
  const middle = tileAt(centre, zoom)
  const first = { x: Math.floor(middle.x) - 1, y: Math.floor(middle.y) - 2 }
  const span = 2 ** zoom
  const images = []
  for (let row = 0; row < tileRows; row++) {
    for (let column = 0; column < tileColumns; column++) {
      const x = (((first.x + column) % span) + span) % span
      const y = first.y + row
      if (y < 0 || y >= span) continue
      const tile = try (asked((client, signal) => client.mapsTile({ z: zoom, x, y }, { signal })) |> Effect.option(%))
      if (Option.isSome(tile)) images.push({ key: `${zoom}/${x}/${y}`, url: imageOf(tile.value.contentType, tile.value.bytes), left: (first.x + column - middle.x) * 256, top: (y - middle.y) * 256 })
    }
  }
  atlas.drawn({ plane, zoom, centre, images })
  return images.length > 0
}

const world: Point = { lat: 20_000_000, lng: 0 }

effect function drawMap(plane: number, basemap: Basemap): Ev!!(Cloud | Time | Screen.Machine) {
  const state = try (try Screen.Machine).get()
  const ok = try drawnTiles(plane, basemap, centreOf(state) ?? world)
  return { type: "reportMap", plane, ok }
}

function carry(fx: Out): Job<Ev, Cloud | Time | Location | Screen.Machine | KeyValueStore.KeyValueStore | Shell, []> {
  return match (fx) {
    when { tag: "ReadCoverage", let ticket }: answer("coverage", covered(ticket), { type: "answerCoverage", ticket, ok: false, covered: false, google: false, offer: noOffer });
    when { tag: "DrawMap", let plane, let basemap }: answer("draw", drawMap(plane, basemap), { type: "reportMap", plane, ok: false });
    when { tag: "FindPlaces", let ticket, let query }: answer("search", searched(ticket, query), { type: "answerSearch", ticket, ok: false, found: 0 });
    when { tag: "FindForAgent", let query }: run("agentSearch", foundForAgent(query));
    when { tag: "PlanRoute", let ticket, let origin, let travel, let place }: answer("route", planned(ticket, origin, travel, place), { type: "answerRoute", ticket, ok: false, turns: 0 });
    when { tag: "StartLocation", let session, let once }: stream("location", located(session, once), { type: "locationLost", session });
    when { tag: "StopLocation" }: run("location", stopped());
    when { tag: "AskLocation" }: answer("permission", permitted(), { type: "observeLocation", grant: "Denied" });
    when { tag: "OpenLocationSettings" }: run("settings", settingsOpened());
    when { tag: "ShowMyLocation" }: run("show", Effect.void);
    when { tag: "GuideWithScreenOff", let journey }: answer("service", succeed<Ev>({ type: "serviceReport", journey, running: false }), { type: "serviceReport", journey, running: false });
    when { tag: "StopGuidance" }: run("location", stopped());
    when { tag: "KeepSaved", let saved }: run("saved", keep(saved));
    when { tag: "HandedOn", let place, let kind }: run("handOn", handed(place, kind));
    when { tag: "OpenEvent" }: run("event", Effect.flatMap(Shell, (shell) => ignore(shell.send({ type: "openView", view: "Calendar" }))));
    when { tag: "TellAgent", let ticket }: answer("tell", succeed<Ev>({ type: "answerTell", ticket, confirmed: false, known: false }), { type: "answerTell", ticket, confirmed: false, known: false });
    when { tag: "BringMapsForward" }: run("forward", Effect.flatMap(Shell, (shell) => ignore(shell.send({ type: "openView", view: "Maps" }))));
  }
}

const screen = reacting(Screen, { carry, open: restored() })

let asked_: { centre: Point; zoom: number } | undefined

/** The half width, in degrees, of the area a copyright is asked for at `zoom`: the view and one view of margin on each side. */
const spanAt = (zoom: number) => 0.02 * 2 ** (14 - zoom)

// spec/app/maps/credits.md, "When the camera settles outside the area the shown copyright covers, the copyright is asked for that view, and within it nothing changes"
function coveredNow(state: State): boolean {
  const centre = centreOf(state)
  if (centre === undefined || asked_ === undefined || asked_.zoom !== atlas.snapshot().zoom) return false
  const span = spanAt(asked_.zoom) / 3
  return Math.abs(centre.lat - asked_.centre.lat) / 1e6 <= span && Math.abs(centre.lng - asked_.centre.lng) / 1e6 <= span
}

// spec/app/maps/credits.md, "Only the answer to the latest copyright request, for the view in place, is shown, and a failed one never breaks the map"
effect function copyrighted(token: number): CreditsEv!!(Cloud | Time | Screen.Machine) {
  const state = try (try Screen.Machine).get()
  const centre = centreOf(state) ?? world
  const zoom = atlas.snapshot().zoom
  const span = spanAt(zoom)
  asked_ = { centre, zoom }
  return effect {
    const found = try asked((client, signal) => client.mapsViewport({
      zoom, north: Math.min(90, centre.lat / 1e6 + span), south: Math.max(-90, centre.lat / 1e6 - span),
      east: Math.min(180, centre.lng / 1e6 + span), west: Math.max(-180, centre.lng / 1e6 - span),
    }, { signal }))
    return { type: "copyrightAnswered", token, success: true, text: found.copyright }
  } catch () => ({ type: "copyrightAnswered", token, success: false, text: "" })
}

function carryCredits(fx: CreditsOut): Job<CreditsEv, Cloud | Time | Screen.Machine, []> {
  return match (fx) {
    when { tag: "Copyright", let token }: answer("copyright", copyrighted(token), { type: "copyrightAnswered", token, success: false, text: "" });
  }
}

const credits = reacting(Credits, { carry: carryCredits })

const accounts = new Map<string, number>()

// spec/app/maps/index.md, "Another account retires the trip, the search and the place, and reads the new account's coverage"
const account = started(effect {
  const { client } = try Cloud
  const owner = try (tryPromise(() => client.account()) |> Effect.option(%))
  const id = Option.isSome(owner) ? owner.value.id : ""
  const number = id === "" ? 0 : (accounts.get(id) ?? accounts.size + 1)
  accounts.set(id, number)
  if (number !== 0) try ignore((try Screen.Machine).send({ type: "changeAccount", account: number }))
}, "reading the Maps account")

// spec/app/maps/connection.md, "A failed read is tried again"
const retried = started(effect {
  const screen = try Screen.Machine
  const time = try Time
  try Stream.runForEach(
    screen.changes |> Stream.map(%, (s) => s.link.coverage.status === "Failed" && s.link.account !== 0 ? s.link.coverage.ticket : 0) |> Stream.changes(%),
    effect (ticket) => {
      if (ticket === 0) return
      try time.until((try time.now()) + 30_000)
      try ignore(screen.send({ type: "connect" }))
    },
  )
}, "retrying Maps")

// spec/app/maps/index.md, "What Android reports about location is taken at once; guidance without it ends"
const permission = started(effect {
  const shell = try Shell
  const screen = try Screen.Machine
  const location = try Location
  try Stream.runForEach(shell.changes |> Stream.map(%, (s) => showing(s, "Maps")) |> Stream.changes(%), effect (shown) => {
    if (!shown) return
    try ignore(screen.send({ type: "observeLocation", grant: allowedOf(try location.permission()) }))
    try ignore(screen.send({ type: "connect" }))
  })
}, "reading the location permission")

function cameraOf(state: State): string {
  const centre = centreOf(state)
  return centre === undefined ? "" : `${state.link.plane}:${centre.lat}:${centre.lng}:${atlas.snapshot().zoom}`
}

/**
 * Maps: its screen and the map's credits, which live from Maps' first opening until Alpha closes; the saved places,
 * kept on the phone; and what each follows: the shell's showing Maps, the account, Android's permission and the camera.
 */
export const maps = together(
  screen,
  credits,
  account,
  retried,
  permission,
  following(Shell, (shell) => showing(shell, "Maps"), Screen.Machine, (shown): Ev => (shown ? { type: "comeBack" } : { type: "leaveMaps" })),
  following(Screen.Machine, (state) => [state.link.plane, state.link.basemap === "Cloud"] as const, Credits.Machine, ([plane, raster]): CreditsEv => ({ type: "drawnOn", plane, raster })),
  following(Screen.Machine, (state) => [cameraOf(state), coveredNow(state)] as const, Credits.Machine, ([camera, covered]): CreditsEv | undefined => (camera === "" ? undefined : { type: "cameraSettled", covered })),
  applying(Screen.Machine, cameraOf, (camera) => effect {
    if (camera === "") return
    const state = try (try Screen.Machine).get()
    try ignore(drawnTiles(state.link.plane, state.link.basemap, centreOf(state) ?? world))
  }),
)

/** The owner zooms the map in or out: the tiles of the new zoom are drawn. */
export effect function zoomed(step: number): void!!(Cloud | Time | Screen.Machine) {
  atlas.zoomBy(step)
  const state = try (try Screen.Machine).get()
  try ignore(drawnTiles(state.link.plane, state.link.basemap, centreOf(state) ?? world))
}

// spec/app/maps/index.md, "An event's place opens on its card once Maps is on screen, never over navigation, and Maps remembers the event"
/** Calendar hands Maps an event's place by its words: Maps comes forward, finds the place and opens it on its card. */
export effect function enteredFromEvent(meeting: number, address: string): boolean!!(Cloud | Time | Screen.Machine | Shell) {
  try ignore((try Shell).send({ type: "openView", view: "Maps" }))
  const found = try (asked((client, signal) => client.mapsGeocode({ query: address, limit: 1 }, { signal })) |> Effect.option(%))
  const first = Option.isSome(found) ? found.value.places[0] : undefined
  if (first === undefined) return false
  const place = atlas.numberOf(spotOf(first))
  return try (((try Screen.Machine).send({ type: "enterFromEvent", meeting, place })) |> Effect.as(%, true) |> Effect.orElseSucceed(%, () => false))
}

/** What Maps shows, as the agent's turn names it: the place or route on screen by its handle and revision, or nothing. */
export interface Selected {
  readonly kind: "map-place" | "map-route"
  readonly id: string
  readonly revision: string
}

// spec/app/maps/index.md, "While Maps is in front the agent is told what it shows, a place, a route or a search, by a handle that names it on this phone only"
export function selectedOf(state: State, inFront: boolean): Selected | undefined {
  const what = shown(state, inFront)
  if (!readable(what)) return undefined
  return { kind: what === "ShowsRoute" ? "map-route" : "map-place", id: atlas.handleOf(state.place), revision: String(state.review.revision) }
}
