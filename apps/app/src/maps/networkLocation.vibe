// spec/maps/location.md, "When GPS gives no fix for 4 seconds, a network position stands in as approximate until GPS answers"; spec/assistant/context.md, "The network answer is looked up only off the messaging path, when GPS has nothing, and is reused before it is asked again"
import { NetworkLocation, type NetworkPosition } from "../assistant/network-location.vibe"
import type { Position } from "./geometry.vibe"

/** A network position as Maps shows it: approximate, with the accuracy the service gave. */
export type NetworkFix = Position

/** The phone's position from its visible Wi-Fi and cell towers, read from the one network client the assistant's chat location also uses. */
export service MapsNetworkLocation {
  /** The kept answer while it may still stand for the phone's position; never a lookup. */
  cached(): NetworkFix | undefined!!
  /** A position now: the kept one while recent, else one lookup shared with every caller waiting on it; undefined when none is known. */
  locate(): NetworkFix | undefined!!
}

/** The shared network answer as a Maps position. */
export function networkFixOf(answer: NetworkPosition | undefined): NetworkFix | undefined {
  return answer === undefined ? undefined : {
    coordinate: { latitude: answer.latitude, longitude: answer.longitude }, accuracyMeters: answer.accuracyMeters,
    timestamp: answer.timestamp, precision: "approximate",
  }
}

/** Maps' network position over the assistant's `NetworkLocation`, so Maps and chat share one cache, one lookup in flight and one back-off. */
export const networkLayer = Layer.effect(MapsNetworkLocation, effect {
  const network = try NetworkLocation
  return {
    effect cached() { return networkFixOf(try network.cached()) },
    effect locate() { return networkFixOf(try network.locate()) },
  }
})
