// spec/maps/location.md, "A chat turn waits at most 1.5 seconds for a position, reuses one for a minute, and serves a nearby search only while recent"
import { type PhoneLocation as Fix, phoneLocation } from "@elizaos/plugin-maps/client/location"
import { mayReadPhone, phonePlatformMaxAgeMs, phoneReadTimeoutMs, phoneWaitMs, reusePhoneFix } from "../../gen/maps__location.effect.vibe"
import { Native } from "../platform/native.vibe"
import { LocationEvent, Permission } from "./maps.schema.vibe"
import { MapsPreferences } from "./ports.vibe"

const PLUGIN = "ElizaLocation"

/** The phone's last known position for an ordinary chat turn, when Location for Alpha is on and Android already allows it. */
export service PhoneLocation {
  /** The position to send with this turn, waiting at most 1.5 seconds; never prompts. */
  forTurn(): Fix | undefined!!
  /** Warm a read at connect, so the first turn has one. */
  warm(): void!!
}

/** The phone position reader over `ElizaLocation`; a newer capture wins and a revoked permission forgets it. */
export const phoneLocationLayer = Layer.effect(PhoneLocation, effect {
  const native = try Native
  const preferences = try MapsPreferences
  const last = try Ref.make<Fix | undefined>(undefined)
  const allowed = try Ref.make(true)
  const reading = try Ref.make<Fiber.Fiber<Fix | undefined> | undefined>(undefined)

  fork.detached Stream.runForEach(preferences.locationForAlpha, (on) => effect {
    try Ref.set(allowed, on)
    if (!on) try Ref.set(last, undefined)
  })

  effect function granted() {
    if (!(try native.available(PLUGIN))) return false
    const raw = native.invoke(PLUGIN, "checkPermissions") catch () => undefined
    const grant = raw === undefined ? undefined : (Schema.decodeUnknownEffect(Permission)(raw) catch () => undefined)
    return grant?.location === "granted" && grant.accuracy !== "none"
  }

  effect function read() {
    const raw = native.invoke(PLUGIN, "getCurrentPosition", { accuracy: "high", maxAge: phonePlatformMaxAgeMs, timeout: phoneReadTimeoutMs }) catch () => undefined
    const event = raw === undefined ? undefined : (Schema.decodeUnknownEffect(LocationEvent)(raw) catch () => undefined)
    const fix = event === undefined ? undefined : phoneLocation({
      latitude: event.coords.latitude, longitude: event.coords.longitude, capturedAt: Math.max(0, Math.round(event.coords.timestamp)),
      ...(Number.isFinite(event.coords.accuracy) ? { accuracyMeters: Math.min(1000000, event.coords.accuracy) } : {}),
    })
    if (fix) try Ref.update(last, (old) => old === undefined || fix.capturedAt >= old.capturedAt ? fix : old)
    return try Ref.get(last)
  }

  effect function shared() {
    const running = try Ref.get(reading)
    if (running) return running
    const fiber = fork.detached ensuring(read(), Ref.set(reading, undefined))
    try Ref.set(reading, fiber)
    return fiber
  }

  effect function gated() {
    const native_ = try native.available(PLUGIN)
    const ok = mayReadPhone({ allowed: try Ref.get(allowed), granted: native_ && (try granted()), native: native_ })
    if (!ok) try Ref.set(last, undefined)
    return ok
  }

  return {
    effect forTurn() {
      if (!(try gated())) return undefined
      const now = try Clock.currentTimeMillis
      const known = try Ref.get(last)
      if (known && reusePhoneFix(now - known.capturedAt)) return known
      const fiber = try shared()
      const waited = timeout(Fiber.join(fiber), phoneWaitMs) catch () => undefined
      return waited ?? known
    },
    effect warm() {
      if (try gated()) try shared()
    },
  }
})
