// spec/maps/connection.md, "Only the newest read for the bound account installs the provider"; spec/maps/delivery.md, "A navigation effect runs only under a returned claim, and a redelivery never runs it twice"; spec/maps/vocabulary.md, "A fix guides only when precise, at most 30 seconds old, at most 5 seconds ahead, and within 50 meters"; spec/maps/eventReturn.md, "One check per tap, and only its reply for the current origin returns, once"

import { Route, TravelMode } from "@elizaos/plugin-maps/client/contracts"

const controls = /^[^\u0000-\u0008\u000b\u000c\u000e-\u001f]*\S[^\u0000-\u0008\u000b\u000c\u000e-\u001f]*$/
const text = (maximum: number) => Schema.String.check(Schema.isMaxLength(maximum), Schema.isPattern(controls))
const between = (minimum: number, maximum: number) => Schema.Finite.check(Schema.isBetween({ minimum, maximum }))
const whole = (minimum: number, maximum: number) => Schema.Int.check(Schema.isBetween({ minimum, maximum }))
const meters = Schema.Finite.check(Schema.isGreaterThanOrEqualTo(0))
const ProviderId = Schema.String.check(Schema.isPattern(/^[a-z0-9][a-z0-9._-]{0,79}$/))

export { Coordinate, Maneuver, Route, RouteStep, TravelMode, type Place } from "@elizaos/plugin-maps/client/contracts"

/** Places as Cloud Maps returns them; each one is checked by the client contract's `place`. */
export const PlacesAnswer = Schema.Struct({ providerId: ProviderId, attribution: text(2000), places: Schema.Array(Schema.Unknown).check(Schema.isMaxLength(50)) })
export const PlaceAnswer = Schema.Struct({ providerId: ProviderId, attribution: text(2000), place: Schema.Unknown })

export const RoutesAnswer = Schema.Struct({ providerId: ProviderId, attribution: text(2000), routes: Schema.Array(Route.check(Schema.makeFilter((r: Route) => r.geometry.length <= 20000 && r.steps.length <= 2000))).check(Schema.isMinLength(1), Schema.isMaxLength(3)) })
export const ViewportAnswer = Schema.Struct({ providerId: ProviderId, copyright: text(500), maxZoom: Schema.optionalKey(whole(0, 22)) })

/** A raster tile as the account-bound transport returns it: base64 of at most 1 MiB of image. */
export const TileAnswer = Schema.Struct({
  encoding: Schema.Literal("base64"),
  contentType: Schema.Literals(["image/png", "image/jpeg", "image/webp"]),
  data: Schema.String.check(Schema.isMaxLength(1398104), Schema.isPattern(/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/)),
})

const Bounds = Schema.Tuple([between(-180, 180), between(-90, 90), between(-180, 180), between(-90, 90)])
  .check(Schema.makeFilter(([west, south, east, north]: readonly [number, number, number, number]) => west < east && south < north))
export const Recipient = Schema.Struct({ role: Schema.Literals(["gateway", "search", "routing"]), name: text(100), operator: text(100) })
export type Recipient = typeof Recipient.Type

/** What the deployment's Maps offers, read once per account from `GET /api/v1/maps/capabilities`. */
export const Capabilities = Schema.Union([
  Schema.Struct({ available: Schema.Literal(false) }),
  Schema.Struct({
    available: Schema.Literal(true),
    providerId: ProviderId,
    connectionId: Schema.String.check(Schema.isPattern(/^conn_[A-Za-z0-9_-]{16,}$/)),
    revision: text(100),
    attribution: text(2000),
    sources: Schema.optionalKey(Schema.Struct({ data: text(100), search: text(100), routing: text(100) })),
    disclosure: Schema.optionalKey(Schema.Struct({
      recipients: Schema.Array(Recipient).check(Schema.isMinLength(1), Schema.isMaxLength(8)),
      cloudRecords: Schema.Literal("operation-and-result-code"),
    })),
    regions: Schema.Array(Schema.Struct({ id: text(64), name: text(100), bounds: Bounds })).check(Schema.isMinLength(1), Schema.isMaxLength(64)),
    capabilities: Schema.Struct({
      map: Schema.Boolean,
      search: Schema.Literal(true),
      placeDetails: Schema.Literal(true),
      modes: Schema.Array(TravelMode).check(Schema.isMinLength(1)),
      alternatives: Schema.optionalKey(Schema.Boolean),
      traffic: Schema.Literals(["none", "live"]),
      transit: Schema.Literals(["none", "scheduled"]),
    }),
    tiles: Schema.optionalKey(Schema.Struct({
      urlTemplate: Schema.Literal("/api/v1/maps/tiles/{z}/{x}/{y}"),
      minZoom: whole(0, 22), maxZoom: whole(0, 22), tileSize: Schema.Literals([256, 512]), attribution: text(200),
    })),
  }),
])
export type Capabilities = typeof Capabilities.Type

/** The host's answer to a view-navigation claim: the claim the renderer must name in its one result. */
export const InteractClaim = Schema.Struct({ claimId: Schema.String.check(Schema.isMinLength(1), Schema.isMaxLength(256), Schema.isPattern(controls)) })

export const Permission = Schema.Struct({
  location: Schema.Literals(["granted", "denied", "prompt", "prompt-with-rationale"]),
  accuracy: Schema.optionalKey(Schema.Literals(["precise", "approximate", "none"])),
})
export type Permission = typeof Permission.Type

/** One `locationChange` event of `ElizaLocation`. */
export const LocationEvent = Schema.Struct({
  coords: Schema.Struct({
    latitude: between(-90, 90), longitude: between(-180, 180), accuracy: meters, timestamp: Schema.Finite,
    heading: Schema.optionalKey(Schema.NullOr(Schema.Finite)), speed: Schema.optionalKey(Schema.NullOr(Schema.Finite)),
  }),
  cached: Schema.optionalKey(Schema.Boolean),
})
export const LocationError = Schema.Struct({ code: Schema.String })

export const WatchId = Schema.Struct({ watchId: Schema.String.check(Schema.isMinLength(1)) })

export const NavigationAvailability = Schema.Struct({ background: Schema.Boolean, activeSessionId: Schema.optionalKey(Schema.String) })
export const NavigationActive = Schema.Struct({ active: Schema.Boolean })
export const NavigationStopped = Schema.Struct({ sessionId: Schema.String, reason: Schema.String })
export const NavigationOpen = Schema.Struct({ open: Schema.Boolean })

/** `AlphaCalendar.list` around the event a Maps visit returns to. */
export const CalendarRead = Schema.Struct({
  status: Schema.String,
  events: Schema.optionalKey(Schema.Array(Schema.Struct({ id: Schema.Union([Schema.String, Schema.Finite]), begin: Schema.Finite }))),
})

/** The Calendar event a Maps visit came from: identity and start only, never its location. */
export const EventOrigin = Schema.Union([
  Schema.Struct({ version: Schema.Literal(1), id: text(256), begin: Schema.Int, rowId: text(512), day: Schema.Int, title: Schema.String.check(Schema.isMaxLength(2048)) }),
  Schema.Struct({
    version: Schema.Literal(2), id: text(256), begin: Schema.Int, rowId: text(512), day: Schema.Int, title: Schema.String.check(Schema.isMaxLength(2048)),
    binding: text(4096), eventKey: text(4096), revision: text(1024), sourceRevision: Schema.String.check(Schema.isPattern(/^[a-f0-9]{64}$/)),
  }),
])
export type EventOrigin = typeof EventOrigin.Type
