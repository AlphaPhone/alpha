// spec/maps/cards.md, "Only the newest agent message offers its choice and its card, in the session and conversation that showed them"; spec/maps/connection.md, "Changing account retires the provider; rebuilding the client for the same account keeps it"; spec/maps/agentSurface.md, "Maps opens at most once per request, only over an unblocked launcher, and the answer waits for the open to commit or two seconds"; spec/maps/notificationOpen.md, "A read starts only when Maps can be shown and none is in flight, and opens Maps at most once per tap"
import { type Nav, running } from "../../gen/shell__navigation.effect.vibe"
import { Machine as CallBarMachine, type CallBar } from "../../gen/telephony__callBar.effect.vibe"
import { AccountSheet } from "../account/sheet.vibe"
import { Composer } from "../assistant/composer.vibe"
import { AppLifecycle } from "../platform/lifecycle.vibe"
import { Build } from "../platform/build.vibe"
import { foregroundOf } from "../shell/foreground.vibe"
import { Navigation as ShellNavigation } from "../shell/navigation.vibe"
import { pageEvents } from "../shell/page.ts"
import type { AppId } from "../web/app-screen.ts"
import { MapsHandoff } from "./handoff.vibe"
import { MapsAccount, MapsShell, type ShellState } from "./ports.vibe"

/** The launcher as Maps reads it, from the shell's navigation, Telecom's calls, whether Android has the app in front, whether the account sheet is open, and the build. */
export function shellStateOf(nav: Nav, calls: CallBar, foreground: boolean, accountOpen: boolean, native: boolean): ShellState {
  const front = foregroundOf(nav)
  return {
    live: running(nav), hidden: nav.hidden, suspended: !foreground, assistantWindow: nav.host === "AssistantSurface",
    connectionOpen: accountOpen || nav.layers.some((layer) => layer.id.startsWith("account")), home: front.screen === "home", secure: front.locked,
    shaded: nav.shade, ringing: calls.calls.some((call) => call.phase === "Ringing"), native,
    view: nav.app === "" ? "home" : nav.app, stack: nav.stack,
  }
}

const shellLive = Layer.effect(MapsShell, effect {
  const navigation = try ShellNavigation
  const calls = try CallBarMachine
  const lifecycle = try AppLifecycle
  const sheet = try AccountSheet
  const native = (try Build).info.variant !== "browser"
  let agentOpen = ""
  const foreground = Stream.changes(Stream.map(lifecycle.changes, (app) => app.foreground))
  const accountOpen = Stream.changes(Stream.map(sheet.changes, (s) => s.open))
  const outside = Stream.zipLatest(foreground, accountOpen)
  return {
    states: Stream.map(Stream.zipLatest(Stream.zipLatest(navigation.changes, calls.changes), outside), ([[nav, bar], [front, open]]) => shellStateOf(nav, bar, front, open, native)),
    effect current() { return shellStateOf(try navigation.get(), try calls.get(), (try lifecycle.get()).foreground, (try sheet.current()).open, native) },
    effect open(app: string, route?: string) {
      const forAgent = agentOpen === app
      agentOpen = ""
      if (forAgent) try navigation.switchForAgent(app as AppId, route ?? "")
      else try navigation.open(app as AppId, route)
    },
    effect admitOwnViewOpen(app: string) { agentOpen = app },
    effect back() { try navigation.back() },
  }
})

/** What Maps needs from the telephony and shell areas, built over their own services; GuidanceSpeaker is voice's and MapsAccount is account's. */
export const portsLive = shellLive

/** The chat Maps counts messages in: a new account session or another open conversation retires the messages counted before. */
export const chatLive = Layer.effectDiscard(effect {
  const handoff = try MapsHandoff
  const account = try MapsAccount
  const composer = try Composer
  const sessions = new Map<string, number>()
  const conversations = new Map<string, number>()
  let session = 1
  let conversation = 1
  fork.scoped Stream.runForEach(account.changes, (binding) => effect {
    const key = binding ? `${binding.sessionId}\u0000${binding.credentialId}` : ""
    if (!sessions.has(key)) sessions.set(key, sessions.size + 1)
    session = sessions.get(key) ?? session
    try handoff.chatMoved(session, conversation)
  })
  fork.scoped Stream.runForEach(Stream.changes(Stream.map(composer.transcript, (t) => t.conversation ?? "")), (id) => effect {
    if (!conversations.has(id)) conversations.set(id, conversations.size + 1)
    conversation = conversations.get(id) ?? conversation
    try handoff.chatMoved(session, conversation)
  })
})

/** The navigation notification's tap and the launcher's HOME, as the Android activity posts them to the page. */
export const pageLinksLive = Layer.effectDiscard(effect {
  const handoff = try MapsHandoff
  fork.scoped (effect { for try (const _ of pageEvents("alpha:maps-open")) try handoff.notificationTapped() })
  fork.scoped (effect { for try (const _ of pageEvents("launcher-home")) try handoff.goneHome() })
})
