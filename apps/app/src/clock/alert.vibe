// spec/app/clock/index.md, "Story: Hear and prioritize ringing alerts"
import * as ClockView from "../../gen/app__clock.effect.vibe"
import * as Alarms from "../../gen/app__clock__alarms.effect.vibe"
import * as Timers from "../../gen/app__clock__timers.effect.vibe"
import { feel } from "../shell/haptics.vibe"
import { contained, started, together } from "../runtime/reactor.vibe"
import { playChimePulse } from "./chime.ts"
import { clockRecords } from "./records.ts"

const observeRinging = started(effect {
  const view = try ClockView.Machine
  const alarms = try Alarms.Machine
  const timers = try Timers.Machine
  try Stream.runForEach(Stream.zipLatest(alarms.changes, timers.changes), effect ([alarmState, timerState]) => {
    const alarmId = alarmState.items.find((item) => item.phase === "Ringing")?.id ?? 0
    const timerId = timerState.items.find((item) => item.status === "Ringing")?.id ?? 0
    const current = try view.get()
    if (ClockView.canSyncAlerts(current, alarmId, timerId)) {
      try contained(view.send({ type: "syncAlerts", alarmId, timerId }), "syncing Clock ringing alerts")
    }
  })
}, "observing Clock ringing alerts")

const playAlertAudio = started(effect {
  const view = try ClockView.Machine
  const alarms = try Alarms.Machine
  const watched = Stream.changesWith(
    view.changes,
    (a, b) => a.soundOn === b.soundOn && a.ringingAlarm === b.ringingAlarm && a.ringingTimer === b.ringingTimer,
  )
  try Stream.runDrain(Stream.switchMap(watched, (state) => {
    if (!state.soundOn) return Stream.empty
    return Stream.fromEffectDrain(effect {
      for (;;) {
        const alert = ClockView.activeAlert(state)
        if (alert.tag === "AlarmRing") {
          const alarm = (try alarms.get()).items.find((item) => item.id === alert.id)
          const meta = clockRecords.alarm(alert.id)
          playChimePulse(meta.sound, false)
          if (alarm?.vibrate !== false) try feel("Confirm")
        } else if (alert.tag === "TimerRing") {
          playChimePulse("chime", true)
          try feel("Confirm")
        }
        try sleep(1800)
      }
    })
  }))
}, "playing Clock ringing chime and haptics")

/** Resident alert coordinator linking Alarms and Timers ringing state to ClockView, chime audio, and haptics. */
export const alert = together(observeRinging, playAlertAudio)
