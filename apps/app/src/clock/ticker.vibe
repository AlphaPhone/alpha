// spec/app/clock/timers.md, "Story: Run multiple countdown timers"; spec/app/clock/stopwatch.md, "Story: Time laps with the stopwatch"
import * as ClockView from "../../gen/app__clock.effect.vibe"
import * as Alarms from "../../gen/app__clock__alarms.effect.vibe"
import * as Stopwatch from "../../gen/app__clock__stopwatch.effect.vibe"
import * as Timers from "../../gen/app__clock__timers.effect.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import { Device } from "../platform/index.vibe"
import { started, together } from "../runtime/index.vibe"
import { Time } from "../runtime/index.vibe"
import { activeClockTicks } from "./shelf.vibe"

effect function optionalShellChanges(): Stream.Stream<Shell.Shell | undefined>!! {
  const ctx = try Effect.context<never>()
  const found = Context.getOption(ctx, Shell.Machine)
  return Option.isSome(found) ? found.value.changes : Stream.concat(Stream.succeed(undefined), Stream.never)
}

function clockOrHomeVisible(shellState: Shell.Shell | undefined): boolean {
  if (shellState === undefined) return true
  return Shell.showing(shellState, "Clock") || shellState.trail.length === 0
}

function clockVisible(shellState: Shell.Shell | undefined): boolean {
  if (shellState === undefined) return true
  return Shell.showing(shellState, "Clock")
}

effect function visibilityStream(): Stream.Stream<boolean>!!Device {
  const device = try Device
  const initial = try device.showing()
  return Stream.concat(Stream.succeed(initial), device.visible)
}

const runningTimerTick = started(effect {
  const time = try Time
  const timers = try Timers.Machine
  const ticks = try activeClockTicks()
  const shellStream = try optionalShellChanges()
  const visibleStream = try visibilityStream()
  ticks.clockNow.set(try time.now())
  const active = Stream.changes(
    Stream.map(
      Stream.zipLatest(Stream.zipLatest(visibleStream, shellStream), timers.changes),
      ([[visible, shellState], state]) => visible && clockOrHomeVisible(shellState) && state.items.some((item) => item.status === "Running"),
    ),
  )
  try Stream.runDrain(Stream.switchMap(active, (running) => {
    if (!running) return Stream.fromEffect(effect { ticks.clockNow.set(try time.now()) })
    return Stream.fromEffectDrain(effect {
      for (;;) {
        ticks.clockNow.set(try time.now())
        try sleep(1000)
      }
    })
  }))
}, "Clock running timer ticks")

const alarmChangeTick = started(effect {
  const time = try Time
  const alarms = try Alarms.Machine
  const ticks = try activeClockTicks()
  try Stream.runForEach(alarms.changes, effect () => {
    ticks.clockNow.set(try time.now())
  })
}, "Clock alarm timestamp refresh")

/** Resident lightweight clock tick layer (ticks every second only while visible on Clock or Home with a running timer). */
export const residentClockTick = together(runningTimerTick, alarmChangeTick)

const screenSecondTick = started(effect {
  const time = try Time
  const view = try ClockView.Machine
  const ticks = try activeClockTicks()
  const shellStream = try optionalShellChanges()
  const visibleStream = try visibilityStream()
  const mode = Stream.changes(
    Stream.map(
      Stream.zipLatest(Stream.zipLatest(visibleStream, shellStream), view.changes),
      ([[visible, shellState], state]) => {
        if (!visible || !clockVisible(shellState)) return "off" as const
        return state.tab === "World" ? ("world" as const) : ("idle" as const)
      },
    ),
  )
  try Stream.runDrain(Stream.switchMap(mode, (current) => {
    if (current === "off") return Stream.empty
    const cadence = current === "world" ? 1000 : 60_000
    return Stream.fromEffectDrain(effect {
      for (;;) {
        ticks.clockNow.set(try time.now())
        try sleep(cadence)
      }
    })
  }))
}, "Clock screen ticks")

const stopwatchRunningTick = started(effect {
  const time = try Time
  const view = try ClockView.Machine
  const sw = try Stopwatch.Machine
  const ticks = try activeClockTicks()
  const shellStream = try optionalShellChanges()
  const visibleStream = try visibilityStream()
  ticks.stopwatchNow.set(try time.now())
  const running = Stream.changes(
    Stream.map(
      Stream.zipLatest(Stream.zipLatest(visibleStream, shellStream), Stream.zipLatest(view.changes, sw.changes)),
      ([[visible, shellState], [viewState, swState]]) =>
        visible && clockVisible(shellState) && viewState.tab === "Stopwatch" && swState.status === "Running",
    ),
  )
  try Stream.runDrain(Stream.switchMap(running, (isRunning) => {
    if (!isRunning) return Stream.empty
    return Stream.fromEffectDrain(effect {
      for (;;) {
        ticks.stopwatchNow.set(try time.now())
        try sleep(50)
      }
    })
  }))
}, "Stopwatch high-resolution ticks")

/** Area-scoped Clock screen ticker gated on visibility and active Clock screen/tab. */
export const clockScreenTick = together(screenSecondTick, stopwatchRunningTick)
