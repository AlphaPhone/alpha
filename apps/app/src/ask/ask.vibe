// spec/app/ask/index.md, "Story: Talk to my agent"
import * as Ask from "../../gen/app__ask.effect.vibe"
import type { Effect as Out, Event } from "../../gen/app__ask.effect.vibe"
import { Aborted, Agent, Created, Frame } from "../platform/agent.vibe"
import { ask, listen, outcomeOf } from "../platform/remote.vibe"
import { type Job, answer, reacting, run, stream } from "../runtime/reactor.vibe"

const json = (path: string, body: object) => HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post(path), body)

// spec/app/ask/index.md, "The conversation is the one the agent names in answer to that opening, or none when it does not"
effect function opened(id: number): Event!!Agent {
  return effect {
    const { conversation } = try ask(Agent, json("/api/conversations", { title: "Ask Alpha" }), Created)
    if (conversation.id === "") return { type: "unopened", id, known: true }
    return { type: "opened", id, conversation: conversation.id, room: conversation.roomId }
  } catch (failure) => ({ type: "unopened", id, known: outcomeOf(failure).known })
}

// spec/app/ask/index.md, "Only the turn under way is heard: its reply so far, then the whole reply, or that it did not finish"
function said(id: number, conversation: string, text: string): Stream.Stream<Event, never, Agent> {
  return listen(Agent, json(`/api/conversations/${conversation}/messages/stream`, { text }), Frame)
    |> Stream.map(%, (frame): Event => match (frame) {
      when { type: "token", let fullText }: { type: "heard", id, text: fullText };
      when { type: "done", let fullText }: { type: "answered", id, text: fullText };
      when { type: "error" }: { type: "unanswered", id, known: true };
    })
    |> Stream.catch(%, (failure) => Stream.succeed<Event>({ type: "unanswered", id, known: outcomeOf(failure).known }))
    |> Stream.concat(%, Stream.succeed<Event>({ type: "unanswered", id, known: false }))
}

// spec/app/ask/index.md, "The owner stops the reply under way once, and the agent is asked to stop that conversation's turn"
// The empty body makes it a POST for eliza's client, which sends a request without one as a GET.
const stopped = (room: string) => ignore(ask(Agent, json(`/api/turns/${room}/abort`, {}), Aborted))

function carry(fx: Out): Job<Event, Agent, []> {
  return match (fx) {
    when { tag: "Open", let id }: answer("open", opened(id), { type: "unopened", id, known: false });
    when { tag: "Say", let id, let conversation, let text }: stream("say", said(id, conversation, text), { type: "unanswered", id, known: false });
    when { tag: "Stop", let room }: run("stop", stopped(room));
  }
}

/** Ask Alpha's one conversation, kept in memory: it is the agent's, and is opened when the screen first loads. */
export const asking = reacting(Ask, { carry, open: [{ type: "begin" }] })
