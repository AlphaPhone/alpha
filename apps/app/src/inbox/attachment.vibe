// spec/app/inbox/message.md, "An attachment is reviewed before it is opened or saved, and one use is in flight at a time"; spec/app/inbox/message.md, "An attachment use ends as its own answer says, or unknown"
import type { MailMessage } from "@elizaos/cloud"
import type { ReviewedMailAttachment } from "@elizaos/plugin-inbox-client"
import { blobOf, decodeBase64, encoded, scaledImage, scanImageTypes } from "@elizaos/plugin-files-client"
import type { InboxAttachmentPreview } from "@repo/ui"
import * as Inbox from "../../gen/app__inbox.effect.vibe"
import * as Message from "../../gen/app__inbox__message.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { Cloud } from "../platform/cloud.vibe"
import { pdfRaster, previewOf, releasePreview } from "../platform/browser-library.ts"
import { InboxAttachmentFiles } from "../platform/inboxAttachments.vibe"
import { contained, started } from "../runtime/reactor.vibe"
import { Mail, revisionOf } from "./gmail.vibe"
import { provider } from "./provider.vibe"

type FilePart = MailMessage["attachments"][number]
type Request = Extract<Message.Effect, { tag: "HandleAttachment" }>
type Draw = Extract<Message.Effect, { tag: "DrawPdf" }>
type PdfCopy = { readonly kind: "pdf"; readonly blob: Blob; readonly digest: string; readonly page: number; readonly url: string }
type Preview = Exclude<InboxAttachmentPreview, { kind: "pdf" }> | PdfCopy

/** A preview and its PDF source live only for the attachment review that opened it. */
export service AttachmentPreviews {
  read(attempt: number): Preview | undefined
  show(attempt: number, preview: Preview): void
  forget(attempt: number): void
}

export const attachmentPreviews = Layer.effect(AttachmentPreviews, effect {
  let shown: { attempt: number; preview: Preview } | undefined
  const clear = () => {
    if (shown && shown.preview.kind !== "text") releasePreview(shown.preview.url)
    shown = undefined
  }
  try addFinalizer(() => sync(clear))
  return {
    read: (attempt: number) => shown?.attempt === attempt ? shown.preview : undefined,
    show: (attempt: number, preview: Preview) => {
      clear()
      shown = { attempt, preview }
    },
    forget: (attempt: number) => { if (shown?.attempt === attempt) clear() },
  }
})

export const forgetPreview = started(effect {
  const previews = try AttachmentPreviews
  const destination = try InboxAttachmentFiles
  const reader = try Message.Machine
  const shell = try Shell
  let before = 0
  const reviews = Stream.changes(Stream.map(Stream.zipLatest(reader.changes, shell.changes), ([state, view]) =>
    state.attachment === 0 || !showing(view, "Inbox") ? 0 : state.file.id))
  try Stream.runForEach(reviews, effect (attempt) => {
    if (before !== 0 && before !== attempt) {
      if (attempt === 0 && (try reader.get()).attachment !== 0 && !showing(try shell.get(), "Inbox")) {
        try contained(reader.send({ type: "closeAttachment" }), "closing a hidden attachment review")
      }
      previews.forget(before)
      try destination.cancel(before)
    }
    before = attempt
  })
}, "clearing an attachment preview")

/** Open bounded plain text, raster images and PDFs. */
export function canPreviewAttachment(file: FilePart): boolean {
  const type = file.mimeType.toLowerCase()
  return file.partId !== "" && file.size >= 0 && (type === "text/plain" ? file.size <= 512 * 1024
    : (type === "application/pdf" || scanImageTypes.includes(type)) && file.size <= 5 * 1024 * 1024)
}

/** The managed Inbox route supplies an exact file of up to five MiB. */
export function canSaveAttachment(file: FilePart): boolean {
  return file.partId !== "" && file.size >= 0 && file.size <= 5 * 1024 * 1024
}

effect function custody(request: Omit<Request, "tag">, expected: "Sent" | "Confirmed") {
  const reader = try (try Message.Machine).get()
  const list = try (try Inbox.Machine).get()
  const ledger = try Mail
  const { account, message, attachment, attempt, handling } = request
  if (reader.account !== account || reader.message !== message || reader.attachment !== attachment || reader.handling !== handling ||
    reader.file.id !== attempt || reader.file.outcome !== expected || reader.body.status !== "Loaded" || reader.fromPhone ||
    list.selected.account !== account || !Inbox.accessOf(list, account).grant.read || !showing(try (try Shell).get(), "Inbox")) return undefined
  const body = ledger.body(reader.body.ticket)
  const id = ledger.gmailId(message, account)
  const grant = ledger.grant(account)
  if (!id || body?.message.id !== id || grant === undefined) return undefined
  const history = body.message.metadata.historyId
  const part = body.attachments.at(attachment - 1)
  if (!history || reader.revision <= 0 || reader.revision !== revisionOf(body.message) || !part || attachment <= 0) return undefined
  return { id, grant, history, ticket: reader.body.ticket, generation: ledger.generation(account), part }
}

function matches(part: FilePart, fetched: ReviewedMailAttachment): boolean {
  return part.name === fetched.name && part.size === fetched.size && part.mimeType.toLowerCase() === fetched.mimeType
}

effect function render(blob: Blob, page: number) {
  const raster = try Effect.timeoutOption(tryPromise((signal) => pdfRaster(blob, page, signal)), "20 seconds")
  return Option.isSome(raster) && raster.value.status === "rendered" ? raster.value : undefined
}

/** Carries out exactly the use confirmed by the owner, while its account, reader ticket and provider revision agree. */
export effect function handleAttachment(request: Request): Message.Event!!(Cloud | Mail | Inbox.Machine | Message.Machine | AttachmentPreviews | InboxAttachmentFiles | Shell) {
  const { attempt, handling } = request
  const refused = { type: "attachmentHandled", attempt, done: false, known: true, pages: 0 } as const
  const owner = try custody(request, "Sent")
  if (owner === undefined) return refused
  const client = provider(try Cloud)
  const { grant, id, history, part } = owner
  const current = effect {
    const now = try custody(request, "Sent")
    return now !== undefined && now.id === id && now.grant === grant && now.history === history && now.ticket === owner.ticket &&
      now.generation === owner.generation && now.part === part
  }
  if (handling === "Opening") {
    if (!canPreviewAttachment(part)) return refused
    const opened = client.gmailAttachment(grant, id, part.partId, history) catch () => undefined
    if (opened === undefined || !matches(part, opened) || !(try current)) return refused
    const previews = try AttachmentPreviews
    if (opened.text !== undefined) {
      previews.show(attempt, { kind: "text", text: opened.text, digest: opened.sha256 })
    } else {
      const bytes = decodeBase64(opened.dataBase64)
      if (bytes === undefined) return refused
      const blob = blobOf([bytes], opened.mimeType)
      if (opened.mimeType === "application/pdf") {
        const machine = try Message.Machine
        const retired = Effect.as(Stream.runHead(Stream.filter(machine.changes, (view) => view.file.id !== attempt || view.file.outcome !== "Sent")), undefined)
        const raster = Effect.raceFirst(render(blob, 1), retired) catch () => undefined
        if (raster === undefined || !(try current)) return refused
        previews.show(attempt, { kind: "pdf", blob, digest: opened.sha256, page: 1, url: previewOf(raster.image) })
        return { ...refused, done: true, pages: raster.pageCount }
      }
      if (!scanImageTypes.includes(opened.mimeType)) return refused
      const raster = flatMap(scaledImage(blob, 2048), (image) => encoded(image, "image/png")) catch () => undefined
      if (raster === undefined || !(try current)) return refused
      previews.show(attempt, { kind: "image", url: previewOf(raster), digest: opened.sha256 })
    }
    return { ...refused, done: true }
  }
  const destination = try InboxAttachmentFiles
  if (!canSaveAttachment(part) || destination.destination === "unavailable") return refused
  const saved = client.gmailOpaqueAttachment(grant, id, part.partId, history) catch () => undefined
  if (saved === undefined || !matches(part, saved) || !(try current)) return refused
  const outcome = try destination.save(attempt, saved)
  return { ...refused, done: outcome === "saved", known: outcome !== "unknown" }
}

// spec/app/inbox/message.md, "A reviewed PDF turns one page at a time under a new draw ticket, and shows only the page drawn for that review"
/** Render the latest page of the PDF this review already opened. */
export effect function drawAttachmentPage({ attempt, ticket, page }: Draw): Message.Event!!(Mail | Inbox.Machine | Message.Machine | AttachmentPreviews | Shell) {
  const machine = try Message.Machine
  const previews = try AttachmentPreviews
  const view = try machine.get()
  const failed = { type: "pdfDrawn", attempt, ticket, page, ok: false } as const
  const copy = previews.read(attempt)
  if (!Message.canPdfDrawn(view, attempt, ticket, page) || copy?.kind !== "pdf") return failed
  const request = { attempt, account: view.account, message: view.message, attachment: view.attachment, handling: "Opening" } as const
  const owner = try custody(request, "Confirmed")
  if (owner === undefined) return failed
  const retired = Effect.as(Stream.runHead(Stream.filter(machine.changes, (state) => !Message.canPdfDrawn(state, attempt, ticket, page))), undefined)
  const raster = Effect.raceFirst(render(copy.blob, page), retired) catch () => undefined
  if (raster === undefined || raster.pageCount !== view.pdf.pages || previews.read(attempt) !== copy
    || !Message.canPdfDrawn(try machine.get(), attempt, ticket, page)) return failed
  const now = try custody(request, "Confirmed")
  if (now === undefined || now.ticket !== owner.ticket || now.generation !== owner.generation || now.grant !== owner.grant || now.part !== owner.part) return failed
  previews.show(attempt, { ...copy, page, url: previewOf(raster.image) })
  return { ...failed, ok: true }
}
