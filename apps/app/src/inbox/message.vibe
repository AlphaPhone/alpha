// spec/app/inbox/message.md, "Story: Read a message"; spec/app/inbox/marking.md, "Story: Mark mail read or unread"
import * as Inbox from "../../gen/app__inbox.effect.vibe"
import { accessOf } from "../../gen/app__inbox.effect.vibe"
import * as Message from "../../gen/app__inbox__message.effect.vibe"
import type { Effect as Out, Event } from "../../gen/app__inbox__message.effect.vibe"
import * as Marking from "../../gen/app__inbox__marking.effect.vibe"
import type { Effect as MarkOut, Event as MarkEvent } from "../../gen/app__inbox__marking.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { Machine as Layers, pageInert } from "../../gen/app__shell__layers.effect.vibe"
import { Machine as Preferences } from "../../gen/app__settings__preferences.effect.vibe"
import type { Machine as Toasts } from "../../gen/app__notices__toasts.effect.vibe"
import type { Actor } from "../../gen/app__inbox__access.ts"
import { MailContextRefused } from "@elizaos/plugin-inbox-client"
import { Agent } from "../platform/agent.vibe"
import { InboxBrowserLinks } from "../platform/browser.vibe"
import { Device, native, registered } from "../platform/device.vibe"
import type { InboxAttachmentFiles } from "../platform/inboxAttachments.vibe"
import { say, type Said } from "../notices/toasts.vibe"
import { MailQuestions, reviewMail, sourceOf, type MailQuestion } from "./mail-context.vibe"
import { Cloud } from "../platform/cloud.vibe"
import type { Attempts } from "../runtime/attempts.vibe"
import { type Job, answer, contained, following, hearing, reacting, run, started, stream, together, migratedStore } from "../runtime/reactor.vibe"
import { Mail, asked, body, faultOf, relabel, revisionOf } from "./gmail.vibe"
import { backFromDraft } from "./composer.vibe"
import { InboxAhead, aheadKey, bodyPart } from "./ahead.vibe"
import { ownerChanges } from "./mailbox.vibe"
import { prepareMessage } from "./mail-html.ts"
import { type ThreadPages, locateThread, threadFault, threadMessage, threadPages } from "./thread.vibe"
import { type AttachmentPreviews, attachmentPreviews, drawAttachmentPage, forgetPreview, handleAttachment } from "./attachment.vibe"

module web {
  /** Open `url` away from Alpha's page, with nothing of the page handed to it. @throws {never} */
  export function visit(url: string): void {
    window.open(url, "_blank", "noopener,noreferrer")
  }
}
import { visit } from web

const failedRead = (ticket: number, access: ReturnType<typeof accessOf>, fault: Message.Fault): Event =>
  ({ type: "loaded", ticket, access, ok: false, fault, revision: 0, message: 0, position: 0, thread: 0 })

const selectionOf = ({ selected }: Inbox.Mailbox) => JSON.stringify([selected.account, selected.folder, selected.query])

// spec/app/inbox/message.md, "Only the newest read's answer is shown, while its account may still be read; a read that fails says why"
effect function read(ticket: number, account: number, message: number, position: number, place: Message.ReadPlace): (Event | undefined)!!(Cloud | Mail | Inbox.Machine | InboxAhead | Message.Machine | ThreadPages) {
  const ledger = try Mail
  const list = try Inbox.Machine
  const view = try Message.Machine
  const generation = ledger.generation(account)
  const current = (state: Message.MessageView) =>
    state.account === account && state.message === message && state.body.ticket === ticket && state.body.status === "Loading"
  const before = try list.get()
  if (!current(try view.get()) || before.selected.account !== account) return undefined
  const selection = selectionOf(before)
  const anchor = ledger.card(message)
  const prepared = effect {
    if (place !== "SelectedMessage" || anchor === undefined || anchor.metadata.historyId === null || before.list.status !== "Loaded") return undefined
    const key = aheadKey(before, ledger)
    const part = bodyPart(anchor)
    for (const slot of (try InboxAhead).bodies) {
      const warmed = try slot.take(key, part)
      if (warmed !== undefined && warmed.message.id === anchor.id && warmed.message.metadata.historyId === anchor.metadata.historyId) return warmed
    }
    return undefined
  }
  const found = place === "SelectedMessage" || anchor === undefined
    ? (Effect.map(effect { return (try prepared) ?? (try body(account, message)) }, (loaded) => ({ body: loaded, position: 0, thread: 1 })) catch (cause) => faultOf(cause))
    : (threadMessage(account, anchor, position, place) catch (cause) => threadFault(cause))
  const mailbox = try list.get()
  if (!current(try view.get()) || selectionOf(mailbox) !== selection || ledger.generation(account) !== generation) return undefined
  const access = accessOf(mailbox, account)
  if (typeof found === "string") return failedRead(ticket, access, found)
  const number = try ledger.remember(account, found.body.message)
  ledger.read(ticket, found.body)
  return {
    type: "loaded", ticket, access, ok: true, fault: "Fine", revision: revisionOf(found.body.message),
    message: number, position: found.position, thread: found.thread,
  }
}

// spec/app/inbox/message.md, "Only an https link without credentials in it can be reviewed and opened; any other link stays text"
const opened = (message: number, link: number) => effect {
  const reader = try Message.Machine
  const list = try Inbox.Machine
  const mail = try Mail
  const state = try reader.get()
  const { account, body: { ticket } } = state
  const generation = mail.generation(account)
  const current = effect {
    const view = try reader.get()
    const mailbox = try list.get()
    return view.message === message && view.account === account && view.body.ticket === ticket && view.body.status === "Loaded"
      && mail.generation(account) === generation && mailbox.selected.account === account && accessOf(mailbox, account).grant.read
  }
  if (!showing(try (try Shell).get(), "Inbox") || !(try current)) return
  const found = mail.body(ticket)
  const destination = found === undefined ? undefined : prepareMessage(found).links.at(link - 1)
  if (!destination?.secure) return
  if (!native()) {
    visit(destination.url)
    return
  }
  if (registered("AlphaBrowser") && (try (try InboxBrowserLinks).open(destination.url, current))) return
  if (try current) try say("Browser could not open that link", true)
}

// spec/app/inbox/message.md, "Only the newest read's answer is shown, while its account may still be read; a read that fails says why": a message no longer in Gmail has the list read again.
const refreshed = (account: number) => effect {
  const list = try Inbox.Machine
  if ((try list.get()).selected.account === account) try ignore(list.send({ type: "refresh" }))
}

// spec/app/inbox/message.md, "Ask Alpha is handed the message on screen, once it has loaded, named by its account, number and history revision"
export const questionAbout = (account: number, message: number, revision: number, notice?: MailQuestion["notice"]) => effect {
  const view = try Message.Machine
  const list = try Inbox.Machine
  const ledger = try Mail
  const cloud = try Cloud
  const agent = try Agent
  const shell = try Shell
  const questions = try MailQuestions
  const initial = try view.get()
  const generation = ledger.generation(account)
  const grant = ledger.grant(account)
  const live = effect {
    const shown = try view.get()
    const mailbox = try list.get()
    const onScreen = (try shell.get()).trail.at(-1) === "Inbox"
    return onScreen && shown.account === account && shown.message === message && shown.revision === revision
      && shown.body.status === "Loaded" && shown.body.ticket === initial.body.ticket && ledger.generation(account) === generation
      && mailbox.selected.account === account && accessOf(mailbox, account).grant.read
  }
  const destination = effect {
    const owner = try asked((signal) => cloud.client.account({ signal }))
    const status = try agent.life.status()
    if (!status.available) throw new MailContextRefused({ reason: "unselected" })
    return { ownerId: owner.id, agentId: "alpha-resident", sessionId: String(status.epoch), origin: "alpha-resident" }
  }
  effect {
    const cached = ledger.body(initial.body.ticket)
    if (!grant || !cached || !(try live)) throw new MailContextRefused({ reason: "changed" })
    const reread = Effect.provideService(Effect.provideService(body(account, message), Cloud, cloud), Mail, ledger)
    const fresh = sourceOf(grant, try reread)
    const seen = sourceOf(grant, cached)
    if (JSON.stringify({ ...seen, revision: fresh.revision }) !== JSON.stringify(fresh)) throw new MailContextRefused({ reason: "changed" })
    const target = try destination
    const review = try reviewMail(fresh, target)
    if (!(try live)) throw new MailContextRefused({ reason: "changed" })
    const current: MailQuestion["current"] = effect () => {
      if (!(try live)) throw new MailContextRefused({ reason: "changed" })
      const fetched = try reread
      const target = try destination
      if (!(try live)) throw new MailContextRefused({ reason: "changed" })
      return { source: sourceOf(grant, fetched), destination: target }
    }
    questions.show({ question: { review, current, ...(notice === undefined ? {} : { notice }) } })
  } catch (cause) => questions.show({ failure: cause instanceof MailContextRefused && cause.reason === "too-large" ? "tooLarge" : "changed" })
  try ignore(shell.send({ type: "raise", detent: "Sheet" }))
}

function carry(fx: Out): Job<Event, Cloud | Agent | MailQuestions | Mail | Inbox.Machine | InboxAhead | Marking.Machine | Message.Machine | Shell | ThreadPages | AttachmentPreviews | InboxAttachmentFiles | InboxBrowserLinks | Toasts | Said, []> {
  return match (fx) {
    when { tag: "ReadMessage", let ticket, let account, let message, let position, let place }:
      stream("read", Stream.filter(Stream.fromEffect(read(ticket, account, message, position, place)), (event): event is Event => event !== undefined),
        failedRead(ticket, { account, grant: { read: true, send: false, modify: false } }, "Unreachable"));
    when { tag: "CheckAccounts" }: run("check", effect { try ignore((try Inbox.Machine).send({ type: "checkAccess" })) });
    when { tag: "RefreshList", let account }: run("refresh", refreshed(account));
    when { tag: "OpenLink", let message, let link }: run("link", opened(message, link));
    // spec/app/inbox/message.md, "An attachment use ends as its own answer says, or unknown"
    when { tag: "HandleAttachment", let attempt, let account, let message, let attachment, let handling }:
      answer(`attachment ${attempt}`, handleAttachment({ tag: "HandleAttachment", attempt, account, message, attachment, handling }), { type: "attachmentHandled", attempt, done: false, known: false, pages: 0, cancelled: false });
    // spec/app/inbox/message.md, "A reviewed PDF turns one page at a time under a new draw ticket, and shows only the page drawn for that review"
    when { tag: "DrawPdf", let attempt, let ticket, let page }:
      answer("pdf page", drawAttachmentPage({ tag: "DrawPdf", attempt, ticket, page }), { type: "pdfDrawn", attempt, ticket, page, ok: false });
    // spec/app/inbox/message.md, "Ask Alpha is handed the message on screen, once it has loaded, named by its account, number and history revision"
    when { tag: "AskAlpha", let account, let message, let revision }: run("ask", questionAbout(account, message, revision));
  }
}

// spec/app/inbox/marking.md, "The answer to the mark in flight ends it; a reply that does not match the mark asked, or none, leaves it unconfirmed, and the owner is told to refresh before trying again"
effect function marked(attempt: number, account: number, message: number, unread: boolean): MarkEvent!!(Attempts | Cloud | Mail) {
  const ledger = try Mail
  const generation = ledger.generation(account)
  const ended = try relabel(attempt, account, message, unread ? "mark-unread" : "mark-read")
  if (ended.done && ledger.generation(account) === generation) try ledger.relabelled(message, unread)
  return { type: "marked", attempt, done: ended.done, matches: ended.known, expired: ended.expired }
}

function carryMark(fx: MarkOut): Job<MarkEvent, Cloud | Mail | Inbox.Machine, [by: Actor]> {
  return match (fx) {
    when { tag: "MarkMessage", let attempt, let account, let message, let unread }:
      answer(`mark ${attempt}`, marked(attempt, account, message, unread), { type: "markLost", attempt }, "World");
    // spec/app/inbox/marking.md, "The owner's own mark that finds the cloud sign-in expired has the accounts checked again"
    when { tag: "CheckAccounts" }: run("check", effect { try ignore((try Inbox.Machine).send({ type: "checkAccess" })) }, "World");
  }
}

// spec/app/inbox/message.md, "Closing the message, losing read access to its account, a new cloud session, or a restart leaves nothing open and no read that could still answer"
const access = started(effect {
  const list = try Inbox.Machine
  const view = try Message.Machine
  let selection: string | undefined
  const grants = Stream.zipLatest(list.changes, view.changes) |> Stream.map(%, ([mailbox, shown]) => ({
    shown, access: accessOf(mailbox, shown.account), known: mailbox.accounts.status === "Loaded", selection: selectionOf(mailbox),
    saved: mailbox.saved && mailbox.signedIn && mailbox.selected.account === shown.account && mailbox.failure !== "Revoked",
  }))
  try Stream.runForEach(Stream.changesWith(grants, (a, b) => JSON.stringify(a.access) === JSON.stringify(b.access) && a.known === b.known &&
    a.saved === b.saved && a.selection === b.selection && a.shown.account === b.shown.account && a.shown.fromPhone === b.shown.fromPhone), effect ({ shown, access, known, saved, selection: next }) => {
    const changed = selection !== undefined && selection !== next
    selection = next
    if (shown.account === 0) return
    if (changed) {
      try contained(view.send({ type: "close" }), "the mailbox selection changed")
      return
    }
    // spec/app/inbox/message.md, "While the list shows its saved copy and access is being checked or offline, a message saved on the phone opens from there, marked as saved"
    if (shown.fromPhone) {
      if (known) {
        const remote = (try (try Preferences).get()).images
        try contained(view.send({ type: "accessKnown", access, remote }), "access known")
      } else if (!saved) try contained(view.send({ type: "close" }), "closing the saved message")
      return
    }
    try contained(view.send({ type: "accessChanged", access }), "the grant of the message open")
  })
}, "the grant of the message open")

const sessions = together(
  hearing(ownerChanges, Message.Machine, (): Event => ({ type: "sessionChanged" })),
  hearing(ownerChanges, Marking.Machine, (): MarkEvent => ({ type: "sessionChanged" }), "World"),
)

// spec/app/inbox/marking.md, "A list read afresh lets unconfirmed marks be tried again, and the owner can put the message away"
const afresh = following(Inbox.Machine, (list) => (list.list.status === "Loaded" && !list.saved ? list.list.ticket : 0), Marking.Machine, (ticket): MarkEvent | undefined => (ticket === 0 ? undefined : { type: "refreshed" }), "World")

// spec/app/inbox/marking.md, "Opening an unread message marks it read once in a session, silently, and never again, even when it is not known to have worked"
const openedUnread = started(effect {
  const list = try Inbox.Machine
  const view = try Message.Machine
  const ledger = try Mail
  const marks = try Marking.Machine
  const loaded = Stream.filter(view.changes, (state) => state.body.status === "Loaded")
  try Stream.runForEach(Stream.changesWith(loaded, (a, b) => a.body.ticket === b.body.ticket), effect (state) => {
    const mailbox = try list.get()
    const current = try view.get()
    const body = ledger.body(state.body.ticket)
    if (current.body.ticket !== state.body.ticket || current.body.status !== "Loaded" || mailbox.selected.account !== state.account || body === undefined) return
    try ignore(forkChild(ledger.keepBody(mailbox, body)))
    if (!body.message.isUnread) return
    try ignore(marks.send({
      type: "openedUnread", access: accessOf(mailbox, state.account), account: state.account, message: state.message,
    }, "World"))
  })
}, "marking the message on screen")

// spec/app/inbox/message.md, "Opening a row reads the exact message chosen while its account may be read"
const threadPosition = started(effect {
  const reader = try Message.Machine
  const list = try Inbox.Machine
  const mail = try Mail
  const selected = Stream.map(reader.changes, (view) => view.body.status === "Loaded" && view.thread === 1 ? view.body.ticket : 0)
  try Stream.runDrain(Stream.switchMap(Stream.changes(selected), (ticket) => Stream.fromEffectDrain(effect {
    if (ticket === 0) return
    const state = try reader.get()
    if (state.body.ticket !== ticket) return
    const { account, message } = state
    const generation = mail.generation(account)
    const original = mail.body(ticket)
    if (!original) return
    const found = locateThread(account, original) catch () => undefined
    const mailbox = try list.get()
    if (!found || mail.generation(account) !== generation || mailbox.selected.account !== account) return
    try contained(reader.send({ type: "threadLocated", ticket, message, access: accessOf(mailbox, account), ...found }), "finding the message in its thread")
  })))
}, "finding the message in its thread")

effect function readerRecord(raw: string | undefined): (string | undefined)!! {
  if (raw === undefined) return undefined
  const fields = Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Record(Schema.String, Schema.Unknown)))(raw) catch () => undefined
  if (fields === undefined || ("pdf" in fields && "keep" in fields)) return raw
  const migrated = Message.decodeState({ pdf: Message.emptyPdf, keep: Message.initial.keep, ...fields }) catch () => undefined
  return migrated === undefined ? raw : JSON.stringify(migrated)
}

function stored(key: string, start = Message.initial) {
  return Layer.provide(Message.stored(key, start), migratedStore(key, readerRecord))
}

const viewing = reacting({ ...Message, stored }, { keep: 1, open: [{ type: "restart" }], carry })
const marking = reacting(Marking, { keep: 1, open: [{ type: "restart" }, "World"], carry: carryMark })

/** A message opened from the list, and its marks: kept across restarts, read through the owner's cloud, and told what the list knows of access. */
export const reading = together(viewing, marking, access, sessions, afresh, openedUnread, threadPosition, threadPages, attachmentPreviews, forgetPreview)

// spec/app/home/cards.md, "The unread mail card opens Inbox without a search or message open"
/** The previous Inbox reader and search, to put away only when their Home card opens a new Inbox visit. */
export effect function prepareInboxCardEntry() {
  const list = try Inbox.Machine
  const reader = try Message.Machine
  const shell = try Shell
  const device = try Device
  const layers = try Layers
  const mail = try Mail
  const { selected } = try list.get()
  const previous = try reader.get()
  const owner = mail.generation()
  const grant = mail.generation(selected.account)
  const matchesList = (state: Inbox.Mailbox) => state.selected.account === selected.account
    && state.selected.folder === selected.folder && state.selected.query === selected.query
  const matchesReader = (state: Message.MessageView) => state.account === previous.account && state.message === previous.message
    && state.body.ticket === previous.body.ticket && state.position === previous.position
    && state.link === previous.link && state.attachment === previous.attachment
  return (route: number) => effect {
    const current = () => {
      const where = Effect.runSync(shell.get())
      return where.route === route && showing(where, "Inbox") && where.assistant === "Bar" && where.textAsk.tag === "NoTextAsk"
        && Effect.runSync(device.showing()) && !pageInert(Effect.runSync(layers.get()))
        && mail.ownerConfirmed() && mail.generation() === owner && mail.generation(selected.account) === grant
    }
    if (!current() || !matchesList(try list.get()) || !matchesReader(try reader.get())) return
    let closed = false
    if (Message.canClose(previous)) {
      closed = try contained(reader.send({ type: "close" }, (state) => current() && matchesReader(state)
        && matchesList(Effect.runSync(list.get()))), "closing the previous Inbox message")
      if (!closed) return
    }
    if (Inbox.canCloseSearch(try list.get())) {
      try contained(list.send({ type: "closeSearch" }, (state) => {
        if (!current() || !matchesList(state)) return false
        const showing = Effect.runSync(reader.get())
        return closed ? showing.message === 0 && showing.body.ticket === previous.body.ticket : matchesReader(showing)
      }), "clearing the previous Inbox search")
    }
  }
}

// spec/app/inbox/message.md, "Closing the message, losing read access to its account, a new cloud session, or a restart leaves nothing open and no read that could still answer"
/** Back from a message: a review open closes first, then the message, and the list is Inbox's own last step. */
export const back = effect {
  if (try backFromDraft) return true
  const view = try Message.Machine
  const state = try view.get()
  if (state.link !== 0) return Exit.isSuccess(try exit(view.send({ type: "closeLink" })))
  if (state.attachment !== 0) return Exit.isSuccess(try exit(view.send({ type: "closeAttachment" })))
  if (state.message !== 0) return Exit.isSuccess(try exit(view.send({ type: "close" })))
  // spec/app/inbox/index.md, "Back from a search shows its folder without the search, before Back leaves Inbox"
  const list = try Inbox.Machine
  if (Inbox.canCloseSearch(try list.get())) return Exit.isSuccess(try exit(list.send({ type: "closeSearch" })))
  return false
}
