// spec/inbox/notices.md, "Story: Be told about new mail while the launcher is in the background"; spec/inbox/notices.md, "Story: Open the Inbox or ask about the exact notification I tapped"; spec/shell/navigation.md, "A layer is listed once, closes with its owner or with Back, and holds the phone while open"
import { type Event as NoticesEvent, type MailNotices as NoticesState, type BackgroundStatus, type Watch, type Excerpt, Machine as NoticesMachine, askFailure, type AskFailure } from "../../gen/inbox__notices.effect.vibe"
import { Native } from "../platform/native.vibe"
import { Resident } from "../platform/resident.vibe"
import { Build } from "../platform/build.vibe"
import { GoogleAccounts } from "../account/google.vibe"
import { Navigation } from "../shell/navigation.vibe"
import { Assistant } from "../assistant/assistant.vibe"
import { InboxAccounts } from "./accounts.vibe"
import { Gmail } from "./gmail.vibe"
import { Mailbox } from "./mailbox.vibe"
import { WireBackgroundStatus, WireNoticeTap } from "./wire.schema.vibe"
import { pageVisible } from "./visibility.ts"

const statuses: Record<WireBackgroundStatus["status"], BackgroundStatus> = {
  "web-unavailable": "WebUnavailable", unavailable: "BackgroundUnavailable", disabled: "BackgroundDisabled", waiting: "BackgroundWaiting",
  "watching-new-mail": "WatchingNewMail", "catching-up": "CatchingUp", "history-expired": "HistoryExpired", unsupported: "BackgroundUnsupported",
  retrying: "BackgroundRetrying", "grant-unavailable": "GrantUnavailable", "capacity-reached": "CapacityReached"
}

const ASK_LAYER = "inbox-notice-ask"

/** The background watch of the selected account and the handling of notice taps. */
export service MailNoticesShell {
  readonly changes: Stream.Stream<NoticesState>
  get(): NoticesState!!
  /** Reads the native watch's status again. */
  refreshStatus(): void!!
  /** Handles a captured tap, if one is pending. */
  handleTap(): void!!
  /** Confirms the reviewed question, edited as `question`; returns what went wrong, if anything. */
  confirmAsk(question: string, sensitive: boolean): AskFailure!!
  /** Cancels the question; an explicit dismissal releases it. */
  cancelAsk(explicitDismissal: boolean): void!!
  /** Opens Android's notification settings for Gmail. */
  notificationSettings(): boolean!!
}

/** The notice shell over its machine and the native `AlphaGmail` plugin. */
export const layer = Layer.effect(MailNoticesShell, effect {
  const machine = try NoticesMachine
  const native = try Native
  const resident = try Resident
  const build = try Build
  const google = try GoogleAccounts
  const navigation = try Navigation
  const assistant = try Assistant
  const accounts = try InboxAccounts
  const gmail = try Gmail
  const mailbox = try Mailbox
  const tapRef = try Ref.make<WireNoticeTap | undefined>(undefined)
  const askListed = try Ref.make(false)

  effect function send(event: NoticesEvent) {
    return machine.send(event) catch () => undefined
  }

  effect function readStatus() {
    const raw = native.invoke("AlphaGmail", "status") catch () => undefined
    const status = Schema.decodeUnknownEffect(WireBackgroundStatus)(raw) catch () => undefined
    if (status === undefined) return
    try send({ type: "statusRead", status: statuses[status.status], lastCheck: status.lastSyncAt ?? 0, notificationsAllowed: status.notificationsAllowed !== false, uncertain: status.uncertainNotices ?? 0 })
  }

  effect function pending() {
    const raw = native.invoke("AlphaGmail", "pending") catch () => undefined
    return Schema.decodeUnknownEffect(WireNoticeTap)(raw) catch () => undefined
  }

  effect function watchSelected() {
    const a = try accounts.get()
    const owner = try accounts.owner()
    if (a.selected === "") {
      const s = try machine.get()
      if (s.watched.grant !== "") {
        native.invoke("AlphaGmail", "withdraw", {}) catch () => undefined
        try send({ type: "withdrawWatch", grant: "" })
      }
      return
    }
    if (owner === undefined || owner.organizationId === "" || a.fromDisk) return
    const watch: Watch = { credential: owner.credentialId, grant: a.selected, user: owner.userId, organization: owner.organizationId }
    const s = try machine.get()
    if (s.watched.grant === watch.grant && s.watched.credential === watch.credential) return
    const started = try send({ type: "configure", watch })
    if (started === undefined) return
    const raw = native.invoke("AlphaGmail", "configure", { credentialId: watch.credential, grantId: watch.grant, userId: watch.user, organizationId: watch.organization }) catch () => undefined
    const status = Schema.decodeUnknownEffect(WireBackgroundStatus)(raw) catch () => undefined
    if (status === undefined) try send({ type: "configureRefused" })
    else try send({ type: "configured", status: statuses[status.status] === "WebUnavailable" ? "BackgroundWaiting" : statuses[status.status] })
  }

  effect function handleTap() {
    const s = try machine.get()
    if (!s.available || !pageVisible()) return
    const started = try send({ type: "readPending" })
    if (started === undefined) return
    const tap = try pending()
    const owner = try accounts.owner()
    try Ref.set(tapRef, tap)
    const identity = tap !== undefined && [tap.token, tap.grantId, tap.credentialId, tap.userId, tap.generation].every((v) => v !== undefined && v !== "")
    try send({ type: "acceptPending", evidence: {
      token: tap?.token ?? "", grant: tap?.grantId ?? "", validIdentity: identity,
      sameOwner: owner !== undefined && tap?.credentialId === owner.credentialId && tap?.userId === owner.userId,
      scopeCurrent: pageVisible(), asks: tap?.question === true && tap.messageId !== undefined && tap.threadId !== undefined
    } })
    const admitted = try machine.get()
    if (admitted.tap !== "ReadingGrants" || tap === undefined) return
    try google.reload()
    const rows = try google.list()
    const readable = rows.some((r) => (r.grantId ?? r.connectionId) === tap.grantId && r.grantedCapabilities.includes("google.gmail.triage"))
    const askReady = (try resident.status()) === "running"
    try send({ type: "checkGrants", grants: { scopeCurrent: pageVisible(), readableGrant: readable, askReady } })
    const checked = try machine.get()
    if (checked.tap === "ConsumingTap") {
      const acknowledged = (native.invoke("AlphaGmail", "consume", { token: tap.token }) catch () => undefined) !== undefined
      try send({ type: "finishConsume", consumed: { acknowledged, scopeCurrent: pageVisible(), composed: false } })
      if ((try machine.get()).tap === "OpenedList") try openList(tap.grantId ?? "")
      return
    }
    if (checked.tap !== "ReadingMail") return
    const read = gmail.read(tap.grantId ?? "", tap.messageId ?? "") catch () => undefined
    const exact = read !== undefined && read.id === tap.messageId && read.threadId === tap.threadId
    const excerpt: Excerpt = read === undefined ? { message: "", thread: "", revision: "", subject: "", snippet: "" } : { message: read.id, thread: read.threadId, revision: read.historyId, subject: read.subject, snippet: read.snippet }
    try send({ type: "openAsk", mail: { scopeCurrent: pageVisible(), reply: read === undefined ? "UnavailableMail" : exact ? "ExactMail" : "WrongMail", reviewable: excerpt.subject !== "" || excerpt.snippet !== "", excerpt } })
    if ((try machine.get()).tap === "OpenedList") try openList(tap.grantId ?? "")
  }

  effect function openList(grant: string) {
    try accounts.refresh()
    try accounts.choose(grant)
    try mailbox.setFolder("InboxFolder")
    try mailbox.search("")
    try navigation.open("inbox")
  }

  if (build.info.variant !== "browser" && (try native.available("AlphaGmail"))) {
    try send({ type: "nativeReady" })
    try readStatus()
    fork.scoped (effect {
      for try (const _ of native.listen("AlphaGmail", "pendingMail")) {
        try handleTap()
      }
    })
    fork.scoped (effect {
      for try (const _ of accounts.changes) {
        try watchSelected()
      }
    })
    fork.scoped (effect {
      for try (const s of machine.changes) {
        const reviewing = (s.tap === "ReviewingAsk" || s.tap === "RecheckingAsk") && !s.canceled
        const listed = try Ref.get(askListed)
        if (reviewing && !listed) try Ref.set(askListed, try navigation.openLayer(ASK_LAYER, "SheetLayer", true))
        else if (!reviewing && listed) {
          try Ref.set(askListed, false)
          try navigation.closeLayer(ASK_LAYER)
        }
      }
    })
    fork.scoped (effect {
      for try (const _ of navigation.changes) {
        if (!(try Ref.get(askListed)) || (try navigation.get()).layers.some((l) => l.id === ASK_LAYER)) continue
        try Ref.set(askListed, false)
        const tap = (try machine.get()).tap
        if (tap === "ReviewingAsk" || tap === "RecheckingAsk") try send({ type: "cancelAsk", explicitDismissal: false })
      }
    })
  }

  return {
    changes: machine.changes,
    get: () => machine.get(),
    refreshStatus: readStatus,
    handleTap,
    effect confirmAsk(question: string, sensitive: boolean) {
      const tap = try Ref.get(tapRef)
      const safe = question.trim() !== "" && !sensitive
      try send({ type: "confirmAsk", scopeCurrent: pageVisible(), safeQuestion: safe })
      const s = try machine.get()
      if (s.tap !== "RecheckingAsk" || tap === undefined) return askFailure(true, s)
      const again = try pending()
      const fresh = gmail.read(tap.grantId ?? "", tap.messageId ?? "") catch () => undefined
      const freshExcerpt: Excerpt = fresh === undefined ? { message: "", thread: "", revision: "", subject: "", snippet: "" } : { message: fresh.id, thread: fresh.threadId, revision: fresh.historyId, subject: fresh.subject, snippet: fresh.snippet }
      try send({ type: "finishRecheck", scopeCurrent: pageVisible(), question: { sameToken: again?.token === tap.token && again?.question === true, sameGeneration: again?.generation === tap.generation, fresh: freshExcerpt } })
      if ((try machine.get()).tap !== "ConsumingTap") return askFailure(true, try machine.get())
      const acknowledged = (native.invoke("AlphaGmail", "consume", { token: tap.token }) catch () => undefined) !== undefined
      let composed = false
      if (acknowledged && pageVisible()) {
        try assistant.openWith(question.trim())
        composed = true
      }
      try send({ type: "finishConsume", consumed: { acknowledged, scopeCurrent: pageVisible(), composed } })
      return askFailure(true, try machine.get())
    },
    effect cancelAsk(explicitDismissal: boolean) {
      const tap = try Ref.get(tapRef)
      const done = try send({ type: "cancelAsk", explicitDismissal })
      if (done !== undefined && explicitDismissal && tap?.token !== undefined) native.invoke("AlphaGmail", "releaseQuestion", { token: tap.token }) catch () => undefined
    },
    effect notificationSettings() {
      return (native.invoke("AlphaGmail", "notificationSettings") catch () => undefined) !== undefined
    }
  }
})
