// spec/inbox/agentDrafts.md, "Story: Send an email the agent drafted for me, after I check it"
import { type Event as CardsEvent, type AgentDrafts, type EmailCard, type SendOutcome, Machine as CardsMachine, offerAccepted, cardOf } from "../../gen/inbox__agentDrafts.effect.vibe"
import { canonicalUuid } from "@elizaos/plugin-inbox/mailbox"
import { InboxAccounts } from "./accounts.vibe"
import { MailOperations } from "./operations.vibe"
import { Machine as JournalMachine } from "../../gen/inbox__operations.effect.vibe"
import { WireEmailOffer } from "./wire.schema.vibe"
import { addressKey, literalMailAddress, versionRequestId } from "./text.ts"

/** A finished agent turn as the chat sees it. */
export interface AgentTurn {
  readonly conversation: string
  readonly current: boolean
  readonly actionResults: readonly unknown[]
}

const ownerWords = new Set(["self", "me", "myself"])

/** The draft the local composer gets from the card, as its operation reviews it. */
function cardFields(card: EmailCard) {
  return {
    mode: "ComposeMail" as const, toList: card.recipients, ccList: [], bccList: [], subject: card.subject, body: card.body,
    files: [], forwardMessage: "", forwardHistory: "", forwardParts: [], replyMessage: ""
  }
}

/** Email cards the agent drafted in chat, kept with their conversation and account. */
export service AgentEmails {
  readonly changes: Stream.Stream<AgentDrafts>
  get(): AgentDrafts!!
  /** Stages the one valid email offer of a turn, if it has exactly one. */
  stage(turn: AgentTurn): boolean!!
  /** One edit of a card, exactly as typed. */
  edit(messageId: string, revision: number, recipients: string[], subject: string, body: string): boolean!!
  /** Declines a card; it stays in the conversation, unsent. */
  decline(messageId: string): boolean!!
  /** Sends a card once under the account it was drafted for. */
  send(messageId: string): SendOutcome | "refused"!!
}

/** The card shell over its stored machine and the reviewed operations of the card's account. */
export const layer = Layer.effect(AgentEmails, effect {
  const machine = try CardsMachine
  const journal = try JournalMachine
  const accounts = try InboxAccounts
  const operations = try MailOperations

  effect function send(event: CardsEvent) {
    return machine.send(event) catch () => undefined
  }

  return {
    changes: machine.changes,
    get: () => machine.get(),
    effect stage(turn: AgentTurn) {
      const offers: unknown[] = []
      for (const result of turn.actionResults) {
        const r = result as { success?: unknown; values?: { mode?: unknown; targetId?: unknown; emailDraft?: unknown } }
        if (r?.success === true && r.values?.mode === "local-compose" && r.values?.targetId === "inbox") offers.push(r.values.emailDraft)
      }
      const decoded = offers.length === 1 ? (Schema.decodeUnknownEffect(WireEmailOffer)(offers[0]) catch () => undefined) : undefined
      const valid = decoded !== undefined && canonicalUuid(decoded.requestMessageId) && decoded.to.length >= 1 && decoded.to.length <= 20
        && decoded.to.every((t) => t.trim() !== "" && t.length <= 254 && !/[\r\n]/.test(t)) && decoded.subject.length <= 998 && !/[\r\n]/.test(decoded.subject)
        && decoded.body.trim() !== "" && decoded.body.length <= 64000
      if (!offerAccepted(offers.length, valid) || decoded === undefined) return false
      const a = try accounts.get()
      const sender = (try journal.get()).capabilities.sender
      const literal = decoded.to.every((t) => !ownerWords.has(t.trim().toLowerCase()))
      const recipients = decoded.to.map((t) => ownerWords.has(t.trim().toLowerCase()) && sender !== "" ? sender : t.trim())
      const card: EmailCard = {
        messageId: decoded.requestMessageId.toLowerCase(), conversation: turn.conversation, grant: a.selected, sender, recipients,
        literalTo: literal, subject: decoded.subject, body: decoded.body, phase: "CardDraft", revision: 1, version: 1
      }
      return (try send({ type: "stage", card, inTurn: turn.current })) !== undefined
    },
    effect edit(messageId: string, revision: number, recipients: string[], subject: string, body: string) {
      return (try send({ type: "editCard", messageId, revision, recipients, subject, body })) !== undefined
    },
    effect decline(messageId: string) {
      return (try send({ type: "decline", messageId })) !== undefined
    },
    effect send(messageId: string) {
      const s = try machine.get()
      const card = cardOf(s, messageId)
      const a = try accounts.get()
      const unique = [...new Set(card.recipients.map(addressKey))]
      const literal = unique.length === card.recipients.length && card.recipients.every(literalMailAddress)
      const started = try send({ type: "beginSend", messageId, revision: card.revision, literalRecipients: literal, sameAccount: a.selected === card.grant && a.selected !== "" })
      if (started === undefined) return "refused"
      const requestId = card.version === 1 ? card.messageId
        : try tryPromise({ try: () => versionRequestId([card.messageId, card.grant, card.sender, card.version, card.recipients, card.subject, card.body]), catch: () => "refused" as const })
      const draftId = `agent-email:${card.messageId}`
      const proposal = { tag: "MessageProposal" as const, mail: cardFields(card), draftId: "", expectedDigest: "" }
      const composer = { draftId, content: JSON.stringify(cardFields(card)) }
      const prepared = try operations.prepare("SendKind", proposal, composer, { localDraft: draftId, revision: card.version, gmailDraft: "", gmailDigest: "" }, requestId)
      const outcome = prepared === undefined ? try operations.confirm(composer) : prepared
      const settled: SendOutcome = outcome === "Sent" ? "OutcomeSent" : outcome === "Rejected" ? "OutcomeRejected" : outcome === "Unsent" || outcome === "Refused" || outcome === "Discarded" || outcome === "SignedOut" ? "OutcomeUnsent" : "OutcomeUncertain"
      try send({ type: "sendSettled", messageId, outcome: settled })
      return settled
    }
  }
})
