// spec/inbox/drafts.md, "A draft the previous version kept comes into its account's Drafts once, and the previous slots clear only after every draft is kept"; spec/inbox/operations.md, "An operation the previous version recorded stays the account's operation until its receipt settles"
import { WireProviderResult, WireReview } from "./wire.schema.vibe"

/** One slot answer of `ElizaSecureStore.get`. */
export schema PreviousSlot {
  value?: string | null
}

/** An attachment the previous version kept with a draft: its name, type and bytes. */
export schema PreviousAttachment {
  name: string
  mimeType: string
  dataBase64: string
}

/** A forwarded original the previous version bound to a draft. */
export schema PreviousForwardPart {
  partId: string
  name: string
  mimeType: string
  size: number
}

/** The message and revision a previous forward was bound to, with its originals. */
export schema PreviousForward {
  messageId: string
  historyId: string
  parts: PreviousForwardPart[]
}

/** The message a previous reply answered. */
export schema PreviousReply {
  messageId: string
  threadId: string
}

/** The Gmail draft a previous local draft was bound to. */
export schema PreviousProvider {
  draftId: string
  providerDigest: string
}

/** One local draft as the previous version kept it. */
export schema PreviousDraft {
  version: number
  id: string
  revision: string
  owner: string
  to: string[]
  cc?: string[]
  bcc?: string[]
  attachments?: PreviousAttachment[]
  forward?: PreviousForward
  provider?: PreviousProvider
  subject: string
  body: string
  mode?: "compose" | "reply" | "reply-all" | "forward"
  reply?: PreviousReply
  earlierThanSent?: boolean
}

/** One set-aside row of the previous Drafts shelf: the draft and its half-typed address. */
export schema PreviousShelfRow {
  draft: PreviousDraft
  toQ: string
}

/** The previous Drafts shelf of one account. */
export schema PreviousShelf {
  version: number
  owner: string
  items: PreviousShelfRow[]
}

/** The previous recovery copy's envelope: its binding and the encoded copy. */
export schema PreviousRecoveryEnvelope {
  version: number
  binding: string
  revision: string
  text: string
}

/** The previous recovery copy of the email being edited. */
export schema PreviousRecovery {
  version: number
  owner: string
  baseRevision: string | null
  draft: PreviousDraft
  toQ: string
}

/** An attachment of a previous operation's proposal. */
export schema PreviousProposalFile {
  name: string
  mimeType: string
  dataBase64: string
}

/** The originals a previous forward proposal named. */
export schema PreviousProposalForward {
  messageId: string
  historyId: string
  partIds: string[]
}

/** A previous operation's proposal, as managed Gmail took it. */
export schema PreviousProposal {
  kind: "send" | "draft-create" | "draft-replace" | "draft-delete" | "archive" | "unarchive" | "trash" | "untrash" | "mark-read" | "mark-unread" | "star" | "unstar"
  mode?: "compose" | "reply" | "reply-all" | "forward"
  to?: string[]
  cc?: string[]
  bcc?: string[]
  subject?: string
  bodyText?: string
  attachments?: PreviousProposalFile[]
  forwardAttachments?: PreviousProposalForward
  replyMessageId?: string
  draftId?: string
  expectedDigest?: string
  messageId?: string
  expectedHistoryId?: string
}

/** A previous operation's receipt, as managed Gmail answered it; its provider result is read with the receipt's own wire schema. */
export schema PreviousReceipt {
  requestId: string
  kind: "send" | "draft-create" | "draft-replace" | "draft-delete" | "archive" | "unarchive" | "trash" | "untrash" | "mark-read" | "mark-unread" | "star" | "unstar"
  reviewDigest: string
  state: "prepared" | "dispatched" | "succeeded" | "rejected" | "outcome-unknown"
  rejectionCode?: string | null
}

/** The Gmail draft a previous send was made from. */
export schema PreviousOperationProvider {
  draftId: string
  providerDigest: string
}

/** The local draft a previous send was made from. */
export schema PreviousOperationSource {
  draftId: string
  savedRevision?: string
  providerDraft?: PreviousOperationProvider
}

/** The composer draft a previous send or Gmail draft save was bound to. */
export schema PreviousOperationComposer {
  draftId: string
}

/** The one operation the previous version kept for an account and Gmail grant; its review is read with the review's own wire schema. */
export schema PreviousOperation {
  version: number
  owner: string
  grantId: string
  requestId: string
  proposal: PreviousProposal
  phase: "preparing" | "review" | "dispatching" | "observed"
  receipt: PreviousReceipt | null
  source?: PreviousOperationSource
  composer?: PreviousOperationComposer
}

/** Decodes an `ElizaSecureStore.get` answer. */
export const decodePreviousSlot = Schema.decodeUnknownEffect(PreviousSlot)
/** Decodes a previous saved draft from its stored JSON. */
export const decodePreviousDraft = Schema.decodeUnknownEffect(Schema.fromJsonString(PreviousDraft))
/** Decodes a previous Drafts shelf from its stored JSON. */
export const decodePreviousShelf = Schema.decodeUnknownEffect(Schema.fromJsonString(PreviousShelf))
/** Decodes a previous recovery envelope from its stored JSON. */
export const decodePreviousRecoveryEnvelope = Schema.decodeUnknownEffect(Schema.fromJsonString(PreviousRecoveryEnvelope))
/** Decodes a previous recovery copy from its envelope's text. */
export const decodePreviousRecovery = Schema.decodeUnknownEffect(Schema.fromJsonString(PreviousRecovery))
/** Decodes a previous operation record from its stored JSON. */
export const decodePreviousOperation = Schema.decodeUnknownEffect(Schema.fromJsonString(PreviousOperation))

/** The provider result of a previous operation's receipt. */
export schema PreviousAnswerReceipt {
  providerResult?: WireProviderResult | null
}

/** What a previous operation record holds as managed Gmail answered it: its review and its receipt's provider result. */
export schema PreviousAnswers {
  review?: WireReview | null
  receipt?: PreviousAnswerReceipt | null
}

/** Decodes the review and provider result of a previous operation record from its stored JSON. */
export const decodePreviousAnswers = Schema.decodeUnknownEffect(Schema.fromJsonString(PreviousAnswers))
