// spec/inbox/digest.md, "Story: Keep every digest result exactly once, and be told about each once"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { type Event as DigestEvent, type DigestInbox, type DigestEntry, Machine as DigestMachine, inboxSide, rendererScope, pagesPerSync } from "../../gen/inbox__digest.effect.vibe"
import { Native } from "../platform/native.vibe"
import { Resident } from "../platform/resident.vibe"
import { Build } from "../platform/build.vibe"
import { keys } from "./store.vibe"
import { WireDigestPage, WireDigestResult } from "./wire.schema.vibe"
import { newId } from "./text.ts"

/** A kept digest result, exactly as the inbox delivered it. */
export type DigestResult = WireDigestResult

/** The digest results kept on this phone, newest last. */
export service DigestResults {
  readonly changes: Stream.Stream<DigestInbox>
  /** The kept results. */
  history(): DigestResult[]!!
  /** Reads and keeps new results, acknowledging each page after it is kept; returns the kept results. */
  sync(sessionId: string): DigestResult[]!!
}

/** The digest inbox over its machine, the resident's result inbox and, on a verified Android binding, the native inbox. */
export const layer = Layer.effect(DigestResults, effect {
  const machine = try DigestMachine
  const store = try KeyValueStore.KeyValueStore
  const native = try Native
  const resident = try Resident
  const build = try Build
  const android = build.info.variant !== "browser"
  const side = inboxSide(android, android && (try native.available("AlphaHostedResults")))
  const scope = rendererScope(android)

  effect function send(event: DigestEvent) {
    return machine.send(event) catch () => undefined
  }

  effect function readRow(runId: string) {
    const text = store.get(keys.digestResult(scope, runId)) catch () => undefined
    if (text === undefined) return undefined
    const parsed = Effect.try(() => JSON.parse(text) as unknown) catch () => undefined
    return Schema.decodeUnknownEffect(WireDigestResult)(parsed) catch () => undefined
  }

  effect function nativeEntries(method: "syncInbox" | "inboxHistory", sessionId: string) {
    const raw = native.invoke("AlphaHostedResults", method, { sessionId }) catch () => undefined
    const page = Schema.decodeUnknownEffect(WireDigestPage)(raw) catch () => undefined
    return page?.entries ?? []
  }

  effect function history() {
    const s = try machine.get()
    const rows: DigestResult[] = []
    for (const id of s.ids) {
      const row = try readRow(id)
      if (row !== undefined) rows.push(row)
    }
    return rows
  }

  effect function postNotices() {
    const s = try machine.get()
    for (const runId of s.pendingNotices) {
      const row = try readRow(runId)
      if (row === undefined) continue
      const posted = (native.invoke("AlphaHostedResults", "postResultNotice", { runId: row.runId, workflowId: row.workflowId, status: row.status }) catch () => undefined) !== undefined
      if (posted || !(try native.available("AlphaHostedResults"))) try send({ type: "noticePosted", runId })
    }
  }

  effect function renderSync() {
    const s = try machine.get()
    for (const runId of s.pendingRemoval) store.remove(keys.digestResult(scope, runId)) catch () => undefined
    const begun = try send({ type: "begin", clientId: s.clientId === "" ? newId() : s.clientId })
    if (begun === undefined) return
    try postNotices()
    for (let page = 0; page < pagesPerSync; page++) {
      const current = try machine.get()
      if (current.phase !== "Fetching") break
      const raw = resident.json("GET", `/api/workflow/hosted/results?clientId=${encodeURIComponent(current.clientId)}`) catch () => undefined
      const decoded = raw === undefined ? undefined : (Schema.decodeUnknownEffect(WireDigestPage)(raw.data) catch () => undefined)
      if (decoded === undefined || decoded.entries.length > 50) {
        try send({ type: "stopped", failure: "DigestUnavailable" })
        break
      }
      let identical = true
      for (const entry of decoded.entries) {
        const existing = try readRow(entry.runId)
        if (existing !== undefined && JSON.stringify(existing) !== JSON.stringify(entry)) identical = false
        else if (existing === undefined) store.set(keys.digestResult(scope, entry.runId), JSON.stringify(entry)) catch () => { identical = false }
      }
      const entries: DigestEntry[] = decoded.entries.map((e) => ({ runId: e.runId, cursor: e.cursor }))
      const after = try send({ type: "receive", entries, identical })
      if (after === undefined || after.phase !== "Acknowledging") break
      try postNotices()
      const last = after.waitingAck
      const acked = (resident.json("POST", "/api/workflow/hosted/results/ack", { clientId: after.clientId, cursor: last.cursor, runId: last.runId }) catch () => undefined) !== undefined
      if (!acked) {
        try send({ type: "stopped", failure: "DigestUnavailable" })
        break
      }
      for (const runId of after.pendingRemoval) store.remove(keys.digestResult(scope, runId)) catch () => undefined
      try send({ type: "acked" })
    }
  }

  return {
    changes: machine.changes,
    effect history() {
      return side === "NativeInbox" ? [] : try history()
    },
    effect sync(sessionId: string) {
      if (side === "NativeInbox") return try nativeEntries("syncInbox", sessionId)
      try renderSync()
      return try history()
    }
  }
})
