// spec/inbox/drafts.md, "Each account has one open draft and a shelf of at most fifty, with distinct ids"; spec/inbox/operations.md, "An account holds at most one operation, and a kind is offered only when the account allows it"; spec/platform/storage.md, "A stored value that is not a state is held for review and never written over"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { DeviceStorage, StorageRefused, heldKeyOf } from "../platform/device-storage.vibe"
import { Native } from "../platform/native.vibe"
import { ownerKey } from "../platform/storage.vibe"

/** The device-wide keys of the Inbox's stored machines; each state keeps every owner's part apart by its owner key. */
export const keys = {
  drafts: ownerKey("device", "inbox/drafts"),
  operations: ownerKey("device", "inbox/operations"),
  savedMail: (owner: string) => ownerKey(owner, "inbox/saved-mail"),
}

schema SlotValue { value?: string | null }

function failure(method: string, key: string, cause: unknown) {
  return new KeyValueStore.KeyValueStoreError({ message: "Secure mail storage refused the request", method, key, cause })
}

const SECURE_STORE = "ElizaSecureStore"
const mailKeys: readonly string[] = [keys.drafts, keys.operations, heldKeyOf(keys.drafts), heldKeyOf(keys.operations)]

/** Drafts and operation records: Android's hardware-backed secure slots where the app has them, the platform's store otherwise. */
export const mailStore = Layer.effect(KeyValueStore.KeyValueStore, effect {
  const native = try Native
  if (!(try native.available(SECURE_STORE))) {
    return try KeyValueStore.KeyValueStore
  }
  const slot = (key: string) => `device:${key}`
  effect function get(key: string) {
    const raw = native.invoke(SECURE_STORE, "get", { key: slot(key) }) catch effect (cause) => { throw failure("get", key, cause) }
    const answer = Schema.decodeUnknownEffect(SlotValue)(raw) catch effect (cause) => { throw failure("get", key, cause) }
    return answer.value ?? undefined
  }
  effect function remove(key: string) {
    native.invoke(SECURE_STORE, "remove", { key: slot(key) }) catch effect (cause) => { throw failure("remove", key, cause) }
  }
  effect function held() {
    const present: string[] = []
    for (const key of mailKeys) {
      if ((try get(key)) !== undefined) present.push(key)
    }
    return present
  }
  return KeyValueStore.makeStringOnly({
    get,
    effect set(key: string, value: string) {
      native.invoke(SECURE_STORE, "set", { key: slot(key), value }) catch effect (cause) => { throw failure("set", key, cause) }
    },
    remove,
    clear: effect {
      for (const key of mailKeys) try remove(key)
    },
    size: effect { return (try held()).length },
    keys: held(),
  })
})

/**
 * DeviceStorage for the mail store's machines: a drafts or operations value that is not a state is kept apart in the mail store
 * itself, so a draft never leaves the secure slots, and the platform's DeviceStorage, where the program provides it, is told it is held.
 */
export const mailHeld = Layer.effect(DeviceStorage, effect {
  const platform = try Effect.serviceOption(DeviceStorage)
  const store = try KeyValueStore.KeyValueStore
  const refused = (message: string) => () => new StorageRefused({ message })
  return {
    changes: Option.isSome(platform) ? platform.value.changes : Stream.empty,
    effect admitStartup() { if (Option.isSome(platform)) try platform.value.admitStartup() },
    effect bindOwner(owner: string) { if (Option.isSome(platform)) try platform.value.bindOwner(owner) },
    effect signedOut() { if (Option.isSome(platform)) try platform.value.signedOut() },
    effect hold(key: string) {
      const copy = heldKeyOf(key)
      const earlier = store.get(copy) catch () => null
      const value = store.get(key) catch () => null
      if (earlier === null || value === null) return false
      if (earlier === undefined && value !== undefined) {
        const copied = store.set(copy, value) catch () => false
        if (copied === false) return false
      }
      return Option.isSome(platform) ? try platform.value.hold(key) : true
    },
    effect held(key: string) {
      const kept = store.get(heldKeyOf(key)) catch () => undefined
      return kept
    },
    effect resolve(key: string) {
      try mapError(store.remove(heldKeyOf(key)), refused("The kept copy could not be removed. Try again."))
      if (Option.isSome(platform)) try platform.value.resolve(key)
    },
    effect reset() {
      if (Option.isNone(platform)) throw new StorageRefused({ message: "Nothing to reset." })
      try platform.value.reset()
    },
  }
})
