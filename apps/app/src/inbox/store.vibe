// spec/inbox/drafts.md, "Each account has one open draft and a shelf of at most fifty, with distinct ids"; spec/inbox/operations.md, "An account holds at most one operation, and a kind is offered only when the account allows it"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { Native } from "../platform/native.vibe"
import { ownerKey } from "../platform/storage.vibe"

/** The device-wide keys of the Inbox's stored machines; each state keeps every owner's part apart by its owner key. */
export const keys = {
  drafts: ownerKey("device", "inbox/drafts"),
  operations: ownerKey("device", "inbox/operations"),
  savedMail: (owner: string) => ownerKey(owner, "inbox/saved-mail"),
}

schema SlotValue { value?: string | null }

function failure(method: string, key: string, cause: unknown) {
  return new KeyValueStore.KeyValueStoreError({ message: "Secure mail storage refused the request", method, key, cause })
}

const SECURE_STORE = "ElizaSecureStore"
const mailKeys: readonly string[] = [keys.drafts, keys.operations]

/** Drafts and operation records: Android's hardware-backed secure slots where the app has them, the platform's store otherwise. */
export const mailStore = Layer.effect(KeyValueStore.KeyValueStore, effect {
  const native = try Native
  if (!(try native.available(SECURE_STORE))) {
    return try KeyValueStore.KeyValueStore
  }
  const slot = (key: string) => `device:${key}`
  effect function get(key: string) {
    const raw = native.invoke(SECURE_STORE, "get", { key: slot(key) }) catch effect (cause) => { throw failure("get", key, cause) }
    const answer = Schema.decodeUnknownEffect(SlotValue)(raw) catch effect (cause) => { throw failure("get", key, cause) }
    return answer.value ?? undefined
  }
  effect function remove(key: string) {
    native.invoke(SECURE_STORE, "remove", { key: slot(key) }) catch effect (cause) => { throw failure("remove", key, cause) }
  }
  effect function held() {
    const present: string[] = []
    for (const key of mailKeys) {
      if ((try get(key)) !== undefined) present.push(key)
    }
    return present
  }
  return KeyValueStore.makeStringOnly({
    get,
    effect set(key: string, value: string) {
      native.invoke(SECURE_STORE, "set", { key: slot(key), value }) catch effect (cause) => { throw failure("set", key, cause) }
    },
    remove,
    clear: effect {
      for (const key of mailKeys) try remove(key)
    },
    size: effect { return (try held()).length },
    keys: held(),
  })
})
