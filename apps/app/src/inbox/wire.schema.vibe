// spec/inbox/operations.md, "Gmail's review must match the proposal exactly and come with a prepared receipt"; spec/inbox/notices.md, "The watch's status says what it can promise, from the native side's own report"; spec/inbox/digest.md, "A page is kept only whole and in order, and acknowledged only after it is kept"; spec/inbox/agentDrafts.md, "A turn offers at most one email card, staged once for its conversation"

/** What a provider result of a succeeded receipt may name. */
export schema WireProviderResult {
  messageId?: string
  historyId?: string | null
  draftId?: string
  providerDigest?: string
  unread?: boolean
}

/** A reviewed attachment line of a Gmail review. */
export schema WireReviewedFile {
  name: string
  mimeType?: string
  size: number
  sha256: string
  partId?: string
}

/** The review managed Gmail answers a prepared operation with. */
export schema WireReview {
  kind: string
  from: string
  to?: string[]
  cc?: string[]
  bcc?: string[]
  subject?: string
  mode?: string
  bodyText?: string
  replyMessageId?: string
  draftId?: string
  expectedDigest?: string
  messageId?: string
  expectedHistoryId?: string
  attachments?: WireReviewedFile[]
  forwardedAttachments?: WireReviewedFile[]
  forwardSource?: WireForwardSource
}

/** The source message a reviewed forward binds its original parts to. */
export schema WireForwardSource {
  messageId: string
  historyId: string
}

/** `AlphaGmail.status()`: the native watch's own report. */
export schema WireBackgroundStatus {
  status: "web-unavailable" | "unavailable" | "disabled" | "waiting" | "watching-new-mail" | "catching-up" | "history-expired" | "unsupported" | "retrying" | "grant-unavailable" | "capacity-reached"
  lastSyncAt?: number
  incompleteCatchup?: boolean
  uncertainNotices?: number
  deniedNotices?: number
  notificationsAllowed?: boolean
  grantId?: string
}

/** `AlphaGmail.pending()`: a captured notice tap, or nothing. */
export schema WireNoticeTap {
  token?: string
  grantId?: string
  credentialId?: string
  userId?: string
  generation?: string
  question?: boolean
  messageId?: string
  threadId?: string
}

/** One digest result as the resident's result inbox pages it. */
export schema WireDigestResult {
  cursor: number
  runId: string
  workflowId: string
  workflowVersionId: string
  templateVersion: string
  scheduledAt: string
  source: unknown
  status: string
  startedAt: string
  completedAt: string
  output: unknown
  error: string | null
}

/** `GET /api/workflow/hosted/results`. */
export schema WireDigestPage {
  entries: WireDigestResult[]
}

/** An agent email offer: the draft a local-compose message action carries for the Inbox. */
export schema WireEmailOffer {
  version: 1
  requestMessageId: string
  to: string[]
  subject: string
  body: string
}

/** `AlphaMailAttachments.openReviewed` and `saveReviewed`: what Android or the browser confirms. */
export schema WireHandoffResult {
  status: string
  message?: string
}
