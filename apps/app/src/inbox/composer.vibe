// spec/app/inbox/drafts.md, "Story: Write a message"; spec/app/inbox/drafts.md, "Story: Keep my draft on the phone"; spec/app/inbox/drafts.md, "Story: Set a draft aside or discard it"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Inbox from "../../gen/app__inbox.effect.vibe"
import * as Drafts from "../../gen/app__inbox__drafts.effect.vibe"
import { Machine as Changes } from "../../gen/app__inbox__sending.effect.vibe"
import type { Composer, Effect as Out, Event } from "../../gen/app__inbox__drafts.effect.vibe"
import type { Kind, Policy } from "../../gen/app__inbox__letter.ts"
import type { Actor } from "../../gen/app__inbox__access.ts"
import { CloudError } from "@elizaos/cloud"
import type { GmailDraftContent } from "@elizaos/plugin-inbox-client"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { Cloud } from "../platform/cloud.vibe"
import { Device } from "../platform/device.vibe"
import { type Job, answer, contained, due, reacting, run, started, together, untimed } from "../runtime/reactor.vibe"
import { Mail, asked } from "./gmail.vibe"
import { ownerChanges } from "./mailbox.vibe"
import { provider } from "./provider.vibe"

module pure {
  /** A file attached to a draft: what Gmail is sent, as the owner picked it. */
  export interface Attached {
    readonly name: string
    readonly mimeType: string
    readonly size: number
    readonly data: string
  }

  /** What the owner wrote in one draft, beside the counts the rules keep of it. */
  export interface Words {
    readonly to: ReadonlyArray<string>
    readonly cc: ReadonlyArray<string>
    readonly bcc: ReadonlyArray<string>
    readonly pending?: Readonly<Record<"to" | "cc" | "bcc", string>>
    readonly subject: string
    readonly text: string
    readonly files: ReadonlyArray<Attached>
    /** The Gmail message a reply or a forward answers. */
    readonly answers: string | undefined
    /** How Gmail is asked to send it. */
    readonly mode: "compose" | "reply" | "reply-all" | "forward"
  }

  /** The drafts kept under `text`, or none where nothing readable is kept. @throws {never} */
  export function readWords(text: string | undefined): Record<string, Words> | undefined {
    if (text === undefined) return undefined
    try {
      const found = JSON.parse(text) as unknown
      return found !== null && typeof found === "object" && !Array.isArray(found) ? found as Record<string, Words> : undefined
    } catch { return undefined }
  }

  /** Whether `address` is one Gmail accepts: one mailbox, written whole. @throws {never} */
  export function acceptable(address: string): boolean {
    return /^[^\s@<>,;"]+@[^\s@<>,;"]+\.[^\s@<>,;"]+$/u.test(address)
  }

  /** Whether a storage write failed because browser storage quota was exceeded. @throws {never} */
  export function isQuotaError(cause: unknown): boolean {
    if (typeof DOMException !== "undefined" && cause instanceof DOMException) {
      return cause.name === "QuotaExceededError" || cause.name === "NS_ERROR_DOM_QUOTA_REACHED"
    }
    if (typeof cause === "object" && cause !== null) {
      const record = cause as { name?: unknown; message?: unknown; cause?: unknown }
      if (record.name === "QuotaExceededError" || record.name === "NS_ERROR_DOM_QUOTA_REACHED") return true
      if (typeof record.message === "string" && /quota/iu.test(record.message)) return true
      if (record.cause !== undefined && record.cause !== cause) return isQuotaError(record.cause)
    }
    return false
  }

  /** Parse one draft record kept under its own storage key. @throws {never} */
  export function readOneWords(text: string | undefined): Words | undefined {
    if (text === undefined) return undefined
    try {
      const found = JSON.parse(text) as unknown
      return found !== null && typeof found === "object" && !Array.isArray(found) ? found as Words : undefined
    } catch { return undefined }
  }

  /** Parse the list of stored draft IDs. @throws {never} */
  export function readDraftIds(text: string | undefined): string[] | undefined {
    if (text === undefined) return undefined
    try {
      const found = JSON.parse(text) as unknown
      return Array.isArray(found) && found.every((one): one is string => typeof one === "string") ? found : undefined
    } catch { return undefined }
  }
}
import { type Attached, type Words, acceptable, isQuotaError, readDraftIds, readOneWords, readWords } from pure
export { type Attached, type Words, acceptable }

/** A draft with nothing written yet. */
export const nothing: Words = { to: [], cc: [], bcc: [], subject: "", text: "", files: [], answers: undefined, mode: "compose" }

/** What an account may attach until the cloud reports its own limits: ten files, five MiB in all. */
export const policy: Policy = { files: 10, mib: 5 }

const key = "alpha/inbox/letters"
const draftKeyPrefix = "alpha/inbox/letter/"
const draftIdsKey = "alpha/inbox/letter-ids"
const copyKey = "alpha/inbox/gmail-draft-copies"
const SavedWords = Schema.Struct({
  to: Schema.Array(Schema.String), cc: Schema.Array(Schema.String), bcc: Schema.Array(Schema.String),
  subject: Schema.String, text: Schema.String,
})
const SeenSchema = Schema.Struct({ digest: Schema.String, words: Schema.optionalKey(SavedWords) })
const CopySchema = Schema.Struct({ account: Schema.Number, id: Schema.String, digest: Schema.String, seen: Schema.optionalKey(SeenSchema) })
type Copy = typeof CopySchema.Type
type Seen = typeof SeenSchema.Type
const readCopies = Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Array(CopySchema)))

/**
 * The words of each draft of this session, by its number: what the screen shows and edits, what a write keeps on the
 * phone, and what a send carries. The rules keep only their counts and revisions.
 */
export service Letters {
  words(draft: number): Words
  set(draft: number, words: Words): void
  subscribe(listener: () => void): () => void
  version(): number
  /** Write the words of `draft` to the phone; whether the phone kept them. */
  keep(draft: number): boolean!!
  /** Write the words of `draft` to the phone, distinguishing quota exhaustion. */
  keepDraft(draft: number): { readonly ok: boolean; readonly full: boolean }!!
  /** Read back what the phone kept; whether it could be read. */
  load(): boolean!!
  forget(draft: number): void!!
  clear(): void!!
  /** Gmail's copy of a draft, by the number the rules know it by: its draft id and the digest Gmail holds it at. */
  copy(gmail: number): Copy | undefined
  knownCopy(account: number, id: string): number
  /** Number Gmail's copy `id`, saved at `digest`. */
  copied(account: number, id: string, digest: string): number
  observed(gmail: number, seen: Seen): void
  keepObserved(gmail: number): void
}

export const letters = Layer.effect(Letters, effect {
  const store = try KeyValueStore.KeyValueStore
  let held: Record<string, Words> = readWords(store.get(key) catch () => undefined) ?? {}
  const initialIds = readDraftIds(store.get(draftIdsKey) catch () => undefined) ?? []
  for (const id of initialIds) {
    const one = readOneWords(store.get(`${draftKeyPrefix}${id}`) catch () => undefined)
    if (one !== undefined) held = { ...held, [id]: one }
  }
  const savedCopies = (store.get(copyKey) catch () => undefined) ?? "[]"
  const copies = [...(readCopies(savedCopies) catch () => [])]
  const knownCopy = (account: number, id: string) => copies.findIndex((copy) => copy.account === account && copy.id === id) + 1
  let copiesChanged = false
  let revision = 0
  const listeners = new Set<() => void>()
  const notify = () => {
    revision += 1
    for (const listener of [...listeners]) listener()
  }
  const writeKey = effect (name: string, value: string): { readonly ok: boolean; readonly full: boolean }!! => {
    const res = try exit(store.set(name, value))
    return Exit.isSuccess(res) ? { ok: true, full: false } : { ok: false, full: isQuotaError(res.cause) }
  }
  const persistCopies = effect () => {
    if (!copiesChanged) return { ok: true, full: false }
    const written = try writeKey(copyKey, JSON.stringify(copies))
    if (written.ok) copiesChanged = false
    return written
  }
  const keepDraft = effect (draft: number) => {
    const copied = try persistCopies()
    if (!copied.ok) return copied
    const id = String(draft)
    const entry = held[id]
    if (entry !== undefined) {
      const wrote = try writeKey(`${draftKeyPrefix}${id}`, JSON.stringify(entry))
      if (!wrote.ok) return wrote
    }
    const ids = Object.keys(held)
    return try writeKey(draftIdsKey, JSON.stringify(ids))
  }
  return {
    words: (draft: number) => held[String(draft)] ?? nothing,
    set(draft: number, words: Words) {
      held = { ...held, [String(draft)]: words }
      notify()
    },
    subscribe(listener: () => void) {
      listeners.add(listener)
      return () => { listeners.delete(listener) }
    },
    version: () => revision,
    effect keep(draft: number) {
      return (try keepDraft(draft)).ok
    },
    keepDraft,
    effect load() {
      const legacyText = store.get(key) catch () => null
      if (legacyText === null) return false
      if (legacyText !== undefined && legacyText !== "") {
        const parsedLegacy = readWords(legacyText)
        if (parsedLegacy === undefined) return false
        held = { ...parsedLegacy, ...held }
      }
      const idsText = store.get(draftIdsKey) catch () => null
      if (idsText === null) return false
      if (idsText !== undefined && idsText !== "") {
        const ids = readDraftIds(idsText)
        if (ids === undefined) return false
        for (const id of ids) {
          const itemText = store.get(`${draftKeyPrefix}${id}`) catch () => null
          if (itemText === null) return false
          if (itemText !== undefined && itemText !== "") {
            const parsed = readOneWords(itemText)
            if (parsed === undefined) return false
            if (!(id in held)) held = { ...held, [id]: parsed }
          }
        }
      }
      notify()
      return true
    },
    effect forget(draft: number) {
      const id = String(draft)
      const { [id]: _gone, ...rest } = held
      held = rest
      notify()
      try ignore(store.remove(`${draftKeyPrefix}${id}`))
      try ignore(store.set(draftIdsKey, JSON.stringify(Object.keys(held))))
      try ignore(persistCopies())
    },
    effect clear() {
      const ids = Object.keys(held)
      held = {}
      copies.length = 0
      copiesChanged = true
      notify()
      for (const id of ids) try ignore(store.remove(`${draftKeyPrefix}${id}`))
      try ignore(store.remove(draftIdsKey))
      try ignore(store.remove(key))
      try ignore(persistCopies())
    },
    copy: (gmail: number) => copies[gmail - 1],
    knownCopy,
    copied(account: number, id: string, digest: string) {
      const same = knownCopy(account, id)
      const at = same === 0 ? copies.length : same - 1
      copies[at] = { account, id, digest }
      copiesChanged = true
      notify()
      return at + 1
    },
    observed(gmail: number, seen: Seen) {
      const copy = copies[gmail - 1]
      if (copy === undefined) return
      copies[gmail - 1] = { ...copy, seen }
      copiesChanged = true
      notify()
    },
    keepObserved(gmail: number) {
      const copy = copies[gmail - 1]
      if (copy?.seen === undefined) return
      copies[gmail - 1] = { account: copy.account, id: copy.id, digest: copy.seen.digest }
      copiesChanged = true
      notify()
    },
  }
})

const copyFailed = (ticket: number): Event => ({ type: "copyRead", ticket, ok: false, found: false, held: 0, gmail: 0 })

/** A draft Alpha can reproduce exactly in its text editor. */
function editableCopy(content: GmailDraftContent): typeof SavedWords.Type | undefined {
  if (content.threaded || !content.plainText || content.attachmentCount > 0 || content.subject.length > 500 || content.bodyText.length > 64_000) return undefined
  const { to, cc, bcc, subject, bodyText } = content
  return { to, cc, bcc, subject, text: bodyText }
}

// spec/app/inbox/drafts.md, "Before a draft with a Gmail copy is saved over it, and whenever the draft is unsure of that copy, Gmail's copy is read, one read at a time, while its account may be read"
effect function lookedUp(ticket: number, draft: number, account: number, gmail: number): Event!!(Cloud | Mail | Letters | Drafts.Machine | Inbox.Machine) {
  const letters = try Letters
  const ledger = try Mail
  const composer = try Drafts.Machine
  const list = try Inbox.Machine
  const cloud = try Cloud
  const grant = ledger.grant(account)
  const before = try composer.get()
  if (grant === undefined) return copyFailed(ticket)
  const isNotFound = (cause: unknown) => cause instanceof CloudError && cause.failure.tag === "CloudRefused" && cause.failure.code === "NotFound"
  const stillValid = effect () => {
    const state = try composer.get()
    return state.session === before.session && state.open && state.letter.id === draft &&
      state.lookup.ticket === ticket && state.lookup.status === "Loading" && state.letter.sending === 0 &&
      grant === ledger.grant(account) && Inbox.accessOf(try list.get(), account).grant.read
  }
  if (gmail === 0) {
    if (!before.letter.unsure) return copyFailed(ticket)
    const listing = provider(cloud).gmailDrafts(grant) catch () => undefined
    if (listing === undefined || !(try stillValid())) return copyFailed(ticket)
    const local = letters.words(draft)
    const sameRecipients = (a: ReadonlyArray<string>, b: ReadonlyArray<string>) =>
      a.length === b.length && a.every((one, at) => one.toLowerCase() === (b[at] ?? "").toLowerCase())
    const matched = listing.drafts.find((one) => one.subject === local.subject && sameRecipients(one.to, local.to))
    if (matched === undefined) return { type: "copyRead", ticket, ok: true, found: false, held: 0, gmail: 0 }
    const content = provider(cloud).gmailDraftContent(grant, matched.draftId) catch () => undefined
    if (content === undefined || !(try stillValid())) return copyFailed(ticket)
    const foundGmail = letters.copied(account, matched.draftId, content.providerDigest)
    const base = (try composer.get()).letter.draft.base
    return { type: "copyRead", ticket, ok: true, found: true, held: base, gmail: foundGmail }
  }
  const copy = letters.copy(gmail)
  if (copy?.account !== account) return copyFailed(ticket)
  const read = try exit(provider(cloud).gmailDraftContent(grant, copy.id))
  if (!(try stillValid())) return copyFailed(ticket)
  if (!Exit.isSuccess(read)) {
    const failure = Cause.squash(read.cause)
    return isNotFound(failure) ? { type: "copyRead", ticket, ok: true, found: false, held: 0, gmail: 0 } : copyFailed(ticket)
  }
  const found = read.value
  const state = try composer.get()
  const base = state.letter.draft.base
  if (found.providerDigest === copy.digest) return { type: "copyRead", ticket, ok: true, found: true, held: base, gmail }
  const words = editableCopy(found)
  letters.observed(gmail, words === undefined ? { digest: found.providerDigest } : { digest: found.providerDigest, words })
  return { type: "copyRead", ticket, ok: true, found: true, held: base + 1, gmail }
}

// spec/app/inbox/drafts.md, "On a clash the owner chooses Restore my edits or Use latest saved draft, is told which was kept, and the choice is written to the phone"
export effect function restoreMyEdits(): void!!(Drafts.Machine | Letters) {
  const composer = try Drafts.Machine
  const letters = try Letters
  const state = try composer.get()
  const gmail = state.letter.gmail
  if (!Drafts.canRestoreMine(state) || letters.copy(gmail)?.seen === undefined) return
  letters.keepObserved(gmail)
  try ignore(exit(composer.send({ type: "restoreMine" }, "Owner")))
}

/** How the remote draft's addresses are counted by the composer. */
export function choiceOf(copy: Copy | undefined): Event | undefined {
  const words = copy?.seen?.words
  if (words === undefined) return undefined
  return { type: "useSaved", ...addressCounts(words), intact: true }
}

function addressCounts(words: Pick<Words, "to" | "cc" | "bcc">) {
  const recipients = [...words.to, ...words.cc, ...words.bcc]
  return { recipients: recipients.length, invalid: recipients.filter((one) => !acceptable(one)).length }
}

// spec/app/inbox/drafts.md, "On a clash the owner chooses Restore my edits or Use latest saved draft, is told which was kept, and the choice is written to the phone"
export effect function useLatestSavedDraft(): void!!(Drafts.Machine | Letters) {
  const composer = try Drafts.Machine
  const letters = try Letters
  const state = try composer.get()
  const { gmail, id } = state.letter
  const copy = letters.copy(gmail)
  const words = copy?.seen?.words
  const chosen = choiceOf(copy)
  if (words === undefined || chosen?.type !== "useSaved" || !Drafts.canUseSaved(state, chosen.recipients, chosen.invalid, chosen.intact)) return
  letters.set(id, { ...nothing, ...words })
  letters.keepObserved(gmail)
  try ignore(exit(composer.send(chosen, "Owner")))
}

// spec/app/inbox/drafts.md, "A draft from Gmail's Drafts opens only with no draft open and none set aside that holds it, and only when Alpha can open it whole; otherwise the owner is offered Open in Gmail"
/** Open the provider draft from the active account and Drafts view. */
export effect function openGmailDraft(account: number, id: string): boolean!!(Cloud | Mail | Letters | Inbox.Machine | Drafts.Machine | Shell) {
  const ledger = try Mail
  const letters = try Letters
  const composer = try Drafts.Machine
  const list = try Inbox.Machine
  const shell = try Shell
  const before = try list.get()
  const draft = try composer.get()
  const access = Inbox.accessOf(before, account)
  const grant = ledger.grant(account)
  if (before.selected.account !== account || before.selected.folder !== "DraftsFolder" || before.saved || !access.grant.read ||
    grant === undefined || !Drafts.free(draft) || !showing(try shell.get(), "Inbox")) return false
  const known = letters.knownCopy(account, id)
  const aside = known === 0 ? undefined : draft.shelf.shelved.find((number) => Drafts.letterNamed(draft, number).gmail === known)
  if (aside !== undefined) return Exit.isSuccess(try exit(composer.send({ type: "resume", draft: aside }, "Owner")))

  const generation = ledger.generation(account)
  const found = provider(try Cloud).gmailDraftContent(grant, id) catch () => undefined
  const now = try list.get()
  const state = try composer.get()
  if (found === undefined || generation !== ledger.generation(account) || before.revision !== now.revision ||
    now.selected.account !== account || now.selected.folder !== "DraftsFolder" || state.session !== draft.session ||
    !Drafts.free(state) || !showing(try shell.get(), "Inbox")) return false

  const content = editableCopy(found)
  const gmail = letters.copied(account, id, found.providerDigest)
  const event = { type: "editSaved", access: Inbox.accessOf(now, account), account, gmail, held: 1, intact: content !== undefined, ...addressCounts(content ?? nothing) } as const
  if (!Drafts.canEditSaved(state, event.access, account, gmail, event.held, event.recipients, event.invalid)) return false
  if (content !== undefined) letters.set(state.made + 1, { ...nothing, ...content })
  return Exit.isSuccess(try exit(composer.send(event, "Owner"))) && content !== undefined
}

// spec/app/inbox/drafts.md, "A send found in Gmail's Sent counts as sent and is a change to what the draft shows; one not found is known not to have gone"
/** Whether Gmail's Sent holds the draft: a message to its first recipient with its subject. */
effect function inSent(ticket: number, draft: number, account: number): Event!!(Cloud | Mail | Letters) {
  const { client } = try Cloud
  const ledger = try Mail
  const words = (try Letters).words(draft)
  const grant = ledger.grant(account)
  if (grant === undefined) return { type: "checkedSent", ticket, ok: false, found: false }
  const recipient = [...words.to, ...words.cc, ...words.bcc].find((one) => one.trim() !== "")
  return effect {
    const recipientClause = recipient === undefined ? "" : ` to:${recipient}`
    const query = `in:sent${recipientClause} subject:"${words.subject.replace(/"/gu, "")}"`
    const found = try asked(() => client.gmailSearch({ grantId: grant, query, maxResults: 5 }))
    return { type: "checkedSent", ticket, ok: true, found: found.messages.some((card) => card.subject === words.subject) }
  } catch () => ({ type: "checkedSent", ticket, ok: false, found: false })
}

effect function written(ticket: number, draft: number): Event!!Letters {
  const result = try (try Letters).keepDraft(draft)
  return { type: "written", ticket, ok: result.ok, full: result.full }
}

effect function loaded(ticket: number): Event!!Letters {
  const ok = try (try Letters).load()
  return { type: "loaded", ticket, ok }
}

const keptAside = (draft: number) => effect { try ignore((try Letters).keep(draft)) }
const forgotten = (draft: number) => effect { try (try Letters).forget(draft) }

function carry(fx: Out): Job<Event, Cloud | Mail | Letters | Drafts.Machine | Inbox.Machine, [by: Actor]> {
  return match (fx) {
    // spec/app/inbox/drafts.md, "A write goes out only when none is in flight, under the newest ticket, carrying the draft as it is"
    when { tag: "Keep", let ticket, let draft }:
      answer("keep", written(ticket, draft), { type: "written", ticket, ok: false, full: false }, "World");
    when { tag: "KeepAside", let draft }: run("aside", keptAside(draft), "World");
    // spec/app/inbox/drafts.md, "A restart reopens the draft as last kept on the phone once the phone's drafts have loaded; a save, a send or a deletion handed over is ended by its operation"
    when { tag: "Load", let ticket }:
      answer("load", loaded(ticket), { type: "loaded", ticket, ok: false }, "World");
    when { tag: "ReadCopy", let ticket, let draft, let account, let gmail }:
      answer("copy", lookedUp(ticket, draft, account, gmail), copyFailed(ticket), "World");
    when { tag: "ReadSent", let ticket, let draft, let account }:
      answer("sent", inSent(ticket, draft, account), { type: "checkedSent", ticket, ok: false, found: false }, "World");
    when { tag: "Forget", let draft }: run("forget", forgotten(draft), "World");
  }
}

// spec/app/inbox/drafts.md, "Edits are written to the phone once typing pauses, and no later than the longest wait after a burst began, one write at a time under its own ticket"
const timers = (s: Composer) => (s.pending ? [due("write", s.due, { type: "writeDue", now: untimed } as Event, "World" as Actor)] : [])

// spec/app/inbox/drafts.md, "Leaving Alpha writes the waiting edits at once, or as soon as the write in flight lands"
const leaving = started(effect {
  const device = try Device
  try Stream.runForEach(device.visible, effect (visible) => {
    if (!visible) try contained((try Drafts.Machine).send({ type: "leave" }, "World"), "leaving Alpha")
  })
}, "leaving Alpha")

// spec/app/inbox/drafts.md, "A new cloud session shows none of the drafts of the one before"
const sessions = started(effect {
  const composer = try Drafts.Machine
  const words = try Letters
  try Stream.runForEach(ownerChanges, effect () => {
    try words.clear()
    try contained(composer.send({ type: "sessionChanged" }, "World"), "a new cloud session")
  })
}, "a new cloud session")

/** How a draft begins, for the screen: a new message, or a reply, reply to all or forward of the message open. */
export interface Beginning {
  readonly kind: Kind
  readonly account: number
  /** The message answered, as Gmail names it, with its sender, other recipients, subject and attachments. */
  readonly message?: { readonly id: string; readonly from: string; readonly others: ReadonlyArray<string>; readonly subject: string; readonly body?: string; readonly files: number }
}

const addressOf = (from: string) => /<([^>]+)>/u.exec(from)?.[1] ?? from.trim()

// spec/app/inbox/drafts.md, "A new message, a reply, a reply to all or a forward begins as [one draft](./letter.md) says; a reply to a message with no usable address is refused and the owner told"
/** Begin a draft as `beginning` says, and give it the words it starts with: its recipients and subject. */
export effect function begin(beginning: Beginning): boolean!!(Drafts.Machine | Letters | Mail) {
  const composer = try Drafts.Machine
  const ledger = try Mail
  const words = try Letters
  const { kind, account, message } = beginning
  const sender = message === undefined ? "" : addressOf(message.from)
  const own = ledger.email(account).toLowerCase()
  const others = message === undefined ? [] : message.others.map(addressOf).filter((one) => one.toLowerCase() !== own && one !== sender)
  const replying = kind === "Reply" || kind === "ReplyAll"
  const event: Event = {
    type: "compose", kind, account, others: kind === "ReplyAll" ? others.length : 0, replyTo: false,
    addressable: acceptable(sender), files: kind === "Forward" ? message?.files ?? 0 : 0, mib: 0, forwardable: false, policy,
  }
  const prefix = replying ? "Re: " : kind === "Forward" ? "Fwd: " : ""
  const subject = message === undefined || message.subject.toLowerCase().startsWith(prefix.toLowerCase()) ? message?.subject ?? "" : `${prefix}${message.subject}`
  const forward = kind === "Forward" && message !== undefined
  const text = forward ? `\n\n---------- Forwarded message ----------\nFrom: ${message.from}\nSubject: ${message.subject}\n\n${message.body ?? ""}` : ""
  const drafted: Words = {
    ...nothing, subject, text, answers: replying ? message?.id : undefined, mode: kind === "Reply" ? "reply" : kind === "ReplyAll" ? "reply-all" : kind === "Forward" ? "forward" : "compose",
    to: replying ? [sender] : [], cc: kind === "ReplyAll" ? others : [],
  }
  const nextId = (try composer.get()).made + 1
  const before = words.words(nextId)
  words.set(nextId, drafted)
  const sent = try exit(composer.send(event, "Owner"))
  if (!Exit.isSuccess(sent) || !sent.value.state.open) {
    words.set(nextId, before)
    return false
  }
  const actual = sent.value.state.letter.id
  if (actual !== nextId) {
    words.set(nextId, before)
    words.set(actual, drafted)
  }
  return true
}

// spec/app/inbox/drafts.md, "A draft is set aside only once it is wholly kept on the phone, and comes back exactly as it was set aside"; spec/app/inbox/drafts.md, "Leaving Alpha writes the waiting edits at once, or as soon as the write in flight lands"
/** Take Back from the draft or its review. Keep the draft open if the phone cannot save it. */
export const backFromDraft = effect {
  const composer = try Drafts.Machine
  const state = try composer.get()
  if (!state.open) return false
  const changes = try Changes
  if ((try changes.get()).review.showing) {
    try ignore(exit(changes.send({ type: "cancel" }, "Owner")))
    return true
  }
  if (state.discarding) {
    try ignore(exit(composer.send({ type: "keepDraft" }, "Owner")))
    return true
  }

  const aside = { type: "setAside" } as const
  if (Drafts.canSetAside(state)) {
    try ignore(exit(composer.send(aside, "Owner")))
    return true
  }
  if (!Drafts.ready(state) || state.letter.sending !== 0 || (!state.pending && !state.unkept && state.write.status !== "Loading")) return true

  try ignore(exit(composer.send({ type: "leave" }, "World")))
  const id = state.letter.id
  const session = state.session
  const settled = try Stream.runHead(Stream.filter(composer.changes, (next) =>
    !next.open || next.letter.id !== id || next.session !== session ||
      (next.write.status !== "Loading" && !next.leaving && (!next.pending || next.unkept))))
  if (Option.isSome(settled)) {
    const kept = settled.value
    if (kept.open && kept.letter.id === id && kept.session === session && Drafts.canSetAside(kept)) {
      try ignore(exit(composer.send(aside, "Owner")))
    }
  }
  return true
}

/** The composer: kept on the phone as it is typed, set aside and taken back, and written to the phone before Alpha leaves. */
export const composer = together(
  Layer.provideMerge(reacting(Drafts, { keep: 1, open: [{ type: "restart" }, "World"], carry, timers }), letters),
  leaving,
  sessions,
)
