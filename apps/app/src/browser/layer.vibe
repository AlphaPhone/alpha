// spec/browser/session.md, "Story: Browse in tabs"; spec/browser/bookmarks.md, "Opening Browser, resuming the app, a visible return and a changed bookmark document each ask for one refresh"; spec/browser/presentation.md, "A request is sent only when it differs from the last one, and only the answer to the latest request counts"
import { Foreground } from "../shell/foreground.vibe"
import { agentLayer } from "./agent.vibe"
import { autofillLayer } from "./autofill.vibe"
import { BrowserBookmarks, bookmarksLayer } from "./bookmarks.vibe"
import { cloudRequestsLayer } from "./cloudCustody.vibe"
import { egressLayer } from "./egress.vibe"
import { googleLinkLayer } from "./googleReturn.vibe"
import { BrowserHandoff, handoffLayer } from "./handoff.vibe"
import { pageContextLayer } from "./pageContext.vibe"
import { BrowserPresenter, presenterLayer } from "./presentation.vibe"
import { BrowserReading, readingLayer } from "./reading.vibe"
import { BrowserReviews, reviewsLayer } from "./reviews.vibe"
import { BrowserTabs, tabsLayer } from "./session.vibe"
import { TabHost, ours, tabHostLayer } from "./tabHost.vibe"

/** Keeps Browser in step with Alpha's foreground while the app runs. */
const running = Layer.effectDiscard(effect {
  const tabs = try BrowserTabs
  const reviews = try BrowserReviews
  const handoff = try BrowserHandoff
  const reading = try BrowserReading
  const marks = try BrowserBookmarks
  const presenter = try BrowserPresenter
  const foreground = try Foreground
  const host = try TabHost
  try marks.refresh(true)
  fork.scoped effect {
    for try (const changed of host.events("bookmarksChanged")) {
      if (ours(host.session, changed)) try marks.refresh(true)
    }
  }
  fork.scoped tabs.run()
  fork.scoped reviews.follow()
  fork.scoped handoff.follow()
  fork.scoped reading.follow()
  fork.scoped effect { for try (const _ of tabs.resumed) { try presenter.forget() } }
  fork.scoped effect {
    let inBrowser = false
    let visible = true
    for try (const state of foreground.changes) {
      const shown = state.visible && state.view === "browser"
      if (state.visible !== visible) {
        try presenter.appVisibility(!state.visible)
        if (state.visible && shown) try marks.refresh(false)
      }
      if (shown && !inBrowser) try marks.refresh(false)
      if (!shown && inBrowser) try presenter.withdraw()
      inBrowser = shown
      visible = state.visible
    }
  }
})

const base = Layer.provideMerge(tabsLayer, Layer.mergeAll(reviewsLayer, bookmarksLayer, presenterLayer))
const features = Layer.provideMerge(Layer.mergeAll(egressLayer, handoffLayer, readingLayer, agentLayer, autofillLayer, pageContextLayer), base)

/** Every Browser service, over the platform's Native, Cloud and Build, Settings' Preferences, the shell's Navigation, Toasts and Foreground, the assistant's Assistant, and the ReadingVoice and PageMail ports of src/browser/ports.vibe. */
export const layer = Layer.provideMerge(running, Layer.mergeAll(features, cloudRequestsLayer, googleLinkLayer)).pipe(Layer.provide(tabHostLayer))

