// spec/app/browser/address.md, "Story: Find in page"; spec/app/browser/index.md, "Story: Open, pick and close tabs"; spec/app/browser/index.md, "Story: Keep my tabs through a restart"; spec/app/browser/index.md, "Story: Save the session"; spec/app/browser/address.md, "Story: Go where I typed"; spec/app/browser/address.md, "Story: Watch a page load"
import type * as KeyValueStore from "effect/persistence/KeyValueStore"
import { browsingSnapshot, DEFAULT_BROWSING_LIMITS, restoreBrowsing, savedBrowserUrl } from "@elizaos/os-bridges"
import * as Tabs from "../../gen/app__browser.effect.vibe"
import type { Browser, Effect as TabsOut, Event as TabsEvent } from "../../gen/app__browser.effect.vibe"
import * as Address from "../../gen/app__browser__address.effect.vibe"
import type { Effect as PageOut, Event as PageEvent, Page } from "../../gen/app__browser__address.effect.vibe"
import * as Share from "../../gen/app__browser__share.effect.vibe"
import type { Event as ShareEvent } from "../../gen/app__browser__share.effect.vibe"
import { Machine as Settings } from "../../gen/app__settings.effect.vibe"
import { Machine as Shell, showing, type Shell as ShellState } from "../../gen/app__shell.effect.vibe"
import * as Layers from "../../gen/app__shell__layers.effect.vibe"
import type { BrowserPageGuard } from "@elizaos/os-bridges"
import { BrowserDownloadsHandoff, TabHost, hosted } from "../platform/browser.vibe"
import { say } from "../notices/toasts.vibe"
import { readWebBrowsing, saveWebBrowsing } from "../platform/browserWeb.vibe"
import { Device } from "../platform/device.vibe"
import type { Install } from "../runtime/attempts.vibe"
import { type Job, Whole, answer, contained, due, reacting, run, started, together, untimed, whole } from "../runtime/reactor.vibe"
import { Time } from "../runtime/time.vibe"

/** Whether Browser is on the shell's active view. */
export effect function browserInFront(): boolean!!Shell {
  return showing(try (try Shell).get(), "Browser")
}

module page {
  import { addressFacts, isSecureWebAddress, isWebAddress } from "@elizaos/os-bridges"
  import type { Input } from "../../gen/app__browser__address.ts"

  /** Whether `href` came over HTTPS with a host. @throws {never} */
  export function secure(href: string): boolean {
    return isSecureWebAddress(href)
  }
  /** Where the Browser draws a tab's page now, in the page's own pixels, or none while nothing marks the place. @throws {never} */
  export function placeOfPage(): { x: number; y: number; width: number; height: number } | undefined {
    if (typeof document === "undefined") return undefined
    const place = document.querySelector<HTMLElement>("[data-alpha-browser-page]")
    if (place === null) return undefined
    const { left, top, width, height } = place.getBoundingClientRect()
    return width > 0 && height > 0 ? { x: left, y: top, width, height } : undefined
  }
  type Place = { x: number; y: number; width: number; height: number }
  type HostRect = Place & { cornerRadius: number }
  const findBar = '[role="search"][aria-label="Find in page"]'
  /** What of Alpha may be drawn over a page below it: the find bar and Alpha's marked chrome. */
  export const overPageChrome = `${findBar}, [data-host-chrome]`
  /** Whether `element` is drawn on screen. @throws {never} */
  function drawn(element: HTMLElement): boolean {
    const style = getComputedStyle(element)
    const { width, height } = element.getBoundingClientRect()
    return style.display !== "none" && style.visibility !== "hidden" && Number.parseFloat(style.opacity) !== 0 && width > 0 && height > 0
  }
  /** Whether `element` is drawn and takes touches. @throws {never} */
  function touchable(element: HTMLElement): boolean {
    return drawn(element) && element.closest('[inert],[aria-hidden="true"]') === null && getComputedStyle(element).pointerEvents !== "none"
  }
  /** Whether the find bar is drawn over the page, which the phone then draws below Alpha. @throws {never} */
  export function findBarDrawn(): boolean {
    return typeof document !== "undefined" && [...document.querySelectorAll<HTMLElement>(findBar)].some(drawn)
  }
  /**
   * Alpha's controls drawn over the page below it, in the same pixels as `placeOfPage`, rounded as drawn: the find bar and each
   * innermost piece of Alpha's chrome (`data-host-chrome`) over the page, such as Ask Alpha's bar
   * (spec/app/browser/address.md, "The find bar opens over a shown page"). A touch there is Alpha's; anywhere else, the page's.
   * @throws {never}
   */
  export function overPage(page: Place): HostRect[] {
    if (typeof document === "undefined") return []
    const shown = [...document.querySelectorAll<HTMLElement>(overPageChrome)].filter(touchable)
    return shown.filter((element) => !shown.some((inner) => inner !== element && element.contains(inner))).flatMap((element) => {
      const { left, top, right, bottom, width, height } = element.getBoundingClientRect()
      if (right <= page.x || left >= page.x + page.width || bottom <= page.y || top >= page.y + page.height) return []
      const scale = element.offsetWidth > 0 ? width / element.offsetWidth : 1
      return [{ x: left, y: top, width, height, cornerRadius: (Number.parseFloat(getComputedStyle(element).borderTopLeftRadius) || 0) * scale }]
    })
  }
  const sides = ["top", "right", "bottom", "left"] as const
  /** Clears Alpha's surface over `page`, so the page drawn below Alpha shows through it, or draws the surface whole again. @throws {never} */
  function underlay(page: Place | undefined): void {
    if (typeof document === "undefined") return
    const root = document.documentElement
    const frame = document.querySelector("[data-alpha-browser-page]")?.closest("main")
    if (page === undefined || frame == null) {
      delete root.dataset.alphaBrowserUnder
      for (const side of sides) root.style.removeProperty(`--alpha-browser-under-${side}`)
      return
    }
    const box = frame.getBoundingClientRect()
    const scale = frame.offsetWidth > 0 ? box.width / frame.offsetWidth : 1
    const clear = { top: page.y - box.top, right: page.x + page.width - box.left, bottom: page.y + page.height - box.top, left: page.x - box.left }
    for (const side of sides) root.style.setProperty(`--alpha-browser-under-${side}`, `${Math.max(0, clear[side] / scale)}px`)
    root.dataset.alphaBrowserUnder = ""
  }
  let presentations = 0
  /** Begins a presentation of the page: one below Alpha clears Alpha's surface over it first. Its ticket. @throws {never} */
  export function presenting(below: Place | undefined): number {
    presentations += 1
    if (below !== undefined) underlay(below)
    return presentations
  }
  /** Ends presentation `ticket`: unless a later one began, Alpha's surface is whole again once the page is no longer below it. @throws {never} */
  export function presented(ticket: number, below: boolean): void {
    if (ticket === presentations && !below) underlay(undefined)
  }
  /** The facts of what was typed that the address bar's rules read. @throws {never} */
  export function inputOf(typed: string): Input {
    const text = typed.trim()
    const web = /^https?:\/\//i.test(text)
    const rest = text.replace(/^https?:\/\//i, "")
    const authority = rest.split(/[/?#]/)[0] ?? ""
    const spaced = /\s/.test(text)
    const mail = /^[^\s/:@?#%]+@[^\s/:@?#%]+\.[^\s/:@?#%]+$/.test(text)
    return {
      blank: text === "",
      tooLong: text.length > 8192,
      userInfo: !mail && (addressFacts(text, "DefaultHttps").userInfo || authority.includes("@") && (web || !spaced)),
      web,
      spaced,
      colon: /^[A-Za-z][\w-]*:(?!\d)/.test(text) && !web,
      host: web
        ? isWebAddress(text)
        : /^(localhost|\[[\da-f:.]+\]|[^\s/:@.]+(\.[^\s/:@.]+)+)(:\d+)?([/?#]\S*)?$/i.test(rest) && !/^[\d.:]+$/.test(rest) && isWebAddress(`https://${rest}`),
      numeric: /^[\d.:]+$/.test(text),
      mail,
    }
  }
  /** The address the tab host opens for what was typed: the web address it names, or a search for it. @throws {never} */
  export function addressOf(typed: string, search: boolean): string {
    const text = typed.trim()
    if (search) return `https://www.google.com/search?q=${encodeURIComponent(text)}`
    return /^https?:\/\//i.test(text) ? text : `https://${text}`
  }
  /** A URL the owner tapped in Messages, with an ordinary web scheme and no credentials. @throws {never} */
  export function messageHref(value: string): string | undefined {
    const address = URL.parse(value)
    return address && address.hostname && (address.protocol === "http:" || address.protocol === "https:") && !address.username && !address.password ? address.href : undefined
  }
}
import { addressOf, findBarDrawn, inputOf, messageHref, overPage, overPageChrome, placeOfPage, presented, presenting, secure } from page
export { addressOf, inputOf, overPageChrome }

/** The native tab of a tab number: numbers are never used twice, so neither is an id. */
export const idOf = (tab: number): string => `tab${tab}`
const tabOf = (id: string): number => (/^tab(\d+)$/.test(id) ? Number(id.slice(3)) : 0)
const failedRestore = (ticket: number): TabsEvent => ({ type: "restored", ticket, ok: false, shown: 0, incoming: [] })

/** A tab's page: its own machine, made when the tab is first asked for and ended with the tab. */
export type PageRuntime = ManagedRuntime.ManagedRuntime<Address.Machine | Time, unknown>

/** What Alpha's tab host says of a failed tab beyond eliza's state: the HTTPS address another browser may still reach. */
schema Stranded { readonly id: string; readonly elsewhereUrl?: string }

/** The address each native tab's failed page may open at in another browser, as the host last said it; none once a load starts. */
const elsewhere = new Map<string, string>()

export type HistoryRow = { readonly url: string; readonly stamp: number; readonly title?: string; readonly at?: number }
type HistoryEdit = { readonly ticket: number; readonly stamps: ReadonlySet<number> }
export type HistoryChange =
  | { readonly kind: "visited"; readonly count: number }
  | { readonly kind: "edited"; readonly ticket: number; readonly ok: boolean; readonly count: number; readonly remaining: number }
  | { readonly kind: "wiped" }

/**
 * Each open tab's page: its machine, the address its next load opens, and what the tab host last said of it, which
 * `TabHost`'s session holds by the tab's id.
 */
export service Pages {
  readonly subscribe: (listener: () => void) => () => void
  readonly version: () => number
  notify(): void!!
  of(tab: number): PageRuntime!!
  /** Where the next load of `tab` that opens an address goes. */
  aim(tab: number, address: string): void!!
  aimed(tab: number): Option.Option<string>!!
  /** What the owner is finding in `tab`'s page. */
  seek(tab: number, text: string): void!!
  sought(tab: number): string!!
  findTicket(tab: number, ticket: number): void!!
  activeFindTicket(tab: number): number!!
  /** Whether the native tab currently requests the desktop version of pages. */
  desktop(tab: number): boolean!!
  setDesktop(tab: number, enabled: boolean): void!!
  end(tab: number): void!!
  /** The saved and newly committed normal-tab addresses in recent-first order. */
  history(): readonly HistoryRow[]!!
  keepVisits(addresses: readonly string[], times: Readonly<Record<string, number>> | undefined, titles: ReadonlyMap<string, string>): void!!
  visit(url: string, at: number, title: string | undefined): void!!
  readonly historyChanges: Stream.Stream<HistoryChange>
  historyEdit(): (HistoryEdit | undefined)!!
  stageHistory(edit: HistoryEdit): boolean!!
  finishHistory(edit: HistoryEdit, ok: boolean): void!!
  wipeHistory(): void!!
  /** Tell the Browser's Share machine, which speaks for the tab in front, of `tab`'s page: nothing for a tab behind. Whether it took it. */
  share(tab: number, event: ShareEvent): boolean!!
}

/** Read the current address machine for the exact tab. */
export effect function pageOf(tab: number): Page!!Pages {
  const runtime = try (try Pages).of(tab)
  return try promise(() => runtime.runPromise(Address.Machine.use((machine) => machine.get())))
}

export effect function tellPage(tab: number, event: PageEvent): boolean!!Pages {
  const runtime = try (try Pages).of(tab)
  return try promise(() => runtime.runPromiseExit(Address.Machine.use((machine) => machine.send(event))).then((ended) => Exit.isSuccess(ended)))
}

effect function tellShare(tab: number, event: ShareEvent): boolean!!Pages {
  return try (try Pages).share(tab, event)
}

export effect function tellTabs(event: TabsEvent): boolean!!Tabs.Machine {
  return try ((try Tabs.Machine).send(event) |> Effect.as(%, true) |> Effect.orElseSucceed(%, () => false))
}

// spec/app/browser/index.md, "A tab gets its native tab when it is the one shown and loads a page, and loses it if Android cannot make one"
effect function made(tab: number, kind: Tabs.Kind): void!!(TabHost | Tabs.Machine) {
  const host = try TabHost
  const id = idOf(tab)
  if (host.web !== undefined) {
    try sync(() => host.web?.create(id, kind === "Private"))
    return
  }
  const plugin = host.plugin
  const ok = Option.isSome(plugin) && try promise(() => host.session.ensure(id, kind === "Private", () => plugin.value.create({ session: host.session.session, id, private: kind === "Private" })).then(() => true, () => false))
  if (!ok) try tellTabs({ type: "nativeLost", tab })
}

// spec/app/browser/index.md, "A launch reads the saved session, and may ask again after a failed read"; spec/app/browser/index.md, "The saved tabs replace an untouched launch tab, or join the open tabs when they all fit"
effect function restoredFrom(ticket: number): TabsEvent!!(TabHost | Pages | Tabs.Machine) {
  return effect {
    const host = try TabHost
    const saved = host.web === undefined ? try hosted("browsingState", (plugin, session) => plugin.browsingState({ session })) : try readWebBrowsing()
    const s = try (try Tabs.Machine).get()
    const pages = try Pages
    const adopting = host.web !== undefined && s.kept.length === 0
    const back = restoreBrowsing(saved, { visits: (try pages.history()).map((row) => row.url) }, s.untouched || host.web !== undefined)
    const rows = back.restored.map((row, index) => ({ ...row, tab: adopting ? s.issued + index + 1 : tabOf(row.id) }))
    const incoming = adopting ? rows.map((row) => row.tab) : []
    const cur = rows.find((row) => row.id === back.cur)?.tab ?? 0
    const shown = adopting ? cur : s.kept.includes(cur) ? cur : (s.kept[0] ?? 0)
    if (!Tabs.canRestored(s, ticket, true, shown, incoming)) return failedRestore(ticket)
    const restored: TabsEvent = { type: "restored", ticket, ok: true, shown, incoming }
    if (!Tabs.restored(s, ticket, true, shown, incoming).hydrated) return restored
    try pages.keepVisits(back.visits, back.visitTimes, new Map(rows.map(({ title, url }) => [url, title])))
    for (const { tab, url, title } of rows) {
      if (adopting || s.kept.includes(tab)) {
        try pages.aim(tab, url)
        try sync(() => host.web?.restore(idOf(tab), url, title))
      }
    }
    return restored
  } catch () => failedRestore(ticket)
}

// spec/app/browser/index.md, "A stale session is written once it has been read, one write at a time, and never while browsing data is being cleared"
effect function written(write: number): TabsEvent!!(TabHost | Tabs.Machine | Pages) {
  const pages = try Pages
  const edit = try pages.historyEdit()
  const result = try contained(effect {
    const host = try TabHost
    const s = try (try Tabs.Machine).get()
    const history = (try pages.history()).filter((row) => !edit?.stamps.has(row.stamp))
    const visits = history.map((row) => row.url)
    const visitTimes = Object.fromEntries(history.flatMap(({ url, at }) => at === undefined ? [] : [[url, at]]))
    const snapshot = browsingSnapshot(
      { tabs: s.open.map((tab) => ({ id: idOf(tab), priv: s.privates.includes(tab) })), visits, visitTimes, cur: idOf(s.selected) },
      (id) => host.web === undefined ? host.session.info(id) : host.web.info(id),
    )
    if (host.web === undefined) try hosted("saveBrowsingState", (plugin, session) => plugin.saveBrowsingState({ session, ...snapshot }))
    else try saveWebBrowsing(snapshot)
  }, "saving the Browser session")
  if (edit !== undefined) try pages.finishHistory(edit, result)
  return { type: "saved", ticket: write, ok: result, now: untimed }
}

// spec/app/browser/index.md, "A history edit is carried by the same session writer"
export effect function persistHistory(ticket: number, stamps: ReadonlySet<number>): boolean!!(Pages | Tabs.Machine) {
  if (!Tabs.canHistoryChanged(try (try Tabs.Machine).get())) return false
  const pages = try Pages
  const edit = { ticket, stamps }
  if (!(try pages.stageHistory(edit))) return false
  if (!(try tellTabs({ type: "historyChanged" }))) try pages.finishHistory(edit, false)
  return true
}

function carryTabs(fx: TabsOut): Job<TabsEvent, TabHost | Pages | Tabs.Machine, []> {
  return match (fx) {
    when { tag: "Restore", let ticket }: answer("restore", restoredFrom(ticket), failedRestore(ticket));
    when { tag: "Create", let tab, let kind }: run(`create ${tab}`, made(tab, kind));
    when { tag: "Close", let tab }: run(`close ${tab}`, effect {
      const host = try TabHost
      if (host.web === undefined) try ignore(hosted("close", (plugin, session) => plugin.close({ session, id: idOf(tab) })))
      else try sync(() => host.web?.close(idOf(tab)))
      host.session.forget([idOf(tab)])
      try (try Pages).end(tab)
    });
    when { tag: "Save", let write }: answer("save", written(write), { type: "saved", ticket: write, ok: false, now: untimed });
    when { tag: "Erase" }: answer("erase", erased(), { type: "erased", ok: false });
    when { tag: "Halt" }: run("halt", Effect.void);
  }
}

effect function erased(): TabsEvent!!(TabHost | Pages | Tabs.Machine) {
  return effect {
    const host = try TabHost
    const pages = try Pages
    const edit = try pages.historyEdit()
    if (edit !== undefined) try pages.finishHistory(edit, false)
    const tabs = try (try Tabs.Machine).get()
    const cleared = tabs.open.filter((tab) => !tabs.privates.includes(tab))
    if (host.web === undefined) try hosted("clearBrowsingData", (plugin, session) => plugin.clearBrowsingData({ session }))
    else {
      try saveWebBrowsing({})
      try sync(() => host.web?.clear())
    }
    host.session.forget(cleared.map(idOf))
    for (const tab of cleared) try pages.end(tab)
    try pages.wipeHistory()
    return { type: "erased", ok: true }
  } catch () => ({ type: "erased", ok: false })
}

// spec/app/browser/library.md, "A page that commits in a normal tab is counted in history, which keeps the newest hundred"
effect function visited(tab: number, load: number): void!!(Pages | TabHost | Tabs.Machine | Time) {
  const tabs = try (try Tabs.Machine).get()
  if (!Tabs.canTouch(tabs, tab) || tabs.erasing === "Running") return
  const page = try pageOf(tab)
  const host = try TabHost
  const info = host.web === undefined ? host.session.info(idOf(tab)) : try sync(() => host.web?.info(idOf(tab)))
  const url = info?.url
  if (page.load !== load || page.phase !== "Shown" || !savedBrowserUrl(url)) return
  try (try Pages).visit(url, try (try Time).now(), info?.title)
  try tellTabs({ type: "touch", tab })
}

// spec/app/browser/address.md, "Submitting text opens it, searches for it or says why not, and blank text is not submitted"; spec/app/browser/address.md, "Back and forward move through the tab's own pages"; spec/app/browser/address.md, "Reload loads a shown, failed or stopped page again"
effect function went(tab: number, load: number, way: Address.Way): PageEvent!!(TabHost | Pages | Tabs.Machine) {
  const failed: PageEvent = { type: "failed", load }
  return effect {
    const host = try TabHost
    if (!(try host.observing())) return failed
    const s = try (try Tabs.Machine).get()
    const p = try pageOf(tab)
    if (!s.open.includes(tab) || p.phase !== "Loading" || p.load !== load) return failed
    elsewhere.delete(idOf(tab))
    try tellShare(tab, { type: "pageChanged" })
    if (!s.native.includes(tab) && !(try tellTabs({ type: "load", tab }))) return failed
    try made(tab, Tabs.kindOf(s, tab))
    const id = idOf(tab)
    if (way === "Address" || way === "Query") {
      const aimed = try (try Pages).aimed(tab)
      if (Option.isNone(aimed)) return failed
      if (host.web === undefined) {
        host.session.beginNavigation(id, aimed.value)
        try hosted("navigate", (plugin, session) => plugin.navigate({ session, id, url: aimed.value }))
      } else if (!(try sync(() => host.web?.navigate(id, load, aimed.value)))) return failed
    } else {
      if (host.web === undefined) {
        const command = way === "Again" ? "reload" : way === "Backward" ? "back" : "forward"
        try hosted("command", (plugin, session) => plugin.command({ session, id, command }))
      } else if (!(try sync(() => host.web?.move(id, load, way)))) return failed
    }
    return { type: "started" }
  } catch () => failed
}

/** The shown page's guard, as the host last said it: the page a call is for, which the host refuses once it moved on. */
effect function guardOf(tab: number): Option.Option<BrowserPageGuard>!!TabHost {
  const host = try TabHost
  const id = idOf(tab)
  const info = host.session.info(id)
  return info?.url === undefined || info.navigation === undefined ? Option.none() : Option.some({ session: host.session.session, id, url: info.url, navigation: info.navigation })
}

// spec/app/browser/share.md, "The other browser opens, or the owner is told that none could and the page is still here"; spec/app/browser/share.md, "Only an unreachable HTTPS address makes a failed page leave, and only from a normal tab"
/**
 * Open the failed page in front in another browser, at the HTTPS address the host named.
 * A committed page leaves only through the menu's reviewed hand-off (`launchOtherBrowser` in share.vibe), never from here.
 */
export effect function leaving(): ShareEvent!!(TabHost | Tabs.Machine | Share.Machine) {
  const tab = (try (try Tabs.Machine).get()).selected
  const guard = try guardOf(tab)
  const share = try (try Share.Machine).get()
  const failedAt = elsewhere.get(idOf(tab))
  if (Option.isNone(guard) || !share.stranded || failedAt === undefined) return { type: "launched", ok: false, found: true }
  const sent = hosted("openFailedPage", (plugin) => plugin.openFailedPage({ ...guard.value, url: failedAt }))
  const launched = effect { try sent; return { type: "launched", ok: true, found: true } as ShareEvent }
    catch (failed) => ({ type: "launched", ok: false, found: !String((failed.cause as { message?: unknown } | undefined)?.message ?? failed.cause).includes("No other installed browser") }) as ShareEvent
  return launched
}

function carryPage(tab: number) {
  return (fx: PageOut): Job<PageEvent, TabHost | Pages | Tabs.Machine | Time, []> => match (fx) {
    when { tag: "Go", let load, let way }: run(`go ${tab}`, effect {
      const outcome = try went(tab, load, way)
      if (outcome.type === "failed") try tellPage(tab, outcome)
    });
    when { tag: "Halt", let load }: run(`halt ${tab}`, effect {
      const host = try TabHost
      if (host.web === undefined) try ignore(hosted("command", (plugin, session) => plugin.command({ session, id: idOf(tab), command: "stop" })))
      else try sync(() => host.web?.stop(idOf(tab), load))
    });
    when { tag: "Visit", let load }: run(`visit ${tab}`, visited(tab, load));
    when { tag: "Find", let ticket }: run(`find ${tab}`, ignore(effect {
      const pages = try Pages
      try pages.findTicket(tab, ticket)
      const text = try pages.sought(tab)
      try hosted("find", (plugin, session) => plugin.find({ session, id: idOf(tab), query: text }))
    }));
    when { tag: "FindNext", let forward }: run(`find next ${tab}`, ignore(hosted("findNext", (plugin, session) => plugin.findNext({ session, id: idOf(tab), forward }))));
    when { tag: "ClearFind" }: run(`find ${tab}`, ignore(effect {
      try (try Pages).findTicket(tab, 0)
      try hosted("clearFind", (plugin, session) => plugin.clearFind({ session, id: idOf(tab) }))
    }));
  }
}

/** Each tab's page machine, made over the Browser's own runtime once it is whole, so its loads go through the tab host. */
const pages = Layer.effect(Pages, effect {
  const area = try Whole
  const made = new Map<number, PageRuntime>()
  const aims = new Map<number, string>()
  const finds = new Map<number, { text: string; ticket: number }>()
  const desktops = new Set<number>()
  const listeners = new Set<() => void>()
  let history: readonly HistoryRow[] = []
  let stamp = 0
  let editing: HistoryEdit | undefined
  let rev = 0
  const historyQueue = try Queue.unbounded<HistoryChange>()
  function notifyListeners() {
    rev += 1
    for (const listener of [...listeners]) listener()
  }
  const note = (url: string, title?: string, at?: number): HistoryRow => ({
    url, stamp: ++stamp, ...(title === undefined || title === "" || title === url ? {} : { title }), ...(at === undefined ? {} : { at }),
  })
  try addFinalizer(() => effect {
    for (const runtime of made.values()) try ignore(tryPromise(() => runtime.dispose()))
    made.clear()
    aims.clear()
    finds.clear()
    desktops.clear()
  })
  return {
    subscribe: (listener: () => void) => {
      listeners.add(listener)
      return () => { listeners.delete(listener) }
    },
    version: () => rev,
    notify: () => sync(notifyListeners),
    effect of(tab: number): PageRuntime!! {
      const known = made.get(tab)
      if (known !== undefined) return known
      const context = try area.context
      const found = Context.getOption(context as Context.Context<Tabs.Machine>, Tabs.Machine)
      const privateTab = Option.isSome(found) && (try found.value.get()).privates.includes(tab)
      const machine = whole(reacting(Address, { carry: carryPage(tab), ...(privateTab ? { open: [{ type: "bePrivate" }] as const } : {}) }))
      const runtime: PageRuntime = ManagedRuntime.make(Layer.provideMerge(machine, Layer.succeedContext(context as Context.Context<KeyValueStore.KeyValueStore | Time | Install | TabHost | Pages | Tabs.Machine>)))
      made.set(tab, runtime)
      return runtime
    },
    aim: (tab: number, address: string) => sync(() => { aims.set(tab, address) }),
    aimed: (tab: number) => sync(() => Option.fromNullishOr(aims.get(tab))),
    seek: (tab: number, text: string) => sync(() => { finds.set(tab, { text, ticket: finds.get(tab)?.ticket ?? 0 }); notifyListeners() }),
    sought: (tab: number) => sync(() => finds.get(tab)?.text ?? ""),
    findTicket: (tab: number, ticket: number) => sync(() => {
      const current = finds.get(tab)
      finds.set(tab, { text: current?.text ?? "", ticket })
    }),
    activeFindTicket: (tab: number) => sync(() => finds.get(tab)?.ticket ?? 0),
    desktop: (tab: number) => sync(() => desktops.has(tab)),
    setDesktop: (tab: number, enabled: boolean) => sync(() => {
      if (enabled) desktops.add(tab)
      else desktops.delete(tab)
      notifyListeners()
    }),
    history: () => sync(() => history),
    keepVisits: (urls: readonly string[], times: Readonly<Record<string, number>> | undefined, titles: ReadonlyMap<string, string>) => sync(() => {
      const live = new Map(history.map((row) => [row.url, row]))
      history = urls.map((url) => live.get(url) ?? note(url, titles.get(url), times?.[url]))
      notifyListeners()
    }),
    visit: (url: string, at: number, title: string | undefined) => sync(() => {
      history = [note(url, title, at), ...history.filter((visit) => visit.url !== url)].slice(0, DEFAULT_BROWSING_LIMITS.history)
      Queue.offerUnsafe(historyQueue, { kind: "visited", count: history.length })
      notifyListeners()
    }),
    historyChanges: Stream.fromQueue(historyQueue),
    historyEdit: () => sync(() => editing),
    stageHistory: (edit: HistoryEdit) => sync(() => {
      if (editing !== undefined) return false
      editing = edit
      return true
    }),
    finishHistory: (edit: HistoryEdit, ok: boolean) => sync(() => {
      if (editing !== edit) return
      editing = undefined
      const count = history.length
      const kept = history.filter((one) => !edit.stamps.has(one.stamp))
      if (ok) {
        history = kept
        notifyListeners()
      }
      Queue.offerUnsafe(historyQueue, { kind: "edited", ticket: edit.ticket, ok, count, remaining: count - kept.length })
    }),
    wipeHistory: () => sync(() => {
      history = []
      Queue.offerUnsafe(historyQueue, { kind: "wiped" })
      notifyListeners()
    }),
    effect share(tab: number, event: ShareEvent): boolean!! {
      const context = try area.context
      const tabs = Context.getOption(context as Context.Context<Tabs.Machine>, Tabs.Machine)
      const machine = Context.getOption(context as Context.Context<Share.Machine>, Share.Machine)
      if (Option.isNone(tabs) || Option.isNone(machine) || (try tabs.value.get()).selected !== tab) return false
      return try (machine.value.send(event) |> Effect.as(%, true) |> Effect.orElseSucceed(%, () => false))
    },
    effect end(tab: number): void!! {
      const runtime = made.get(tab)
      made.delete(tab)
      aims.delete(tab)
      finds.delete(tab)
      desktops.delete(tab)
      notifyListeners()
      if (runtime !== undefined) try promise(() => runtime.dispose())
    },
  }
})

// spec/app/browser/index.md, "A stale session is written once it has been read, one write at a time, and never while browsing data is being cleared"; spec/app/browser/index.md, "A write that lands becomes the saved session, and one that fails waits longer each time, up to a minute"
const tabs = reacting(Tabs, {
  keep: 1,
  open: [{ type: "restart" }],
  carry: carryTabs,
  timers: (s: Browser) => (s.stale && s.hydrated && !s.writing && s.erasing !== "Running" ? [due("save", s.retryAt, { type: "save", now: untimed } as TabsEvent)] : []),
})

// spec/app/browser/address.md, "Only the latest load of the page commits it or fails it"; spec/app/browser/address.md, "A page can go on to another page by itself, through a link or a redirect"; spec/app/browser/index.md, "A tab gets its native tab when it is the one shown and loads a page, and loses it if Android cannot make one"
const told = started(effect {
  const host = try TabHost
  try Stream.runForEach(host.told, effect (said) => {
    if (said.kind === "framed" || said.kind === "frameBlocked") {
      const { id, load } = said.request
      const tab = tabOf(id)
      if ((try (try Tabs.Machine).get()).open.includes(tab) && (try sync(() => host.web?.current(id, load))) === said.request) {
        if (said.kind === "framed") try tellPage(tab, { type: "framed", load })
        else if (try tellPage(tab, { type: "frameBlocked", load })) try sync(() => host.web?.blocked(said.request))
      }
      return
    }
    if (said.kind === "showDownloads") {
      const raw = said.raw
      if (typeof raw === "object" && raw !== null && "session" in raw && raw.session === host.session.session && showing(try (try Shell).get(), "Browser")) {
        try (try BrowserDownloadsHandoff).open()
      }
      return
    }
    if (said.kind === "opened") {
      const opened = host.session.applyOpened(said.raw)
      if (opened === undefined) return
      const s = try (try Tabs.Machine).get()
      const rawOpener = typeof said.raw === "object" && said.raw !== null && "opener" in said.raw && typeof said.raw.opener === "string" ? tabOf(said.raw.opener) : s.selected
      const opener = s.native.includes(rawOpener) ? rawOpener : s.selected
      if (tabOf(opened.id) === s.issued + 1 && Tabs.canPopup(s, opener)) {
        try tellTabs({ type: "popup", opener })
      } else if (!Tabs.steady(s) || s.open.length >= Tabs.maxTabs) {
        try ignore(hosted("close", (plugin, session) => plugin.close({ session, id: opened.id })))
        host.session.forget([opened.id])
      }
      try (try Pages).notify()
      return
    }
    if (said.kind === "closed") {
      const id = host.session.applyClosed(said.raw)
      if (id !== undefined) {
        try tellTabs({ type: "nativeLost", tab: tabOf(id) })
        try (try Pages).notify()
      }
      return
    }
    if (said.kind === "found") {
      const s = try (try Tabs.Machine).get()
      const id = idOf(s.selected)
      const raw = said.raw
      const outcome = host.session.findResult(raw, id)
      if (outcome === undefined || outcome.cleared || !outcome.done || !Number.isInteger(outcome.count) || !Number.isInteger(outcome.index)) return
      const navigation = host.session.info(id)?.navigation
      if (navigation === undefined || typeof raw !== "object" || raw === null || !("navigation" in raw) || raw.navigation !== navigation) return
      const pages = try Pages
      const p = try pageOf(s.selected)
      if (!p.finding) return
      const activeTicket = try pages.activeFindTicket(s.selected)
      const { count } = outcome
      const position = count > 0 ? Math.max(1, outcome.index) : 0
      if (p.find.status === "Loading" && p.find.ticket === activeTicket) try tellPage(s.selected, { type: "found", ticket: p.find.ticket, count, position })
      else if (p.find.status === "Loaded" && p.find.ticket === activeTicket) try tellPage(s.selected, { type: "matchSelected", ticket: p.find.ticket, count, position })
      return
    }
    if (said.kind !== "state") return
    const change = host.session.applyState(said.raw)
    if (change === undefined) return
    const tab = tabOf(change.id)
    const tabsState = try (try Tabs.Machine).get()
    if (tab <= 0 || !tabsState.open.includes(tab)) return
    try (try Pages).notify()
    const p = try pageOf(tab)
    const { info } = change
    if (change.revisionChanged && !change.documentChanged && Address.canReaddressed(p, p.load, true, true)) {
      try tellPage(tab, { type: "readdressed", load: p.load, sameOrigin: true, sameDocument: true })
    }
    if (p.phase === "Shown" && info.loading === true && change.documentChanged && (try tellPage(tab, { type: "followed" }))) try tellShare(tab, { type: "pageChanged" })
    const now = try pageOf(tab)
    if (now.phase !== "Loading") return
    if ((info.error ?? "") !== "") {
      const stranded = Schema.decodeUnknownOption(Stranded)(said.raw)
      const failedAt = Option.isSome(stranded) ? (stranded.value.elsewhereUrl ?? "") : ""
      if (failedAt === "") elsewhere.delete(change.id)
      else elsewhere.set(change.id, failedAt)
      if (try tellPage(tab, { type: "failed", load: now.load })) try tellShare(tab, { type: "pageFailed", failure: failedAt === "" ? "Refused" : "Unreachable", https: secure(failedAt === "" ? (info.url ?? "") : failedAt) })
    }
    else if (info.loading !== true && (try sync(() => host.session.pageBinding(change.id))) !== undefined) {
      // spec/app/browser/address.md, "A page that replaces its own address at its own origin, without loading another document, is still the same load": a single-page site's Back or Forward settles in place, and the native commit says so.
      const before = URL.parse(change.previous?.url ?? "")
      const after = URL.parse(info.url ?? "")
      if (before !== null && after !== null && before.href !== after.href && info.committed === true && change.previous?.loading !== true) {
        try tellPage(tab, { type: "readdressed", load: now.load, sameOrigin: before.origin === after.origin, sameDocument: true })
      }
      try tellPage(tab, { type: "committed", load: now.load, secure: secure(info.url ?? "") })
    }
  })
}, "the tab host")

/** Whether Ask Alpha is raised over the app, where all of a page drawn below it is Alpha's to touch. */
const raised = (view: { readonly assistant: string }): boolean => view.assistant !== "Bar"

function presentable(s: Browser, where: ShellState, above: Layers.Layers, deviceShowing: boolean): number {
  return deviceShowing && showing(where, "Browser") && where.assistant !== "Full" && !Layers.pageInert(above) && Tabs.pageShown(s) && s.erasing === "Kept"
    ? s.selected
    : 0
}

// spec/app/browser/index.md, "A launch reads the saved session, and may ask again after a failed read"; spec/app/browser/index.md, "A tab gets its native tab when it is the one shown and loads a page, and loses it if Android cannot make one"
const shown = started(effect {
  const shell = try Shell
  const layers = try Layers.Machine
  const device = try Device
  const machine = try Tabs.Machine
  const host = try TabHost
  const visibility = Stream.concat(Stream.succeed(try device.showing()), device.visible)
  const states = Stream.zipLatestAll(shell.changes, layers.changes, visibility, machine.changes)
  let wasOpen = false
  try Stream.runForEach(states, effect ([where, above, deviceShowing, s]) => {
    const open = deviceShowing && showing(where, "Browser")
    const entered = open && !wasOpen
    wasOpen = open
    if (open && Tabs.canAskRestore(s) && (s.restore.status === "Idle" || entered)) try tellTabs({ type: "askRestore" })
    const aimed = try (try Pages).aimed(s.selected)
    if (open && Tabs.steady(s) && !s.native.includes(s.selected) && Option.isSome(aimed)) {
      const p = try pageOf(s.selected)
      if (p.phase === "Blank") try tellPage(s.selected, { type: "submit", i: inputOf(aimed.value) })
    }
    try present(presentable(s, where, above, deviceShowing), host, raised(where))
  })
}, "showing the page")

effect function present(tab: number, host: TabHost.Shape, assistantRaised: boolean): void!! {
  const place = placeOfPage()
  if (host.web !== undefined) {
    try sync(() => host.web?.present(tab === 0 || place === undefined ? null : { id: idOf(tab), ...place }))
    return
  }
  const plugin = host.plugin
  if (Option.isNone(plugin)) return
  if (tab !== 0 && place !== undefined) {
    try ignore(drawPage(host, idOf(tab), place, assistantRaised))
    return
  }
  presented(presenting(undefined), false)
  try ignore(tryPromise(() => plugin.value.present({ session: host.session.session, id: null })))
}

// spec/app/browser/address.md, "The find bar opens over a shown page"
/**
 * Draw tab `id`'s page at `place`: above Alpha, or below it while the find bar is drawn over it, leaving Alpha its controls
 * over the page, or all of it while Ask Alpha is raised. Whether the tab host drew it.
 */
effect function drawPage(host: TabHost.Shape, id: string, place: { x: number; y: number; width: number; height: number }, assistantRaised: boolean): boolean!! {
  const plugin = host.plugin
  if (Option.isNone(plugin)) return false
  const below = findBarDrawn()
  const ticket = presenting(below ? place : undefined)
  const drew = try contained(tryPromise(() => plugin.value.present(below
    ? { session: host.session.session, id, ...place, layer: "below-host", hostRects: assistantRaised ? [{ ...place, cornerRadius: 0 }] : overPage(place) }
    : { session: host.session.session, id, ...place })), "showing the Browser page")
  presented(ticket, below && drew)
  return drew
}

// spec/app/settings/index.md, "The owner can open Password manager from the Browser menu"
/** Open Password manager with the Settings root as its parent. */
export const openPasswords: void!!(Tabs.Machine | Shell | Settings) = effect {
  const shell = try Shell
  const tabs = try Tabs.Machine
  if (!showing(try shell.get(), "Browser") || (try tabs.get()).layer !== "Menu") return
  if (!(try contained(tabs.send({ type: "uncover" }, (before) => before.layer === "Menu"), "closing the Browser menu"))) return
  if (try contained(shell.send({ type: "openView", view: "Settings" }, (before) => showing(before, "Browser")), "opening Settings")) {
    if (showing(try shell.get(), "Settings")) try contained((try Settings).send({ type: "openBrowserPasswords" }), "opening Password manager")
  }
}

// spec/app/browser/address.md, "Story: Find in page"
/** Search the current Android tab or explain that there is no page to search. */
export effect function openFindFromMenu(tab: number) {
  const tabs = try Tabs.Machine
  const view = try (try Shell).get()
  const s = try tabs.get()
  if (!showing(view, "Browser") || s.layer !== "Menu" || s.selected !== tab || Option.isNone((try TabHost).plugin)) return false
  const page = try pageOf(tab)
  if (page.phase !== "Shown") {
    try say("Load a page before finding text in it.", true)
    return false
  }
  if (!(try contained(tabs.send({ type: "uncover" }, (before) => before.layer === "Menu" && before.selected === tab), "closing the Browser menu"))) return false
  if (!showing(try (try Shell).get(), "Browser") || (try tabs.get()).selected !== tab) return false
  return try tellPage(tab, page.finding ? { type: "typeFind", empty: true } : { type: "openFind" })
}

// spec/app/browser/share.md, "Story: Open the page in another browser"
/** Place the current native tab before its plugin opens an Android action for it. */
export effect function presentForAction(id: string): boolean!!(TabHost | Tabs.Machine | Shell) {
  const tabs = try (try Tabs.Machine).get()
  const position = placeOfPage()
  const view = try (try Shell).get()
  if (position === undefined || idOf(tabs.selected) !== id || !Tabs.pageShown(tabs) || !showing(view, "Browser")) return false
  return try drawPage(try TabHost, id, position, raised(view))
}

// spec/app/browser/downloads.md, "Story: Download a file"
/** Open the phone's Browser downloads, or enter Files from the enclosing browser. */
export const openDownloads: void!!(Tabs.Machine | Shell | TabHost) = effect {
  const shell = try Shell
  if (!showing(try shell.get(), "Browser") || (try (try Tabs.Machine).get()).layer !== "Menu") return
  if (!(try tellTabs({ type: "uncover" }))) return
  if ((try TabHost).web !== undefined) {
    if (!(try contained(shell.send({ type: "goHome" }), "opening Files as an app"))) return
    if ((try shell.get()).trail.length === 0) try contained(shell.send({ type: "openView", view: "Files" }), "opening Files from Browser")
  } else {
    try contained(hosted("downloads", (plugin, session) => plugin.downloads({ session })), "opening Browser downloads")
  }
}

/** Toggle desktop-site mode on the native tab and reload its page if committed. */
export effect function toggleDesktopSite(tab: number): boolean!!(TabHost | Pages | Tabs.Machine) {
  const host = try TabHost
  if (host.web !== undefined || Option.isNone(host.plugin)) return false
  const current = try (try Tabs.Machine).get()
  if (!current.native.includes(tab)) return false
  const store = try Pages
  const next = !(try store.desktop(tab))
  const ok = try contained(hosted("setDesktopSite", (plugin, session) => plugin.setDesktopSite({ session, id: idOf(tab), enabled: next })), "toggling desktop site")
  if (ok) try store.setDesktop(tab, next)
  return ok
}

/** Draw the page shown where the Browser marks its place, once that place is drawn. */
export const placed: void!!(Tabs.Machine | Shell | Layers.Machine | Device | TabHost) = effect {
  const s = try (try Tabs.Machine).get()
  const where = try (try Shell).get()
  const above = try (try Layers.Machine).get()
  const deviceShowing = try (try Device).showing()
  try present(presentable(s, where, above, deviceShowing), try TabHost, raised(where))
}

/** The Browser's tabs, kept across restarts, and each tab's page, carried out through the phone's tab host. */
export const browser = Layer.provideMerge(together(tabs, told, shown), pages)

// spec/app/messages/index.md, "Only the newest read of the open conversation is shown, and it marks the shown messages read only where Alpha is the phone's SMS app"; spec/app/inbox/message.md, "Only an https link without credentials in it can be reviewed and opened; any other link stays text"; spec/app/browser/index.md, "Story: Open, pick and close tabs"
/** A link the owner chose from a message or Ask Alpha opens in one selected normal tab. */
export effect function openMessageLink(href: string, from: "Messages" | "Inbox" | "Ask Alpha" = "Messages", current: Effect.Effect<boolean> = succeed(true)): boolean!!(Tabs.Machine | Pages | Shell | TabHost) {
  const address = messageHref(href)
  const shell = try Shell
  const host = try TabHost
  if (address === undefined || (Option.isNone(host.plugin) && host.web === undefined) || (from !== "Ask Alpha" && !showing(try shell.get(), from)) || !(try current)) return false
  const input = inputOf(address)
  if (Address.verdict(input) !== "Open") return false
  if (!(try contained(shell.send({ type: "openView", view: "Browser" }), "opening a Message link"))) return false
  const tabs = try Tabs.Machine
  const steady = try race(Stream.runHead(Stream.filter(tabs.changes, Tabs.steady)), Effect.as(sleep(2500), Option.none()))
  if (Option.isNone(steady) || !showing(try shell.get(), "Browser") || !(try current)) return false
  const before = try tabs.get()
  if (!Tabs.canOpenTab(before, "Normal") || !(try tellTabs({ type: "openTab", kind: "Normal" }))) return false
  const tab = before.issued + 1
  if ((try tabs.get()).selected !== tab) return false
  const page = try pageOf(tab)
  if (!Address.canSubmit(page, input)) return false
  try (try Pages).aim(tab, address)
  if (!(try tellPage(tab, { type: "submit", i: input }))) return false
  return try tellTabs({ type: "uncover" })
}

// spec/app/browser/index.md, "One layer at a time covers the page, and Back uncovers it"; spec/app/browser/address.md, "Back and forward move through the tab's own pages"
/** Back inside the Browser: the layer over the page, then the tab's own page before. Whether it took one. */
export const back: boolean!!(Tabs.Machine | Pages) = effect {
  const machine = try Tabs.Machine
  const s = try machine.get()
  if (Tabs.canUncover(s)) return try tellTabs({ type: "uncover" })
  const p = try pageOf(s.selected)
  if (Address.canGoBack(p)) return try tellPage(s.selected, { type: "goBack" })
  return false
}
