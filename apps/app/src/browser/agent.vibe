// spec/app/browser/index.md, "Story: Let the agent open a page"; spec/app/approvals/direct.md, "Story: Let Alpha show me things without asking each time"
import { NOT_DISPATCHED } from "@elizaos/agent/client"
import type { DeviceOperation } from "@elizaos/agent/operations"
import * as Browser from "../../gen/app__browser.effect.vibe"
import { Machine as Shell } from "../../gen/app__shell.effect.vibe"
import { contained } from "../runtime/reactor.vibe"
import * as Address from "../../gen/app__browser__address.effect.vibe"
import { Pages, inputOf } from "./browser.vibe"

/** The agent's operations the Browser answers: a page to open, and its tabs to show. */
export type Browsing = Extract<DeviceOperation, { type: "browser_navigate" | "browser_tabs_show" }>

const refused = { kind: "refused", code: NOT_DISPATCHED } as const
const applied = { kind: "applied" } as const

/** What the address rules look at in an address the agent named. */
function proposalOf(url: string): { secure: boolean; userInfo: boolean } {
  const parsed = URL.parse(url)
  return { secure: parsed?.protocol === "https:", userInfo: parsed !== null && (parsed.username !== "" || parsed.password !== "") }
}

effect function stillApproved(current: () => Promise<boolean>): boolean!! {
  return tryPromise(current) catch () => false
}

// spec/app/browser/index.md, "The agent opens only an HTTPS address with no user name or password in it, in a new normal tab, one at a time"; spec/app/browser/index.md, "The agent's page never takes the owner's place, and the agent is told whenever its tab is taken away"
/** The page the owner approved on Ask Alpha's card opens as shown: a new normal tab of the agent's, with its native tab, beside the owner's. Answers whether it opened. */
effect function opened(url: string): boolean!!(Browser.Machine | Pages | Shell) {
  const machine = try Browser.Machine
  const { secure, userInfo } = proposalOf(url)
  if (!Browser.canAgentOpen(try machine.get(), secure, userInfo)) return false
  if (!(try contained(machine.send({ type: "agentOpen", secure, userInfo }), "the agent's page"))) return false
  const tab = (try machine.get()).agent
  if (tab === 0) return false
  const pages = try Pages
  try pages.aim(tab, url)
  const runtime = try pages.of(tab)
  const sent = try promise(() => runtime.runPromiseExit(Address.Machine.use((page) => page.send({ type: "submit", i: inputOf(url) }))).then((ended) => ended._tag === "Success"))
  if (sent) try contained((try Shell).send({ type: "agentOpenView", view: "Browser" }), "the agent's page beside the owner's")
  return sent
}

// spec/app/browser/index.md, "One layer at a time covers the page, and Back uncovers it"
/** The Browser's own tab list, opened over the page. Answers whether it opened. */
effect function tabsShown(): boolean!!(Browser.Machine | Shell) {
  const machine = try Browser.Machine
  if (!(try contained((try Shell).send({ type: "agentOpenView", view: "Browser" }), "the agent showing the tabs"))) return false
  if ((try machine.get()).layer === "Switcher") return true
  return try contained(machine.send({ type: "cover", layer: "Switcher" }), "the agent showing the tabs")
}

/**
 * Carry out a Browser operation the owner approved, or one the agent may run directly for the owner's current
 * message; `current` says the approval still holds. The SDK owns approval, claim and dispatch journaling.
 */
export effect function browserAction(operation: Browsing, current: () => Promise<boolean>): unknown!!(Browser.Machine | Pages | Shell) {
  if (!(try stillApproved(current))) return refused
  const done = operation.type === "browser_tabs_show" ? (try tabsShown()) : (try opened(operation.url))
  return done ? applied : refused
}
