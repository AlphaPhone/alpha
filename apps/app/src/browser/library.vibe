// spec/app/browser/library.md, "Story: Keep bookmarks"; spec/app/browser/library.md, "Story: Look back through history"
import * as Library from "../../gen/app__browser__library.effect.vibe"
import type { Effect as Out, Event, Job as Writing } from "../../gen/app__browser__library.effect.vibe"
import { TabHost, type TabHostFailed, hosted } from "../platform/browser.vibe"
import { type Job, answer, reacting } from "../runtime/reactor.vibe"

/** A saved bookmark, as the phone keeps it. */
export interface Mark {
  readonly url: string
  readonly title: string
}

/**
 * The lists the phone keeps, as the library last read or wrote them: the bookmarks, and history oldest first. The
 * library's rules count them; this holds what they are, for the sheet and for the next write. It holds no rule.
 */
export interface Lists {
  readonly marks: ReadonlyArray<Mark>
  readonly history: ReadonlyArray<string>
}

/**
 * The lists of this Alpha, and the page the bookmark write under way adds or removes. Until the phone's lists are
 * first read, history holds only what was visited since; the first read puts the kept history before it.
 */
export service Kept {
  now(): Lists
  subscribe(listener: () => void): () => void
  change(next: Lists): void
  /** The phone's lists were read, so history here is all of it. */
  hasRead(): boolean
  markRead(): void
  aim(mark: Mark): void
  aimed(): Mark | undefined
}

const kept = Layer.sync(Kept, () => {
  let lists: Lists = { marks: [], history: [] }
  let read = false
  let target: Mark | undefined
  const listeners = new Set<() => void>()
  return {
    now: () => lists,
    subscribe(listener: () => void) {
      listeners.add(listener)
      return () => { listeners.delete(listener) }
    },
    change(next: Lists) {
      lists = next
      for (const listener of [...listeners]) listener()
    },
    hasRead: () => read,
    markRead() { read = true },
    aim(mark: Mark) { target = mark },
    aimed: () => target,
  }
})

// spec/app/browser/library.md, "A page that commits in a normal tab is counted in history, which keeps the newest hundred"
/** A page committed in a normal tab: history gains it, and loses its oldest page when full. */
export effect function remember(url: string): void!!Kept {
  if (url === "") return
  const lists = try Kept
  lists.change({ ...lists.now(), history: [...lists.now().history, url].slice(-Library.maxHistory) })
}

// spec/app/browser/library.md, "Clearing all browsing data empties history at once"
/** Clearing all browsing data emptied history. */
export effect function forgetHistory(): void!!Kept {
  const lists = try Kept
  lists.change({ ...lists.now(), history: [] })
}

// spec/app/browser/library.md, "A page that commits in a normal tab is counted in history, which keeps the newest hundred"; spec/app/browser/index.md, "A stale session is written once it has been read, one write at a time, and never while browsing data is being cleared"
/** History as the next saved session keeps it: all of it once read, or else the kept history and what was visited since. */
export effect function historyToSave(): ReadonlyArray<string>!TabHostFailed!(Kept | TabHost) {
  const lists = try Kept
  if (lists.hasRead()) return lists.now().history
  const saved = try hosted("browsingState", (plugin, session) => plugin.browsingState({ session }))
  return [...saved.history, ...lists.now().history].slice(-Library.maxHistory)
}

const entriesOf = (list: { readonly urls: ReadonlyArray<string>; readonly entries?: ReadonlyArray<{ readonly url: string; readonly title?: string }> }): Mark[] =>
  list.urls.map((url) => ({ url, title: list.entries?.find((entry) => entry.url === url)?.title ?? "" }))

// spec/app/browser/library.md, "The latest read gives the bookmarks and history, says it could not read them, or finds the bookmark list damaged and offers once to replace it"
effect function loading(ticket: number): Event!!(Kept | TabHost) {
  const failed: Event = { type: "loaded", ticket, ok: false, damaged: false, count: 0, entries: 0 }
  const read = effect {
    const marks = try hosted("bookmarks", (plugin, session) => plugin.bookmarks({ session }))
    const kept = try hosted("browsingState", (plugin, session) => plugin.browsingState({ session }))
    return { marks: entriesOf(marks).slice(0, Library.maxMarks), history: kept.history.slice(-Library.maxHistory) }
  } catch () => undefined
  const lists = try Kept
  const found = read === undefined ? undefined : { ...read, history: lists.hasRead() ? lists.now().history : [...read.history, ...lists.now().history].slice(-Library.maxHistory) }
  if (found === undefined) return failed
  lists.change(found)
  lists.markRead()
  return { type: "loaded", ticket, ok: true, damaged: false, count: found.marks.length, entries: found.history.length }
}

// spec/app/browser/library.md, "A write that lands changes the lists, and one that fails changes nothing and says so"; spec/app/browser/library.md, "Pages visited while history is being cleared stay in it"
effect function marked(mark: Mark | undefined, saved: boolean): boolean!!(Kept | TabHost) {
  if (mark === undefined) return false
  const lists = try Kept
  const done = effect {
    const list = try hosted("setBookmark", (plugin, session) => plugin.setBookmark({ session, url: mark.url, saved, ...(saved ? { title: mark.title } : {}) }))
    lists.change({ ...lists.now(), marks: entriesOf(list) })
    return true
  } catch () => false
  return done
}

effect function cleared(): boolean!!(Kept | TabHost | Library.Machine) {
  const lists = try Kept
  const left = lists.now().history.slice((try (try Library.Machine).get()).kept)
  const done = effect {
    const saved = try hosted("browsingState", (plugin, session) => plugin.browsingState({ session }))
    try hosted("saveBrowsingState", (plugin, session) => plugin.saveBrowsingState({ session, tabs: saved.tabs, cur: saved.cur, history: left }))
    lists.change({ ...lists.now(), history: left })
    return true
  } catch () => false
  return done
}

effect function writing(write: number, job: Writing): Event!!(Kept | TabHost | Library.Machine) {
  const mark = (try Kept).aimed()
  const ok = match (job) {
    when "Adding": try marked(mark, true);
    when "Removing": try marked(mark, false);
    when "Repairing": false;
    when "Clearing": try cleared();
    when "Idle": false;
  }
  return { type: "written", ticket: write, ok }
}

function carry(fx: Out): Job<Event, Kept | TabHost | Library.Machine, []> {
  return match (fx) {
    when { tag: "Load", let ticket }: answer("load", loading(ticket), { type: "loaded", ticket, ok: false, damaged: false, count: 0, entries: 0 });
    when { tag: "Write", let write, let job }: answer("write", writing(write, job), { type: "written", ticket: write, ok: false });
  }
}

// spec/app/browser/library.md, "The library is read when it opens and again on request, never under a write"
/** The bookmarks and history, read when the Browser opens, over the lists of this Alpha. */
export const library = reacting(Library, { open: [{ type: "askRead" }], carry })

/** The lists the Browser keeps for this Alpha: one set for its life, read again from the phone after a restart. */
export { kept }
