// spec/app/browser/library.md, "The library is read when it opens and again on request, never under a write"; spec/app/browser/library.md, "The latest read gives the bookmarks and history, says it could not read them, or finds the bookmark list damaged and offers once to replace it"; spec/app/browser/library.md, "Bookmarking the shown page adds it when it is an HTTPS page without a user name or password and fewer than a hundred are saved, and otherwise says why not"; spec/app/browser/library.md, "A write that lands changes the lists, and one that fails changes nothing and says so"
import { bookmarkBrowserUrl, type BrowserBookmarkList, type BrowserPageBinding } from "@elizaos/os-bridges"
import { Machine as Tabs } from "../../gen/app__browser.effect.vibe"
import * as Library from "../../gen/app__browser__library.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { TabHost, hosted } from "../platform/index.vibe"
import { answer, contained, reacting } from "../runtime/index.vibe"
import { Pages, idOf } from "./browser.vibe"

export type Bookmark = { readonly url: string; readonly title?: string }
type BookmarkWrite = { readonly ticket: number; readonly entry: Bookmark; readonly saved: boolean }

/** The native rows and the address bound to a library write. */
export service LibraryRows {
  readonly turn: Semaphore.Semaphore
  bookmarks(): readonly Bookmark[]!!
  keep(bookmarks: readonly Bookmark[]): void!!
  prepare(intent: BookmarkWrite): void!!
  take(ticket: number): (BookmarkWrite | undefined)!!
}

const rows = Layer.effect(LibraryRows, effect {
  let stored: readonly Bookmark[] = []
  let offered: BookmarkWrite | undefined
  const turn = try Semaphore.make(1)
  return {
    turn,
    bookmarks: () => sync(() => stored),
    keep: (bookmarks: readonly Bookmark[]) => sync(() => { stored = bookmarks }),
    prepare: (intent: BookmarkWrite) => sync(() => { offered = intent }),
    take: (ticket: number) => sync(() => {
      if (offered?.ticket !== ticket) return undefined
      const intent = offered
      offered = undefined
      return intent
    }),
  }
})

function entries(saved: BrowserBookmarkList): Bookmark[] {
  const titles = new Map(saved.entries?.map((entry) => [entry.url, entry.title]))
  return [...new Set(saved.urls.filter(bookmarkBrowserUrl))].slice(0, Library.maxMarks).map((url) => {
    const title = titles.get(url)
    return title ? { url, title } : { url }
  })
}

effect function load(ticket: number): Library.Event!!(TabHost | Pages | LibraryRows | Library.Machine) {
  return effect {
    const saved = try hosted("bookmarks", (plugin, session) => plugin.bookmarks({ session }))
    const bookmarks = entries(saved)
    const visits = try (try Pages).visits()
    const current = try (try Library.Machine).get()
    if (Library.canLoaded(current, ticket, bookmarks.length, visits.length)) try (try LibraryRows).keep(bookmarks)
    return { type: "loaded", ticket, ok: true, damaged: false, count: bookmarks.length, entries: visits.length }
  } catch () => ({ type: "loaded", ticket, ok: false, damaged: false, count: 0, entries: 0 })
}

/** Save or remove the exact entry the owner chose, after the library has read the saved list. */
export effect function setMark(entry: Bookmark, saved: boolean): boolean!!(LibraryRows | Library.Machine) {
  const rows = try LibraryRows
  return try Semaphore.withPermit(rows.turn, effect {
    const machine = try Library.Machine
    const s = try machine.get()
    const known = (try rows.bookmarks()).some((bookmark) => bookmark.url === entry.url)
    if (known === saved) return false
    const secure = bookmarkBrowserUrl(entry.url)
    if (saved ? !Library.canMark(s, secure, false) : !Library.canUnmark(s)) return false
    const ticket = s.write + 1
    const changes = !saved || (secure && s.marks < Library.maxMarks)
    if (changes) try rows.prepare({ ticket, entry, saved })
    const sent = try contained(machine.send(saved ? { type: "mark", secure, userInfo: false } : { type: "unmark" }), "choosing a bookmark")
    if (!sent) try rows.take(ticket)
    return changes && sent
  })
}

/** Bind a menu bookmark to the page the owner saw, before asking the saved list to change. */
export effect function markPage(binding: BrowserPageBinding, saved: boolean): boolean!!(TabHost | Tabs | Shell | LibraryRows | Library.Machine) {
  const tabs = try (try Tabs).get()
  const host = (try TabHost).session
  if (tabs.layer !== "Menu" || !showing(try (try Shell).get(), "Browser") || !host.current(binding, idOf(tabs.selected))) return false
  const title = host.info(binding.id)?.title
  return try setMark(title && title !== binding.url ? { url: binding.url, title } : { url: binding.url }, saved)
}

effect function bookmarkWritten(ticket: number): Library.Event!!(TabHost | LibraryRows | Library.Machine) {
  const rows = try LibraryRows
  const intent = try rows.take(ticket)
  const failed: Library.Event = { type: "written", ticket, ok: false }
  if (intent === undefined) return failed
  return effect {
    const { entry, saved } = intent
    const result = try hosted("setBookmark", (plugin, session) => plugin.setBookmark({ session, ...entry, saved }))
    const list = entries(result)
    if (list.some((one) => one.url === entry.url) !== saved) return failed
    const current = try (try Library.Machine).get()
    if (Library.canWritten(current, ticket)) try rows.keep(list)
    return { type: "written", ticket, ok: true }
  } catch () => failed
}

/** The Browser's library reads the phone's saved bookmarks and its current visit list. */
export const library = Layer.provideMerge(reacting(Library, {
  carry: (fx: Library.Effect) => match (fx) {
    when { tag: "Load", let ticket }: answer("read library", load(ticket), { type: "loaded", ticket, ok: false, damaged: false, count: 0, entries: 0 } as Library.Event);
    when { tag: "Write", let write }: answer("write library", bookmarkWritten(write), { type: "written", ticket: write, ok: false } as Library.Event);
  },
}), rows)
