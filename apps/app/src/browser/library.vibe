// spec/app/browser/library.md, "The library is read when it opens and again on request, never under a write"; spec/app/browser/library.md, "The latest read gives the bookmarks and history, says it could not read them, or finds the bookmark list damaged and offers once to replace it"; spec/app/browser/library.md, "Bookmarking the shown page adds it when it is an HTTPS page without a user name or password and fewer than a hundred are saved, and otherwise says why not"; spec/app/browser/library.md, "A write that lands changes the lists, and one that fails changes nothing and says so"
import { bookmarkBrowserUrl, type BrowserBookmarkList, type BrowserPageBinding } from "@elizaos/os-bridges"
import { Machine as Tabs } from "../../gen/app__browser.effect.vibe"
import * as Library from "../../gen/app__browser__library.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { TabHost, hosted } from "../platform/browser.vibe"
import { readWebBookmarks, saveWebBrowsing, writeWebBookmark, type FrameRequest } from "../platform/browserWeb.vibe"
import { answer, contained, reacting, started, together } from "../runtime/reactor.vibe"
import { Pages, idOf, pageOf } from "./browser.vibe"

export type Bookmark = { readonly url: string; readonly title?: string }
type BookmarkWrite = { readonly ticket: number; readonly entry: Bookmark; readonly saved: boolean }
export type BookmarkPage = BrowserPageBinding | FrameRequest

/** The saved rows and the address bound to a library write. */
export service LibraryRows {
  readonly turn: Semaphore.Semaphore
  readonly subscribe: (listener: () => void) => () => void
  readonly snapshot: () => readonly Bookmark[]
  bookmarks(): readonly Bookmark[]!!
  keep(bookmarks: readonly Bookmark[]): void!!
  prepare(intent: BookmarkWrite): void!!
  take(ticket: number): (BookmarkWrite | undefined)!!
}

const rows = Layer.effect(LibraryRows, effect {
  let stored: readonly Bookmark[] = []
  let offered: BookmarkWrite | undefined
  const listeners = new Set<() => void>()
  const turn = try Semaphore.make(1)
  return {
    turn,
    subscribe: (listener: () => void) => {
      listeners.add(listener)
      return () => { listeners.delete(listener) }
    },
    snapshot: () => stored,
    bookmarks: () => sync(() => stored),
    keep: (bookmarks: readonly Bookmark[]) => sync(() => {
      stored = bookmarks
      for (const listener of [...listeners]) listener()
    }),
    prepare: (intent: BookmarkWrite) => sync(() => { offered = intent }),
    take: (ticket: number) => sync(() => {
      if (offered?.ticket !== ticket) return undefined
      const intent = offered
      offered = undefined
      return intent
    }),
  }
})

function entries(saved: BrowserBookmarkList): Bookmark[] {
  const titles = new Map(saved.entries?.map((entry) => [entry.url, entry.title]))
  return [...new Set(saved.urls.filter(bookmarkBrowserUrl))].slice(0, Library.maxMarks).map((url) => {
    const title = titles.get(url)
    return title ? { url, title } : { url }
  })
}

effect function load(ticket: number): Library.Event!!(TabHost | Pages | LibraryRows | Library.Machine) {
  return effect {
    const host = try TabHost
    const saved = host.web === undefined ? try hosted("bookmarks", (plugin, session) => plugin.bookmarks({ session })) : try readWebBookmarks()
    const bookmarks = entries(saved)
    const visits = try (try Pages).visits()
    const current = try (try Library.Machine).get()
    if (Library.canLoaded(current, ticket, bookmarks.length, visits.length)) try (try LibraryRows).keep(bookmarks)
    return { type: "loaded", ticket, ok: true, damaged: false, count: bookmarks.length, entries: visits.length }
  } catch (cause) => ({
    type: "loaded",
    ticket,
    ok: false,
    damaged: /recovery|damaged/i.test(String(cause)),
    count: 0,
    entries: 0,
  })
}

effect function setMarkInside(entry: Bookmark, saved: boolean): boolean!!(LibraryRows | Library.Machine) {
  const rows = try LibraryRows
  const machine = try Library.Machine
  const s = try machine.get()
  const known = (try rows.bookmarks()).some((bookmark) => bookmark.url === entry.url)
  if (known === saved) return false
  const secure = bookmarkBrowserUrl(entry.url)
  if (saved ? !Library.canMark(s, secure, false) : !Library.canUnmark(s)) return false
  const ticket = s.write + 1
  const changes = !saved || (secure && s.marks < Library.maxMarks)
  if (changes) try rows.prepare({ ticket, entry, saved })
  const sent = try contained(machine.send(saved ? { type: "mark", secure, userInfo: false } : { type: "unmark" }), "choosing a bookmark")
  if (!sent) try rows.take(ticket)
  return changes && sent
}

/** Save or remove the exact entry the owner chose, after the library has read the saved list. */
export effect function setMark(entry: Bookmark, saved: boolean): boolean!!(LibraryRows | Library.Machine) {
  const rows = try LibraryRows
  return try Semaphore.withPermit(rows.turn, setMarkInside(entry, saved))
}

/** Bind a menu bookmark to the current shown native page or opaque frame before accepting the write. */
export effect function markPage(binding: BookmarkPage, saved: boolean): boolean!!(TabHost | Tabs | Shell | Pages | LibraryRows | Library.Machine) {
  const rows = try LibraryRows
  return try Semaphore.withPermit(rows.turn, effect {
    const tabs = try (try Tabs).get()
    const host = try TabHost
    const id = idOf(tabs.selected)
    if (tabs.layer !== "Menu" || binding.id !== id || !showing(try (try Shell).get(), "Browser")) return false
    let title: string | undefined
    if ("load" in binding) {
      const page = try pageOf(tabs.selected)
      if (page.phase !== "Shown" || page.load !== binding.load || (try sync(() => host.web?.current(id, page.load))) !== binding) return false
      title = (try sync(() => host.web?.info(id)))?.title
    } else {
      if (!host.session.current(binding, id)) return false
      title = host.session.info(id)?.title
    }
    return try setMarkInside(title && title !== binding.url ? { url: binding.url, title } : { url: binding.url }, saved)
  })
}

effect function bookmarkWritten(ticket: number): Library.Event!!(TabHost | LibraryRows | Library.Machine) {
  const rows = try LibraryRows
  const intent = try rows.take(ticket)
  const failed: Library.Event = { type: "written", ticket, ok: false }
  if (intent === undefined) return failed
  return effect {
    const { entry, saved } = intent
    const host = try TabHost
    const before = (try rows.bookmarks()).map((bookmark) => bookmark.url)
    const result = host.web === undefined
      ? try hosted("setBookmark", (plugin, session) => plugin.setBookmark({ session, ...entry, saved }))
      : try writeWebBookmark({ ...entry, saved, before, limit: Library.maxMarks })
    const list = entries(result)
    if (list.some((one) => one.url === entry.url) !== saved) return failed
    const current = try (try Library.Machine).get()
    if (Library.canWritten(current, ticket)) try rows.keep(list)
    return { type: "written", ticket, ok: true }
  } catch () => failed
}

effect function clearedHistory(ticket: number): Library.Event!!(TabHost | Pages | Library.Machine) {
  return effect {
    const host = try TabHost
    const pages = try Pages
    if (host.web !== undefined) try saveWebBrowsing({})
    const current = try (try Library.Machine).get()
    if (Library.canWritten(current, ticket)) try pages.keepVisits([])
    return { type: "written", ticket, ok: true }
  } catch () => ({ type: "written", ticket, ok: false })
}

effect function repairedBookmarks(ticket: number): Library.Event!!(LibraryRows | Library.Machine) {
  const current = try (try Library.Machine).get()
  if (Library.canWritten(current, ticket)) try (try LibraryRows).keep([])
  return { type: "written", ticket, ok: true }
}

// spec/app/browser/library.md, "A page that commits in a normal tab is counted in history, which keeps the newest hundred"; spec/app/browser/library.md, "Clearing all browsing data empties history at once"
const syncHistory = started(effect {
  const machine = try Library.Machine
  const pages = try Pages
  try Stream.runForEach(pages.visited, effect () => {
    const s = try machine.get()
    if (Library.canVisited(s)) try contained(machine.send({ type: "visited" }), "counting a visited page")
  })
}, "library history visits")

const syncWiped = started(effect {
  const machine = try Library.Machine
  const tabs = try Tabs
  let wasRunning = false
  try Stream.runForEach(tabs.changes, effect (s) => {
    const finished = wasRunning && s.erasing === "Kept" && s.kept.length === 0
    wasRunning = s.erasing === "Running"
    if (finished) try contained(machine.send({ type: "wiped" }), "emptying library history")
  })
}, "library history clear")

effect function writeLibrary(ticket: number, job: Library.Job): Library.Event!!(TabHost | Pages | LibraryRows | Library.Machine) {
  if (job === "Clearing") return try clearedHistory(ticket)
  if (job === "Repairing") return try repairedBookmarks(ticket)
  return try bookmarkWritten(ticket)
}

/** The Browser's library reads the saved bookmarks and the current visit list. */
export const library = Layer.provideMerge(together(reacting(Library, {
  carry: (fx: Library.Effect) => match (fx) {
    when { tag: "Load", let ticket }: answer("read library", load(ticket), { type: "loaded", ticket, ok: false, damaged: false, count: 0, entries: 0 } as Library.Event);
    when { tag: "Write", let write, let job }: answer("write library", writeLibrary(write, job), { type: "written", ticket: write, ok: false } as Library.Event);
  },
}), syncHistory, syncWiped), rows)
