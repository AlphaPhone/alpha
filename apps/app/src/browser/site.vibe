// spec/app/browser/site.md, "Story: Let a site use the camera, microphone or location"; spec/app/browser/site.md, "Story: Sign in to a site"; spec/app/browser/site.md, "Story: Clear a site's data"
import * as Tabs from "../../gen/app__browser.effect.vibe"
import * as Site from "../../gen/app__browser__site.effect.vibe"
import { type Job, answer, contained, reacting, run, started, together } from "../runtime/reactor.vibe"

/** Host callbacks for site permission prompts, HTTP authentication and per-site storage clearing. */
export service SitePort {
  askAndroid(want: Site.Want): boolean!!
  grant(page: number, want: Site.Want): void!!
  refuse(page: number): void!!
  authenticate(page: number, user: string, password: Site.SecretSitePassword): void!!
  clearOrigin(ticket: number): boolean!!
}

/** Default site port used when the native browser plugin does not supply custom site prompts. */
export const defaultSitePort = Layer.succeed(SitePort, {
  askAndroid: () => succeed(false),
  grant: () => Effect.void,
  refuse: () => Effect.void,
  authenticate: () => Effect.void,
  clearOrigin: () => succeed(true),
})

function carry(fx: Site.Effect): Job<Site.Event, SitePort, []> {
  return match (fx) {
    when { tag: "AskAndroid", let want }: answer("site ask android", effect {
      const granted = (try (try SitePort).askAndroid(want))
      return { type: "androidAnswered", granted } as Site.Event
    }, { type: "androidAnswered", granted: false });
    when { tag: "Grant", let page, let want }: run("site grant", effect { try (try SitePort).grant(page, want) });
    when { tag: "Refuse", let page }: run("site refuse", effect { try (try SitePort).refuse(page) });
    when { tag: "Authenticate", let page, let user, let password }: run("site auth", effect { try (try SitePort).authenticate(page, user, password) });
    when { tag: "Clear", let ticket }: answer("site clear", effect {
      const ok = try (try SitePort).clearOrigin(ticket)
      return { type: "cleared", ticket, ok } as Site.Event
    }, { type: "cleared", ticket, ok: false });
  }
}

const followTabs = started(effect {
  const tabs = try Tabs.Machine
  const site = try Site.Machine
  let lastSelected = 0
  let lastErasing: Tabs.Erasing | undefined = undefined
  try Stream.runForEach(tabs.changes, effect (state) => {
    if (state.selected !== lastSelected) {
      lastSelected = state.selected
      if (Site.canShow(try site.get(), state.selected)) {
        try contained(site.send({ type: "show", tab: state.selected }), "updating site foreground tab")
      }
    }
    if (state.erasing === "Kept" && lastErasing !== "Kept") {
      try contained(site.send({ type: "wiped" }), "wiping remembered site decisions")
    }
    lastErasing = state.erasing
  })
}, "browser site tab tracking")

/** Site permissions, HTTP sign-in and per-site data clearing for the Browser. */
export const site = Layer.provideMerge(
  together(reacting(Site, { carry }), followTabs),
  defaultSitePort,
)
