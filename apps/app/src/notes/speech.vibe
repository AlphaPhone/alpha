// spec/notes/recorder.md, "Segments are transcribed in order while the recording goes on, and never past the audio"; spec/notes/audio.md, "A transcript is read in 25-second windows, each checked against the exact recording first"
import type { Route } from "../../gen/voice__route.ts"
import { Native } from "../platform/native.vibe"
import { VoiceRoute, attemptFailed, type VoiceAccount } from "../voice/route.vibe"
import { decodeTranscribe } from "./notes.schema.vibe"
import { randomId } from "./platform.ts"

/** The window of a saved voice note's recording a transcript request reads. */
export interface SavedWindow { readonly savedNoteId: string; readonly savedDurationMs: number; readonly offsetMs: number }

/** A transcription that gave no words: the refusal code the route or the recorder gave, if any. */
export interface SpeechRefused { readonly code: string | undefined }

const plugin = "AlphaVoiceCloud"

function request(route: Route, account: VoiceAccount, recordingId: string, requestId: string, saved: SavedWindow | undefined) {
  const window = saved === undefined ? {} : { savedNoteId: saved.savedNoteId, savedDurationMs: saved.savedDurationMs, offsetMs: saved.offsetMs }
  if (route === "Cloud" && account.kind === "cloud") {
    return { method: "transcribeRecording", args: { recordingId, requestId, ...window, environment: account.environment, credentialId: account.credentialId } }
  }
  if (route === "Direct" && account.kind === "own") {
    return { method: "transcribeOwnRecording", args: { recordingId, requestId, ...window, providerRevision: account.revision } }
  }
  if (saved !== undefined) return undefined
  return { method: "transcribeLocalRecording", args: { recordingId, requestId } }
}

/** The first string `code` on an error or the causes it carries. */
export function refusalCode(error: unknown): string | undefined {
  let current: unknown = error
  for (let depth = 0; depth < 4 && typeof current === "object" && current !== null; depth += 1) {
    if ("code" in current && typeof current.code === "string") return current.code
    current = "cause" in current ? current.cause : undefined
  }
  return undefined
}

/** Transcribe a live segment or a saved window on the speech route voice admits now; a saved window is read only over Cloud or the owner's own provider. */
export effect function transcribeOnRoute(routes: VoiceRoute.Shape, native: Native.Shape, recordingId: string, saved?: SavedWindow): string | SpeechRefused!! {
  const requestId = randomId()
  return routes.run((route: Route, heard) => effect {
    const account = try routes.account()
    const call = request(route, account, recordingId, requestId, saved)
    if (call === undefined) throw attemptFailed({ code: "unavailable" })
    const raw = try (native.invoke(plugin, call.method, call.args) catch effect (error) => { throw attemptFailed(error) })
    const reply = try (decodeTranscribe(raw) catch effect () => { throw attemptFailed({ code: "voice-stt-response" }) })
    if (reply.local !== undefined && reply.local !== (route === "Device")) throw attemptFailed({ code: "voice-stt-response" })
    try heard()
    return reply.text
  }) catch (error): SpeechRefused => ({ code: refusalCode(error.cause) ?? refusalCode(error) })
}
