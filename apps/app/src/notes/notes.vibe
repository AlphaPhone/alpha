// spec/app/notes/index.md, "Story: See my notes"; spec/app/notes/index.md, "Story: Open a note"; spec/app/notes/index.md, "Story: Organise my notes"; spec/app/notes/index.md, "Story: Select and delete notes"; spec/app/notes/index.md, "Story: Another owner never sees my notes"
import * as Actions from "../../gen/app__notes__actions.effect.vibe"
import * as Notes from "../../gen/app__notes.effect.vibe"
import * as Editor from "../../gen/app__notes__editor.effect.vibe"
import * as Link from "../../gen/app__notes__linkNote.effect.vibe"
import * as Voice from "../../gen/app__notes__voice.effect.vibe"
import * as Recorder from "../../gen/app__notes__recording.effect.vibe"
import * as Previous from "../../gen/app__notes__previous.effect.vibe"
import * as Transfer from "../../gen/app__notes__transfer.effect.vibe"
import * as Trash from "../../gen/app__notes__trash.effect.vibe"
import type { Actor, Request } from "../../gen/app__notes__note.effect.vibe"
import { unlinked } from "../../gen/app__notes__note.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { Machine as Layers, pageInert } from "../../gen/app__shell__layers.effect.vibe"
import { Machine as Toasts, duration } from "../../gen/app__notices__toasts.effect.vibe"
import { type Said, offer, say, withdraw } from "../notices/toasts.vibe"
import type { Agent } from "../platform/agent.vibe"
import { Device } from "../platform/device.vibe"
import { NoteStore, noteStore } from "../platform/notes.vibe"
import { ownerAt } from "../platform/owner.vibe"
import { type Job, answer, reacting, run, started, stream, together, untimed } from "../runtime/reactor.vibe"
import { Time } from "../runtime/time.vibe"
import { actions } from "./actions.vibe"
import { NoteContent, audioIdOf, formatChanged, fromSaved, noteContent, numberOf, savedVoice } from "./content.vibe"
import { NoteEditor, editing } from "./editor.vibe"
import { Opens, opens } from "./opens.vibe"
import { ownerRecords, recording } from "./recording.vibe"
import { ownerEarlier, previous } from "./previous.vibe"
import { transfers } from "./transfer.vibe"
import { VoiceReview, sides } from "./sides.vibe"
import { trashing } from "./trash.vibe"

const phone: Actor = "Phone"
type DeleteSelection = Extract<Notes.Effect, { readonly tag: "DeletesSelection" }>
type SelectionDeleted = Extract<Notes.Event, { readonly type: "selectionDeleted" }>
type DeletedNote = { readonly id: number; readonly record: string; readonly deletedAt: string }
type SelectionUndo = Agent | NoteStore | Trash.Machine | Toasts | Said | Time

effect function inFront(): boolean!!(Shell | Layers | Device) {
  const view = try (try Shell).get()
  return showing(view, "Notes") && !view.drawer && (try (try Device).showing()) && !pageInert(try (try Layers).get())
}

/** Confirm the visible selection while the notes list and Recently deleted still admit the move. */
export effect function deleteSelection() {
  if (!(try inFront())) return
  const bin = try (try Trash.Machine).get()
  const active = try (try Editor.Machine).get()
  const available = !active.showing && !Editor.waiting(active) && !bin.showing && Trash.ready(bin)
  if (available) try ignore((try Notes.Machine).send({ type: "deleteSelection", available }, "Owner"))
}

effect function trashOutcome(bin: Trash.Machine.Shape, owner: number, ticket: number) {
  const concluded = try Stream.runHead(Stream.filter(bin.changes, (state) =>
    state.owner !== owner || state.attempt.id !== ticket || (state.attempt.outcome !== "Recorded" && state.attempt.outcome !== "Sent")))
  return Option.isNone(concluded) || concluded.value.owner !== owner || concluded.value.attempt.id !== ticket
    ? "Unknown" : concluded.value.attempt.outcome
}

effect function selectedDeletion(fx: DeleteSelection) {
  const list = try Notes.Machine
  const bin = try Trash.Machine
  const content = try NoteContent
  const identity = ownerAt() catch () => ""
  const first = try content.collection()
  const removedIds: number[] = []
  const result = (known: boolean): SelectionDeleted => ({ type: "selectionDeleted", turn: fx.turn, removedIds, known })
  if (identity === "" || first.owner !== identity || first.version !== fx.revision || numberOf("owner", identity) !== fx.owner) return result(true)
  let revision = fx.revision
  for (const id of fx.ids) {
    const active = try list.get()
    if (active.owner !== fx.owner || active.selection !== "Deleting" || active.selectionTurn !== fx.turn ||
      !(try inFront()) || (ownerAt() catch () => "") !== identity || (try bin.get()).owner !== fx.owner) return result(true)
    const note = first.noteByNumber.get(id)
    if (note === undefined) return result(true)
    const audio = audioIdOf(note)
    const event: Trash.Event = { type: "discardSelected", id, revision, recording: audio === "" ? 0 : numberOf("recording", audio), now: untimed }
    const sent = bin.send(event, "Owner") catch () => undefined
    if (sent === undefined) return result(true)
    const outcome = try trashOutcome(bin, fx.owner, sent.state.attempt.id)
    if (outcome !== "Confirmed") return result(outcome !== "Unknown")
    removedIds.push(id)
    revision += 1
  }
  return result(true)
}

effect function restoreSelection(identity: string, notes: ReadonlyArray<DeletedNote>, until: number): void!!SelectionUndo {
  if ((try (try Time).now()) >= until) return
  const bin = try Trash.Machine
  const store = try NoteStore
  const owner = numberOf("owner", identity)
  let restored = 0
  let unknown = false
  for (const note of notes) {
    if ((ownerAt() catch () => "") !== identity || (try bin.get()).owner !== owner) break
    const latest = store.read() catch () => undefined
    if (latest?.trash?.some((row) => row.note.id === note.record && row.deletedAt === note.deletedAt) !== true ||
      (ownerAt() catch () => "") !== identity) break
    const event: Trash.Event = { type: "recoverSelected", id: note.id, revision: latest.revision + 1, deletedAt: Date.parse(note.deletedAt), now: untimed }
    const sent = bin.send(event, "Owner") catch () => undefined
    if (sent === undefined) break
    const outcome = try trashOutcome(bin, owner, sent.state.attempt.id)
    if (outcome !== "Confirmed") {
      unknown = outcome === "Unknown"
      break
    }
    restored += 1
  }
  if ((ownerAt() catch () => "") !== identity) return
  const count = restored === 1 ? "Restored 1 note." : `Restored ${restored} notes.`
  if (restored === notes.length) try say(count)
  else try say(`${restored > 0 ? `${count} ` : ""}${unknown ? "Alpha couldn’t confirm the next recovery." : "The remaining notes couldn’t be restored."}`, true)
}

effect function offerSelectionUndo(fx: DeleteSelection, result: SelectionDeleted): void!!SelectionUndo {
  const count = result.removedIds.length
  if (count === 0 || !result.known) return
  const identity = ownerAt() catch () => ""
  if (identity === "" || numberOf("owner", identity) !== fx.owner) return
  const saved = (try NoteStore).read() catch () => undefined
  if ((ownerAt() catch () => "") !== identity) return
  const receipts = saved?.trash?.flatMap(({ note, deletedAt }) => {
    const id = numberOf("note", note.id)
    return result.removedIds.includes(id) && Date.parse(deletedAt) > 0 ? [{ id, record: note.id, deletedAt }] : []
  })
  const message = count === 1 ? "Deleted" : `Deleted ${count} notes`
  if (saved?.revision !== fx.revision + count - 1 || receipts?.length !== count) {
    if (count === fx.ids.length) try say(message)
    return
  }
  const time = try Time
  const until = (try time.now()) + duration(message.length, true, (try (try Toasts).get()).scale)
  const services = try Effect.context<SelectionUndo>()
  try offer(message, "notes", fx.turn, Effect.provideContext(restoreSelection(identity, receipts, until), services))
  try time.until(until)
  try withdraw("notes", fx.turn)
}

effect function listed(owner: number, ticket: number): Notes.Event!!(Agent | Notes.Machine | Editor.Machine | NoteStore | NoteContent) {
  const fail: Notes.Event = { type: "listed", ticket, ok: false, version: 0, rows: [], folders: [], shelf: 0 }
  const identity = ownerAt() catch () => ""
  if (identity === "" || numberOf("owner", identity) !== owner) return fail
  const store = try NoteStore
  const snapshot = store.read() catch () => undefined
  if (snapshot === undefined || (ownerAt() catch () => "") !== identity) return fail
  const machine = try Notes.Machine
  if (!Notes.canListed(try machine.get(), ticket, phone)) return fail
  const content = try NoteContent
  const read = content.publish(identity, snapshot) catch () => undefined
  if (read === undefined) return fail
  const editor = try Editor.Machine
  const active = try editor.get()
  if (active.note > 0) {
    const row = read.rows.find((row) => row.id === active.note)
    const saved = read.noteByNumber.get(active.note)
    const said: Editor.Event = { type: "noteRead", note: active.note, latest: read.version, present: row !== undefined, link: row?.source ?? unlinked }
    if (Editor.canNoteRead(active, said.note, said.latest, said.present, said.link, phone)) {
      if (!Editor.waiting(active) && saved !== undefined) try content.showDraft(fromSaved(saved, identity, read.version))
      try ignore(editor.send(said, phone))
    }
  }
  return { type: "listed", ticket, ok: true, version: read.version, rows: read.rows, folders: read.folders, shelf: read.shelf }
}

effect function written(owner: number, ticket: number, change: Notes.Change): Notes.Event!!(Agent | NoteStore | NoteContent) {
  const failed: Notes.Event = { type: "changeWritten", ticket, ok: false, known: true }
  const done: Notes.Event = { type: "changeWritten", ticket, ok: true, known: true }
  const identity = ownerAt() catch () => ""
  if (identity === "" || numberOf("owner", identity) !== owner) return failed
  const { note, folder, base, op, name } = change
  const content = try NoteContent
  const current = try content.collection()
  if (current.owner !== identity) return failed
  if (op === "AddFolder" || op === "RenameFolder" || op === "RemoveFolder") {
    return effect { try content.changeFolders(identity, base, op, folder, name); return done } catch () => failed
  }
  const row = current.noteByNumber.get(note)
  if (row === undefined || base !== current.version) return failed
  if (op === "Create" || op === "Rewrite") return failed
  const destination = current.folderByNumber.get(folder)
  if (op === "Move" && folder > 0 && destination === undefined) return failed
  const fields: Readonly<Record<string, string | boolean | null>> = op === "Move" ? { folderId: destination?.id ?? null } : { pinned: op === "Pin" }
  return effect {
    try (try NoteStore).update({ id: row.id, expectedRevision: base - 1, format: formatChanged(row, fields) })
    return done
  } catch (error) => ({ ...failed, known: error.known })
}

// spec/app/notes/index.md, "The owner opens a note the list shows, when nothing else of Notes is open, and it opens as listed"; spec/app/notes/index.md, "The agent opens the one note the owner named, as the list last read it, once for the owner's current request, and is told whether it opened"
/** Open `row` as its kind needs, in the name of `by` and for the owner's request `req` an agent's open carries. */
effect function opened(row: Notes.Row, by: Actor, req: Request) {
  const content = try NoteContent
  const current = try content.collection()
  const note = current.noteByNumber.get(row.id)
  if (note === undefined || current.version !== row.revision || (ownerAt() catch () => "") !== current.owner) return
  const { id, revision, kind, origin, source: link } = row
  if (Notes.viewFor(kind) === "Visiting") {
    try ignore((try Link.Machine).send({ type: "openLink", note: id, revision, kind, origin, link, covered: false }, "Owner"))
  } else if (Notes.viewFor(kind) === "Listening") {
    const saved = savedVoice(note)
    if (saved === undefined) return
    const { segments } = saved
    const heard = saved.lines.length > 0 ? segments : 0
    const summary = saved.summary.length > 0 ? heard : 0
    try ignore((try Voice.Machine).send({ type: "openVoice", note: id, revision, segments, heard, summary, covered: false, req }, by))
  } else {
    const editor = try Editor.Machine
    const moved = editor.send({ type: "openNote", id, revision, kind, link, covered: false, req }, by) catch () => undefined
    if (moved !== undefined) try content.showDraft(fromSaved(note, current.owner, revision))
  }
}

/** Open what the agent named, then tell whoever waits on it whether the editor or voice note holds it now. */
effect function openedForAgent(row: Notes.Row, req: Request) {
  try opened(row, "Agent", req)
  const editor = try (try Editor.Machine).get()
  const voice = try (try Voice.Machine).get()
  try (try Opens).settle(req.turn, (editor.showing && editor.note === row.id) || (voice.showing && voice.note === row.id))
}

/** Open what the list hands over; an agent's open, however its job ends, is told once whether it opened. */
effect function shown(row: Notes.Row, by: Actor, req: Request) {
  if (by !== "Agent") return try opened(row, by, req)
  const opens = try Opens
  try Effect.ensuring(openedForAgent(row, req), opens.settle(req.turn, false))
}

function carry(fx: Notes.Effect): Job<Notes.Event, SelectionUndo | Notes.Machine | Editor.Machine | NoteContent | Shell | Layers | Device | Link.Machine | Voice.Machine | Opens, [Actor]> {
  return match (fx) {
    when { tag: "Lists" }: answer("list", listed(fx.owner, fx.ticket), { type: "listed", ticket: fx.ticket, ok: false, version: 0, rows: [], folders: [], shelf: 0 }, phone);
    when { tag: "Writes" }: answer(`write ${fx.ticket}`, written(fx.owner, fx.ticket, fx.change), { type: "changeWritten", ticket: fx.ticket, ok: false, known: false }, phone);
    when { tag: "Shows" }: run(fx.by === "Agent" ? `agent open ${fx.req.turn}` : "open", shown(fx.row, fx.by, fx.req), phone);
    when { tag: "OpensAccount" }: run("account", effect { try ignore((try Shell).send({ type: "openView", view: "Settings" })) }, phone);
    when { tag: "NotOpened" }: run("not opened", effect { try (try Opens).settle(fx.turn, false) }, phone);
    when { tag: "DeletesSelection" }: stream(`selection ${fx.turn}`, Stream.unwrap(effect {
      const result = try selectedDeletion(fx)
      return Stream.concat(Stream.succeed(result), Stream.fromEffectDrain(offerSelectionUndo(fx, result)))
    }),
      { type: "selectionDeleted", turn: fx.turn, removedIds: [], known: false }, phone);
  }
}

export effect function enter() {
  const content = try NoteContent
  const list = try Notes.Machine
  const editor = try Editor.Machine
  const trash = try Trash.Machine
  const link = try Link.Machine
  const voice = try Voice.Machine
  const identity = ownerAt() catch () => ""
  const owner = identity === "" ? 0 : numberOf("owner", identity)
  if ((try list.get()).owner !== owner) {
    try content.clear()
    try (try VoiceReview).put(undefined)
  }
  try ignore(list.send({ type: "ownerChanged", owner }, phone))
  try ignore(editor.send({ type: "ownerChanged", owner }, phone))
  try ignore(trash.send({ type: "ownerChanged", owner }, phone))
  try ignore(link.send({ type: "ownerChanged", owner }, phone))
  try ignore(voice.send({ type: "ownerChanged", owner }, phone))
  try ignore((try Actions.Machine).send({ type: "ownerChanged", owner }, phone))
  try ownerRecords(owner)
  try ownerEarlier(owner)
  try ignore((try Transfer.Machine).send({ type: "ownerChanged", owner }, phone))
  if (owner === 0) return
  const recovered = try exit(content.readDraft(identity))
  const held = try editor.get()
  const draft = Exit.isSuccess(recovered) ? recovered.value : undefined
  if (draft === undefined && held.owner === owner && Editor.waiting(held) && !held.showing) {
    try ignore(editor.send({ type: "restart", readable: false }, phone))
  }
  if (draft !== undefined && draft.owner === identity) {
    if (Editor.waiting(held)) try content.showDraft(draft)
    else {
      const accepted = editor.send({ type: "draftFound", note: draft.id === "" ? 0 : numberOf("note", draft.id), made: draft.made,
        kind: draft.kind, base: draft.base, edits: 1, folder: draft.folder, link: unlinked, readable: true }, phone) catch () => undefined
      if (accepted !== undefined) try content.showDraft(draft)
    }
  }
  try ignore(list.send({ type: "refresh" }, phone))
  try ignore(trash.send({ type: "resumeAction" }, phone))
}

const opening = started(effect {
  const shell = try Shell
  const device = try Device
  const changes = Stream.changes(Stream.map(shell.changes, (state) => showing(state, "Notes")))
  const visible = Stream.changes(Stream.concat(Stream.fromEffect(device.showing()), device.visible))
  try Stream.runForEach(Stream.zipLatest(changes, visible), effect ([shown, front]) => {
    if (shown && front) try enter()
    if (!shown) {
      const list = try Notes.Machine
      const state = try list.get()
      if (state.selection !== "NoSelection" || state.selectionResult !== "NotReported") try ignore(list.send({ type: "left" }, phone))
    }
  })
}, "enter Notes")

/** The Notes view observes these resident machines. The agent's store is opened only when Notes is requested; Ask Alpha waits here on the agent's open of a note. */
export const notes = Layer.provideMerge(together(reacting(Notes, { carry }), editing, trashing, sides, recording, previous, transfers, actions, opening), Layer.mergeAll(noteStore, noteContent, opens))

effect function took() {
  const prior = try Previous.Machine
  const recorder = try Recorder.Machine
  const link = try Link.Machine
  const voice = try Voice.Machine
  const editor = try Editor.Machine
  const trash = try Trash.Machine
  const list = try Notes.Machine
  if (Previous.canBack(try prior.get())) {
    try ignore(prior.send({ type: "back" }, "Owner"))
    return true
  }
  if (Recorder.canBack(try recorder.get())) {
    try ignore(recorder.send({ type: "back" }, "Owner"))
    return true
  }
  if (Link.canBack(try link.get())) {
    try ignore(link.send({ type: "back" }, "Owner"))
    return true
  }
  if (Voice.canBack(try voice.get())) {
    try ignore(voice.send({ type: "back" }, "Owner"))
    return true
  }
  if (Trash.canBack(try trash.get())) {
    try ignore(trash.send({ type: "back" }, "Owner"))
    return true
  }
  if (Editor.canBack(try editor.get())) {
    try (try NoteEditor).close()
    return true
  }
  if (Notes.canBack(try list.get())) {
    try ignore(list.send({ type: "back" }, "Owner"))
    return true
  }
  return false
}

export const back = took()
