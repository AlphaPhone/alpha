// spec/app/notes/index.md, "Story: See my notes"; spec/app/notes/index.md, "Story: Open a note"; spec/app/notes/index.md, "Story: Another owner never sees my notes"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { CloudError } from "@elizaos/cloud/client"
import * as List from "../../gen/app__notes.effect.vibe"
import type { Change, Effect as Out, Event, Row } from "../../gen/app__notes.effect.vibe"
import * as Editor from "../../gen/app__notes__editor.effect.vibe"
import type { Actor, Request } from "../../gen/app__notes__note.ts"
import * as Voice from "../../gen/app__notes__voice.effect.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import type { Agent } from "../platform/agent.vibe"
import { Cloud } from "../platform/cloud.vibe"
import { type Job, answer, contained, reacting, run, started, together } from "../runtime/reactor.vibe"
import { keep, noteOf, storedId } from "./shown.ts"
import { interact, readState } from "./store.vibe"
import { Opens, opens } from "./opens.vibe"
import { type Opened, shows, tellOwner } from "./views.vibe"

/** The folders the phone keeps for one owner's notes, and their own revision. */
schema Shelf { readonly revision: number; readonly folders: { readonly id: string; readonly name: string }[] }
const decodeShelf = Schema.decodeUnknownEffect(Schema.fromJsonString(Shelf))

/** Where the phone keeps `owner`'s folders. */
function shelfKey(owner: number): string {
  return `alpha.notes.folders.${owner}`
}

/** The folders the phone keeps for `owner`: none before the first is made. */
effect function shelfOf(owner: number): Shelf!!KeyValueStore.KeyValueStore {
  const text = (try KeyValueStore.KeyValueStore).get(shelfKey(owner)) catch () => undefined
  const empty: Shelf = { revision: 1, folders: [] }
  return text === undefined ? empty : (decodeShelf(text) catch () => empty)
}

// spec/app/notes/index.md, "Only the phone answers a reading, only the newest reading is taken, and only a well-formed one no older than the one shown"
/** `owner`'s notes and folders, as the answer to the reading numbered `ticket`. */
effect function list(ticket: number, owner: number): Event!!(Agent | KeyValueStore.KeyValueStore) {
  const failed: Event = { type: "listed", ticket, ok: false, version: 0, rows: [], folders: [], shelf: 0 }
  return effect {
    const read = try readState()
    const shelf = try shelfOf(owner)
    const { rows, folders } = keep(read.notes, shelf.folders, read.revision)
    return { type: "listed", ticket, ok: true, version: Math.max(1, read.revision), rows, folders, shelf: shelf.revision } as Event
  } catch () => failed
}

// spec/app/notes/index.md, "A change ends as the store says, and the list is read again whatever the answer"
/** Write `change` to the owner's store over the revision it names: a pin is kept in the note's own format. */
effect function write(ticket: number, change: Change): Event!!Agent {
  const refused: Event = { type: "changeWritten", ticket, ok: false, known: true }
  const id = storedId(change.note)
  const note = noteOf(change.note)
  if ((change.op !== "Pin" && change.op !== "Unpin") || id === undefined || note === undefined) return refused
  const format = { kind: note.format?.kind ?? "text", data: { ...note.format?.data, pinned: change.op === "Pin" } }
  return effect {
    try interact("update-note", { id, format, expectedRevision: change.base })
    return { type: "changeWritten", ticket, ok: true, known: true } as Event
  } catch effect (failure) => (failure._tag === "Refused" ? refused : { type: "changeWritten", ticket, ok: false, known: false } as Event)
}

// spec/app/notes/index.md, "The agent opens the one note the owner named, as the list shows it now, once for the owner's current turn, and is told whether it opened"
/** Open what the list hands over, and tell whoever waits on an agent's open for that turn whether the editor or voice note holds it now. */
effect function shown(row: Row, by: Actor, req: Request) {
  try shows(row, by, req)
  if (by !== "Agent") return
  const e = try (try Editor.Machine).get()
  const v = try (try Voice.Machine).get()
  try (try Opens).settle(req.turn, (e.showing && e.note === row.id) || (v.showing && v.note === row.id))
}

function carry(fx: Out): Job<Event, Agent | KeyValueStore.KeyValueStore | Shell.Machine | Opened | Opens, [by: Actor]> {
  return match (fx) {
    when { tag: "Lists", let ticket, let owner }: answer("list", list(ticket, owner), { type: "listed", ticket, ok: false, version: 0, rows: [], folders: [], shelf: 0 }, "Phone");
    when { tag: "Writes", let ticket, let change }: answer("write", write(ticket, change), { type: "changeWritten", ticket, ok: false, known: false }, "Phone");
    when { tag: "Shows", let row, let by, let req }: run("show", shown(row, by, req), "Phone");
    when { tag: "OpensAccount" }: run("account", effect { try contained((try Shell.Machine).send({ type: "openView", view: "Settings" }), "opening Settings") }, "Phone");
    when { tag: "Opened", let turn, let ok }: run("opened", effect { if (!ok) try (try Opens).settle(turn, false) }, "Phone");
  }
}

const kept = reacting(List, { carry })

const ownersKey = "alpha.notes.owners"
const decodeIds = Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Array(Schema.String)))

/** The number `account` keeps on this phone across restarts: 0 for no account. */
effect function numberOf(account: string): number!!KeyValueStore.KeyValueStore {
  if (account === "") return 0
  const store = try KeyValueStore.KeyValueStore
  const text = store.get(ownersKey) catch () => undefined
  const known: ReadonlyArray<string> = text === undefined ? [] : (decodeIds(text) catch () => [])
  const at = known.indexOf(account)
  if (at >= 0) return at + 1
  try ignore(store.set(ownersKey, JSON.stringify([...known, account])))
  return known.length + 1
}

/** The account the cloud session is signed in to: "" when signed out, nothing when the cloud could not say. */
effect function account(): (string | undefined)!!Cloud {
  const { client } = try Cloud
  return effect {
    const signed = try tryPromise({ try: () => client.account(), catch: (cause) => cause })
    return signed.id
  } catch (failed) => (failed instanceof CloudError && failed.failure.tag === "CloudCredentialInvalid" ? "" : undefined)
}

// spec/app/notes/index.md, "When another owner takes the phone, the list forgets everything shown, asked or proposed, and reads nothing until opened again"; spec/app/notes/index.md, "Opening Notes, or trying again, reads the owner's notes"
/** Tell the list who is signed in, then read that owner's notes. */
export effect function opened() {
  const who = try account()
  const notes = try List.Machine
  if (who !== undefined) {
    const owner = try numberOf(who)
    if ((try notes.get()).owner !== owner) {
      try contained(notes.send({ type: "ownerChanged", owner }, "Phone"), "telling Notes who is signed in")
      try tellOwner(owner)
    }
  }
  try contained(notes.send({ type: "refresh" }, "Owner"), "reading the notes")
}

/** Each time the shell brings Notes forward, who is signed in, and their notes read again. */
const fronted = started(effect {
  const forward = Stream.filter(Stream.changes(Stream.map((try Shell.Machine).changes, (shell) => Shell.showing(shell, "Notes"))), (front) => front)
  try Stream.runForEach(forward, () => contained(opened(), "opening Notes"))
}, "following Notes to the front")

/** Notes' list: in memory, told who is signed in and read from the agent's store each time Notes comes forward, and who waits on an agent's open. */
export const notes = Layer.provideMerge(together(kept, fronted), opens)
