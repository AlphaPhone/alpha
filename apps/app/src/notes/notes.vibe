// spec/app/notes/index.md, "Story: See my notes"; spec/app/notes/index.md, "Story: Open a note"; spec/app/notes/index.md, "Story: Organise my notes"; spec/app/notes/index.md, "Story: Another owner never sees my notes"
import * as Notes from "../../gen/app__notes.effect.vibe"
import * as Editor from "../../gen/app__notes__editor.effect.vibe"
import * as Link from "../../gen/app__notes__linkNote.effect.vibe"
import * as Voice from "../../gen/app__notes__voice.effect.vibe"
import * as Trash from "../../gen/app__notes__trash.effect.vibe"
import type { Actor } from "../../gen/app__notes__note.effect.vibe"
import { unlinked } from "../../gen/app__notes__note.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import type { Agent } from "../platform/agent.vibe"
import { Device } from "../platform/device.vibe"
import { NoteStore, noteStore } from "../platform/notes.vibe"
import { ownerAt } from "../platform/owner.vibe"
import { type Job, answer, reacting, run, started, together } from "../runtime/reactor.vibe"
import { NoteContent, formatChanged, fromSaved, noteContent, numberOf } from "./content.vibe"
import { NoteEditor, editing } from "./editor.vibe"
import { sides } from "./sides.vibe"
import { trashing } from "./trash.vibe"

const phone: Actor = "Phone"

effect function listed(owner: number, ticket: number): Notes.Event!!(Agent | Notes.Machine | Editor.Machine | NoteStore | NoteContent) {
  const fail: Notes.Event = { type: "listed", ticket, ok: false, version: 0, rows: [], folders: [], shelf: 0 }
  const identity = ownerAt() catch () => ""
  if (identity === "" || numberOf("owner", identity) !== owner) return fail
  const store = try NoteStore
  const snapshot = store.read() catch () => undefined
  if (snapshot === undefined || (ownerAt() catch () => "") !== identity) return fail
  const machine = try Notes.Machine
  if (!Notes.canListed(try machine.get(), ticket, phone)) return fail
  const content = try NoteContent
  const read = content.publish(identity, snapshot) catch () => undefined
  if (read === undefined) return fail
  const editor = try Editor.Machine
  const active = try editor.get()
  if (active.note > 0) {
    const row = read.rows.find((row) => row.id === active.note)
    const saved = read.noteByNumber.get(active.note)
    const said: Editor.Event = { type: "noteRead", note: active.note, latest: read.version, present: row !== undefined, link: row?.source ?? unlinked }
    if (Editor.canNoteRead(active, said.note, said.latest, said.present, said.link, phone)) {
      if (!Editor.waiting(active) && saved !== undefined) try content.showDraft(fromSaved(saved, identity, read.version))
      try ignore(editor.send(said, phone))
    }
  }
  return { type: "listed", ticket, ok: true, version: read.version, rows: read.rows, folders: read.folders, shelf: read.shelf }
}

effect function written(owner: number, ticket: number, change: Notes.Change): Notes.Event!!(Agent | NoteStore | NoteContent) {
  const failed: Notes.Event = { type: "changeWritten", ticket, ok: false, known: true }
  const done: Notes.Event = { type: "changeWritten", ticket, ok: true, known: true }
  const identity = ownerAt() catch () => ""
  if (identity === "" || numberOf("owner", identity) !== owner) return failed
  const { note, folder, base, op, name } = change
  const content = try NoteContent
  const current = try content.collection()
  if (current.owner !== identity) return failed
  if (op === "AddFolder" || op === "RenameFolder" || op === "RemoveFolder") {
    return effect { try content.changeFolders(identity, base, op, folder, name); return done } catch () => failed
  }
  const row = current.noteByNumber.get(note)
  if (row === undefined || base !== current.version) return failed
  if (op === "Create" || op === "Rewrite") return failed
  const destination = current.folderByNumber.get(folder)
  if (op === "Move" && folder > 0 && destination === undefined) return failed
  const fields = op === "Move" ? { folderId: destination?.id ?? null } : { pinned: op === "Pin" }
  return effect {
    try (try NoteStore).update({ id: row.id, expectedRevision: base - 1, format: formatChanged(row, fields) })
    return done
  } catch (error) => ({ ...failed, known: error.known })
}

effect function opened(row: Notes.Row) {
  const content = try NoteContent
  const current = try content.collection()
  const note = current.noteByNumber.get(row.id)
  if (note === undefined || current.version !== row.revision || (ownerAt() catch () => "") !== current.owner) return
  const { id, revision, kind, origin, source: link } = row
  if (Notes.viewFor(kind) === "Visiting") {
    try ignore((try Link.Machine).send({ type: "openLink", note: id, revision, kind, origin, link, covered: false }, "Owner"))
  } else if (Notes.viewFor(kind) === "Listening") {
    const format = note.format?.data
    const segments = Array.isArray(format?.segments) ? format.segments.length : typeof format?.audioId === "string" ? 1 : 0
    const heard = Array.isArray(format?.lines) ? format.lines.length : 0
    const summary = Array.isArray(format?.summary) ? format.summary.length : 0
    try ignore((try Voice.Machine).send({ type: "openVoice", note: id, revision, segments, heard, summary, covered: false }, "Owner"))
  } else {
    const editor = try Editor.Machine
    const moved = editor.send({ type: "openNote", id, revision, kind, link, covered: false }, "Owner") catch () => undefined
    if (moved !== undefined) try content.showDraft(fromSaved(note, current.owner, revision))
  }
}

function carry(fx: Notes.Effect): Job<Notes.Event, Agent | Notes.Machine | Editor.Machine | NoteStore | NoteContent | Shell | Link.Machine | Voice.Machine, [Actor]> {
  return match (fx) {
    when { tag: "Lists" }: answer("list", listed(fx.owner, fx.ticket), { type: "listed", ticket: fx.ticket, ok: false, version: 0, rows: [], folders: [], shelf: 0 }, phone);
    when { tag: "Writes" }: answer(`write ${fx.ticket}`, written(fx.owner, fx.ticket, fx.change), { type: "changeWritten", ticket: fx.ticket, ok: false, known: false }, phone);
    when { tag: "Shows" }: run("open", opened(fx.row), phone);
    when { tag: "OpensAccount" }: run("account", effect { try ignore((try Shell).send({ type: "openView", view: "Settings" })) }, phone);
  }
}

effect function enter() {
  const content = try NoteContent
  const list = try Notes.Machine
  const editor = try Editor.Machine
  const trash = try Trash.Machine
  const link = try Link.Machine
  const voice = try Voice.Machine
  const identity = ownerAt() catch () => ""
  const owner = identity === "" ? 0 : numberOf("owner", identity)
  if ((try list.get()).owner !== owner) try content.clear()
  try ignore(list.send({ type: "ownerChanged", owner }, phone))
  try ignore(editor.send({ type: "ownerChanged", owner }, phone))
  try ignore(trash.send({ type: "ownerChanged", owner }, phone))
  try ignore(link.send({ type: "ownerChanged", owner }, phone))
  try ignore(voice.send({ type: "ownerChanged", owner }, phone))
  if (owner === 0) return
  const draft = content.readDraft() catch () => undefined
  if (draft !== undefined && draft.owner === identity) {
    const held = try editor.get()
    if (Editor.waiting(held)) try content.showDraft(draft)
    else {
      const accepted = editor.send({ type: "draftFound", note: draft.id === "" ? 0 : numberOf("note", draft.id), made: draft.made,
        kind: draft.kind, base: draft.base, edits: 1, folder: draft.folder, link: unlinked, readable: true }, phone) catch () => undefined
      if (accepted !== undefined) try content.showDraft(draft)
    }
  }
  try ignore(list.send({ type: "refresh" }, phone))
  try ignore(trash.send({ type: "resumeAction" }, phone))
}

const opening = started(effect {
  const shell = try Shell
  const device = try Device
  const changes = Stream.changes(Stream.map(shell.changes, (state) => showing(state, "Notes")))
  const visible = Stream.changes(Stream.concat(Stream.fromEffect(device.showing()), device.visible))
  try Stream.runForEach(Stream.zipLatest(changes, visible), effect ([shown, front]) => {
    if (shown && front) try enter()
  })
}, "enter Notes")

/** The Notes view observes these resident machines. The agent's store is opened only when Notes is requested. */
export const notes = Layer.provideMerge(together(reacting(Notes, { carry }), editing, trashing, sides, opening), Layer.merge(noteStore, noteContent))

effect function took() {
  const link = try Link.Machine
  const voice = try Voice.Machine
  const editor = try Editor.Machine
  const trash = try Trash.Machine
  const list = try Notes.Machine
  if (Link.canBack(try link.get())) {
    try ignore(link.send({ type: "back" }, "Owner"))
    return true
  }
  if (Voice.canBack(try voice.get())) {
    try ignore(voice.send({ type: "back" }, "Owner"))
    return true
  }
  if (Trash.canBack(try trash.get())) {
    try ignore(trash.send({ type: "back" }, "Owner"))
    return true
  }
  if (Editor.canBack(try editor.get())) {
    try (try NoteEditor).close()
    return true
  }
  if (Notes.canBack(try list.get())) {
    try ignore(list.send({ type: "back" }, "Owner"))
    return true
  }
  return false
}

export const back = took()
