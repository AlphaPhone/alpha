// spec/notes/list.md, "The list holds every row once, pinned rows first, then by time, ties in stored order"; spec/notes/list.md, "A record is shown as its kind only when it carries that kind's data"; spec/notes/list.md, "A row carries only an opaque recording handle, checked against its own recording"; spec/notes/list.md, "A row is shown when it matches every part of the filter"; spec/notes/list.md, "A Notes route opens one note or shows one list filter, and the plain list otherwise"; spec/notes/list.md, "A default title takes the next number after the highest one in use, Trash included"; spec/notes/list.md, "A checked item is written with an [x] mark, and an unchecked item that looks marked gets an empty mark"
import { itemMark, nextDefaultNumber, routeAsk, rowMatches, shownKind, shownOrder, voiceAudioValid, type NoteKind } from "../../gen/notes__list.effect.vibe"
import { authoredNoteText } from "@elizaos/plugin-notes/format"
import { projectNoteForModel, reconstructNoteContent, type NoteFormat, type StickyNote } from "@elizaos/plugin-notes/types"

/** A note's kind as the records name it. */
export type KindName = "text" | "list" | "voice" | "link"

/** One checklist item or voice action. */
export interface CheckItem { readonly t: string; readonly done: boolean }

/** One transcript line of a voice note. */
export interface VoiceLine { readonly s?: string; readonly at: number; readonly t: string }

/** A web page a summary note came from. */
export interface WebSource { readonly name: string; readonly url: string }

/** A document a note came from: its fingerprint and, on the phone that holds it, an opaque reference. */
export interface DocumentSource { readonly name: string; readonly mimeType: string; readonly sha256: string; readonly size: number; readonly reference?: string }

/** One row of the Notes list: a canonical note as the list shows it, with no device-only handle. */
export interface NoteRow {
  readonly id: string
  readonly kind: KindName
  readonly title: string
  readonly body: string
  readonly separator: "" | "\n"
  readonly at: number
  readonly pinned: boolean
  readonly folderId: string
  readonly items: readonly CheckItem[]
  readonly lines: readonly VoiceLine[]
  readonly summary: readonly string[]
  readonly actions: readonly CheckItem[]
  readonly url?: string
  readonly domain?: string
  readonly clips: readonly string[]
  readonly audio?: { readonly audioId: string; readonly durationMs: number }
  readonly recordingId?: string
  readonly webSource?: WebSource
  readonly documentSource?: DocumentSource
  readonly createdAt: string
  readonly updatedAt: string
}

/** The agent's or the owner's list filter: text, kind and folder ID, each optional. */
export interface NotesFilter { readonly text?: string; readonly kind?: KindName; readonly folder?: string }

const kinds: Record<KindName, NoteKind> = { text: "PlainKind", list: "ChecklistKind", voice: "VoiceKind", link: "LinkKind" }
const names: Record<NoteKind, KindName> = { PlainKind: "text", ChecklistKind: "list", VoiceKind: "voice", LinkKind: "link" }

type Json = NoteFormat["data"][string]

function object(value: Json | undefined): value is { readonly [key: string]: Json } {
  return value !== null && typeof value === "object" && !Array.isArray(value)
}

function strings(value: Json | undefined): string[] {
  return Array.isArray(value) ? value.filter((item): item is string => typeof item === "string") : []
}

function checks(value: Json | undefined): CheckItem[] {
  return Array.isArray(value) ? value.flatMap((item) => object(item) && typeof item.t === "string" ? [{ t: item.t, done: item.done === true }] : []) : []
}

function voiceLines(value: Json | undefined): VoiceLine[] {
  return Array.isArray(value) ? value.flatMap((item) => object(item) && typeof item.t === "string"
    ? [{ t: item.t, at: typeof item.at === "number" && Number.isFinite(item.at) ? item.at : 0, ...(typeof item.s === "string" ? { s: item.s } : {}) }]
    : []) : []
}

/** The note's recording handle, only when it is exactly an audio ID and duration for the note's own recording. */
export function voiceAudio(data: NoteFormat["data"]): { audioId: string; durationMs: number } | undefined {
  const audio = data.audio
  if (!object(audio)) return undefined
  const keys = Object.keys(audio)
  const exactKeys = keys.length === 2 && keys.includes("audioId") && keys.includes("durationMs")
  const audioId = typeof audio.audioId === "string" ? audio.audioId : ""
  const durationMs = typeof audio.durationMs === "number" && Number.isFinite(audio.durationMs) ? audio.durationMs : -1
  const idShape = /^[A-Za-z0-9_-]{1,128}$/.test(audioId)
  return voiceAudioValid(exactKeys, data.recordingId === audioId, idShape, durationMs) ? { audioId, durationMs } : undefined
}

function webSourceOf(value: Json | undefined): WebSource | undefined {
  if (!object(value) || typeof value.name !== "string" || typeof value.url !== "string" || !/^https:\/\//.test(value.url)) return undefined
  return { name: value.name.slice(0, 200), url: value.url }
}

function documentSourceOf(value: Json | undefined): DocumentSource | undefined {
  if (!object(value) || typeof value.name !== "string" || typeof value.mimeType !== "string" || typeof value.sha256 !== "string"
    || !/^[0-9a-f]{64}$/.test(value.sha256) || typeof value.size !== "number" || !Number.isSafeInteger(value.size) || value.size < 0) return undefined
  return { name: value.name, mimeType: value.mimeType, sha256: value.sha256, size: value.size,
    ...(typeof value.reference === "string" && /^a1:[A-Za-z0-9_-]{1,200}$/.test(value.reference) ? { reference: value.reference } : {}) }
}

function domainOf(url: string): string {
  const match = /^[a-z][a-z0-9+.-]*:\/\/([^/?#:]+)/i.exec(url)
  return match?.[1] ?? url
}

/** The instant a row is ordered by: modified, then updated, then created time; -1 when none is readable. */
export function instant(...values: readonly unknown[]): number {
  for (const value of values) {
    const at = typeof value === "number" ? value : typeof value === "string" ? Date.parse(value) : Number.NaN
    if (Number.isFinite(at)) return at
  }
  return -1
}

/** Split stored content into its title and body, keeping the one framing line feed apart. */
export function contentParts(note: Pick<StickyNote, "title" | "body">): { title: string; body: string; separator: "" | "\n" } {
  const parts = projectNoteForModel(note)
  return { title: parts.title, body: parts.body, separator: parts.bodySeparator }
}

/** The stored content of a title, separator and body. */
export function contentOf(title: string, separator: "" | "\n", body: string): string {
  return reconstructNoteContent({ title, body, bodySeparator: separator })
}

/** The authored text of a note's rich data, for search and for whether a draft has authored content. */
export function authoredText(format: NoteFormat | undefined): string {
  return authoredNoteText(format)
}

/** A canonical note as a list row. */
export function rowOf(note: StickyNote): NoteRow {
  const data = note.format?.data ?? {}
  const stored = note.format?.kind ?? "text"
  const parts = contentParts(note)
  const audio = stored === "voice" ? voiceAudio(data) : undefined
  const lines = voiceLines(data.lines)
  const summary = strings(data.summary)
  const actions = checks(data.actions)
  const url = typeof data.url === "string" && data.url !== "" ? data.url : undefined
  const kind = names[shownKind(kinds[stored], lines.length > 0 || summary.length > 0 || actions.length > 0 || audio !== undefined, url !== undefined)]
  return {
    id: note.id, kind, title: parts.title, body: parts.body, separator: parts.separator,
    at: instant(data.modifiedAt, note.updatedAt, note.createdAt), pinned: data.pinned === true,
    folderId: typeof data.folderId === "string" ? data.folderId : "",
    items: checks(data.items), lines, summary, actions, clips: strings(data.clips),
    ...(url !== undefined ? { url, domain: typeof data.domain === "string" ? data.domain : domainOf(url) } : {}),
    ...(audio !== undefined ? { audio } : {}),
    ...(typeof data.recordingId === "string" ? { recordingId: data.recordingId } : {}),
    ...(webSourceOf(data.webSource) !== undefined ? { webSource: webSourceOf(data.webSource) } : {}),
    ...(documentSourceOf(data.documentSource) !== undefined ? { documentSource: documentSourceOf(data.documentSource) } : {}),
    createdAt: note.createdAt, updatedAt: note.updatedAt,
  }
}

/** The rows in the order the list shows them. */
export function shownRows(rows: readonly NoteRow[]): NoteRow[] {
  return shownOrder(rows.map((row) => ({ pinned: row.pinned, at: row.at }))).flatMap((index) => rows[index] === undefined ? [] : [rows[index]])
}

const fold = (value: string) => value.normalize("NFKC").toLowerCase()

/** Every piece of text a row holds, for search. */
export function searchText(row: NoteRow): string {
  return [row.title, row.body, ...row.items.map((item) => item.t), ...row.lines.map((line) => line.t), ...row.summary,
    ...row.actions.map((item) => item.t), row.domain ?? "", ...row.clips].filter(Boolean).join("\n")
}

/** Whether a row's text contains `text`, ignoring case and Unicode form; empty text matches. */
export function matchesText(row: NoteRow, text: string): boolean {
  const needle = fold(text).trim()
  return needle === "" || fold(searchText(row)).includes(needle)
}

/** The folder a row is shown in: its folder when that folder exists, otherwise none. */
export function folderOf(row: NoteRow, folderIds: ReadonlySet<string>): string {
  return row.folderId !== "" && folderIds.has(row.folderId) ? row.folderId : ""
}

/** The rows a filter keeps. */
export function filterRows(rows: readonly NoteRow[], filter: NotesFilter | undefined, folderIds: ReadonlySet<string>): NoteRow[] {
  if (filter === undefined) return [...rows]
  return rows.filter((row) => rowMatches(filter.kind !== undefined, row.kind === filter.kind, filter.folder !== undefined,
    folderOf(row, folderIds) === (filter.folder ?? ""), filter.text !== undefined, matchesText(row, filter.text ?? "")))
}

const filterRoute = "filter?"
const kindNames: readonly KindName[] = ["text", "list", "voice", "link"]

/** The route that opens Notes at a note or shows a list filter; undefined for the plain list. */
export function notesRouteOf(request: { readonly filter?: NotesFilter; readonly noteId?: string }): string | undefined {
  if (request.noteId !== undefined) return request.noteId
  const filter = request.filter
  if (filter === undefined) return undefined
  const query = new URLSearchParams()
  if (filter.text !== undefined) query.set("text", filter.text)
  if (filter.kind !== undefined) query.set("kind", filter.kind)
  if (filter.folder !== undefined) query.set("folder", filter.folder)
  return filterRoute + query.toString()
}

/** What a Notes route asks for: one note, one list filter, or the plain list. */
export function notesRouteRequest(route: string | undefined): { readonly filter?: NotesFilter; readonly noteId?: string } {
  const text = route ?? ""
  const isFilter = text.startsWith(filterRoute)
  const query = new URLSearchParams(isFilter ? text.slice(filterRoute.length) : "")
  const words = query.get("text") ?? ""
  const kind = kindNames.find((name) => name === query.get("kind"))
  const folder = query.get("folder") ?? ""
  const filter: NotesFilter = { ...(words === "" ? {} : { text: words }), ...(kind === undefined ? {} : { kind }), ...(folder === "" ? {} : { folder }) }
  const asked = routeAsk(text === "", isFilter, Object.keys(filter).length > 0)
  return asked === "RouteNote" ? { noteId: text } : asked === "RouteFilter" ? { filter } : {}
}

/** The two-line preview of a row: its body, checklist with marks, transcript or a link's domain. */
export function preview(row: NoteRow): string {
  const text = row.kind === "list" ? row.items.map((item) => (item.done ? "☑ " : "☐ ") + item.t).join("\n")
    : row.kind === "link" ? row.domain ?? ""
    : row.body.trim() !== "" ? row.body : row.lines.map((line) => line.t).join(" ")
  return text.replace(/[ \t]+/g, " ").trim().slice(0, 240)
}

/** The short list date: the time today, the weekday within a week, otherwise the date; empty when unknown. */
export function dateLabel(at: number, now: number, locale?: string, timeZone?: string): string {
  if (at < 0) return ""
  const day = (t: number) => new Intl.DateTimeFormat("en-CA", { timeZone, year: "numeric", month: "2-digit", day: "2-digit" }).format(t)
  if (day(at) === day(now)) return new Intl.DateTimeFormat(locale, { timeZone, hour: "numeric", minute: "2-digit" }).format(at)
  if (at < now && now - at < 6 * 24 * 60 * 60 * 1000) return new Intl.DateTimeFormat(locale, { timeZone, weekday: "short" }).format(at)
  const year = (t: number) => new Intl.DateTimeFormat("en", { timeZone, year: "numeric" }).format(t)
  return new Intl.DateTimeFormat(locale, year(at) === year(now) ? { timeZone, month: "short", day: "numeric" } : { timeZone, year: "numeric", month: "short", day: "numeric" }).format(at)
}

/** The next default title for a new note or voice note, after every title in use in notes and Trash. */
export function nextDefaultTitle(titles: Iterable<string>, base: "New note" | "Voice note"): string {
  const prefix = base.toLowerCase()
  let highest = 0
  for (const raw of titles) {
    const title = raw.trim().toLowerCase()
    if (title === prefix) { highest = Math.max(highest, 1); continue }
    if (!title.startsWith(prefix)) continue
    const suffix = /^\s+#?(\d+)$/.exec(title.slice(prefix.length))
    const number = suffix ? Number(suffix[1]) : 0
    if (Number.isSafeInteger(number) && number > 0) highest = Math.max(highest, number)
  }
  const next = nextDefaultNumber(highest)
  return next === 0 ? base : `${base} ${next}`
}

const checkMark = /^\[([ xX])\]\s/

/** A checklist as text, one item per line, so that every item reads back as it was. */
export function checklistText(items: readonly CheckItem[]): string {
  return items.map((item) => {
    const mark = itemMark(item.done, checkMark.test(item.t))
    return mark === "CheckedMark" ? "[x] " + item.t : mark === "OpenMark" ? "[ ] " + item.t : item.t
  }).join("\n")
}

/** Text as a checklist: one item per non-blank line, an [x] mark ticks it. */
export function checklistItems(body: string): CheckItem[] {
  return body.split("\n").filter((line) => line.trim() !== "").map((line) => {
    const text = line.trim()
    const mark = checkMark.exec(text)
    return mark ? { t: text.slice(mark[0].length).trim(), done: mark[1] !== " " } : { t: text, done: false }
  })
}
