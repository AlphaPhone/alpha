// spec/notes/collection.md, "A collection is bound to one owner, and a new owner or a retirement starts over"; spec/notes/recorder.md, "Another owner or leaving Notes detaches the view and keeps the recording"
import { CloudSession, ownerOf } from "../account/layer.vibe"
import { audioLayer } from "./audio.vibe"
import { cleanupLayer } from "./cleanup.vibe"
import { clientLayer } from "./client.vibe"
import { NotesCollection, collectionLayer } from "./collection.vibe"
import { draftsLayer } from "./drafts.vibe"
import { NotesEditor, editorLayer } from "./editor.vibe"
import { foldersLayer } from "./folders.vibe"
import { NotesListFilter, listFilterLayer } from "./listFilter.vibe"
import { organizeLayer } from "./organize.vibe"
import { NotesHandoff, handoffLayer, originsLayer } from "./origins.vibe"
import { NotesRecorder, recorderLayer } from "./recorder.vibe"
import { shareLayer } from "./share.vibe"
import { sourcesLayer } from "./sources.vibe"
import { trashLayer } from "./trash.vibe"

const records = Layer.provideMerge(Layer.mergeAll(editorLayer, handoffLayer), Layer.provideMerge(collectionLayer, Layer.merge(clientLayer, draftsLayer)))
const devices = Layer.provideMerge(Layer.mergeAll(trashLayer, cleanupLayer, recorderLayer, audioLayer, originsLayer, shareLayer, sourcesLayer), records)
const agent = Layer.provideMerge(organizeLayer, Layer.provideMerge(Layer.mergeAll(foldersLayer, listFilterLayer), devices))

const followOwner = Layer.effectDiscard(effect {
  const session = try CloudSession
  const collection = try NotesCollection
  const recorder = try NotesRecorder
  const filter = try NotesListFilter
  const editor = try NotesEditor
  const handoff = try NotesHandoff
  try fork.scoped Stream.runForEach(handoff.requests, (request) =>
    request.kind === "open-notes" && request.noteId !== undefined ? Effect.asVoid(editor.leave(request.noteId)) : Effect.void)
  try fork.scoped Stream.runForEach(Stream.changesWith(collection.snapshots, (a, b) => a?.snapshot.revision === b?.snapshot.revision && a?.owner === b?.owner),
    () => filter.collectionChanged())
  const owners = Stream.changes(Stream.map(session.changes, (current) => ownerOf(current)))
  try fork.scoped Stream.runForEach(owners, (number) => effect {
    const current = number === 0 ? undefined : try session.ownerKey("notes")
    if (current === undefined) {
      try recorder.ownerChanged(false)
      try filter.ownerLost()
      try collection.retire()
      return
    }
    try collection.bind(current)
    try recorder.ownerChanged(true)
  })
})

/** Every Notes service and machine; it needs the platform's Native, Resident, Build and KeyValueStore, and the account's CloudSession. */
export const layer = Layer.provideMerge(followOwner, agent)
