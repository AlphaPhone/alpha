// spec/app/notes/trash.md, "Story: Delete a note and get it back"; spec/app/notes/trash.md, "Story: Erase for good"; spec/app/notes/trash.md, "Story: Stay honest when an action is cut off"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Trash from "../../gen/app__notes__trash.effect.vibe"
import type { Actor } from "../../gen/app__notes__note.effect.vibe"
import { Machine as Notes } from "../../gen/app__notes.effect.vibe"
import { Machine as Editor } from "../../gen/app__notes__editor.effect.vibe"
import { Attempts } from "../runtime/attempts.vibe"
import { type Job, answer, reacting, run, started, together, untimed } from "../runtime/reactor.vibe"
import { NoteContent, audioIdOf, numberOf } from "./content.vibe"
import { ownerAt } from "../platform/owner.vibe"
import { NoteStore } from "../platform/notes.vibe"
import { NoteDevice } from "../platform/noteDevice.vibe"
import { Device } from "../platform/device.vibe"
import type { Agent } from "../platform/agent.vibe"

const phone: Actor = "Phone"

function isTrashFull(cause: unknown): boolean {
  if (typeof cause === "object" && cause !== null) {
    if ("status" in cause && (cause.status === 413 || cause.status === 507)) return true
    if ("message" in cause && typeof cause.message === "string" && /full|capacity|limit|no room/i.test(cause.message)) return true
  }
  return false
}

effect function listed(owner: number, ticket: number): Trash.Event!!(Agent | NoteStore | NoteContent | Trash.Machine) {
  const failed: Trash.Event = { type: "listed", ticket, ok: false, entries: [] }
  const identity = ownerAt() catch () => ""
  if (identity === "" || numberOf("owner", identity) !== owner) return failed
  const snapshot = (try NoteStore).read() catch () => undefined
  if (snapshot?.trash === undefined || (ownerAt() catch () => "") !== identity) return failed
  const bin = try (try Trash.Machine).get()
  if (bin.owner !== owner || !Trash.canListed(bin, ticket, phone)) return failed
  try ignore((try NoteContent).publish(identity, snapshot))
  const entries = snapshot.trash.map(({ note, deletedAt }) => ({
    id: numberOf("note", note.id),
    revision: snapshot.revision + 1,
    at: Date.parse(deletedAt),
    recording: audioIdOf(note) === "" ? 0 : numberOf("recording", audioIdOf(note)),
  })).filter((entry) => Number.isSafeInteger(entry.at) && entry.at > 0)
  return { type: "listed", ticket, ok: true, entries }
}

effect function action(fx: Extract<Trash.Effect, { readonly tag: "Does" }>): Trash.Event!!(Agent | NoteStore | NoteContent) {
  const { owner, ticket, act, subject, revision, asOf } = fx
  const failed: Trash.Event = { type: "finished", ticket, verdict: "Denied", revision }
  const lost: Trash.Event = { ...failed, verdict: "Lost" }
  const done: Trash.Event = { ...failed, verdict: "Done" }
  const identity = ownerAt() catch () => ""
  if (identity === "" || numberOf("owner", identity) !== owner) return failed
  const store = try NoteStore
  const snapshot = store.read() catch () => undefined
  if (snapshot?.trash === undefined) return failed
  const note = snapshot.notes.find((row) => numberOf("note", row.id) === subject)
  const entry = snapshot.trash.find((row) => numberOf("note", row.note.id) === subject)
  if (act !== "Sweep" && snapshot.revision + 1 !== revision) return failed
  const discardTarget = effect {
    if (note === undefined || snapshot.deleteAtRevision !== true) return undefined
    const seen = (try (try NoteContent).collection()).noteByNumber.get(subject)
    if (seen !== undefined && (seen.id !== note.id || seen.updatedAt !== note.updatedAt)) return undefined
    if ((ownerAt() catch () => "") !== identity) return undefined
    return try store.discard(note.id, snapshot.revision)
  }
  return effect {
    switch (act) {
      case "Discard": {
        const saved = try discardTarget
        if (saved === undefined || note === undefined) return failed
        if ((ownerAt() catch () => "") !== identity || saved.target?.id !== note.id ||
          saved.state.revision !== revision || saved.state.notes.some((row) => row.id === note.id) ||
          !saved.state.trash?.some((row) => row.note.id === note.id)) return lost
        return done
      }
      case "Recover": {
        if (entry === undefined || (ownerAt() catch () => "") !== identity) return failed
        const saved = try store.recover(entry.note.id, snapshot.revision)
        if ((ownerAt() catch () => "") !== identity || saved.target?.id !== entry.note.id ||
          saved.state.revision !== revision || saved.state.trash?.some((row) => row.note.id === entry.note.id) ||
          !saved.state.notes.some((row) => row.id === entry.note.id)) return lost
        return done
      }
      case "Erase":
        if (entry === undefined) return failed
        try store.erase({ scope: "entry", id: entry.note.id, deletedAt: entry.deletedAt, expectedRevision: snapshot.revision })
        return done
      case "EmptyAll":
        try store.erase({ scope: "all", expectedRevision: snapshot.revision })
        return done
      case "Sweep": {
        let latest = snapshot.revision
        for (const row of (snapshot.trash ?? []).filter((item) => Date.parse(item.deletedAt) + Trash.retention <= asOf)) {
          const erased = try store.erase({ scope: "entry", id: row.note.id, deletedAt: row.deletedAt, expectedRevision: latest })
          latest = erased.state.revision
        }
        return done
      }
      case "Destroy": {
        const discarded = try discardTarget
        if (discarded === undefined || note === undefined) return failed
        const trashed = (discarded.state.trash ?? []).find((item) => item.note.id === note.id)
        if (trashed !== undefined) {
          try store.erase({ scope: "entry", id: trashed.note.id, deletedAt: trashed.deletedAt, expectedRevision: discarded.state.revision })
        }
        return done
      }
    }
  } catch (error) => {
    if (act === "Discard" && isTrashFull(error.cause)) return { type: "finished", ticket, verdict: "NoRoom", revision: snapshot.revision + 1 }
    return error.known && act !== "Sweep" ? failed : lost
  }
}

/** The recording’s device confirms its erasure and the same agent acknowledges it. */
effect function cleanRecorded(ids: ReadonlyArray<number>): { readonly ok: boolean; readonly known: boolean }!!(Agent | NoteStore | NoteDevice) {
  const unknown = { ok: false, known: false }
  const identity = ownerAt() catch () => ""
  if (identity === "") return unknown
  const pending = (try NoteStore).cleanup() catch () => undefined
  if (pending === undefined) return unknown
  const wanted = new Set(ids)
  const receipts = new Map<number, (typeof pending)[number]>()
  for (const receipt of pending) {
    const number = numberOf("recording", receipt.audioId)
    if (!wanted.has(number)) continue
    if (receipts.has(number)) return unknown
    receipts.set(number, receipt)
  }
  if (receipts.size !== wanted.size) return unknown
  const device = try NoteDevice
  for (const receipt of receipts.values()) {
    if ((ownerAt() catch () => "") !== identity || !(try device.purge(receipt))) return unknown
  }
  return (ownerAt() catch () => "") === identity ? { ok: true, known: true } : unknown
}

function carry(fx: Trash.Effect): Job<Trash.Event, Agent | NoteStore | NoteDevice | NoteContent | Trash.Machine | KeyValueStore.KeyValueStore | Notes | Editor, [Actor]> {
  return match (fx) {
    when { tag: "Lists" }: answer("trash", listed(fx.owner, fx.ticket), { type: "listed", ticket: fx.ticket, ok: false, entries: [] }, phone);
    when { tag: "Keeps" }: answer(`keep ${fx.ticket}`, effect {
      const number = try (try Attempts).key(fx.ticket)
      const shelf = try KeyValueStore.KeyValueStore
      const key = `alpha/trash/${number}`
      const entry = JSON.stringify({ owner: fx.owner, act: fx.act, subject: fx.subject, recordings: fx.recordings })
      const kept = effect { try shelf.set(key, entry); return (try shelf.get(key)) === entry } catch () => false
      return { type: "kept", ticket: fx.ticket, ok: kept } satisfies Trash.Event
    }, { type: "kept", ticket: fx.ticket, ok: false }, phone);
    when { tag: "Does" }: answer(`action ${fx.ticket}`, action(fx), { type: "finished", ticket: fx.ticket, verdict: "Lost", revision: fx.revision }, phone);
    when { tag: "ErasesAudio" }: answer(`audio ${fx.ticket}`, effect { return { type: "audioErased", ticket: fx.ticket, ...(try cleanRecorded(fx.recordings)) } satisfies Trash.Event }, { type: "audioErased", ticket: fx.ticket, ok: false, known: false }, phone);
    when { tag: "Changed" }: run("notes changed", effect { try ignore((try Notes).send({ type: "storeChanged" }, phone)) }, phone);
    when { tag: "Answers" }: run(`deletion ${fx.ticket}`, effect {
      try ignore((try Editor).send({ type: "deleted", ticket: fx.ticket, binned: fx.binned, told: fx.told }, phone))
    }, phone);
  }
}

// spec/app/notes/trash.md, "The phone's maintenance, at its start, on resuming and every fifteen minutes, reads Recently deleted again with the time, which never goes back"; spec/app/notes/trash.md, "Notes past their three days are erased by the phone, as one action like any other, from the reading of its maintenance"
const maintenance = started(effect {
  const bin = try Trash.Machine
  const device = try Device
  const runMaintain = effect {
    const state = try bin.get()
    if (Trash.canMaintain(state, untimed, phone)) try ignore(bin.send({ type: "maintain", now: untimed }, phone))
  }
  const ownerReady = Stream.changes(Stream.map(bin.changes, (s) => s.owner)) |> Stream.filter(%, (owner) => owner > 0)
  const resumed = Stream.filter(device.visible, (front) => front)
  const periodic = Stream.fromSchedule(Schedule.spaced("15 minutes"))
  const triggers = Stream.merge(Stream.merge(ownerReady, resumed), periodic)
  const sweepDue = Stream.runForEach(
    Stream.changes(Stream.map(bin.changes, (s) => Trash.canSweep(s, true, phone))),
    effect (canSweep) => {
      if (canSweep) try ignore(bin.send({ type: "sweep", storage: true }, phone))
    },
  )
  try Effect.all([Stream.runForEach(triggers, () => runMaintain), sweepDue], { concurrency: "unbounded" })
}, "maintain Recently deleted")

/** Notes Trash with the phone's durable attempt numbers, 3-day maintenance, and the agent's canonical store. */
export const trashing = together(reacting(Trash, { keep: 1, open: [{ type: "restart" }, phone], carry }), maintenance)
