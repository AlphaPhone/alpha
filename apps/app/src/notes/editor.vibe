// spec/app/notes/editor.md, "Story: Write a note"; spec/app/notes/editor.md, "Story: Keep my draft through a restart"; spec/app/notes/editor.md, "Story: Delete the note I am writing"
import type { StickyNote } from "@elizaos/plugin-notes-client"
import * as Editor from "../../gen/app__notes__editor.effect.vibe"
import * as List from "../../gen/app__notes.effect.vibe"
import * as Trash from "../../gen/app__notes__trash.effect.vibe"
import type { Actor, Source } from "../../gen/app__notes__note.effect.vibe"
import { NoteStore } from "../platform/index.vibe"
import { type Agent } from "../platform/index.vibe"
import { ownerAt } from "../platform/index.vibe"
import { fresh } from "../runtime/index.vibe"
import { type Job, answer, migratedStore, reacting, run, started, together, untimed } from "../runtime/index.vibe"
import { type Collection, type DraftWords, NoteContent, formatOf, fromSaved, hasContent, newWords, numberOf, wordsOf } from "./content.vibe"

export type Fields = Pick<DraftWords, "title" | "body" | "items" | "kind" | "pinned">

const phone: Actor = "Phone"

/** The title a new note starts with: New note, or the next number past every note and deleted note already titled New note or New note and a number, as v119's nextDefaultNoteTitle. */
export function startingTitle(collection: Collection): string {
  const base = "new note"
  let highest = 0
  for (const note of [...collection.noteByNumber.values(), ...collection.trash.map((entry) => entry.note)]) {
    if (typeof note.title !== "string") continue
    const title = note.title.trim().toLowerCase()
    if (title === base) highest = Math.max(highest, 1)
    if (title === base || !title.startsWith(base)) continue
    const rest = title.slice(base.length)
    const spaced = rest.trimStart()
    const digits = spaced.startsWith("#") ? spaced.slice(1) : spaced
    if (spaced === rest || digits === "" || [...digits].some((char) => char < "0" || char > "9")) continue
    const number = Number(digits)
    if (Number.isSafeInteger(number) && number > 0) highest = Math.max(highest, number)
  }
  return highest > 0 ? `New note ${highest + 1}` : "New note"
}

/** A new note holding only the title it started with, no words or items, and no pin, that the owner has not asked to share: nothing of it is the owner's, so it is never saved or kept. */
function startedOnly(draft: DraftWords, collection: Collection, current: Editor.Editor): boolean {
  return draft.id === "" && draft.pinned !== true && !current.asked && draft.title === startingTitle(collection) && !hasContent({ ...draft, title: "" })
}

effect function freshEditor(kind: Fields["kind"], available: boolean, folder: number, covered: boolean) {
  const editor = try Editor.Machine
  const content = try NoteContent
  const collection = try content.collection()
  const owner = collection.owner
  if (owner === "") return
  const active = ownerAt() catch () => ""
  if (active !== owner) return
  const opened = (editor.send({ type: "newNote", kind, available, folder, covered }, "Owner") catch () => undefined)?.state
  if (opened !== undefined) try content.showDraft({ ...newWords(owner, opened.made, folder, kind), title: startingTitle(collection) })
}

effect function oldEditor() {
  const editor = try Editor.Machine
  const content = try NoteContent
  const list = try List.Machine
  const owner = ownerAt() catch () => ""
  if (owner === "" || (try content.collection()).owner !== owner) return
  const latest = try content.collection()
  const draft = try content.draft()
  const state = (editor.send({ type: "takeSaved" }, "Owner") catch () => undefined)?.state
  if (state === undefined) return
  const saved = latest.noteByNumber.get(state.note)
  if (saved !== undefined) try content.showDraft(fromSaved(saved, owner, state.draft.base))
  else try content.showDraft(draft)
  try ignore(content.dropDraft(owner))
  try ignore(list.send({ type: "storeChanged" }, phone))
}

effect function saveDraft(by: "Owner" | "Phone") {
  const editor = try Editor.Machine
  const content = try NoteContent
  const draft = try content.draft()
  const current = try editor.get()
  if (draft === undefined || !Editor.canSave(current, by) || !hasContent(draft) || startedOnly(draft, try content.collection(), current)) return
  const ticket = current.ticket + 1
  try content.capture(ticket, draft)
  const sent = editor.send({ type: "save" }, by) catch () => undefined
  if (sent === undefined) try content.dropCapture(ticket, draft)
}

export service NoteEditor {
  newNote(kind: Fields["kind"], available: boolean, folder: number, covered: boolean): void!!(Agent | Editor.Machine | NoteContent)
  typed(fields: Partial<Fields>): void!!
  syncEdit(draft: DraftWords): void!!
  save(): void!!(Editor.Machine | NoteContent)
  autoSave(): void!!(Editor.Machine | NoteContent)
  close(): void!!(Agent | Editor.Machine | NoteContent)
  left(): void!!(Editor.Machine | NoteContent)
  noteRead(note: number, latest: number, present: boolean, link: Source, saved: StickyNote | undefined, owner: string): void!!(Editor.Machine | NoteContent)
  takeSaved(): void!!(Agent | Editor.Machine | NoteContent | List.Machine)
  keepMine(): void!!(Editor.Machine | NoteContent)
  keepAsNew(): void!!(Editor.Machine | NoteContent)
  discard(): void!!Agent
  pinNew(pinned: boolean): void!!(Editor.Machine | NoteContent)
  shareNew(): void!!(Editor.Machine | NoteContent)
  shareWhenSaved(): void!!(Editor.Machine | NoteContent)
  deleteWhenSaved(ready: boolean): void!!(Editor.Machine | NoteContent)
  settled(initial: DraftWords, id: string, revision: number): void!!
}

const typing = Layer.effect(NoteEditor, effect {
  const read = try NoteContent
  const editor = try Editor.Machine
  const turn = try Semaphore.make(1)

  effect function commitEdit(next: DraftWords) {
    const current = try editor.get()
    if (!Editor.canEdit(current, "Owner")) return
    const kept = try read.keepDraft(next)
    const event: Editor.Event = next.kind === current.kind ? { type: "edit", kept } : { type: "formatNote", kind: next.kind, kept }
    try ignore(editor.send(event, "Owner"))
  }

  effect function letGo(current: Editor.Editor) {
    if (!Editor.canDiscardDraft(current, "Owner") && !Editor.canDropDraft(current, "Owner")) return
    const identity = ownerAt() catch () => ""
    if (identity === "" || numberOf("owner", identity) !== current.owner || !(try read.dropDraft(identity))) return
    try ignore(editor.send({ type: current.unreadable ? "dropDraft" : "discardDraft" }, "Owner"))
    try read.showDraft(undefined)
  }

  effect function close() {
    const current = try editor.get()
    if (!Editor.canClose(current)) return
    const draft = try read.draft()
    const untouched = draft !== undefined && startedOnly(draft, try read.collection(), current)
    if (!untouched) try saveDraft("Owner")
    const moved = (editor.send({ type: "close" }, "Owner") catch () => undefined)?.state
    if (moved !== undefined && untouched && Editor.waiting(moved)) try letGo(moved)
    else if (moved !== undefined && !Editor.waiting(moved)) try read.showDraft(undefined)
  }

  effect function typed(fields: Partial<Fields>) {
    const current = try editor.get()
    const draft = try read.draft()
    if (draft === undefined || !Editor.canEdit(current, "Owner")) return
    const next = { ...draft, ...fields }
    try read.showDraft(next)
    try commitEdit(next)
  }

  return {
    newNote: (kind: Fields["kind"], available: boolean, folder: number, covered: boolean) => turn.withPermit(freshEditor(kind, available, folder, covered)),
    typed: (fields: Partial<Fields>) => turn.withPermit(typed(fields)),
    syncEdit: (draft: DraftWords) => turn.withPermit(commitEdit(draft)),
    save: () => turn.withPermit(saveDraft("Owner")),
    autoSave: () => turn.withPermit(saveDraft("Phone")),
    close: () => turn.withPermit(close()),
    left: () => turn.withPermit(effect {
      const moved = (editor.send({ type: "left" }, phone) catch () => undefined)?.state
      if (moved !== undefined && !Editor.waiting(moved)) try read.showDraft(undefined)
    }),
    noteRead: (note: number, latest: number, present: boolean, link: Source, saved: StickyNote | undefined, owner: string) => turn.withPermit(effect {
      const active = try editor.get()
      if (!Editor.canNoteRead(active, note, latest, present, link, phone)) return
      const moved = (editor.send({ type: "noteRead", note, latest, present, link }, phone) catch () => undefined)?.state
      if (moved === undefined) return
      if (!present && !moved.showing && !Editor.waiting(moved)) {
        try read.showDraft(undefined)
        return
      }
      if (!Editor.waiting(active) && saved !== undefined) try read.showDraft(fromSaved(saved, owner, latest))
    }),
    takeSaved: () => turn.withPermit(oldEditor()),
    keepMine: () => turn.withPermit(effect {
      const current = (editor.send({ type: "keepMine" }, "Owner") catch () => undefined)?.state
      const draft = try read.draft()
      if (current === undefined || draft === undefined) return
      const retained = { ...draft, base: current.draft.base }
      try read.showDraft(retained)
      try ignore(read.keepDraft(retained))
      try saveDraft("Owner")
    }),
    keepAsNew: () => turn.withPermit(effect {
      const current = (editor.send({ type: "keepAsNew" }, "Owner") catch () => undefined)?.state
      const draft = try read.draft()
      if (current === undefined || draft === undefined) return
      const retained = { ...draft, id: "", made: current.made, creation: fresh(), base: 0 }
      try read.showDraft(retained)
      try ignore(read.keepDraft(retained))
      try saveDraft("Owner")
    }),
    discard: () => turn.withPermit(effect { try letGo(try editor.get()) }),
    pinNew: (pinned: boolean) => turn.withPermit(effect {
      const current = try editor.get()
      const draft = try read.draft()
      if (draft === undefined || !Editor.canPinNew(current, "Owner")) return
      const next = { ...draft, pinned }
      try read.showDraft(next)
      const kept = try read.keepDraft(next)
      const moved = editor.send({ type: "pinNew", kept }, "Owner") catch () => undefined
      if (moved !== undefined) try saveDraft("Owner")
    }),
    shareNew: () => turn.withPermit(effect {
      const current = try editor.get()
      const draft = try read.draft()
      if (draft === undefined || !Editor.canShareNew(current, "Owner")) return
      const kept = Editor.waiting(current) || (try read.keepDraft(draft))
      try ignore(editor.send({ type: "shareNew", kept }, "Owner"))
      try saveDraft("Owner")
    }),
    // spec/app/notes/editor.md, "More over a saved note stays offered while an edit waits to be saved or a save is on its way, and its Share and Delete wait for the save to land, as v119's did"
    shareWhenSaved: () => turn.withPermit(effect {
      if (!Editor.canShareWhenSaved(try editor.get(), "Owner")) return
      try ignore(editor.send({ type: "shareWhenSaved" }, "Owner"))
      try saveDraft("Owner")
    }),
    deleteWhenSaved: (ready: boolean) => turn.withPermit(effect {
      if (!Editor.canDeleteWhenSaved(try editor.get(), ready, "Owner")) return
      try ignore(editor.send({ type: "deleteWhenSaved", ready }, "Owner"))
      try saveDraft("Owner")
    }),
    settled: (initial: DraftWords, id: string, revision: number) => turn.withPermit(effect {
      const current = try read.draft()
      if (current === undefined || current.owner !== initial.owner || current.creation !== initial.creation) return
      const { pinned: _pinned, ...words } = current
      const saved = { ...words, id, base: revision, folder: 0, made: 0 }
      try read.showDraft(saved)
      if (current === initial) try ignore(read.dropDraft(initial.owner))
      else try ignore(read.keepDraft(saved))
    }),
  }
})

effect function savedRequest(fx: Extract<Editor.Effect, { readonly tag: "Saves" }>): Editor.Event!!(Editor.Machine | NoteContent | NoteStore | List.Machine | NoteEditor | Agent) {
  const { owner, ticket, note, made, base, folder } = fx
  const failed: Editor.Event = { type: "saved", ticket, verdict: "Failed", revision: 0, id: 0 }
  const content = try NoteContent
  const store = try NoteStore
  const initial = try content.take(ticket)
  if (initial === undefined || !hasContent(initial) || (note === 0 ? initial.made !== made : numberOf("note", initial.id) !== note)) return failed
  const identity = ownerAt() catch () => ""
  if (identity !== initial.owner || numberOf("owner", identity) !== owner) return failed
  const collection = try content.collection()
  const stored = note === 0 ? undefined : collection.noteByNumber.get(note)
  const folderOf = folder > 0 ? collection.folderByNumber.get(folder) : undefined
  const format = formatOf(initial, stored, folderOf)
  const words = wordsOf(initial)
  const result = (note === 0
    ? store.create({ content: words, format, creationId: initial.creation })
    : store.update({ id: initial.id, expectedRevision: base - 1, content: words, format })) catch () => undefined
  const after = ownerAt() catch () => ""
  if (after !== identity || (try (try Editor.Machine).get()).owner !== owner) return failed
  if (result?.note === undefined) {
    const latest = store.read() catch () => undefined
    if (latest === undefined || note === 0) return failed
    try ignore((try List.Machine).send({ type: "storeChanged" }, phone))
    const revision = latest.revision + 1
    if (!latest.notes.some((row) => row.id === initial.id)) return { type: "saved", ticket, verdict: "Gone", revision, id: note }
    return revision > base ? { type: "saved", ticket, verdict: "Collided", revision, id: note } : failed
  }
  const id = numberOf("note", result.note.id)
  const revision = result.state.revision + 1
  if (revision <= base) return failed
  try (try NoteEditor).settled(initial, result.note.id, revision)
  try ignore((try List.Machine).send({ type: "storeChanged" }, phone))
  return { type: "saved", ticket, verdict: "Landed", revision, id }
}

function carry(fx: Editor.Effect): Job<Editor.Event, Editor.Machine | NoteContent | NoteStore | List.Machine | NoteEditor | Agent | Trash.Machine, [Actor]> {
  return match (fx) {
    when { tag: "Saves" }: answer(`save ${fx.ticket}`, savedRequest(fx), { type: "saved", ticket: fx.ticket, verdict: "Failed", revision: 0, id: 0 }, phone);
    when { tag: "Deletes" }: run(`delete ${fx.ticket}`, effect {
      const bin = try Trash.Machine
      const moved = bin.send({ type: "discard", id: fx.note, revision: fx.revision, recording: 0, asked: fx.ticket, now: untimed, storage: true }, "Owner") catch () => undefined
      if (moved === undefined) try ignore((try Editor.Machine).send({ type: "deleted", ticket: fx.ticket, binned: false, told: "WasRefused" }, phone))
    }, phone);
  }
}

const saving = started(effect {
  const editor = try Editor.Machine
  const writer = try NoteEditor
  const ready = (state: Editor.Editor): number => state.showing && !state.failed && Editor.canSave(state, "Phone") ? state.draft.edits : 0
  try Stream.runForEach(Stream.debounce(Stream.changes(Stream.map(editor.changes, ready)), "700 millis"), effect (edits) => {
    if (edits > 0 && ready(try editor.get()) === edits) try writer.autoSave()
  })
}, "save drafts while Notes is open")

// spec/app/notes/editor.md, "More over a saved note stays offered while an edit waits to be saved or a save is on its way, and its Share and Delete wait for the save to land, as v119's did"
/**
 * A Delete the owner chose while the note was being saved goes to Recently deleted once the save lands, at the revision
 * saved: once the list has read the store at that revision, so Recently deleted checks the note the owner saw, and
 * Recently deleted has no action of its own in flight.
 */
const binning = started(effect {
  const editor = try Editor.Machine
  const bin = try Trash.Machine
  const list = try List.Machine
  const states = Stream.zipLatest(Stream.zipLatest(editor.changes, bin.changes), list.changes)
  try Stream.runForEach(states, effect ([[state, trash], listed]) => {
    if (!Editor.canDeleteShown(state, true, phone) || Trash.busy(trash) || listed.read.status !== "Loaded" || listed.version < state.draft.base) return
    try ignore(editor.send({ type: "deleteShown", ready: Trash.ready(try bin.get()) }, phone))
  })
}, "delete the note the owner asked to delete once its save lands")

/** An editor kept before a Delete could wait on a save has no `binning`: it is read as asking for none, so its draft is not set aside. */
effect function editorRecord(raw: string | undefined): (string | undefined)!! {
  if (raw === undefined) return undefined
  const fields = Schema.decodeUnknownEffect(Schema.fromJsonString(Schema.Record(Schema.String, Schema.Unknown)))(raw) catch () => undefined
  if (fields === undefined || "binning" in fields) return raw
  const migrated = Editor.decodeState({ binning: Editor.initial.binning, ...fields }) catch () => undefined
  return migrated === undefined ? raw : JSON.stringify(migrated)
}

function stored(key: string, start = Editor.initial) {
  return Layer.provide(Editor.stored(key, start), migratedStore(key, editorRecord))
}

/** On leaving or reloading Notes, the saved words live in the phone vault, with only revision metadata in the machine. */
export const editing = together(Layer.provideMerge(typing, reacting({ ...Editor, stored }, { keep: 1, open: [{ type: "restart", readable: true }, phone], carry })), saving, binning)
