// spec/app/notes/index.md, "A voice note opens only as a voice note, a link note only in its dialog, and text and checklists only in the editor"; spec/app/notes/editor.md, "Story: Write a note"; spec/app/notes/voice.md, "Story: Read and use the transcript"; spec/app/notes/linkNote.md, "Story: Open a link note"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as List from "../../gen/app__notes.effect.vibe"
import type { Row } from "../../gen/app__notes.ts"
import * as Editor from "../../gen/app__notes__editor.effect.vibe"
import type { Effect as Saving, Event as Edit, Verdict } from "../../gen/app__notes__editor.effect.vibe"
import * as Link from "../../gen/app__notes__linkNote.effect.vibe"
import type { Effect as Visiting, Event as Visit } from "../../gen/app__notes__linkNote.effect.vibe"
import type { Actor } from "../../gen/app__notes__note.ts"
import * as Voice from "../../gen/app__notes__voice.effect.vibe"
import type { Effect as Listening, Event as Listen } from "../../gen/app__notes__voice.effect.vibe"
import type { Agent } from "../platform/agent.vibe"
import { type Job, answer, contained, reacting, run, together } from "../runtime/reactor.vibe"
import { type Words, cleared, current, put, wordsOf, written } from "./drafts.ts"
import { noteOf, numberOf, pageOf, storedId } from "./shown.ts"
import { interact, readState } from "./store.vibe"

module web {
  /** Open `url` in the phone's browser. @throws {never} */
  export function visited(url: string): void {
    window.open(url, "_blank", "noopener")
  }
}
import { visited } from web

/** Every machine of an open note: the editor, a voice note and a link note's dialog. */
export type Opened = Editor.Machine | Voice.Machine | Link.Machine

// spec/app/notes/index.md, "The owner opens a note the list shows, when nothing else of Notes is open, and it opens as listed"
/** Open `row` as its kind needs: a text note or a checklist in the editor, a voice note as one, a link note in its dialog. */
export effect function shows(row: Row) {
  const note = noteOf(row.id)
  if (note === undefined) return
  if (row.kind === "Voice") {
    const segments = Math.max(1, note.format?.data.lines?.length ?? 0)
    const summary = (note.format?.data.summary?.length ?? 0) > 0 ? segments : 0
    try contained((try Voice.Machine).send({ type: "openVoice", note: row.id, revision: row.revision, segments, heard: segments, summary, covered: false }, "Owner"), "opening a voice note")
    return
  }
  if (row.kind === "Link") {
    try contained((try Link.Machine).send({ type: "openLink", note: row.id, revision: row.revision, kind: row.kind, origin: row.origin, link: row.source, covered: false }, "Owner"), "opening a link note")
    return
  }
  put(wordsOf(note))
  try contained((try Editor.Machine).send({ type: "openNote", id: row.id, revision: row.revision, kind: row.kind, link: row.source, covered: false }, "Owner"), "opening a note")
}

/** Tell every machine of an open note who has the phone now. */
export effect function tellOwner(owner: number) {
  cleared()
  try contained((try Editor.Machine).send({ type: "ownerChanged", owner }, "Phone"), "telling the editor who is signed in")
  try contained((try Voice.Machine).send({ type: "ownerChanged", owner }, "Phone"), "telling the voice note who is signed in")
  try contained((try Link.Machine).send({ type: "ownerChanged", owner }, "Phone"), "telling the link note who is signed in")
}

/** Where the phone keeps `owner`'s unsaved draft. */
function draftKey(owner: number): string {
  return `alpha.notes.draft.${owner}`
}

// spec/app/notes/editor.md, "The owner types, adds or ticks an item, and each change is kept on the phone at once"
/** The owner typed: the editor shows `next`, the phone keeps it for its owner, and the editor counts the edit. */
export effect function typed(next: Words) {
  put(next)
  const editor = try Editor.Machine
  const { owner } = try editor.get()
  const kept = effect {
    try (try KeyValueStore.KeyValueStore).set(draftKey(owner), JSON.stringify(next))
    return true
  } catch () => false
  try contained(editor.send({ type: "edit", kept }, "Owner"), "keeping what was typed")
}

// spec/app/notes/editor.md, "A save lands, finds a newer revision, finds the note deleted, or fails, and only the phone's answer to the last save counts"; spec/app/notes/index.md, "The store says when it changed, and the list reads it again, once, when it is free"
/** Save the draft as `fx` asks: over the store's revision it builds on, or as a new note under its creation number. */
effect function save(fx: Saving & { readonly tag: "Saves" }): Edit!!(Agent | List.Machine) {
  const failed = (verdict: Verdict, revision: number): Edit => ({ type: "saved", ticket: fx.ticket, verdict, revision, id: 0 })
  if (fx.kind !== "Text" && fx.kind !== "Checklist") return failed("Failed", 0)
  const words = written(fx.kind, current())
  const id = storedId(fx.note)
  if (fx.note > 0 && id === undefined) return failed("Gone", 0)
  const asked = fx.note > 0
    ? interact("update-note", { id, ...words, expectedRevision: fx.base })
    : interact("create-note", { ...words, color: "yellow", creationId: `alpha-${fx.owner}-${fx.made}` })
  return effect {
    const done = try asked
    try contained((try List.Machine).send({ type: "storeChanged" }, "Phone"), "telling the list the store changed")
    const made = done.data?.note.id
    return { type: "saved", ticket: fx.ticket, verdict: "Landed", revision: done.state.revision, id: made === undefined ? fx.note : numberOf(made) } as Edit
  } catch effect (failure) => {
    if (failure._tag === "Refused" && failure.status === 404 && fx.note > 0) return failed("Gone", 0)
    if (failure._tag === "Refused" && failure.status === 409 && fx.note > 0) {
      const latest = (readState() catch () => undefined)?.revision ?? 0
      return latest > fx.base ? failed("Collided", latest) : failed("Failed", 0)
    }
    return failed("Failed", 0)
  }
}

function writing(fx: Saving): Job<Edit, Agent | List.Machine, [by: Actor]> {
  return match (fx) {
    when { tag: "Saves", let ticket }: answer("save", save(fx), { type: "saved", ticket, verdict: "Failed", revision: 0, id: 0 }, "Phone");
    when { tag: "Deletes", let ticket }: answer("delete", sync((): Edit => ({ type: "deleted", ticket, binned: false, told: "WasRefused" })), { type: "deleted", ticket, binned: false, told: "WasUnknown" }, "Phone");
  }
}

function listening(fx: Listening): Job<Listen, never, [by: Actor]> {
  return match (fx) {
    when { tag: "Transcribes", let ticket }: answer("transcribe", sync((): Listen => ({ type: "transcribed", ticket, ok: false })), { type: "transcribed", ticket, ok: false }, "Phone");
    when { tag: "Summarises", let ticket }: answer("summarise", sync((): Listen => ({ type: "summarised", ticket, ok: false })), { type: "summarised", ticket, ok: false }, "Phone");
    when { tag: "Writes", let ticket }: answer("write", sync((): Listen => ({ type: "written", ticket, ok: false, known: true, latest: 0 })), { type: "written", ticket, ok: false, known: false, latest: 0 }, "Phone");
    when { tag: "AsksAlpha" }: run("ask", sync(() => undefined), "Phone");
    when { tag: "Plays", let ticket }: answer("play", sync((): Listen => ({ type: "played", ticket, ok: false })), { type: "played", ticket, ok: false }, "Phone");
    when { tag: "Halts", let ticket }: answer("halt", sync((): Listen => ({ type: "halted", ticket, ok: true })), { type: "halted", ticket, ok: false }, "Phone");
  }
}

function visiting(fx: Visiting): Job<Visit, never, [by: Actor]> {
  return match (fx) {
    when { tag: "Visits", let page }: run("visit", sync(() => {
      const url = pageOf(page)
      if (/^https:\/\//.test(url)) visited(url)
    }), "Phone");
    when { tag: "Removes", let ticket }: answer("remove", sync((): Visit => ({ type: "removed", ticket, ok: false, known: true })), { type: "removed", ticket, ok: false, known: false }, "Phone");
  }
}

/** The machines of an open note, in memory: the editor and its saves, a voice note and a link note's dialog. */
export const views = together(reacting(Editor, { carry: writing }), reacting(Voice, { carry: listening }), reacting(Link, { carry: visiting }))
