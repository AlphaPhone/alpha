// spec/notes/trash.md, "Story: Keep the notes I deleted before this version"; spec/notes/trash.md, "An earlier device Trash row comes into the canonical Trash once, and the device slot clears only after every row is settled"
import { parseNoteFormat } from "@elizaos/plugin-notes/format"
import type { NoteFormat, NoteJson, NotesSnapshot } from "@elizaos/plugin-notes/types"
import { legacyRowKept, legacySlotClears } from "../../gen/notes__trash.effect.vibe"
import { NotesCollection } from "./collection.vibe"
import { contentOf } from "./list.vibe"
import { decodeLegacyTrash, type LegacyTrashNote } from "./notes.schema.vibe"
import { compareExchangeSlot, readSlot, slots } from "./slots.vibe"

/** The canonical content of an earlier device note: its title line, then its body. */
export function legacyContent(note: LegacyTrashNote): string {
  const body = note.body ?? ""
  return contentOf(note.title, body === "" ? "" : "\n", body.startsWith("\n") ? body.slice(1) : body)
}

/** The canonical format of an earlier device note's rich data, without its recording; undefined for a plain note outside any folder. */
export function legacyFormat(note: LegacyTrashNote): NoteFormat | undefined {
  const data: Record<string, NoteJson> = {}
  if (note.folderId !== undefined) data.folderId = note.folderId
  if (note.kind === "list") data.items = (note.items ?? []).map((item) => ({ t: item.t, done: item.done === true }))
  if (note.kind === "voice") {
    data.lines = (note.lines ?? []).map((line) => ({ t: line.t, at: line.at ?? 0, ...(line.s === undefined ? {} : { s: line.s }) }))
    if (note.summary !== undefined) data.summary = [...note.summary]
    if (note.actions !== undefined) data.actions = note.actions.map((item) => ({ t: item.t, done: item.done === true }))
  }
  if (note.kind === "link") {
    if (note.url !== undefined) data.url = note.url
    if (note.domain !== undefined) data.domain = note.domain
    if (note.clips !== undefined) data.clips = [...note.clips]
  }
  if (note.kind === "text" && Object.keys(data).length === 0) return undefined
  return parseNoteFormat({ kind: note.kind, data })
}

function trashed(state: NotesSnapshot, noteId: string): boolean {
  return (state.trash ?? []).some((entry) => entry.note.id === noteId)
}

/** Bring the rows the earlier device Trash still keeps into the canonical Trash of the bound owner, then clear its slot once every row is settled; the count of settled rows. */
export effect function importLegacyTrash(): number!! {
  const collection = try NotesCollection
  if ((try collection.current()) === undefined) return 0
  const raw = try (readSlot(slots.legacyTrash) catch () => undefined)
  if (raw === undefined) return 0
  const document = try (decodeLegacyTrash(raw) catch () => undefined)
  if (document === undefined) return 0
  const now = Date.now()
  let settled = 0
  for (const entry of document.entries) {
    if (!legacyRowKept({ deletedAt: entry.deletedAt, now, inCanonicalTrash: false })) {
      settled += 1
      continue
    }
    const format = legacyFormat(entry.note)
    const created = try (collection.interact("create-note", {
      content: legacyContent(entry.note), creationId: `legacy-trash:${entry.id}`, color: entry.note.color ?? "yellow",
      ...(format === undefined ? {} : { format }),
    }) catch () => undefined)
    const noteId = created?.target?.id
    if (created === undefined || noteId === undefined) continue
    if (trashed(created.state, noteId)) {
      settled += 1
      continue
    }
    const deleted = try (collection.interact("delete-note", { id: noteId }) catch () => undefined)
    if (deleted !== undefined && trashed(deleted.state, noteId)) settled += 1
  }
  if (!legacySlotClears(settled, document.entries.length)) return settled
  try (compareExchangeSlot(slots.legacyTrash, raw, undefined) catch () => false)
  return settled
}
