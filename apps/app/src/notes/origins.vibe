// spec/notes/origins.md, "Story: Turn a note into an event or a reminder I review in Calendar"; spec/notes/origins.md, "The draft text is the note's open action items, then its open checklist items, then its body"; spec/notes/origins.md, "A link resolves only against the open collection it belongs to"; spec/notes/origins.md, "A link is stored only for a record that was saved, and retired with a durable deletion receipt"; spec/notes/share.md, "A share acts on the open note's snapshot, only while it is still the same note"
import { noteLinkOf, noteOriginTitle, noteScheduleDraft, recordNoteRevision, resolveNoteLink, type NoteLink, type NoteScheduleDraft, type NoteScheduleKind } from "@elizaos/plugin-notes/client"
import { linkStored, originLabel, originOpensEdited, originResolution, originRetires, type OriginLabel } from "../../gen/notes__origins.effect.vibe"
import { NotesCollection } from "./collection.vibe"
import type { NotesFilter } from "./list.vibe"
import { decodeOrigins, type OriginIndex } from "./notes.schema.vibe"
import { compareExchangeSlot, readSlot, slots } from "./slots.vibe"

/** What Notes asks the shell to open in another app; nothing is saved or sent by the request itself. */
export type NotesRequest =
  | { readonly kind: "open-notes"; readonly filter?: NotesFilter; readonly noteId?: string }
  | { readonly kind: "calendar-draft"; readonly draft: NoteScheduleDraft }
  | { readonly kind: "email-draft"; readonly subject: string; readonly body: string }
  | { readonly kind: "open-web-source"; readonly url: string }

/** The requests Notes hands to the shell, which opens the app each names, and the list filter a request asked Notes to show. */
export service NotesHandoff {
  readonly requests: Stream.Stream<NotesRequest>
  readonly filters: Stream.Stream<NotesFilter | undefined>
  request(request: NotesRequest): void!!
  /** Show a filter another app's route asked for, without asking the shell for anything. */
  showFilter(filter: NotesFilter): void!!
  clearFilter(): void!!
}

/** The handoff stream. */
export const handoffLayer = Layer.effect(NotesHandoff, effect {
  const hub = try PubSub.unbounded<NotesRequest>()
  const filter = try SubscriptionRef.make<NotesFilter | undefined>(undefined)
  return {
    requests: Stream.fromPubSub(hub),
    filters: SubscriptionRef.changes(filter),
    effect request(request: NotesRequest) {
      if (request.kind === "open-notes" && request.filter !== undefined) try SubscriptionRef.set(filter, request.filter)
      try PubSub.publish(hub, request)
    },
    showFilter: (asked: NotesFilter) => SubscriptionRef.set(filter, asked),
    clearFilter: () => SubscriptionRef.set(filter, undefined),
  }
})

/** Why a note started no draft. */
export type ScheduleRefusal = "empty" | "too-long" | "invalid"

/** How a saved event or reminder shows the note it came from. */
export interface OriginView { readonly label: OriginLabel; readonly title: string; readonly noteId?: string }

/** Back-links from saved events and reminders to their notes. */
export service NotesOrigins {
  scheduleDraft(noteId: string, kind: NoteScheduleKind): ScheduleRefusal | "ready"!!
  remember(kind: "reminder" | "event", recordId: string, link: unknown, saved: boolean): boolean!!
  forget(kind: "reminder" | "event", recordId: string, terminalReceipt: boolean): void!!
  view(kind: "reminder" | "event", recordId: string): OriginView | undefined!!
  open(kind: "reminder" | "event", recordId: string): "opened" | "edited" | "gone" | "unavailable"!!
}

effect function index(): { raw: string | undefined; links: OriginIndex["links"] }!! {
  const raw = try (readSlot(slots.origins) catch () => undefined)
  if (raw === undefined) return { raw, links: [] }
  const decoded = try (decodeOrigins(raw) catch () => undefined)
  return { raw, links: decoded?.links ?? [] }
}

/** The origin links over the device's origin slot. */
export const originsLayer = Layer.effect(NotesOrigins, effect {
  const collection = try NotesCollection
  const handoff = try NotesHandoff

  effect function find(kind: "reminder" | "event", recordId: string): NoteLink | undefined!! {
    const stored = (try index()).links.find((row) => row.kind === kind && row.recordId === recordId)
    return stored === undefined ? undefined : noteLinkOf(stored.link)
  }

  effect function edit(update: (links: OriginIndex["links"]) => OriginIndex["links"]): boolean!! {
    const before = try index()
    const next: OriginIndex = { version: 1, links: update(before.links) }
    return try (compareExchangeSlot(slots.origins, before.raw, JSON.stringify(next)) catch () => false)
  }

  return {
    effect scheduleDraft(noteId: string, kind: NoteScheduleKind) {
      const note = (try collection.current())?.snapshot.notes.find((item) => item.id === noteId)
      if (note === undefined) return "invalid"
      const result = try (tryPromise(() => noteScheduleDraft(note, kind)) catch () => undefined)
      if (result === undefined) return "invalid"
      if (result.status !== "ready") return result.status
      try handoff.request({ kind: "calendar-draft", draft: result.draft })
      return "ready"
    },
    effect remember(kind: "reminder" | "event", recordId: string, link: unknown, saved: boolean) {
      const origin = noteLinkOf(link)
      if (origin === undefined || recordId === "" || !saved) return false
      const written = try edit((links) => [...links.filter((row) => !(row.kind === kind && row.recordId === recordId)), { kind, recordId, link: origin, linkedAt: Date.now() }])
      const readBack = written && (try find(kind, recordId)) !== undefined
      return linkStored(saved, readBack)
    },
    effect forget(kind: "reminder" | "event", recordId: string, terminalReceipt: boolean) {
      if (!originRetires(terminalReceipt, !terminalReceipt)) return
      try edit((links) => links.filter((row) => !(row.kind === kind && row.recordId === recordId)))
    },
    effect view(kind: "reminder" | "event", recordId: string) {
      const link = try find(kind, recordId)
      if (link === undefined) return undefined
      const current = try collection.current()
      const resolved = current === undefined ? undefined : resolveNoteLink(link, current.snapshot.notes)
      const resolution = originResolution(current !== undefined, resolved?.status === "found")
      return { label: originLabel(resolution), title: resolved?.status === "found" ? noteOriginTitle(resolved.note, "Note") : "",
        ...(resolved?.status === "found" && typeof resolved.note.id === "string" ? { noteId: resolved.note.id } : {}) }
    },
    effect open(kind: "reminder" | "event", recordId: string) {
      const link = try find(kind, recordId)
      const current = try collection.current()
      if (link === undefined || current === undefined) return "unavailable"
      const resolved = resolveNoteLink(link, current.snapshot.notes)
      if (resolved.status !== "found") return "gone"
      const note = current.snapshot.notes.find((item) => item.id === resolved.note.id)
      if (note === undefined) return "gone"
      const revision = try (tryPromise(() => recordNoteRevision(note)) catch () => "")
      const linkRevision = "revision" in link && typeof link.revision === "string" ? link.revision : ""
      try handoff.request({ kind: "open-notes", noteId: note.id })
      return originOpensEdited(originResolution(true, true), revision === linkRevision) ? "edited" : "opened"
    },
  }
})
