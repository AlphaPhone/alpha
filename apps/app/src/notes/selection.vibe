// spec/app/notes/agent.md, "The agent reads one note, or the note the owner has open in Notes in front, and is told the revision it read"; spec/app/assistant/index.md, "The agent is told the view, the time zone, the day only from Calendar, and whether something is selected"
import type { StickyNote } from "@elizaos/plugin-notes-client"
import { Machine as Notes, type Notes as List } from "../../gen/app__notes.effect.vibe"
import { Machine as Editor, type Editor as Writing } from "../../gen/app__notes__editor.effect.vibe"
import { Machine as Link, type Dialog } from "../../gen/app__notes__linkNote.effect.vibe"
import { Machine as Voice, type VoiceNote } from "../../gen/app__notes__voice.effect.vibe"
import { Machine as Previous } from "../../gen/app__notes__previous.effect.vibe"
import { Machine as Trash } from "../../gen/app__notes__trash.effect.vibe"
import { Machine as Recorder, unfinished } from "../../gen/app__notes__recording.effect.vibe"
import { Machine as Layers, pageInert } from "../../gen/app__shell__layers.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import type { Agent } from "../platform/agent.vibe"
import { Device } from "../platform/device.vibe"
import { NoteStore } from "../platform/notes.vibe"
import { ownerAt } from "../platform/owner.vibe"
import { NoteContent, numberOf, savedVoice } from "./content.vibe"

export type RendererNote = { readonly kind: "canonical-note" | "canonical-note-source"; readonly id: string; readonly revision: string }
export type NotesSelection = Notes | Editor | Link | Voice | Previous | Trash | Recorder | Layers | Shell | Device | Agent | NoteContent
export type TranscriptSource = {
  readonly owner: number
  readonly number: number
  readonly opened: number
  readonly record: RendererNote & { readonly kind: "canonical-note" }
}
export type NoteTranscript = TranscriptSource & { readonly title: string }

type NoteSubjects = { readonly note: number; readonly owner: number; readonly revision: number; readonly opened: number }

function chosen(list: List, editor: Writing, link: Dialog, voice: VoiceNote): number {
  if (list.read.status !== "Loaded" || list.owner === 0) return 0
  if (editor.showing && editor.owner === list.owner && editor.draft.sync === "Kept" && editor.draft.base === list.version && !editor.deleting) return editor.note
  if (link.showing && link.owner === list.owner && link.revision === list.version && !link.changed) return link.note
  if (voice.showing && voice.owner === list.owner && voice.revision === list.version) return voice.note
  return 0
}

/** The selected record changes only as each Notes detail confirms which exact saved note it shows. */
export const noteSubjects = Stream.unwrap(effect {
  const list = try Notes
  const editor = try Editor
  const link = try Link
  const voice = try Voice
  return Stream.changesWith(Stream.map(Stream.zipLatest(Stream.zipLatest(list.changes, editor.changes), Stream.zipLatest(link.changes, voice.changes)),
    ([[notes, writing], [linked, speaking]]): NoteSubjects => ({
      note: chosen(notes, writing, linked, speaking), owner: notes.owner, revision: notes.version, opened: speaking.showing ? speaking.opened : 0,
    })), (one, next) => one.note === next.note && one.owner === next.owner && one.revision === next.revision && one.opened === next.opened)
})

/** Only identifiers cross to the agent. The agent reads its own saved words after receiving an owner turn. */
export effect function notesSelection(): (RendererNote | undefined)!!NotesSelection {
  const shell = try (try Shell).get()
  if (!showing(shell, "Notes")) return undefined
  const identity = ownerAt() catch () => ""
  if (identity === "" || !(try (try Device).showing()) || pageInert(try (try Layers).get())) return undefined
  if ((try (try Previous).get()).showing || (try (try Trash).get()).showing || unfinished(try (try Recorder).get())) return undefined
  const list = try (try Notes).get()
  const editor = try (try Editor).get()
  const link = try (try Link).get()
  const voice = try (try Voice).get()
  const id = chosen(list, editor, link, voice)
  const snapshot = try (try NoteContent).collection()
  if (list.read.status !== "Loaded" || list.version !== snapshot.version || snapshot.owner !== identity || numberOf("owner", identity) !== list.owner) return undefined
  const note = snapshot.noteByNumber.get(id)
  if (note !== undefined) return { kind: "canonical-note", id: note.id, revision: String(snapshot.version - 1) }
  if (editor.showing || link.showing || voice.showing) return undefined
  return { kind: "canonical-note-source", id: "notes", revision: String(snapshot.version - 1) }
}

/** Read the exact saved voice note while the same owner and opening remain in front. */
export effect function savedVoiceRecord(transcript: TranscriptSource): (StickyNote | undefined)!!(NotesSelection | NoteStore) {
  if (!showing(try (try Shell).get(), "Notes") || !(try (try Device).showing()) ||
    pageInert(try (try Layers).get())) return undefined
  const saved = (try NoteStore).read() catch () => undefined
  if (saved === undefined || String(saved.revision) !== transcript.record.revision) return undefined
  const note = saved.notes.find((item) => item.id === transcript.record.id)
  if (note === undefined || note.format?.kind !== "voice") return undefined
  const selected = try notesSelection()
  const voice = try (try Voice).get()
  const matches = selected?.kind === "canonical-note" && selected.id === transcript.record.id && selected.revision === transcript.record.revision &&
    voice.showing && voice.owner === transcript.owner && voice.note === transcript.number && voice.opened === transcript.opened &&
    String(voice.revision - 1) === transcript.record.revision
  return matches ? note : undefined
}

/** Only a transcript kept on the note can be copied or attached. */
export effect function savedTranscriptRecord(source: TranscriptSource): (StickyNote | undefined)!!(NotesSelection | NoteStore) {
  const note = try savedVoiceRecord(source)
  const voice = try (try Voice).get()
  return note !== undefined && voice.added > 0 && (savedVoice(note)?.lines.length ?? 0) > 0 ? note : undefined
}

export effect function transcriptCurrent(transcript: TranscriptSource): boolean!!(NotesSelection | NoteStore) {
  return (try savedTranscriptRecord(transcript)) !== undefined
}
