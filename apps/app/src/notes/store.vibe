// spec/app/notes/index.md, "Only the phone answers a reading, only the newest reading is taken, and only a well-formed one no older than the one shown"; spec/app/notes/editor.md, "A save lands, finds a newer revision, finds the note deleted, or fails, and only the phone's answer to the last save counts"
import { Agent } from "../platform/agent.vibe"
import { type Failure, ask } from "../platform/remote.vibe"

schema Item { readonly t: string; readonly done?: boolean }
schema Said { readonly s?: string; readonly t: string; readonly at?: number }

/** What a note's format holds that Notes shows: its pin and folder, a checklist's items, a voice note's words and a link note's page. */
schema Data {
  readonly pinned?: boolean
  readonly folderId?: string
  readonly items?: Item[]
  readonly lines?: Said[]
  readonly summary?: string[]
  readonly actions?: Item[]
  readonly audio?: { readonly durationMs?: number }
  readonly url?: string
  readonly domain?: string
  readonly clips?: string[]
}

/** One note of the agent's store, as `@elizaos/plugin-notes` serves it. */
schema Stored {
  readonly id: string
  readonly title: string
  readonly body: string
  readonly format?: { readonly kind: "text" | "list" | "voice" | "link"; readonly data: Data }
  readonly createdAt: string
  readonly updatedAt: string
}

/** The store's notes and the revision they are at. */
export schema Snapshot { readonly notes: Stored[]; readonly revision: number }
schema State { readonly success: true; readonly data: Snapshot }
schema Interacted { readonly success: true; readonly result: { readonly state: Snapshot; readonly data?: { readonly note: Stored } } }

/** The agent's notes store as it is now. */
export effect function readState(): Snapshot!Failure!Agent {
  return (try ask(Agent, HttpClientRequest.get("/api/notes/state"), State)).data
}

/** Ask the store for `capability` with `params`, as `@elizaos/plugin-notes` takes them: the store as it is after, and the note it changed. */
export effect function interact(capability: string, params: Record<string, unknown>): Interacted["result"]!Failure!Agent {
  const request = HttpClientRequest.post("/api/notes/interact") |> HttpClientRequest.bodyJsonUnsafe(%, { capability, params })
  return (try ask(Agent, request, Interacted)).result
}
