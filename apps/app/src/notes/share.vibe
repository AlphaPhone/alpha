// spec/notes/share.md, "Story: Share the note I have open"; spec/notes/share.md, "A share acts on the open note's snapshot, only while it is still the same note"; spec/notes/share.md, "The export text is the note's own words by kind, and a voice note says its audio is not included"; spec/notes/share.md, "One document operation runs at a time, and its receipt shows only in its own visible visit"
import { noteShareText } from "@elizaos/plugin-notes/format"
import type { StickyNote } from "@elizaos/plugin-notes/types"
import { type Event as TransferEvent, Machine as TransferMachine, machine as transferMachine, shareAllowed, textExportFits, type Transfer } from "../../gen/notes__share.effect.vibe"
import { Build } from "../platform/build.vibe"
import { Native } from "../platform/native.vibe"
import { NotesCollection } from "./collection.vibe"
import { NotesHandoff } from "./origins.vibe"
import { decodeDocumentResult } from "./notes.schema.vibe"
import { copyText, pageVisible, randomId, shareText, utf8Size } from "./platform.ts"

/** Where the owner shares the open note. */
export type ShareChannel = "system" | "copy" | "email" | "save"

/** What a share did, for its one-line notice. */
export type ShareNotice = "shared" | "copied" | "drafted" | "saved" | "requested" | "cancelled" | "unavailable" | "changed" | "too-large" | "failed" | "busy"

/** A document operation's receipt, shown in the visit it belongs to. */
export interface DocumentReceipt { readonly visit: number; readonly notice: ShareNotice | "imported" }

/** Sharing, copying and saving the open note, and the test-mock text import. */
export service NotesShare {
  readonly receipts: Stream.Stream<DocumentReceipt>
  share(noteId: string, snapshot: string, channel: ShareChannel): ShareNotice!!
  snapshotOf(noteId: string): (string | undefined)!!
  importText(): (ShareNotice | "imported")!!
  visit(active: boolean): void!!
  visibility(): void!!
}

function shareable(note: StickyNote): { title: string; text: string } | undefined {
  const kind = note.format?.kind ?? "text"
  return kind === "text" || kind === "list" || kind === "voice" || kind === "link" ? noteShareText(note) : undefined
}

const make = effect {
  const collection = try NotesCollection
  const handoff = try NotesHandoff
  const native = try Native
  const build = try Build
  const machine = try TransferMachine
  const receipts = try PubSub.unbounded<DocumentReceipt>()

  effect function send(event: TransferEvent): (Transfer | undefined)!! {
    return try (machine.send(event) catch () => undefined)
  }

  effect function deliver(before: Transfer, after: Transfer | undefined, notice: ShareNotice | "imported"): void!! {
    if (after !== undefined && after.shown > before.shown) try PubSub.publish(receipts, { visit: after.lastShownVisit, notice })
  }

  effect function note(noteId: string): (StickyNote | undefined)!! {
    return (try collection.current())?.snapshot.notes.find((item) => item.id === noteId)
  }

  effect function snapshotOf(noteId: string): (string | undefined)!! {
    const found = try note(noteId)
    const text = found === undefined ? undefined : shareable(found)
    return text === undefined ? undefined : JSON.stringify(text)
  }

  effect function exportText(title: string, text: string): ShareNotice!! {
    const before = try machine.get()
    const begun = try send({ type: "chooseTransfer", kind: "ExportText", testMocks: build.info.testMocks })
    if (begun === undefined) return "unavailable"
    if (begun.refusedBusy > before.refusedBusy) return "busy"
    const size = utf8Size(text)
    const result = !textExportFits(size.bytes, size.valid) ? "too-large"
      : !(try native.available("AlphaNoteDocuments")) ? "unavailable"
      : try (effect {
        const answer = try decodeDocumentResult(try native.invoke("AlphaNoteDocuments", "exportText", { title, text }))
        return answer.status === "exported" ? "saved" : answer.status === "requested" ? "requested" : answer.status === "cancelled" ? "cancelled" : "failed"
      } catch () => "failed")
    const settledBefore = try machine.get()
    const after = try send({ type: "transferSettled", result: result === "failed" ? "TransferThrew" : result === "saved" || result === "requested" ? "TransferDone" : "TransferRefused", stored: false })
    try deliver(settledBefore, after, result)
    return result
  }

  return {
    receipts: Stream.fromPubSub(receipts),
    snapshotOf,
    effect share(noteId: string, snapshot: string, channel: ShareChannel) {
      const found = try note(noteId)
      const fresh = found === undefined ? undefined : shareable(found)
      if (fresh === undefined || !shareAllowed(true, JSON.stringify(fresh) === snapshot, pageVisible())) return "changed"
      const { title, text } = fresh
      if (channel === "copy") {
        const copied = try (effect { try tryPromise(() => copyText(text)); return true } catch () => false)
        return copied ? "copied" : "failed"
      }
      if (channel === "email") { try handoff.request({ kind: "email-draft", subject: title, body: text }); return "drafted" }
      if (channel === "save") return try exportText(title, text)
      const shared = try (tryPromise(() => shareText(title, text)) catch () => "failed" as const)
      return shared === "shared" ? "shared" : shared === "cancelled" ? "cancelled" : shared === "unavailable" ? "unavailable" : "failed"
    },
    effect importText() {
      if (!build.info.testMocks) return "unavailable"
      const before = try machine.get()
      const begun = try send({ type: "chooseTransfer", kind: "ImportText", testMocks: true })
      if (begun === undefined) return "unavailable"
      if (begun.refusedBusy > before.refusedBusy) return "busy"
      const answer = try (effect { return try decodeDocumentResult(try native.invoke("AlphaNoteDocuments", "importText")) } catch () => undefined)
      const read = answer?.status === "read" && typeof answer.text === "string"
      const title = (answer?.name ?? "Imported note").replace(/\.(txt|md|markdown)$/i, "").slice(0, 200)
      const created = read ? try (collection.interact("create-note", { content: `${title}\n${answer?.text ?? ""}`, creationId: `import-${randomId()}`, color: "yellow" }) catch () => undefined) : undefined
      const settledBefore = try machine.get()
      const after = try send({ type: "transferSettled", result: answer === undefined ? "TransferThrew" : read ? "TransferDone" : "TransferRefused", stored: created !== undefined })
      const notice = created !== undefined ? "imported" : answer === undefined ? "failed" : answer.status === "cancelled" ? "cancelled" : "failed"
      try deliver(settledBefore, after, notice)
      return notice
    },
    effect visit(active: boolean) {
      try send({ type: active ? "enterTransfer" : "leaveTransfer" })
    },
    effect visibility() {
      const before = try machine.get()
      const after = try send({ type: pageVisible() ? "showPage" : "hidePage" })
      try deliver(before, after, "requested")
    },
  }
}

/** The share service with its document transfer machine. */
export const shareLayer = Layer.provideMerge(Layer.effect(NotesShare, make), transferMachine())
