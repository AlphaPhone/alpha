// spec/app/home/cards.md, "Story: See my day at a glance"
import type { AndroidCalendarList } from "@elizaos/os-bridges"
import * as Cards from "../../gen/app__home__cards.effect.vibe"
import type { CardVisit, Effect as Out, Event, Flows, Item, Kind, Mail, Origin, Row } from "../../gen/app__home__cards.effect.vibe"
import * as Home from "../../gen/app__home.effect.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import { Machine as Canvas } from "../../gen/app__shell__keyboard.effect.vibe"
import { Machine as Layers } from "../../gen/app__shell__layers.effect.vibe"
import type { View } from "../../gen/app__shell.effect.vibe"
import { Agent } from "../platform/agent.vibe"
import { Device, native, registered } from "../platform/device.vibe"
import { ask } from "../platform/remote.vibe"
import { civilDay, dayStart, localDate } from "../calendar/time.ts"
import { type Job, answer, contained, due, following, hearing, reacting, run, started, untimed, together } from "../runtime/reactor.vibe"
import { Time } from "../runtime/time.vibe"
import { homeInput } from "./home.vibe"

module held {
  import { calendarClient } from "@elizaos/os-bridges"

  let made: ReturnType<typeof calendarClient> | undefined
  /** eliza's client of the `ElizaCalendar` plugin, made once. @throws {never} */
  export function client(): ReturnType<typeof calendarClient> {
    return (made ??= calendarClient())
  }
}
import { client } from held

/** The phone's calendar, where this phone's host registered it. */
function phoneCalendar() {
  return native() && registered("ElizaCalendar") ? client() : undefined
}

/** What each item of a card is called, which the spec never holds: by its origin and its number in the read. */
const titles = new Map<string, string>()
const listeners = new Set<() => void>()
let version = 0

function subscribeNamed(this: void, listener: () => void): () => void {
  listeners.add(listener)
  return () => { listeners.delete(listener) }
}

/** The titles of the items read, as an external store the card reads without an effect. */
export const named = {
  snapshot: (): number => version,
  subscribe: subscribeNamed,
  title: (origin: Origin, id: number): string => titles.get(`${origin}:${id}`) ?? "",
}

function bump() {
  version += 1
  for (const listener of [...listeners]) listener()
}

function titled(origin: Origin, rows: ReadonlyArray<{ readonly title: string }>) {
  rows.forEach((row, at) => titles.set(`${origin}:${at + 1}`, row.title))
  bump()
}

/** A reminder saved on the phone, as the area that keeps it tells the agenda: when it is due, whether it is overdue or done, and its title. */
export interface ToldReminder { readonly due: number; readonly overdue: boolean; readonly done: boolean; readonly title: string }

/** The brief the digests area kept for Home: what it says and when it ran, or that its run failed and when. */
export type ToldBrief = { readonly outcome: "Finished"; readonly summary: string; readonly at: number } | { readonly outcome: "RunFailed"; readonly summary?: string; readonly at: number }

/**
 * What the cards take from the areas that keep it, as they hold it: the reminders saved on the phone, the calendars
 * Calendar hides, Inbox's summary of unread mail, the rows waiting in Messages and Phone, Workflows' enabled rows and
 * the brief kept for Home. Whether this phone is an Alpha image is the shell's.
 */
export interface Told {
  readonly reminders: ReadonlyArray<Item>
  readonly hidden: ReadonlyArray<number>
  readonly mail: Mail
  readonly mailMore: boolean
  /** Which account Inbox read and when, or since when it is not up to date. */
  readonly mailStatus: string
  readonly messages: ReadonlyArray<Row>
  readonly phone: ReadonlyArray<Row>
  /** How many wait in Messages and in Phone, when the newest of each came, and what waits in Phone in words. */
  readonly waiting: { readonly messages: number; readonly messagesAt: number; readonly phone: number; readonly phoneAt: number; readonly phoneSaid: string }
  readonly flows: Flows
  readonly brief: ToldBrief | undefined
}

let told: Told = { reminders: [], hidden: [], mail: Cards.quiet, mailMore: false, mailStatus: "", messages: [], phone: [], waiting: { messages: 0, messagesAt: 0, phone: 0, phoneAt: 0, phoneSaid: "" }, flows: { rows: [], freshness: "UpToDate" }, brief: undefined }

function tell(next: Partial<Told>): void {
  told = { ...told, ...next }
  version += 1
  for (const listener of [...listeners]) listener()
}

/** What Home's cards are given, for a phone that is or is not an Alpha image. */
export function others(
  given: Told,
  image: boolean,
  telegram: Cards.Messaging = Cards.quietMessaging,
  slack: Cards.Messaging = Cards.quietMessaging,
): Cards.Others {
  return {
    image, reminders: [...given.reminders], hidden: [...given.hidden], mail: given.mail,
    telegram, slack,
    messages: [...given.messages], phone: [...given.phone], flows: given.flows, brief: given.brief?.outcome ?? "NoBrief",
  }
}

// spec/app/home/cards.md, "The agenda draws on both calendars and the reminders saved on the phone, leaving out a calendar Calendar hides and a reminder already done"; spec/app/home/cards.md, "Story: The other cards"
/** What other areas tell Home's cards, each as its area holds it now, as an external store the cards read without an effect. */
export const fromAreas = {
  snapshot: (): Told => told,
  subscribe: named.subscribe,
  /** The reminders saved on the phone now, every one of them. */
  reminders(rows: ReadonlyArray<ToldReminder>): void {
    titled("Reminder", rows)
    tell({ reminders: rows.map((row, at) => ({ id: at + 1, origin: "Reminder", calendar: 0, begin: row.due, end: row.due, allDay: false, overdue: row.overdue, done: row.done })) })
  },
  /** The phone's calendars Calendar hides now, by their numbers. */
  hidden(calendars: ReadonlyArray<number>): void { tell({ hidden: [...calendars] }) },
  /** Inbox's summary of the unread mail it loaded: subject and sender, never a body; and which account it read when. */
  mail(mail: Mail, more = false, status = ""): void { tell({ mail, mailMore: more, mailStatus: status }) },
  /** The rows waiting in Messages: who, over the message; how many conversations are unread and when the newest came. */
  messages(rows: ReadonlyArray<Row>, count = rows.length, at = 0): void { tell({ messages: [...rows], waiting: { ...told.waiting, messages: count, messagesAt: at } }) },
  /** The rows waiting in Phone: who, over the missed call or voicemail; how many wait, when the newest came, and what waits in words. */
  phone(rows: ReadonlyArray<Row>, count = rows.length, at = 0, said = ""): void { tell({ phone: [...rows], waiting: { ...told.waiting, phone: count, phoneAt: at, phoneSaid: said } }) },
  /** Workflows' enabled rows, name over status, and how current they are. */
  flows(flows: Flows): void { tell({ flows }) },
  /** The brief kept for Home, or none. */
  brief(brief: ToldBrief | undefined): void { tell({ brief }) },
}

/** The span a card reads for the owner's civil `day`: from the midnight before the day before to the one after the day after. */
function span(day: number) {
  return { begin: dayStart(day - 1), end: dayStart(day + 2) }
}

// spec/app/home/cards.md, "An item stays on the card until it ends: a timed item through its last minute, an all-day item until its day is over, an overdue reminder until it is handled"
/** An all-day bound the phone's calendar keeps at a UTC midnight, as the same date's midnight on this phone. */
function ownersMidnight(at: number): number {
  const utc = new Date(at)
  return new Date(utc.getUTCFullYear(), utc.getUTCMonth(), utc.getUTCDate()).getTime()
}

// spec/app/home/cards.md, "An answer replaces what the calendar had; one whose access is off or has no account leaves nothing behind, and one that failed, could not reach it or ran out keeps what was read before, as not up to date"
effect function readPhone(ticket: number, day: number): Event!!Cards.Machine {
  const calendar = phoneCalendar()
  if (calendar === undefined) return { type: "calendarRead", ticket, source: "Unavailable", items: [] }
  const listed: AndroidCalendarList | undefined = tryPromise(() => calendar.list(span(day))) catch () => undefined
  if (listed === undefined) return { type: "calendarRead", ticket, source: "Broken", items: [] }
  if (listed.status === "permission-required") return { type: "calendarRead", ticket, source: "Denied", items: [] }
  const items: Item[] = listed.events.map((event, at) => ({
    id: at + 1, origin: "PhoneCalendar", calendar: Number.parseInt(event.calendarId, 10) || 0,
    begin: event.allDay ? ownersMidnight(event.begin) : event.begin, end: event.allDay ? ownersMidnight(event.end) : event.end,
    allDay: event.allDay, overdue: false, done: false,
  }))
  if (Cards.canCalendarRead(try (try Cards.Machine).get(), ticket, "Ready", items)) {
    titled("PhoneCalendar", listed.events.map((event) => ({ title: event.title ?? "" })))
  }
  return { type: "calendarRead", ticket, source: "Ready", items }
}

/** The part of the agent's calendar feed the agenda reads: what it could reach, and each event's title and times. */
schema FeedEvent { readonly title: string; readonly startAt: string; readonly endAt: string; readonly isAllDay: boolean }
schema Feed { readonly state: "complete" | "partial" | "unavailable"; readonly events: FeedEvent[] }

// spec/app/home/cards.md, "An answer replaces what the calendar had; one whose access is off or has no account leaves nothing behind, and one that failed, could not reach it or ran out keeps what was read before, as not up to date"
effect function readAgent(ticket: number, day: number): Event!!(Agent | Cards.Machine) {
  const { begin, end } = span(day)
  const request = HttpClientRequest.get("/api/lifeops/calendar/feed", { urlParams: { timeMin: new Date(begin).toISOString(), timeMax: new Date(end).toISOString() } })
  const feed = ask(Agent, request, Feed) catch () => undefined
  if (feed === undefined) return { type: "agentRead", ticket, source: "Broken", events: [] }
  if (feed.state === "unavailable") return { type: "agentRead", ticket, source: "NotConnected", events: [] }
  const events = feed.events.flatMap((event) => {
    const from = event.isAllDay ? localDate(event.startAt) : Date.parse(event.startAt)
    const to = event.isAllDay ? localDate(event.endAt) : Date.parse(event.endAt)
    return Number.isFinite(from) && Number.isFinite(to) ? [{ title: event.title, begin: from, end: to, allDay: event.isAllDay }] : []
  })
  const source: Cards.Source = feed.state === "complete" ? "Ready" : "Unavailable"
  const mapped: Item[] = events.map((event, at) => ({ id: at + 1, origin: "AgentCalendar", calendar: 0, begin: event.begin, end: event.end, allDay: event.allDay, overdue: false, done: false }))
  if (source === "Ready" && Cards.canAgentRead(try (try Cards.Machine).get(), ticket, source, mapped)) {
    titled("AgentCalendar", events)
  }
  return { type: "agentRead", ticket, source, events: mapped }
}

/** The Inbox area prepares the previous reader and search for the next exact Inbox visit. */
export service InboxCardEntry {
  prepare(): (((route: number) => Effect.Effect<void>) | undefined)!!
}

// spec/app/home/cards.md, "A Workflows or Brief card beside the landscape Ask sheet opens Workflows from the same Home visit"; spec/app/home/cards.md, "The unread mail card opens Inbox without a search or message open"
effect function cardVisit(kind: Kind, route: number, beside: boolean) {
  const free = try homeInput(beside)
  const home = try Home.Machine
  return (state: Cards.Cards, shell: Shell.Shell) => {
    if (shell.route !== route || !free()) return undefined
    const h = Effect.runSync(home.get())
    if (!Home.showsCards(h) || h.editing || (beside && !Home.onPhone(h))) return undefined
    const { flows, brief, mail } = fromAreas.snapshot()
    const event = kind === "MailCard"
      ? { type: "openMailCard", shell, beside, shown: Cards.mailCard(mail) !== "Hidden" } as const
      : { type: "openCardBeside", kind, shell, landscapePhone: beside, shown: Cards.shownBeside(kind, flows, brief?.outcome ?? "NoBrief") } as const
    return Cards.enabled(state, event) ? event : undefined
  }
}

export effect function openRoutedCard(kind: Kind, route: number, beside: boolean) {
  const cards = try Cards.Machine
  const shell = try Shell.Machine
  const admits = try cardVisit(kind, route, beside)
  const event = admits(try cards.get(), try shell.get())
  if (event !== undefined) {
    try contained(cards.send(event, (state) => admits(state, Effect.runSync(shell.get())) !== undefined), "choosing a card from Home")
  }
}

// spec/app/home/cards.md, "A card opens its app: the agenda Calendar, Messages and Phone their own, mail Inbox, Telegram and Slack their own, the brief and Workflows Workflows; the agenda asks its calendar again if the last read did not succeed"
effect function go(view: View, visit: CardVisit) {
  const shell = try Shell.Machine
  const event = { type: "openView", view } as const
  if (visit.tag === "BareCard") {
    try contained(shell.send(event), "opening an app from a card")
    return
  }
  const cards = try Cards.Machine
  const mail = visit.tag === "MailCardVisit"
  const admits = try cardVisit(mail ? "MailCard" : visit.kind, visit.route, mail ? visit.beside : true)
  const current = (where: Shell.Shell) => admits(Effect.runSync(cards.get()), where) !== undefined
  if (!current(try shell.get())) return
  const enter = mail ? (try (try InboxCardEntry).prepare()) : undefined
  if (mail && enter === undefined) return
  if (try contained(shell.send(event, current), "opening an app from a Home card")) {
    if (enter !== undefined) try enter(visit.route + 1)
  }
}

function carry(fx: Out, state: () => Cards.Cards!!Cards.Machine): Job<Event, Agent | Cards.Machine | Shell.Machine | Home.Machine | Device | Canvas | Layers | InboxCardEntry, []> {
  return match (fx) {
    when { tag: "ReadCalendar", let ticket }: answer("calendar", flatMap(state(), (c) => readPhone(ticket, c.calendar.asked)), { type: "calendarRead", ticket, source: "Broken", items: [] });
    when { tag: "ReadAgentCalendar", let ticket }: answer("agent", flatMap(state(), (c) => readAgent(ticket, c.agent.asked)), { type: "agentRead", ticket, source: "Broken", events: [] });
    when { tag: "Go", let view, let visit }: run("go", go(view, visit));
  }
}

const current = () => Cards.Machine.use((machine) => machine.get())

// spec/app/home/cards.md, "When the owner's day begins, Home counts the new day and asks both calendars for it, in place of any read still asked for an earlier day"
/** A restart, told the owner's civil day by Alpha's time in the phone's own time zone. */
effect function restarted(): Event!!Time {
  return { type: "restart", day: civilDay(try (try Time).now()) }
}

// spec/app/home/cards.md, "An item stays on the card until it ends: a timed item through its last minute, an all-day item until its day is over, an overdue reminder until it is handled"
const advancing = started(Effect.scoped(effect {
  const device = try Device
  const shell = try Shell.Machine
  const cards = try Cards.Machine
  const time = try Time
  const wake = Stream.merge(
    Stream.filter(device.visible, (shown) => shown),
    Stream.changes(Stream.map(shell.changes, (state) => state.trail.length === 0)),
  )
  try fork.scoped Stream.runForEach(wake, effect () => {
    try time.now()
    bump()
  })
  try Stream.runDrain(Stream.switchMap(cards.changes, (state) => Stream.fromEffect(effect {
    for (;;) {
      const now = try time.now()
      const ends = [...state.calendar.items, ...state.agent.items]
        .filter((item) => !item.overdue)
        .map((item) => (item.allDay ? item.end : item.end + 1))
        .filter((at) => at > now)
      if (ends.length === 0) return
      try time.until(Math.min(...ends))
      bump()
    }
  })))
}), "advancing the agenda card as events end")

/** The cards, kept across restarts for their tickets: looked at when Home shows and when Alpha comes back to the front, and read again at each of the owner's midnights. */
export const cards = together(
  reacting(Cards, {
    keep: 1,
    open: Effect.map(restarted(), (event) => [event] as const),
    carry: (fx) => carry(fx, current),
    timers: (c) => [
      due("day", dayStart(c.today + 1), { type: "dayBegins", now: untimed, day: c.today + 1 } as const),
      ...(Cards.loading(c.calendar) ? [due(`calendar ${c.calendar.read.ticket}`, c.calendar.since + Cards.patience, { type: "ranOut", now: untimed } as const)] : []),
      ...(Cards.loading(c.agent) ? [due(`agent ${c.agent.read.ticket}`, c.agent.since + Cards.patience, { type: "ranOut", now: untimed } as const)] : []),
    ],
  }),
  following(Shell.Machine, (shell) => shell.trail.length === 0, Cards.Machine, (bare) => (bare ? { type: "look", now: untimed } as const : undefined)),
  hearing(Stream.unwrap(effect { return Stream.filter((try Device).visible, (shown) => shown) }), Cards.Machine, () => ({ type: "look", now: untimed } as const)),
  advancing,
)
