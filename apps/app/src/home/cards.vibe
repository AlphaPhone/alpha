// spec/app/home/cards.md, "Story: See my day at a glance"
import type { AndroidCalendarList } from "@elizaos/os/bridges/definitions/calendar"
import * as Cards from "../../gen/app__home__cards.effect.vibe"
import type { Effect as Out, Event, Flows, Item, Mail, Origin, Row } from "../../gen/app__home__cards.effect.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import type { View } from "../../gen/app__shell.effect.vibe"
import { Agent } from "../platform/agent.vibe"
import { Device, native, registered } from "../platform/device.vibe"
import { ask } from "../platform/remote.vibe"
import { type Job, answer, contained, due, following, hearing, reacting, run, untimed, together } from "../runtime/reactor.vibe"

module held {
  import { calendarClient } from "@elizaos/os/bridges/calendar"

  let made: ReturnType<typeof calendarClient> | undefined
  /** eliza's client of the `ElizaCalendar` plugin, made once. @throws {never} */
  export function client(): ReturnType<typeof calendarClient> {
    return (made ??= calendarClient())
  }
}
import { client } from held

/** The phone's calendar, where this phone's host registered it. */
function phoneCalendar() {
  return native() && registered("ElizaCalendar") ? client() : undefined
}

/** What each item of a card is called, which the spec never holds: by its origin and its number in the read. */
const titles = new Map<string, string>()
const listeners = new Set<() => void>()
let version = 0

function subscribeNamed(this: void, listener: () => void): () => void {
  listeners.add(listener)
  return () => { listeners.delete(listener) }
}

/** The titles of the items read, as an external store the card reads without an effect. */
export const named = {
  snapshot: (): number => version,
  subscribe: subscribeNamed,
  title: (origin: Origin, id: number): string => titles.get(`${origin}:${id}`) ?? "",
}

function titled(origin: Origin, rows: ReadonlyArray<{ readonly title: string }>) {
  rows.forEach((row, at) => titles.set(`${origin}:${at + 1}`, row.title))
  version += 1
  for (const listener of [...listeners]) listener()
}

/** A reminder saved on the phone, as the area that keeps it tells the agenda: when it is due, whether it is overdue or done, and its title. */
export interface ToldReminder { readonly due: number; readonly overdue: boolean; readonly done: boolean; readonly title: string }

/** The brief the digests area kept for Home: what it says and when it ran, or that its run failed and when. */
export type ToldBrief = { readonly outcome: "Finished"; readonly summary: string; readonly at: number } | { readonly outcome: "RunFailed"; readonly at: number }

/**
 * What the cards take from the areas that keep it, as they hold it: the reminders saved on the phone, the calendars
 * Calendar hides, Inbox's summary of unread mail, the rows waiting in Messages and Phone, Workflows' enabled rows and
 * the brief kept for Home. Whether this phone is an Alpha image is the shell's.
 */
export interface Told {
  readonly reminders: ReadonlyArray<Item>
  readonly hidden: ReadonlyArray<number>
  readonly mail: Mail
  readonly mailMore: boolean
  readonly mailStatus: string
  readonly messages: ReadonlyArray<Row>
  readonly messagesSay: Says
  readonly phone: ReadonlyArray<Row>
  readonly phoneSay: Says
  readonly flows: Flows
  readonly brief: ToldBrief | undefined
}

/** What a Messages or Phone card says over and under its rows, which the spec never holds: how many wait, when the newest came, and its name. */
export interface Says { readonly count: string; readonly status: string; readonly label: string }

const unsaid: Says = { count: "", status: "", label: "" }

let told: Told = {
  reminders: [], hidden: [], mail: Cards.quiet, mailMore: false, mailStatus: "", messages: [], messagesSay: unsaid, phone: [], phoneSay: unsaid,
  flows: { rows: [], freshness: "UpToDate" }, brief: undefined,
}

function tell(next: Partial<Told>): void {
  told = { ...told, ...next }
  version += 1
  for (const listener of [...listeners]) listener()
}

/** What Home's cards are given, for a phone that is or is not an Alpha image. */
export function others(given: Told, image: boolean): Cards.Others {
  return {
    image, reminders: [...given.reminders], hidden: [...given.hidden], mail: given.mail,
    messages: [...given.messages], phone: [...given.phone], flows: given.flows, brief: given.brief?.outcome ?? "NoBrief",
  }
}

// spec/app/home/cards.md, "The agenda draws on both calendars and the reminders saved on the phone, leaving out a calendar Calendar hides and a reminder already done"; spec/app/home/cards.md, "Story: The other cards"
/** What other areas tell Home's cards, each as its area holds it now, as an external store the cards read without an effect. */
export const fromAreas = {
  snapshot: (): Told => told,
  subscribe: named.subscribe,
  /** The reminders saved on the phone now, every one of them. */
  reminders(rows: ReadonlyArray<ToldReminder>): void {
    titled("Reminder", rows)
    tell({ reminders: rows.map((row, at) => ({ id: at + 1, origin: "Reminder", calendar: 0, begin: row.due, end: row.due, allDay: false, overdue: row.overdue, done: row.done })) })
  },
  /** The phone's calendars Calendar hides now, by their numbers. */
  hidden(calendars: ReadonlyArray<number>): void { tell({ hidden: [...calendars] }) },
  /** Inbox's summary of the unread mail it loaded: subject and sender, never a body; and when the page was read. */
  mail(mail: Mail, more = false, status = ""): void { tell({ mail, mailMore: more, mailStatus: status }) },
  /** The rows waiting in Messages: who, over the message; how many are unread and when the newest came. */
  messages(rows: ReadonlyArray<Row>, says: Says = unsaid): void { tell({ messages: [...rows], messagesSay: says }) },
  /** The rows waiting in Phone: who, over the missed call or voicemail; how many are new and when the newest came. */
  phone(rows: ReadonlyArray<Row>, says: Says = unsaid): void { tell({ phone: [...rows], phoneSay: says }) },
  /** Workflows' enabled rows, name over status, and how current they are. */
  flows(flows: Flows): void { tell({ flows }) },
  /** The brief kept for Home, or none. */
  brief(brief: ToldBrief | undefined): void { tell({ brief }) },
}

/** The span a card reads: from the day before the day asked to two days after it. */
function span(now: number) {
  const day = Cards.dayOf(now) * Cards.dayLength
  return { begin: day - Cards.dayLength, end: day + 2 * Cards.dayLength }
}

// spec/app/home/cards.md, "An answer replaces what the calendar had; one whose access is off or has no account leaves nothing behind, and one that failed, could not reach it or ran out keeps what was read before, as not up to date"
effect function readPhone(ticket: number, now: number): Event!! {
  const calendar = phoneCalendar()
  if (calendar === undefined) return { type: "calendarRead", ticket, source: "Unavailable", items: [] }
  const listed: AndroidCalendarList | undefined = tryPromise(() => calendar.list(span(now))) catch () => undefined
  if (listed === undefined) return { type: "calendarRead", ticket, source: "Broken", items: [] }
  if (listed.status === "permission-required") return { type: "calendarRead", ticket, source: "Denied", items: [] }
  titled("PhoneCalendar", listed.events.map((event) => ({ title: event.title ?? "" })))
  const items: Item[] = listed.events.map((event, at) => ({
    id: at + 1, origin: "PhoneCalendar", calendar: Number.parseInt(event.calendarId, 10) || 0,
    begin: event.begin, end: event.end, allDay: event.allDay, overdue: false, done: false,
  }))
  return { type: "calendarRead", ticket, source: "Ready", items }
}

/** The part of the agent's calendar feed the agenda reads: what it could reach, and each event's title and times. */
schema FeedEvent { readonly title: string; readonly startAt: string; readonly endAt: string; readonly isAllDay: boolean }
schema Feed { readonly state: "complete" | "partial" | "unavailable"; readonly events: FeedEvent[] }

// spec/app/home/cards.md, "An answer replaces what the calendar had; one whose access is off or has no account leaves nothing behind, and one that failed, could not reach it or ran out keeps what was read before, as not up to date"
effect function readAgent(ticket: number, now: number): Event!!Agent {
  const { begin, end } = span(now)
  const request = HttpClientRequest.get("/api/lifeops/calendar/feed", { urlParams: { timeMin: new Date(begin).toISOString(), timeMax: new Date(end).toISOString() } })
  const feed = ask(Agent, request, Feed) catch () => undefined
  if (feed === undefined) return { type: "agentRead", ticket, source: "Broken", events: [] }
  if (feed.state === "unavailable") return { type: "agentRead", ticket, source: "NotConnected", events: [] }
  const events = feed.events.flatMap((event) => {
    const from = Date.parse(event.startAt)
    const to = Date.parse(event.endAt)
    return Number.isFinite(from) && Number.isFinite(to) ? [{ title: event.title, begin: from, end: to, allDay: event.isAllDay }] : []
  })
  titled("AgentCalendar", events)
  return {
    type: "agentRead", ticket, source: feed.state === "complete" ? "Ready" : "Unavailable",
    events: events.map((event, at) => ({ id: at + 1, origin: "AgentCalendar", calendar: 0, begin: event.begin, end: event.end, allDay: event.allDay, overdue: false, done: false })),
  }
}

// spec/app/home/cards.md, "A card opens its app: the agenda Calendar, Messages and Phone their own, mail Inbox, the brief and Workflows Workflows; the agenda asks its calendar again if the last read did not succeed"
effect function go(view: View) {
  try contained((try Shell.Machine).send({ type: "openView", view }), "opening an app from a card")
}

function carry(fx: Out, state: () => Cards.Cards!!Cards.Machine): Job<Event, Agent | Cards.Machine | Shell.Machine, []> {
  return match (fx) {
    when { tag: "ReadCalendar", let ticket }: answer("calendar", flatMap(state(), (c) => readPhone(ticket, c.calendar.since)), { type: "calendarRead", ticket, source: "Broken", items: [] });
    when { tag: "ReadAgentCalendar", let ticket }: answer("agent", flatMap(state(), (c) => readAgent(ticket, c.agent.since)), { type: "agentRead", ticket, source: "Broken", events: [] });
    when { tag: "Go", let view }: run("go", go(view));
  }
}

const current = () => Cards.Machine.use((machine) => machine.get())

/** The cards, kept across restarts for their tickets: looked at when Home shows, when Alpha comes back to the front and when the day turns. */
export const cards = together(
  reacting(Cards, {
    keep: 1,
    open: [{ type: "restart" }],
    carry: (fx) => carry(fx, current),
    timers: (c) => [
      due("day", (c.today + 1) * Cards.dayLength, { type: "look", now: untimed } as const),
      ...(Cards.loading(c.calendar) ? [due(`calendar ${c.calendar.read.ticket}`, c.calendar.since + Cards.patience, { type: "ranOut", now: untimed } as const)] : []),
      ...(Cards.loading(c.agent) ? [due(`agent ${c.agent.read.ticket}`, c.agent.since + Cards.patience, { type: "ranOut", now: untimed } as const)] : []),
    ],
  }),
  following(Shell.Machine, (shell) => shell.trail.length === 0, Cards.Machine, (bare) => (bare ? { type: "look", now: untimed } as const : undefined)),
  hearing(Stream.unwrap(effect { return Stream.filter((try Device).visible, (shown) => shown) }), Cards.Machine, () => ({ type: "look", now: untimed } as const)),
)
