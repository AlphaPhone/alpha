// spec/app/home/press.md, "Story: Arrange Home with my fingers"
import * as Home from "../../gen/app__home.effect.vibe"
import type { Actor } from "../../gen/app__home.effect.vibe"
import * as Press from "../../gen/app__home__press.effect.vibe"
import type { Event, Outcome } from "../../gen/app__home__press.effect.vibe"
import type { Tile } from "../../gen/app__home__tiles.effect.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import type { View } from "../../gen/app__shell.effect.vibe"
import { feel } from "../shell/haptics.vibe"
import { type Job, contained, due, reacting, run, started, untimed } from "../runtime/reactor.vibe"

const owner: Actor = "Owner"

/** A tile's key, which names it to the press machine: `view:<View>` for one of Alpha's own apps, `app:<key>` for an installed one. */
export function keyOfTile(tile: Tile): string {
  return tile.tag === "Own" ? `view:${tile.view}` : `app:${tile.app}`
}

function tileOfKey(key: string): Tile {
  return key.startsWith("view:") ? { tag: "Own", view: key.slice("view:".length) as View } : { tag: "Installed", app: key.slice("app:".length) }
}

// spec/app/home/index.md, "A tile on Home is removed or moved only while Home is being edited"; spec/app/home/index.md, "A long press on bare Home starts editing, only on the phone and once the tiles are read"
/** What a finished gesture asks of Home, sent as the owner's, where Home's rules allow it. */
effect function acted(outcome: Outcome) {
  const home = try Home.Machine
  const shell = try (try Shell.Machine).get()
  const state = try home.get()
  const tile = tileOfKey(outcome.key)
  const shown = Home.tilesShown(state, shell)
  const at = shown.findIndex((one) => keyOfTile(one) === outcome.key)
  const neighbour = (step: number) => shown[at + step]
  const event: Home.Event | undefined = match (outcome.act) {
    when "StartEditing": { type: "beginEditing", shell };
    when "OpenMenu": { type: "openMenu", app: tile.tag === "Installed" ? tile.app : "", shell };
    when "Activate": tile.tag === "Own" ? { type: "openTile", view: tile.view, shell } : { type: "openApp", app: tile.app, now: untimed };
    when "Remove": { type: "removeFromHome", tile, shell };
    when "Place": { type: "moveTile", tile, onto: tileOfKey(outcome.onto), behind: at < shown.findIndex((one) => keyOfTile(one) === outcome.onto), shell };
    when "MoveEarlier": neighbour(-1) === undefined ? undefined : { type: "moveTile", tile, onto: neighbour(-1)!, behind: false, shell };
    when "MoveLater": neighbour(1) === undefined ? undefined : { type: "moveTile", tile, onto: neighbour(1)!, behind: true, shell };
  }
  if (event === undefined) return
  if (outcome.act === "StartEditing") try feel("LongPress")
  try contained(home.send(event, owner), "a gesture on Home")
}

function carry(outcome: Outcome): Job<Event, unknown, []> {
  return run(`press ${outcome.act}`, acted(outcome))
}

/** What the press machine is told after every change of what shows: the surface, whether Home is edited or covered, and the tiles or apps shown. */
function showing(shell: Shell.Shell, home: Home.Home): Event {
  const shown = shell.drawer
    ? Home.listing(home).map((app) => `app:${app}`)
    : Home.tilesShown(home, shell).map(keyOfTile)
  return {
    type: "showing",
    surface: shell.drawer ? "InDrawer" : shell.trail.length === 0 ? "OnHome" : "Elsewhere",
    editing: home.editing,
    covered: shell.assistant !== "Bar" || home.adding || Home.menuIsOpen(home.menu),
    shown,
  }
}

/** The press machine, in memory: its hold is told once its time has come, and each outcome goes to Home. */
export const press = Layer.mergeAll(
  reacting(Press, {
    carry,
    timers: (p) => (p.hold.finger !== 0 ? [due(`hold ${p.hold.finger} ${p.hold.key}`, p.hold.at, { type: "holdDue", now: untimed })] : []),
  }),
  started(effect {
    const machine = try Press.Machine
    const shell = try Shell.Machine
    const home = try Home.Machine
    try Stream.runForEach(Stream.zipLatest(shell.changes, home.changes), ([now, edited]) => contained(machine.send(showing(now, edited)), "what Home shows"))
  }, "what Home shows"),
)
