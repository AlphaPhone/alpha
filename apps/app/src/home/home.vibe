// spec/app/home/index.md, "Story: Start Home"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Home from "../../gen/app__home.effect.vibe"
import * as Drawer from "../../gen/app__home__drawer.effect.vibe"
import type { Actor, Effect as Out, Event, Host } from "../../gen/app__home.effect.vibe"
import { type Ask, waiting } from "../../gen/app__home__android.effect.vibe"
import type { Tile } from "../../gen/app__home__tiles.effect.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import type { View } from "../../gen/app__shell.effect.vibe"
import { Machine as Canvas } from "../../gen/app__shell__keyboard.effect.vibe"
import * as Layers from "../../gen/app__shell__layers.effect.vibe"
import { Device } from "../platform/device.vibe"
import { Launcher, type Presentation, type Why } from "../platform/launcher.vibe"
import { type Job, answer, contained, due, following, hearing, reacting, run, started, untimed, together } from "../runtime/reactor.vibe"
import type { HomeAsk, HomeNoticeMessage } from "@repo/ui"
import { type Said, say } from "../notices/toasts.vibe"
import type { Machine as Toasts } from "../../gen/app__notices__toasts.effect.vibe"
import { coarsePointer, landscapeHomeInput } from "../shell/canvas.vibe"
import { stepping } from "../shell/shell.vibe"
import { catalog, labelOf } from "./catalog.vibe"
import { parsedTiles, savedKey, written } from "./saved.vibe"

module words {
  import { type HomeNoticeMessage, homeNoticeWords } from "@repo/ui"
  /** What Home's notice says, in the owner's words. @throws {never} */
  export function wordsOf(notice: HomeNoticeMessage): string {
    return homeNoticeWords(notice)
  }
}
import { wordsOf } from words

const owner: Actor = "Owner"

// spec/app/home/index.md, "Startup says once per run how Alpha is presented, and Home then reads its saved tiles"
function hostOf(presented: Presentation): Host {
  if (!presented.phone) return "InBrowser"
  if (presented.assistant) return "AssistantOnly"
  return presented.launcher ? "AsLauncher" : "AsApp"
}

// spec/app/home/tiles.md, "What was saved comes back as it was saved, an empty Home included; with no record Home shows its defaults"
effect function readSaved(ticket: number): Event!!KeyValueStore.KeyValueStore {
  const store = try KeyValueStore.KeyValueStore
  const found = try parsedTiles((key) => Effect.orElseSucceed(store.get(key), () => undefined))
  return { type: "savedRead", ticket, found: found.found, tiles: found.tiles }
}

// spec/app/home/index.md, "A save that lands becomes what is saved; one that fails puts Home back as it was and says so"
effect function saveTiles(tiles: ReadonlyArray<Tile>, ticket: number): Event!!KeyValueStore.KeyValueStore {
  const store = try KeyValueStore.KeyValueStore
  const ok = effect { try store.set(savedKey, written(tiles)); return true } catch () => false
  return { type: "homeSaved", ticket, ok }
}

// spec/app/home/index.md, "When the phone's apps change, or Alpha comes back to the front after a change, they are read again on the phone"
effect function readApps(ticket: number): Event!!(Launcher | Device | Home.Machine) {
  const listed = (try Launcher).apps() catch () => undefined
  const visible = try (try Device).showing()
  if (listed === undefined) return { type: "appsRead", ticket, ok: false, listed: [], visible }
  if (Home.canAppsRead(try (try Home.Machine).get(), ticket)) catalog.listed(listed)
  return { type: "appsRead", ticket, ok: true, listed: [...new Set(listed.map(({ key }) => key))], visible }
}

// spec/app/home/index.md, "Android's answer ends the wait; a refusal is told with its reason, and the apps are read again"
effect function asked(ask: Ask, ticket: number): Event!!Launcher {
  const launcher = try Launcher
  const app = ask.tag === "Shade" ? undefined : catalog.app(ask.app)
  const said = ask.tag === "Shade"
    ? (try launcher.shade())
    : app === undefined
      ? { done: false as const, why: "Gone" as Why }
      : ask.tag === "AppInfo" ? (try launcher.info(app)) : (try launcher.open(app))
  return { type: "answered", ticket, opened: said.done, why: said.done ? "Unable" : said.why }
}

/** What Android was asked, as Home's notice names it. */
function askOf(ask: Ask): HomeAsk {
  return ask.tag === "Shade" ? { tag: "Shade" } : { tag: ask.tag, label: labelOf(ask.app) }
}

/** What Home tells the owner of each failure, in the words of Home's own notice, or nothing for an effect that is not one. */
function noticeOf(fx: Out): HomeNoticeMessage | undefined {
  return match (fx) {
    when { tag: "TellNotOpened", let ask, let why }: { tag: "TellNotOpened", ask: askOf(ask), why };
    when { tag: "TellNoAnswer" }: { tag: "TellNoAnswer" };
    when { tag: "TellUnlockFirst" }: { tag: "TellUnlockFirst" };
    when { tag: "TellNotSaved" }: { tag: "TellNotSaved" };
    when { tag: "TellSavedUnreadable" }: { tag: "TellSavedUnreadable" };
    when { tag: "TellAppsUnread" }: { tag: "TellAppsUnread" };
    default: undefined;
  }
}

/** The notice Home last told inside the edit bar or drawer, and where: an external store the screen reads without an effect. */
export interface Told {
  readonly notice: HomeNoticeMessage
  readonly place: "InEditBar" | "InDrawer"
}

let last: Told | undefined
const listeners = new Set<() => void>()

function subscribeTold(this: void, listener: () => void): () => void {
  listeners.add(listener)
  return () => { listeners.delete(listener) }
}

export const told = {
  snapshot: (): Told | undefined => last,
  subscribe: subscribeTold,
}

// spec/app/home/index.md, "The app in the menu can be added to Home or handed to Android as App info"
/** Choose an action for the installed app the owner is still looking at. */
export effect function chooseApp(app: string, action: "Pin" | "Info", route: number, beside: boolean) {
  const home = try Home.Machine
  const drawer = try Drawer.Machine
  const shell = try Shell.Machine
  const showing = try shell.get()
  const admitted = try appsVisit(route, beside)
  const current = () => admitted(Effect.runSync(shell.get()))
  if (!admitted(showing)) return
  const menu = try drawer.get()
  const state = try home.get()
  const allowed = action === "Pin" ? Home.canPinInstalled(state, app, showing, menu, owner) : Home.canShowAppInfo(state, app, showing, menu, owner)
  if (!allowed) return
  const event: Event = action === "Pin"
    ? { type: "pinInstalled", app, shell: showing, drawer: menu }
    : { type: "showAppInfo", app, shell: showing, drawer: menu, now: untimed }
  if (!(try contained(home.send(event, owner, current), "choosing an installed app's action"))) return
  if (action === "Pin") try contained(shell.send({ type: "closeDrawer" }, admitted), "closing Apps after adding a tile")
  else try contained(drawer.send({ type: "closeMenu" }, current), "closing the Apps menu")
}

// spec/app/home/drawer.md, "The menu names a current app and closes before Apps"; spec/app/home/index.md, "Back closes one layer of Home's own: Add to Home, then editing; Done ends editing"
/** Back first closes the current installed app's menu, or ends the latest Home editing step. */
export effect function backHome(): boolean!!(Home.Machine | Drawer.Machine) {
  const drawer = try Drawer.Machine
  if (Drawer.canCloseMenu(try drawer.get())) return try contained(drawer.send({ type: "closeMenu" }), "closing the Apps menu")
  const home = try Home.Machine
  if (!Home.canBackOut(try home.get())) return false
  return try contained(home.send({ type: "backOut" }, owner), "back on Home")
}

// spec/app/home/index.md, "A notice shows as a toast on bare Home and in the edit bar while editing; told while an app or Ask Alpha is up, it is not shown"
effect function tell(fx: Out) {
  const notice = noticeOf(fx)
  if (notice === undefined) return
  const shell = try (try Shell.Machine).get()
  const home = try (try Home.Machine).get()
  const place = Home.noticeAt(home, shell)
  if (place === "Nowhere") return
  if (place === "AsToast") {
    try say(wordsOf(notice), true)
    return
  }
  last = { notice, place }
  for (const listener of [...listeners]) listener()
}

effect function homeInput(beside: boolean) {
  const canvas = try Canvas
  const layers = try Layers.Machine
  const device = try Device
  return () => !Layers.pageInert(Effect.runSync(layers.get())) && Effect.runSync(device.showing())
    && (!beside || landscapeHomeInput(Effect.runSync(canvas.get()), coarsePointer()))
}

// spec/app/shell/index.md, "Apps can open beside the landscape Ask sheet and Close leaves Ask open"; spec/app/shell/index.md, "The Apps drawer opens on phone Home with Ask Alpha at rest"
effect function appsVisit(route: number, beside: boolean) {
  const free = try homeInput(beside)
  return (where: Shell.Shell) => where.route === route && where.drawer && where.textAsk.tag === "NoTextAsk"
    && (beside ? Shell.adjacentAskSheet(where, true) : where.assistant === "Bar") && free()
}

export effect function openApps(route: number, beside: boolean) {
  const home = try Home.Machine
  const shell = try Shell.Machine
  const free = try homeInput(beside)
  const event = beside
    ? { type: "openDrawerBeside", phone: true, landscapePhone: true } as const
    : { type: "openDrawer", phone: true } as const
  const current = (where: Shell.Shell) => where.route === route && where.textAsk.tag === "NoTextAsk"
    && Home.offersDrawer(Effect.runSync(home.get())) && free()
  if (current(try shell.get())) try contained(shell.send(event, current), "opening Apps")
}

export effect function closeApps(route: number, beside: boolean) {
  const shell = try Shell.Machine
  const current = try appsVisit(route, beside)
  if (current(try shell.get())) try contained(shell.send({ type: "closeDrawer" }, current), "closing Apps")
}

export type AppsInput = Extract<Drawer.Event, { type: "search" | "openMenu" | "closeMenu" }>
  | Extract<Event, { type: "openApp" | "tryAgain" }>

export effect function actInApps(route: number, beside: boolean, event: AppsInput) {
  const shell = try Shell.Machine
  const admitted = try appsVisit(route, beside)
  const current = () => admitted(Effect.runSync(shell.get()))
  if (!current()) return false
  if (event.type === "openApp" || event.type === "tryAgain")
    return try contained((try Home.Machine).send(event, owner, current), "using Apps")
  return try contained((try Drawer.Machine).send(event, current), "using Apps")
}

// spec/app/home/index.md, "Apps also lists Alpha's own apps that are not on Home, and opens one as its tile would"
/** Open one of Alpha's own apps listed in Apps; the shell's openView closes Apps. */
export effect function openOwnInApps(view: View, route: number, beside: boolean) {
  const home = try Home.Machine
  const shell = try Shell.Machine
  const admitted = try appsVisit(route, beside)
  const current = (where: Shell.Shell) => admitted(where) && Home.drawerOpens(Effect.runSync(home.get()), view, where)
  if (current(try shell.get())) try contained(shell.send({ type: "openView", view }, current), "opening an app from Apps")
}

// spec/app/home/index.md, "A tap on one of Alpha's own tiles on bare Home asks the shell to open that app, never while Home is being edited"; spec/app/home/index.md, "An Alpha tile beside the landscape Ask sheet opens its app and lowers Ask Alpha to rest"
effect function ownTileVisit(view: View, route: number, beside: boolean) {
  const free = try homeInput(beside)
  return (home: Home.Home, shell: Shell.Shell) => {
    if (shell.route !== route || !free()) return undefined
    const event = beside
      ? { type: "openTileBeside", view, shell, landscapePhone: true } as const
      : { type: "openTile", view, shell } as const
    return Home.enabled(home, event, owner) ? event : undefined
  }
}

export effect function openOwnTile(view: View, route: number, beside: boolean) {
  const home = try Home.Machine
  const shell = try Shell.Machine
  const admits = try ownTileVisit(view, route, beside)
  const event = admits(try home.get(), try shell.get())
  if (event !== undefined) {
    try contained(home.send(event, owner, (state) => admits(state, Effect.runSync(shell.get())) !== undefined), "choosing an app on Home")
  }
}

effect function go(view: View, route: number, beside: boolean) {
  const home = try Home.Machine
  const shell = try Shell.Machine
  const admits = try ownTileVisit(view, route, beside)
  try contained(shell.send({ type: "openView", view }, (where) => admits(Effect.runSync(home.get()), where) !== undefined), "opening an app from Home")
}

function carry(fx: Out): Job<Event, KeyValueStore.KeyValueStore | Launcher | Device | Shell.Machine | Home.Machine | Canvas | Layers.Machine | Toasts | Said, [Actor]> {
  return match (fx) {
    when { tag: "ReadSaved", let ticket }: answer("saved", readSaved(ticket), { type: "savedRead", ticket, found: "Unreadable", tiles: [] }, owner);
    when { tag: "SaveHome", let tiles, let ticket }: answer("save", saveTiles(tiles, ticket), { type: "homeSaved", ticket, ok: false }, owner);
    when { tag: "ReadApps", let ticket }: answer("apps", readApps(ticket), { type: "appsRead", ticket, ok: false, listed: [], visible: false }, owner);
    when { tag: "AskAndroid", let ask, let ticket }: answer("android", asked(ask, ticket), { type: "answered", ticket, opened: false, why: "Unable" }, owner);
    when { tag: "Go", let view, let route, let beside }: run("go", go(view, route, beside), owner);
    default: run(`tell ${fx.tag}`, tell(fx), owner);
  }
}

// spec/app/home/index.md, "Startup says once per run how Alpha is presented, and Home then reads its saved tiles"; spec/app/home/index.md, "Alpha is told when it becomes, or stops being, the phone's launcher"
const presented = started(effect {
  const home = try Home.Machine
  const launcher = try Launcher
  const host = hostOf(try launcher.presentation())
  try contained(home.send({ type: "presented", host }, owner), "presenting Home")
  const canvas = try Canvas
  const role = Stream.changes(Stream.map(Stream.filter(canvas.changes, (frame) => frame.mounted), (frame) => frame.launcher))
  try Stream.runForEach(role, effect (held) => {
    if (Home.canLauncherChanged(try home.get(), held)) try contained(home.send({ type: "launcherChanged", launcher: held }, owner), "the launcher role")
  })
}, "presenting Home")

/** Home's machine, kept across restarts for its numbers, and what tells it of the phone and the shell. */
export const home = together(
  reacting(Home, {
    keep: 1,
    open: [{ type: "restart" }, owner],
    carry,
    timers: (h) => (waiting(h.handoff) ? [due("android", h.handoff.until, { type: "stopWaiting", now: untimed }, owner)] : []),
  }),
  presented,
  reacting(Drawer, {}),
  following(Shell.Machine, (shell) => shell.drawer, Drawer.Machine, (open) => open ? undefined : { type: "clear" } as const),
  following(Home.Machine, (state) => state.installed.apps, Drawer.Machine, (listed) => ({ type: "appsChanged", listed } as const)),
  hearing(Stream.unwrap(effect {
    const device = try Device
    return Stream.mapEffect((try Launcher).changes, () => device.showing())
  }), Home.Machine, (visible) => ({ type: "appsChanged", visible } as const), owner),
  hearing(Stream.unwrap(effect { return Stream.filter((try Device).visible, (shown) => shown) }), Home.Machine, () => ({ type: "resumed" } as const), owner),
  following(Shell.Machine, (shell) => shell, Home.Machine, (shell) => ({ type: "shellMoved", shell } as const), owner),
  stepping("home", Home.Machine, Home.canBackOut),
)
