// spec/app/contacts/agent.md, "Only the owner approves, only what is shown as it is now, and only when the phone has ruled out an emergency call"; spec/app/messages/sending.md, "The journal read back settles an unknown outcome: sent, or never sent"; spec/app/messages/sending.md, "Story: Send a message once"
import { NOT_DISPATCHED, type ExecutorCall } from "@elizaos/agent/client"
import { readResult, type DeviceOperation } from "@elizaos/agent/operations"
import { operationIdOf, type DirectSmsReview, type SmsSendResult } from "@elizaos/os/bridges/definitions/messages"
import { normalizePhoneNumber } from "@elizaos/os/bridges/definitions/phone"
import { Machine as Phone, clear } from "../../gen/app__phone.effect.vibe"
import { Device } from "../platform/device.vibe"
import { Telephony, TelephonyAbsent, TelephonyRefused, telephony } from "../platform/telephony.vibe"
import { simOf } from "./composer.vibe"

type Sms = Extract<DeviceOperation, { type: "sms_send" }>
type Composed = Extract<DeviceOperation, { type: "sms_compose" }>
/** A text the phone sends for the agent: an `sms_send` naming its recipients and SIM exactly, or an `sms_compose` to one number that asks for more than a draft. */
type Text = Sms | (Composed & { readonly target: { readonly kind: "number"; readonly number: string } })
const refused = { kind: "refused", code: NOT_DISPATCHED } as const

/** Whether `op` is a text the phone sends once the owner approves its card; an `sms_compose` with `draft` only fills the draft. */
export function isText(op: DeviceOperation): op is Text {
  if (op.type === "sms_send") return true
  return op.type === "sms_compose" && "target" in op && op.target.kind === "number" && op.draft !== true && op.replyThreadId === undefined
}

function binding(op: Text, call: ExecutorCall, subscriptionId: number) {
  if (call.proposalId !== call.operationId || !Number.isSafeInteger(call.attemptId) || call.attemptId <= 0) return undefined
  const id = operationIdOf(call.operationId)
  const named = op.type === "sms_send" ? op.recipients : [op.target.number]
  const recipients = named.map(normalizePhoneNumber)
  if (id === null || recipients.some((number, at) => number === null || (op.type === "sms_send" && number !== named[at]))) return undefined
  const review: DirectSmsReview = {
    recipients: recipients.filter((number) => number !== null), body: op.body, subscriptionId,
  }
  return { id, review }
}

/** The text as the phone sends it: an `sms_send` on the SIM it names, and an `sms_compose` on the phone's SIM for texts. */
effect function bound(op: Text, call: ExecutorCall): (ReturnType<typeof binding>)!!Telephony {
  if (op.type === "sms_send") return binding(op, call, op.subscriptionId)
  const sim = try simOf(null)
  return sim === undefined ? undefined : binding(op, call, sim)
}

/** The phone's record as eliza reads the operation's result: the whole record for an `sms_send`, its status for an `sms_compose`. */
function resultOf(op: Text, receipt: SmsSendResult | undefined) {
  if (receipt === undefined) return undefined
  const result = op.type === "sms_send" ? receipt : readResult(op, { kind: "sms-compose", status: receipt.status === "denied" ? "unavailable" : receipt.status })
  if (result === undefined) return undefined
  if (receipt.status === "submitted" || receipt.status === "sent" || receipt.status === "delivered") return { kind: "applied", result } as const
  if (receipt.status === "denied" || receipt.status === "cancelled") return { ...refused, result }
  return undefined
}

/** A reviewed agent request uses the exact native SMS confirmation, never a fallback composer or a fresh send ID. */
export effect function reviewAgentSms(op: Text, call: ExecutorCall, current: () => Promise<boolean>) {
  const wanted = try bound(op, call)
  const device = try Device
  const phone = try Phone
  if (wanted === undefined || !(try device.capabilities()).image || !(try device.showing()) || !clear(try phone.get())) return refused
  if (!(tryPromise(current) catch () => false)) return refused
  const status = telephony("reviewed SMS status", (client) => client.messages.status()) catch () => undefined
  if (status?.sendMode !== "direct" || status.permissions.sendSms !== "granted" || !status.subscriptions?.some((sim) => sim.id === wanted.review.subscriptionId)) return refused
  if (!(tryPromise(current) catch () => false) || !(try device.showing()) || !clear(try phone.get())) return refused
  const receipt = telephony("sendSms", (client) => client.messages.sendSms(wanted.review, wanted.id)) catch (failure) => {
    if (failure instanceof TelephonyAbsent || (failure instanceof TelephonyRefused &&
      (failure.tag === "BridgeUnavailable" || failure.tag === "InvalidMessageRequest" || failure.tag === "SmsSendNotAttempted"))) return null
    return undefined
  }
  return receipt === null ? refused : resultOf(op, receipt)
}

/** Recovery only reads the phone's receipt for the same body, recipients, operation ID and subscription. */
export effect function readAgentSms(op: Text, call: ExecutorCall): unknown!!(Device | Telephony) {
  const wanted = try bound(op, call)
  const device = try Device
  if (wanted === undefined || !(try device.capabilities()).image || !(try device.showing())) return undefined
  const receipt = telephony("smsSendResult", (client) => client.messages.smsSendResult(wanted.review, wanted.id)) catch () => undefined
  if (!(try device.showing())) return undefined
  const result = resultOf(op, receipt)
  return result?.kind === "applied" ? { kind: "found", result: result.result } : result
}
