// spec/app/messages/composer.md, "Story: Keep my draft"; spec/app/messages/composer.md, "Story: Let Alpha suggest a draft"; spec/app/messages/composer.md, "Story: Send a message"; spec/app/messages/sending.md, "Story: Send a message once"; spec/app/messages/sending.md, "Story: Know whether it arrived"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { MMS_ATTACHMENT_TYPES, MMS_MAX_BODY, MMS_MAX_RECIPIENTS, MMS_MAX_TOTAL_BYTES } from "@elizaos/os-bridges"
import { mmsBinding, type MmsAttachmentType, type MmsBinding, type MmsReview, type OperationId, type SmsReview, type SmsSendResult, type SmsSendStatus } from "@elizaos/os-bridges"
import type { PhoneNumber, TelephonySubscription } from "@elizaos/os-bridges"
import * as Composer from "../../gen/app__messages__composer.effect.vibe"
import type { Effect as Out, Event } from "../../gen/app__messages__composer.effect.vibe"
import type { Effect as SendOut } from "../../gen/app__messages__sending.effect.vibe"
import { Machine as Messages, canNewPictureMessage } from "../../gen/app__messages.effect.vibe"
import { Machine as Phone, clear } from "../../gen/app__phone.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { type Machine as Toasts } from "../../gen/app__notices__toasts.effect.vibe"
import { type Said, say } from "../notices/toasts.vibe"
import { Agent } from "../platform/agent.vibe"
import { ask } from "../platform/remote.vibe"
import { SystemSettings } from "../platform/systemSettings.vibe"
import { Telephony, TelephonyAbsent, TelephonyRefused, telephony } from "../platform/telephony.vibe"
import { Attempts } from "../runtime/attempts.vibe"
import { type Job, answer, applying, contained, following, hearing, reacting, run, started, stream, together } from "../runtime/reactor.vibe"
import { grantOf } from "../phone/phone.vibe"
import { Conversations, Inbox, elsewhere } from "./messages.vibe"

/** A picture the owner attached: what the phone says it is, and its bytes. */
export interface Picture {
  readonly name: string
  readonly wireName?: string
  readonly contentType: MmsAttachmentType
  readonly bytes: Uint8Array
}

interface PictureOffer {
  readonly ticket: number
  readonly picture: Picture
}

/** What one send carries, kept from Send until its record is retired, so that a send read back after a restart is the same one. */
export interface Outgoing {
  readonly thread: number
  readonly to: ReadonlyArray<string>
  readonly body: string
  readonly sim: number | null
  readonly selectedSim?: TelephonySubscription | undefined
  readonly pictures: ReadonlyArray<Picture>
  readonly pictured: boolean
  readonly operation: OperationId | undefined
  readonly mms: MmsReceiptBinding | undefined
  readonly status: SmsSendStatus | undefined
}

interface MmsReceiptBinding {
  readonly hash: string
  readonly attachments: MmsBinding["attachments"]
}

/** The texts behind the composer: each conversation's draft, saved on the phone, the pictures of the open one, and the send in hand. */
export service Drafts {
  text(thread: number): string!!
  write(thread: number, text: string): void!!
  drop(thread: number): void!!
  pictures(): ReadonlyArray<Picture>!!
  setPictures(pictures: ReadonlyArray<Picture>): void!!
  subscriptions(): ReadonlyArray<TelephonySubscription>!!
  setSubscriptions(subscriptions: ReadonlyArray<TelephonySubscription>): void!!
  offeredPicture(): (PictureOffer | undefined)!!
  setOfferedPicture(offer: PictureOffer | undefined): void!!
  outgoing(): Option.Option<Outgoing>!!
  setOutgoing(outgoing: Outgoing): void!!
  bindOutgoing(outgoing: Outgoing): boolean!!
  retireOutgoing(operation: OperationId): void!!
  /** What the phone last said it can send itself: texts directly, and pictures. */
  sending(): { readonly direct: boolean; readonly pictures: boolean }!!
  setSending(sending: { readonly direct: boolean; readonly pictures: boolean }): void!!
}

const draftKey = (thread: number) => `alpha/messages/draft/${thread}@1`
const outgoingKey = "alpha/messages/outgoing@1"

module text {
  import { MMS_ATTACHMENT_TYPES, MMS_MAX_ATTACHMENTS, MMS_MAX_TOTAL_BYTES, mmsBindingText, operationIdOf, type MmsAttachmentBinding, type MmsBinding, type OperationId } from "@elizaos/os-bridges"

  type Binding = { hash: string; attachments: MmsAttachmentBinding[] }
  const digest = /^[a-f0-9]{64}$/

  function record(value: unknown): Record<string, unknown> | undefined {
    return typeof value === "object" && value !== null && !Array.isArray(value) ? value as Record<string, unknown> : undefined
  }

  function retainedBinding(value: unknown): Binding | undefined {
    const fields = record(value)
    if (fields === undefined || typeof fields.hash !== "string" || !digest.test(fields.hash)
      || !Array.isArray(fields.attachments) || fields.attachments.length > MMS_MAX_ATTACHMENTS) return undefined
    const attachments: MmsAttachmentBinding[] = []
    let size = 0
    for (const item of fields.attachments) {
      const row = record(item)
      const type = MMS_ATTACHMENT_TYPES.find((kind) => kind === row?.contentType)
      if (row === undefined || type === undefined || typeof row.name !== "string" || row.name.length === 0 || row.name.length > 64
        || typeof row.sha256 !== "string" || !digest.test(row.sha256) || typeof row.size !== "number" || !Number.isSafeInteger(row.size)
        || row.size <= 0 || size + row.size > MMS_MAX_TOTAL_BYTES) return undefined
      size += row.size
      attachments.push({ contentType: type, name: row.name, sha256: row.sha256, size: row.size })
    }
    return { hash: fields.hash, attachments }
  }

  /** What the store kept for the send in hand. It never keeps an attachment's bytes. @throws {never} */
  export function keptSend(raw: string | undefined): { thread: number; to: string[]; body: string; sim: number | null; pictures: never[]; pictured: boolean; operation: OperationId | undefined; mms: Binding | undefined; status: undefined } | undefined {
    if (raw === undefined) return undefined
    try {
      const found = record(JSON.parse(raw))
      if (found === undefined || typeof found.thread !== "number" || !Number.isSafeInteger(found.thread) || found.thread <= 0
        || !Array.isArray(found.to) || !found.to.every((one): one is string => typeof one === "string") || typeof found.body !== "string"
        || !(found.sim === null || typeof found.sim === "number" && Number.isSafeInteger(found.sim) && found.sim >= 0)) return undefined
      return {
        thread: found.thread, to: found.to, body: found.body, sim: found.sim, pictures: [], pictured: found.pictured !== false,
        operation: operationIdOf(found.operation) ?? undefined, mms: retainedBinding(found.mms), status: undefined,
      }
    } catch {
      return undefined
    }
  }
  /** The send in hand as the store keeps it. @throws {never} */
  export function keepSend(outgoing: { readonly pictures: ReadonlyArray<unknown>; readonly pictured: boolean }): string {
    return JSON.stringify({ ...outgoing, pictures: [], pictured: outgoing.pictured || outgoing.pictures.length > 0 })
  }

  export async function matchesBinding(binding: MmsBinding, expected: string): Promise<boolean> {
    const bytes = new TextEncoder().encode(mmsBindingText(binding))
    const found = new Uint8Array(await crypto.subtle.digest("SHA-256", bytes))
    return Array.from(found, (one) => one.toString(16).padStart(2, "0")).join("") === expected
  }

  /** @throws {never} */
  export function canDigest(): boolean {
    return typeof globalThis.crypto?.subtle?.digest === "function"
  }
}
import { canDigest, keepSend, keptSend, matchesBinding } from text

const drafts = Layer.effect(Drafts, effect {
  const store = try KeyValueStore.KeyValueStore
  let pictures: ReadonlyArray<Picture> = []
  let subscriptions: ReadonlyArray<TelephonySubscription> = []
  let offeredPicture: PictureOffer | undefined
  let sending = { direct: false, pictures: false }
  let outgoing: Option.Option<Outgoing> = Option.fromNullishOr(keptSend(store.get(outgoingKey) catch () => undefined))
  return {
    effect text(thread: number): string!! {
      return (store.get(draftKey(thread)) catch () => undefined) ?? ""
    },
    write: (thread: number, text: string) => ignore(store.set(draftKey(thread), text)),
    drop: (thread: number) => ignore(store.remove(draftKey(thread))),
    pictures: () => sync(() => pictures),
    setPictures: (next: ReadonlyArray<Picture>) => sync(() => { pictures = next }),
    subscriptions: () => sync(() => subscriptions),
    setSubscriptions: (next: ReadonlyArray<TelephonySubscription>) => sync(() => { subscriptions = next }),
    offeredPicture: () => sync(() => offeredPicture),
    setOfferedPicture: (offer: PictureOffer | undefined) => sync(() => { offeredPicture = offer }),
    outgoing: () => sync(() => outgoing),
    sending: () => sync(() => sending),
    setSending: (next: { readonly direct: boolean; readonly pictures: boolean }) => sync(() => { sending = next }),
    setOutgoing: (next: Outgoing) => sync(() => { outgoing = Option.some(next) }),
    effect bindOutgoing(next: Outgoing): boolean!! {
      const encoded = keepSend(next)
      if (!(try isSuccess(store.set(outgoingKey, encoded)))) return false
      const saved = store.get(outgoingKey) catch () => undefined
      if (saved !== encoded) return false
      outgoing = Option.some(next)
      return true
    },
    effect retireOutgoing(operation: OperationId): void!! {
      if (Option.isSome(outgoing) && outgoing.value.operation === operation) outgoing = Option.none()
      const saved = keptSend(store.get(outgoingKey) catch () => undefined)
      if (saved?.operation === operation) try ignore(store.remove(outgoingKey))
    },
  }
})

// spec/app/messages/composer.md, "The phone says how many SIMs it has, and with more than one the owner picks one, which needs SIM access"
/** Whether Android still reports the same subscription at the reviewed slot and carrier. */
export function sameSubscription(one: TelephonySubscription, other: TelephonySubscription): boolean {
  return one.id === other.id && one.slot === other.slot && one.carrierName === other.carrierName && one.displayName === other.displayName
}

effect function rememberSims(sims: ReadonlyArray<TelephonySubscription>): void!!(Drafts | Composer.Machine) {
  const composer = try Composer.Machine
  try (try Drafts).setSubscriptions(sims)
  const count = Math.max(1, sims.length)
  if ((try composer.get()).sims !== count) try contained(composer.send({ type: "simsReported", count }), "the SIMs")
}

/** The still-active SIM the owner picked, or Android's default or sole SIM if they did not choose one. */
effect function simOf(chosen: TelephonySubscription | undefined): (number | undefined)!!(Telephony | Drafts | Composer.Machine) {
  const status = telephony("status", (c) => c.messages.status()) catch () => undefined
  if (status === undefined) return undefined
  const sims = status.subscriptions ?? []
  try rememberSims(sims)
  if (chosen !== undefined) return sims.find((sim) => sameSubscription(sim, chosen))?.id
  return sims.find((one) => one.defaultSms)?.id ?? (sims.length === 1 ? sims[0].id : undefined)
}

const sentStatuses = new Set<SmsSendStatus>(["sent", "delivered"])
const usingMms = (recipients: number, pictured: boolean) => recipients > 1 || pictured

function mmsReview(send: Outgoing, sim: number): MmsReview {
  return { recipients: [...send.to] as PhoneNumber[], body: send.body, subscriptionId: sim, attachments: send.pictures.map((one) => ({ name: one.wireName ?? one.name, contentType: one.contentType, bytes: one.bytes })) }
}

effect function receiptOf(send: Outgoing, sim: number, operation: OperationId): (SmsSendStatus | undefined)!!Telephony {
  if (usingMms(send.to.length, send.pictured)) {
    if (send.mms === undefined) {
      // Older text-only group sends can reproduce their complete binding without any pictures.
      if (send.pictured) return undefined
      const receipt = telephony("mmsSendResult", (c) => c.messages.mmsSendResult(mmsReview(send, sim), operation)) catch () => undefined
      return receipt?.status
    }
    const binding: MmsBinding = { recipients: [...send.to] as PhoneNumber[], body: send.body, subscriptionId: sim, attachments: send.mms.attachments }
    const hash = send.mms.hash
    const matches = tryPromise(() => matchesBinding(binding, hash)) catch () => false
    if (!matches) return undefined
    const receipt = telephony("mmsSendResult", (c) => c.mmsReceipt(binding, operation, hash)) catch () => undefined
    return receipt?.status
  }
  const receipt = telephony("smsSendResult", (c) => c.messages.smsSendResult({ recipients: [...send.to] as PhoneNumber[], body: send.body, subscriptionId: sim }, operation)) catch () => undefined
  return receipt?.status
}

/** Only evidence of refusal before native dispatch permits a fresh attempt. */
function refusedSend(failure: TelephonyAbsent | TelephonyRefused): (SmsSendStatus | undefined) {
  if (failure instanceof TelephonyAbsent) return "denied"
  if (failure.tag === "InvalidMessageRequest" || failure.tag === "SmsSendRefused" || failure.tag === "SmsSendNotAttempted"
    || failure.code === "busy" || failure.code === "too-large") return "denied"
  return undefined
}

// spec/app/messages/sending.md, "Send journals a new operation, or reads the journal back when the last outcome is unknown"; spec/app/messages/sending.md, "The journal entry lands, or the phone denies the send before any radio is used"
/** The send under its operation's key: the phone journals it before it uses the radio, and the same key never sends twice. */
function journaled(id: number, recipients: number): Stream.Stream<Event, never, Telephony | Drafts | Attempts | Composer.Machine | Phone> {
  return Stream.unwrap(effect {
    const store = try Drafts
    const phone = try Phone
    const composer = try Composer.Machine
    const denied = Stream.succeed<Event>({ type: "journaled", id, allowed: false })
    const held = try store.outgoing()
    if (Option.isNone(held) || !canDigest()) return denied
    const send = held.value
    const current = effect () => {
      const { outgoing } = try composer.get()
      return outgoing.op.id === id && outgoing.op.outcome === "Recorded" && outgoing.thread === send.thread
        && outgoing.recipients === recipients && send.to.length === recipients && clear(try phone.get())
    }
    if (!(try current) || send.operation !== undefined) return denied
    const operation = (try (try Attempts).key(id)) as OperationId
    const sim = send.selectedSim?.id ?? (try simOf(undefined))
    if (sim === undefined) return denied
    const review = usingMms(send.to.length, send.pictured) ? mmsReview(send, sim) : undefined
    const bound = review === undefined ? undefined : (tryPromise(() => mmsBinding(review)) catch () => undefined)
    if (review !== undefined && bound === undefined) return denied
    if (send.selectedSim !== undefined && (try simOf(send.selectedSim)) !== sim) return denied
    const still = try store.outgoing()
    if (Option.isNone(still) || still.value !== send || !(try current)) return denied
    const next: Outgoing = { ...send, sim, selectedSim: undefined, operation, mms: bound === undefined ? undefined : { hash: bound.hash, attachments: bound.binding.attachments } }
    if (!(try store.bindOutgoing(next)) || !(try current)) return denied
    const to = send.to as PhoneNumber[]
    const status: SmsSendStatus | undefined = review !== undefined
      ? Effect.map(telephony("sendMms", (c) => c.messages.sendMms(review, operation)), (result) => result.status) catch (failure) => refusedSend(failure)
      : Effect.map(telephony("sendSms", (c) => c.messages.sendSms({ recipients: to, body: send.body, subscriptionId: sim } satisfies SmsReview & { subscriptionId: number }, operation)), (result) => result.status) catch (failure) => refusedSend(failure)
    const latest = try store.outgoing()
    const resolved = Option.isSome(latest) && latest.value.operation === operation ? latest.value.status ?? status : status
    if (Option.isSome(latest) && latest.value.operation === operation) try store.setOutgoing({ ...latest.value, status: resolved })
    if (resolved === undefined) return Stream.succeed<Event>({ type: "lost" })
    if (resolved === "denied" || resolved === "cancelled") return Stream.succeed<Event>({ type: "journaled", id, allowed: false })
    return Stream.fromIterable<Event>([{ type: "journaled", id, allowed: true }, ...Array.from({ length: recipients }, (): Event => ({ type: "transmit", id }))])
  })
}

// spec/app/messages/sending.md, "The radio reports each part sent or failed, and the send ends when every recipient has an answer"
effect function radioed(id: number): Event!!(Drafts | Telephony) {
  const held = try (try Drafts).outgoing()
  if (Option.isNone(held)) return { type: "lost" }
  const send = held.value
  const status = send.status === "submitted" && send.sim !== null && send.operation !== undefined ? try receiptOf(send, send.sim, send.operation) : send.status
  return status === undefined || status === "unknown" || status === "submitted" ? { type: "lost" } : { type: "partSent", id, ok: sentStatuses.has(status) }
}

// spec/app/messages/sending.md, "The journal read back settles an unknown outcome: sent, or never sent"
effect function readBack(id: number): Event!!(Telephony | Drafts | Attempts | Composer.Machine) {
  const held = try (try Drafts).outgoing()
  const operation = (try (try Attempts).key(id)) as OperationId
  const state = try (try Composer.Machine).get()
  if (Option.isNone(held) || held.value.operation !== operation || held.value.thread !== state.outgoing.thread) {
    return { type: "readBack", id, wasSent: false, known: false }
  }
  const send = held.value
  const status = send.sim === null ? undefined : try receiptOf(send, send.sim, operation)
  return { type: "readBack", id, wasSent: status !== undefined && sentStatuses.has(status), known: status !== undefined && status !== "unknown" && status !== "submitted" }
}

function sending(fx: SendOut): Job<Event, Telephony | Drafts | Attempts | Composer.Machine | Phone, []> {
  return match (fx) {
    when { tag: "Journal", let id, let recipients }: stream(`send ${id}`, journaled(id, recipients), { type: "lost" });
    when { tag: "Radio", let id, let recipient }: answer(`radio ${id} ${recipient}`, radioed(id), { type: "lost" });
    when { tag: "ReadJournal", let id }: answer(`read back ${id}`, readBack(id), { type: "readBack", id, wasSent: false, known: false });
    when { tag: "Tombstone", let id }: run("retired", effect {
      const operation = (try (try Attempts).key(id)) as OperationId
      try (try Drafts).retireOutgoing(operation)
    });
  }
}

/** What the agent answers to `POST /api/messages/reply-draft`: one short reply for the owner to read, or none. */
const Drafted = Schema.Struct({ draft: Schema.NullOr(Schema.String) })

/** The open conversation's tail as the agent's drafter reads it, oldest first. */
const tailLength = 20

// spec/app/messages/composer.md, "Alpha's suggestion is asked for only when the draft is empty, and lands only if it still is"
/** Alpha's draft for `thread`, asked of the agent from the messages last read: it lands in the conversation's draft only while the owner has written nothing there. */
effect function suggestion(ticket: number, thread: number): Event!!(Agent | Inbox | Drafts | Conversations | Messages | Composer.Machine) {
  const refused: Event = { type: "suggested", ticket, ok: false }
  const current = try (try Messages).get()
  if (!current.front || current.thread !== thread || current.sms.grant !== "Granted" || current.shown.rows === 0) return refused
  const visible = try (try Inbox).get()
  if (visible.messagesThread !== thread) return refused
  const rows = visible.messages.flatMap((row) => ("incomplete" in row ? [] : [{ direction: row.direction === "incoming" ? "in" : "out", date: row.date, body: row.body }]))
  const tail = [...rows].sort((a, b) => a.date - b.date).slice(-tailLength)
  const conversation = try (try Conversations).get(thread)
  const participant = Option.isSome(conversation) && conversation.value.addresses.length === 1 ? conversation.value.addresses[0] : null
  if (tail.length === 0 || tail[tail.length - 1].direction !== "in") return refused
  const answered = ask(Agent, HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post("/api/messages/reply-draft"), { participant, messages: tail, truncated: rows.length > tail.length }), Drafted) catch () => undefined
  const draft = answered?.draft?.trim() ?? ""
  const state = try (try Composer.Machine).get()
  if (draft === "" || draft.length > MMS_MAX_BODY || state.thread !== thread || state.slot.author !== "Nobody") return refused
  try (try Drafts).write(thread, draft)
  return { type: "suggested", ticket, ok: true }
}

function carry(fx: Out): Job<Event, Telephony | Drafts | Attempts | Conversations | Inbox | Agent | SystemSettings | Messages | Composer.Machine | Phone, []> {
  return match (fx) {
    when { tag: "SaveDraft" }: answer("save", succeed<Event>({ type: "draftSaved" }), { type: "draftSaved" });
    when { tag: "DropDraft", let thread }: run(`drop ${thread}`, effect { try (try Drafts).drop(thread) });
    when { tag: "Suggest", let ticket, let thread }: answer("suggest", suggestion(ticket, thread), { type: "suggested", ticket, ok: false });
    when { tag: "Prompt", let need }: answer("prompt", effect {
      const status = telephony("requestAccess", (c) => c.phone.requestAccess(need === "SendAccess" ? "sendSms" : "phoneState")) catch () => undefined
      if (status !== undefined) try rememberSims(status.subscriptions ?? [])
      return { type: "accessReported", need, grant: grantOf(need === "SendAccess" ? status?.permissions.sendSms : status?.permissions.phoneState) } satisfies Event
    }, { type: "accessReported", need, grant: "Unasked" });
    when { tag: "OpenSettings" }: run("settings", effect { try (try SystemSettings).open("AppPermissions", "") });
    when { tag: "OpenMessagingApp" }: run("elsewhere", effect {
      const thread = (try (try Composer.Machine).get()).thread
      try elsewhere(thread, try (try Drafts).text(thread))
    });
    when { tag: "Sending" }: sending(fx.effect);
  }
}

// spec/app/messages/composer.md, "A restart closes the conversation and keeps the saved drafts, the send, access and the SIMs the phone has"
const machine = reacting(Composer, { keep: 1, open: [{ type: "restart" }], carry })

// spec/app/messages/composer.md, "Opening a conversation brings back the draft the phone saved for it"; spec/app/messages/composer.md, "Closing the conversation's composer waits until its draft is saved"
/** The conversation Messages has open, and how many it is with, told to the composer until it takes it. */
const opened = started(effect {
  const messages = try Messages
  const composer = try Composer.Machine
  const numbering = try Conversations
  let taken = -1
  try Stream.runForEach(Stream.zipLatest(messages.changes, composer.changes), effect ([state]) => {
    const store = try Drafts
    const queued = try store.offeredPicture()
    if (queued !== undefined && state.offeredPicture !== queued.ticket && state.picker.ticket >= queued.ticket) {
      try store.setOfferedPicture(undefined)
    }
    const thread = state.pane === "Conversation" ? state.thread : 0
    const forThread = queued !== undefined && state.offeredPicture === queued.ticket && thread > 0
    if (thread === taken && !forThread) return
    const conversation = try numbering.get(thread)
    const recipients = Option.isSome(conversation) ? conversation.value.addresses.length : 0
    const event: Event = thread === 0 ? { type: "closeDraft" } : { type: "openDraft", thread, recipients }
    if ((try composer.get()).thread === thread || (try contained(composer.send(event), "the open conversation"))) taken = thread
    if (thread === 0) return
    const status = telephony("status", (c) => c.messages.status()) catch () => undefined
    if (status !== undefined) {
      try rememberSims(status.subscriptions ?? [])
      try (try Drafts).setSending({ direct: status.sendMode === "direct", pictures: status.mmsSend })
      try contained(composer.send({ type: "accessReported", need: "SendAccess", grant: grantOf(status.permissions.sendSms) }), "send access")
      try contained(composer.send({ type: "accessReported", need: "SimAccess", grant: grantOf(status.permissions.phoneState) }), "SIM access")
    }
    if (forThread && queued !== undefined && taken === thread) {
      const choosing = try messages.get()
      if (choosing.thread !== thread || choosing.offeredPicture !== queued.ticket) return
      const current = try composer.get()
      try store.setOfferedPicture(undefined)
      try ignore(messages.send({ type: "clearPictureOffer", ticket: queued.ticket }))
      if (status?.sendMode !== "direct" || !status.mmsSend || !status.roles.sms.held) {
        try say("Picture messaging is unavailable", true)
      } else if (current.slot.author !== "Nobody" || (try store.text(thread)) !== "" || current.pictures !== 0 ||
        !(try attachPicture(thread, queued.picture))) {
        try say("Finish your existing message draft before adding this picture", true)
      }
    }
  })
}, "the composer's conversation")

// spec/app/messages/sending.md, "A delivery report counts only for a part reported sent"
/** The phone's word that a send's record changed: a delivery report for each recipient every part of which arrived, counted once. */
const reports: Stream.Stream<Event, never, Telephony | Drafts | Composer.Machine> = Stream.flatMap(
  Stream.callback<OperationId, never, Telephony>((queue) => Effect.asVoid(acquireRelease(
    Effect.orElseSucceed(telephony("observeMessages", (c) => c.messages.observeMessages(() => {}, (operation) => { Queue.offerUnsafe(queue, operation) }, (operation) => { Queue.offerUnsafe(queue, operation) })), () => undefined),
    (unsubscribe) => (unsubscribe === undefined ? Effect.void : ignore(tryPromise(() => unsubscribe()))),
  ))),
  (operation) => Stream.unwrap(effect {
    const store = try Drafts
    const machine = try Composer.Machine
    const held = try store.outgoing()
    if (Option.isNone(held) || held.value.operation !== operation || held.value.sim === null) return Stream.empty
    const send = held.value
    const sim = held.value.sim
    const mms = usingMms(send.to.length, send.pictured)
    const record: SmsSendResult | undefined = mms ? undefined : (telephony("smsSendResult", (c) => c.messages.smsSendResult({ recipients: [...send.to] as PhoneNumber[], body: send.body, subscriptionId: sim }, operation)) catch () => undefined)
    const status = mms ? try receiptOf(send, sim, operation) : record?.status
    if (status === undefined || status === "submitted" || status === "unknown") return Stream.empty
    const current = try store.outgoing()
    if (Option.isNone(current) || current.value.operation !== operation) return Stream.empty
    try store.setOutgoing({ ...current.value, status })
    const state = try machine.get()
    const id = state.outgoing.op.id
    const resolved: Event[] = Composer.canReadBack(state, id) ? [{ type: "readBack", id, wasSent: sentStatuses.has(status), known: true }] : []
    const arrived = record === undefined ? 0 : send.to.filter((_number, at) => {
      const parts = record.parts.filter((part) => part.recipientIndex === at)
      return parts.length > 0 && parts.every((part) => part.delivery === "success")
    }).length
    return Stream.fromIterable([...resolved, ...Array.from({ length: Math.max(0, arrived - state.outgoing.reported) }, (): Event => ({ type: "reportArrived", id }))])
  }),
)

// spec/app/messages/sending.md, "A finished record is retired by a tombstone"
const retiring = following(Composer.Machine, (state) => (Composer.canRetire(state, state.outgoing.op.id) ? state.outgoing.op.id : 0), Composer.Machine, (id): Event | undefined => (id === 0 ? undefined : { type: "retire", id }))

// spec/app/messages/composer.md, "What Alpha cannot send is handed to the messaging app"
/** Single plain texts use SMS. Group messages and pictures need the phone's MMS capability. */
export effect function supported(recipients: number, pictures: number): boolean!!Drafts {
  const can = try (try Drafts).sending()
  return can.direct && (usingMms(recipients, pictures > 0) ? can.pictures && recipients <= MMS_MAX_RECIPIENTS : recipients === 1)
}

/** What the owner's Send carries, put in hand just before it: the draft, the conversation's numbers, the SIM and the pictures; a send whose outcome is unknown keeps what it carried. */
export effect function prepare(thread: number, selectedSim: TelephonySubscription | undefined): boolean!!(Drafts | Conversations | Composer.Machine) {
  const state = try (try Composer.Machine).get()
  const store = try Drafts
  if (state.thread !== thread || Composer.bound(state) || state.outgoing.op.outcome === "Recorded" || state.outgoing.op.outcome === "Sent") return false
  const conversation = try (try Conversations).get(thread)
  if (Option.isNone(conversation) || conversation.value.addresses.length !== state.recipients || state.recipients === 0) return false
  const to = conversation.value.addresses
  const pictures = try store.pictures()
  try store.setOutgoing({ thread, to, body: state.slot.author === "Nobody" ? "" : try store.text(thread), sim: null, selectedSim, pictures, pictured: pictures.length > 0, operation: undefined, mms: undefined, status: undefined })
  return true
}

// spec/app/messages/index.md, "A picture from Files is offered in a new recipient picker and can join only its chosen empty draft"
export effect function pictureMessagingReady(): boolean!!Telephony {
  const status = telephony("status", (c) => c.messages.status()) catch () => undefined
  return status?.sendMode === "direct" && status.mmsSend && status.roles.sms.held
}

// spec/app/messages/index.md, "A picture from Files is offered in a new recipient picker and can join only its chosen empty draft"
export effect function handOverPicture(picture: Picture): boolean!!(Drafts | Composer.Machine | Messages | Shell) {
  const shell = try Shell
  const messages = try Messages
  const drafts = try Drafts
  const composer = try (try Composer.Machine).get()
  if (!showing(try shell.get(), "Files") || Composer.bound(composer) || !Composer.settledDraft(composer) || composer.pictures > 0 ||
    (try drafts.offeredPicture()) !== undefined || (try messages.get()).front) return false
  if (!(try contained(shell.send({ type: "openView", view: "Messages" }), "the picture handed to Messages"))) return false
  const front = try Effect.timeoutOption(Stream.runHead(Stream.filter(messages.changes, (s) => s.front)), "3 seconds")
  if (Option.isNone(front) || !(showing(try shell.get(), "Messages"))) return false
  const state = try messages.get()
  if (!canNewPictureMessage(state)) return false
  try drafts.setOfferedPicture({ ticket: state.picker.ticket + 1, picture })
  if (try contained(messages.send({ type: "newPictureMessage" }), "the picture's recipient picker")) return true
  try drafts.setOfferedPicture(undefined)
  return false
}

// spec/app/messages/composer.md, "The owner attaches up to five pictures, and removes them one by one"
effect function attachPicture(thread: number, picture: Picture): boolean!!(Drafts | Composer.Machine) {
  const store = try Drafts
  const machine = try Composer.Machine
  const current = try machine.get()
  const held = try store.pictures()
  const wireName = picture.wireName ?? picture.name
  const fits = !held.some((one) => one.name === picture.name || (one.wireName ?? one.name) === wireName) && held.reduce((sum, one) => sum + one.bytes.length, 0) + picture.bytes.byteLength <= MMS_MAX_TOTAL_BYTES
  if (current.thread !== thread || !Composer.canAttach(current, fits)) return false
  try store.setPictures([...held, picture])
  if (try contained(machine.send({ type: "attach", fits }), "the selected picture")) return true
  try store.setPictures(held)
  return false
}

// spec/app/messages/composer.md, "The owner attaches up to five pictures, and removes them one by one"
/** Attach the owner's chosen files in turn: each the phone's MMS takes, a JPEG, PNG or GIF within its size with those before, is attached while the composer takes one. */
export effect function attachAll(files: ReadonlyArray<File>): void!!(Drafts | Composer.Machine) {
  const machine = try Composer.Machine
  const thread = (try machine.get()).thread
  for (const file of files) {
    const contentType = MMS_ATTACHMENT_TYPES.find((type) => type === file.type)
    if (contentType === undefined || file.size <= 0 || file.size > MMS_MAX_TOTAL_BYTES) continue
    const bytes = tryPromise(() => file.arrayBuffer()) catch () => undefined
    if (bytes === undefined) continue
    if ((try machine.get()).thread !== thread) return
    try attachPicture(thread, { name: file.name, contentType, bytes: new Uint8Array(bytes) })
  }
}

// spec/app/messages/composer.md, "An edited draft is saved for its conversation, one save at a time"
const saving = following(Composer.Machine, (state) => Composer.canSaveDraft(state), Composer.Machine, (due): Event | undefined => (due ? { type: "saveDraft" } : undefined))

// spec/app/messages/composer.md, "The composer holds at most five pictures and a SIM the phone has"
/** The pictures kept beside the composer go when it holds none: a message sent with them, or another conversation opened. */
const unpictured = applying(Composer.Machine, (state) => state.pictures === 0, effect (none: boolean) => {
  if (none && (try (try Composer.Machine).get()).pictures === 0) try (try Drafts).setPictures([])
})

/** The composer: kept across restarts, so a draft and a send under way survive them; nothing is sent when Alpha opens again. */
export const composer = together(machine, drafts, opened, saving, retiring, unpictured, hearing(reports, Composer.Machine, (event: Event) => event))
