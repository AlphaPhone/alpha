// spec/app/messages/composer.md, "The agent's draft goes into the open conversation's draft only while it is empty, and never sends"
import { NOT_DISPATCHED } from "@elizaos/agent"
import { type DeviceOperation, type OperationResultOf, readResult } from "@elizaos/agent"
import { MMS_MAX_BODY, threadIdOf } from "@elizaos/os-bridges"
import { normalizePhoneNumber, type PhoneNumber } from "@elizaos/os-bridges"
import { Machine as Composer, bound } from "../../gen/app__messages__composer.effect.vibe"
import { Machine as Messages, removing } from "../../gen/app__messages.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { Device } from "../platform/device.vibe"
import { Telephony, telephony } from "../platform/telephony.vibe"
import { contained } from "../runtime/reactor.vibe"
import { currentPhoneContact, type ReviewedPhoneContact } from "../phone/named-review.vibe"
import { Drafts } from "./composer.vibe"
import { Conversations, Inbox } from "./messages.vibe"

/** The exact thread and latest read the owner had open when the request started. */
export interface MessageDraftTarget {
  readonly thread: number
  readonly ticket: number
}

type SmsCompose = Extract<DeviceOperation, { type: "sms_compose" }>

/** A previous sender's exact native thread uses a separate owner-approved read and draft path. */
export function reviewedCompose(operation: SmsCompose): boolean {
  return !("target" in operation) || operation.replyThreadId === undefined
}

export function composeRecipient(operation: SmsCompose) {
  return "target" in operation ? operation.target : { kind: "contact", query: operation.query } as const
}

const refused = { kind: "refused", code: NOT_DISPATCHED } as const

type ReadSelected = Extract<DeviceOperation, { type: "messages_read_selected" }>
const readSelected: ReadSelected = { type: "messages_read_selected" }

module selection {
  import type { MessageRow } from "@elizaos/os-bridges"

  const maxRows = 20
  const maxBody = 1600
  // The native execution journal caps its entire encrypted entry at 64 KiB.
  const maxBodyWireBytes = 48 * 1024
  const wire = new TextEncoder()

  /** The visible tail, oldest first, measured the same way the native journal stores it. @throws {never} */
  export function messageTail(rows: readonly MessageRow[], older: boolean) {
    const listed = rows.flatMap((row) => "incomplete" in row ? [] : [row])
      .sort((one, other) => other.date - one.date)
    const tail = []
    let truncated = older || listed.length !== rows.length || listed.length > maxRows
    let remaining = maxBodyWireBytes
    for (const row of listed.slice(0, maxRows)) {
      const body = row.body.slice(0, maxBody).replace(/[\uD800-\uDBFF]$/u, "")
      const message = { direction: row.direction === "incoming" ? "in" : "out", date: row.date, body } as const
      const size = wire.encode(JSON.stringify(message)).byteLength + 1
      if (size > remaining) { truncated = true; break }
      remaining -= size
      truncated ||= body !== row.body
      tail.push(message)
    }
    return { messages: tail.reverse(), truncated }
  }
}
import { messageTail } from selection

// spec/app/contacts/agent.md, "The agent reads only the conversation, voicemail or contact open on screen, as the phone last read it"
/** One exact visible provider thread, when its current read can be shared. */
effect function selectedMessage(target: MessageDraftTarget): (OperationResultOf<"messages_read_selected"> | undefined)!!(Device | Shell | Messages | Inbox | Conversations) {
  if (!(try (try Device).showing()) || !showing(try (try Shell).get(), "Messages")) return undefined
  const where = try (try Messages).get()
  if (!where.front || where.pane !== "Conversation" || where.page.status !== "Loaded" || where.sms.grant !== "Granted") return undefined
  if (where.thread !== target.thread || where.page.ticket !== target.ticket) return undefined
  const held = try (try Inbox).get()
  if (held.messagesThread !== where.thread) return undefined
  const saved = try (try Conversations).get(where.thread)
  if (Option.isNone(saved) || threadIdOf(saved.value.id) === null || held.messages.some((one) => one.threadId !== saved.value.id)) return undefined
  const addresses = saved.value.addresses
  const address = addresses.length === 1 ? addresses[0] : undefined
  const displayName = address === undefined ? undefined : held.names.get(address)?.trim().slice(0, 128)
  const number = normalizePhoneNumber(address)
  const person = displayName && displayName !== address && (number === null || normalizePhoneNumber(displayName) !== number) ? displayName : null
  const tail = messageTail(held.messages, held.messagesNext !== undefined)
  return readResult<"messages_read_selected">(readSelected, { kind: "messages-read", status: "read", participant: person, ...tail })
}

/** Return a thread receipt only under the current explicit approval and the phone's current SMS permission. */
export effect function shareSelectedMessage(target: MessageDraftTarget | undefined, current: () => Promise<boolean>): unknown!!(Device | Shell | Messages | Inbox | Conversations | Telephony) {
  if (target === undefined || !(try (try Device).capabilities()).image) return refused
  const allowed = tryPromise(current) catch () => false
  if (!allowed) return refused
  const native = telephony("Messages sharing permission", (client) => client.messages.status()) catch () => undefined
  if (native?.permissions.sms !== "granted") return refused
  const still = tryPromise(current) catch () => false
  if (!still) return refused
  const result = try selectedMessage(target)
  return result?.status === "read" ? { kind: "applied", result } : refused
}

/** When the addressed draft navigates, the Ask Alpha sheet stays where it was. */
effect function addressed(number: string): (number | undefined)!!(Shell | Messages | Conversations) {
  const shell = try Shell
  if (!showing(try shell.get(), "Messages") && !(try contained(shell.send({ type: "agentOpenView", view: "Messages" }), "opening the addressed draft"))) return undefined
  const messages = try Messages
  const ready = try race(
    Stream.runHead(Stream.filter(messages.changes, (state) => state.front && state.sms.grant === "Granted")),
    Effect.as(sleep(2500), Option.none()),
  )
  if (Option.isNone(ready) || !showing(try shell.get(), "Messages")) return undefined
  const state = try messages.get()
  if (!state.front || state.sms.grant !== "Granted" || state.confirming || removing(state)) return undefined
  const thread = try (try Conversations).of({ id: "", addresses: [number] })
  if (state.pane === "Conversation" && state.thread === thread) return thread
  if (state.pane !== "Threads" && !(try contained(messages.send({ type: "back" }), "leaving the prior message pane"))) return undefined
  if (!(try contained(messages.send({ type: "newMessage" }), "opening the addressed message picker"))) return undefined
  return (try contained(messages.send({ type: "choose", thread, typed: true }), "selecting the exact draft recipient")) ? thread : undefined
}

/** Stage only the reviewed draft, in the admitted conversation's empty slot. */
effect function stage(body: string, thread: number, check: boolean!!Telephony, target?: MessageDraftTarget, recipient?: PhoneNumber): boolean!!(Device | Shell | Messages | Composer | Inbox | Drafts | Conversations | Telephony) {
  const inbox = try Inbox
  const messages = try Messages
  const composer = try Composer
  const opened = try race(
    Stream.runHead(Stream.filter(Stream.zipLatest(messages.changes, composer.changes), ([where, draft]) =>
      where.front && where.thread === thread && where.sms.grant === "Granted" && where.page.status === "Loaded" && draft.thread === thread)),
    Effect.as(sleep(2500), Option.none()),
  )
  if (Option.isNone(opened)) return false
  const [read] = opened.value
  if (!(try check) || !(try (try Device).showing()) || !showing(try (try Shell).get(), "Messages")) return false
  const where = try messages.get()
  const draft = try composer.get()
  if (!where.front || where.thread !== thread || where.sms.grant !== "Granted" || where.page.status !== "Loaded" ||
      where.page.ticket !== read.page.ticket || (target !== undefined && where.page.ticket !== target.ticket) || (try inbox.get()).messagesThread !== thread ||
      draft.thread !== thread || draft.slot.author !== "Nobody" || draft.pictures > 0 || bound(draft)) return false
  if (recipient !== undefined) {
    const conversation = try (try Conversations).get(thread)
    if (Option.isNone(conversation) || conversation.value.addresses.length !== 1 || normalizePhoneNumber(conversation.value.addresses[0]) !== recipient) return false
  }
  const drafts = try Drafts
  if ((try drafts.text(thread)) !== "") return false
  try drafts.write(thread, body)
  const kept = (try drafts.text(thread)) === body
  const taken = kept && (try contained(composer.send({ type: "agentDrafted", thread }), "staging the reviewed draft"))
  const after = try composer.get()
  if (taken && after.thread === thread && after.slot.author === "AlphaWrote" && (try drafts.text(thread)) === body) return true
  if ((try composer.get()).slot.author === "Nobody" && (try drafts.text(thread)) === body) try drafts.drop(thread)
  return false
}

/** After the proposal is approved, an addressed draft may open only its exact Messages destination. */
export effect function messageAction(operation: DeviceOperation, target: MessageDraftTarget | undefined, current: () => Promise<boolean>, continueDraft?: () => Promise<boolean>, contact?: ReviewedPhoneContact): unknown!!(Device | Shell | Messages | Composer | Conversations | Inbox | Drafts | Telephony) {
  if (operation.type !== "sms_reply_selected" && operation.type !== "sms_compose") return refused
  const body = operation.body
  if (!body.trim() || body.length > MMS_MAX_BODY || body.includes("\0")) return refused
  const live = tryPromise(current) catch () => false
  if (!live || !(try (try Device).capabilities()).image || !(try (try Device).showing())) return refused
  if (operation.type === "sms_reply_selected") {
    if (target === undefined || !(try stage(body, target.thread, tryPromise(current) catch () => false, target))) return refused
    return { kind: "applied", result: { kind: "sms-reply", status: "drafted" } }
  }
  if (!reviewedCompose(operation)) return refused
  const recheck = continueDraft ?? current
  const recipient = composeRecipient(operation)
  const chosen = recipient.kind === "contact" ? contact : undefined
  if (recipient.kind === "contact" && (chosen === undefined || chosen.query !== recipient.query.trim() || !(try currentPhoneContact(chosen)))) return refused
  const number = normalizePhoneNumber(recipient.kind === "number" ? recipient.number : chosen?.number)
  if (number === null || !(tryPromise(current) catch () => false)) return refused
  const thread = try addressed(number)
  const canStage = effect {
    if (!(tryPromise(recheck) catch () => false)) return false
    if (chosen === undefined) return true
    return (try currentPhoneContact(chosen)) && (tryPromise(recheck) catch () => false)
  }
  if (thread === undefined || !(try stage(body, thread, canStage, undefined, number))) return refused
  return { kind: "applied", result: { kind: "sms-compose", status: "drafted" } }
}
