// spec/app/messages/index.md, "Story: See my conversations"; spec/app/messages/index.md, "Story: Read a conversation"; spec/app/messages/index.md, "Story: Act on a message"; spec/app/messages/index.md, "Story: Start a new message"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { type ContactCursor, type StagedDeletion, type AddressBookContact, normalizePhoneNumber, threadIdOf, type MessageCursor, type MessageDeleteReference, type MessageRow, type ThreadCursor, type ThreadId, type ThreadRow, type PhoneNumber } from "@elizaos/os-bridges"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import * as Messages from "../../gen/app__messages.effect.vibe"
import type { Effect as Out, Event, Need, Page } from "../../gen/app__messages.effect.vibe"
import { CarrierSetup } from "../platform/carrier.vibe"
import { Device, registered } from "../platform/device.vibe"
import { SystemSettings } from "../platform/systemSettings.vibe"
import { Telephony, deletionRefused, readAddressBook, readNames, telephony } from "../platform/telephony.vibe"
import type { Machine as Toasts } from "../../gen/app__notices__toasts.effect.vibe"
import { type Said, offer, withdraw } from "../notices/toasts.vibe"
import { type Job, answer, applying, contained, hearing, reacting, run, started, together } from "../runtime/reactor.vibe"
import { Time } from "../runtime/time.vibe"
import { type Dialer, dialing, grantOf } from "../phone/phone.vibe"
import { type Machine as PhoneMachine } from "../../gen/app__phone.effect.vibe"
import { on, visiting } from "../phone/visit.vibe"
import { displayNumber, matches } from "../phone/words.ts"
import { pageAddressBook } from "../contacts/contacts.vibe"

module nativeNotice {
  import { type PluginListenerHandle, registerPlugin } from "@capacitor/core"

  interface Transport {
    smsNoticePending(): Promise<{ threadId?: unknown; token?: unknown }>
    acknowledgeSmsNotice(input: { token: string }): Promise<void>
    smsDraftPending(): Promise<unknown>
    acknowledgeSmsDraft(input: { token: string }): Promise<void>
    addListener(name: "smsNotice" | "smsDraft", wake: () => void): Promise<PluginListenerHandle>
  }

  let made: Transport | undefined
  /** The Alpha image's extension of the telephony plugin. @throws {never} */
  export function noticeTransport(): Transport {
    const existing = (globalThis as { Capacitor?: { Plugins?: Record<string, Transport | undefined> } }).Capacitor?.Plugins?.ElizaTelephony
    if (existing !== undefined) return existing
    return (made ??= registerPlugin<Transport>("ElizaTelephony"))
  }
}
import { noticeTransport } from nativeNotice
export { noticeTransport }

/** A conversation Messages has given a number: the phone's thread, where it has one, and the numbers it is with. */
export interface Conversation {
  readonly id: string
  readonly addresses: ReadonlyArray<string>
  readonly promoted?: true
}

export type CopyReport = (outcome: "copied" | "failed" | undefined) => void

/**
 * The numbers Messages gives conversations, kept across restarts so that a draft saved for a number still names its
 * conversation. A conversation started with a number the phone has no thread for is numbered by that number.
 */
export service Conversations {
  of(conversation: Conversation): number!!
  get(thread: number): Option.Option<Conversation>!!
}

module text {
  type StoredConversation = { id: string; addresses: string[]; promoted?: true }

  /** What the store kept: the conversations in the order they were numbered, from 1. @throws {never} */
  export function kept(raw: string | undefined): StoredConversation[] {
    if (raw === undefined) return []
    try {
      const found: unknown = JSON.parse(raw)
      return Array.isArray(found) ? found.filter((one): one is StoredConversation => typeof one?.id === "string" && Array.isArray(one?.addresses)
        && one.addresses.every((address: unknown) => typeof address === "string") && (one.promoted === undefined || one.promoted === true)) : []
    } catch {
      return []
    }
  }
}
import { kept } from text

const conversationsKey = "alpha/messages/conversations@1"

const canonicalAddresses = (addresses: ReadonlyArray<string>) =>
  addresses.map((one) => normalizePhoneNumber(one) ?? one.trim()).sort().join(",")

const conversations = Layer.effect(Conversations, effect {
  const store = try KeyValueStore.KeyValueStore
  const known: Conversation[] = kept(store.get(conversationsKey) catch () => undefined)
  const recipientKey = (one: Conversation) => canonicalAddresses(one.addresses)
  const keyOf = (one: Conversation) => (one.id !== "" ? `id:${one.id}` : `to:${recipientKey(one)}`)
  const numbers = new Map(known.map((one, at) => [keyOf(one), at + 1]))
  return {
    effect of(conversation: Conversation): number!! {
      const key = keyOf(conversation)
      const recipients = recipientKey(conversation)
      const alias = recipients === "" ? 0 : known.findIndex((one) =>
        (one.id === "" || conversation.id === "") && recipientKey(one) === recipients) + 1
      const found = numbers.get(key) ?? alias
      const previous = known.at(found - 1)
      if (found > 0 && previous !== undefined) {
        const id = conversation.id || previous.id
        const addresses = conversation.addresses.length > 0 ? conversation.addresses : previous.addresses
        const current: Conversation = { id, addresses, ...(previous.promoted || (previous.id === "" && id !== "") ? { promoted: true } : {}) }
        numbers.set(key, found)
        if (id !== previous.id || recipientKey(current) !== recipientKey(previous)) {
          known[found - 1] = current
          try ignore(store.set(conversationsKey, JSON.stringify(known)))
        }
        return found
      }
      known.push({ id: conversation.id, addresses: [...conversation.addresses] })
      numbers.set(keyOf(conversation), known.length)
      try ignore(store.set(conversationsKey, JSON.stringify(known)))
      return known.length
    },
    get: (thread: number) => sync(() => Option.fromNullishOr(known[thread - 1])),
  }
})

/** What Messages counts, kept beside it: the rows each pane last read, the search, the message the owner chose, and where a further read goes on from. */
export interface Texts {
  readonly threads: ReadonlyArray<ThreadRow>
  readonly threadsNext: ThreadCursor | undefined
  readonly sought: string
  readonly messagesThread: number
  readonly messages: ReadonlyArray<MessageRow>
  readonly messagesNext: MessageCursor | undefined
  readonly chosen: string
  readonly copyRequest: { readonly row: MessageRow; readonly report: CopyReport } | undefined
  readonly deleteTarget: MessageDeleteReference | undefined
  readonly choices: ReadonlyArray<AddressBookContact>
  readonly choicesNext: ContactCursor | undefined
  readonly typed: string
  readonly names: ReadonlyMap<string, string>
}

const empty: Texts = { threads: [], threadsNext: undefined, sought: "", messagesThread: 0, messages: [], messagesNext: undefined, chosen: "", copyRequest: undefined, deleteTarget: undefined, choices: [], choicesNext: undefined, typed: "", names: new Map() }

/** A conversation's title: the contacts' names for its numbers, and readable numbers for the rest. */
export function titleOf(addresses: ReadonlyArray<string>, names: ReadonlyMap<string, string>): string {
  return addresses.map((address) => names.get(address) || displayNumber(address)).join(", ")
}

interface NewRecipientScope { readonly visit: number; readonly recipient: number; readonly contacts: boolean }
interface NewRecipientTitle extends NewRecipientScope { readonly title: string; readonly numbers: string }

interface NewRecipientSnapshot {
  readonly get: () => NewRecipientTitle | undefined
  readonly subscribe: (listener: () => void) => () => void
  set(next: NewRecipientTitle | undefined): void
}

/** The rows and current New recipient label behind Messages' counts. */
export service Inbox {
  get(): Texts!!
  set(change: Partial<Texts>): void!!
  readonly newRecipient: NewRecipientSnapshot
}

function sameNewRecipient(one: NewRecipientScope | undefined, other: NewRecipientScope | undefined): boolean {
  return one?.visit === other?.visit && one?.recipient === other?.recipient && one?.contacts === other?.contacts
}

const inbox = Layer.sync(Inbox, () => {
  let held = empty
  let title: NewRecipientTitle | undefined
  const listeners = new Set<() => void>()
  const newRecipient: NewRecipientSnapshot = {
    get: () => title,
    subscribe: (listener) => {
      listeners.add(listener)
      return () => { listeners.delete(listener) }
    },
    set: (next) => {
      if (sameNewRecipient(title, next) && title?.title === next?.title) return
      title = next
      for (const listener of listeners) listener()
    },
  }
  return { get: () => sync(() => held), set: (change: Partial<Texts>) => sync(() => { held = { ...held, ...change } }), newRecipient }
})

function replaceNames(previous: ReadonlyMap<string, string>, addresses: ReadonlyArray<string>, names: ReadonlyMap<string, string> | undefined): ReadonlyMap<string, string> {
  if (names === undefined) return new Map()
  const kept = new Map(previous)
  for (const address of addresses) kept.delete(address)
  for (const [address, name] of names) kept.set(address, name)
  return kept
}

const maxPages = 20

// spec/app/messages/index.md, "Only the newest read of the list is shown, with what Android says about SMS access"
effect function threadsRead(ticket: number, further: boolean): Event!!(Telephony | Inbox | Conversations | Messages.Machine) {
  const store = try Inbox
  const machine = try Messages.Machine
  const held = try store.get()
  const chip = (try machine.get()).chip
  const status = telephony("status", (c) => c.messages.status()) catch () => undefined
  const grant = grantOf(status?.permissions.sms)
  const canName = status?.permissions.contacts === "granted"
  if (grant !== "Granted") {
    if (!canName && Messages.canThreadsRead(try machine.get(), ticket, 0)) try store.set({ names: new Map() })
    return { type: "threadsRead", ticket, ok: true, grant, count: 0, further: false }
  }
  const found = new Map((further ? held.threads : []).map((row) => [row.id, row] as const))
  const filtering = chip === "UnreadThreads" || held.sought.trim() !== ""
  const seen = new Set<ThreadCursor>()
  let cursor = further ? held.threadsNext : undefined
  let more = true
  let pages = 0
  const minimum = found.size
  let visibleNames: ReadonlyMap<string, string> = canName ? (further ? held.names : new Map()) : new Map()
  while (more && found.size === minimum && pages < maxPages) {
    pages += 1
    const position = cursor
    const page = telephony("threadPage", (c) => c.messages.threadPage(position)) catch () => undefined
    if (page === undefined) {
      if (!canName && Messages.canThreadsRead(try machine.get(), ticket, 0)) try store.set({ names: new Map() })
      return { type: "threadsRead", ticket, ok: false, grant, count: 0, further: false }
    }
    const addresses = page.rows.flatMap((row) => ("incomplete" in row ? [] : row.addresses))
    const previousNames = (try store.get()).names
    const pageNames = canName ? (readNames("messages", addresses) catch () => undefined) : undefined
    const currentNames = (try store.get()).names
    visibleNames = !canName ? new Map() : currentNames !== previousNames ? currentNames
      : further || pages > 1 ? replaceNames(visibleNames, addresses, pageNames) : pageNames ?? new Map()
    const titled = (row: ThreadRow) => ("incomplete" in row ? "" : row.addresses.map((address) => visibleNames.get(address) ?? address).join(", "))
    for (const row of page.rows) {
      const fits = "incomplete" in row
        ? !filtering
        : (chip === "AllThreads" || row.unread) && matches(held.sought, `${titled(row)} ${row.snippet}`, row.addresses.join(" "))
      if (fits) found.set(row.id, row)
    }
    const next = page.next ?? undefined
    more = next !== undefined && !seen.has(next)
    if (next !== undefined) seen.add(next)
    cursor = next
  }
  const rows = Array.from(found.values())
  if (Messages.canThreadsRead(try machine.get(), ticket, rows.length)) {
    try store.set({ threads: rows, threadsNext: more ? cursor : undefined, names: visibleNames })
  }
  return { type: "threadsRead", ticket, ok: true, grant, count: rows.length, further: more && cursor !== undefined }
}

/** The phone's thread for a conversation Messages numbered: its own, or the listed one with exactly its numbers. */
effect function threadOf(conversation: Conversation): Option.Option<ThreadId>!!Telephony {
  if (conversation.id !== "") return Option.some(conversation.id as ThreadId)
  const target = canonicalAddresses(conversation.addresses)
  const same = (row: ThreadRow) => !("incomplete" in row) && canonicalAddresses(row.addresses) === target
  const seen = new Set<ThreadCursor>()
  let cursor: ThreadCursor | undefined
  let matched: ThreadId | undefined
  for (let pages = 0; pages < maxPages; pages += 1) {
    const position = cursor
    const page = telephony("threadPage", (c) => c.messages.threadPage(position)) catch () => undefined
    if (page === undefined) return Option.none()
    for (const row of page.rows) {
      if (!same(row)) continue
      if (matched !== undefined && matched !== row.id) return Option.none()
      matched = row.id
    }
    const next = page.next ?? undefined
    if (next === undefined || seen.has(next)) break
    seen.add(next)
    cursor = next
  }
  return Option.fromNullishOr(matched)
}

// spec/app/messages/index.md, "Only the newest read of the open conversation is shown, and it marks the shown messages read only where Alpha is the phone's SMS app"
effect function pageRead(ticket: number, thread: number, further: boolean): Event!!(Telephony | Inbox | Conversations | Messages.Machine) {
  const store = try Inbox
  const machine = try Messages.Machine
  const held = try store.get()
  const blank: Page = { rows: 0, failed: 0, partial: 0 }
  const status = telephony("status", (c) => c.messages.status()) catch () => undefined
  const grant = grantOf(status?.permissions.sms)
  const role = status?.roles.sms.held ?? false
  const canName = status?.permissions.contacts === "granted"
  effect function admit(seen: Page): boolean!! {
    const current = try machine.get()
    if (current.thread !== thread || !Messages.canPageRead(current, ticket, seen)) return false
    if (!canName) try store.set({ names: new Map() })
    return true
  }
  const conversation = try (try Conversations).get(thread)
  if (grant !== "Granted" || Option.isNone(conversation)) {
    try admit(blank)
    return { type: "pageRead", ticket, ok: grant === "Granted" || grant === "Unasked", grant, seen: blank, further: false, unreadShown: false, role }
  }
  const id = try threadOf(conversation.value)
  if (Option.isNone(id)) {
    if (try admit(blank)) try store.set({ messagesThread: thread, messages: [], messagesNext: undefined })
    return { type: "pageRead", ticket, ok: true, grant, seen: blank, further: false, unreadShown: false, role }
  }
  const page = telephony("messagePage", (c) => c.messages.messagePage(id.value, further ? held.messagesNext : undefined)) catch () => undefined
  if (page === undefined) {
    try admit(blank)
    return { type: "pageRead", ticket, ok: false, grant, seen: blank, further: false, unreadShown: false, role }
  }
  const merged = new Map((further ? held.messages : []).map((row) => [row.id, row] as const))
  for (const row of page.rows) merged.set(row.id, row)
  const rows = Array.from(merged.values())
  const seen: Page = {
    rows: rows.length,
    failed: rows.filter((row) => !("incomplete" in row) && row.status === "failed").length,
    partial: rows.filter((row) => "incomplete" in row).length,
  }
  if (try admit(seen)) {
    try store.set({ messagesThread: thread, messages: rows, messagesNext: page.next ?? undefined })
    if (conversation.value.id === "") try (try Conversations).of({ id: id.value, addresses: conversation.value.addresses })
  }
  const unreadShown = rows.some((row) => !("incomplete" in row) && row.direction === "incoming" && !row.read)
  return { type: "pageRead", ticket, ok: true, grant, seen, further: page.next !== null, unreadShown, role }
}

// spec/app/messages/index.md, "Only the newest read of the choices is shown, with what Android says about address-book access"
effect function choicesRead(ticket: number, further: boolean): Event!!(Telephony | Inbox | Messages.Machine) {
  const store = try Inbox
  const held = try store.get()
  const status = telephony("status", (c) => c.phone.status()) catch () => undefined
  const grant = grantOf(status?.permissions.contacts)
  if (grant !== "Granted") return { type: "choicesRead", ticket, ok: true, grant, count: 0, further: false }
  const read = effect {
    try readAddressBook("open contacts", (c) => c.open())
    return try pageAddressBook({
      query: held.typed,
      limit: 20,
      maxPages,
      existing: further ? held.choices : [],
      start: further ? held.choicesNext : undefined,
      accept: (row) => row.phones.length > 0,
    })
  } catch () => undefined
  if (read === undefined) return { type: "choicesRead", ticket, ok: false, grant, count: 0, further: false }
  const { rows, next } = read
  if (Messages.canChoicesRead(try (try Messages.Machine).get(), ticket, rows.length)) try store.set({ choices: rows, choicesNext: next })
  return { type: "choicesRead", ticket, ok: true, grant, count: rows.length, further: next !== undefined }
}

// spec/app/messages/index.md, "Access that arrives reads the pane again, and access that goes forgets what it showed"
effect function prompted(need: Need): Event!!Telephony {
  const status = telephony("requestAccess", (c) => c.phone.requestAccess(need === "SmsAccess" ? "sms" : "contacts")) catch () => undefined
  return { type: "accessReported", need, grant: grantOf(need === "SmsAccess" ? status?.permissions.sms : status?.permissions.contacts) }
}

// spec/app/messages/index.md, "Keep clipboard feedback on the selected message's menu"
effect function copySelected(): void!!(Inbox | CarrierSetup) {
  const inbox = try Inbox
  const held = try inbox.get()
  const request = held.copyRequest
  if (request === undefined) return
  try inbox.set({ copyRequest: undefined })
  const row = request.row
  const body = row.id === held.chosen && held.messages.includes(row) && !("incomplete" in row) ? row.body : ""
  const copied = body !== "" && (try (try CarrierSetup).copy(body))
  try sync(() => request.report(copied ? "copied" : "failed"))
  if (copied) {
    try sleep("1400 millis")
    try sync(() => request.report(undefined))
  }
}

/** A staged receipt is the authority for whether the delete happened, until Android settles it. */
effect function settledDeletion(id: number, staged: StagedDeletion): Event!!(Telephony | Time | Toasts | Said) {
  const time = try Time
  for (const delay of [0, 250, 1000, 3000]) {
    if (delay !== 0) {
      try time.until(staged.expiresAt + delay)
      if (delay === 250) try withdraw("messages", id)
    }
    const phase = telephony("message deletion receipt", (c) => c.deletionReceipt(staged)) catch () => undefined
    if (phase === "deleted") return { type: "removed", id, done: true, known: true }
    if (phase === "undone" || phase === "conflict") return { type: "removed", id, done: false, known: true }
    if (phase === "unknown") break
  }
  return { type: "removed", id, done: false, known: false }
}

// spec/app/messages/index.md, "The phone's answer ends the removal it names, and the conversation is read again unless it was refused"
effect function removed(id: number): Event!!(Telephony | Inbox | Messages.Machine | Time | Toasts | Said) {
  const inbox = try Inbox
  const one = (try inbox.get()).deleteTarget
  if (one === undefined) return { type: "removed", id, done: false, known: true }
  const machine = try Messages.Machine
  const answer = try Effect.result(telephony("deleteMessage", (c) => c.messages.deleteMessage(one)))
  if (Result.isFailure(answer)) return { type: "removed", id, done: false, known: deletionRefused(answer.failure) }
  const report = answer.success
  if (report.status !== "queued") return { type: "removed", id, done: report.status === "not-found", known: true }
  const staged = report.deletion
  const phone = try Telephony
  const undo = Effect.provideService(effect {
    const outcome = telephony("undo message deletion", (c) => c.deletions.undo(staged)) catch () => undefined
    if (outcome?.kind === "Kept") {
      try inbox.set({ deleteTarget: undefined })
      try ignore(machine.send({ type: "removed", id, done: false, known: true }))
      try ignore(machine.send({ type: "arrived" }))
    }
  }, Telephony, phone)
  try offer("Message deletion queued", "messages", id, undo)
  try ignore(machine.send({ type: "arrived" }))
  const settledEarly = Effect.as(Stream.runHead(Stream.filter(machine.changes, (s) => s.removal.id !== id || s.removal.outcome !== "Sent")), { type: "removed", id, done: false, known: true } satisfies Event)
  const outcome = try race(settledDeletion(id, staged), settledEarly)
  try withdraw("messages", id)
  if (outcome.type === "removed" && (outcome.done || !outcome.known)) try inbox.set({ deleteTarget: undefined })
  return outcome
}

/** The open conversation's numbers. */
effect function numbers(thread: number): ReadonlyArray<string>!!Conversations {
  const conversation = try (try Conversations).get(thread)
  return Option.isSome(conversation) ? conversation.value.addresses : []
}

// spec/app/messages/index.md, "Copy puts a message's text on the clipboard, Call opens Phone with the number, and a message Alpha cannot show opens in the messaging app; none changes anything here"
effect function called(thread: number, ticket: number): void!!(Conversations | Dialer | PhoneMachine | Shell | Messages.Machine) {
  const shell = try Shell
  const visit = try shell.get()
  if (!showing(visit, "Messages")) return
  const page = try (try Messages.Machine).get()
  if (page.thread !== thread || page.page.ticket !== ticket || !Messages.canCall(page)) return
  const addresses = try numbers(thread)
  if (addresses.length !== 1) return
  try ignore(dialing(addresses[0], { view: "Messages", route: visit.route }))
}

/** The messaging app, opened on the conversation's numbers, for what Alpha cannot show or send. */
export effect function elsewhere(thread: number, body = ""): void!!(Telephony | Conversations) {
  const to = (try numbers(thread)) as PhoneNumber[]
  try ignore(telephony("composeSms", (c) => c.messages.composeSms({ recipients: to, body, subscriptionId: null })))
}

function carry(fx: Out): Job<Event, Telephony | Inbox | Conversations | Messages.Machine | SystemSettings | CarrierSetup | Dialer | PhoneMachine | Shell | Time | Toasts | Said, []> {
  return match (fx) {
    when { tag: "ReadThreads", let ticket, let further }: answer("list", threadsRead(ticket, further), { type: "threadsRead", ticket, ok: false, grant: "Unasked", count: 0, further: false });
    when { tag: "ReadConversation", let ticket, let thread, let further }: answer("page", pageRead(ticket, thread, further), { type: "pageRead", ticket, ok: false, grant: "Unasked", seen: { rows: 0, failed: 0, partial: 0 }, further: false, unreadShown: false, role: false });
    when { tag: "ReadChoices", let ticket, let further }: answer("choices", choicesRead(ticket, further), { type: "choicesRead", ticket, ok: false, grant: "Unasked", count: 0, further: false });
    when { tag: "MarkRead", let thread }: run(`read ${thread}`, effect {
      const conversation = try (try Conversations).get(thread)
      const held = try (try Inbox).get()
      if (held.messagesThread !== thread) return
      const latest = held.messages.reduce((at, row) => Math.max(at, row.date), 0)
      if (Option.isSome(conversation) && conversation.value.id !== "") try ignore(telephony("markThreadRead", (c) => c.messages.markThreadRead(conversation.value.id as ThreadId, latest)))
    });
    when { tag: "Prompt", let need }: answer("prompt", prompted(need), { type: "accessReported", need, grant: "Unasked" });
    when { tag: "OpenSettings" }: run("settings", effect { try (try SystemSettings).open("AppPermissions", "") });
    when { tag: "CopyText" }: run("copy", copySelected());
    when { tag: "OpenPhone", let thread, let ticket }: run("call", called(thread, ticket));
    when { tag: "OpenMessagingApp" }: run("elsewhere", effect { try elsewhere((try (try Messages.Machine).get()).thread) });
    when { tag: "RemoveMessage", let id }: answer(`remove ${id}`, removed(id), { type: "removalLost" });
  }
}

/** Each change the phone reports while Messages shows: a message that arrived or was sent. */
const arrivals: Stream.Stream<Event, never, Telephony> = Stream.callback<Event, never, Telephony>((queue) => Effect.asVoid(acquireRelease(
  Effect.orElseSucceed(telephony("observeMessages", (c) => c.messages.observeMessages(() => { Queue.offerUnsafe(queue, { type: "arrived" }) })), () => undefined),
  (unsubscribe) => (unsubscribe === undefined ? Effect.void : ignore(tryPromise(() => unsubscribe()))),
)))

const machine = reacting(Messages, { carry })

const shown = visiting(on("Messages"), Messages.Machine, (showing): Event => (showing ? { type: "show" } : { type: "leave" }))

function newRecipientScope(state: Messages.Messages): NewRecipientScope | undefined {
  if (!state.front || state.pane !== "New" || state.newDraft.recipient === 0) return undefined
  const { visit, recipient } = state.newDraft
  return { visit, recipient, contacts: state.book.grant === "Granted" }
}

// spec/app/messages/index.md, "The current New address names the Messages stage beside Ask Alpha"
const nameNewRecipient = started(effect {
  const machine = try Messages.Machine
  const shell = try Shell
  const device = try Device
  const numbers = try Conversations
  const { newRecipient } = try Inbox
  const scope = Stream.map(Stream.zipLatest(shell.changes, machine.changes), ([where, state]) =>
    showing(where, "Messages") ? newRecipientScope(state) : undefined)
  const latest = Stream.changesWith(scope, sameNewRecipient)
  try Stream.runDrain(Stream.switchMap(latest, (one) => Stream.fromEffectDrain(effect {
    const current = effect {
      return (try device.showing()) && showing(try shell.get(), "Messages") && sameNewRecipient(one, newRecipientScope(try machine.get()))
    }
    if (!(try current) || one === undefined) {
      try sync(() => newRecipient.set(undefined))
      return
    }
    const conversation = Option.getOrUndefined(try numbers.get(one.recipient))
    if (conversation === undefined) return
    const { addresses } = conversation
    const displayedNumbers = addresses.map(displayNumber).join(", ")
    const fallback = { ...one, title: displayedNumbers, numbers: displayedNumbers }
    try sync(() => newRecipient.set(fallback))
    if (!one.contacts) return
    const names = timeout(readNames("messages", addresses), "2 seconds") catch () => undefined
    if (names !== undefined && (try current)) try sync(() => newRecipient.set({ ...fallback, title: titleOf(addresses, names) }))
  })))
}, "the New message recipient")

// spec/app/messages/index.md, "A new message, or one sent, reads the list or the open conversation again"
const heard = hearing(arrivals, Messages.Machine, (event: Event) => event)

// spec/app/messages/index.md, "A message notification opens its exact conversation once access is available"
/** A native notice may arrive before its WebView or Messages' permissions have finished loading. */
const notices = started(effect {
  if (!registered("ElizaTelephony")) return
  try ignore((try Telephony).clients())
  const transport = noticeTransport()
  const shell = try Shell
  const machine = try Messages.Machine
  const inbox = try Inbox
  const conversations = try Conversations
  const wake = Stream.callback<"Native">((queue) => effect {
    const listener = tryPromise(() => transport.addListener("smsNotice", () => { Queue.offerUnsafe(queue, "Native") })) catch () => undefined
    if (listener !== undefined) {
      try acquireRelease(succeed(listener), (handle) => ignore(tryPromise(() => handle.remove())))
    }
  })
  const accepting = Stream.changesWith(Stream.map(machine.changes, (state) => Messages.canOpenNotice(state, 1)), (a, b) => a === b)
  const ready = Stream.map(Stream.filter(accepting, (can) => can), () => "Readable" as const)
  const events = Stream.merge(Stream.concat(Stream.succeed("Native" as const), wake), ready)
  try Stream.runForEach(events, effect (event) => {
    const pending = tryPromise(() => transport.smsNoticePending()) catch () => undefined
    const id = threadIdOf(pending?.threadId)
    const token = pending?.token
    if (id === null || typeof token !== "string" || !/^\d{1,19}$/.test(token)) return
    if (!showing(try shell.get(), "Messages")) {
      if (event !== "Native" || !(try contained(shell.send({ type: "openView", view: "Messages" }), "the message notification"))) return
    }
    if (!Messages.canOpenNotice(try machine.get(), 1)) return
    const held = try inbox.get()
    const listed = held.threads.find((row) => row.id === id)
    const loaded = listed !== undefined && !("incomplete" in listed) ? [] : (telephony("listMessages", (c) => c.messages.listMessages(id)) catch () => undefined)
    if (loaded === undefined) return
    const first = loaded.find((row) => !("incomplete" in row))
    const addresses = listed !== undefined && !("incomplete" in listed) ? listed.addresses : first !== undefined && !("incomplete" in first) ? first.addresses : []
    const previousNames = (try inbox.get()).names
    const names = addresses.length > 0 ? (readNames("messages", addresses) catch () => undefined) : undefined
    const latest = tryPromise(() => transport.smsNoticePending()) catch () => undefined
    if (latest?.token !== token || threadIdOf(latest?.threadId) !== id || !showing(try shell.get(), "Messages")) return
    const thread = try conversations.of({ id, addresses })
    if (!Messages.canOpenNotice(try machine.get(), thread)) return
    const currentNames = (try inbox.get()).names
    try inbox.set({ chosen: "", names: currentNames === previousNames ? replaceNames(currentNames, addresses, names) : currentNames })
    if (try contained(machine.send({ type: "openNotice", thread }), "the message notification")) {
      try ignore(tryPromise(() => transport.acknowledgeSmsNotice({ token })))
    }
  })
}, "message notifications")

const resetDeleteTarget = applying(Messages.Machine, (state) => ({ pane: state.pane, thread: state.thread, front: state.front }), effect () => {
  try (try Inbox).set({ deleteTarget: undefined })
})

/** Messages: resident for the agent, conversation navigation and Home's unread count. It reads only while its view is in front. */
export const messages = together(machine, inbox, conversations, shown, nameNewRecipient, heard, notices, resetDeleteTarget)
