// spec/app/shell/index.md, "Story: Move between Home and the apps"
import { together, whole } from "./runtime/reactor.vibe"
import { shell } from "./shell/shell.vibe"
import { toasts } from "./notices/toasts.vibe"
import { haptics } from "./shell/haptics.vibe"
import { canvas } from "./shell/canvas.vibe"

/**
 * The machines that live from launch to exit: those another area follows or tells, and those that must act while
 * their screen has never been loaded. Every other machine is its area's own (runtime/area.tsx). One line each, in
 * any order: they find each other once all are built. Lines are only ever added.
 */
const machines = together(
  shell,
  toasts,
  haptics,
  canvas,
)

/** The resident machines, closed: each machine one of them follows or tells is among them. */
export const resident = whole(machines)
