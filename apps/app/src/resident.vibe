// spec/app/shell/index.md, "Story: Move between Home and the apps"
import { together, whole } from "./runtime/reactor.vibe"
import { pages } from "./settings/pages.vibe"
import { preferences } from "./settings/preferences.vibe"
import { updating } from "./settings/updates.vibe"
import { shell } from "./shell/shell.vibe"
import { notices } from "./shell/notices.vibe"
import { haptics } from "./shell/haptics.vibe"
import { canvas } from "./shell/canvas.vibe"
import { mailbox } from "./inbox/mailbox.vibe"
import { operations } from "./inbox/operations.vibe"
import { callStrip } from "./phone/call.vibe"
import { comms } from "./phone/comms.vibe"
import { phone } from "./phone/phone.vibe"
import { voicemail } from "./phone/voicemail.vibe"
import { composer } from "./messages/composer.vibe"
import { messages } from "./messages/messages.vibe"
import { contacts } from "./contacts/contacts.vibe"
import { requests } from "./contacts/requests.vibe"

/**
 * The machines that live from launch to exit: those another area follows or tells, and those that must act while
 * their screen has never been loaded. Every other machine is its area's own (runtime/area.tsx). One line each, in
 * any order: they find each other once all are built. Lines are only ever added.
 */
const machines = together(
  shell,
  notices,
  haptics,
  canvas,
  pages,
  preferences,
  updating,
  mailbox,
  operations,
  callStrip,
  phone,
  voicemail,
  messages,
  composer,
  contacts,
  requests,
  comms,
)

/** The resident machines, closed: each machine one of them follows or tells is among them. */
export const resident = whole(machines)
