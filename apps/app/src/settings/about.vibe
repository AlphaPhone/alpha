// spec/app/settings/licences.md, "Story: Read the licences"; spec/app/settings/developer.md, "Story: Read the problem log"
import * as Developer from "../../gen/app__settings__developer.effect.vibe"
import * as Licences from "../../gen/app__settings__licences.effect.vibe"
import * as Prefs from "../../gen/app__settings__preferences.effect.vibe"
import * as Pages from "../../gen/app__settings.effect.vibe"
import { Device, native } from "../platform/device.vibe"
import { type PhoneReport, type Problem, SystemSettings } from "../platform/systemSettings.vibe"
import { VoiceBridge } from "../platform/voice.vibe"
import { type Job, answer, due, following, reacting, run, stop, together, untimed } from "../runtime/reactor.vibe"
import { Time } from "../runtime/time.vibe"

module web {
  /** The licence notices shipped with Alpha, beside its page: never a remote source. */
  export async function shipped(): Promise<unknown> {
    const response = await fetch("licenses/third-party-notices.json")
    if (!response.ok) throw new Error(`the notices answered ${response.status}`)
    return await response.json()
  }
  /** Share `text` as a file through Android's share sheet where there is one, or save it as a file. Whether it was shared or saved. */
  export async function shared(name: string, text: string): Promise<boolean> {
    const file = new File([text], name, { type: "application/json" })
    if (typeof navigator.canShare === "function" && navigator.canShare({ files: [file] })) {
      try {
        await navigator.share({ files: [file], title: "Alpha diagnostics" })
        return true
      } catch {
        return false
      }
    }
    const link = document.createElement("a")
    link.href = URL.createObjectURL(file)
    link.download = name
    link.click()
    URL.revokeObjectURL(link.href)
    return true
  }
}
import { shared, shipped } from web
import { development, versions } from "./build.ts"

/** One licence as the notices file holds it. */
export schema Notice { name: string; version: string; license: string; text: string; source?: string; flags?: ReadonlyArray<string> }

/** The licences loaded, kept beside the machine that counts them: the list the Licences page searches and shows. */
export service Notices {
  get(): ReadonlyArray<Notice>!!
  set(notices: ReadonlyArray<Notice>): void!!
}

const notices = Layer.sync(Notices, () => {
  let held: ReadonlyArray<Notice> = []
  return { get: () => sync(() => held), set: (next: ReadonlyArray<Notice>) => sync(() => { held = next }) }
})

// spec/app/settings/licences.md, "A load ends with the licences it found, or as one that could not load"
effect function loaded(load: number): Licences.Event!!Notices {
  return effect {
    const found = try Schema.decodeUnknownEffect(Schema.Array(Notice))(try tryPromise(shipped))
    try (try Notices).set(found)
    return { type: "loaded", load, ok: true, found: found.length }
  } catch () => ({ type: "loaded", load, ok: false, found: 0 })
}

const licencesMachine = reacting(Licences, {
  carry: (fx): Job<Licences.Event, Notices, []> => answer("load", loaded(fx.load), { type: "giveUpOnLoad", now: untimed }),
  timers: (state) => (state.load.read.status === "Loading" ? [due<Licences.Event, []>("load", state.load.due, { type: "giveUpOnLoad", now: untimed })] : []),
})

// spec/app/settings/licences.md, "Opening the page clears the search, and loads the licences unless they are loading or loaded with some found"
const licencesOpened = following(Pages.Machine, (state) => state.page === "Licences", Licences.Machine, (shown): Licences.Event | undefined => (shown ? { type: "opened", at: untimed } : undefined))

// spec/app/settings/developer.md, "Only the newest read's answer is taken; a log that could not be read, or was not read in time, says unavailable with Retry"
effect function logRead(reading: number): Developer.Event!!(SystemSettings | Prefs.Machine) {
  const problems = try (try SystemSettings).problems()
  const prefs = try (try Prefs.Machine).get()
  const needs: Developer.Store[] = prefs.document.read.status === "Failed" ? ["DevicePreferences"] : []
  return Option.isSome(problems)
    ? { type: "logRead", reading, ok: true, problems: Math.min(problems.value.length, Developer.journalCap), needs }
    : { type: "logRead", reading, ok: false, problems: 0, needs: [] }
}

effect function logCleared(clearing: number): Developer.Event!!SystemSettings {
  return { type: "logCleared", clearing, ok: try (try SystemSettings).clearProblems(), at: untimed }
}

/** The packaged agent files whose digests a report may carry; Alpha's Android host hashes the same list. */
export const runtimeHashAssets = ["agent/alpha-source.json", "agent/inventory.json", "agent/agent.mjs", "agent/workflow-worker/manifest.json", "agent/workflow-worker/files.sha256"] as const

const shapes = {
  version: /^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$/,
  variant: /^(launcher|standalone)$/,
  buildType: /^(debug|release)$/,
  patch: /^\d{4}-\d{2}-\d{2}$/,
  pin: /^[0-9a-f]{40}$/,
  digest: /^[0-9a-f]{64}$/,
  timingFormat: /^[a-z0-9-]{1,64}$/,
}

/** The Talk stages a report keeps, by the name the relay records them under. */
const talkStages = { "stt-connected": "sttConnectedMs", "first-frame-sent": "firstFrameSentMs" } as const

/**
 * Each recent Talk the relay recorded, in order and without its session: the milliseconds from its start to the
 * relay's connection and to the first audio sent, and whether consent was asked again.
 */
function talkOf(answer: unknown) {
  const kept = typeof answer === "object" && answer !== null ? (answer as Record<string, unknown>) : {}
  const rows = Array.isArray(kept.records) ? kept.records : []
  const sessions = new Map<number, { sttConnectedMs: number | null; firstFrameSentMs: number | null; consentRetry: boolean }>()
  for (const row of rows) {
    const one = typeof row === "object" && row !== null ? (row as Record<string, unknown>) : {}
    const { session, stage, elapsedMs } = one
    if (typeof session !== "number" || !Number.isSafeInteger(session) || typeof stage !== "string") continue
    const talk = sessions.get(session) ?? { sttConnectedMs: null, firstFrameSentMs: null, consentRetry: false }
    sessions.set(session, talk)
    if (stage === "consent-retry") talk.consentRetry = true
    const field = Object.hasOwn(talkStages, stage) ? talkStages[stage as keyof typeof talkStages] : undefined
    if (field !== undefined && typeof elapsedMs === "number" && Number.isSafeInteger(elapsedMs) && elapsedMs >= 0 && talk[field] === null) talk[field] = elapsedMs
  }
  const format = typeof kept.format === "string" && shapes.timingFormat.test(kept.format) ? kept.format : null
  return { format, sessions: [...sessions.values()] }
}

/**
 * The support report: only the fields Alpha allows, each of a strict shape, and anything else left out, never
 * scrubbed. What the host says about its build is untrusted; Alpha's own roles say only whether Alpha holds them.
 */
export function reportOf(input: { readonly at: number; readonly native: boolean; readonly facts: unknown; readonly phone: PhoneReport; readonly problems: ReadonlyArray<Problem>; readonly talk: unknown }) {
  const facts: Record<string, unknown> = typeof input.facts === "object" && input.facts !== null ? { ...input.facts } : {}
  const text = (value: unknown, shape: RegExp) => (typeof value === "string" && shape.test(value) ? value : undefined)
  const whole = (value: unknown, below: number) => (typeof value === "number" && Number.isSafeInteger(value) && value > 0 && value < below ? value : undefined)
  const hashes: Record<string, unknown> = typeof facts.runtimeHashes === "object" && facts.runtimeHashes !== null ? { ...facts.runtimeHashes } : {}
  const { app, mode } = versions()
  const version = input.phone.readings.find((reading) => reading.fact === "Versions")?.value
  return {
    format: "alpha-diagnostics/v1",
    generatedAt: new Date(input.at).toISOString(),
    platform: input.native ? "android" : "web",
    app: {
      version: text(version, shapes.version) ?? text(app, shapes.version) ?? null, versionCode: whole(facts.versionCode, 2 ** 31),
      variant: text(facts.variant, shapes.variant), buildType: text(facts.buildType, shapes.buildType), mode, testMocks: development(),
    },
    os: { androidRelease: text(facts.androidRelease, shapes.version), securityPatch: text(facts.securityPatch, shapes.patch), sdkInt: whole(facts.sdkInt, 1000) },
    upstreamPin: text(facts.upstreamPin, shapes.pin) ?? null,
    runtimeHashes: Object.fromEntries(runtimeHashAssets.flatMap((asset) => {
      const hash = text(hashes[asset], shapes.digest)
      return hash === undefined ? [] : [[asset, hash]]
    })),
    permissions: Object.fromEntries(input.phone.grants.flatMap(({ access, grant }) => (grant === "Granted" || grant === "Limited" ? [[access, true]] : grant === "Denied" ? [[access, false]] : []))),
    roles: ([["home", input.phone.home], ["assistant", input.phone.assistant]] as const).map(([role, holder]) => ({ role, held: holder === "Alpha", available: holder !== "NoSuchRole" })),
    problems: { count: input.problems.length, recent: input.problems.slice(-Developer.journalCap) },
    talk: talkOf(input.talk),
  }
}

// spec/app/settings/developer.md, "The report copies only the fields Alpha allows, so no text, address, key or identifier can reach it"
effect function exported(exporting: number): Developer.Event!!(SystemSettings | Device | Time | VoiceBridge) {
  const system = try SystemSettings
  const device = try Device
  const logged = try system.problems()
  const report = reportOf({
    at: try (try Time).now(),
    native: native(),
    facts: Option.getOrUndefined(try device.buildFacts()),
    phone: try system.report(),
    problems: Option.getOrElse(logged, () => []),
    talk: try (try VoiceBridge).streamTimings(),
  })
  const ok = tryPromise(() => shared("alpha-diagnostics.json", JSON.stringify(report, null, 2))) catch () => false
  return { type: "exported", exporting, ok }
}

// spec/app/settings/developer.md, "Saved data that cannot be read is listed, and each such store is handed to its owner to recover"
const recoverPreferences = effect {
  try ignore((try Prefs.Machine).send({ type: "recover", at: untimed }, "Owner"))
}

function carryDeveloper(fx: Developer.Effect): Job<Developer.Event, SystemSettings | Device | Time | VoiceBridge | Prefs.Machine | Developer.Machine, []> {
  return match (fx) {
    when { tag: "ReadLog", let reading }: answer("log", logRead(reading), { type: "giveUpOnLog", now: untimed });
    when { tag: "ClearLog", let clearing }: answer("clear", logCleared(clearing), { type: "giveUpOnClearing", now: untimed });
    when { tag: "ExportDiagnostics", let exporting }: answer("export", exported(exporting), { type: "giveUpOnExport", now: untimed });
    when { tag: "TryMockMode" }: stop("mocks");
    when { tag: "RecoverStore", let store }: store === "DevicePreferences" ? run("recover", recoverPreferences) : stop("recover");
  }
}

function developerTimers(state: Developer.Developer) {
  const waits: ReadonlyArray<[boolean, string, number, Developer.Event]> = [
    [state.log.read.status === "Loading", "log", state.log.due, { type: "giveUpOnLog", now: untimed }],
    [state.clearing.read.status === "Loading", "clear", state.clearing.due, { type: "giveUpOnClearing", now: untimed }],
    [state.exporting.read.status === "Loading", "export", state.exporting.due, { type: "giveUpOnExport", now: untimed }],
  ]
  return waits.flatMap(([busy, key, at, event]) => (busy ? [due<Developer.Event, []>(key, at, event)] : []))
}

const developerMachine = reacting(Developer, { carry: carryDeveloper, timers: developerTimers })

// spec/app/settings/developer.md, "The log is read when the Problem log opens, on Retry, and after it was cleared, one read at a time, with ten seconds to answer"; spec/app/settings/developer.md, "Leaving the Problem log retires its read, and an answer that comes later is never shown"
const logShown = following(Pages.Machine, (state) => state.page === "Problems", Developer.Machine, (shown): Developer.Event => (shown ? { type: "openLog", at: untimed } : { type: "leaveLog" }))

/** About's licences and the Developer page's problem log, which Settings loads when their page opens. */
export const about = together(Layer.provideMerge(licencesMachine, notices), licencesOpened, developerMachine, logShown)
