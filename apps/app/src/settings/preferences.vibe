// spec/settings/preferences.md, "Story: Decide what Alpha may do without asking"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { type Preference, type Preferences as State, Machine, asksBefore, decodeState, loadsMailImages, machine, sensorAllowed, sharesLocation, stored, allowsCalendarEdits, allowsGmailChanges } from "../../gen/settings__preferences.effect.vibe"
import { Build } from "../platform/build.vibe"
import { ownerKey } from "../platform/storage.vibe"

export const PREFERENCES_KEY = ownerKey("device", "settings/preferences")

/** The preferences could not be read, so the switch is locked until the owner resets them. */
export error PreferencesUnreadable

/** What Alpha may do and read; other areas read it here. */
export service Preferences {
  /** The stored preferences and whether they could be read. */
  current(): { readonly value: State; readonly readable: boolean }!!
  /** Whether Alpha asks before a reviewed action: always where the preferences cannot be read. */
  asksBeforeActions(): boolean!!
  /** Whether a chat turn may carry the phone's last known location. */
  sharesLocation(): boolean!!
  loadsMailImages(): boolean!!
  allowsGmailChanges(): boolean!!
  allowsCalendarEdits(): boolean!!
  /** Whether the browser simulator may open its microphone or location. */
  sensorAllowed(microphone: boolean): boolean!!
  set(preference: Preference, on: boolean): void!PreferencesUnreadable
  /** Forget unreadable preferences and return to the defaults, after the owner confirmed. */
  reset(): void!!
}

effect function readable() {
  const store = try KeyValueStore.KeyValueStore
  const raw = try (store.get(PREFERENCES_KEY) catch () => null)
  if (raw === undefined) return true
  if (raw === null) return false
  const value = try (Effect.try(() => JSON.parse(raw) as unknown) catch () => null)
  return value !== null && (try (decodeState(value) catch () => undefined)) !== undefined
}

/** The preferences Machine kept under the owner's key, or in memory while the key cannot be read. */
export const preferences = Layer.unwrap(effect {
  const ok = try readable()
  const kept = ok ? stored(PREFERENCES_KEY) : machine()
  const lock = { open: ok }
  const service = Layer.effect(Preferences, effect {
    const held = try Machine
    const store = try KeyValueStore.KeyValueStore
    const mocks = (try Build).info.testMocks
    const persist = effect () => { try (store.set(PREFERENCES_KEY, JSON.stringify(try held.get())) catch () => undefined) }
    const read = effect () => ({ value: try held.get(), readable: lock.open })
    return {
      current: read,
      asksBeforeActions: effect () => { const { value, readable } = try read(); return asksBefore(value, readable) },
      sharesLocation: effect () => { const { value, readable } = try read(); return sharesLocation(value, readable) },
      loadsMailImages: effect () => { const { value, readable } = try read(); return loadsMailImages(value, readable) },
      allowsGmailChanges: effect () => { const { value, readable } = try read(); return allowsGmailChanges(value, readable) },
      allowsCalendarEdits: effect () => { const { value, readable } = try read(); return allowsCalendarEdits(value, readable) },
      sensorAllowed: effect (microphone: boolean) => { const { value, readable } = try read(); return sensorAllowed(value, readable, mocks, microphone) },
      effect set(preference: Preference, on: boolean) {
        if (!lock.open) throw new PreferencesUnreadable()
        try (held.send({ type: "setPreference", preference, on }) catch () => undefined)
        if (!ok) try persist()
      },
      effect reset() {
        try (store.remove(PREFERENCES_KEY) catch () => undefined)
        lock.open = true
        try (held.send({ type: "resetPreferences" }) catch () => undefined)
        if (!ok) try persist()
      },
    }
  })
  return Layer.provideMerge(service, kept)
})

