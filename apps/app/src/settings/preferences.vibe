// spec/settings/preferences.md, "Story: Decide what Alpha may do without asking"; spec/settings/preferences.md, "A preference an update added starts at its new-phone value, and the owner's saved choices stay"; spec/settings/preferences.md, "A phone updated from the previous Alpha keeps the choices it saved there"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { type Preference, type Preferences as State, Machine, adoptPrevious, asksBefore, decodeState, initial, loadsMailImages, machine, sensorAllowed, sharesBrowserPage, sharesLocation, stored, allowsCalendarEdits, allowsGmailChanges } from "../../gen/settings__preferences.effect.vibe"
import { Build } from "../platform/build.vibe"
import { ownerKey } from "../platform/storage.vibe"
import { previousDeviceChoices } from "./previous.ts"
import { PreviousDeviceChoices } from "./stored.schema.vibe"

export const PREFERENCES_KEY = ownerKey("device", "settings/preferences")

/** The preferences could not be read, so the switch is locked until the owner resets them. */
export error PreferencesUnreadable

/** What Alpha may do and read; other areas read it here. */
export service Preferences {
  /** The stored preferences and whether they could be read. */
  current(): { readonly value: State; readonly readable: boolean }!!
  /** Whether Alpha asks before a reviewed action: always where the preferences cannot be read. */
  asksBeforeActions(): boolean!!
  /** Whether a chat turn may carry the phone's last known location. */
  sharesLocation(): boolean!!
  /** Whether a chat turn sent with Browser on screen may carry the open page; never where the preferences cannot be read. */
  sharesBrowserPage(): boolean!!
  loadsMailImages(): boolean!!
  allowsGmailChanges(): boolean!!
  allowsCalendarEdits(): boolean!!
  /** Whether the browser simulator may open its microphone or location. */
  sensorAllowed(microphone: boolean): boolean!!
  set(preference: Preference, on: boolean): void!PreferencesUnreadable
  /** Forget unreadable preferences and return to the defaults, after the owner confirmed. */
  reset(): void!!
}

/** Take the previous Alpha's saved choices once, when this version keeps none: whether the preferences are readable after. */
effect function adoptPreviousChoices() {
  const store = try KeyValueStore.KeyValueStore
  const raw = (tryPromise(() => previousDeviceChoices()) catch () => null)
  if (raw === undefined) return true
  if (raw === null) return false
  const value = (Effect.try(() => JSON.parse(raw) as unknown) catch () => null)
  if (value === null || typeof value !== "object" || Array.isArray(value)) return false
  const previous = (Schema.decodeUnknownEffect(PreviousDeviceChoices)(value) catch () => undefined)
  if (previous === undefined) return false
  const adopted = adoptPrevious({
    askBeforeActions: previous.askBeforeAgentActions ?? initial.askBeforeActions,
    agentLocation: previous.agentLocationEnabled ?? initial.agentLocation,
    browserPage: previous.agentBrowserPageEnabled ?? initial.browserPage,
    gmailChanges: previous.agentGmailChanges ?? initial.gmailChanges,
    calendarEdits: previous.agentCalendarEdits ?? initial.calendarEdits,
    mailImages: previous.autoLoadMailImages ?? initial.mailImages,
  })
  return (Effect.as(store.set(PREFERENCES_KEY, JSON.stringify(adopted)), true) catch () => false)
}

effect function readable() {
  const store = try KeyValueStore.KeyValueStore
  const raw = (store.get(PREFERENCES_KEY) catch () => null)
  if (raw === undefined) return try adoptPreviousChoices()
  if (raw === null) return false
  const value = (Effect.try(() => JSON.parse(raw) as unknown) catch () => null)
  if (value === null || typeof value !== "object" || Array.isArray(value)) return false
  const filled = { ...initial, ...value }
  if (((decodeState(filled) catch () => undefined)) === undefined) return false
  if (Object.keys(initial).every((key) => Object.hasOwn(value, key))) return true
  return (Effect.as(store.set(PREFERENCES_KEY, JSON.stringify(filled)), true) catch () => false)
}

/** The preferences Machine kept under the owner's key, or in memory while the key cannot be read. */
export const preferences = Layer.unwrap(effect {
  const ok = try readable()
  const kept = ok ? stored(PREFERENCES_KEY) : machine()
  const lock = { open: ok }
  const service = Layer.effect(Preferences, effect {
    const held = try Machine
    const store = try KeyValueStore.KeyValueStore
    const mocks = (try Build).info.testMocks
    const persist = effect () => { (store.set(PREFERENCES_KEY, JSON.stringify(try held.get())) catch () => undefined) }
    const read = effect () => ({ value: try held.get(), readable: lock.open })
    return {
      current: read,
      asksBeforeActions: effect () => { const { value, readable } = try read(); return asksBefore(value, readable) },
      sharesLocation: effect () => { const { value, readable } = try read(); return sharesLocation(value, readable) },
      sharesBrowserPage: effect () => { const { value, readable } = try read(); return sharesBrowserPage(value, readable) },
      loadsMailImages: effect () => { const { value, readable } = try read(); return loadsMailImages(value, readable) },
      allowsGmailChanges: effect () => { const { value, readable } = try read(); return allowsGmailChanges(value, readable) },
      allowsCalendarEdits: effect () => { const { value, readable } = try read(); return allowsCalendarEdits(value, readable) },
      sensorAllowed: effect (microphone: boolean) => { const { value, readable } = try read(); return sensorAllowed(value, readable, mocks, microphone) },
      effect set(preference: Preference, on: boolean) {
        if (!lock.open) throw new PreferencesUnreadable()
        held.send({ type: "setPreference", preference, on }) catch () => undefined
        if (!ok) try persist()
      },
      effect reset() {
        store.remove(PREFERENCES_KEY) catch () => undefined
        lock.open = true
        held.send({ type: "resetPreferences" }) catch () => undefined
        if (!ok) try persist()
      },
    }
  })
  return Layer.provideMerge(service, kept)
})

