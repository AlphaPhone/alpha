// spec/app/settings/updates.md, "Story: Update Alpha when I choose"; spec/app/settings/updates.md, "Story: Get updates hands-off"; spec/app/settings/updates.md, "Story: Let Android finish an update without losing what I typed"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { Machine as Shell } from "../../gen/app__shell.effect.vibe"
import * as Updates from "../../gen/app__settings__updates.effect.vibe"
import type { Effect as Out, Event } from "../../gen/app__settings__updates.effect.vibe"
import { Device } from "../platform/device.vibe"
import { type Installed, LauncherUpdates, type Release } from "../platform/launcherUpdates.vibe"
import { type Job, answer, due, hearing, reacting, run, started, together, untimed } from "../runtime/reactor.vibe"
import { Time } from "../runtime/time.vibe"

const hex64 = /^[0-9a-f]{64}$/
const key = "alpha.app-update"

schema Row {
  schema: "alpha-update/v1"
  versionCode: number
  versionName?: string
  variant: string
  signerSha256: string
  apkUrl: string
  sha256: string
  sizeBytes: number
}
schema Index { schema: "alpha-update/index-v1"; releases: ReadonlyArray<Row> }
schema Saved { checkedAt: number; feed?: string; digest?: string }

/** The release a feed offers this install, with its version name. */
interface Offer extends Release {
  readonly versionName: string
}

module pure {
  /** @throws {never} */
  export function parsedFeed(text: string): unknown {
    try { return JSON.parse(text) as unknown } catch { return undefined }
  }
  /** @throws {never} */
  export function https(url: string): boolean {
    const parsed = URL.canParse(url) ? new URL(url) : undefined
    return parsed !== undefined && parsed.protocol === "https:" && parsed.username === "" && parsed.password === ""
  }
}
import { https, parsedFeed } from pure

function rows(text: string | undefined): ReadonlyArray<typeof Row.Type> {
  if (text === undefined) return []
  const value = parsedFeed(text)
  const index = Schema.decodeUnknownOption(Index)(value)
  if (Option.isSome(index)) {
    const { releases } = index.value
    const pairs = new Set(releases.map((row) => `${row.variant}:${row.signerSha256}`))
    return releases.length >= 1 && releases.length <= 16 && pairs.size === releases.length ? releases : []
  }
  return Option.match(Schema.decodeUnknownOption(Row)(value), { onNone: () => [], onSome: (row) => [row] })
}

// spec/app/settings/updates.md, "An offer is for this launcher and its signer, newer than the installed version, complete and over HTTPS"
function offerFor(text: string | undefined, installed: Installed): Offer | undefined {
  const row = rows(text).find((one) => one.variant === "launcher" && one.signerSha256 === installed.signer)
  if (row === undefined) return undefined
  const admitted = Updates.admitOffer({
    launcher: installed.launcher, signerMatches: hex64.test(row.signerSha256), versionCode: Number.isSafeInteger(row.versionCode) ? row.versionCode : 0,
    installed: installed.versionCode, https: https(row.apkUrl), digest: hex64.test(row.sha256), sizeBytes: Number.isSafeInteger(row.sizeBytes) ? row.sizeBytes : 0, urlChars: row.apkUrl.length,
  })
  if (!admitted) return undefined
  const named = typeof row.versionName === "string" && /^[^\u0000-\u001f\u007f]{1,64}$/.test(row.versionName) ? row.versionName : ""
  return { apkUrl: row.apkUrl, sha256: row.sha256, sizeBytes: row.sizeBytes, versionCode: row.versionCode, versionName: named }
}

const unknown: Installed = { versionCode: Number.MAX_SAFE_INTEGER, signer: "", launcher: false, permission: "PermissionUnread" }

effect function saved(): typeof Saved.Type!!KeyValueStore.KeyValueStore {
  const text = (try KeyValueStore.KeyValueStore).get(key) catch () => undefined
  return text === undefined ? { checkedAt: -1 } : Option.getOrElse(Schema.decodeUnknownOption(Schema.fromJsonString(Saved))(text), () => ({ checkedAt: -1 }))
}

effect function keep(next: typeof Saved.Type): void!!KeyValueStore.KeyValueStore {
  try ignore((try KeyValueStore.KeyValueStore).set(key, JSON.stringify(next)))
}

effect function installed(): Installed!!LauncherUpdates {
  return Option.getOrElse(try (try LauncherUpdates).installed(), () => unknown)
}

// spec/app/settings/updates.md, "Alpha starts with the version it runs and the time of the last check the phone kept"
const starting = effect {
  const mine = try installed()
  const start: Event = { type: "start", installed: Math.min(mine.versionCode, Number.MAX_SAFE_INTEGER), checkedAt: (try saved()).checkedAt }
  return [start] as const
}

// spec/app/settings/updates.md, "Only the newest check's answer is taken: the release offered, whether it is bound to the bytes it reviewed, and when"
effect function checked(check: number): Event!!(LauncherUpdates | KeyValueStore.KeyValueStore | Time) {
  const now = try (try Time).now()
  const reply = try (try LauncherUpdates).check()
  if (Option.isNone(reply) || (reply.value.feed !== undefined && rows(reply.value.feed).length === 0)) return { type: "checkFailed", check, now: untimed }
  const digest = reply.value.digest !== undefined && hex64.test(reply.value.digest) ? reply.value.digest : undefined
  try keep({ checkedAt: now, ...(reply.value.feed === undefined ? {} : { feed: reply.value.feed }), ...(digest === undefined ? {} : { digest }) })
  const offer = offerFor(reply.value.feed, try installed())
  return { type: "checkAnswered", check, offer: offer?.versionCode ?? 0, offerName: offer?.versionName ?? "", bound: digest !== undefined, now: untimed }
}

// spec/app/settings/updates.md, "Android's answer ends the install: started, the offer gone or changed, Android still starting, or the owner's permission needed"
effect function installed_(install: number): Event!!(LauncherUpdates | KeyValueStore.KeyValueStore | Updates.Machine) {
  const { automatic } = try (try Updates.Machine).get()
  const feed = try saved()
  const offer = offerFor(feed.feed, try installed())
  if (offer === undefined) return { type: "installAnswered", install, answer: "OfferUnavailable", now: untimed }
  const answered = try (try LauncherUpdates).install(offer, automatic && feed.digest !== undefined ? Option.some(feed.digest) : Option.none())
  if (answered === "OfferWithdrawn") try keep({ checkedAt: -1 })
  return { type: "installAnswered", install, answer: answered, now: untimed }
}

// spec/app/settings/updates.md, "Android's activation is acknowledged once, after the page has kept its drafts, and as not ready when it could not keep them or the phone is no longer idle enough"
effect function acknowledged(ready: boolean): void!!LauncherUpdates {
  const updates = try LauncherUpdates
  const { ids } = try updates.activation()
  if (Option.isSome(ids)) try updates.acknowledge(ids.value, ready)
}

const continued = effect {
  const updates = try LauncherUpdates
  const { ids } = try updates.activation()
  if (Option.isSome(ids)) try updates.continueInstall(ids.value)
}

function carry(fx: Out): Job<Event, LauncherUpdates | KeyValueStore.KeyValueStore | Time | Updates.Machine, []> {
  return match (fx) {
    when { tag: "CheckFeed", let check }: answer("check", checked(check), { type: "giveUpOnCheck", now: untimed });
    when { tag: "InstallOffer", let install }: answer("install", installed_(install), { type: "giveUpOnInstall", now: untimed });
    when { tag: "Acknowledge", let ready }: run("acknowledge", acknowledged(ready));
    when { tag: "ContinueInstall" }: run("continue", continued);
  }
}

// spec/app/settings/updates.md, "Every check and every install ends, so Settings never waits on one for ever"
function timers(state: Updates.Updates) {
  const waits: ReadonlyArray<[boolean, string, number, Event]> = [
    [state.checking.read.status === "Loading", "check", state.checking.due, { type: "giveUpOnCheck", now: untimed }],
    [state.installing.read.status === "Loading", "install", state.installing.due, { type: "giveUpOnInstall", now: untimed }],
  ]
  return waits.flatMap(([busy, at, when, event]) => (busy ? [due<Event, []>(at, when, event)] : []))
}

const machine = reacting(Updates, { open: starting, carry, timers })

/** Whether the phone is at rest on Home, as far as the shell knows it. */
const idleOf = (shell: { readonly trail: ReadonlyArray<unknown>; readonly drawer: boolean; readonly assistant: string }) => shell.trail.length === 0 && !shell.drawer && shell.assistant === "Bar"

// spec/app/settings/updates.md, "When the schedule wakes, a due check runs first; then an offer bound to its bytes is installed hands-off if the phone is idle, Android allows it and nothing is pending"
const schedule = started(effect {
  const updates = try Updates.Machine
  const time = try Time
  const shell = try Shell
  try ignore(updates.send({ type: "setActive", active: true }))
  for (;;) {
    const state = try updates.get()
    if (state.active && Updates.quiet(state)) {
      try time.until(state.wakeAt)
      try ignore(updates.send({ type: "wake", now: untimed, idle: idleOf(try shell.get()) }))
    }
    try Stream.runHead(Stream.drop(updates.changes, 1))
  }
}, "the update schedule")

// spec/app/settings/updates.md, "The schedule runs while Alpha is in front"
const active = hearing(Stream.unwrap(effect { return (try Device).visible }), Updates.Machine, (visible): Event => ({ type: "setActive", active: visible }))

// spec/app/settings/updates.md, "Android's activation is read when Android says it is ready or settled, when Alpha starts, and every second while Android holds one"
const activationFollowed = started(effect {
  const updates = try Updates.Machine
  const device = try LauncherUpdates
  const time = try Time
  const shell = try Shell
  for (;;) {
    const read = try device.activation()
    try ignore(updates.send({ type: "activationRead", activation: read.activation, canContinue: read.canContinue }))
    const state = try updates.get()
    if (state.activation === "Preparing" && !state.acknowledged) try ignore(updates.send({ type: "acknowledge", ready: !state.automatic || idleOf(try shell.get()) }))
    if (Updates.follows(state)) try time.until((try time.now()) + 1000)
    else try Stream.runHead(Stream.drop(updates.changes, 1))
  }
}, "following the update activation")

// spec/app/settings/updates.md, "Android reports whether automatic installs are allowed, and Allow opens Android's page for it"
const permission = started(effect {
  const updates = try Updates.Machine
  const mine = try installed()
  try ignore(updates.send({ type: "permissionRead", permission: mine.permission }))
}, "reading the update permission")

/** Alpha's launcher updates, from launch: the schedule runs whether or not Settings was ever opened. */
export const updating = together(machine, schedule, active, activationFollowed, permission)
