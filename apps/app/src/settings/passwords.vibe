// spec/settings/passwords.md, "Story: Use my saved passwords only after Android unlocks them"; spec/settings/passwords.md, "Android's Back cancels a pending confirmation first, then closes the entry shown"; spec/settings/passwords.md, "Story: Delete or reset only on purpose"; spec/settings/passwords.md, "Story: Fill passwords with Alpha, and back them up natively"
import { passwordsError, secretFieldIn } from "@elizaos/os/bridges/passwords"
import { Listed, PasswordsStatus } from "@elizaos/os/bridges/passwords.schema"
import { type Answer, type Autofill, type Entry, type Phase, type Task, Machine, backTaken, canCancelConfirm } from "../../gen/settings__passwords.effect.vibe"
import { Native } from "../platform/native.vibe"
import { attempt, call } from "./call.vibe"
import { AutofillOpened, BackupReadiness, EditorReply, LoginFill } from "./native.schema.vibe"

const VAULT = "ElizaPasswords"
const METHOD: Partial<Record<Task, string>> = {
  Unlocking: "unlock", Locking: "lock", Removing: "remove", Revealing: "reveal", Copying: "copy",
  Resetting: "reset", OpeningAutofill: "openAutofillSettings", ApprovingBackup: "approveSharedBackup",
}

/** The vault page: metadata while unlocked, every secret kept in Android's own screens. */
export service Vault {
  /** Open the page: a new visit, which reads the vault's status. */
  open(): void!!
  /** Leave the page or go to the background: lock the vault and forget the visit. */
  leave(): void!!
  /** Run one vault task on the entry `id` where it needs one. */
  run(task: Task, id: string): void!!
  /** The vault's own editor, for a new entry or the selected revision of one. */
  edit(id: string): void!!
  /** Android's Back on the vault: a pending confirmation is cancelled, then an open entry closes; false on the list, where Back leaves. */
  back(): boolean!!
}

function phaseOf(status: typeof PasswordsStatus.Type): Phase {
  if (!status.available) {
    const reason = status.reason
    return { tag: "VaultUnavailable", reason: reason === "no-screen-lock" ? "NoScreenLock" : reason === "not-admitted" ? "NotAdmitted" : reason === "device-locked" ? "DeviceLocked"
      : reason === "legacy-authorization-required" ? "LegacyAuthorization" : reason === "legacy-key-unavailable" ? "LegacyKey" : "Unsupported" }
  }
  return status.locked ? { tag: "Locked" } : { tag: "Unlocked" }
}

function autofillOf(status: typeof PasswordsStatus.Type): Autofill {
  if (status.autofill.supported === false) return "AutofillUnsupported"
  const selected = status.autofill.selected
  return selected === "this-app" ? "AutofillThisApp" : selected === "other" ? "AutofillOther" : selected === "none" ? "AutofillNone" : "AutofillUnread"
}

function answerOf(error: unknown): Answer {
  const code = passwordsError(error).code
  return code === "locked" ? "WasLocked" : code === "key-invalidated" ? "KeyInvalidated" : code === "conflict" ? "Conflicted" : "Refused"
}

/** Vault over the vault Machine it is given. */
export const vault = Layer.effect(Vault, effect {
  const held = try Machine
  const native = try Native
  const within = <A, E>(program: A!E!Native) => Effect.provideService(program, Native, native)

  effect function list(visit: number) {
    const raw = try attempt(native.invoke(VAULT, "list"))
    if (raw === undefined || secretFieldIn(raw)) return
    const listed = Option.getOrUndefined(Schema.decodeUnknownOption(Listed)(raw))
    if (listed === undefined) return
    const entries: Entry[] = listed.entries.map((e) => ({ id: e.id, label: e.label, username: e.username, sites: e.bindings.map((b) => b.display), revision: e.revision }))
    try (held.send({ type: "listed", visit, entries }) catch () => undefined)
  }

  effect function status(visit: number) {
    if (!(try native.available(VAULT))) {
      try (held.send({ type: "statusRead", visit, phase: { tag: "VaultUnavailable", reason: "BridgeMissing" }, autofill: "AutofillUnread", browserFill: false, backupReady: false }) catch () => undefined)
      return
    }
    const raw = try attempt(native.invoke(VAULT, "status"))
    const read = raw === undefined || secretFieldIn(raw) ? undefined : Option.getOrUndefined(Schema.decodeUnknownOption(PasswordsStatus)(raw))
    const fill = try attempt(call("AlphaBrowser", "loginFillStatus", LoginFill))
    const backup = try attempt(call(VAULT, "sharedBackupReadiness", BackupReadiness))
    if (read === undefined) {
      try (held.send({ type: "statusRead", visit, phase: { tag: "VaultUnavailable", reason: "Unsupported" }, autofill: "AutofillUnread", browserFill: false, backupReady: false }) catch () => undefined)
      return
    }
    const phase = phaseOf(read)
    try (held.send({ type: "statusRead", visit, phase: phase.tag === "Unlocked" ? { tag: "Locked" } : phase, autofill: autofillOf(read), browserFill: fill?.available === true, backupReady: backup?.ready === true }) catch () => undefined)
    if (phase.tag === "Unlocked") try list(visit)
  }

  return {
    open: () => within(effect {
      const opened = try (held.send({ type: "openPage" }) catch () => undefined)
      if (opened !== undefined) try status(opened.visit)
    }),
    leave: () => within(effect {
      try (held.send({ type: "leavePage" }) catch () => undefined)
      try attempt(native.invoke(VAULT, "lock"))
    }),
    run: (task: Task, id: string) => within(effect {
      const before = try held.get()
      const entry = before.entries.find((e) => e.id === id)
      const begun = try (held.send({ type: "beginTask", task, id }) catch () => undefined)
      const method = METHOD[task]
      if (begun === undefined || method === undefined) return
      const args = entry === undefined ? undefined : { id, expectedRevision: entry.revision }
      const answer = try (effect {
        if (task === "OpeningAutofill") { try call(VAULT, method, AutofillOpened); return "Done" as Answer }
        const raw = try native.invoke(VAULT, method, args)
        return secretFieldIn(raw) ? "Refused" as Answer : "Done" as Answer
      } catch (error) => answerOf(typeof error === "object" && error !== null && "message" in error ? error : undefined))
      try (held.send({ type: "taskAnswered", visit: begun.visit, answer }) catch () => undefined)
      if (task === "Unlocking" && answer === "Done") try list(begun.visit)
      if (task === "Removing" && answer === "Done") try list(begun.visit)
    }),
    edit: (id: string) => within(effect {
      const before = try held.get()
      const entry = before.entries.find((e) => e.id === id)
      const begun = try (held.send({ type: "beginTask", task: "Editing", id }) catch () => undefined)
      if (begun === undefined) return
      const reply = try (call(VAULT, "openEditor", EditorReply, entry === undefined ? undefined : { entryId: entry.id, expectedRevision: entry.revision }) catch () => undefined)
      try (held.send({ type: "taskAnswered", visit: begun.visit, answer: reply === undefined ? "Refused" : "Done" }) catch () => undefined)
      if (reply?.status === "saved") try list(begun.visit)
    }),
    effect back() {
      const before = try held.get()
      if (!backTaken(before)) return false
      const taken = try (held.send(canCancelConfirm(before) ? { type: "cancelConfirm" } : { type: "closeEntry" }) catch () => undefined)
      return taken !== undefined
    },
  }
})
