// spec/app/settings/facts.md, "Story: Manage my saved passwords"
import * as Facts from "../../gen/app__settings__facts.effect.vibe"
import * as Pages from "../../gen/app__settings.effect.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import * as Layers from "../../gen/app__shell__layers.effect.vibe"
import type { PasswordsClient } from "@elizaos/os-bridges"
import { Device } from "../platform/device.vibe"
import { type PasswordProvider, type PasswordProviderAction, SystemSettings } from "../platform/systemSettings.vibe"
import { answer, due, hearing, untimed } from "../runtime/reactor.vibe"
import { Time } from "../runtime/time.vibe"

export service VaultTurn {
  readonly one: Semaphore.Semaphore
  readonly unlock: (open: PasswordsClient["unlock"]) => ReturnType<PasswordsClient["unlock"]>
  retire(): boolean!!
}

export const vaultTurn = Layer.effect(VaultTurn, effect {
  const one = try Semaphore.make(1)
  let claimed = false
  return {
    one,
    unlock: (open) => {
      claimed = true
      return open().then((lease) => { claimed = true; return lease })
    },
    retire: () => sync(() => {
      const wasClaimed = claimed
      claimed = false
      return wasClaimed
    }),
  }
})

type Front = Shell.Machine | Pages.Machine | Layers.Machine | Device
type PasswordWork = Front | Facts.Machine | SystemSettings | VaultTurn | Time

function onPage(shell: Shell.Shell, pages: Pages.Settings, layers: Layers.Layers): boolean {
  return Shell.showing(shell, "Settings") && shell.assistant !== "Full" && shell.assistant !== "Sheet" && pages.phone && Pages.passwordPage(pages.page) && !Layers.pageInert(layers)
}

const looking = effect {
  const shell = try Shell.Machine
  const pages = try Pages.Machine
  const layers = try Layers.Machine
  const device = try Device
  const view = Stream.zipLatest(Stream.zipLatest(shell.changes, pages.changes), layers.changes)
  const visible = Stream.concat(Stream.fromEffect(device.showing()), device.visible)
  const active = Stream.map(view, ([[place, page], covers]) => onPage(place, page, covers))
  return Stream.changesWith(Stream.map(Stream.zipLatest(active, visible), ([here, shown]) => ({ here, front: here && shown })),
    (before, after) => before.here === after.here && before.front === after.front)
}

export const vaultPresence = hearing(Stream.unwrap(looking), Facts.Machine,
  ({ here, front }): Facts.Event => ({ type: "vaultPresence", here, front }))

export effect function passwordPageVisible(): boolean!!Front {
  const [shell, pages, layers, visible] = try.all [
    (try Shell.Machine).get(), (try Pages.Machine).get(), (try Layers.Machine).get(),
    (try Device).showing(),
  ]
  return visible && onPage(shell, pages, layers)
}

export effect function readPasswordProvider(): (PasswordProvider | undefined)!!(Front | SystemSettings) {
  if (!(try passwordPageVisible())) return undefined
  const reported = try (try SystemSettings).passwordProvider()
  return (try passwordPageVisible()) ? Option.getOrUndefined(reported) : undefined
}

export effect function handPasswordProvider(action: PasswordProviderAction): boolean!!(Front | SystemSettings) {
  if (!(try passwordPageVisible())) return false
  return try (try SystemSettings).openPasswordProvider(action)
}

effect function current(request: number): boolean!!(Front | Facts.Machine) {
  const [visible, facts] = try.all [passwordPageVisible(), (try Facts.Machine).get()]
  return visible && facts.vault.front && facts.vault.request === request
}

effect function afterPrompt(request: number): boolean!!(Front | Facts.Machine) {
  if (try current(request)) return true
  const machine = try Facts.Machine
  const presence = try looking
  const ready = Stream.filter(Stream.zipLatest(presence, machine.changes), ([page, state]) =>
    !page.here || state.vault.request !== request || (page.front && state.vault.front))
  try Stream.runHead(ready)
  return try current(request)
}

type VaultAnswer = Extract<Facts.Event, { type: "vaultAnswered" }>

const closed: Facts.VaultResult = { tag: "VaultSecured" }
const unavailable: Facts.VaultResult = { tag: "VaultNotAvailable" }

function reply(request: number, result: Facts.VaultResult, notice: Facts.VaultNotice = "VaultQuiet"): VaultAnswer {
  return { type: "vaultAnswered", request, result, notice, now: untimed }
}

effect function reading(request: number, afterUnlock: boolean, notice: Facts.VaultNotice): VaultAnswer!!PasswordWork {
  const client = (try SystemSettings).passwordVault()
  if (client === undefined || !(try current(request))) return reply(request, unavailable)
  return effect {
    const time = try Time
    const before = try time.now()
    const status = try timeout(tryPromise(() => client.status()), "10 seconds")
    if (!status.available) return reply(request, status.reason === "no-screen-lock" ? { tag: "VaultUnsecured" } : unavailable, notice)
    if (!afterUnlock || status.custody !== undefined || status.locked || status.unlockRemainingMs === null || status.unlockRemainingMs <= 0)
      return reply(request, closed, notice)
    const until = before + Math.floor(status.unlockRemainingMs)
    if (!(try current(request))) return reply(request, closed)
    const rows = try timeout(tryPromise(() => client.list()), "10 seconds")
    if (!(try current(request)) || (try time.now()) >= until) return reply(request, closed)
    if (rows.some(({ id, revision }) => id === "" || !Number.isSafeInteger(revision) || revision < 0)) return reply(request, closed, "VaultFailed")
    return reply(request, { tag: "VaultList", rows: rows.map(({ id, revision, label, username, bindings }) => ({
      id, revision, label, username, terms: bindings.flatMap(({ display, facet }) => [display, facet]),
    })), until }, notice)
  } catch () => reply(request, afterUnlock ? closed : unavailable, "VaultFailed")
}

effect function lockClaim(client: Pick<PasswordsClient, "lock">): boolean!!VaultTurn {
  return effect {
    if (try (try VaultTurn).retire()) try tryPromise(() => client.lock())
    return true
  } catch () => false
}

effect function workVault(request: number, work: Facts.VaultWork): VaultAnswer!!PasswordWork {
  const client = (try SystemSettings).passwordVault()
  if (client === undefined) return reply(request, unavailable)
  const turn = try VaultTurn
  if (work.tag === "LockVault") {
    const { vault } = try (try Facts.Machine).get()
    if (vault.request !== request || vault.phase !== "VaultLocking") return reply(request, closed)
    const retired = try lockClaim(client)
    return try Semaphore.withPermit(turn.one, effect {
      const drained = try lockClaim(client)
      return reply(request, retired && drained ? closed : unavailable)
    })
  }
  return try Semaphore.withPermit(turn.one, effect {
    if (!(try current(request))) return reply(request, closed)
    if (work.tag === "CheckVault") return try reading(request, false, "VaultQuiet")
    let notice: Facts.VaultNotice = "VaultQuiet"
    if (work.tag === "UnlockVault") {
      const opened = tryPromise(() => turn.unlock(client.unlock)) catch () => undefined
      if (!(try afterPrompt(request))) return reply(request, closed)
      if (opened === undefined) return (try lockClaim(client)) ? try reading(request, false, "VaultQuiet") : reply(request, unavailable)
    } else if (work.tag === "PasswordRowAction") {
      const { id, revision, choice } = work
      const result = effect {
        if (choice === "CopyPassword") {
          try tryPromise(() => client.copy(id, revision))
          return "VaultCopied" as const
        }
        if (choice === "RevealPassword") {
          try tryPromise(() => client.reveal(id, revision))
          return "VaultQuiet" as const
        }
        try tryPromise(() => client.remove(id, revision))
        return "VaultRemoved" as const
      } catch () => "VaultFailed" as const
      notice = result
    } else {
      const edited = tryPromise(() => client.openEditor(work.tag === "CreatePassword" ? undefined : { entryId: work.id, expectedRevision: work.revision }))
        catch () => undefined
      notice = edited === undefined ? "VaultFailed" : edited.status === "saved" ? "VaultChanged" : "VaultQuiet"
    }
    const read = try reading(request, true, notice)
    if (work.tag === "UnlockVault" && !(try afterPrompt(request))) return reply(request, closed)
    if (!(try current(request))) return reply(request, closed)
    if (read.result.tag !== "VaultList" || read.result.until <= (try (try Time).now())) {
      const locked = try lockClaim(client)
      if (!locked) return reply(request, unavailable, notice)
      return read.result.tag === "VaultList" ? reply(request, closed, notice) : read
    }
    return read
  })
}

export function vaultWork(request: number, work: Facts.VaultWork) {
  return answer("vault " + request, workVault(request, work), reply(request, closed))
}

export function vaultTimers(state: Facts.Facts) {
  return state.vault.phase === "VaultReady" ? [due<Facts.Event, []>("vault expiry", state.vault.until, { type: "vaultExpire", now: untimed })] : []
}
