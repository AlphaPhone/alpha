// spec/app/voice/listener.md, "Story: See and control the listener"
import type { ListenerState, ListenerStatus } from "@elizaos/os-bridges"
import * as Listener from "../../gen/app__voice__listener.effect.vibe"
import * as Pages from "../../gen/app__settings.effect.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import * as Layers from "../../gen/app__shell__layers.effect.vibe"
import { ImageListener, imageListener } from "../platform/listener.vibe"
import { Device } from "../platform/device.vibe"
import { type Job, answer, contained, reacting, started, stop, together } from "../runtime/reactor.vibe"

const reasons: Readonly<Record<ListenerState, string>> = {
  OFF: "Off",
  PERMISSION_REQUIRED: "Needs microphone permission",
  NOTIFICATIONS_REQUIRED: "Needs its notification to be allowed",
  STOPPED_AFTER_ERRORS: "Stopped after repeated errors",
  STOPPED_INDICATOR_LOST: "Stopped because the microphone indicator wasn’t shown",
  PAUSED_OTHER_USER: "Paused while another user is active",
  WAITING_FOR_UNLOCK: "Starts after you unlock the phone",
  SPEECH_UNAVAILABLE: "Unavailable until on-device speech is ready",
  INDICATOR_UNAVAILABLE: "Waiting for the microphone indicator",
  PAUSED_USER: "Paused",
  PAUSED_CALL: "Paused during a call",
  PAUSED_MIC_IN_USE: "Paused while another app uses the microphone",
  PAUSED_MIC_UNAVAILABLE: "Paused because the microphone is unavailable",
  PAUSED_DISPLAY_OFF: "Paused while the screen is off without Always-on display",
  PAUSED_FULLSCREEN: "Paused while an app is full screen",
  PAUSED_SHADE: "Paused while notifications are open",
  PAUSED_TRANSITION: "Paused while the screen changes",
  LISTENING: "Listening",
}

function readback(ticket: number, status: ListenerStatus): Listener.Event {
  if (!status.available) return { type: "failed", ticket }
  const mic = status.microphoneOpen || status.listening
  if (status.state === "LISTENING" && !mic) return { type: "failed", ticket }
  return { type: "answered", ticket, report: {
    on: mic || (status.consented && status.state !== "OFF"),
    mic,
    consent: status.consented,
    fresh: status.listening && status.microphoneOpen,
    lost: status.state === "STOPPED_INDICATOR_LOST",
    paused: status.state.startsWith("PAUSED_") && !mic,
    reason: reasons[status.state],
  } }
}

const onPrivacy = (shell: Parameters<typeof Shell.showing>[0], pages: Pages.Settings): boolean =>
  Shell.showing(shell, "Settings") && shell.assistant !== "Full" && pages.page === "Privacy"

const inFront = effect {
  const shell = try (try Shell.Machine).get()
  const pages = try (try Pages.Machine).get()
  return onPrivacy(shell, pages) && !Layers.pageInert(try (try Layers.Machine).get()) && (try (try Device).showing())
}

type Ports = ImageListener | Listener.Machine | Pages.Machine | Shell.Machine | Layers.Machine | Device

effect function read(ticket: number): Listener.Event!!Ports {
  const listener = try ImageListener
  const current = try (try Listener.Machine).get()
  if (!(try inFront) || !Listener.canFailed(current, ticket) || current.acting !== "NoAct") return { type: "failed", ticket }
  const status = try listener.status()
  return (try inFront) ? readback(ticket, status) : { type: "failed", ticket }
}

effect function settle(ticket: number, action: "pause" | "turnOff"): Listener.Event!!Ports {
  const listener = try ImageListener
  const current = try (try Listener.Machine).get()
  const acting = action === "pause" ? "Pausing" : "TurningOff"
  if (!(try inFront) || !Listener.canFailed(current, ticket) || current.acting !== acting) return { type: "failed", ticket }
  return readback(ticket, try listener.stop(action))
}

effect function openConsent(opening: number): Listener.Event!!Ports {
  const listener = try ImageListener
  const current = try (try Listener.Machine).get()
  const opened = Listener.canConsentAnswer(current, opening, true) && (try inFront) && (try listener.openSettings())
  return { type: "consentAnswer", opening, opened }
}

function carry(fx: Listener.Effect): Job<Listener.Event, Ports, []> {
  return match (fx) {
    when { tag: "ReadStatus", let ticket }: answer("listener status", read(ticket), { type: "failed", ticket });
    when { tag: "Pause", let pausing }: answer("listener stop", settle(pausing, "pause"), { type: "failed", ticket: pausing });
    when { tag: "TurnOff", let stopping }: answer("listener stop", settle(stopping, "turnOff"), { type: "failed", ticket: stopping });
    when { tag: "OpenConsent", let opening }: answer("listener consent screen", openConsent(opening), { type: "consentAnswer", opening, opened: false });
    when { tag: "StartVoice" }: stop("external voice invocation");
  }
}

const visiting = started(effect {
  if (!(try ImageListener).present) return
  const device = try Device
  const model = try Listener.Machine
  try contained(model.send({ type: "admit", image: true }), "admit the image listener")
  const shell = try Shell.Machine
  const pages = try Pages.Machine
  const layers = try Layers.Machine
  const locations = Stream.zipLatest(shell.changes, pages.changes)
  const privacy = Stream.map(Stream.zipLatest(locations, layers.changes), ([[shell, pages], layers]) => onPrivacy(shell, pages) && !Layers.pageInert(layers))
  const visible = Stream.concat(Stream.fromEffect(device.showing()), device.visible)
  const foreground = Stream.changes(Stream.map(Stream.zipLatest(privacy, visible), ([privacy, visible]) => privacy && visible))
  try Stream.runForEach(foreground, effect (shown) => {
    const current = try model.get()
    if (shown && Listener.canRefresh(current)) try contained(model.send({ type: "refresh" }), "read the image listener")
    if (!shown && Listener.canLeave(current)) try contained(model.send({ type: "leave" }), "leave image listener settings")
  })
}, "listener settings visit")

/** Listening controls for one Settings runtime, including the warning after a stop finishes away from Privacy. */
export const listenerControls = Layer.provideMerge(together(reacting(Listener, { carry }), visiting), imageListener)
