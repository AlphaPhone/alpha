// spec/app/settings/network.md, "Story: Join a nearby network"; spec/app/settings/carrier.md, "Story: Read what my carrier needs to activate a SIM"; spec/app/settings/passwords.md, "Story: Use my saved passwords only after Android unlocks them"
import * as Carrier from "../../gen/app__settings__carrier.effect.vibe"
import * as Network from "../../gen/app__settings__network.effect.vibe"
import * as Vault from "../../gen/app__settings__passwords.effect.vibe"
import * as Pages from "../../gen/app__settings.effect.vibe"
import { CarrierSetup } from "../platform/carrier.vibe"
import { Device } from "../platform/device.vibe"
import { Passwords } from "../platform/passwords.vibe"
import { type Nearby, WiFi } from "../platform/wifi.vibe"
import { type Due, type Job, answer, due, following, hearing, reacting, run, together, untimed } from "../runtime/reactor.vibe"

/** The networks the last scan found, kept beside the machine that counts them: the rows of the Network page. */
export service Found {
  get(): ReadonlyArray<Nearby>!!
  set(networks: ReadonlyArray<Nearby>): void!!
}

const found = Layer.sync(Found, () => {
  let held: ReadonlyArray<Nearby> = []
  return { get: () => sync(() => held), set: (next: ReadonlyArray<Nearby>) => sync(() => { held = next }) }
})

// spec/app/settings/network.md, "Only the newest scan's answer is taken: the networks it found, or why it could not scan"
effect function scanned(scan: number): Network.Event!!(WiFi | Found) {
  const { scan: result, networks } = try (try WiFi).scan()
  try (try Found).set(networks)
  return { type: "scanned", scan, result, found: result === "Found" ? networks.length : 0 }
}

// spec/app/settings/network.md, "Only Android's answer to the newest join settles it, and the phone is then read again; a wrong password is said only of a join that had one"
effect function joined(join: number, name: string, security: Network.Security, passphrase: string): Network.Event!!WiFi {
  return { type: "joinAnswered", join, joined: try (try WiFi).join(name, security, Redacted.make(passphrase)), at: untimed }
}

// spec/app/settings/network.md, "Only the newest read is taken: Android's own flags for the active network, or unknown when it could not say"
effect function connectivity(reading: number): Network.Event!!WiFi {
  const read = try (try WiFi).connectivity()
  return Option.isSome(read)
    ? { type: "connectivityRead", reading, answered: true, online: read.value.online, validated: read.value.validated, portal: read.value.portal }
    : { type: "connectivityRead", reading, answered: false, online: false, validated: false, portal: false }
}

function carryNetwork(fx: Network.Effect): Job<Network.Event, WiFi | Found, []> {
  return match (fx) {
    when { tag: "ScanNearby", let scan }: answer("scan", scanned(scan), { type: "giveUpOnScan", now: untimed });
    when { tag: "JoinNetwork", let join, let name, let security, let passphrase }: answer("join", joined(join, name, security, passphrase), { type: "giveUpOnJoin", now: untimed, at: untimed });
    when { tag: "ReadConnectivity", let reading }: answer("connectivity", connectivity(reading), { type: "giveUpOnReading", now: untimed });
  }
}

function networkTimers(state: Network.Network): ReadonlyArray<Due<Network.Event, []>> {
  const waits: ReadonlyArray<[boolean, string, number, Network.Event]> = [
    [state.scanning.read.status === "Loading", "scan", state.scanning.due, { type: "giveUpOnScan", now: untimed }],
    [state.joining.read.status === "Loading", "join", state.joining.due, { type: "giveUpOnJoin", now: untimed, at: untimed }],
    [state.reading.read.status === "Loading", "connectivity", state.reading.due, { type: "giveUpOnReading", now: untimed }],
  ]
  return waits.flatMap(([busy, key, at, event]) => (busy ? [due<Network.Event, []>(key, at, event)] : []))
}

const network = together(
  Layer.provideMerge(reacting(Network, { carry: carryNetwork, timers: networkTimers }), found),
  // spec/app/settings/network.md, "Opening the page scans and reads whether the phone is online, each unless already asked, with ten seconds to answer"; spec/app/settings/network.md, "Leaving the page retires what it asked and forgets what it found; a join in flight is Android's and goes on"
  following(Pages.Machine, (state) => state.page === "NetworkPage", Network.Machine, (shown): Network.Event => (shown ? { type: "opened", at: untimed } : { type: "leave" })),
)

// spec/app/settings/carrier.md, "Only the newest read's answer is shown; a read that failed or was not answered in time shows nothing"
effect function identifiers(reading: number): Carrier.Event!!CarrierSetup {
  const read = try (try CarrierSetup).read()
  return Option.isSome(read)
    ? { type: "identifiersRead", reading, ok: true, identifiers: [...read.value.fields], esim: read.value.esim, smsChoice: read.value.smsChoice }
    : { type: "identifiersRead", reading, ok: false, identifiers: [], esim: false, smsChoice: false }
}

effect function eidOf(eidReading: number): Carrier.Event!!CarrierSetup {
  return { type: "eidRead", eidReading, eid: try (try CarrierSetup).readEid() }
}

// spec/app/settings/carrier.md, "Copy puts one identifier Android returned on the clipboard, one copy at a time, and the page says whether it was copied"
effect function copied(copy: number, value: string): Carrier.Event!!CarrierSetup {
  return { type: "copyAnswered", copy, ok: try (try CarrierSetup).copy(value) }
}

function carryCarrier(fx: Carrier.Effect): Job<Carrier.Event, CarrierSetup, []> {
  return match (fx) {
    when { tag: "ReadIdentifiers", let reading }: answer("read", identifiers(reading), { type: "giveUpOnRead", now: untimed });
    when { tag: "ReadEid", let eidReading }: answer("eid", eidOf(eidReading), { type: "giveUpOnEid", now: untimed });
    when { tag: "CopyIdentifier", let copy, let value }: answer("copy", copied(copy, value), { type: "giveUpOnCopy", now: untimed });
  }
}

function carrierTimers(state: Carrier.Carrier): ReadonlyArray<Due<Carrier.Event, []>> {
  const waits: ReadonlyArray<[boolean, string, number, Carrier.Event]> = [
    [state.read.read.status === "Loading", "read", state.read.due, { type: "giveUpOnRead", now: untimed }],
    [state.eidRead.read.status === "Loading", "eid", state.eidRead.due, { type: "giveUpOnEid", now: untimed }],
    [state.copying.read.status === "Loading", "copy", state.copying.due, { type: "giveUpOnCopy", now: untimed }],
  ]
  return waits.flatMap(([busy, key, at, event]) => (busy ? [due<Carrier.Event, []>(key, at, event)] : []))
}

const carrier = together(
  reacting(Carrier, { carry: carryCarrier, timers: carrierTimers }),
  // spec/app/settings/carrier.md, "Opening the page reads nothing; leaving it, the phone locking or Alpha going to the background forgets everything it read, and an answer that comes later is refused"
  following(Pages.Machine, (state) => state.page === "CarrierPage", Carrier.Machine, (shown): Carrier.Event => (shown ? { type: "show" } : { type: "pageHidden" })),
  hearing(Stream.unwrap(effect { return (try Device).visible }), Carrier.Machine, (visible): Carrier.Event | undefined => (visible ? undefined : { type: "pageHidden" })),
)

// spec/app/settings/passwords.md, "The vault is unavailable for a reason, locked, damaged, or unlocked still, which lists the entries"
effect function vaultRead(visit: number): Vault.Event!!Passwords {
  const state = try (try Passwords).state()
  return { type: "vaultRead", visit, ...state }
}

// spec/app/settings/passwords.md, "Only Android's own authentication unlocks the vault, and the list follows the unlock"
effect function listed(visit: number): Vault.Event!!Passwords {
  const entries = try (try Passwords).list()
  return Option.isSome(entries) ? { type: "listed", visit, entries: [...entries.value] } : { type: "taskAnswered", visit, answer: "WasLocked" }
}

effect function ran(visit: number, task: Vault.Task, id: string, revision: number): Vault.Event!!Passwords {
  return { type: "taskAnswered", visit, answer: try (try Passwords).run(task, id, revision) }
}

const locked = effect {
  try (try Passwords).run("Locking", "", 0)
}

function carryVault(fx: Vault.Effect): Job<Vault.Event, Passwords, []> {
  return match (fx) {
    when { tag: "ReadVault", let visit }: answer(`vault ${visit}`, vaultRead(visit), { type: "taskAnswered", visit, answer: "Refused" });
    when { tag: "ListEntries", let visit }: answer(`list ${visit}`, listed(visit), { type: "taskAnswered", visit, answer: "WasLocked" });
    when { tag: "RunTask", let visit, let task, let id, let revision }: task === "Locking"
      ? run(`lock ${visit}`, locked)
      : answer(`task ${visit}`, ran(visit, task, id, revision), { type: "taskAnswered", visit, answer: "Refused" });
  }
}

const passwords = together(
  reacting(Vault, { carry: carryVault }),
  // spec/app/settings/passwords.md, "Opening the page starts a new visit that asks the vault how it is, and the agent observes nothing until the page is left"; spec/app/settings/passwords.md, "Alpha going to the background locks the vault, and leaving the page ends the visit and forgets everything"
  following(Pages.Machine, (state) => state.page === "PasswordsPage", Vault.Machine, (shown): Vault.Event => (shown ? { type: "openPage" } : { type: "leavePage" })),
  hearing(Stream.unwrap(effect { return (try Device).visible }), Vault.Machine, (visible): Vault.Event | undefined => (visible ? undefined : { type: "lock" })),
)

/** The pages that reach the phone's own hardware and vault: Network, Carrier & SIM setup and Passwords. */
export const phone = together(network, carrier, passwords)
