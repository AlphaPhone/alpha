// spec/settings/facts.md, "Story: Read my phone's state truthfully"; spec/settings/updates.md, "An offer is for this launcher and signer, newer than the installed version, complete and HTTPS"; spec/settings/reset.md, "The native answer is worded by Alpha, and one Alpha does not know claims nothing"

/** AlphaDevice.snapshot: what the launcher reports of itself; every field may be missing. */
export schema DeviceSnapshot {
  appVersion?: string
  appVersionCode?: number
  appSigner?: string
  appUpdatedAt?: number
  androidRelease?: string
  textScalePercent?: number
  permissions?: Record<string, boolean>
  appAutomaticUpdates?: "starting" | "permission-required" | "supported" | "unsupported"
  storageUsedBytes?: number
  storageTotalBytes?: number
}

/** AlphaNotifications.status, as far as Settings reads it. */
export schema NotificationGrant { appEnabled?: boolean; permissionGranted?: boolean }

/** AlphaPhotos.libraryAccess. */
export schema PhotoAccess { scope: "full" | "partial" | "selected" | "denied" }

/** AlphaFiles.storageState. */
export schema StorageAccess { access?: "granted" | "denied" }

/** AlphaDevice.setTextScale. */
export schema TextScale { textScalePercent: number }

/** ElizaSystem.openSettingsPage and the fixed page openers. */
export schema PageOpened { status: "opened"; specific?: boolean }

/** ElizaSystem.openNotificationShade. */
export schema ShadeReply { status: "opened" | "standalone" | "permission-missing" | "unsupported" | "not-in-front" }

/** ElizaSystem.getBuildInfo. */
export schema SystemBuild { launcher: boolean; version: string }

/** AlphaDevice.checkForUpdate: the raw feed and its digest, or neither when the feed has none. */
export schema UpdateCheck { manifest?: string; manifestSha256?: string }

/** One row of the update feed. */
export schema UpdateRow {
  schema: "alpha-update/v1"
  versionCode: number
  versionName?: string
  variant: string
  signerSha256: string
  apkUrl: string
  sha256: string
  sizeBytes: number
  notes?: string
}

/** The bounded index of releases. */
export schema UpdateIndex { schema: "alpha-update/index-v1"; releases: ReadonlyArray<UpdateRow> }

/** AlphaDevice.installUpdate. */
export schema InstallReply {
  status?: "started" | "offer-unavailable" | "offer-withdrawn" | "offer-response-changed" | "starting" | "permission-required" | "unsupported"
  manifest?: string
}

/** AlphaDevice.updateState: Android's activation of a staged update, if any. */
export schema UpdateState {
  pending?: boolean
  phase?: "preparing" | "paused"
  activationId?: string
  bridgeId?: string
  canContinue?: boolean
  outcome?: "canceled" | "failed" | "installed"
  idle?: boolean
}

/** AlphaReset.review: never a completed reset. */
export schema ResetAnswer { status?: string; message?: string }

/** AlphaDevice.shareDiagnostics. */
export schema ShareReply { status?: string }

/** One shipped third-party notice. */
export schema LicenceNotice {
  name: string
  version: string
  license: string
  source?: string
  text?: string
  flags?: ReadonlyArray<string>
}

/** ElizaWiFi.listAvailableNetworks. */
export schema WifiScan {
  networks: ReadonlyArray<{ readonly ssid: string; readonly rssi: number; readonly secured: boolean; readonly security?: "open" | "owe" | "wpa2" | "wpa3" | "eap" | "wep" }>
}

/** ElizaWiFi.addNetworkWithApproval. */
export schema WifiJoin { status: "connected" | "captivePortal" | "declined" | "unverified" | "notConnected" | "wrongPassword" | "savedNetwork" }

/** ElizaWiFi.getConnectivity. */
export schema WifiConnectivity { online: boolean; validated: boolean; captivePortal: boolean }

/** ElizaPasswords.openEditor. */
export schema EditorReply { status: "saved" | "cancelled" }

/** ElizaPasswords.openAutofillSettings. */
export schema AutofillOpened { status: "opened" }

/** AlphaBrowser.loginFillStatus. */
export schema LoginFill { available?: boolean }

/** ElizaPasswords backup readiness, from the vault's shared backup bridge. */
export schema BackupReadiness { ready?: boolean }
