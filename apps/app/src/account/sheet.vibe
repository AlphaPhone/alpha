// spec/account/sheet.md, "Story: Look after my account in one place"; spec/account/sheet.md, "Story: Notice what needs my attention"
import { type Mode, type Section, type Sheet, type SheetEffect, Machine as SheetMachine, machine as sheetMachine } from "../../gen/account__sheet.effect.vibe"
import { keyExpiringSoon } from "../../gen/account__session.effect.vibe"
import { deployment } from "./deployment.ts"
import { Entitlement } from "./entitlement.vibe"
import { CloudSession, ownerOf } from "./session.vibe"

/** The Account presentation, its sign-out review and the Home plan notice. */
export service AccountSheet {
  readonly changes: Stream.Stream<Sheet>
  run(): void!!
  show(): void!!
  openSection(section: Section): void!!
  back(): void!!
  close(): void!!
  /** Android returned Home: the sheet and its panels close. */
  returnHome(): void!!
  askSignOut(): void!!
  cancelSignOut(): void!!
  confirmSignOut(): void!!
  switchMode(mode: Mode): void!!
  toggleCode(): void!!
  dismissPlan(): void!!
  /** Another screen covers Home, or Home shows again. */
  covered(covering: boolean): void!!
}

/** The sheet service over its in-memory machine. */
export const sheetService = Layer.effect(AccountSheet, effect {
  const machine = try SheetMachine
  const session = try CloudSession
  const entitlement = try Entitlement

  effect function send(event: Parameters<typeof machine.send>[0]) {
    const step = machine.send(event) catch () => undefined
    if (step !== undefined && "out" in step) try perform(step.out)
  }

  effect function perform(out: ReadonlyArray<SheetEffect>): void!! {
    for (const effectOf of out) {
      match (effectOf) {
        when { tag: "SignOut", let signingOut }: {
          if (signingOut === (try session.owner())) try session.signOut()
        };
      }
    }
  }

  effect function followSession() {
    for try (const s of session.changes) {
      const owner = ownerOf(s)
      const now = try Clock.currentTimeMillis
      const sheet = try machine.get()
      if (owner !== sheet.owner) try send({ type: "ownerChanged", owner })
      const expiring = owner !== 0 && (s.expiryWarning || keyExpiringSoon(s.account, now))
      if (expiring !== (try machine.get()).keyExpiring) try send({ type: "keyExpiry", expiring })
    }
  }

  effect function followPlan() {
    for try (const a of entitlement.changes) {
      const needed = a.notice === "NeedsPlanNotice" || a.notice === "PlanEndedNotice"
      if (needed !== (try machine.get()).planRequired) try send({ type: "planNeeded", needed })
    }
  }

  return {
    changes: machine.changes,
    effect run() { try.all [ignore(followSession()), ignore(followPlan())] },
    effect show() { try send({ type: "showSheet" }) },
    effect openSection(section: Section) { try send({ type: "openSection", section, fundsOffered: deployment === "ElizaCloud" }) },
    effect back() { try send({ type: "back" }) },
    effect close() { try send({ type: "closeSheet" }) },
    effect returnHome() { try send({ type: "returnHome" }) },
    effect askSignOut() { try send({ type: "askSignOut" }) },
    effect cancelSignOut() { try send({ type: "cancelSignOut" }) },
    effect confirmSignOut() { try send({ type: "confirmSignOut" }) },
    effect switchMode(mode: Mode) { try send({ type: "switchMode", mode }) },
    effect toggleCode() { try send({ type: "toggleCode" }) },
    effect dismissPlan() { try send({ type: "dismissPlan" }) },
    effect covered(covering: boolean) { try send(covering ? { type: "coverScreen" } : { type: "uncover" }) }
  }
})

/** The sheet service with its machine in memory. */
export const sheetLayer = Layer.provideMerge(sheetService, sheetMachine())
