// spec/account/signIn.md, "Story: Choose how to sign in"; spec/account/signIn.md, "Story: Sign in with Google"; spec/account/signIn.md, "Story: Sign in with a code"; spec/account/signIn.md, "A typed phone number is sent in international form"; spec/account/signIn.md, "Story: Leave sign-in"; spec/account/signIn.md, "Story: Read the service's terms before signing in"
import {
  type CodeMethod, type FactorKind, type Host, type Methods, type Net, type SignIn, type SignInEffect, type VerifyOutcome,
  Machine as SignInMachine, canTapGoogle, countryOf, enabled, entryOf, machine as signInMachine, mayReopenGoogle, readinessWaitMs, unknownMethods
} from "../../gen/account__signIn.effect.vibe"
import type { Net as LifeNet } from "../../gen/platform__lifecycle.ts"
import { Build } from "../platform/build.vibe"
import { buildCloudEnvironment, environmentName } from "../platform/build-live.vibe"
import { Cloud } from "../platform/cloud.vibe"
import { AppLifecycle } from "../platform/lifecycle.vibe"
import { Native } from "../platform/native.vibe"
import { Resident } from "../platform/resident.vibe"
import { freshKey } from "./deployment.ts"
import { ensureResident } from "./inference.vibe"
import { CloudSession, noNews, newsOf, type SignInNews } from "./session.vibe"
import { CodeStarted, HostStatus, MfaRequired, MfaResumed, NetworkStatus, ReadinessChanged, ServiceAnswer, SignInAnswer } from "./signIn.schema.vibe"

const plugin = "AlphaCloudSignIn"

/** The deployment's published Terms and Privacy, as the screen shows them. */
export type ServiceInfo = ServiceAnswer["service"]

/** Alpha's own sign-in screen over the native host. */
export service SignInScreen {
  readonly changes: Stream.Stream<SignIn>
  current(): SignIn!!
  /** Fix the host, follow the session, the network as AppLifecycle reports it, the host's readiness and its retained second verifications; runs for the app's life. */
  run(): void!!
  /** The owner opens sign-in, or checks the methods again. */
  open(): void!!
  choose(method: CodeMethod): void!!
  google(): void!!
  /** The Google page was closed or lost: end the waiting attempt as Back does and start a new one. */
  reopenGoogle(): void!!
  /** Whether the address field holds text the owner typed; the text itself is never kept. */
  draft(drafted: boolean): void!!
  /** Send a code to the address or number the owner typed; it is never stored. */
  submit(address: string): void!!
  verify(code: string): void!!
  resend(address: string): void!!
  /** Back one step out of sign-in; whether sign-in took it, the required page holding its chooser included. */
  back(): boolean!!
  /** Saving own provider keys started, or ended; a start behind another step is refused and says so. Whether a start was admitted. */
  ownKeys(started: boolean, saved: boolean): boolean!!
  /** The host holds own keys in use, or no longer: the entry ends, or comes back. */
  useOwnKeys(using: boolean): void!!
  /** The deployment's Terms and Privacy, or undefined when they cannot be read. */
  serviceInfo(): (ServiceInfo | undefined)!!
  /** Opens Android's network settings from the network notice; whether they opened. */
  openWifiSettings(): boolean!!
}

const methodNames = { EmailCode: { start: "startEmail", verify: "verifyEmail", field: "email" }, PhoneCode: { start: "startPhone", verify: "verifyPhone", field: "phone" } } as const

/** What Android says of the network, as AppLifecycle reports it and with its validation fact on the phone, as the screen's network state. */
export function netOf(status: NetworkStatus, android: boolean): Net {
  if (status.connected === false) return "NetOffline"
  if (android && status.internetValidated === false) return "NetUnvalidated"
  return status.connected === true ? "NetOnline" : "NetUnknown"
}

/** The host's readiness answer as methods; unknown readiness offers email only. */
export function methodsOf(status: HostStatus): Methods {
  const known = status.inApp === true || status.methodsKnown === true
  return { known, google: known && status.google === true, email: known && status.email === true, phone: known && status.phone === true }
}

/** How a refused verification reads on the code step. */
export function verifyRefusal(code: string | undefined): VerifyOutcome {
  if (code === "invalid-code") return { tag: "CodeWrong" }
  if (code === "expired" || code === "attempts-exhausted") return { tag: "CodeUsedUp" }
  return { tag: "CodeFailed" }
}

/** The number the host takes (E.164) from what the owner typed: separators go, `+` or `00` keeps the dialled country, and only a North American length is given +1. */
export function internationalNumber(typed: string): string {
  const text = typed.trim()
  const plus = text.startsWith("+")
  // Only separators are dropped: letters or other symbols stay, so such a number is refused, not rewritten.
  const rest = (plus ? text.slice(1) : text).replace(/[\s().-]/g, "")
  const zeroZero = !plus && rest.startsWith("00")
  const digits = zeroZero ? rest.slice(2) : rest
  const country = countryOf(plus ? "PlusDialled" : zeroZero ? "ZeroZeroDialled" : "Undialled", /^[0-9]*$/.test(digits) ? digits.length : 0, digits.startsWith("1"))
  if (country === "CountryDialled") return `+${digits}`
  if (country === "NorthAmerican") return digits.length === 10 ? `+1${digits}` : `+${digits}`
  return digits
}

/** The second verification a host answer names. */
export function factorOf(method: string | undefined): FactorKind {
  return method === "sms" ? "SmsFactor" : method === "passkey" ? "PasskeyFactor" : "TotpFactor"
}

/** The sign-in screen service over its in-memory machine. */
export const signInService = Layer.effect(SignInScreen, effect {
  const machine = try SignInMachine
  const native = try Native
  const cloud = try Cloud
  const resident = try Resident
  const build = try Build
  const lifecycle = try AppLifecycle
  const session = try CloudSession
  const scope = try Scope.Scope
  const environment = environmentName(buildCloudEnvironment(build.info))
  const android = build.info.variant !== "browser"
  const attemptId = try Ref.make("")
  const requestId = try Ref.make("")
  const typed = try Ref.make({ address: "", code: "" })
  const news = try Ref.make<SignInNews>(noNews)
  const epoch = try Ref.make(0)
  const retained = try Ref.make<MfaRequired | undefined>(undefined)

  effect function send(event: Parameters<typeof machine.send>[0]) {
    const step = machine.send(event) catch () => undefined
    if (step !== undefined) try perform(step.out)
    return step !== undefined
  }

  effect function perform(out: ReadonlyArray<SignInEffect>): void!! {
    for (const effectOf of out) {
      match (effectOf) {
        when "ReadMethods": fork.in(scope) readMethods();
        when "StartGoogle": try runGoogle();
        when "SendCode": try runSend();
        when "VerifyCode": try runVerify();
        when "CancelAttempt": native.invoke(plugin, "cancel", { requestId: try Ref.get(requestId) }) catch () => undefined;
        when "EnsureResident": try ensureResident(resident);
        when "Adopted": try session.adopt(try Ref.get(news));
      }
    }
  }

  effect function readMethods(): void!! {
    const read = effect {
      return Effect.flatMap(native.invoke(plugin, "status", { environment, refreshNegative: true }), Schema.decodeUnknownEffect(HostStatus)) catch () => ({})
    }
    const reading = fork.in(scope) read
    // The chooser waits at most six seconds; an answer after that is the check's late answer.
    const first = try timeoutOption(Fiber.join(reading), Duration.millis(readinessWaitMs))
    if (Option.isSome(first)) {
      try send({ type: "probeSettles", methods: methodsOf(first.value), lateFollows: true })
      return
    }
    try send({ type: "probeSettles", methods: unknownMethods, lateFollows: true })
    const late = try Fiber.join(reading)
    try send({ type: "lateMethods", methods: methodsOf(late) })
  }

  /** What the host is sent for the address the owner typed: a phone number in international form. */
  effect function sentAddress(address: string) {
    return (try machine.get()).method === "PhoneCode" ? internationalNumber(address) : address.trim()
  }

  effect function held<A>(work: A!!) {
    try session.attempt(true)
    const result = try ensuring(work, session.attempt(false))
    return result
  }

  effect function stillCurrent(turn: number) {
    return (try Ref.get(epoch)) === turn
  }

  effect function begin() {
    return try Ref.updateAndGet(epoch, (n) => n + 1)
  }

  effect function cooldown(until: number) {
    const now = try Clock.currentTimeMillis
    if (until > now) try sleep(Duration.millis(until - now))
    try send({ type: "cooldownEnds" })
  }

  effect function runGoogle() {
    const turn = try begin()
    const id = freshKey()
    try Ref.set(requestId, id)
    try Ref.set(news, noNews)
    const outcome = try held(effect {
      const raw = native.invoke(plugin, "startGoogle", { environment, requestId: id }) catch () => undefined
      const answer = raw === undefined ? undefined : (Schema.decodeUnknownEffect(SignInAnswer)(raw) catch () => undefined)
      if (answer === undefined) return { tag: "GoogleFailed" } as const
      if (answer.status === "authenticated") {
        try Ref.set(news, newsOf(answer))
        if (try stillCurrent(turn)) try send({ type: "hostCommitsKey" })
        return { tag: "GoogleSignedIn" } as const
      }
      if (answer.attemptId !== undefined) try Ref.set(attemptId, answer.attemptId)
      return { tag: "GoogleFactor", googleFactor: factorOf(answer.method) } as const
    })
    if (try stillCurrent(turn)) try send({ type: "googleEnds", result: outcome })
  }

  effect function runSend() {
    const turn = try begin()
    const s = try machine.get()
    const resending = s.work === "Resending"
    const names = methodNames[s.method]
    const address = (try Ref.get(typed)).address
    const id = freshKey()
    try Ref.set(requestId, id)
    const started = try held(effect {
      const raw = native.invoke(plugin, names.start, { environment, [names.field]: address, requestId: id }) catch () => undefined
      if (raw === undefined) return undefined
      return Schema.decodeUnknownEffect(CodeStarted)(raw) catch () => undefined
    })
    if (!(try stillCurrent(turn))) return
    if (started !== undefined) {
      try Ref.set(attemptId, started.attemptId)
      fork.in(scope) cooldown(started.resendAt)
    }
    try send(resending ? { type: "resendEnds", accepted: started !== undefined } : { type: "sendEnds", accepted: started !== undefined })
  }

  effect function runVerify() {
    const turn = try begin()
    const s = try machine.get()
    const attempt = try Ref.get(attemptId)
    const code = (try Ref.get(typed)).code
    try Ref.update(typed, (t) => ({ ...t, code: "" }))
    try Ref.set(news, noNews)
    const method = s.screen === "FactorStep" ? "verifyMfa" : methodNames[s.method].verify
    const verified = try held(effect {
      const call = Effect.map(native.invoke(plugin, method, { attemptId: attempt, code }), (value) => ({ ok: true as const, value }))
      const result = call catch (error) => ({ ok: false as const, code: error._tag === "NativeFailed" ? error.code : undefined })
      if (!result.ok) return verifyRefusal(result.code)
      const answer = Schema.decodeUnknownEffect(SignInAnswer)(result.value) catch () => undefined
      if (answer === undefined) return { tag: "CodeFailed" } as VerifyOutcome
      if (answer.status === "authenticated") {
        try Ref.set(news, newsOf(answer))
        return { tag: "CodeAccepted" } as VerifyOutcome
      }
      if (answer.attemptId !== undefined) try Ref.set(attemptId, answer.attemptId)
      return { tag: "CodeNeedsFactor", codeFactor: factorOf(answer.method) } as VerifyOutcome
    })
    if (try stillCurrent(turn)) try send({ type: "verifyEnds", verified, attempt: s.attempt })
  }

  effect function offerRetained() {
    const waiting = try Ref.get(retained)
    if (waiting === undefined) return
    const s = try machine.get()
    const factor = factorOf(waiting.method)
    if (!enabled(s, { type: "factorReturned", returnedFactor: factor })) return
    try Ref.set(retained, undefined)
    const now = try Clock.currentTimeMillis
    if (waiting.expiresAt <= now) return
    const resumed = effect {
      return try Schema.decodeUnknownEffect(MfaResumed)(try native.invoke(plugin, "resumeMfa", { attemptId: waiting.attemptId, environment }))
    } catch () => ({ active: false })
    if (!resumed.active) return
    try Ref.set(attemptId, waiting.attemptId)
    try send({ type: "factorReturned", returnedFactor: factor })
  }

  effect function followSession() {
    for try (const s of session.changes) {
      const usable = s.phase === "SignedIn" || s.phase === "ActivationPending"
      const current = try machine.get()
      if (s.startupResolved && !current.startupResolved) try send({ type: "startupSettles" })
      if (usable !== current.signedIn) try send({ type: "sessionChanged", usable })
      const after = try machine.get()
      if (enabled(after, { type: "automaticProbe" })) try send({ type: "automaticProbe" })
      if (enabled(after, { type: "latchReleases" })) try send({ type: "latchReleases" })
    }
  }

  effect function followQueued() {
    for try (const s of machine.changes) {
      if (s.work === "NoWork") try offerRetained()
    }
  }

  effect function validated() {
    const read = effect {
      return try Schema.decodeUnknownEffect(NetworkStatus)(try native.invoke("ElizaSystem", "getNetworkStatus"))
    } catch () => undefined
    return read?.internetValidated
  }

  effect function seen(network: LifeNet) {
    const validation = android && network === "NetOnline" ? (try validated()) : undefined
    const status: NetworkStatus = {
      ...(network === "NetOnline" ? { connected: true } : network === "NetOffline" ? { connected: false } : {}),
      ...(validation === undefined ? {} : { internetValidated: validation }),
    }
    const net = netOf(status, android)
    const before = try machine.get()
    if (enabled(before, { type: "networkSeen", net })) try send({ type: "networkSeen", net })
    const s = try machine.get()
    if (net === "NetOnline" && enabled(s, { type: "ownerOpens" }) && s.screen === "Choose" && !s.methods.known) try send({ type: "ownerOpens" })
  }

  effect function followNetwork() {
    try seen(try lifecycle.refreshNetwork())
    for try (const app of Stream.changesWith(lifecycle.changes, (a, b) => a.network === b.network && a.returns === b.returns)) {
      try seen(app.network)
    }
  }

  effect function followReadiness() {
    for try (const raw of native.listen(plugin, "signInReadinessChanged")) {
      const read = Schema.decodeUnknownEffect(ReadinessChanged)(raw) catch () => undefined
      if (read === undefined || read.environment !== environment) continue
      try send({ type: "lateMethods", methods: methodsOf(read) })
    }
  }

  effect function followRetained() {
    for try (const raw of native.listen(plugin, "signInMfaRequired")) {
      const read = Schema.decodeUnknownEffect(MfaRequired)(raw) catch () => undefined
      if (read === undefined) continue
      try Ref.set(retained, read)
      try offerRetained()
    }
  }

  return {
    changes: machine.changes,
    current: () => machine.get(),
    effect run() {
      const host: Host = android ? "AndroidHost" : build.info.testMocks ? "PreviewHost" : "BrowserHost"
      try send({ type: "fixHost", host, boundary: !android && build.info.testMocks })
      try.all [
        ignore(followSession()),
        ignore(followNetwork()),
        ignore(followReadiness()),
        ignore(followRetained()),
        ignore(followQueued())
      ]
    },
    effect open() { try send({ type: "ownerOpens" }) },
    effect choose(method: CodeMethod) { try send({ type: "chooseMethod", method }) },
    effect draft(drafted: boolean) {
      if ((try machine.get()).drafted !== drafted) try send({ type: "draftChanged", drafted })
    },
    effect google() { try send({ type: "tapGoogle" }) },
    effect reopenGoogle() {
      if (!mayReopenGoogle(try machine.get())) return
      try send({ type: "backDuringGoogle" })
      try Ref.update(epoch, (n) => n + 1)
      if (canTapGoogle(try machine.get())) try send({ type: "tapGoogle" })
    },
    effect submit(address: string) {
      try Ref.set(typed, { address: try sentAddress(address), code: "" })
      try send({ type: "submitAddress" })
    },
    effect resend(address: string) {
      try Ref.set(typed, { address: try sentAddress(address), code: "" })
      try send({ type: "resend" })
    },
    effect verify(code: string) {
      try Ref.update(typed, (t) => ({ ...t, code: code.replace(/[\s-]/g, "") }))
      if (!(try send({ type: "verify" }))) try Ref.update(typed, (t) => ({ ...t, code: "" }))
    },
    effect back() {
      const before = try machine.get()
      if (before.work === "GoogleWork") try send({ type: "backDuringGoogle" })
      else try send({ type: "back" })
      const after = try machine.get()
      if (after.work !== before.work || after.screen !== before.screen) try Ref.update(epoch, (n) => n + 1)
      return entryOf(before) !== "NoEntry"
    },
    effect ownKeys(started: boolean, saved: boolean) {
      if (!started) return try send({ type: "ownKeysEnd", saved })
      if (try send({ type: "ownKeysStart" })) return true
      try send({ type: "ownKeysRefused" })
      return false
    },
    effect useOwnKeys(using: boolean) {
      if (!using) {
        try send({ type: "ownKeysCleared" })
        return
      }
      if (try send({ type: "ownKeysStart" })) try send({ type: "ownKeysEnd", saved: true })
    },
    effect serviceInfo() {
      const answer = effect {
        return try Schema.decodeUnknownEffect(ServiceAnswer)(try cloud.json("GET", "/api/public/service"))
      } catch () => undefined
      return answer !== undefined && answer.success && answer.version === 1 ? answer.service : undefined
    },
    effect openWifiSettings() {
      const opened = effect {
        try native.invoke("ElizaSystem", "openNetworkSettings")
        return true
      } catch () => false
      return opened
    }
  }
})

/** The sign-in screen with its machine in memory: nothing of an attempt survives the process. */
export const signInLayer = Layer.provideMerge(signInService, signInMachine())
