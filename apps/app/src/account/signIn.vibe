// spec/account/signIn.md, "Story: Choose how to sign in"; spec/account/signIn.md, "Story: Sign in with Google"; spec/account/signIn.md, "Story: Sign in with a code"; spec/account/signIn.md, "Story: Leave sign-in"; spec/account/signIn.md, "Story: Read the service's terms before signing in"
import {
  type CodeMethod, type Host, type Methods, type Net, type SignIn, type SignInEffect, type VerifyOutcome,
  Machine as SignInMachine, enabled, machine as signInMachine
} from "../../gen/account__signIn.effect.vibe"
import { Build } from "../platform/build.vibe"
import { Cloud } from "../platform/cloud.vibe"
import { Native } from "../platform/native.vibe"
import { environmentFor, freshKey, hostEnvironment } from "./deployment.ts"
import { ensureResident } from "./inference.vibe"
import { CloudSession } from "./session.vibe"
import { CodeStarted, HostStatus, NativeRejection, NetworkStatus, ServiceAnswer, SignInAnswer } from "./signIn.schema.vibe"

const plugin = "AlphaCloudSignIn"

/** The deployment's published Terms and Privacy, as the screen shows them. */
export type ServiceInfo = ServiceAnswer["service"]

/** Alpha's own sign-in screen over the native host. */
export service SignInScreen {
  readonly changes: Stream.Stream<SignIn>
  current(): SignIn!!
  /** Fix the host, follow the session, the network and the host's readiness; runs for the app's life. */
  run(): void!!
  /** The owner opens sign-in, or checks the methods again. */
  open(): void!!
  choose(method: CodeMethod): void!!
  google(): void!!
  /** Send a code to the address or number the owner typed; it is never stored. */
  submit(address: string): void!!
  verify(code: string): void!!
  resend(address: string): void!!
  back(): void!!
  /** Saving own provider keys started, or ended. */
  ownKeys(started: boolean, saved: boolean): void!!
  /** The deployment's Terms and Privacy, or undefined when they cannot be read. */
  serviceInfo(): ServiceInfo | undefined!!
  /** Opens Android's network settings from the network notice; whether they opened. */
  openWifiSettings(): boolean!!
}

const methodNames = { EmailCode: { start: "startEmail", verify: "verifyEmail", field: "email" }, PhoneCode: { start: "startPhone", verify: "verifyPhone", field: "phone" } } as const

/** What Android says of the network, as the screen's network state. */
export function netOf(status: NetworkStatus, android: boolean): Net {
  if (status.connected === false) return "NetOffline"
  if (android && status.internetValidated === false) return "NetUnvalidated"
  return status.connected === true ? "NetOnline" : "NetUnknown"
}

/** The host's readiness answer as methods; unknown readiness offers email only. */
export function methodsOf(status: HostStatus): Methods {
  const known = status.inApp === true || status.methodsKnown === true
  return { known, google: known && status.google === true, email: known && status.email === true, phone: known && status.phone === true }
}

/** How a refused verification reads on the code step. */
export function verifyRefusal(code: string): VerifyOutcome {
  if (code === "invalid-code") return { tag: "CodeWrong" }
  if (code === "expired" || code === "attempts-exhausted") return { tag: "CodeUsedUp" }
  return { tag: "CodeFailed" }
}

/** The sign-in screen service over its in-memory machine. */
export const signInService = Layer.effect(SignInScreen, effect {
  const machine = try SignInMachine
  const native = try Native
  const build = try Build
  const session = try CloudSession
  const environment = hostEnvironment(environmentFor(build.info.testMocks))
  const android = build.info.variant !== "browser"
  const attemptId = try Ref.make("")
  const requestId = try Ref.make("")
  const resendAt = try Ref.make(0)

  effect function send(event: Parameters<typeof machine.send>[0]) {
    const step = machine.send(event) catch () => undefined
    if (step !== undefined) try perform(step.out)
    return step !== undefined
  }

  effect function perform(out: ReadonlyArray<SignInEffect>): void!! {
    for (const effectOf of out) {
      match (effectOf) {
        when "ReadMethods": fork readMethods();
        when "EnsureResident": try ensureResident();
        when "Adopted": try session.adopt();
        when "CancelAttempt": native.invoke(plugin, "cancel", { requestId: try Ref.get(requestId) }) catch () => undefined;
        when "StartGoogle": undefined;
        when "SendCode": undefined;
        when "VerifyCode": undefined;
      }
    }
  }

  effect function readMethods() {
    const status = effect {
      return try Schema.decodeUnknownEffect(HostStatus)(try native.invoke(plugin, "status", { environment, refreshNegative: true }))
    } catch () => ({})
    try send({ type: "probeSettles", methods: methodsOf(status), lateFollows: true })
  }

  effect function rejectionCode(error: unknown) {
    const read = Schema.decodeUnknownEffect(NativeRejection)(error) catch () => undefined
    return read?.code ?? "unavailable"
  }

  effect function held<A>(work: A!!) {
    try session.attempt(true)
    const result = try ensuring(work, session.attempt(false))
    return result
  }

  effect function cooldown(until: number) {
    const now = try Clock.currentTimeMillis
    if (until > now) try sleep(Duration.millis(until - now))
    try send({ type: "cooldownEnds" })
  }

  effect function sendCode(address: string, resending: boolean) {
    const s = try machine.get()
    if (!(try send(resending ? { type: "resend" } : { type: "submitAddress" }))) return
    const names = methodNames[s.method]
    const id = freshKey()
    try Ref.set(requestId, id)
    const started = try held(effect {
      return try Schema.decodeUnknownEffect(CodeStarted)(try native.invoke(plugin, names.start, { environment, [names.field]: address.trim(), requestId: id }))
    } catch () => undefined)
    if (started !== undefined) {
      try Ref.set(attemptId, started.attemptId)
      try Ref.set(resendAt, started.resendAt)
      fork.detached cooldown(started.resendAt)
    }
    try send(resending ? { type: "resendEnds", accepted: started !== undefined } : { type: "sendEnds", accepted: started !== undefined })
  }

  effect function followSession() {
    for try (const s of session.changes) {
      const usable = s.phase === "SignedIn" || s.phase === "ActivationPending"
      const current = try machine.get()
      if (s.startupResolved && !current.startupResolved) try send({ type: "startupSettles" })
      if (usable !== current.signedIn) try send({ type: "sessionChanged", usable })
      const after = try machine.get()
      if (enabled(after, { type: "automaticProbe" })) try send({ type: "automaticProbe" })
      if (enabled(after, { type: "latchReleases" })) try send({ type: "latchReleases" })
    }
  }

  effect function followNetwork() {
    const first = effect {
      return try Schema.decodeUnknownEffect(NetworkStatus)(try native.invoke("ElizaSystem", "getNetworkStatus"))
    } catch () => undefined
    if (first !== undefined) try send({ type: "networkSeen", net: netOf(first, android) })
    for try (const raw of native.listen("ElizaSystem", "networkStatusChanged")) {
      const read = Schema.decodeUnknownEffect(NetworkStatus)(raw) catch () => undefined
      if (read === undefined) continue
      const net = netOf(read, android)
      try send({ type: "networkSeen", net })
      const s = try machine.get()
      if (net === "NetOnline" && enabled(s, { type: "ownerOpens" }) && s.screen === "Choose" && !s.methods.known) try send({ type: "ownerOpens" })
    }
  }

  effect function followReadiness() {
    for try (const raw of native.listen(plugin, "signInReadinessChanged")) {
      const row = typeof raw === "object" && raw !== null && "readiness" in raw ? (raw as { readiness: unknown }).readiness : undefined
      const read = Schema.decodeUnknownEffect(HostStatus)(row ?? {}) catch () => ({})
      try send({ type: "lateMethods", methods: methodsOf({ ...read, methodsKnown: row !== null && row !== undefined }) })
    }
  }

  effect function answered(raw: unknown) {
    return try Schema.decodeUnknownEffect(SignInAnswer)(raw)
  }

  return {
    changes: machine.changes,
    current: () => machine.get(),
    effect run() {
      const host: Host = android ? "AndroidHost" : build.info.testMocks ? "PreviewHost" : "BrowserHost"
      try send({ type: "fixHost", host, boundary: !android && build.info.testMocks })
      try.all [
        ignore(followSession()),
        ignore(followNetwork()),
        ignore(followReadiness())
      ]
    },
    effect open() { try send({ type: "ownerOpens" }) },
    effect choose(method: CodeMethod) { try send({ type: "chooseMethod", method }) },
    effect google() {
      if (!(try send({ type: "tapGoogle" }))) return
      const id = freshKey()
      try Ref.set(requestId, id)
      const outcome = try held(effect {
        const answer = try answered(try native.invoke(plugin, "startGoogle", { environment, requestId: id }))
        if (answer.status === "authenticated") {
          try send({ type: "hostCommitsKey" })
          return { tag: "GoogleSignedIn" } as const
        }
        if (answer.attemptId !== undefined) try Ref.set(attemptId, answer.attemptId)
        return { tag: "GoogleFactor", googleFactor: answer.method === "sms" ? "SmsFactor" : answer.method === "passkey" ? "PasskeyFactor" : "TotpFactor" } as const
      } catch () => ({ tag: "GoogleFailed" } as const))
      try send({ type: "googleEnds", outcome })
    },
    submit: (address: string) => sendCode(address, false),
    resend: (address: string) => sendCode(address, true),
    effect verify(code: string) {
      const s = try machine.get()
      if (!(try send({ type: "verify" }))) return
      const attempt = try Ref.get(attemptId)
      const method = s.screen === "FactorStep" ? "verifyMfa" : methodNames[s.method].verify
      const verified = try held(effect {
        const answer = try answered(try native.invoke(plugin, method, { attemptId: attempt, code: code.replace(/[\s-]/g, "") }))
        if (answer.status === "authenticated") return { tag: "CodeAccepted" } as const
        if (answer.attemptId !== undefined) try Ref.set(attemptId, answer.attemptId)
        return { tag: "CodeNeedsFactor", codeFactor: answer.method === "sms" ? "SmsFactor" : answer.method === "passkey" ? "PasskeyFactor" : "TotpFactor" } as const
      } catch effect (error) => verifyRefusal(try rejectionCode(error)))
      try send({ type: "verifyEnds", verified })
    },
    effect back() {
      const s = try machine.get()
      if (s.work === "GoogleWork") try send({ type: "backDuringGoogle" })
      else try send({ type: "back" })
    },
    effect ownKeys(started: boolean, saved: boolean) {
      try send(started ? { type: "ownKeysStart" } : { type: "ownKeysEnd", saved })
    },
    effect serviceInfo() {
      const cloud = try Cloud
      const answer = effect {
        return try Schema.decodeUnknownEffect(ServiceAnswer)(try cloud.json("GET", "/api/public/service"))
      } catch () => undefined
      return answer !== undefined && answer.success && answer.version === 1 ? answer.service : undefined
    },
    effect openWifiSettings() {
      const opened = effect {
        try native.invoke("ElizaSystem", "openNetworkSettings")
        return true
      } catch () => false
      return opened
    }
  }
})

/** The sign-in screen with its machine in memory: nothing of an attempt survives the process. */
export const signInLayer = Layer.provideMerge(signInService, signInMachine())
