// spec/account/devBridge.md, "Story: Sign in through the development bridge"; spec/account/dedicated.md, "Story: Review a dedicated agent in a development build"
import { type AckResult, type Bridge, Machine as BridgeMachine, machine as bridgeMachine } from "../../gen/account__devBridge.effect.vibe"
import { type Dedicated, type DedicatedEffect, type PollOutcome, Machine as DedicatedMachine, machine as dedicatedMachine } from "../../gen/account__dedicated.effect.vibe"
import { Build } from "../platform/build.vibe"
import { CloudSession } from "./session.vibe"

const bridge = "/__alpha-dev-cloud"

/** The bridge's answer to one step. */
schema BridgeAnswer {
  ok: boolean
  reached?: boolean
  result?: "confirmed" | "transient" | "refused"
  store?: "before" | "mine" | "other"
}

/** The bridge's dedicated review. */
schema DedicatedReview {
  adoption: boolean
  available: boolean
}

/** The bridge's dedicated status. */
schema DedicatedStatus {
  phase: "provisioning" | "cutover" | "ready" | "unconfirmed"
}

/** The test-mocks development bridge's own Cloud sign-in. */
export service DevBridgeSignIn {
  readonly changes: Stream.Stream<Bridge>
  /** Run one bridge sign-in after a verified development session; nothing in a product build. */
  signIn(): void!!
  cancel(): void!!
}

/** The test-mocks review of a dedicated Cloud agent. */
export service DedicatedSetup {
  readonly changes: Stream.Stream<Dedicated>
  review(): void!!
  accept(): void!!
  decline(): void!!
  poll(): void!!
  finalize(): void!!
}

effect function ask(path: string) {
  const client = try HttpClient.HttpClient
  const response = try client.execute(HttpClientRequest.post(`${bridge}/${path}`))
  return try Schema.decodeUnknownEffect(BridgeAnswer)(try response.json)
}

/** The bridge service: each step is the bridge's answer applied to the bridge machine. */
export const devBridgeService = Layer.effect(DevBridgeSignIn, effect {
  const machine = try BridgeMachine
  const build = try Build
  const session = try CloudSession
  machine.send({ type: "allowBridge", testMocks: build.info.testMocks }) catch () => undefined

  effect function step(event: Parameters<typeof machine.send>[0]) {
    return (machine.send(event) catch () => undefined) !== undefined
  }

  return {
    changes: machine.changes,
    effect signIn() {
      if (!(try step({ type: "begin" }))) return
      const minted = ask("mint") catch () => ({ ok: false })
      try step({ type: "mint", ok: minted.ok })
      while ((try machine.get()).phase === "Acking") {
        const ack = ask("ack") catch () => ({ ok: false, result: "transient" as const, reached: false })
        const result: AckResult = ack.result === "confirmed" ? "AckConfirmed" : ack.result === "refused" ? "AckRefused" : "AckTransient"
        try step({ type: "acknowledge", result, reached: ack.reached === true })
      }
      const owner = ask("identity") catch () => ({ ok: false })
      try step({ type: "identity", ok: owner.ok })
      const store = ask("store") catch () => ({ ok: false, store: "before" as const })
      if (store.store === "other") try step({ type: "storeChangesElsewhere" })
      try step({ type: "commitChecks" })
      if ((try machine.get()).phase === "Writing") {
        try step({ type: "dispatchRename" })
        const renamed = ask("commit") catch () => ({ ok: false })
        try step({ type: "renameSettles", ok: renamed.ok })
        if (renamed.ok) try session.adopt()
      }
      try step({ type: "reset" })
    },
    effect cancel() {
      ask("cancel") catch () => undefined
      try step({ type: "cancel" })
    }
  }
})

/** The dedicated review service, over the bridge. */
export const dedicatedService = Layer.effect(DedicatedSetup, effect {
  const machine = try DedicatedMachine
  const build = try Build
  machine.send({ type: "allowSetup", testMocks: build.info.testMocks }) catch () => undefined

  effect function call(path: string) {
    const client = try HttpClient.HttpClient
    const response = try client.execute(HttpClientRequest.post(`${bridge}/dedicated/${path}`))
    return try response.json
  }

  effect function perform(out: ReadonlyArray<DedicatedEffect>) {
    for (const effectOf of out) {
      const path = effectOf === "AcceptReview" ? "accept" : effectOf === "PollStatus" ? "status" : "finalize"
      const raw = call(path) catch () => undefined
      if (effectOf === "AcceptReview") {
        machine.send({ type: "acceptSettled", confirmed: raw !== undefined }) catch () => undefined
        continue
      }
      const read = raw === undefined ? undefined : (Schema.decodeUnknownEffect(DedicatedStatus)(raw) catch () => undefined)
      const outcome: PollOutcome = read === undefined || read.phase === "unconfirmed" ? "SetupUnconfirmed" : read.phase === "ready" ? "SetupFinished" : read.phase === "cutover" ? "ReadyForCutover" : "StillProvisioning"
      machine.send({ type: "polled", outcome }) catch () => undefined
    }
  }

  effect function send(event: Parameters<typeof machine.send>[0]) {
    const result = machine.send(event) catch () => undefined
    if (result !== undefined && "out" in result) try perform(result.out)
  }

  return {
    changes: machine.changes,
    effect review() {
      const raw = call("review") catch () => undefined
      const read = raw === undefined ? undefined : (Schema.decodeUnknownEffect(DedicatedReview)(raw) catch () => undefined)
      if (read !== undefined) try send({ type: "reviewRead", adoption: read.adoption, available: read.available })
    },
    effect accept() { try send({ type: "accept" }) },
    effect decline() { try send({ type: "decline" }) },
    effect poll() { try send({ type: "poll" }) },
    effect finalize() { try send({ type: "finalize" }) }
  }
})

/** Both development surfaces with their machines in memory, over the browser's fetch. */
export const devLayer = Layer.provide(
  Layer.mergeAll(Layer.provideMerge(devBridgeService, bridgeMachine()), Layer.provideMerge(dedicatedService, dedicatedMachine())),
  FetchHttpClient.layer
)
