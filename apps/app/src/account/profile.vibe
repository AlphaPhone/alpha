// spec/app/account/billing.md, "The plans and their prices are read from Cloud, and only the newest reading is taken"; spec/app/account/plan.md, "Story: Know my plan"; spec/app/settings/index.md, "Each page links to what another area owns there"; spec/app/shell/layers.md, "Story: Keep a sheet or a dialog above the phone"; spec/kit/read.md, "Story: Read from outside"
import type { CredentialId } from "@elizaos/os-bridges"
import { type Account as CloudProfile, CloudError, isCredentialInvalid, networkError, type PlanOffer, subscriptionView } from "@elizaos/cloud"
import * as Billing from "../../gen/app__account__billing.effect.vibe"
import * as Settings from "../../gen/app__settings.effect.vibe"
import * as Shell from "../../gen/app__shell.effect.vibe"
import * as Layers from "../../gen/app__shell__layers.effect.vibe"
import { type Account, Cloud } from "../platform/cloud.vibe"
import { Device, native } from "../platform/device.vibe"
import { CLOUD_ENVIRONMENT, signInAccounts } from "../platform/voice.vibe"
import { contained, started } from "../runtime/reactor.vibe"

/** The account sheet's entry in the shell's stack. */
export const accountLayer = "account"

type Plan =
  | { readonly tag: "CheckingPlan" }
  | { readonly tag: "PlanUnavailable" }
  | {
    readonly tag: "PlanRead"
    readonly name: "Plus" | "Pro" | "Credits" | "No plan"
    readonly paymentDue: boolean
    readonly balanceMicros: number
    readonly allowance: { readonly availableMicros: number; readonly resetsAt: number } | null
    readonly expiresAt: number | null
  }

export type PurchaseVisibility = "Matches" | "Changed" | "Unconfirmed"

/** Serializes decisions initiated in Account. */
export service AccountWrites { readonly admission: Semaphore.Semaphore }

export const accountWrites = Layer.effect(AccountWrites, Effect.map(Semaphore.make(1), (admission) => ({ admission })))

type ReadProfile = {
  readonly tag: "Read"
  readonly contact: string
  readonly name: string
  readonly plan?: Plan
  readonly purchase?: PurchaseVisibility
  readonly codesAvailable?: boolean
}

/** What Cloud says about the account for this request. The page never holds a credential. */
export type Profile =
  | { readonly tag: "Reading" }
  | { readonly tag: "SignInRequired" }
  | { readonly tag: "Unavailable" }
  | ReadProfile

const reading: Profile = { tag: "Reading" }

export interface Catalog {
  readonly ticket: number
  readonly offers: ReadonlyArray<PlanOffer>
  readonly buyer: Buyer | undefined
}

/** Display details from the current read, held for the Settings row and Account sheet. */
export function profileShelf() {
  let current: Profile = reading
  let offers: Catalog | undefined
  const listeners = new Set<() => void>()
  const checks = new Set<() => void>()
  return {
    refresh: (): void => { for (const check of checks) check() },
    refreshed: Stream.callback<void>((queue) => acquireRelease(sync(() => {
      const check = () => { Queue.offerUnsafe(queue, undefined) }
      checks.add(check)
      return check
    }), (check) => sync(() => { checks.delete(check) }))),
    snapshot: (): Profile => current,
    catalog: (): Catalog | undefined => offers,
    subscribe: (listener: () => void): (() => void) => {
      listeners.add(listener)
      return (): void => { listeners.delete(listener) }
    },
    publish: (value: Profile): void => {
      current = value
      for (const listener of listeners) listener()
    },
    publishCatalog: (value: Catalog | undefined): void => {
      offers = value
      for (const listener of listeners) listener()
    },
  }
}

/** Opens the owner's account from Settings. The shell retires the layer on Back and Home. */
export effect function openAccount(): void!!Layers.Machine {
  const layers = try Layers.Machine
  try contained(layers.send({ type: "openLayer", id: accountLayer, kind: "SheetLayer", covers: true }), "opening Account")
}

const cloudFailure = (cause: unknown) => cause instanceof CloudError ? cause : networkError(cause)

export const readAccount = (cloud: Account) => timeout(tryPromise({
  try: (signal) => cloud.client.account({ signal }),
  catch: cloudFailure,
}), "10 seconds")

const profileOf = (data: CloudProfile): ReadProfile =>
  ({ tag: "Read", name: data.name?.trim() ?? "", contact: data.email?.trim() || data.phone?.trim() || "" })

const profileFailure = (error: unknown): Profile => error instanceof CloudError && isCredentialInvalid(error)
  ? { tag: "SignInRequired" } : { tag: "Unavailable" }

effect function credentialOf(owner: CloudProfile) {
  const status = timeout(tryPromise(() => signInAccounts().status({ environment: CLOUD_ENVIRONMENT })), "5 seconds") catch () => undefined
  const account = status?.account
  return account?.kind === "signedIn" && account.userId === owner.id && account.organizationId === owner.organization_id ? account.credentialId : undefined
}

type Checked<A> =
  | { readonly tag: "Current"; readonly answer: A }
  | { readonly tag: "Unconfirmed"; readonly profile: Profile }

effect function readForOwner<A>(cloud: Account, owner: CloudProfile, profile: ReadProfile, request: (signal: AbortSignal) => Promise<A>): Checked<A>!! {
  const phone = native()
  const unavailable: Checked<A> = { tag: "Unconfirmed", profile }
  if (!owner.id || !owner.organization_id) return unavailable
  const before = phone ? try credentialOf(owner) : undefined
  if (phone && before === undefined) return unavailable
  const answer = try exit(timeout(tryPromise({ try: request, catch: cloudFailure }), "10 seconds"))
  const checked = try exit(readAccount(cloud))
  if (Exit.isFailure(checked)) {
    const issue = profileFailure(Cause.squash(checked.cause))
    return issue.tag === "SignInRequired" ? { tag: "Unconfirmed", profile: issue } : unavailable
  }
  const after = checked.value
  if (after.id !== owner.id || after.organization_id !== owner.organization_id) return { tag: "Unconfirmed", profile: profileOf(after) }
  if (phone && (try credentialOf(after)) !== before) return unavailable
  return Exit.isSuccess(answer) ? { tag: "Current", answer: answer.value } : unavailable
}

export interface Buyer {
  readonly userId: string
  readonly organizationId: string
  readonly credentialId: CredentialId
  readonly expiresAt: number
}

export effect function buyerOf(owner: CloudProfile): (Buyer | undefined)!! {
  if (!native()) return undefined
  const status = timeout(tryPromise(() => signInAccounts().status({ environment: CLOUD_ENVIRONMENT })), "5 seconds") catch () => undefined
  const account = status?.account
  const now = try Clock.currentTimeMillis
  if (account?.kind !== "signedIn" || account.userId !== owner.id || account.organizationId !== owner.organization_id
    || !account.credentialId || account.keyExpiresAt <= now) return undefined
  return { userId: account.userId, organizationId: account.organizationId, credentialId: account.credentialId, expiresAt: account.keyExpiresAt }
}

export const sameBuyer = (one: Buyer, other: Buyer | undefined): boolean => other !== undefined
  && one.userId === other.userId && one.organizationId === other.organizationId
  && one.credentialId === other.credentialId && one.expiresAt === other.expiresAt

const planUnavailable: Plan = { tag: "PlanUnavailable" }

effect function readPlan(cloud: Account, owner: CloudProfile, profile: ReadProfile): Profile!! {
  const found = try readForOwner(cloud, owner, profile, (signal) => cloud.client.snapshot({ signal }))
  if (found.tag === "Unconfirmed") return found.profile.tag === "Read" ? { ...found.profile, plan: planUnavailable } : found.profile
  const snapshot = found.answer
  const unavailable = { ...profile, plan: planUnavailable }
  if (snapshot.account.status !== "active") return unavailable
  const now = try Clock.currentTimeMillis
  const view = subscriptionView(snapshot, now)
  if (view.credit.kind === "unavailable" || (view.planEffectiveUntil !== null && view.planEffectiveUntil <= now)) return unavailable
  const shown = view.plan
  if (shown.tag === "PlanChecking" || shown.tag === "PlanUnavailable") return unavailable
  const name = shown.tag === "PlanPaid" ? (view.planKey === "pro_monthly" ? "Pro" : "Plus")
    : shown.tag === "PlanOnCredits" ? "Credits" : "No plan"
  const allowance = view.allowance
  return {
    ...profile,
    plan: {
      tag: "PlanRead",
      name,
      paymentDue: shown.tag === "PlanPaid" && shown.warning,
      balanceMicros: view.credit.kind === "funded" ? view.credit.usdMicros : 0,
      allowance: allowance?.state === "open" && allowance.resetsAt > now
        ? { availableMicros: allowance.available, resetsAt: allowance.resetsAt }
        : null,
      expiresAt: view.planEffectiveUntil,
    },
  }
}

function untilExpiry(profile: Profile): Stream.Stream<Profile> {
  if (profile.tag !== "Read" || profile.plan?.tag !== "PlanRead") return Stream.succeed(profile)
  const plan = profile.plan
  return Stream.unwrap(effect {
    const now = try Clock.currentTimeMillis
    const expiresAt = plan.expiresAt ?? Number.POSITIVE_INFINITY
    const resetsAt = plan.allowance?.resetsAt ?? Number.POSITIVE_INFINITY
    const retirement = { ...profile, plan: planUnavailable }
    const expires = Number.isFinite(expiresAt)
      ? Stream.fromEffect(Effect.as(sleep(Math.max(0, expiresAt - now)), retirement))
      : Stream.empty
    if (resetsAt >= expiresAt) return Stream.concat(Stream.succeed<Profile>(profile), expires)
    const withoutAllowance = { ...profile, plan: { ...plan, allowance: null } }
    return Stream.concat(
      Stream.succeed<Profile>(profile),
      Stream.concat(Stream.fromEffect(Effect.as(sleep(Math.max(0, resetsAt - now)), withoutAllowance)),
        Number.isFinite(expiresAt) ? Stream.fromEffect(Effect.as(sleep(expiresAt - resetsAt), retirement)) : Stream.empty),
    )
  })
}

function visit<R>(cloud: Account, place: "Account" | "Settings", checkPurchase: (owner: CloudProfile) => { readonly purchase: PurchaseVisibility; readonly codesAvailable: boolean }!!R): Stream.Stream<Profile, never, R> {
  return Stream.unwrap(effect {
    const opened = try exit(readAccount(cloud))
    if (Exit.isFailure(opened)) return Stream.succeed(profileFailure(Cause.squash(opened.cause)))
    const owner = opened.value
    const profile = profileOf(owner)
    if (place !== "Account") return Stream.succeed<Profile>(profile)
    const current = { ...profile, ...(try checkPurchase(owner)) }
    return Stream.concat(Stream.succeed<Profile>({ ...current, plan: { tag: "CheckingPlan" } }), Stream.flatMap(Stream.fromEffect(readPlan(cloud, owner, current)), untilExpiry))
  })
}

const settingsIsInFront = (shell: Shell.Shell, settings: Settings.Settings): boolean =>
  Shell.showing(shell, "Settings") && shell.assistant !== "Full" && settings.page === "Top"

export const accountIsInFront = effect {
  const shell = try (try Shell.Machine).get()
  const settings = try (try Settings.Machine).get()
  const layers = try (try Layers.Machine).get()
  return settingsIsInFront(shell, settings) && Layers.top(layers).id === accountLayer && (try (try Device).showing())
}

/** Drops the offer receipt and retires the read when the owner leaves the catalog. */
export effect function closeCatalog(publish: (catalog: Catalog | undefined) => void) {
  const billing = try Billing.Machine
  try sync(() => publish(undefined))
  try contained(billing.send({ type: "retireOffers" }), "closing Plans")
}

/** Starts a catalog read only while the Account sheet is open. */
export effect function openCatalog() {
  if (!(try accountIsInFront)) return
  try contained((try Billing.Machine).send({ type: "askOffers", signIn: 1 }), "asking for Plans")
}

/** Publishes only the offer receipt of the current Account visit. */
export effect function readCatalog(ticket: number, publish: (catalog: Catalog | undefined) => void) {
  const billing = try Billing.Machine
  const cloud = try Cloud
  if (!(try accountIsInFront) || !Billing.canOffersRead(try billing.get(), ticket)) return
  const owner = readAccount(cloud) catch () => undefined
  const buyer = owner === undefined ? undefined : try buyerOf(owner)
  const result = owner === undefined ? undefined : try readForOwner(cloud, owner, profileOf(owner), (signal) => cloud.client.plans({ signal }))
  if (!(try accountIsInFront) || !Billing.canOffersRead(try billing.get(), ticket)) return
  const receipt = try contained(billing.send({ type: "offersRead", ticket, ok: result?.tag === "Current" }), "reading Plans")
  if (receipt && result?.tag === "Current" && (try accountIsInFront)) {
    const settled = try billing.get()
    if (settled.offers.status !== "Loaded" || settled.offers.ticket !== ticket) return
    const offers = result.answer.toSorted((a, b) => a.amountCents - b.amountCents)
    try sync(() => publish({ ticket, offers, buyer }))
  }
}

/** Reads the account while Settings or its Account sheet is visible. Leaving interrupts the read and drops its answer. */
export function profileLive<R>(publish: (value: Profile) => void, publishCatalog: (catalog: Catalog | undefined) => void, refreshed: Stream.Stream<void>, checkPurchase: (owner: CloudProfile) => { readonly purchase: PurchaseVisibility; readonly codesAvailable: boolean }!!R) {
  return started(effect {
    const { changes } = try Layers.Machine
    const cloud = try Cloud
    const device = try Device
    const shell = try Shell.Machine
    const settings = try Settings.Machine
    const pages = Stream.zipLatest(shell.changes, settings.changes)
    const active = Stream.changes(Stream.map(Stream.zipLatest(changes, pages), ([layers, [shell, settings]]) => {
      if (!settingsIsInFront(shell, settings)) return "Away"
      return Layers.top(layers).id === accountLayer ? "Account" : "Settings"
    }))
    const visible = Stream.switchMap(active, (place) => place === "Away"
      ? Stream.succeed("Away" as const)
      : Stream.map(Stream.changes(Stream.concat(Stream.fromEffect(device.showing()), device.visible)), (showing) => showing ? place : "Away" as const))
    const watched = Stream.switchMap(visible, (place) => Stream.unwrap(effect {
      if (place !== "Account") try closeCatalog(publishCatalog)
      return place === "Away"
        ? Stream.succeed<Profile>(reading)
        : Stream.switchMap(Stream.concat(Stream.succeed(undefined), refreshed), () =>
          Stream.concat(Stream.succeed<Profile>(reading), visit(cloud, place, checkPurchase)))
    }))
    try Stream.runForEach(watched, (value) => sync(() => publish(value)))
  }, "reading Account")
}
