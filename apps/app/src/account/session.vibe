// spec/account/session.md, "Story: Sign in once for Cloud's managed services"; spec/account/session.md, "A new account, and an earlier sign-in left unconfirmed, are told for the sign-in that reported them"; spec/account/session.md, "Story: Keep my sign-in working until I sign out"; spec/account/session.md, "Story: Hear why a sign-in from the browser did not finish"; spec/account/session.md, "Story: Use Cloud only for managed services"
import {
  type Account, type IncompleteCode, type RouteKind, type Session, type SessionEffect,
  Machine as SessionMachine, isSignedIn, restoreRetryMs, routeAdmitted, stored as storedSession
} from "../../gen/account__session.effect.vibe"
import { Build } from "../platform/build.vibe"
import { buildCloudEnvironment, environmentName } from "../platform/build-live.vibe"
import { cloudResidentPreview } from "../platform/build-flags.ts"
import { Cloud } from "../platform/cloud.vibe"
import { Native } from "../platform/native.vibe"
import { Resident } from "../platform/resident.vibe"
import { ownerKey } from "../platform/storage.vibe"
import { deployment } from "./deployment.ts"
import { ensureResident, unbindInference } from "./inference.vibe"
import { Completed, CredentialIdentity, Incomplete, Renewal, Renewed, UserAnswer } from "./signIn.schema.vibe"

const plugin = "AlphaCloudSignIn"

/** A managed route this build does not admit was asked for; nothing was sent. */
export error RouteRefused { route: RouteKind }

/** A sign-in return that did not finish, for the notice it shows. */
export interface IncompleteNotice { readonly restarted: boolean }

/** What the host said of a completed sign-in: whether Cloud created the account, and whether the key it replaced is unconfirmed. */
export interface SignInNews { readonly created: boolean; readonly priorUnconfirmed: boolean }

/** No news: an ordinary sign-in of an existing account that replaced nothing left active. */
export const noNews: SignInNews = { created: false, priorUnconfirmed: false }

/** The news a host answer or retained completion carries. */
export function newsOf(answer: { readonly accountCreated?: unknown; readonly previousSignIn?: unknown }): SignInNews {
  return { created: answer.accountCreated === true, priorUnconfirmed: answer.previousSignIn === "unconfirmed" }
}

/** The account other areas fence their requests and results to: its generation, or 0 while signed out. */
export function ownerOf(s: Session): number {
  return isSignedIn(s.phase) ? s.generation : 0
}

/** The storage namespace of the account signed in now, or `device` while signed out. */
export function ownerNameOf(s: Session): string {
  return isSignedIn(s.phase) ? `${s.account.userId}.${s.account.organizationId}` : "device"
}

/** The signed-in Cloud account, its key's expiry and renewal, and sign-out. */
export service CloudSession {
  readonly changes: Stream.Stream<Session>
  readonly notices: Stream.Stream<IncompleteNotice>
  current(): Session!!
  /** The owner number of spec/account/session.md for the account signed in now, or 0. */
  owner(): number!!
  /** A key under `alpha/<owner>/` for state that belongs to the account signed in now. */
  ownerKey(key: string): string!!
  /** Load, restore the saved sign-in, settle startup, and follow the host's sign-in events; runs for the app's life. */
  run(): void!!
  /** A sign-in finished: adopt the account Cloud names for the key the host stored, with what the host said of it. */
  adopt(news: SignInNews, expectedCredentialId?: string): void!!
  /** A sign-in attempt holds the slot, or released it. */
  attempt(started: boolean): void!!
  /** Sign out of the account signed in now; whether Cloud confirmed the revocation. */
  signOut(): boolean!!
  /** Cloud answered 401 for the saved key. */
  rejected(): void!!
  /** Refuses a route this build may not send. */
  admit(route: RouteKind): void!RouteRefused
}

export effect function readCredentialIdentity(native: Native.Shape, environment: string) {
  return try Schema.decodeUnknownEffect(CredentialIdentity)(try native.invoke(plugin, "credentialIdentity", { environment }))
}

effect function readIdentity(native: Native.Shape, environment: string) {
  const identity = try readCredentialIdentity(native, environment)
  if (identity.credentialId === null || identity.expiresAt === undefined) return undefined
  return { ...identity, credentialId: identity.credentialId, expiresAt: identity.expiresAt }
}

effect function readUser(cloud: Cloud.Shape) {
  const answer = try Schema.decodeUnknownEffect(UserAnswer)(try cloud.json("GET", "/api/v1/user"))
  return answer.success ? answer.data : undefined
}

/** The account Cloud names for the key the host holds now, with whether Cloud confirmed that key. */
effect function readAccount(native: Native.Shape, cloud: Cloud.Shape, environment: string) {
  const identity = readIdentity(native, environment) catch () => undefined
  if (identity === undefined) return undefined
  const user = readUser(cloud) catch () => undefined
  if (user === undefined) return undefined
  const account: Account = { userId: user.id, organizationId: user.organization_id, credentialId: identity.credentialId, expiresAt: identity.expiresAt }
  return { account, confirmed: identity.activationPending !== true }
}

const incompleteCodes = { "app-link-unverified": "AppLinkUnverified", storage: "StorageFailed", "activation-expired": "ActivationExpired" } as const satisfies Record<string, IncompleteCode>

/** The session service over the stored session machine. */
export const sessionService = Layer.effect(CloudSession, effect {
  const machine = try SessionMachine
  const native = try Native
  const cloud = try Cloud
  const resident = try Resident
  const build = try Build
  const notices = try PubSub.unbounded<IncompleteNotice>()
  const cloudEnvironment = buildCloudEnvironment(build.info)
  const environment = environmentName(cloudEnvironment)

  effect function send(event: Parameters<typeof machine.send>[0]) {
    const step = machine.send(event) catch () => undefined
    if (step !== undefined && "out" in step) try perform(step.out)
    return step
  }

  effect function revoke(credentialId: string) {
    const held = readIdentity(native, environment) catch () => undefined
    if (held === undefined || held.credentialId !== credentialId) return false
    const answer = effect {
      try cloud.json("DELETE", "/api/v1/api-keys/current")
      return true
    } catch () => false
    return answer
  }

  effect function perform(out: ReadonlyArray<SessionEffect>): void!! {
    for (const effectOf of out) {
      match (effectOf) {
        when { tag: "EnsureResident" }: try ensureResident(resident);
        when { tag: "UnbindInference" }: try unbindInference(native);
        when { tag: "RevokeKey", let credentialId }: try effect {
          const revoked = try revoke(credentialId)
          native.invoke(plugin, "clearCredentialState") catch () => undefined
          try send({ type: "signOutSettled", revoked })
        };
        when { tag: "ShowIncomplete", let restarted }: try PubSub.publish(notices, { restarted });
      }
    }
  }

  effect function adopt(news: SignInNews, expectedCredentialId?: string) {
    const read = try readAccount(native, cloud, environment)
    if (read === undefined || (expectedCredentialId !== undefined && read.account.credentialId !== expectedCredentialId)) return
    try send(read.confirmed
      ? { type: "signInCompleted", account: read.account, created: news.created, priorUnconfirmed: news.priorUnconfirmed }
      : { type: "restore", account: read.account, confirmed: false })
  }

  /** A saved key whose account Cloud could not name at startup: asked again after one minute, doubling to fifteen. */
  effect function restoreLater() {
    let tries = 0
    while (true) {
      tries = tries + 1
      try sleep(Duration.millis(restoreRetryMs(tries)))
      const s = try machine.get()
      if (isSignedIn(s.phase)) return
      if ((readIdentity(native, environment) catch () => undefined) === undefined) return
      if (s.holder !== "Free") continue
      const read = try readAccount(native, cloud, environment)
      if (read !== undefined) {
        try send({ type: "restore", account: read.account, confirmed: read.confirmed })
        return
      }
    }
  }

  effect function renewalCheck() {
    const answer = effect {
      return try Schema.decodeUnknownEffect(Renewal)(try native.invoke(plugin, "renewSignIn", { environment }))
    } catch () => undefined
    if (answer === undefined) return
    if (answer.status === "renewed" && answer.credentialId !== undefined && answer.expiresAt !== undefined) {
      try send({ type: "renewed", credentialId: answer.credentialId, expiresAt: answer.expiresAt })
    }
    try send({ type: "renewalReported", warning: answer.expiryWarning, refused: answer.keyRefused === true })
  }

  effect function expiryWatch() {
    while (true) {
      const s = try machine.get()
      const now = try Clock.currentTimeMillis
      if (isSignedIn(s.phase) && s.phase !== "KeyExpired" && s.account.expiresAt <= now) try send({ type: "expire", now })
      try sleep("1 minute")
    }
  }

  effect function follow(event: string, handle: (raw: unknown) => void!!) {
    for try (const raw of native.listen(plugin, event)) {
      try handle(raw)
    }
  }

  return {
    changes: machine.changes,
    notices: Stream.fromPubSub(notices),
    current: () => machine.get(),
    effect owner() { return ownerOf(try machine.get()) },
    effect ownerKey(key: string) {
      const s = try machine.get()
      return ownerKey(ownerNameOf(s), key)
    },
    effect run() {
      try send({ type: "load", deployment, environment: cloudEnvironment, testMocks: build.info.testMocks, preview: cloudResidentPreview(build.info.variant !== "browser") })
      const s = try machine.get()
      let unnamed = false
      if (!isSignedIn(s.phase) && (try native.available(plugin))) {
        const read = try readAccount(native, cloud, environment)
        if (read !== undefined) try send({ type: "restore", account: read.account, confirmed: read.confirmed })
        else unnamed = (readIdentity(native, environment) catch () => undefined) !== undefined
      }
      try send({ type: "startupSettles" })
      if (unnamed) fork.detached restoreLater()
      try ensureResident(resident)
      try renewalCheck()
      try.all [
        ignore(follow("signInCompleted", effect (raw) => {
          const completed = Schema.decodeUnknownEffect(Completed)(raw) catch () => ({})
          try adopt(newsOf(completed))
        })),
        ignore(follow("signInIncomplete", effect (raw) => {
          const read = Schema.decodeUnknownEffect(Incomplete)(raw) catch () => undefined
          if (read !== undefined) try send({ type: "incompleteArrives", code: incompleteCodes[read.code] })
        })),
        ignore(follow("signInRenewed", effect (raw) => {
          const read = Schema.decodeUnknownEffect(Renewed)(raw) catch () => undefined
          if (read !== undefined) try send({ type: "renewed", credentialId: read.credentialId, expiresAt: read.expiresAt })
        })),
        expiryWatch()
      ]
    },
    adopt,
    effect attempt(started: boolean) {
      try send(started ? { type: "attemptStarts" } : { type: "attemptEnds" })
    },
    effect signOut() {
      const s = try machine.get()
      if (!isSignedIn(s.phase)) return false
      try send({ type: "beginSignOut", credentialId: s.account.credentialId })
      return (try machine.get()).revocation === "Revoked"
    },
    effect rejected() { try send({ type: "rejected" }) },
    effect admit(route: RouteKind) {
      const s = try machine.get()
      if (!routeAdmitted(route, s.testMocks, s.deployment)) throw new RouteRefused({ route })
    }
  }
})

/** The session service with its machine, stored on the device: it outlives every account it names. */
export const sessionLayer = Layer.provideMerge(sessionService, storedSession(ownerKey("device", "account/session")))
