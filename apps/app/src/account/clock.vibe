// spec/app/account/plan.md, "Time only moves on, and a member's or funded answer, or a kept record, runs out when its time comes"; spec/app/account/session.md, "The current sign-in is its number while an account is known to be signed in, and none otherwise"
import { Time } from "../runtime/index.vibe"

module pure {
  /** Converts a timestamp in milliseconds or seconds into whole Unix seconds. @throws {never} */
  export function toSeconds(timestamp: number): number {
    if (!Number.isFinite(timestamp) || timestamp <= 0) return 0
    return timestamp >= 1e11 ? Math.floor(timestamp / 1000) : Math.floor(timestamp)
  }

  /** Deterministic positive integer identifier for mapping string Cloud account and grant IDs into spec machine IDs. @throws {never} */
  export function accountIdNumber(identity: string): number {
    if (identity === "") return 0
    let hash = 0x811c9dc5
    for (let at = 0; at < identity.length; at += 1) {
      hash = Math.imul(hash ^ identity.charCodeAt(at), 0x01000193)
    }
    return ((hash >>> 1) % 1_000_000_000) + 1
  }
}
import { accountIdNumber, toSeconds } from pure
export { accountIdNumber, toSeconds }

/** Adapts Alpha's millisecond Time service to whole seconds for the account specs. */
export const secondsTime = Layer.effect(Time, effect {
  const ms = try Time
  return {
    now: () => Effect.map(ms.now(), (value) => Math.floor(value / 1000)),
    latest: () => Effect.map(ms.latest(), (value) => Math.floor(value / 1000)),
    until: (seconds: number) => ms.until(seconds * 1000),
  }
})

/** Current time in whole seconds from the root millisecond Time service. */
export effect function nowSeconds(): number!!Time {
  return Math.floor((try (try Time).now()) / 1000)
}
