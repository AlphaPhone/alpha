// spec/app/photos/index.md, "Only the newest read's answer is shown, only while Photos is showing, and a further page only adds older items"
import type { AlbumId, MediaCursor, MediaItem, OwnedAlbum, Reviewed } from "@elizaos/os/bridges/media"

/** An item as the phone last listed or read it: what a change names and what the grid and the Viewer draw. */
export interface Seen {
  readonly item: MediaItem
  /** Whether it was listed from Alpha's own captures, which the phone reads by `read`, not `readPermitted`. */
  readonly own: boolean
}

/**
 * The numbers Photos gives the phone's items and albums, which the rules hold. An item is numbered by the time the
 * phone lists it at, the newest highest, so that a further page, which holds older items, numbers them lower; the
 * revision the phone's library is at, one higher each time it says the library changed; and where the last page
 * the phone gave left off. None of it is kept through a restart, as the rules keep nothing.
 */
export service Library {
  number(item: MediaItem, own: boolean): number!!
  seen(photo: number): Option.Option<Seen>!!
  reviewed(photos: ReadonlyArray<number>): Reviewed[]!!
  albumNumber(album: OwnedAlbum): number!!
  album(number: number): Option.Option<OwnedAlbum>!!
  revision(): number!!
  moved(): number!!
  cursor(): (MediaCursor | undefined)!!
  leaveOff(next: MediaCursor | null): void!!
}

/** The most items the phone lists at one millisecond that keep an order of their own. */
const tied = 1_000

/** The numbers, in memory from Photos' first load. */
export const library = Layer.sync(Library, () => {
  const numbers = new Map<string, number>()
  const items = new Map<number, Seen>()
  const albumNumbers = new Map<AlbumId, number>()
  const albums = new Map<number, OwnedAlbum>()
  const ties = new Map<number, number>()
  let revision = 1
  let next: MediaCursor | undefined
  return {
    number: (item: MediaItem, own: boolean) => sync(() => {
      const at = Math.max(1, Math.trunc(item.date))
      const known = numbers.get(item.id)
      const photo = known ?? at * tied + (tied - 1 - Math.min(tied - 1, ties.get(at) ?? 0))
      if (known === undefined) {
        numbers.set(item.id, photo)
        ties.set(at, (ties.get(at) ?? 0) + 1)
      }
      items.set(photo, { item, own })
      return photo
    }),
    seen: (photo: number) => sync(() => Option.fromNullishOr(items.get(photo))),
    reviewed: (photos: ReadonlyArray<number>) => sync(() => photos.flatMap((photo) => {
      const seen = items.get(photo)
      return seen === undefined ? [] : [{ id: seen.item.id, revision: seen.item.revision }]
    })),
    albumNumber: (album: OwnedAlbum) => sync(() => {
      const number = albumNumbers.get(album.id) ?? albumNumbers.size + 1
      albumNumbers.set(album.id, number)
      albums.set(number, album)
      return number
    }),
    album: (number: number) => sync(() => Option.fromNullishOr(albums.get(number))),
    revision: () => sync(() => revision),
    moved: () => sync(() => (revision += 1)),
    cursor: () => sync(() => next),
    leaveOff: (cursor: MediaCursor | null) => sync(() => { next = cursor ?? undefined }),
  }
})
