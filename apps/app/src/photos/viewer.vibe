// spec/app/photos/viewer.md, "Story: Look at a photo or video"; spec/app/photos/viewer.md, "Story: Edit a photo or trim a video"; spec/app/photos/viewer.md, "Story: Keep a copy through a restart"; spec/app/photos/viewer.md, "Story: Share what I am looking at"
import type { CropRect, EditPreview, MediaItem, Reviewed, VideoEditSession } from "@elizaos/os-bridges"
import { MMS_MAX_TOTAL_BYTES } from "@elizaos/os-bridges"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Library from "../../gen/app__photos.effect.vibe"
import type { Actor } from "../../gen/app__photos__actor.effect.vibe"
import * as Viewer from "../../gen/app__photos__viewer.effect.vibe"
import { PhotosPort, canReplaceBrowserEdit, isBrowserEdit, photoEmailMaxBytes, type BrowserSource, type PhotoAttachmentUse } from "../platform/photos.vibe"
import { photoRefusal, renderBrowserPhoto, type BrowserEditFrame, type PhotoLook } from "../platform/photoCanvas.vibe"
import { clipRefusal, renderBrowserClip } from "../platform/videoCanvas.vibe"
import { Catalog } from "./catalog.vibe"
import { answer, applying, reacting, run, started, together, type Job, migratedStore } from "../runtime/reactor.vibe"
import { createShelf, type Shelf } from "../runtime/shelf.vibe"
import { say, type Said } from "../notices/toasts.vibe"
import { handOver } from "../inbox/adding.vibe"
import { attachToAlpha } from "../assistant/attachments.vibe"
import { handOverPicture, pictureBytes, pictureMessagingReady } from "../messages/composer.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import type { Machine as Toasts } from "../../gen/app__notices__toasts.effect.vibe"

module sources {
  import { Schema } from "effect"
  import { EditReceipt } from "@elizaos/os-bridges"
  import type { EditOperationId } from "@elizaos/os-bridges"

  /** @throws {never} */
  export function editOperation(raw: string | undefined): EditOperationId | undefined {
    const got = Schema.decodeUnknownOption(EditReceipt)({ status: "unknown", operationId: raw })
    return got._tag === "Some" ? got.value.operationId : undefined
  }
  /** @throws {never} */
  export const localUri = (file: Blob): string => URL.createObjectURL(file)
  /** @throws {never} */
  export const releaseUri = (uri: string): void => URL.revokeObjectURL(uri)
  /** @throws {never} */
  export const browserOperation = (): string => `browser-edit:${crypto.randomUUID()}`

  export async function attachmentBytes(source: string | Blob, name: string) {
    const response = typeof source === "string" && source.startsWith("data:image/") ? await fetch(source) : undefined
    const file = source instanceof Blob ? source : response?.ok === true ? await response.blob() : undefined
    if (file === undefined || !file.type.startsWith("image/") || file.size === 0 || file.size > 5_000_000) return undefined
    return new Promise<{ name: string; mimeType: string; size: number; data: string } | undefined>((resolve) => {
      const reader = new FileReader()
      reader.onload = () => resolve(typeof reader.result === "string"
        ? { name, mimeType: file.type, size: file.size, data: reader.result.slice(reader.result.indexOf(",") + 1) } : undefined)
      reader.onerror = () => resolve(undefined)
      reader.readAsDataURL(file)
    })
  }
}
import { attachmentBytes, browserOperation, editOperation, localUri, releaseUri } from sources

type BrowserSession = { readonly kind: "browser"; readonly value: { readonly operationId: string } }
type Session = { readonly kind: "still"; readonly value: EditPreview } | { readonly kind: "clip"; readonly value: VideoEditSession } | BrowserSession

export interface MediaView {
  readonly photo: number
  readonly uri: string
  readonly local: boolean
  readonly item?: MediaItem
  readonly browser?: BrowserSource
}

export interface EditView {
  readonly revision: number
  readonly image: string
  readonly width: number
  readonly height: number
  readonly canReplace: boolean
  readonly frame?: BrowserEditFrame
}

export service OpenedPhoto {
  readonly rendering: Semaphore.Semaphore
  current(): MediaView!!
  mediaShelf(): Shelf<MediaView>!!
  hold(media: MediaView): void!!
  session(): (Session | undefined)!!
  holdSession(value: Session | undefined): void!!
  preview(): (EditView | undefined)!!
  previewShelf(): Shelf<EditView | undefined>!!
  holdPreview(value: EditView | undefined): void!!
}

const opened = Layer.effect(OpenedPhoto, effect {
  const rendering = try Semaphore.make(1)
  const initialMedia: MediaView = { photo: 0, uri: "", local: false }
  const mediaStore = createShelf<MediaView>(initialMedia, { reset: () => initialMedia })
  let session: Session | undefined
  const previewStore = createShelf<EditView | undefined>(undefined, { reset: () => undefined })
  try addFinalizer(() => sync(() => {
    const media = mediaStore.get()
    const preview = previewStore.get()
    if (media.local) releaseUri(media.uri)
    if (preview?.frame !== undefined) releaseUri(preview.image)
    mediaStore.reset()
    previewStore.reset()
  }))
  return {
    rendering,
    current: () => sync(() => mediaStore.get()),
    mediaShelf: () => sync(() => mediaStore),
    hold: (next: MediaView) => sync(() => {
      const media = mediaStore.get()
      if (media.local && media.uri !== next.uri) releaseUri(media.uri)
      mediaStore.set(next)
    }),
    session: () => sync(() => session),
    holdSession: (next: Session | undefined) => sync(() => { session = next }),
    preview: () => sync(() => previewStore.get()),
    previewShelf: () => sync(() => previewStore),
    holdPreview: (next: EditView | undefined) => sync(() => {
      const preview = previewStore.get()
      if (preview?.frame !== undefined && preview.image !== next?.image) releaseUri(preview.image)
      previewStore.set(next)
    }),
  }
})

const emptyMedia: MediaView = { photo: 0, uri: "", local: false }
const failed = (ticket: number): Viewer.Event => ({ type: "loaded", ticket, ok: false, kind: "Still", duration: 0, revision: 0, favourite: false })

effect function loaded(ticket: number, photo: number): Viewer.Event!!(Viewer.Machine | Catalog | OpenedPhoto | PhotosPort) {
  const viewing = try Viewer.Machine
  const cache = try Catalog
  const { rows } = try cache.displayed()
  const row = rows.get(photo)
  if (row === undefined) return failed(ticket)
  const { phone, capture } = try PhotosPort
  if (row.kind === "browser") {
    const source = capture(row.item.id) catch () => undefined
    if (source === undefined) return failed(ticket)
    const kind = source.item.mimeType.startsWith("video/") ? "Clip" : "Still"
    const duration = kind === "Clip" ? Math.max(1, Math.round((source.item.duration ?? 0) * 10)) : 0
    if (!Viewer.canLoaded(try viewing.get(), ticket, kind, duration, "Phone")) return failed(ticket)
    try (try OpenedPhoto).hold({ photo, uri: localUri(source.file), local: true, browser: source })
    return { type: "loaded", ticket, ok: true, kind, duration, revision: try cache.revision(), favourite: source.item.favorite === true }
  }
  if (Option.isNone(phone)) return failed(ticket)
  const item = tryPromise(() => phone.value.read({ id: row.item.id, includeTrashed: row.item.trashed === true })) catch () => undefined
  if (item === undefined) return failed(ticket)
  const kind = item.kind === "video" ? "Clip" : "Still"
  const duration = kind === "Clip" ? Math.max(1, Math.round((item.duration ?? 0) * 10)) : 0
  if (!Viewer.canLoaded(try viewing.get(), ticket, kind, duration, "Phone")) return failed(ticket)
  const uri = kind === "Clip" ? item.path : item.image
  if (uri === undefined || uri === "") return failed(ticket)
  try (try OpenedPhoto).hold({ photo, uri, local: false, item })
  return { type: "loaded", ticket, ok: true, kind, duration, revision: try cache.revision(), favourite: item.favorite === true }
}

const looks: Record<Viewer.Look, PhotoLook> = { Original: "none", Vivid: "vivid", Warm: "warm", Cool: "cool", Mono: "mono", Fade: "fade", Noir: "noir" }
export const photoLook = (look: Viewer.Look): PhotoLook => looks[look]

function cropRect(bounds: Viewer.CropBounds): CropRect | undefined {
  const unit = Viewer.cropUnits
  if (bounds.width === unit && bounds.height === unit) return undefined
  return { x: bounds.x / unit, y: bounds.y / unit, width: bounds.width / unit, height: bounds.height / unit }
}

const operationKey = (attempt: number): string => `alpha/photos/edit/${attempt}`

/** An edit preview is tied to both the open item and the latest preview revision. */
effect function rendered(revision: number, edit: Viewer.Edit, cropSource: boolean): Viewer.Event!!(Viewer.Machine | OpenedPhoto | PhotosPort) {
  const open = try OpenedPhoto
  return try open.rendering.withPermits(1)(Effect.uninterruptible(rendering(revision, edit, cropSource)))
}

function editRefusalFromCause(cause: unknown): Viewer.Refusal {
  const inner = typeof cause === "object" && cause !== null && "cause" in cause ? cause.cause : cause
  const code = typeof inner === "object" && inner !== null && "code" in inner && typeof inner.code === "string" ? inner.code.toUpperCase() : ""
  if (code.includes("ANIMATED")) return "Animated"
  if (code.includes("NO_SPACE") || code.includes("ENOSPC") || code.includes("NO_ROOM")) return "NoRoom"
  if (code.includes("TOO_LARGE")) return "TooLarge"
  if (code.includes("TOO_LONG")) return "TooLong"
  return "NoEditor"
}

effect function rendering(revision: number, edit: Viewer.Edit, cropSource: boolean): Viewer.Event!!(Viewer.Machine | OpenedPhoto | PhotosPort) {
  const open = try OpenedPhoto
  const { phone } = try PhotosPort
  const current = try open.current()
  const target = current.item
  const model = try Viewer.Machine
  const pending = try model.get()
  if (!Viewer.canPreviewed(pending, revision, "Phone") || pending.open !== current.photo) return { type: "previewed", revision, ok: false }
  if (current.browser !== undefined) return try browserPreview(current, revision, edit, cropSource)
  let session = try open.session()
  if (session?.kind === "browser" || Option.isNone(phone) || target === undefined) return { type: "editRefused", why: "NoEditor" }
  if (target.kind === "video" && (target.duration ?? 0) > 300) return { type: "editRefused", why: "TooLong" }
  if (target.size > (target.kind === "video" ? 104857600 : 33554432)) return { type: "editRefused", why: "TooLarge" }
  const item = { id: target.id, revision: target.mutationRevision ?? target.revision }
  if (session === undefined) {
    let refusal: Viewer.Refusal = "NoEditor"
    if (target.kind === "video") {
      const attempted = try exit(tryPromise(() => phone.value.beginVideoEdit(item)))
      if (Exit.isSuccess(attempted)) session = { kind: "clip", value: attempted.value }
      else refusal = editRefusalFromCause(Cause.squash(attempted.cause))
    } else {
      const attempted = try exit(tryPromise(() => phone.value.beginEdit(item)))
      if (Exit.isSuccess(attempted)) session = { kind: "still", value: attempted.value }
      else refusal = editRefusalFromCause(Cause.squash(attempted.cause))
    }
    if (session === undefined) return { type: "editRefused", why: refusal }
    const result = try model.get()
    if (!result.editing || result.open !== current.photo) {
      const { sessionId } = session.value
      const video = session.kind === "clip"
      try ignore(tryPromise(() => video ? phone.value.cancelVideoEdit(sessionId) : phone.value.cancelEdit(sessionId)))
      return { type: "previewed", revision, ok: false }
    }
    try open.holdSession(session)
  }
  const still = session.kind === "still" ? session.value : undefined
  const preview = still === undefined ? undefined : (tryPromise(() => phone.value.previewEdit({ sessionId: still.sessionId, rotation: edit.turns * 90, filter: looks[edit.look], cropRect: cropSource ? undefined : cropRect(edit.bounds) })) catch () => undefined)
  const ready = session.kind === "clip" || preview !== undefined
  if (ready && Viewer.canPreviewed(try model.get(), revision, "Phone")) try open.holdPreview({ revision, image: preview?.image ?? current.uri, width: preview?.width ?? session.value.width, height: preview?.height ?? session.value.height, canReplace: preview?.canReplace === true })
  return { type: "previewed", revision, ok: ready }
}

effect function browserPreview(current: MediaView, revision: number, edit: Viewer.Edit, cropSource: boolean): Viewer.Event!!(Viewer.Machine | OpenedPhoto) {
  const open = try OpenedPhoto
  const model = try Viewer.Machine
  const source = current.browser
  if (source === undefined) return { type: "editRefused", why: "NoEditor" }
  const session = try open.session()
  if (source.item.mimeType.startsWith("video/")) {
    const why = clipRefusal({ file: source.file, width: source.item.width, height: source.item.height, duration: source.item.duration ?? 0 })
    if (why !== undefined) return { type: "editRefused", why }
    if (session === undefined) try open.holdSession({ kind: "browser", value: { operationId: browserOperation() } })
    try open.holdPreview({ revision, image: current.uri, width: source.item.width, height: source.item.height, canReplace: false })
    return { type: "previewed", revision, ok: true }
  }
  if (session === undefined) {
    const refusal = tryPromise(() => photoRefusal(source.file, source.item.width, source.item.height)) catch () => "NoEditor" as const
    if (refusal !== undefined) {
      const pending = try model.get()
      return pending.open === current.photo && Viewer.canPreviewed(pending, revision, "Phone")
        ? { type: "editRefused", why: refusal } : { type: "previewed", revision, ok: false }
    }
  }
  const frame = tryPromise(() => renderBrowserPhoto(source.file, { turns: edit.turns, look: looks[edit.look], crop: cropSource ? undefined : cropRect(edit.bounds) })) catch () => undefined
  const pending = try model.get()
  const valid = frame !== undefined && pending.open === current.photo && Viewer.canPreviewed(pending, revision, "Phone")
  if (valid) {
    if (session === undefined) try open.holdSession({ kind: "browser", value: { operationId: browserOperation() } })
    try open.holdPreview({ ...frame, revision, image: localUri(frame.file), canReplace: canReplaceBrowserEdit(source.item.id), frame })
  }
  return { type: "previewed", revision, ok: valid }
}

type Save = Extract<Viewer.Effect, { tag: "WriteCopy" }>

effect function written(request: Save): Viewer.Event!!(Library.Machine | Viewer.Machine | OpenedPhoto | PhotosPort | Catalog | KeyValueStore.KeyValueStore) {
  const { phone, saveEdit } = try PhotosPort
  const open = try OpenedPhoto
  const current = try open.current()
  const model = try (try Viewer.Machine).get()
  const session = try open.session()
  const store = try KeyValueStore.KeyValueStore
  const { attempt, photo, revision, edit, replace } = request
  const answer = { type: "saved", attempt, known: true, confirmed: false } as const
  if (photo !== current.photo || revision !== model.revision || session === undefined) return answer
  const preview = session.kind === "browser" ? try open.preview() : undefined
  const kept = store.set(operationKey(attempt), session.value.operationId) catch () => false
  if (kept === false) return answer
  if (session.kind === "browser") {
    const source = current.browser
    if (source === undefined || preview?.revision !== model.preview.revision) return answer
    const video = source.item.mimeType.startsWith("video/")
    const frame = video ? (tryPromise({
      try: (signal) => renderBrowserClip({ file: source.file, width: source.item.width, height: source.item.height, duration: source.item.duration ?? 0 },
        { start: edit.start / 10, end: edit.end / 10, turns: edit.turns, crop: edit.cropped }, signal),
      catch: (cause) => cause,
    }) catch () => undefined) : preview.frame
    if (frame === undefined) return answer
    const receipt = saveEdit({ operation: session.value.operationId, source: source.item, frame, replace: replace && !video }) catch () => undefined
    if (receipt?.status !== "saved") {
      if (receipt !== undefined && (try open.session()) === session) {
        try open.holdSession({ kind: "browser", value: { operationId: browserOperation() } })
        if (receipt.status === "stale") {
          try (try Catalog).changed()
          try ignore((try Library.Machine).send({ type: "libraryChanged" }, "Phone"))
        }
      }
      return { ...answer, known: receipt !== undefined }
    }
    const visible = try (try Viewer.Machine).get()
    if (receipt.replaced && visible.visible && visible.open === current.photo && visible.revision === revision
      && (try open.current()) === current) {
      const item = { ...source.item, id: receipt.id, name: receipt.name ?? source.item.name, revision: session.value.operationId, mimeType: frame.file.type, size: frame.file.size,
        width: frame.width, height: frame.height, duration: frame.duration, thumbnail: frame.thumbnail }
      try open.hold({ photo, uri: localUri(frame.file), local: true, browser: { item, file: frame.file } })
    }
    return { ...answer, confirmed: true }
  }
  if (Option.isNone(phone)) return answer
  const { sessionId } = session.value
  const reply = tryPromise(() => session.kind === "clip"
    ? phone.value.saveVideoEdit({ sessionId, rotation: edit.turns * 90, crop: edit.cropped, start: edit.start / 10, end: edit.end / 10 })
    : phone.value.saveEdit({ sessionId, rotation: edit.turns * 90, filter: looks[edit.look], cropRect: cropRect(edit.bounds), replace })) catch () => undefined
  if (reply?.status === "saved") {
    try (try Catalog).changed()
    if (replace && current.item !== undefined) {
      const refreshed = tryPromise(() => phone.value.read({ id: current.item!.id })) catch () => undefined
      const visible = try (try Viewer.Machine).get()
      if (refreshed !== undefined && visible.visible && visible.open === current.photo && (try open.current()) === current) {
        const uri = refreshed.kind === "video" ? (refreshed.path ?? current.uri) : (refreshed.image ?? current.uri)
        try open.hold({ photo, uri, local: false, item: refreshed })
      }
    }
    try ignore((try Library.Machine).send({ type: "libraryChanged" }, "Phone"))
    return { ...answer, confirmed: true }
  }
  return { ...answer, known: reply !== undefined && reply.status !== "unknown" && reply.status !== "incomplete" }
}

effect function located(ticket: number, attempt: number): Viewer.Event!!(PhotosPort | KeyValueStore.KeyValueStore) {
  const { phone, editResult } = try PhotosPort
  const store = try KeyValueStore.KeyValueStore
  const raw = store.get(operationKey(attempt)) catch () => undefined
  if (raw !== undefined && isBrowserEdit(raw)) {
    const receipt = editResult(raw) catch () => undefined
    return { type: "copyFound", ticket, ok: receipt !== undefined, found: receipt?.status === "saved" }
  }
  const id = editOperation(raw)
  const reply = Option.isNone(phone) || id === undefined ? undefined : (tryPromise(() => phone.value.editResult(id)) catch () => undefined)
  return { type: "copyFound", ticket, ok: reply !== undefined && reply.status !== "unknown" && reply.status !== "incomplete", found: reply?.status === "saved" }
}

effect function closeEditor() {
  const open = try OpenedPhoto
  const session = try open.session()
  if (session === undefined) return
  try open.holdSession(undefined)
  try open.holdPreview(undefined)
  const { phone } = try PhotosPort
  if (session.kind !== "browser" && Option.isSome(phone)) {
    const { sessionId } = session.value
    try ignore(tryPromise(() => session.kind === "still" ? phone.value.cancelEdit(sessionId) : phone.value.cancelVideoEdit(sessionId)))
  }
}

effect function selectedAskPhoto(view: MediaView) {
  const { phone, capture } = try PhotosPort
  const original = view.browser
  if (original !== undefined) {
    const current = capture(original.item.id) catch () => undefined
    if (current === undefined || current.item.revision !== original.item.revision || current.item.sourceRevision !== original.item.sourceRevision
      || current.item.trashedAt !== undefined || current.item.mimeType !== original.item.mimeType || current.item.size !== original.item.size) return undefined
    const picture = tryPromise(() => attachmentBytes(current.file, current.item.name)) catch () => undefined
    return picture === undefined ? undefined : { id: current.item.id, ...picture }
  }
  const expected = view.item
  if (Option.isNone(phone) || expected === undefined) return undefined
  const current = tryPromise(() => phone.value.read({ id: expected.id })) catch () => undefined
  if (current === undefined || current.id !== expected.id || current.kind !== "image" || current.trashed === true || current.image === undefined
    || current.revision !== expected.revision || current.mutationRevision !== expected.mutationRevision || current.contentRevision !== expected.contentRevision) return undefined
  let picture: { readonly name: string; readonly mimeType: string; readonly size: number; readonly data: string } | undefined
  if (photoEmailAllowed(current) && current.mutationRevision !== undefined) {
    const received = (try PhotosPort).attachmentPicture({ id: current.id, revision: current.mutationRevision }, "email") catch () => undefined
    if (received !== undefined) picture = { name: received.name, mimeType: received.mimeType, size: received.size, data: received.dataBase64 }
  }
  if (picture === undefined) {
    const uri = current.image
    picture = tryPromise(() => attachmentBytes(uri, current.name ?? "Photo.jpg")) catch () => undefined
  }
  return picture === undefined ? undefined : { id: current.id, ...picture }
}

effect function askAboutPhoto(photo: number, revision: number, ticket: number) {
  const viewer = try Viewer.Machine
  const catalog = try Catalog
  const opened = try OpenedPhoto
  const view = try opened.current()
  const row = (try catalog.displayed()).rows.get(photo)
  if (view.photo !== photo || row === undefined) return
  const scope = try Effect.context<Viewer.Machine | Catalog | OpenedPhoto | Library.Machine | Shell | PhotosPort>()
  const current = Effect.provideContext(effect {
    const state = try viewer.get()
    const library = try (try Library.Machine).get()
    const latest = (try catalog.displayed()).rows.get(photo)
    if (state.open !== photo || state.revision !== revision || state.read.ticket !== ticket || state.kind !== "Still"
      || !Viewer.canAskAlpha(state, "Owner") || (try opened.current()) !== view || !library.visible || !showing(try (try Shell).get(), "Photos")) return false
    return row.kind === "phone"
      ? latest?.kind === "phone" && latest.item.id === row.item.id && latest.item.revision === row.item.revision
        && latest.item.mutationRevision === row.item.mutationRevision && latest.item.contentRevision === row.item.contentRevision && latest.item.trashed !== true
      : latest?.kind === "browser" && latest.item.id === row.item.id && latest.item.revision === row.item.revision
        && latest.item.sourceRevision === row.item.sourceRevision && latest.item.trashedAt === undefined
  }, scope)
  if (!(try current)) return
  const read = Effect.provideContext(selectedAskPhoto(view), scope)
  const close = Effect.provideContext(effect {
    if (!(try current)) return
    try ignore(viewer.send({ type: "closeRemovedPhoto", photo, revision, ticket }, "Owner"))
  }, scope)
  if (try attachToAlpha({ kind: "ViewedPhoto", read, close }, current)) return
  if (try current) try say("This photo could not be attached.", true)
}

/** A permitted native still with a known, bounded original. */
export function photoEmailAllowed(item: MediaItem | undefined): boolean {
  return item !== undefined && item.kind === "image" && item.trashed !== true && item.id.startsWith("m:") && item.mutationRevision !== undefined
    && Boolean(item.name?.trim()) && Number.isSafeInteger(item.size) && item.size > 0 && item.size <= photoEmailMaxBytes
}

/** The permitted still and known size which Photos can offer to the MMS composer. */
export function photoMessageType(item: MediaItem | undefined): ("image/png" | "image/jpeg" | undefined) {
  if (item === undefined || !photoEmailAllowed(item) || item.size > MMS_MAX_TOTAL_BYTES) return undefined
  if (/\.png$/i.test(item.name ?? "")) return "image/png"
  return /\.jpe?g$/i.test(item.name ?? "") ? "image/jpeg" : undefined
}

// spec/app/photos/viewer.md, "Use in Messages offers the exact readable original of a permitted photo"; spec/app/photos/viewer.md, "Story: Share what I am looking at"
effect function offerPhoto(photo: number, revision: number, ticket: number, use: PhotoAttachmentUse) {
  const viewer = try Viewer.Machine
  const shell = try Shell
  const catalog = try Catalog
  const opened = try OpenedPhoto
  const view = try opened.current()
  const item = view.item
  const mimeType = photoMessageType(item)
  if (item === undefined || item.mutationRevision === undefined || !(use === "email" ? photoEmailAllowed(item) : mimeType !== undefined)) return
  const requested: Reviewed = { id: item.id, revision: item.mutationRevision }
  const current = effect {
    const state = try viewer.get()
    const library = try (try Library.Machine).get()
    const row = (try catalog.displayed()).rows.get(photo)
    return view.photo === photo && (try opened.current()) === view && state.open === photo && state.revision === revision && state.read.ticket === ticket
      && (use === "email" ? Viewer.canEmail(state, "Owner") : Viewer.canUseInMessages(state, "Owner")) && library.visible && showing(try shell.get(), "Photos")
      && row?.kind === "phone" && row.item.id === requested.id && row.item.mutationRevision === requested.revision
      && row.item.contentRevision === item.contentRevision && row.item.trashed !== true
  }
  if (!(try current)) return
  if (use === "message") {
    const ready = try pictureMessagingReady()
    if (!(try current)) return
    if (!ready) { try say("Messages could not open this picture", true); return }
  }
  const received = (try PhotosPort).attachmentPicture(requested, use) catch () => undefined
  if (!(try current)) return
  const compatible = received !== undefined && received.name === item.name && (use === "email" || received.mimeType === mimeType)
  const limit = use === "email" ? photoEmailMaxBytes : MMS_MAX_TOTAL_BYTES
  const bytes = compatible ? pictureBytes(received.dataBase64, received.mimeType, received.size, limit) : undefined
  const refusal = use === "email" ? "This photo could not be attached." : "Messages could not open this picture"
  if (received === undefined || bytes === undefined) { try say(refusal, true); return }
  if (use === "email") {
    const { name, mimeType, size, dataBase64: data } = received
    if (!(try handOver({ name, mimeType, size, data }, "Photos"))) try say(refusal, true)
  } else if (mimeType !== undefined) {
    const wireName = mimeType === "image/png" ? "picture-1.png" : "picture-1.jpg"
    if (!(try handOverPicture({ name: received.name, wireName, contentType: mimeType, bytes }, "Photos"))) try say(refusal, true)
  }
}

type Needs = PhotosPort | Catalog | OpenedPhoto | Viewer.Machine | Library.Machine | KeyValueStore.KeyValueStore | Toasts | Said
  | Effect.Services<ReturnType<typeof askAboutPhoto>> | Effect.Services<ReturnType<typeof offerPhoto>>

function carry(fx: Viewer.Effect): Job<Viewer.Event, Needs, [Actor]> {
  return match (fx) {
    when { tag: "Load", let ticket, let photo }: answer("view", loaded(ticket, photo), failed(ticket), "Phone");
    when { tag: "Render", let revision, let edit, let cropSource }: answer("preview", rendered(revision, edit, cropSource), { type: "previewed", revision, ok: false }, "Phone");
    when { tag: "WriteCopy", let attempt }: answer(`write ${attempt}`, written(fx), { type: "saved", attempt, known: false, confirmed: false }, "Phone");
    when { tag: "FindCopy", let ticket, let attempt }: answer("check", located(ticket, attempt), { type: "copyFound", ticket, ok: false, found: false }, "Phone");
    when { tag: "Request", let change, let photo, let revision }: run("change", ignore(effect {
      try (try Library.Machine).send({ type: "requested", change, photo, revision }, "Owner")
    }), "Phone");
    when { tag: "AskAbout", let photo, let revision, let ticket }: run("ask", askAboutPhoto(photo, revision, ticket), "Phone");
    when { tag: "Compose", let photo, let revision, let ticket }: run("offer picture", offerPhoto(photo, revision, ticket, "email"), "Phone");
    when { tag: "TextPicture", let photo, let revision, let ticket }: run("offer picture", offerPhoto(photo, revision, ticket, "message"), "Phone");
  }
}

const releasing = applying(Viewer.Machine, (s) => ({ photo: s.open, editing: s.editing, saving: s.save.outcome === "Sent" }), ({ photo, editing, saving }) => effect {
  if (!editing && !saving) try closeEditor()
  if (photo === 0) try (try OpenedPhoto).hold(emptyMedia)
})

const nativeUpdates = started(effect {
  const library = try Library.Machine
  const viewer = try Viewer.Machine
  const open = try OpenedPhoto
  const { phone } = try PhotosPort
  const cache = try Catalog
  try Stream.runForEach(library.changes, effect (state) => {
    if (!state.visible || state.library.status !== "Loaded" || Option.isNone(phone)) return
    const view = try viewer.get()
    const current = try open.current()
    const prior = current.item
    if (prior === undefined || view.origin !== "LibraryItem" || current.photo !== view.open || !Viewer.canItemChanged(view, "Phone")) return
    const row = (try cache.displayed()).rows.get(view.open)
    const listedItem = row?.kind === "phone" && row.item.id === prior.id ? row.item : undefined
    const priorRev = prior.mutationRevision ?? prior.revision
    const listedRev = listedItem === undefined ? undefined : (listedItem.mutationRevision ?? listedItem.revision)
    if (listedItem !== undefined && listedItem.trashed !== true && listedRev === priorRev
      && (listedItem.favorite === true) === (prior.favorite === true) && view.revision === state.revision) return
    const fresh = tryPromise(() => phone.value.read({ id: prior.id, includeTrashed: true })) catch () => undefined
    const now = try viewer.get()
    if (now.open !== view.open || now.origin !== "LibraryItem" || (try open.current()) !== current || !Viewer.canItemChanged(now, "Phone")) return
    if (fresh === undefined || (fresh.trashed === true && prior.trashed !== true)) {
      try ignore(viewer.send({ type: "deleted" }, "Phone"))
      return
    }
    const freshRev = fresh.mutationRevision ?? fresh.revision
    const favourite = fresh.favorite === true
    if (freshRev !== priorRev || favourite !== (prior.favorite === true)) {
      const uri = fresh.kind === "video" ? (fresh.path ?? current.uri) : (fresh.image ?? current.uri)
      try open.hold({ photo: view.open, uri, local: false, item: fresh })
    }
    try ignore(viewer.send({ type: "itemChanged", revision: state.revision, favourite }, "Phone"))
  })
}, "refreshing an open native photo")

const browserUpdates = started(effect {
  const library = try Library.Machine
  const viewer = try Viewer.Machine
  const open = try OpenedPhoto
  const { capture } = try PhotosPort
  const cache = try Catalog
  try Stream.runForEach(library.changes, effect (state) => {
    if (!state.visible || state.library.status !== "Loaded") return
    const view = try viewer.get()
    const current = try open.current()
    const source = current.browser
    if (source === undefined || current.photo !== view.open || !Viewer.canItemChanged(view, "Phone")) return
    const row = (try cache.displayed()).rows.get(view.open)
    if (row?.kind !== "browser" || (row.item.revision === source.item.revision && view.revision === state.revision)) return
    const read = try exit(capture(row.item.id))
    const now = try viewer.get()
    if (Exit.isFailure(read) || now.open !== view.open || (try open.current()) !== current || !Viewer.canItemChanged(now, "Phone")) return
    const fresh = read.value
    if (fresh === undefined || fresh.item.trashedAt !== undefined && source.item.trashedAt === undefined) {
      try ignore(viewer.send({ type: "deleted" }, "Phone"))
      return
    }
    if (fresh.item.revision !== source.item.revision) try open.hold({ photo: view.open, uri: localUri(fresh.file), local: true, browser: fresh })
    try ignore(viewer.send({ type: "itemChanged", revision: state.revision, favourite: fresh.item.favorite === true }, "Phone"))
  })
}, "refreshing an open browser photo")

// spec/app/photos/viewer.md, "A restart forgets the viewer but keeps the save; a save still on its way is no longer trusted, and is looked up"
effect function viewerRecord(raw: string | undefined): (string | undefined)!! {
  if (raw === undefined) return undefined
  const previous = Effect.try({ try: () => JSON.parse(raw) as unknown, catch: () => undefined }) catch () => undefined
  if (typeof previous !== "object" || previous === null || "origin" in previous) return raw
  if (!("save" in previous && "attempts" in previous && "lookup" in previous && "found" in previous)) return raw
  const state = Viewer.parseState({
    ...Viewer.initial, save: previous.save, attempts: previous.attempts, lookup: previous.lookup, found: previous.found,
  })
  return state === undefined ? raw : JSON.stringify(state)
}

function storedViewer(key: string, start = Viewer.initial) {
  return Layer.provide(Viewer.stored(key, start), migratedStore(key, viewerRecord))
}

/** The viewer's hands, over its rule-owned playback and edit state. */
export const viewer = together(opened, reacting({ ...Viewer, stored: storedViewer }, { keep: 1, open: [{ type: "restart" }, "Phone"], carry }), releasing, nativeUpdates, browserUpdates)
