// spec/app/photos/index.md, "Story: Browse the library"; spec/app/photos/index.md, "Story: Give Photos access"; spec/app/photos/index.md, "Story: Change albums from what I am looking at"; spec/app/photos/index.md, "Story: Select photos"
import type { AlbumChange, LibraryAccess, MediaId, MediaItem, MediaPage, PhotosClient, Reviewed } from "@elizaos/os-bridges"
import * as Library from "../../gen/app__photos.effect.vibe"
import type { Actor } from "../../gen/app__photos__actor.effect.vibe"
import * as Viewer from "../../gen/app__photos__viewer.effect.vibe"
import * as Trash from "../../gen/app__photos__trash.effect.vibe"
import type { Change } from "../../gen/app__photos__changes.effect.vibe"
import { allows, type Grant } from "../../gen/kit__permission.effect.vibe"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { Device, native } from "../platform/device.vibe"
import { duration as noticeDuration } from "../../gen/app__notices__toasts.effect.vibe"
import { offer, say, withdraw } from "../notices/toasts.vibe"
import { Time } from "../runtime/time.vibe"
import { PhotosPort, saveBrowserCapture, type BrowserCapture, type PhotoHandoff } from "../platform/photos.vibe"
import type { BrowserEditFrame } from "../platform/photoCanvas.vibe"
import { answer, following, reacting, run, started, together, type Job } from "../runtime/reactor.vibe"
import { Catalog, catalog, reviewed, taken, type ListedAlbum, type Row } from "./catalog.vibe"
import { OpenedPhoto } from "./viewer.vibe"

/** One explicit image chooser belongs to the Photos entry that opened it. */
export service PhotoChooser {
  pending(): boolean!!
  begin(): boolean!!
  finish(): boolean!!
}

const chooser = Layer.sync(PhotoChooser, () => {
  let waiting = false
  return {
    pending: () => sync(() => waiting),
    begin: () => sync(() => {
      if (waiting) return false
      waiting = true
      return true
    }),
    finish: () => sync(() => {
      const accepted = waiting
      waiting = false
      return accepted
    }),
  }
})

/** Consume the exact owner-visible chooser once before using its selected image. */
export effect function consumeImageChoice(choice: number): boolean!!(Library.Machine | Shell | Device) {
  const photos = try Library.Machine
  const device = try Device
  const shell = try Shell
  if (native() || !(try device.showing()) || !showing(try shell.get(), "Photos")) return false
  return Exit.isSuccess(try exit(photos.send({ type: "closeImageChoice", choice }, "Owner")))
}

/** Save the previewed browser copy to the same capture library the grid reads. */
export effect function importImageChoice(choice: number, frame: BrowserEditFrame, name: string) {
  if (!(try consumeImageChoice(choice))) return
  const saved = tryPromise(() => saveBrowserCapture(frame.file, name, frame.width, frame.height, undefined, frame.thumbnail)) catch () => undefined
  if (saved === undefined && showing(try (try Shell).get(), "Photos")) try say("Couldn’t save the photo.", true)
}

const pageLimit = 120
export const thumbnailBatch = 24

async function pictures(client: PhotosClient, ids: readonly MediaId[]): Promise<ReadonlyMap<MediaId, string>> {
  const found = new Map<MediaId, string>()
  for (let start = 0; start < ids.length; start += thumbnailBatch) {
    const pack = await client.thumbnails(ids.slice(start, start + thumbnailBatch))
    for (const item of pack) if (item.image) found.set(item.id, item.image)
  }
  return found
}

export interface ThumbnailWindow {
  readonly revision: number
  readonly trash: boolean
}

/** Read pixels only for the current listed rows, keeping their revisions as the grid scrolls. */
export effect function viewportThumbnails(ids: readonly number[], shown: ThumbnailWindow): ReadonlyMap<number, string>!!(PhotosPort | Catalog | Library.Machine | Trash.Machine) {
  const photos = try Library.Machine
  const trash = try Trash.Machine
  const cache = try Catalog
  const library = try photos.get()
  const bin = try trash.get()
  const live = shown.trash ? bin : library
  const result = new Map<number, string>()
  if (!library.visible || shown.trash !== bin.open || live.revision !== shown.revision || ids.length > thumbnailBatch) return result
  const { rows } = try cache.displayed()
  const listed = new Set(live.rows)
  const native = new Map<MediaId, number>()
  for (const key of ids) {
    const row = listed.has(key) ? rows.get(key) : undefined
    if (row === undefined) continue
    const image = row.kind === "browser" ? row.item.thumbnail : row.item.image
    if (image) result.set(key, image)
    else if (row.kind === "phone" && !shown.trash) native.set(row.item.id, key)
  }
  const { phone } = try PhotosPort
  if (native.size > 0 && Option.isSome(phone)) {
    const read = tryPromise(() => pictures(phone.value, [...native.keys()])) catch () => undefined
    if (read !== undefined) for (const [id, image] of read) {
      const key = native.get(id)
      if (key !== undefined) result.set(key, image)
    }
  }
  const current = try photos.get()
  const deleted = try trash.get()
  const after = shown.trash ? deleted : current
  if (!current.visible || shown.trash !== deleted.open || after.revision !== shown.revision) return new Map()
  const remains = new Set(after.rows)
  for (const key of result.keys()) if (!remains.has(key)) result.delete(key)
  return result
}
const standardAlbums = [
  { title: "Favorites", target: "favorites" },
  { title: "Videos", target: "videos" },
  { title: "Camera", target: "camera" },
  { title: "Screenshots", target: "screenshots" },
] as const

/** Access to this library and to its video rows. */
type Access = Extract<Library.Event, { type: "accessIs" }>

function accessEvent(access: LibraryAccess): Access {
  const grant: Grant = access.scope === "full" ? "Granted" : access.scope === "partial" || access.scope === "selected" ? "Limited" : "Denied"
  return { type: "accessIs", grant, videos: access.videos === "full" || access.videos === "selected" }
}

const denied: Access = { type: "accessIs", grant: "Denied", videos: false }

/** The current permission, with a failed query left unconfirmed. */
effect function permission(ask = false): (Access | undefined)!!PhotosPort {
  const { phone, browser } = try PhotosPort
  if (Option.isSome(browser)) return { type: "accessIs", grant: "Granted", videos: true }
  if (Option.isNone(phone)) return undefined
  const access = tryPromise(() => ask ? phone.value.requestLibraryAccess() : phone.value.libraryAccess()) catch () => undefined
  return access === undefined ? undefined : accessEvent(access)
}

type Fetch = Extract<Library.Effect, { readonly tag: "Fetch" }>

/** A native page as requested, with ownership independently enforced where Android did not grant library access. */
async function phonePage(phone: PhotosClient, request: Fetch, cursor: MediaPage["next"], album?: ListedAlbum): Promise<MediaPage> {
  const before = cursor ?? undefined
  if (album !== undefined) return phone.list({ before, album: album.target, limit: pageLimit, thumbnails: false })
  if (request.own) return phone.list({ before, limit: pageLimit, thumbnails: false })
  if (request.filter === "Favorites") return phone.list({ before, album: "favorites", limit: pageLimit, thumbnails: false })
  return phone.listPermitted({ before, thumbnails: false, query: request.filter === "Matching" ? request.query : undefined, kind: request.filter === "Videos" ? "video" : undefined })
}

function failedList(ticket: number): Extract<Library.Event, { type: "listed" }> {
  return { type: "listed", ticket, ok: false, rows: [], owned: [], starred: [], cameraItem: 0, revision: 0, more: false }
}

interface CameraLookup {
  readonly id: string
  readonly source: "owned" | "permitted"
}

function cameraLookup(capture: PhotoHandoff, page: MediaPage, own: boolean): CameraLookup | undefined {
  const libraryId = capture.libraryId
  const canonical = libraryId !== undefined && /^m:(?!external:|internal:)[A-Za-z0-9_-]{1,80}:[iv]:[1-9][0-9]*$/.test(libraryId)
  if (!own && canonical) {
    return page.access !== undefined && page.access.scope !== "denied" ? { id: libraryId, source: "permitted" } : undefined
  }
  const ownedScope = own ? page.access === undefined : page.access?.scope === "full"
  const ownedId = capture.ownedId ?? libraryId
  return ownedScope && ownedId !== undefined && /^(?:v:)?[1-9][0-9]*$/.test(ownedId) ? { id: ownedId, source: "owned" } : undefined
}

effect function verifiedCameraItem(phone: PhotosClient, lookup: CameraLookup): (Extract<Row, { kind: "phone" }> | undefined)!! {
  const { id, source } = lookup
  const item = tryPromise(() => source === "owned" ? phone.read({ id }) : phone.readPermitted({ id, pixels: false })) catch () => undefined
  if (item === undefined || item.id !== id || item.trashed === true) return undefined
  return { kind: "phone", item: source === "owned" ? { ...item, owned: true } : item }
}

function cameraPageMatches(state: Library.Photos, page: MediaPage, own: boolean): boolean {
  if (own) return page.access === undefined
  if (page.access === undefined) return false
  const access = accessEvent(page.access)
  return access.grant === state.access.grant && access.videos === state.videos
}

function sameCameraContent(before: MediaItem, after: MediaItem): boolean {
  return after.id === before.id && after.kind === before.kind && after.identity === before.identity
    && after.width === before.width && after.height === before.height && after.size === before.size
    && (before.contentRevision === undefined
      ? (after.mutationRevision ?? after.revision) === (before.mutationRevision ?? before.revision)
      : after.contentRevision === before.contentRevision)
}

/** Read the requested page and keep its payload only when the matching ticket can still answer. */
effect function fetched(request: Fetch): Library.Event!!(PhotosPort | Catalog | Library.Machine) {
  const { phone, browser, reviewed: deviceLibrary, peekHandoff } = try PhotosPort
  const cache = try Catalog
  const machine = try Library.Machine
  const revision = try cache.revision()
  const cursor = request.page ? try cache.cursor(false) : null
  const fail = failedList(request.ticket)
  if (Option.isSome(browser)) return try fetchedBrowser(request)
  if (request.tab === "Albums" && request.album === 0) {
    if (Option.isNone(phone)) return fail
    const client = phone.value
    const [shelves, totals] = try.all [
      effect { return tryPromise(() => client.albums()) catch () => undefined },
      effect { return tryPromise(() => client.summary()) catch () => undefined },
    ]
    if (shelves === undefined || !Library.canListed(try machine.get(), request.ticket, "Phone")) return fail
    const representatives = [...new Set(shelves.flatMap((album) => album.memberIds.slice(0, 1)))]
    const covers = tryPromise(() => pictures(client, representatives)) catch () => undefined
    const tiles: ListedAlbum[] = []
    for (const album of standardAlbums) {
      const count = totals?.[album.target]
      if (count === 0 && album.target !== "favorites") continue
      const sample = tryPromise(() => client.list({ album: album.target, limit: 1, thumbnails: true })) catch () => undefined
      if (count === undefined && (sample?.items.length ?? 0) === 0 && album.target !== "favorites") continue
      tiles.push({ ...album, count: count ?? sample?.items.length ?? 0, cover: sample?.items[0]?.image })
    }
    if (!Library.canListed(try machine.get(), request.ticket, "Phone")) return fail
    const custom = shelves.map((owned): ListedAlbum => ({
      title: owned.name, target: `custom:${owned.id}`, owned, count: owned.count,
      cover: owned.memberIds[0] === undefined ? undefined : covers?.get(owned.memberIds[0]),
    }))
    const albums = try cache.shelves([...tiles, ...custom], totals?.trash ?? 0)
    return { ...fail, ok: true, rows: albums, revision }
  }
  const { albums } = try cache.displayed()
  const album = request.album === 0 ? undefined : albums.get(request.album)
  const listed = Option.isSome(phone) ? (tryPromise(() => phonePage(phone.value, request, cursor, album)) catch () => undefined) : undefined
  if (Option.isSome(phone) && listed === undefined) {
    const scope = Option.isSome(deviceLibrary) ? (tryPromise(() => deviceLibrary.value.scope()) catch () => undefined) : undefined
    return scope?.locked ? { type: "lockedOut", ticket: request.ticket } : fail
  }
  const state = try machine.get()
  if (!Library.canListed(state, request.ticket, "Phone")) return fail
  const ownedPage = request.own && album === undefined && listed !== undefined && listed.access === undefined
  const rows = (listed?.items ?? []).flatMap((item): Row[] => {
    if (item.owned === true || !request.own) return [{ kind: "phone", item }]
    const ownedId = item.kind === "video" ? /^v:[1-9][0-9]*$/ : /^[1-9][0-9]*$/
    return ownedPage && item.owned === undefined && ownedId.test(item.id)
      ? [{ kind: "phone", item: { ...item, owned: true } }] : []
  }).sort((a, b) => taken(b) - taken(a))
  const capture = try peekHandoff()
  const beforeCamera = state.cameraItem === 0 ? undefined : (try cache.displayed()).rows.get(state.cameraItem)
  let cameraRow: Extract<Row, { kind: "phone" }> | undefined
  if (listed !== undefined && Option.isSome(phone) && request.only.length === 0 && Library.cameraVisit(state)
    && cameraPageMatches(state, listed, request.own)) {
    const kept = beforeCamera?.kind === "phone" ? beforeCamera : undefined
    const requested = kept === undefined && Library.cameraScope(state) ? capture : undefined
    const identity = requested ?? (kept === undefined ? undefined : { libraryId: kept.item.id, ownedId: undefined })
    const lookup = identity === undefined ? undefined : cameraLookup(identity, listed, request.own)
    if (lookup !== undefined && (kept !== undefined || !rows.some((row) => row.item.id === lookup.id))) {
      const verified = try verifiedCameraItem(phone.value, lookup)
      if (!Library.canListed(try machine.get(), request.ticket, "Phone") || (try cache.revision()) !== revision) return fail
      if ((try peekHandoff()) === capture && verified !== undefined && (kept === undefined || sameCameraContent(kept.item, verified.item))) cameraRow = verified
    }
  }
  const handles = try cache.index(rows)
  const accepted = request.only.length === 0 ? rows : rows.filter((_, index) => request.only.includes(handles[index] ?? 0))
  const acceptedHandles = request.only.length === 0 ? handles : handles.filter((id) => request.only.includes(id))
  try cache.publish(accepted, acceptedHandles)
  try cache.next(false, listed?.next ?? null)
  const owned = rows.flatMap((row, at) => row.kind === "browser" || row.item.owned === true ? [handles[at] ?? 0] : [])
  const starred = rows.flatMap((row, at) => row.kind === "phone" && row.item.favorite === true ? [handles[at] ?? 0] : [])
  const cameraItem = cameraRow === undefined ? 0 : (try cache.index([cameraRow]))[0] ?? 0
  if (cameraRow !== undefined && cameraItem > 0) {
    try cache.publish([cameraRow], [cameraItem])
    if (cameraRow.item.owned === true) owned.push(cameraItem)
  }
  return {
    type: "listed", ticket: request.ticket, ok: true, rows: handles, owned, starred, cameraItem,
    revision, more: listed?.next != null,
  }
}

function browserBelongs(row: BrowserCapture, album: ListedAlbum["target"] | undefined, members: ReadonlySet<string>): boolean {
  if (album === "favorites") return row.favorite === true
  if (album === "videos") return row.mimeType.startsWith("video/")
  if (album === "screenshots") return false
  return album?.startsWith("custom:") ? members.has(row.id) : true
}

/** The app's local library uses the same tab, section and action rules as the phone's library. */
effect function fetchedBrowser(request: Fetch): Library.Event!!(PhotosPort | Catalog | Library.Machine) {
  const { browser } = try PhotosPort
  const fail = failedList(request.ticket)
  if (Option.isNone(browser)) return fail
  const local = browser.value
  const all = tryPromise(() => local.rows()) catch () => undefined
  if (all === undefined) return fail
  const live = all.filter((item) => item.trashedAt === undefined).sort((a, b) => b.created - a.created)
  const cache = try Catalog
  const machine = try Library.Machine
  if (!Library.canListed(try machine.get(), request.ticket, "Phone")) return fail
  const revision = try cache.revision()
  if (request.tab === "Albums" && request.album === 0) {
    const owned = tryPromise(() => local.albums()) catch () => undefined
    if (owned === undefined || !Library.canListed(try machine.get(), request.ticket, "Phone")) return fail
    const defaults: ListedAlbum[] = standardAlbums.flatMap((album) => {
      const rows = live.filter((row) => browserBelongs(row, album.target, new Set()))
      return rows.length > 0 || album.target === "favorites" ? [{ ...album, count: rows.length, cover: rows[0]?.thumbnail }] : []
    })
    const personal = owned.map((album): ListedAlbum => {
      const members = new Set(album.memberIds)
      const rows = live.filter((item) => members.has(item.id))
      return { title: album.name, target: `custom:${album.id}`, owned: album, count: rows.length, cover: rows[0]?.thumbnail }
    })
    const albums = try cache.shelves([...defaults, ...personal], all.length - live.length)
    return { ...fail, ok: true, rows: albums, revision }
  }
  const { albums } = try cache.displayed()
  const album = albums.get(request.album)
  const members = new Set(album?.owned?.memberIds ?? [])
  const query = request.query.toLocaleLowerCase()
  const rows = live.filter((item) => browserBelongs(item, album?.target, members) && (request.filter === "Favorites" ? item.favorite === true
    : request.filter === "Videos" ? item.mimeType.startsWith("video/") : request.filter === "Matching" ? item.name.toLocaleLowerCase().includes(query) : request.filter !== "People"))
    .map((item): Row => ({ kind: "browser", item }))
  const allIds = try cache.index(rows)
  const state = try machine.get()
  const older = request.page ? state.rows.reduce((first, number) => Math.min(first, number), Infinity) : Infinity
  const slice = rows.flatMap((row, index) => {
    const number = allIds[index]
    return number !== undefined && number < older && (request.only.length === 0 || request.only.includes(number)) ? [{ row, number }] : []
  })
  const shown = slice.slice(0, pageLimit)
  const ids = shown.map(({ number }) => number)
  try cache.publish(shown.map(({ row }) => row), ids)
  return { ...fail, ok: true, rows: ids, owned: ids, starred: shown.filter(({ row }) => row.item.favorite === true).map(({ number }) => number), revision, more: slice.length > shown.length }
}

/** Resolve the exact browser rows approved by the owner. */
export effect function browserTargets(items: readonly number[]): BrowserCapture[]!!Catalog {
  const { rows } = try (try Catalog).displayed()
  return items.flatMap((number) => {
    const row = rows.get(number)
    return row?.kind === "browser" ? [row.item] : []
  })
}

/** Resolve exactly the native rows a change intends; never replace a missing row with a different item. */
export effect function targets(items: readonly number[]): Array<{ number: number; item: Reviewed }>!!Catalog {
  const { rows } = try (try Catalog).displayed()
  return items.flatMap((number) => {
    const item = reviewed(rows.get(number))
    return item === undefined ? [] : [{ number, item }]
  })
}

const operations = { Favorite: "favorite", Unfavorite: "unfavorite", Trash: "trash", Restore: "restore" } as const

/** The native system-confirmed rows, with lost or unverified results never claimed as complete. */
export effect function changedItems(change: Change, items: readonly number[]) {
  const { phone, browser } = try PhotosPort
  if (Option.isSome(browser)) {
    const reviewed = try browserTargets(items)
    const refusal = { done: [], stale: [...items], declined: false, known: true }
    if (reviewed.length !== items.length) return refusal
    const local = browser.value
    if (change === "Share") {
      const library = try Library.Machine
      const before = try library.get()
      const files = tryPromise(() => local.shareFiles(reviewed)) catch () => undefined
      const after = try library.get()
      if (files === undefined || !after.visible || after.secure || before.revision !== after.revision || before.library.ticket !== after.library.ticket
        || !(try (try Device).showing()) || !showing(try (try Shell).get(), "Photos")) return refusal
      const shared = tryPromise(() => local.share(files)) catch () => undefined
      if (shared === "unavailable") try say("Sharing is unavailable in this browser.", true)
      return { done: shared === "opened" ? [...items] : [], stale: [], declined: shared === "declined", known: shared !== undefined }
    }
    const changed = tryPromise(() => local.change(operations[change], reviewed)) catch () => undefined
    const done: number[] = []
    const stale: number[] = []
    const updated: Row[] = []
    const updatedIds: number[] = []
    for (const [index, row] of reviewed.entries()) {
      const number = items[index]
      const reply = changed?.find((entry) => entry.id === row.id)
      if (number === undefined || reply === undefined) continue
      if (reply.status === "stale") stale.push(number)
      else if (reply.status === "done") done.push(number)
      if (reply.item !== undefined) { updated.push({ kind: "browser", item: reply.item }); updatedIds.push(number) }
    }
    try (try Catalog).publish(updated, updatedIds)
    return { done, stale, declined: false, known: changed !== undefined && !changed.some((row) => row.status === "unverified") }
  }
  const rows = try targets(items)
  if (Option.isNone(phone) || rows.length !== items.length) return { done: [], stale: [...items], declined: false, known: true }
  const asked = rows.map((row) => row.item)
  if (change === "Share") {
    const shared = tryPromise(() => asked.length === 1 && asked[0] !== undefined ? phone.value.share(asked[0]) : phone.value.shareMany(asked)) catch () => undefined
    return { done: shared?.status === "opened" ? [...items] : [], stale: [], declined: false, known: shared !== undefined }
  }
  const attempted = try exit(tryPromise(() => phone.value.changeMany(operations[change], asked)))
  const reply = Exit.isSuccess(attempted) ? attempted.value : undefined
  if (reply === undefined && Exit.isFailure(attempted)) {
    const failure = Cause.squash(attempted.cause)
    const cause = typeof failure === "object" && failure !== null && "cause" in failure ? failure.cause : failure
    const code = typeof cause === "object" && cause !== null && "code" in cause ? cause.code : undefined
    if (code === "LIBRARY_DECLINED") return { done: [], stale: [], declined: true, known: true }
    if (code === "LIBRARY_STALE") return { done: [], stale: [...items], declined: false, known: true }
  }
  const knownRows: Row[] = []
  const knownNumbers: number[] = []
  for (const [index, row] of rows.entries()) {
    const updated = reply?.outcomes[index]?.item
    if (updated === undefined) continue
    knownRows.push({ kind: "phone", item: updated })
    knownNumbers.push(row.number)
  }
  if (knownRows.length > 0) try (try Catalog).publish(knownRows, knownNumbers)
  const done = rows.filter((row, index) => {
    const status = reply?.outcomes[index]?.status
    return status === "favorited" || status === "unfavorited" || status === "trashed" || status === "restored" || status === "unchanged"
  }).map((row) => row.number)
  const stale = rows.filter((_, index) => reply?.outcomes[index]?.status === "stale").map((row) => row.number)
  return { done, stale, declined: false, known: reply !== undefined && !reply.outcomes.some((row) => row.status === "unverified") }
}

effect function changed(attempt: number, change: Change, items: readonly number[]): Library.Event!!(PhotosPort | Catalog | Library.Machine | Device | Shell | Effect.Services<ReturnType<typeof say>>) {
  const outcome = try changedItems(change, items)
  if (outcome.done.length > 0 && change !== "Share") try (try Catalog).changed()
  return { type: "changed", attempt, ...outcome }
}

// spec/app/photos/index.md, "The owner can add the Camera capture in the Viewer to an album"
effect function cameraAlbums(photo: number, ticket: number): void!!(PhotosPort | Catalog | Library.Machine | Viewer.Machine) {
  const { phone } = try PhotosPort
  if (Option.isNone(phone)) return
  const shelves = tryPromise(() => phone.value.albums()) catch () => undefined
  const machine = try Library.Machine
  const viewer = try (try Viewer.Machine).get()
  if (shelves === undefined || viewer.open !== photo || !Viewer.shown(viewer)
    || !Library.canCameraAlbumsLoaded(try machine.get(), photo, ticket, "Phone")) return
  const cache = try Catalog
  const choices = try cache.shelves(shelves.map((album): ListedAlbum => ({
    title: album.name, target: `custom:${album.id}`, owned: album, count: album.count,
  })), (try cache.displayed()).trashCount)
  try ignore(machine.send({ type: "cameraAlbumsLoaded", photo, ticket, choices }, "Phone"))
}

// spec/app/photos/index.md, "The Viewer's favourite, share or delete of the item open is a change of that one item, at the revision it showed"
effect function revokeCamera(photo: number): void!!(Library.Machine | Viewer.Machine) {
  if ((try (try Library.Machine).get()).cameraItem === photo) return
  const viewer = try Viewer.Machine
  const showing = try viewer.get()
  if (showing.open === photo && showing.origin === "CameraCapture") try ignore(viewer.send({ type: "revoked" }, "Phone"))
}

// spec/app/photos/index.md, "The owner can add the Camera capture in the Viewer to an album"
export effect function openCameraAlbum(photo: number, revision: number, ticket: number): void!!(Library.Machine | Viewer.Machine) {
  const viewer = try Viewer.Machine
  const current = try viewer.get()
  if (current.open !== photo || current.revision !== revision || current.read.ticket !== ticket
    || current.origin !== "CameraCapture" || current.editing || !Viewer.shown(current)) return
  if (current.info && Exit.isFailure(try exit(viewer.send({ type: "toggleInfo" }, "Owner")))) return
  const after = try viewer.get()
  if (after.open !== photo || after.revision !== revision || after.read.ticket !== ticket
    || after.origin !== "CameraCapture" || after.info || after.editing || !Viewer.shown(after)) return
  try ignore((try Library.Machine).send({ type: "chooseCameraAlbum", photo, revision }, "Owner"))
}

type WriteAlbum = Extract<Library.Effect, { readonly tag: "WriteAlbum" }>

effect function albumWritten(request: WriteAlbum): Library.Event!!(PhotosPort | Catalog) {
  const { phone, browser } = try PhotosPort
  const { albums } = try (try Catalog).displayed()
  const owned = albums.get(request.album)?.owned
  const refusal: Library.Event = { type: "albumWritten", attempt: request.attempt, known: true, confirmed: false }
  if (Option.isSome(browser)) {
    const local = browser.value
    const items = try browserTargets(request.items)
    if (items.length !== request.items.length) return refusal
    const album = owned !== undefined && "kind" in owned ? owned : undefined
    const written = tryPromise(() => local.writeAlbum({ change: request.change, album, name: request.name, items })) catch () => undefined
    if (written) try (try Catalog).changed()
    return { ...refusal, known: written !== undefined, confirmed: written === true }
  }
  const album = owned !== undefined && !("kind" in owned) ? owned : undefined
  const rows = try targets(request.items)
  if (Option.isNone(phone) || rows.length !== request.items.length) return refusal
  let update: AlbumChange | undefined
  if (request.change === "Create") update = { operation: "create", name: request.name }
  else if (album !== undefined && request.change === "Rename") update = { operation: "rename", id: album.id, revision: album.revision, name: request.name }
  else if (album !== undefined && request.change === "Delete") update = { operation: "delete", id: album.id, revision: album.revision }
  if (update === undefined && album === undefined) return refusal
  const planned = update
  const reply = planned === undefined ? album : (tryPromise(() => phone.value.changeAlbum(planned)) catch () => undefined)
  if (reply === undefined) return { ...refusal, known: false }
  let current = reply
  for (const { item } of request.change === "Create" || request.change === "Add" || request.change === "Remove" ? rows : []) {
    const operation = request.change === "Remove" ? "remove" : "add"
    const { id, revision } = current
    const next = tryPromise(() => phone.value.changeAlbum({ operation, id, revision, mediaId: item.id, mediaRevision: item.revision })) catch () => undefined
    if (next === undefined) return { ...refusal, known: false }
    current = next
  }
  try (try Catalog).changed()
  return { ...refusal, confirmed: true }
}

effect function revoke() {
  try (try Catalog).clear()
  try ignore((try Viewer.Machine).send({ type: "revoked" }, "Phone"))
  try ignore((try Trash.Machine).send({ type: "leave" }, "Phone"))
}

type LibraryNeeds = PhotosPort | Catalog | Library.Machine | Viewer.Machine | Trash.Machine | Device | Shell | Effect.Services<ReturnType<typeof say>>
function carry(fx: Library.Effect): Job<Library.Event, LibraryNeeds, [Actor]> {
  return match (fx) {
    when { tag: "Fetch" }: answer("library", fetched(fx), failedList(fx.ticket), "Phone");
    when { tag: "ReadCameraAlbums", let photo, let ticket }: run("camera albums", cameraAlbums(photo, ticket), "Phone");
    when { tag: "DropCamera", let photo }: run("drop camera", revokeCamera(photo), "Phone");
    when { tag: "AskAccess" }: answer("access", Effect.map(permission(true), (event) => event ?? denied), denied, "Phone");
    when { tag: "PickItems" }: answer("access", Effect.map(permission(true), (event) => event ?? denied), denied, "Phone");
    when { tag: "OpenSettings" }: run("settings", effect {
      const { phone } = try PhotosPort
      if (Option.isSome(phone)) try ignore(tryPromise(() => phone.value.openLibrarySettings()))
    }, "Phone");
    when { tag: "Revoke" }: run("privacy", revoke(), "Phone");
    when { tag: "ChangeItems" }: answer(`change:${fx.attempt}`, changed(fx.attempt, fx.change, fx.items), { type: "changed", attempt: fx.attempt, done: [], stale: [], declined: false, known: false }, "Phone");
    when { tag: "WriteAlbum" }: answer(`album:${fx.attempt}`, albumWritten(fx), { type: "albumWritten", attempt: fx.attempt, confirmed: false, known: false }, "Phone");
  }
}

const lifecycle = started(effect {
  const shell = try Shell
  const device = try Device
  const photos = try Library.Machine
  const { phone, hasHandoff, takeHandoff } = try PhotosPort
  const picker = try PhotoChooser
  const visibility = Stream.concat(Stream.fromEffect(device.showing()), device.visible)
  try Stream.runForEach(Stream.changesWith(Stream.zipLatestWith(Stream.map(shell.changes, (state) => showing(state, "Photos")), visibility, (front, visible) => ({ front, visible })), (a, b) => a.front === b.front && a.visible === b.visible), effect ({ front, visible }) => {
    const state = try photos.get()
    if (front && (try picker.pending())) return
    if (!front || !visible) {
      if (!front) try picker.finish()
      if (state.visible) {
        try takeHandoff()
        try ignore(photos.send({ type: "hideView" }, "Phone"))
      }
      try revoke()
      if (Option.isSome(phone)) try ignore(tryPromise(() => phone.value.watchLibrary(false)))
      return
    }
    const access = try permission()
    if (access !== undefined) {
      if (state.access.grant === "Granted" && access.grant === "Limited") try revoke()
      try ignore(photos.send(access, "Phone"))
    }
    if (!state.visible) try ignore(photos.send({ type: "showView", secure: false, only: [] }, "Phone"))
    else if (access === undefined) try ignore(photos.send({ type: "libraryChanged" }, "Phone"))
    if (try hasHandoff()) {
      const current = try photos.get()
      if (current.tab === "Albums") try ignore(photos.send({ type: "showTab", tab: "Library" }, "Owner"))
      else if (current.filter !== "Everything") try ignore(photos.send({ type: "narrow", narrowing: "Everything", query: "", person: 0 }, "Owner"))
    }
    if (Option.isSome(phone)) try ignore(tryPromise(() => phone.value.watchLibrary(true)))
  })
}, "Photos visibility")

const handoff = started(effect {
  const photos = try Library.Machine
  const viewer = try Viewer.Machine
  const port = try PhotosPort
  const cache = try Catalog
  try Stream.runForEach(photos.changes, effect (state) => {
    if (!state.visible || state.library.status !== "Loaded" || state.tab !== "Library" || state.filter !== "Everything") return
    const capture = try port.takeHandoff()
    if (capture === undefined) return
    const { rows } = try cache.displayed()
    const admitted = state.cameraItem === 0 ? state.rows : [...state.rows, state.cameraItem]
    const exact = capture.libraryId === undefined ? undefined : admitted.find((number) => rows.get(number)?.item.id === capture.libraryId)
    const owned = exact !== undefined || capture.ownedId === undefined ? undefined : admitted.find((number) => {
      if (allows(state.access) && number !== state.cameraItem) return false
      const row = rows.get(number)
      return row?.kind === "phone" && row.item.owned === true && row.item.id === capture.ownedId
    })
    const photo = exact ?? owned
    if (photo !== undefined) try ignore(viewer.send({ type: "openItem", photo, listed: true, secure: state.secure, only: state.only, reviewing: false, origin: "CameraCapture" }, "Owner"))
  })
}, "Camera photo handoff")

const libraryChanges = started(effect {
  const { changes } = try PhotosPort
  const photos = try Library.Machine
  const cache = try Catalog
  try Stream.runForEach(changes, effect () => {
    const before = try photos.get()
    if (!before.visible) return
    try cache.changed()
    const access = try permission()
    const after = try photos.get()
    if (!after.visible) return
    if (access?.grant === "Limited" && (before.access.grant === "Granted" || before.access.grant === "Limited")) try revoke()
    try ignore(photos.send(access ?? { type: "libraryChanged" }, "Phone"))
  })
}, "Photos library changes")

// spec/app/photos/index.md, "The Viewer's favourite, share or delete of the item open is a change of that one item, at the revision it showed"
const cameraUpdates = started(effect {
  const library = try Library.Machine
  const viewer = try Viewer.Machine
  const cache = try Catalog
  const open = try OpenedPhoto
  try Stream.runForEach(library.changes, effect (state) => {
    if (!state.visible || state.cameraItem === 0 || state.library.status !== "Loaded") return
    if ((try library.get()).library.ticket !== state.library.ticket) return
    const viewing = try viewer.get()
    const media = try open.current()
    const photo = state.cameraItem
    const row = (try cache.displayed()).rows.get(photo)
    if (viewing.open !== photo || viewing.origin !== "CameraCapture" || media.photo !== photo || media.item === undefined
      || row?.kind !== "phone" || row.item.id !== media.item.id || !Viewer.canItemChanged(viewing, "Phone")) return
    const confirmedFlag = state.job.basis === viewing.revision && state.job.done.includes(photo)
      && (state.job.change === "Favorite" || state.job.change === "Unfavorite")
    if (row.item.identity !== media.item.identity || row.item.kind !== media.item.kind
      || row.item.width !== media.item.width || row.item.height !== media.item.height || row.item.size !== media.item.size
      || (row.item.contentRevision !== media.item.contentRevision && !confirmedFlag)) {
      try ignore(viewer.send({ type: "revoked" }, "Phone"))
      return
    }
    if (row.item.trashed === true) { try ignore(viewer.send({ type: "deleted" }, "Phone")); return }
    const favourite = row.item.favorite ?? viewing.favourite
    const revised = (row.item.mutationRevision ?? row.item.revision) !== (media.item.mutationRevision ?? media.item.revision)
    if (!revised && favourite === viewing.favourite && viewing.revision === state.revision) return
    if (revised || favourite !== viewing.favourite) try open.hold({ ...media, item: { ...media.item, ...row.item } })
    try ignore(viewer.send({ type: "itemChanged", revision: state.revision, favourite }, "Phone"))
  })
}, "refreshing the open Camera capture")

const batchLimit = 20
const batches = following(Library.Machine, (state) => ({ job: state.job, visible: state.visible }), Library.Machine,
  ({ job, visible }): Library.Event | undefined => visible && job.left.length > 0 && job.request.outcome !== "Sent"
    ? { type: "sendNext", items: job.change === "Share" ? job.left : job.left.slice(0, batchLimit) } : undefined, "Phone")

const notices = started(effect {
  const photos = try Library.Machine
  const time = try Time
  const device = try Device
  const outcomes = Stream.changesWith(Stream.map(photos.changes, (s) => ({
    attempt: s.job.request.id, undo: s.visible && s.job.undoable,
    outcome: s.job.request.outcome, done: s.job.done.length,
  })), (a, b) => a.attempt === b.attempt && a.outcome === b.outcome && a.undo === b.undo)
  let previous = 0
  try Stream.runDrain(Stream.switchMap(outcomes, (state) => Stream.fromEffect(effect {
    if (previous > 0) { try withdraw("Photos", previous); previous = 0 }
    if (state.undo) {
      const { attempt, done } = state
      previous = attempt
      const notice = done === 1 ? "Photo moved to Recently deleted" : `${done} photos moved to Recently deleted`
      const scale = Option.getOrElse(try device.timeoutScale(), () => 100)
      try offer(notice, "Photos", attempt, ignore(photos.send({ type: "undoTrash" }, "Owner")))
      try time.until((try time.now()) + noticeDuration(notice.length, true, scale))
      if ((try photos.get()).job.request.id === attempt) try ignore(photos.send({ type: "undoLapsed" }, "Phone"))
      try withdraw("Photos", attempt)
      previous = 0
    } else if (state.outcome === "Unknown") try say("Some photo changes could not be confirmed.", true)
  })))
}, "Photos change notices")

export const library = together(chooser, catalog, reacting(Library, { carry }), lifecycle, libraryChanges, batches, handoff, cameraUpdates, notices)
