// spec/app/camera/index.md, "Story: Scan a document"; spec/app/files/scan.md, "Story: Arrange the pages"
import type { SelectionId } from "@elizaos/os/bridges/definitions/media"
import type { Fields } from "../calendar/editor.vibe"

/** The scanned event is a draft for the Calendar editor, still requiring owner save. */
export interface ScannedEvent { readonly day: number; readonly fields: Fields; readonly disclosures: ReadonlyArray<string> }

/** The owner opened the scanner, for the active or next Files view alone. */
export service ScanEntry {
  readonly requests: Stream.Stream<boolean>
  ask(): void!!
  take(): boolean!!
  readonly events: Stream.Stream<ScannedEvent | undefined>
  calendar(draft: ScannedEvent): void!!
  takeEvent(): (ScannedEvent | undefined)!!
}

/** A single handoff is consumed while Files is visible. */
export const scanEntry = Layer.effect(ScanEntry, effect {
  const waiting = try SubscriptionRef.make(false)
  const event = try SubscriptionRef.make<ScannedEvent | undefined>(undefined)
  return {
    requests: SubscriptionRef.changes(waiting),
    ask: () => SubscriptionRef.set(waiting, true),
    take: () => SubscriptionRef.getAndSet(waiting, false),
    events: SubscriptionRef.changes(event),
    calendar: (draft: ScannedEvent) => SubscriptionRef.set(event, draft),
    takeEvent: () => SubscriptionRef.getAndSet(event, undefined),
  }
})

/** A saved scanner PDF is listed in the retained Files runtime, from either scan surface. */
export service ScanExports {
  record(selection: SelectionId): void!!
}
