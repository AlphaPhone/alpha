// spec/app/files/scan.md, "Story: Arrange the pages"; spec/app/files/scan.md, "Story: Keep the scan as I work"; spec/app/files/scan.md, "Story: Make the PDF, and keep the photo"; spec/app/files/scan.md, "Story: Leave the scan and come back"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import type { ScanCorners, ScanEventProposal, ScanTextLine } from "@elizaos/plugin-files-client"
import type { SelectionId } from "@elizaos/os-bridges"
