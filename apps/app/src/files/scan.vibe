import * as Recent from "../../gen/app__files__recent.effect.vibe"
import * as Correction from "../../gen/app__files__correction.effect.vibe"
import * as Scan from "../../gen/app__files__scan.effect.vibe"
import type { Page } from "../../gen/app__files__scanDraft.ts"
import { civilDay, dayStart, zone } from "../calendar/time.ts"
import { Machine as Shell, showing } from "../../gen/app__shell.effect.vibe"
import { Agent } from "../platform/index.vibe"
import { Attempts } from "../runtime/index.vibe"
import { Documents } from "../platform/index.vibe"
import { Device, native } from "../platform/index.vibe"
import { PhotosPort, saveBrowserCapture } from "../platform/index.vibe"
import { PhotoChooser } from "../photos/photos.vibe"
import { say } from "../notices/index.vibe"
import { answer, applying, contained, reacting, run, started, together, type Job } from "../runtime/index.vibe"
import { createShelf, type Shelf } from "../runtime/index.vibe"
import { loadFilesClient, scanNoteLimit } from "./entries.vibe"
import { Opened } from "./preview.vibe"
import { Time } from "../runtime/index.vibe"
import { ScanEntry, ScanExports, type ScannedEvent } from "./scanEntry.vibe"
import { changeDraft, copyText, drawPdf, readDraft, openLink, photoData, release, rotateImage, scanImage, source, writePdf, type ScanImage, type ScanWords, type StoredPage } from "./scanStore.vibe"

function fullPage(): ScanCorners {
  return [{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: 1, y: 1 }, { x: 0, y: 1 }]
}

export interface ScanOutline {
  readonly corners: ScanCorners
  readonly turns: number
}

export interface ScanPage extends ScanImage {
  readonly uri: string
}

/** The images and prepared document addressed by the Scan model. */
export service ScanAssets {
  readonly turn: Semaphore.Semaphore
  version(): Shelf<number>!!
  read(id: number): (ScanPage | undefined)!!
  words(id: number, revision: number): (ScanWords | undefined)!!
  holdWords(id: number, revision: number, value: ScanWords): void!!
  review(ticket: number, words?: ReadonlyMap<number, ScanWords>): (ReadonlyMap<number, ScanWords> | undefined)!!
  retireReview(ticket: number, closed: boolean): void!!
  outline(image: number, draft?: ScanOutline): ScanOutline!!
  hold(id: number, image: ScanImage): void!!
  keep(ids: ReadonlySet<number>): void!!
  document(ticket: number, pdf?: Blob): void!!
  takeDocument(ticket: number): (Blob | undefined)!!
  receipt(ticket: number, id?: string): (string | undefined)!!
  event(ticket: number, draft?: ScannedEvent): (ScannedEvent | undefined)!!
}

const assets = Layer.effect(ScanAssets, effect {
  const images = new Map<number, ScanPage>()
  const text = new Map<number, Map<number, ScanWords>>()
  let review: { ticket: number; words: ReadonlyMap<number, ScanWords> } | undefined
  let retiredThrough = 0
  let outline: { image: number; draft: ScanOutline } | undefined
  const turn = try Semaphore.make(1)
  let prepared: { ticket: number; pdf?: Blob } | undefined
  const receipts = new Map<number, string>()
  let event: { ticket: number; draft: ScannedEvent } | undefined
  const updates = createShelf(0)
  function touch() { updates.update((n) => n + 1) }
  function remove(id: number): boolean {
    const image = images.get(id)
    if (image !== undefined) release(image.uri)
    const removed = images.delete(id)
    text.delete(id)
    return removed
  }
  try addFinalizer(() => sync(() => { for (const id of images.keys()) remove(id) }))
  return {
    turn,
    version: () => sync(() => updates),
    read: (id: number) => sync(() => images.get(id)),
    words: (id: number, revision: number) => sync(() => text.get(id)?.get(revision)),
    holdWords: (id: number, revision: number, value: ScanWords) => sync(() => {
      const row = text.get(id) ?? new Map<number, ScanWords>()
      row.set(revision, value)
      for (const prior of row.keys()) if (prior + 4 < revision) row.delete(prior)
      text.set(id, row)
      touch()
    }),
    review: (ticket: number, words?: ReadonlyMap<number, ScanWords>) => sync(() => {
      if (words !== undefined && ticket > retiredThrough && (review === undefined || review.ticket <= ticket)) { review = { ticket, words }; touch() }
      return review?.ticket === ticket ? review.words : undefined
    }),
    retireReview: (ticket: number, closed: boolean) => sync(() => {
      retiredThrough = Math.max(retiredThrough, closed ? ticket : ticket - 1)
      if (review !== undefined && review.ticket <= retiredThrough) { review = undefined; touch() }
    }),
    outline: (image: number, draft?: ScanOutline) => sync(() => {
      if (draft !== undefined) { outline = { image, draft }; touch() }
      return outline?.image === image ? outline.draft : { corners: fullPage(), turns: 0 }
    }),
    hold: (id: number, image: ScanImage) => sync(() => {
      remove(id)
      images.set(id, { ...image, uri: source(image.blob) })
      touch()
    }),
    keep: (ids: ReadonlySet<number>) => sync(() => {
      let changed = false
      for (const id of images.keys()) if (!ids.has(id) && remove(id)) changed = true
      if (changed) touch()
    }),
    document: (ticket: number, pdf?: Blob) => sync(() => {
      if (prepared === undefined || ticket >= prepared.ticket) prepared = { ticket, pdf }
    }),
    event: (ticket: number, draft?: ScannedEvent) => sync(() => {
      if (draft !== undefined) { event = { ticket, draft }; touch() }
      return event?.ticket === ticket ? event.draft : undefined
    }),
    receipt: (ticket: number, id?: string) => sync(() => {
      if (id !== undefined) receipts.set(ticket, id)
      const found = receipts.get(ticket)
      if (id === undefined) receipts.delete(ticket)
      return found
    }),
    takeDocument: (ticket: number) => sync(() => {
      if (prepared?.ticket !== ticket) return undefined
      const { pdf } = prepared
      prepared = { ticket }
      return pdf
    }),
  }
})

/** Begin Files' scan, from its own menu. */
export effect function startScan(): void!!ScanEntry {
  try (try ScanEntry).ask()
}

const visible = started(effect {
  const shell = try Shell
  const entry = try ScanEntry
  const scan = try Scan.Machine
  try Stream.runForEach(Stream.zipLatest(shell.changes, entry.requests), effect ([front, asked]) => {
    const state = try scan.get()
    if (!showing(front, "Files")) {
      if (state.open) try contained(scan.send({ type: "hidden", picking: false }, "Phone"), "leaving the scan")
      return
    }
    if (asked) {
      const taken = try entry.take()
      if (taken && Scan.canStart(state, "Owner")) try contained(scan.send({ type: "start" }, "Owner"), "opening the scanner")
    }
  })
}, "Files scanner foreground")

effect function admitScanImage(blob: Blob) {
  const accepted = tryPromise(() => scanImage(blob)) catch () => undefined
  if (accepted === undefined) {
    try say("Choose a JPEG, PNG or WebP image under 16 MB.", true)
    return undefined
  }
  return accepted
}

effect function fitsScanBudget(pages: ReadonlyArray<{ readonly image: number }>, held: Effect.Success<typeof ScanAssets>, incoming: number, replacing: number) {
  let total = incoming
  for (const page of pages) {
    if (page.image !== replacing) total += (try held.read(page.image))?.blob.size ?? 0
  }
  if (total > 64_000_000) {
    try say("This document exceeds 64 MB.", true)
    return false
  }
  return true
}

/** An image selected by the owner is admitted once, and the scanner's generated model gets a new page identity. */
export effect function addScanImage(blob: Blob, replacing: number, camera: boolean) {
  const accepted = try admitScanImage(blob)
  if (accepted === undefined) return
  const held = try ScanAssets
  const model = try Scan.Machine
  try Semaphore.withPermit(held.turn, effect {
    const state = try model.get()
    const next = state.images + 1
    if (!Scan.canAdd(state, next, replacing, camera, "Phone")) return
    if (!(try fitsScanBudget(state.pages, held, accepted.blob.size, replacing))) return
    try held.hold(next, accepted)
    try contained(model.send({ type: "add", frame: next, replacing, camera }, "Phone"), "adding the scanned page")
  })
}

// spec/app/files/scan.md, "Story: Arrange the pages"
export effect function scanSelectedImage(blob: Blob) {
  const shell = try Shell
  const photos = try PhotoLibrary.Machine
  const device = try Device
  const origin = try photos.get()
  if (!(try (try PhotoChooser).finish()) || !origin.visible || origin.secure || !showing(try shell.get(), "Photos")) return
  const accepted = try admitScanImage(blob)
  if (accepted === undefined) return
  const held = try ScanAssets
  const model = try Scan.Machine
  try Semaphore.withPermit(held.turn, effect {
    const current = try photos.get()
    const state = try model.get()
    const frame = state.images + 1
    if (!current.visible || current.secure || current.library.ticket !== origin.library.ticket
      || !showing(try shell.get(), "Photos") || !(try device.showing()) || !Scan.canStartImage(state, frame, "Phone")) return
    try held.hold(frame, accepted)
    if (!(try contained(model.send({ type: "startImage", frame }, "Phone"), "opening selected image text"))) {
      try held.keep(new Set(state.pages.map((page) => page.image)))
    }
  })
}

function failedLoad(ticket: number): Scan.Event {
  return { type: "loaded", ticket, ok: false, readable: true, base: 0, pages: [] }
}

effect function load(ticket: number): Scan.Event!!(ScanAssets | Scan.Machine) {
  const saved = try readDraft()
  if (saved === "damaged") return { type: "loaded", ticket, ok: true, readable: false, base: 0, pages: [] }
  const model = try Scan.Machine
  const held = try ScanAssets
  return try Semaphore.withPermit(held.turn, effect {
    const state = try model.get()
    if (!Scan.canLoaded(state, ticket, "Phone")) return failedLoad(ticket)
    const pages = saved?.pages ?? []
    const present = new Set(state.pages.map((page) => page.image))
    let serial = Math.max(state.images, ...pages.map(({ page }) => page.image))
    const restored: Page[] = []
    for (const image of pages) {
      const old = image.page
      const id = present.has(old.image) ? ++serial : old.image
      const page = id === old.image ? old : { ...old, image: id, text: old.text === 0 ? 0 : id }
      try held.hold(page.image, image)
      if (image.words !== undefined) try held.holdWords(page.image, page.edits, image.words)
      restored.push(page)
    }
    return { type: "loaded", ticket, ok: true, readable: true, base: saved?.revision ?? 0, pages: restored }
  })
}

effect function store(ticket: number, base: number, pages: ReadonlyArray<Page>): Scan.Event!!ScanAssets {
  const assets = try ScanAssets
  const found: StoredPage[] = []
  const failed = { type: "draftSaved", ticket, ok: false, landed: false, held: base } as const
  for (const page of pages) {
    const image = try assets.read(page.image)
    if (image === undefined) return failed
    const words = page.text === 0 ? undefined : try assets.words(page.image, page.edits)
    if (page.text !== 0 && words === undefined) return failed
    found.push({ page, blob: image.blob, width: image.width, height: image.height, words })
  }
  const wrote = tryPromise(() => changeDraft(base, found)) catch () => undefined
  return wrote === undefined ? failed : { ...failed, ok: true, landed: wrote.landed, held: wrote.revision }
}

effect function prepare(ticket: number, pages: ReadonlyArray<Page>, review: number): Scan.Event!!ScanAssets {
  const assets = try ScanAssets
  const images: Blob[] = []
  const layers: ReadonlyArray<ScanTextLine>[] = []
  const reviewed = review === 0 ? undefined : try assets.review(review)
  const failed = { type: "prepared", ticket, ok: false, problem: "NotDrawn" } as const
  try assets.document(ticket)
  for (const p of pages) {
    const item = try assets.read(p.image)
    if (item === undefined) return failed

    images.push(item.blob)
    if (review !== 0) {
      const words = reviewed?.get(p.image)
      if (words === undefined) return failed
      layers.push(words.lines)
    }
  }
  if (review !== 0) {
    const client = tryPromise(loadFilesClient) catch () => undefined
    if (client === undefined) return failed
    const made = timeout(map(client.createScanPdf({ title: "Scanned document", creator: "Alpha" }, images, layers), (bytes) => ({ bytes })), 60_000) catch (error) => {
      if (typeof error === "object" && error !== null && "_tag" in error) {
        if (error._tag === "PdfRefused" && "reason" in error && error.reason === "too-large") return { problem: "TooLarge" } as const
        const rejectedText = error._tag === "TextLayerRefused" || (error._tag === "PdfRefused" && "reason" in error && error.reason === "unsupported-text")
        return { problem: rejectedText ? "TooMuchText" : "NotDrawn" } as const
      }
      return { problem: "NotDrawn" } as const
    }
    if ("problem" in made) return { ...failed, problem: made.problem }
    try assets.document(ticket, client.blobOf([made.bytes], "application/pdf"))
    return { ...failed, ok: true, problem: "NoProblem" }
  }
  const built = timeout(tryPromise((signal) => drawPdf(images, signal)), 60_000) catch () => undefined
  if (built === undefined) return failed
  if ("problem" in built) return { ...failed, problem: built.problem }
  try assets.document(ticket, built.pdf)
  return { ...failed, ok: true, problem: "NoProblem" }
}

effect function write(ticket: number): Scan.Event!!ScanAssets {
  const assets = try ScanAssets
  const pdf = try assets.takeDocument(ticket)
  const refused = { type: "exported", ticket, confirmed: false, known: true } as const
  if (pdf === undefined) return refused
  const wrote = try writePdf(pdf)
  if (wrote.confirmed && wrote.selectionId !== undefined) try assets.receipt(ticket, wrote.selectionId)
  return { ...refused, confirmed: wrote.confirmed, known: wrote.known }
}

effect function keep(ticket: number, image: number): Scan.Event!!(ScanAssets | PhotosPort | Attempts) {
  const selected = try (try ScanAssets).read(image)
  const refused = { type: "kept", ticket, confirmed: false, known: true } as const
  if (selected === undefined) return refused
  const photos = try PhotosPort
  if (Option.isNone(photos.phone)) {
    if (native()) return refused
    const extension = selected.blob.type === "image/png" ? "png" : selected.blob.type === "image/webp" ? "webp" : "jpg"
    const saved = tryPromise(() => saveBrowserCapture(selected.blob, `Scanned page.${extension}`, selected.width, selected.height)) catch () => undefined
    return { ...refused, confirmed: saved !== undefined }
  }
  const data = tryPromise(() => photoData(selected.blob)) catch () => undefined
  if (data === undefined) return refused
  const phone = photos.phone.value
  const operationId = try (try Attempts).key(ticket)
  const result = tryPromise(() => phone.keepCapture({ operationId, dataBase64: data })) catch () => undefined
  return { ...refused, confirmed: result?.status === "saved", known: result !== undefined }
}

const ocr = { workerUrl: "/ocr/worker.min.js", assetsUrl: "/ocr/", language: "eng" }

function unread(ticket: number): Extract<Scan.Event, { type: "recognized" }> {
  return { type: "recognized", ticket, ok: false, blank: false, links: 0 }
}

effect function localWords(blob: Blob): (ScanWords | undefined)!! {
  const client = tryPromise(loadFilesClient) catch () => undefined
  if (client === undefined) return undefined
  const words = timeout(client.recognizeLocalText(ocr, blob, () => {}, true), 45000) catch () => undefined
  return words === undefined ? undefined : { text: words.text, lines: words.lines ?? [], links: client.scannedLinks(words.text) }
}

effect function recognize(ticket: number, image: number): Scan.Event!!(ScanAssets | Scan.Machine) {
  const held = try ScanAssets
  const model = try Scan.Machine
  const page = try held.read(image)
  if (page === undefined) return unread(ticket)
  const words = try localWords(page.blob)
  const state = try model.get()
  if (words === undefined || !Scan.canRecognized(state, ticket, "Phone") || state.text.read !== image || !Scan.has(state, image)) return unread(ticket)
  try held.holdWords(image, 0, words)
  return { type: "recognized", ticket, ok: true, blank: words.text.trim() === "", links: words.links.length }
}

/** The reviewed words and their original page positions change together. */
export effect function editScanLine(image: number, index: number, value: string) {
  const held = try ScanAssets
  const model = try Scan.Machine
  const client = tryPromise(loadFilesClient) catch () => undefined
  if (client === undefined) return
  try Semaphore.withPermit(held.turn, effect {
    const state = try model.get()
    if (!Scan.canEditText(state, image, "Owner")) return
    const page = Scan.pageOf(state, image)
    const old = try held.words(image, page.edits)
    if (old === undefined || old.lines[index] === undefined || old.lines[index]?.text === value) return
    const lines = client.admittedTextLayer(old.lines.map((line, at) => at === index ? { ...line, text: value } : line))
    if (lines === undefined) return
    const text = lines.map((line) => line.text).join("\n")
    const links = client.scannedLinks(text)
    try held.holdWords(image, page.edits + 1, { text, links, lines })
    try contained(model.send({ type: "editText", image, links: links.length }, "Owner"), "correcting the text of a page")
  })
}

function unreadSearch(ticket: number, image: number): Extract<Scan.Event, { type: "searchRead" }> {
  return { type: "searchRead", ticket, image, ok: false }
}

effect function readSearch(ticket: number, image: number): Scan.Event!!(ScanAssets | Scan.Machine) {
  const assets = try ScanAssets
  const machine = try Scan.Machine
  const page = try assets.read(image)
  if (page === undefined || !Scan.canSearchRead(try machine.get(), ticket, image, "Phone")) return unreadSearch(ticket, image)
  const retired = Effect.as(Stream.runHead(Stream.filter(machine.changes, (state) => !Scan.canSearchRead(state, ticket, image, "Phone"))), undefined)
  const words = try Effect.raceFirst(localWords(page.blob), retired)
  if (words === undefined || !Scan.canSearchRead(try machine.get(), ticket, image, "Phone")) return unreadSearch(ticket, image)
  const staged = new Map(try assets.review(ticket))
  staged.set(image, words)
  try assets.review(ticket, staged)
  return { type: "searchRead", ticket, image, ok: true }
}

export interface SearchLine {
  readonly image: number
  readonly line: number
  readonly text: string
}

/** The text shown during review belongs to the staged reading or the exact existing revision. */
export effect function searchWords(ticket: number, page: Page): (ScanWords | undefined)!!ScanAssets {
  const assets = try ScanAssets
  const staged = (try assets.review(ticket))?.get(page.image)
  return staged ?? (page.text === 0 ? undefined : try assets.words(page.image, page.edits))
}

effect function reviewedWords(ticket: number, pages: ReadonlyArray<Page>, edits: readonly SearchLine[]): (ReadonlyMap<number, ScanWords> | undefined)!!ScanAssets {
  const client = edits.length === 0 ? undefined : (tryPromise(loadFilesClient) catch () => undefined)
  if (edits.length > 0 && client === undefined) return undefined
  const staged = new Map<number, ScanWords>()
  for (const page of pages) {
    const present = try searchWords(ticket, page)
    if (present === undefined) return undefined
    const changed = edits.filter((line) => line.image === page.image)
    if (changed.length === 0) { staged.set(page.image, present); continue }
    if (client === undefined) return undefined
    const lines = client.admittedTextLayer(present.lines.map((line, index) => ({ ...line, text: changed.find((item) => item.line === index)?.text ?? line.text })))
    if (lines === undefined) return undefined
    const text = lines.map((line) => line.text).join("\n")
    staged.set(page.image, { text, lines, links: client.scannedLinks(text) })
  }
  return staged
}

effect function revisedSearch(pages: ReadonlyArray<Page>, staged: ReadonlyMap<number, ScanWords>): (Page[] | undefined)!!ScanAssets {
  const assets = try ScanAssets
  const result: Page[] = []
  for (const page of pages) {
    const words = staged.get(page.image)
    if (words === undefined) return undefined
    const prior = page.text === 0 ? undefined : try assets.words(page.image, page.edits)
    if (prior !== undefined && prior.text === words.text && prior.lines.length === words.lines.length
      && prior.lines.every((line, index) => line.text === words.lines[index]?.text)) {
      result.push(page)
    } else {
      const blank = words.text.trim() === ""
      result.push({ ...page, text: page.image, blank, edits: page.text === 0 ? 0 : page.edits + 1, links: blank ? 0 : words.links.length })
    }
  }
  return result
}

effect function keepReviewed(pages: ReadonlyArray<Page>, staged: ReadonlyMap<number, ScanWords>): void!!ScanAssets {
  const assets = try ScanAssets
  for (const page of pages) {
    const words = staged.get(page.image)
    if (words !== undefined) try assets.holdWords(page.image, page.edits, words)
  }
}

/** Keeping text and starting the separate PDF save both use the exact review seen by the owner. */
export effect function confirmSearch(ticket: number, edits: readonly SearchLine[], save: boolean) {
  const assets = try ScanAssets
  const model = try Scan.Machine
  try Semaphore.withPermit(assets.turn, effect {
    const state = try model.get()
    if (!Scan.currentSearch(state, ticket) || state.search.stage !== "SearchReview") return
    const staged = try reviewedWords(ticket, state.pages, edits)
    if (staged === undefined) { try say("This text could not be prepared."); return }
    if (save) {
      if (!Scan.canSaveSearch(state, ticket, "Owner")) return
      try assets.review(ticket, staged)
      try contained(model.send({ type: "saveSearch", ticket }, "Owner"), "saving the reviewed PDF")
      return
    }
    const reviewed = try revisedSearch(state.pages, staged)
    if (reviewed === undefined || !Scan.canKeepSearch(state, ticket, reviewed, "Owner")) return
    try keepReviewed(reviewed, staged)
    try contained(model.send({ type: "keepSearch", ticket, reviewed }, "Owner"), "keeping reviewed text")
  })
}

effect function savedSearch(ticket: number): void!!(ScanAssets | Scan.Machine) {
  const assets = try ScanAssets
  const model = try Scan.Machine
  try Semaphore.withPermit(assets.turn, effect {
    const state = try model.get()
    const staged = try assets.review(ticket)
    if (!Scan.currentSearch(state, ticket)) return
    const reviewed = staged === undefined ? undefined : try revisedSearch(state.pages, staged)
    if (staged === undefined || reviewed === undefined || !Scan.canFinishSearch(state, ticket, reviewed, "Phone")) {
      if (Scan.canCancelSearch(state, ticket, "Phone")) try ignore(model.send({ type: "cancelSearch", ticket }, "Phone"))
      return
    }
    try keepReviewed(reviewed, staged)
    try contained(model.send({ type: "finishSearch", ticket, reviewed }, "Phone"), "keeping the saved PDF text")
  })
}

function calendarDraft(value: ScanEventProposal, disclosures: ReadonlyArray<string>): ScannedEvent | undefined {
  const [year = 1970, month = 1, date = 1] = value.date.split("-").map(Number)
  const [hour = 0, minute = 0] = (value.time ?? "").split(":").map(Number)
  const begin = new Date(year, month - 1, date, hour, minute).getTime()
  if (!Number.isFinite(begin)) return undefined
  const day = civilDay(begin)
  return {
    day, disclosures,
    fields: {
      title: value.title, place: value.location, notes: value.notes, people: "", allDay: value.allDay,
      begin, end: value.allDay ? dayStart(day + 1) : begin + (value.minutes ?? 60) * 60_000,
    },
  }
}

effect function suggested(ticket: number, image: number, edits: number): Scan.Event!!(ScanAssets | Scan.Machine | Time) {
  const held = try ScanAssets
  const words = try held.words(image, edits)
  const absent = { type: "eventSuggested", ticket, ok: true, found: false } as const
  if (words === undefined) return absent
  const client = tryPromise(loadFilesClient) catch () => undefined
  if (client === undefined) return absent
  const now = new Date(try (try Time).now())
  const suggestion = client.suggestScanEventDetails(words.text, { now, timeZone: zone() })
  const fields = suggestion.fields
  const reviewed = (suggestion.allDay ? client.reviewScanAllDayEvent(fields, words.text, now) : client.reviewScanEvent(fields, words.text, now)) catch () => undefined
  const draft = reviewed === undefined ? undefined : calendarDraft(reviewed, suggestion.disclosures)
  const state = try (try Scan.Machine).get()
  if (draft === undefined || !Scan.canEventSuggested(state, ticket, "Phone") || Scan.pageOf(state, image).edits !== edits) return absent
  try held.event(ticket, draft)
  return { ...absent, found: true }
}

/** Open only the event suggestion still shown for this page; Calendar owns the draft and the final save. */
export effect function reviewCalendarEvent(ticket: number) {
  const current = try (try Scan.Machine).get()
  const read = current.text.event
  const page = current.text.eventOf
  const latest = Scan.pageOf(current, page.image)
  if (!current.open || !current.text.found || read.ticket !== ticket || latest.text !== page.text || latest.edits !== page.edits) return
  const draft = try (try ScanAssets).event(ticket)
  if (draft === undefined) return
  const entry = try ScanEntry
  const shell = try Shell
  try entry.calendar(draft)
  if (!(try contained(shell.send({ type: "openView", view: "Calendar" }), "opening Calendar for review"))) try entry.takeEvent()
}

module notes {
  import { createNotesClient, type NotesClient, type NotesTransport } from "@elizaos/plugin-notes-client"
  import { Effect } from "effect"
  import { HttpClientRequest } from "effect/http"
  import type { Remote } from "../platform/index.vibe"

  /** Run the SDK client on the same authenticated agent transport as Notes. @throws {never} */
  export function noteClient(agent: Remote): NotesClient {
    const transport: NotesTransport = {
      async fetch<T>(path: string, init: Parameters<NotesTransport["fetch"]>[1]): Promise<T> {
        const request = init.method === "GET" ? HttpClientRequest.get(path) : HttpClientRequest.post(path)
        const body = init.body === undefined ? request : HttpClientRequest.bodyText(request, init.body, "application/json")
        const reply = await Effect.runPromise(agent.call(HttpClientRequest.setHeaders(body, init.headers)), init.signal === undefined ? undefined : { signal: init.signal })
        return reply as T
      },
    }
    return createNotesClient(transport)
  }
}
import { noteClient } from notes

/** The same content the owner sees in the note review, in the document's page order. */
export effect function noteContent(pages: ReadonlyArray<Page>): (string | undefined)!!ScanAssets {
  const held = try ScanAssets
  const words: string[] = []
  for (const page of pages) {
    if (page.text === 0 || page.blank) continue
    const found = try held.words(page.image, page.edits)
    if (found === undefined) return undefined
    words.push(found.text)
  }
  return words.join("\n\n")
}

effect function noted(ticket: number, pages: ReadonlyArray<Page>): Scan.Event!!(Agent | Attempts | ScanAssets | Effect.Services<ReturnType<typeof say>>) {
  const refused = { type: "noted", ticket, confirmed: false, known: true } as const
  const content = try noteContent(pages)
  if (content === undefined || content.trim() === "" || content.length > scanNoteLimit) return refused
  const client = noteClient(try Agent)
  const creationId = try (try Attempts).key(ticket)
  const written = tryPromise((signal) => client.interact("create-note", { content, creationId, forceNew: true }, signal)) catch () => undefined
  if (written?.note === undefined) return { ...refused, known: false }
  try say("Note saved.")
  return { ...refused, confirmed: true }
}

type Needs = ScanAssets | Scan.Machine | PhotosPort | ScanExports | Time | Agent | Device | Effect.Services<ReturnType<typeof say>>

/** Take a confirmed Android selection into Files Recent. */
export effect function retainScanExport(id: SelectionId) {
  const documents = (try Documents).client
  if (Option.isNone(documents)) return
  const client = documents.value
  const description = tryPromise(() => client.describe(id)) catch () => undefined
  if (description?.status === "selected" && description.name) {
    const recent = try Recent.Machine
    const key = (try recent.get()).issued + 1
    const opened = try Opened
    try opened.give(key, { selection: id, key, name: description.name, mimeType: "application/pdf", revision: Math.max(0, Math.trunc(description.modified ?? 0)) })
    if (try contained(recent.send({ type: "exported", key }, "Phone"), "listing the exported file")) return
    try opened.take(key)
  }
  try ignore(tryPromise(() => client.forget(id)))
}

effect function recordExport(ticket: number) {
  const selection = try (try ScanAssets).receipt(ticket)
  if (selection !== undefined) try (try ScanExports).record(selection as SelectionId)
  try say("PDF saved.")
}

function carry(fx: Scan.Effect): Job<Scan.Event, Needs, [Scan.Actor]> {
  switch (fx.tag) {
    case "Load": return answer("read the scan draft", load(fx.ticket), failedLoad(fx.ticket), "Phone")
    case "Save": return answer("save the scan draft", store(fx.ticket, fx.base, fx.pages), { type: "draftSaved", ticket: fx.ticket, ok: false, landed: false, held: fx.base }, "Phone")
    case "Discard": return answer("delete the scan draft", effect {
      const wrote = tryPromise(() => changeDraft(fx.base, undefined)) catch () => undefined
      return { type: "discarded", ticket: fx.ticket, confirmed: wrote?.landed === true, known: wrote !== undefined } as const
    }, { type: "discarded", ticket: fx.ticket, confirmed: false, known: false }, "Phone")
    case "Prepare": return answer("draw the scan", prepare(fx.ticket, fx.pages, fx.review), { type: "prepared", ticket: fx.ticket, ok: false, problem: "NotDrawn" }, "Phone")
    case "Export": return answer("save the scan", write(fx.ticket), { type: "exported", ticket: fx.ticket, confirmed: false, known: false }, "Phone")
    case "Keep": return answer("keep the capture", keep(fx.ticket, fx.image), { type: "kept", ticket: fx.ticket, confirmed: false, known: false }, "Phone")
    case "Recognize": return answer("read text", recognize(fx.ticket, fx.image), unread(fx.ticket), "Phone")
    case "SearchRead": return answer("read search text", readSearch(fx.ticket, fx.image), unreadSearch(fx.ticket, fx.image), "Phone")
    case "SearchSaved": return run("keep the reviewed PDF text", savedSearch(fx.ticket), "Phone")
    case "OpenLink": return answer("open link", effect {
      const words = try (try ScanAssets).words(fx.image, fx.edits)
      const url = words?.links[fx.link - 1]
      const opened = url === undefined ? false : (Effect.try(() => openLink(url)) catch () => false)
      return { type: "linkOpened", ticket: fx.ticket, opened } as const
    }, { type: "linkOpened", ticket: fx.ticket, opened: false }, "Phone")
    case "Suggest": return answer("suggest event", suggested(fx.ticket, fx.image, fx.edits), { type: "eventSuggested", ticket: fx.ticket, ok: false, found: false }, "Phone")
    case "Note": return answer("make note", noted(fx.ticket, fx.pages), { type: "noted", ticket: fx.ticket, confirmed: false, known: false }, "Phone")
    case "ToRecent": return run("confirm scan export", recordExport(fx.ticket), "Phone")
    case "CopyText": return run("copy scan text", effect {
      const words = try (try ScanAssets).words(fx.image, fx.edits)
      if (words === undefined) return
      const copied = (try (try Device).copyText(words.text))
        || (tryPromise(() => copyText(words.text).then(() => true)) catch () => false)
      if (!copied) try say("Could not copy scanned text.", true)
    }, "Phone")
  }
}

const edits = started(effect {
  const model = try Scan.Machine
  const held = try ScanAssets
  try Stream.runForEach(model.changes, effect (state) => {
    const live = new Set([...state.pages, ...state.keeping.carrying, ...state.keeping.saved].map((page) => page.image))
    try Semaphore.withPermit(held.turn, held.keep(live))
    const active = try model.get()
    const ticket = active.search.ticket
    if (Scan.canCancelSearch(active, ticket, "Phone") && !Scan.currentSearch(active, ticket)) {
      try contained(model.send({ type: "cancelSearch", ticket }, "Phone"), "retiring stale searchable text")
    }
    const search = (try model.get()).search
    try held.retireReview(search.ticket, search.stage === "SearchClosed")
    if (Scan.canSaveDraft(state, "Phone")) try contained(model.send({ type: "saveDraft" }, "Phone"), "keeping the scan draft")
  })
}, "keeping scan pages")

/** A dialog's Back goes to the scan first, keeping the current draft. */
export const scanBack = effect {
  const model = try Scan.Machine
  const state = try model.get()
  const ticket = state.search.ticket
  if (Scan.canCancelSearch(state, ticket, "Owner")) return try contained(model.send({ type: "cancelSearch", ticket }, "Owner"), "closing searchable text")
  if (state.search.stage === "SearchSaving") return true
  const editing = try Correction.Machine
  if (Correction.canCancel(try editing.get(), "Owner")) return try contained(editing.send({ type: "cancel" }, "Owner"), "closing the correction")
  if (Scan.canCloseLinks(state, "Owner")) return try contained(model.send({ type: "closeLinks" }, "Owner"), "closing scanned links")
  if (!Scan.canClose(state, "Owner")) return false
  return try contained(model.send({ type: "close" }, "Owner"), "closing the scan")
}

/** Replace a corner after the owner has moved it, or change the quarter-turns of the reviewed correction. */
export effect function setScanOutline(image: number, draft: ScanOutline) {
  const held = try ScanAssets
  const model = try Correction.Machine
  try Semaphore.withPermit(held.turn, effect {
    const state = try model.get()
    if (state.image !== image || !Correction.canMoveCorner(state, "Owner")) return
    try held.outline(image, draft)
    try contained(model.send({ type: "moveCorner" }, "Owner"), "showing the revised outline")
  })
}

type CorrectionNeeds = ScanAssets | Scan.Machine | Correction.Machine | Effect.Services<ReturnType<typeof say>>

effect function outline(image: number, revision: number, detect: boolean): Correction.Event!!(ScanAssets | Correction.Machine) {
  const held = try ScanAssets
  const model = try Correction.Machine
  const requested = { type: "outlined", revision, ok: false } as const
  const source = try held.read(image)
  if (source === undefined) return requested
  const client = tryPromise(loadFilesClient) catch () => undefined
  if (client === undefined) return requested
  let value = try held.outline(image)
  if (detect) {
    const detected = client.detectScanEdges(source.blob) catch () => undefined
    value = { corners: detected ?? fullPage(), turns: 0 }
  }
  const state = try model.get()
  if (!Correction.canOutlined(state, revision, "Phone") || state.image !== image) return requested
  try held.outline(image, value)
  return { ...requested, ok: client.scanCornersAdmitted(value.corners) }
}

effect function useCorrection(image: number) {
  const model = try Scan.Machine
  const held = try ScanAssets
  const selected = try held.read(image)
  if (selected === undefined) return
  const client = tryPromise(loadFilesClient) catch () => undefined
  if (client === undefined) {
    try say("The page could not be corrected.", true)
    return
  }
  const draft = try held.outline(image)
  const warped = client.correctScanPage(selected.blob, draft.corners) catch () => undefined
  const adjusted = warped === undefined ? undefined : (tryPromise(() => rotateImage(warped, draft.turns)) catch () => undefined)
  const corrected = adjusted === undefined ? undefined : (tryPromise(() => scanImage(adjusted)) catch () => undefined)
  if (corrected === undefined) {
    try say("The page could not be corrected.", true)
    return
  }
  try Semaphore.withPermit(held.turn, effect {
    const state = try model.get()
    if (!Scan.canCorrected(state, image, "Phone")) return
    if (!(try fitsScanBudget(state.pages, held, corrected.blob.size, image))) return
    try held.hold(state.images + 1, corrected)
    try contained(model.send({ type: "corrected", image }, "Phone"), "replacing the corrected page")
  })
}

function carryCorrection(fx: Correction.Effect): Job<Correction.Event, CorrectionNeeds, [Correction.Actor]> {
  switch (fx.tag) {
    case "Outline": return answer("draw the scan outline", outline(fx.image, fx.revision, fx.detect), { type: "outlined", revision: fx.revision, ok: false }, "Phone")
    case "Corrected": return run(`correct page ${fx.image}`, useCorrection(fx.image), "Phone")
  }
}

const leavingCorrection = applying(Scan.Machine, (state) => state.open, effect (open: boolean) => {
  if (open) return
  const editing = try Correction.Machine
  if (Correction.canCancel(try editing.get(), "Phone")) try contained(editing.send({ type: "cancel" }, "Phone"), "closing the page correction")
})

const common = together(reacting(Correction, { carry: carryCorrection }), assets, edits, leavingCorrection)

const photosVisible = started(effect {
  const shell = try Shell
  const photos = try PhotoLibrary.Machine
  const model = try Scan.Machine
  try Stream.runForEach(Stream.zipLatest(shell.changes, photos.changes), effect ([front, library]) => {
    const state = try model.get()
    if ((!showing(front, "Photos") || library.secure) && Scan.canHidden(state, false, "Phone")) {
      try contained(model.send({ type: "hidden", picking: false }, "Phone"), "leaving selected image text")
    }
  })
}, "Photos scan foreground")

export const imageScan = together(reacting(Scan, { carry }), Layer.fresh(common), photosVisible)

module compatible {
  import type { Scan } from "../../gen/app__files__scan.ts"

  /** Restore earlier durable scans using this visit's review. @throws {never} */
  export function keptScan(raw: string, search: Scan["search"]): unknown {
    try {
      const state: unknown = JSON.parse(raw)
      return typeof state === "object" && state !== null && !Array.isArray(state)
        ? { origin: "Document", ...state, search }
        : state
    } catch {
      return raw
    }
  }

  /** The searchable review is kept only in memory. @throws {never} */
  export function durableScan(state: Scan): string {
    const { search: _search, ...kept } = state
    return JSON.stringify(kept)
  }
}
import { durableScan, keptScan } from compatible

function stored(key: string, start = Scan.initial) {
  return Layer.effect(Scan.Machine, effect {
    const store = try KeyValueStore.KeyValueStore
    let search = Scan.initial.search
    let durable: string | undefined
    effect function load() {
      const raw = try store.get(key)
      const state = raw === undefined ? { ...start, search } : try Scan.decodeState(keptScan(raw, search))
      durable = durableScan(state)
      return state
    }
    return try Scan.machineOver(load, effect (next: Scan.Scan) => {
      const value = durableScan(next)
      if (value !== durable) try orDie(store.set(key, value))
      search = next.search
    })
  })
}

export const scan = together(reacting({ ...Scan, stored }, { carry, keep: 1, open: [{ type: "restart" }, "Phone"] }), common, visible)
