// spec/app/files/shared.md, "A file has a number, a name, a revision that changes whenever the file does, a kind, its size, and the storage volume it is on"
import type { Kind } from "../../gen/app__files__shared.effect.vibe"

/** What a file is, from what the phone says of it. */
export function kindOf(entry: { readonly directory: boolean; readonly mimeType: string }): Kind {
  if (entry.directory) return "Folder"
  const { mimeType } = entry
  if (mimeType.startsWith("image/")) return "Image"
  if (mimeType.startsWith("video/")) return "Video"
  if (mimeType.startsWith("audio/")) return "Audio"
  if (mimeType === "application/pdf") return "Pdf"
  if (mimeType.startsWith("text/") || mimeType.includes("document") || mimeType.includes("msword")) return "Document"
  return "Other"
}

/** How many items the phone counted in a folder it listed; a file holds none. */
export function childrenOf(entry: { readonly directory: boolean; readonly children?: number }): number {
  return entry.directory ? Math.max(0, Math.trunc(entry.children ?? 0)) : 0
}

module presentation {
  /** A size in the units the owner reads, to one decimal above a kilobyte. @throws {never} */
  export function sized(bytes: number): string {
    const units = ["B", "KB", "MB", "GB", "TB"];
    let at = 0;
    let value = bytes;
    while (value >= 1024 && at < units.length - 1) { value /= 1024; at += 1; }
    return `${at === 0 || value >= 100 ? Math.round(value) : Math.round(value * 10) / 10} ${units[at]}`;
  }
  const changedTime = new Intl.DateTimeFormat(undefined, { hour: "numeric", minute: "2-digit" });
  const changedDay = new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric" });
  const changedDate = new Intl.DateTimeFormat(undefined, { year: "numeric", month: "short", day: "numeric" });

  /** A file's listing time today, its day this year, or its date with the year. @throws {never} */
  export function changedOn(revision: number, today: Date): string {
    const date = new Date(revision);
    if (revision <= 0 || Number.isNaN(date.getTime())) return "";
    if (date.toDateString() === today.toDateString()) return changedTime.format(date);
    return (date.getFullYear() === today.getFullYear() ? changedDay : changedDate).format(date);
  }
  /** The part of an exact file path that contains its folder. @throws {never} */
  export function parentPath(path: string): string {
    return path.slice(0, Math.max(0, path.lastIndexOf("/")));
  }
  /** A folder's count of items, as v119's rows read it (files-browser-adapter.ts:191 at 45f6bed30). @throws {never} */
  export function itemCount(children: number): string {
    return children === 1 ? "1 item" : `${children} items`
  }
  /** A storage volume and its folder, as Files shows the location. @throws {never} */
  export function folderLocation(volume: string, folder: string): string {
    return [volume, ...folder.split("/").filter(Boolean)].join(" › ");
  }
}
export { changedOn, folderLocation, itemCount, parentPath, sized } from presentation
