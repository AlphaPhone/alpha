// spec/app/files/preview.md, "Story: Look at a file"; spec/app/files/preview.md, "Story: Act on the file I am looking at"; spec/app/files/preview.md, "Story: Get a file back when access was lost"; spec/app/files/recent.md, "Story: Find what I opened lately"
import type { SelectedDocument, SelectedDocumentsClient, SelectionId } from "@elizaos/os-bridges"
import { MMS_MAX_TOTAL_BYTES, sensitiveReadingText } from "@elizaos/os-bridges"
import { fileBase64Cap, imageBase64Cap, imageIntakeBytes, nameLimit } from "../../gen/app__assistant__attachments.effect.vibe"
import type { Attached } from "../assistant/talk.vibe"
import { type Machine as TextMessages } from "../../gen/app__messages.effect.vibe"
import { type Machine as MessageComposer } from "../../gen/app__messages__composer.effect.vibe"
import { type Drafts as MessageDrafts, handOverPicture, pictureBytes, pictureMessagingReady } from "../messages/composer.vibe"
import type { Telephony } from "../platform/index.vibe"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import * as Browser from "../../gen/app__files.effect.vibe"
import * as Shown from "../../gen/app__files__preview.effect.vibe"
import * as Recent from "../../gen/app__files__recent.effect.vibe"
import type { Item } from "../../gen/app__files__shared.effect.vibe"
import { kindOf as storageKind, loadFilesClient, parentPath } from "./entries.vibe"
import { type MediaHandoff, attachToAlpha } from "../assistant/attachments.vibe"
import * as Inbox from "../../gen/app__inbox.effect.vibe"
import type { Machine as Adding } from "../../gen/app__inbox__adding.effect.vibe"
import * as Drafts from "../../gen/app__inbox__drafts.effect.vibe"
import type { Machine as Shell } from "../../gen/app__shell.effect.vibe"
import { type Incoming, handOver } from "../inbox/adding.vibe"
import type { Machine as Toasts } from "../../gen/app__notices__toasts.effect.vibe"
import { type Said, say } from "../notices/index.vibe"
import { earlierCleared } from "../../gen/app__platform__adoption.effect.vibe"
import { Documents, type Files, adopt, called, keptAt, previewUrl } from "../platform/index.vibe"
import { type Job, type Shelf, answer, createShelf, filledStore, following, reacting, run, started, stop, together } from "../runtime/index.vibe"
import { Handles, type Spot } from "./handles.vibe"

/** What a grant of Recent names: the selection the phone gave for the document, its number in Files, its name, type and revision. */
export interface Grant {
  readonly selection: string
  readonly key: number
  readonly name: string
  readonly mimeType: string
  readonly revision: number
  readonly bytes?: number
  readonly canRename?: boolean
  readonly storage?: { readonly volume: string; readonly path: string; readonly label: string }
}

/** Metadata the selected provider last reported for an exact picked grant. */
function pickedFacts(grant: Pick<Grant, "selection" | "key" | "name" | "mimeType">, result: SelectedDocument): Grant {
  return { selection: grant.selection, key: grant.key, name: result.name ?? grant.name, mimeType: result.mimeType ?? grant.mimeType,
    revision: result.modified ?? 0, canRename: result.canRename === true, ...(result.size === undefined ? {} : { bytes: result.size }) }
}

/** What the viewer shows of its file: its text, the address of a picture or recording, and the PDF page drawn. */
export interface Content {
  readonly viewer: number
  readonly text?: string
  readonly uri?: string
  readonly page?: string
  readonly firstPage?: { readonly uri: string; readonly revision: number; readonly isolated: boolean; readonly readOnly: boolean }
}

module kept {
  /** A grant as the store keeps it. */
  export interface Stored {
    readonly selection: string
    readonly key: number
    readonly name: string
    readonly mimeType: string
    readonly revision: number
  }
  /** The grants the store kept, by number. @throws {never} */
  export function grantsOf(raw: string | undefined): Map<number, Stored> {
    if (raw === undefined) return new Map()
    try {
      const found: unknown = JSON.parse(raw)
      return new Map(Array.isArray(found) ? found.filter((one): one is [number, Stored] => Array.isArray(one) && typeof one[0] === "number" && typeof one[1]?.selection === "string") : [])
    } catch {
      return new Map()
    }
  }
  /** @throws {never} */
  export function namesOf(raw: string | undefined): Map<number, string> {
    try {
      const found: unknown = JSON.parse(raw ?? "[]")
      return new Map(Array.isArray(found) ? found.filter((one): one is [number, string] => Array.isArray(one) && Number.isSafeInteger(one[0]) && typeof one[1] === "string") : [])
    } catch {
      return new Map()
    }
  }

  /** @throws {never} */
  export function textFromBase64(data: string): string | undefined {
    const clean = data.replace(/\s+/g, "")
    if (clean.length > 2_000_000) return undefined
    try {
      return new TextDecoder("utf-8", { fatal: true }).decode(Uint8Array.from(atob(clean), (byte) => byte.charCodeAt(0)))
    } catch {
      return undefined
    }
  }

  /** The bridge's payload, retaining the original UTF-8 or image bytes. @throws {never} */
  export function base64(bytes: Uint8Array): string {
    let binary = ""
    for (let at = 0; at < bytes.length; at += 16384) binary += String.fromCharCode(...bytes.subarray(at, at + 16384))
    return btoa(binary)
  }

  /** A preview drawn by this viewer's isolated renderer, fetched only from the app's own origin. */
  export async function pageImage(address: string, limit: number): Promise<Blob | undefined> {
    const url = new URL(address, globalThis.location.href)
    if (url.origin !== globalThis.location.origin) return undefined
    const reply = await fetch(url, { redirect: "error", cache: "no-store" })
    const type = reply.headers.get("content-type")?.split(";", 1)[0]?.trim().toLowerCase()
    if (!reply.ok || (type !== "image/png" && type !== "image/jpeg") || Number(reply.headers.get("content-length")) > limit) {
      await reply.body?.cancel()
      return undefined
    }
    const reader = reply.body?.getReader()
    if (reader === undefined) return undefined
    const chunks: Uint8Array<ArrayBuffer>[] = []
    let size = 0
    try {
      for (;;) {
        const part = await reader.read()
        if (part.done) break
        size += part.value.byteLength
        if (size > limit) return undefined
        chunks.push(part.value)
      }
      return size === 0 ? undefined : new Blob(chunks, { type })
    } finally {
      await reader.cancel()
      reader.releaseLock()
    }
  }

  /** A document the earlier Alpha's Recent held access to. */
  export interface Earlier {
    readonly selection: string
    readonly name: string
    readonly mimeType: string
    readonly at: number
  }
  /** The documents the earlier Alpha's Recent kept with access, the oldest first, at most `most` of the newest. @throws {never} */
  export function earlierOf(raw: string, most: number): Earlier[] {
    try {
      const found: unknown = JSON.parse(raw)
      if (!Array.isArray(found)) return []
      const rows = found.flatMap((row): Earlier[] => typeof row?.selectionId === "string" && /^[A-Za-z0-9:._/-]{1,100}$/.test(row.selectionId) && row.kind === "selected"
        && row.status === "ready" && typeof row.name === "string" && typeof row.mimeType === "string" && Number.isFinite(row.openedAt)
        ? [{ selection: row.selectionId, name: row.name, mimeType: row.mimeType, at: Number(row.openedAt) }] : [])
      const newest = rows.sort((a, b) => a.at - b.at).filter((row, at, all) => !all.slice(at + 1).some((later) => later.selection === row.selection))
      return newest.slice(-most)
    } catch {
      return []
    }
  }

  /** Every selection the earlier Alpha's Recent and open document name, held with access or not. @throws {never} */
  export function earlierHeld(raw: string, open: string | undefined): string[] {
    const selection = /^[A-Za-z0-9:._/-]{1,100}$/
    try {
      const found: unknown = JSON.parse(raw)
      const named = Array.isArray(found) ? found.flatMap((row): string[] => typeof row?.selectionId === "string" && selection.test(row.selectionId) ? [row.selectionId] : []) : []
      return [...new Set([...named, ...(open !== undefined && selection.test(open) ? [open] : [])])]
    } catch {
      return open !== undefined && selection.test(open) ? [open] : []
    }
  }
}
import { base64, earlierHeld, earlierOf, grantsOf, namesOf, pageImage, textFromBase64 } from kept

/**
 * The documents Recent holds access to, each by its grant's number, kept across restarts with what the owner calls
 * them; and what the viewer showing has read, which no other viewer shows.
 */
export service Opened {
  grant(grant: number): Option.Option<Grant>!!
  give(grant: number, given: Grant): void!!
  take(grant: number): Option.Option<Grant>!!
  nameAt(key: number): (string | undefined)!!
  rememberName(key: number, name: string): void!!
  content(): Content!!
  contentShelf(): Shelf<Content>!!
  hold(content: Content): void!!
}

const grantsKey = "alpha/files/grants@1"
const namesKey = "alpha/files/lapsed-names@1"

export const opened = Layer.effect(Opened, effect {
  const store = try KeyValueStore.KeyValueStore
  const grants = grantsOf(store.get(grantsKey) catch () => undefined)
  const names = namesOf(store.get(namesKey) catch () => undefined)
  const shown = createShelf<Content>({ viewer: 0 }, { reset: () => ({ viewer: 0 }) })
  const save = () => ignore(store.set(grantsKey, JSON.stringify([...grants])))
  return {
    grant: (grant: number) => sync(() => Option.fromNullishOr(grants.get(grant))),
    effect give(grant: number, given: Grant): void!! {
      grants.set(grant, given)
      try save()
    },
    effect take(grant: number): Option.Option<Grant>!! {
      const found = Option.fromNullishOr(grants.get(grant))
      grants.delete(grant)
      try save()
      return found
    },
    nameAt: (key: number) => sync(() => names.get(key)),
    effect rememberName(key: number, name: string): void!! {
      names.delete(key)
      names.set(key, name)
      const at = names.keys().next()
      if (names.size > Recent.limit && !at.done) names.delete(at.value)
      try ignore(store.set(namesKey, JSON.stringify([...names])))
    },
    content: () => sync(() => shown.get()),
    contentShelf: () => sync(() => shown),
    hold: (content: Content) => sync(() => { shown.set(content) }),
  }
})

/** How the viewer shows a file of this type. */
export function kindOf(mimeType: string): Shown.Kind {
  if (mimeType === "application/pdf") return "Pdf"
  if (mimeType.startsWith("image/")) return "Photo"
  if (mimeType.startsWith("audio/") || mimeType.startsWith("video/")) return "Media"
  if (mimeType === "application/zip" || mimeType.includes("compressed") || mimeType.includes("archive")) return "Archive"
  return "Text"
}

/** The phone's client of the documents it holds, failing where there is none. */
effect function documents(): SelectedDocumentsClient!string!Documents {
  const { client } = try Documents
  if (Option.isNone(client)) throw "no documents plugin"
  return client.value
}

/** The selection a grant of Recent names, where it still names one. */
effect function selectionOf(grant: number): Option.Option<SelectionId>!!Opened {
  const found = try (try Opened).grant(grant)
  return Option.map(found, (one) => one.selection as SelectionId)
}

/** The grant through which the viewer reads `key`: the one of the document Recent says is open. */
effect function grantOf(key: number): number!!Recent.Machine {
  const shown = (try (try Recent.Machine).get()).shown
  return shown.key === key ? shown.grant : 0
}

/** Whether Files can show this media without dispatching to a different app. */
function previews(mimeType: string): boolean {
  return mimeType === "application/pdf" || mimeType === "application/json" || mimeType === "application/xml"
    || mimeType.startsWith("text/") || mimeType.startsWith("image/") || mimeType.startsWith("audio/") || mimeType.startsWith("video/")
}

effect function openStored(spot: Spot, current: boolean!!): void!!(Files | Toasts | Said) {
  if (!(try current)) return
  const result = called("storageOpen", (plugin) => plugin.storageOpen(spot)) catch () => undefined
  if (result?.status !== "opened" && (try current)) try say("Android could not open this file", true)
}

// spec/app/files/index.md, "The owner opens a file that is listed or found, with the names beside it, and Recent remembers it"
/** Open the read-only Android chooser for a format without a preview, or show and remember an exact grant. */
export effect function view(item: Item, siblings: ReadonlyArray<string>, owner: boolean = false): void!!(Browser.Machine | Files | Handles | Documents | Opened | Recent.Machine | Shown.Machine | Toasts | Said) {
  try ignore(effect {
    const browser = try Browser.Machine
    const before = try browser.get()
    if (!before.open || !Browser.allowed(before) || (owner && !Browser.canView(before, item, "Owner"))) return
    const where = Browser.where(before)
    const current = effect {
      const now = try browser.get()
      if (!now.open || !Browser.allowed(now)) return false
      if (!owner) return true
      const at = Browser.where(now)
      return Browser.canView(now, item, "Owner") && now.listing.ticket === before.listing.ticket
        && now.search.query.ticket === before.search.query.ticket && at.inCategory === where.inCategory && at.category === where.category
        && at.trail.length === where.trail.length && at.trail.every((part, index) => part === where.trail[index])
    }
    const handles = try Handles
    const named = try handles.spot(item.id)
    if (Option.isNone(named)) return
    const spot = named.value
    const docs = (try Documents).client
    if (Option.isNone(docs)) {
      if (owner) try openStored(spot, current)
      return
    }
    let retained = false
    let released = true
    const select = effect {
      return called("storageSelect", (plugin) => plugin.storageSelect(spot)) catch () => undefined
    }
    const outside = try Effect.acquireUseRelease(select, effect (selected) => {
      if (selected?.status !== "selected" || !("selectionId" in selected)) return owner
      if (!(try current)) return false
      if (owner && !previews(selected.mimeType)) return true
      const recent = try Recent.Machine
      uninterruptible {
        const moved = try recent.send({ type: "remember", key: item.id }, "Phone")
        const grant = moved.state.shown.grant
        const label = Option.getOrElse(try handles.label(item.volume), () => spot.volume === "primary" ? "Internal storage" : "Storage")
        try (try Opened).give(grant, { selection: selected.selectionId, key: item.id, name: selected.name, mimeType: selected.mimeType,
          revision: item.revision, bytes: item.bytes, storage: { volume: spot.volume, path: spot.path, label } })
        retained = true
        try (try Shown.Machine).send({ type: "show", file: item.id, kind: kindOf(selected.mimeType), revision: item.revision, siblings: [...siblings] }, "Phone")
      }
      return false
    }, effect (selected) => {
      if (!retained && selected?.status === "selected" && "selectionId" in selected) {
        released = Exit.isSuccess(try exit(tryPromise(() => docs.value.forget(selected.selectionId as SelectionId))))
      }
    })
    if (outside && (try current)) {
      if (released) try openStored(spot, current)
      else try say("Android could not open this file", true)
    }
  })
}

// spec/app/files/preview.md, "What was read of a file is shown only in its own viewer, while it can be read"
effect function read(ticket: number, item: number, revision: number): Shown.Event!!(Documents | Opened | Recent.Machine | Shown.Machine) {
  const failed: Shown.Event = { type: "contentRead", ticket, ok: false, pages: 0, why: "Fine", secret: false }
  return effect {
    const machine = try Shown.Machine
    const viewer = try machine.get()
    if (viewer.item !== item || viewer.revision !== revision || viewer.content.ticket !== ticket) return failed
    const current = effect {
      const state = try machine.get()
      return state.viewer === viewer.viewer && state.revision === revision && Shown.canContentRead(state, ticket, false, "Phone")
    }
    const selection = try selectionOf(try grantOf(item))
    if (Option.isNone(selection)) return failed
    const client = try documents()
    const holder = try Opened
    if (viewer.kind === "Pdf") {
      const first = try Effect.timeoutOption(tryPromise(() => client.pdf(selection.value, 1)), "20 seconds")
      if (Option.isNone(first)) return { ...failed, why: "TooSlow" }
      const rendered = first.value
      if (rendered.status === "unavailable") {
        try ignore(machine.send({ type: "lost" }, "Phone"))
        return failed
      }
      if (rendered.status !== "rendered") return { ...failed, why: /encrypt|password/i.test(rendered.message) ? "Locked" : "Fine" }
      const pages = Math.max(1, Math.trunc(rendered.pageCount ?? 1))
      if (!rendered.imageUri || !(try current)) return failed
      const isolated = !("isolated" in rendered) || rendered.isolated !== false
      const readOnly = !("readOnly" in rendered) || rendered.readOnly !== false
      try holder.hold({ viewer: viewer.viewer, firstPage: { uri: previewUrl(rendered.imageUri), revision, isolated, readOnly } })
      return { type: "contentRead", ticket, ok: true, pages, why: "Fine", secret: false }
    }
    if (viewer.kind === "Text") {
      const text = try tryPromise(() => client.read(selection.value))
      if (!(try current)) return failed
      if (text.status === "unavailable") try ignore(machine.send({ type: "lost" }, "Phone"))
      if (text.status !== "read") return { ...failed, why: text.status === "too-large" ? "TooLarge" : "Fine" }
      try holder.hold({ viewer: viewer.viewer, text: text.text ?? "" })
      return { type: "contentRead", ticket, ok: true, pages: 0, why: "Fine", secret: sensitiveReadingText(text.text ?? "") }
    }
    const described = try tryPromise(() => client.describe(selection.value))
    if (!(try current)) return failed
    if (described.status === "renamed-reselect" || described.status === "unavailable") {
      try ignore(machine.send({ type: "lost" }, "Phone"))
      return failed
    }
    if (described.status !== "selected" || !described.uri || viewer.kind === "Archive") return failed
    try holder.hold({ viewer: viewer.viewer, uri: previewUrl(described.uri) })
    return { type: "contentRead", ticket, ok: true, pages: 0, why: "Fine", secret: false }
  } catch () => failed
}

// spec/app/files/preview.md, "A page the worker takes too long to draw is given up, and its late answer shows nothing"; spec/app/files/preview.md, "A page is shown only when the worker drew it in isolation and handed it over unwritable"
effect function drew(ticket: number, item: number, revision: number, page: number): Shown.Event!!(Documents | Opened | Recent.Machine | Shown.Machine) {
  const failed: Shown.Event = { type: "drawn", ticket, ok: false, isolated: true, readOnly: true }
  return effect {
    const machine = try Shown.Machine
    const viewer = try machine.get()
    if (viewer.item !== item || viewer.revision !== revision || !Shown.canDrawn(viewer, ticket, "Phone")) return failed
    const holder = try Opened
    const content = try holder.content()
    if (page === 1 && content.viewer === viewer.viewer && content.firstPage?.revision === revision) {
      const { uri, isolated, readOnly } = content.firstPage
      if (isolated && readOnly) try holder.hold({ viewer: viewer.viewer, page: uri })
      return { type: "drawn", ticket, ok: true, isolated, readOnly }
    }
    const selection = try selectionOf(try grantOf(item))
    if (Option.isNone(selection)) return failed
    const client = try documents()
    const timed = try Effect.timeoutOption(tryPromise(() => client.pdf(selection.value, page)), "20 seconds")
    if (Option.isNone(timed)) return { type: "pageTimedOut", ticket }
    const drawn = timed.value
    const current = try machine.get()
    if (current.viewer !== viewer.viewer || current.revision !== revision || !Shown.canDrawn(current, ticket, "Phone")) return failed
    if (drawn.status === "unavailable") {
      try ignore(machine.send({ type: "lost" }, "Phone"))
      return failed
    }
    if (drawn.status !== "rendered" || !drawn.imageUri) return failed
    const isolated = !("isolated" in drawn) || drawn.isolated !== false
    const readOnly = !("readOnly" in drawn) || drawn.readOnly !== false
    if (isolated && readOnly) try holder.hold({ ...(try holder.content()), viewer: viewer.viewer, page: previewUrl(drawn.imageUri) })
    return { type: "drawn", ticket, ok: true, isolated, readOnly }
  } catch () => failed
}

/** The exact preview, and the grant the open Files viewer still owns. */
export interface FileSelection {
  readonly viewer: number
  readonly item: number
  readonly revision: number
  readonly grant: number
}

type FilePreview = Shown.Machine | Recent.Machine | Opened

/** Capture the currently readable text file for a spoken question about this document. */
export effect function selectedTextContext(): (FileSelection | undefined)!!FilePreview {
  const shown = try (try Shown.Machine).get()
  if (shown.kind !== "Text" || !Shown.canAskAlpha(shown, "Owner")) return undefined
  const grant = try grantOf(shown.item)
  const opened = try Opened
  const file = try opened.grant(grant)
  const current = try opened.content()
  if (Option.isNone(file) || file.value.mimeType !== "text/plain" || current.viewer !== shown.viewer || !current.text?.trim()) return undefined
  return { viewer: shown.viewer, item: shown.item, revision: shown.revision, grant }
}

function sameDocument(before: SelectedDocument, after: SelectedDocument): boolean {
  return after.status === "selected" && before.selectionId === after.selectionId && before.name === after.name
    && before.mimeType === after.mimeType && before.size === after.size && before.modified === after.modified
}

const documentLimit = fileBase64Cap / 4 * 3
const previewLimit = imageBase64Cap / 4 * 3
const localText = { workerUrl: "/ocr/worker.min.js", assetsUrl: "/ocr/", language: "eng" }

effect function excerpt(content: Content, page: number, id: string, name: string): (Attached | undefined)!! {
  const text = content.text?.slice(0, 12000).trim()
  if (text) {
    if (sensitiveReadingText(text)) return undefined
    const suffix = " (excerpt).txt"
    return { id, name: name.slice(0, nameLimit - suffix.length) + suffix, mimeType: "text/plain", data: base64(new TextEncoder().encode(text)) }
  }
  if (content.page === undefined) return undefined
  const address = content.page
  const image = tryPromise(() => pageImage(address, previewLimit)) catch () => undefined
  if (image === undefined) return undefined
  const loadedClient = tryPromise(() => loadFilesClient()) catch () => undefined
  if (loadedClient === undefined) return undefined
  const words = timeout(loadedClient.recognizeLocalText(localText, image, () => {}, true), 20000) catch () => undefined
  if (words === undefined || sensitiveReadingText(words.text)) return undefined
  const bytes = tryPromise(() => image.arrayBuffer()) catch () => undefined
  if (bytes === undefined) return undefined
  const suffix = ` (page ${page} preview).${image.type === "image/png" ? "png" : "jpg"}`
  return { id, name: name.slice(0, nameLimit - suffix.length) + suffix, mimeType: image.type, data: base64(new Uint8Array(bytes)) }
}

// spec/app/files/preview.md, "Ask Alpha, Transcribe and Open elsewhere hand the file on and change nothing here"; spec/app/files/preview.md, "A file that holds a verification code or another secret is never handed to Ask Alpha"
effect function readAttachment(prior: FileSelection, allowExcerpt: boolean): (Attached | undefined)!!(FilePreview | Documents) {
  const machine = try Shown.Machine
  const shown = try machine.get()
  if (shown.kind === "Media" || shown.kind === "Archive" || !Shown.canAskAlpha(shown, "Owner")
    || !(try samePreview(prior.viewer, prior.item, prior.revision, prior.grant))) return undefined
  const opened = try Opened
  const file = try opened.grant(prior.grant)
  const selection = try selectionOf(prior.grant)
  const content = try opened.content()
  if (Option.isNone(file) || Option.isNone(selection) || content.viewer !== prior.viewer) return undefined
  const current = effect {
    const state = try machine.get()
    return (try samePreview(prior.viewer, prior.item, prior.revision, prior.grant))
      && Shown.canAskAlpha(state, "Owner") && (try opened.content()) === content
      && state.drawing.ticket === shown.drawing.ticket
  }
  const client = documents() catch () => undefined
  if (client === undefined) return undefined
  const source = selection.value
  const before = tryPromise(() => client.describe(source)) catch () => undefined
  const expected = file.value
  if (before?.status !== "selected" || before.selectionId !== source || before.name !== expected.name
    || before.mimeType?.toLowerCase() !== expected.mimeType.toLowerCase()
    || (before.modified !== undefined && Math.trunc(before.modified) !== prior.revision) || !(try current)) return undefined
  const mimeType = expected.mimeType.toLowerCase()
  const limit = mimeType.startsWith("image/") ? imageIntakeBytes : documentLimit
  let result: Attached | undefined
  if (before.size !== undefined && before.size > limit) {
    if (!allowExcerpt || (shown.kind !== "Text" && (shown.kind !== "Pdf" || shown.drawing.status !== "Loaded"))) return undefined
    result = try excerpt(content, shown.page, source, expected.name)
  } else {
    const bytes = try (try Documents).attachment(source)
    if (Option.isNone(bytes)) return undefined
    const data = bytes.value.dataBase64.replace(/\s+/g, "")
    const size = data.length / 4 * 3 - (data.endsWith("==") ? 2 : data.endsWith("=") ? 1 : 0)
    if (bytes.value.name !== expected.name || bytes.value.mimeType.toLowerCase() !== mimeType || data.length % 4 !== 0 || size < 1
      || size > limit || (before.size !== undefined && before.size !== size)) return undefined
    if (shown.kind === "Text") {
      const text = textFromBase64(data)
      if (text === undefined || text !== content.text || sensitiveReadingText(text)) return undefined
    }
    result = { id: source, name: expected.name, mimeType, data }
  }
  if (result === undefined || !(try current)) return undefined
  const after = tryPromise(() => client.describe(source)) catch () => undefined
  return after !== undefined && sameDocument(before, after) && (try current) ? result : undefined
}

/** Read only the non-sensitive text of the exact preview a spoken turn captured. */
export effect function readCurrentFileText(prior: FileSelection): (Attached | undefined)!!(FilePreview | Documents) {
  const now = try selectedTextContext()
  if (now?.viewer !== prior.viewer || now.item !== prior.item || now.revision !== prior.revision || now.grant !== prior.grant) return undefined
  return try readAttachment(prior, false)
}

effect function askAbout(viewer: number, item: number, revision: number): void!!(Documents | FilePreview | MediaHandoff | Toasts | Said) {
  const prior = { viewer, item, revision, grant: try grantOf(item) }
  const machine = try Shown.Machine
  const opened = try Opened
  const drawing = (try machine.get()).drawing.ticket
  const content = try opened.content()
  const context = try Effect.context<FilePreview>()
  const current = Effect.provideContext(effect {
    const state = try machine.get()
    return Shown.canAskAlpha(state, "Owner") && state.drawing.ticket === drawing && (try opened.content()) === content
      && (try samePreview(viewer, item, revision, prior.grant))
  }, context)
  const data = try readAttachment(prior, true)
  if (!(try current)) return
  if (data !== undefined && (try attachToAlpha(data, current))) return
  if (try current) try say("Alpha could not attach this file", true)
}

// spec/app/files/preview.md, "Use in email offers the exact file to the selected Inbox account for review before it joins a new draft"
export function emailAccount(mail: Inbox.Mailbox, composer: Drafts.Composer): Inbox.Linked | undefined {
  const linked = Inbox.linkOf(mail.connected, mail.selected.account)
  return mail.signedIn && Drafts.free(composer) && linked.account > 0 && linked.credential > 0 && linked.grant.send ? linked : undefined
}

type MailTarget = Incoming | Adding | Drafts.Machine | Inbox.Machine | Shell

effect function emailTarget(): (Inbox.Linked | undefined)!!(Inbox.Machine | Drafts.Machine) {
  return emailAccount(try (try Inbox.Machine).get(), try (try Drafts.Machine).get())
}

// spec/app/files/preview.md, "The answer to an email handoff says whether Inbox received the attachment for review"
effect function offerEmail(ticket: number, viewer: number, item: number, revision: number, account: number): Shown.Event!!(Documents | Opened | Recent.Machine | Shown.Machine | MailTarget | Toasts | Said) {
  const refused: Shown.Event = { type: "answered", ticket, confirmed: false, known: true }
  const machine = try Shown.Machine
  const current = effect {
    const state = try machine.get()
    return state.viewer === viewer && state.item === item && state.revision === revision && Shown.loaded(state) && Shown.canAnswered(state, ticket, "Phone")
  }
  const target = try emailTarget()
  if (target?.account !== account || !(try current)) return refused
  const grantId = try grantOf(item)
  const file = try (try Opened).grant(grantId)
  const selection = try selectionOf(grantId)
  if (Option.isNone(file) || Option.isNone(selection)) return refused
  const docs = documents() catch () => undefined
  if (docs === undefined) return refused
  const verified = tryPromise(() => docs.describe(selection.value)) catch () => undefined
  if (verified?.status !== "selected" || (verified.modified !== undefined && Math.trunc(verified.modified) !== revision) || !(try current)) return refused
  const bytes = try (try Documents).attachment(selection.value)
  if (!(try current) || (try grantOf(item)) !== grantId) return refused
  const fresh = try emailTarget()
  if (fresh?.account !== account || fresh?.credential !== target.credential || Option.isNone(bytes)) {
    try say("Alpha could not offer this file to Inbox", true)
    return refused
  }
  const { name, mimeType, dataBase64 } = bytes.value
  const data = dataBase64.replace(/\s+/g, "")
  const size = data.length / 4 * 3 - (data.endsWith("==") ? 2 : data.endsWith("=") ? 1 : 0)
  if (name !== file.value.name || mimeType.toLowerCase() !== file.value.mimeType.toLowerCase() || data.length % 4 !== 0 || size <= 0
    || (verified.size !== undefined && verified.size !== size)) {
    try say("The selected file changed", true)
    return refused
  }
  const confirmed = try handOver({ name, mimeType, data, size }, "Files")
  if (!confirmed) try say("Alpha could not offer this file to Inbox", true)
  return { type: "answered", ticket, confirmed, known: true }
}

/** Tell Recent what happened to the document it holds, where the rules still take it. */
effect function toRecent(event: Recent.Event): void!!Recent.Machine {
  try ignore((try Recent.Machine).send(event, "Phone"))
}

effect function samePreview(viewer: number, item: number, revision: number, grant: number): boolean!!(Shown.Machine | Recent.Machine) {
  const state = try (try Shown.Machine).get()
  return Shown.usable(state) && state.viewer === viewer && state.item === item && state.revision === revision && (try grantOf(item)) === grant
}

/** A PNG or JPEG the phone can carry as one MMS picture. */
export function pictureFits(file: Grant | undefined): boolean {
  const size = file?.bytes
  return (file?.mimeType === "image/png" || file?.mimeType === "image/jpeg") && size !== undefined && Number.isSafeInteger(size) && size > 0 && size <= MMS_MAX_TOTAL_BYTES
}

type MessageTarget = TextMessages | MessageComposer | MessageDrafts | Shell | Telephony

// spec/app/files/preview.md, "Use in Messages offers the exact readable PNG or JPEG to the owner’s recipient picker"
effect function offerPicture(viewer: number, item: number, revision: number): void!!(Documents | Opened | Recent.Machine | Shown.Machine | Files | MessageTarget | Toasts | Said) {
  const offered = effect {
    const grant = try grantOf(item)
    const file = try (try Opened).grant(grant)
    const selection = try selectionOf(grant)
    if (Option.isNone(file) || Option.isNone(selection) || !pictureFits(file.value) || !(try samePreview(viewer, item, revision, grant))) return false
    const contentType = file.value.mimeType
    const size = file.value.bytes
    if ((contentType !== "image/png" && contentType !== "image/jpeg") || size === undefined || !(try pictureMessagingReady())) return false
    const docs = try documents()
    const before = try tryPromise(() => docs.describe(selection.value))
    const place = file.value.storage
    const matches = (one: typeof before) => one.status === "selected" && one.selectionId === selection.value && one.name === file.value.name &&
      one.mimeType === contentType && (one.size === undefined || one.size === size) &&
      (place !== undefined && one.modified === undefined || Math.max(0, Math.trunc(one.modified ?? 0)) === revision)
    if (!matches(before) || !(try samePreview(viewer, item, revision, grant))) return false
    const attachment = try (try Documents).attachment(selection.value)
    if (Option.isNone(attachment) || attachment.value.name !== file.value.name || attachment.value.mimeType !== contentType) return false
    const bytes = pictureBytes(attachment.value.dataBase64, contentType, size, MMS_MAX_TOTAL_BYTES)
    if (bytes === undefined) return false
    const after = try tryPromise(() => docs.describe(selection.value))
    if (!matches(after) || before.uri !== after.uri) return false
    if (place !== undefined) {
      const listed = try called("storageList", (plugin) => plugin.storageList({ volume: place.volume, path: parentPath(place.path) }))
      if (listed.status !== "ready" || !listed.entries?.some((one) =>
        one.path === place.path && !one.directory && one.name === file.value.name && one.size === size && Math.trunc(one.modified) === revision)) return false
    }
    if (!(try samePreview(viewer, item, revision, grant))) return false
    const wireName = contentType === "image/png" ? "picture-1.png" : "picture-1.jpg"
    return try handOverPicture({ name: file.value.name, wireName, contentType, bytes }, "Files")
  } catch () => false
  if (!offered) try say("Messages could not open this picture", true)
}

// spec/app/files/preview.md, "The owner can share the readable file shown through Android using its own selected-document grant"
effect function shareViewed(viewer: number, item: number, revision: number): void!!(Documents | Opened | Recent.Machine | Shown.Machine | Toasts | Said) {
  try ignore(effect {
    const grant = try grantOf(item)
    const selection = try selectionOf(grant)
    if (Option.isNone(selection) || !(try samePreview(viewer, item, revision, grant))) return
    const docs = try documents()
    const held = try tryPromise(() => docs.describe(selection.value))
    if (held.status !== "selected" || !(try samePreview(viewer, item, revision, grant))) return
    const opened = try tryPromise(() => docs.share(selection.value))
    if (opened.status !== "opened") try say("Android could not share this file", true)
  })
}

// spec/app/files/preview.md, "A picked document is renamed through its provider using the access held for the viewer"
effect function renamePicked(viewer: number, item: number, revision: number, name: string): Shown.Event!!(Documents | Opened | Recent.Machine | Shown.Machine | Toasts | Said) {
  const finished: Shown.Event = { type: "pickedRenameFinished", viewer }
  const holder = try Opened
  const recent = try Recent.Machine
  const machine = try Shown.Machine
  const grant = (try recent.get()).shown
  const applied = effect {
    const selection = try selectionOf(grant.grant)
    const file = try holder.grant(grant.grant)
    if (grant.origin !== "Picked" || grant.key !== item || Option.isNone(selection) || Option.isNone(file) || file.value.canRename !== true) return false
    if (!(try samePreview(viewer, item, revision, grant.grant)) || (try machine.get()).renaming !== viewer) return false
    const docs = try documents()
    const described = try tryPromise(() => docs.describe(selection.value))
    if (described.status !== "selected" || described.canRename !== true || described.name !== file.value.name ||
      (described.modified !== undefined && Math.max(0, Math.trunc(described.modified)) !== revision) ||
      !(try samePreview(viewer, item, revision, grant.grant))) return false
    const changed = try tryPromise(() => docs.rename(selection.value, name))
    const held = try recent.get()
    if (held.shown.grant !== grant.grant && !held.rows.some((row) => row.grant === grant.grant)) return true
    if (changed.status === "renamed-reselect" || changed.status === "unavailable") {
      if (changed.status === "renamed-reselect") try holder.rememberName(item, name)
      else try holder.rememberName(item, file.value.name)
      if (try samePreview(viewer, item, revision, grant.grant)) try ignore(machine.send({ type: "lost" }, "Phone"))
      else try toRecent({ type: "lapsed", key: item })
      return changed.status === "renamed-reselect"
    }
    if (changed.status !== "selected" || changed.selectionId !== selection.value || !changed.name) return false
    const renamed = pickedFacts(file.value, changed)
    try holder.give(grant.grant, renamed)
    if (try samePreview(viewer, item, revision, grant.grant)) {
      try ignore(machine.send({ type: "show", file: item, revision: renamed.revision, kind: kindOf(renamed.mimeType), siblings: [] }, "Phone"))
    }
    return true
  } catch () => false
  if (!applied) try say("The provider could not confirm the rename. Select the file again before retrying.", true)
  return finished
}

type PreviewWorkspace = Browser.Machine | Documents | Files | Handles | Opened | Recent.Machine | Shown.Machine

// spec/app/files/preview.md, "Rename, Move to and Move to Trash act on the storage-backed preview still showing"
effect function actOnViewed(viewer: number, item: number, revision: number, operation: Shown.StorageAction, name: string): void!!(PreviewWorkspace | Toasts | Said) {
  const applied = effect {
    const recent = try Recent.Machine
    const row = (try recent.get()).shown
    const grant = row.grant
    if (row.origin !== "InFolder" || row.key !== item || !(try samePreview(viewer, item, revision, grant))) return false
    const shown = try Shown.Machine
    const files = try Browser.Machine
    const handle = try Handles
    const place = try handle.spot(item)
    const document = try (try Opened).grant(grant)
    const selection = try selectionOf(grant)
    if (Option.isNone(place) || Option.isNone(document) || Option.isNone(selection)) return false
    const { volume, path } = place.value
    if (path === "" || (document.value.storage !== undefined && (document.value.storage.path !== path || document.value.storage.volume !== volume))) return false
    const parent = parentPath(path)
    const docs = try documents()
    const described = try tryPromise(() => docs.describe(selection.value))
    if (described.status !== "selected" || described.name !== document.value.name) return false
    const reply = try called("storageList", (plugin) => plugin.storageList({ volume, path: parent }))
    const listed = reply.status === "ready" ? reply.entries?.find((one) => one.path === path && !one.directory) : undefined
    if (listed === undefined || listed.name !== described.name || Math.trunc(listed.modified) !== revision || !Browser.allowed(try files.get()) || !(try samePreview(viewer, item, revision, grant))) return false
    if (described.size !== undefined && described.size !== listed.size) return false
    const root = try handle.of({ volume, path: "" })
    const exact: Item = { id: item, volume: root, name: listed.name, revision, bytes: Math.max(0, Math.trunc(listed.size)), children: 0, kind: storageKind(listed) }
    if (operation === "RenameFile") {
      const ticket = (try files.get()).change.attempt.id + 1
      const siblings = (reply.entries ?? []).map((one) => one.name)
      try files.send({ type: "renameShown", file: exact, name, siblings }, "Owner")
      const settled = Stream.filter(files.changes, (next) => next.change.attempt.id >= ticket && next.change.attempt.outcome !== "Sent")
      const answered = try Effect.timeoutOption(Stream.runHead(settled), "20 seconds")
      if (Option.isNone(answered) || Option.isNone(answered.value) || answered.value.value.change.attempt.id !== ticket || answered.value.value.change.attempt.outcome !== "Confirmed") return false
      const changedPath = parent === "" ? name : `${parent}/${name}`
      const updated = try called("storageList", (plugin) => plugin.storageList({ volume, path: parent }))
      const renamed = updated.status === "ready" ? updated.entries?.find((one) => one.path === changedPath && !one.directory) : undefined
      const stillShowing = try samePreview(viewer, item, revision, grant)
      if (stillShowing && renamed !== undefined) {
        const key = try handle.of({ volume, path: changedPath })
        const renamedItem = { ...exact, id: key, name: renamed.name, revision: Math.max(0, Math.trunc(renamed.modified)), bytes: Math.max(0, Math.trunc(renamed.size)) }
        try view(renamedItem, (updated.entries ?? []).map((one) => one.name))
      }
      if (stillShowing && (try shown.get()).viewer === viewer) try ignore(shown.send({ type: "gone", file: item }, "Phone"))
      try toRecent({ type: "gone", key: item })
      return true
    }
    const segments = parent === "" ? [] : parent.split("/")
    const parentTrail = [...(try handle.many(Array.from({ length: segments.length + 1 }, (_, depth) => ({ volume, path: segments.slice(0, depth).join("/") }))))]
    const here = try files.get()
    if (here.inCategory || here.trail.length !== parentTrail.length || !here.trail.every((id, at) => id === parentTrail[at])
      || here.listing.status !== "Loaded" || !here.items.some((one) => one.id === exact.id && one.revision === exact.revision && one.bytes === exact.bytes)) {
      try files.send({ type: "openPreviewParent", parentTrail }, "Phone")
      const ticket = here.listing.ticket + 1
      const read = Stream.filter(files.changes, (next) => next.listing.ticket >= ticket && next.listing.status !== "Loading")
      const answer = try Effect.timeoutOption(Stream.runHead(read), "15 seconds")
      if (Option.isNone(answer) || Option.isNone(answer.value)) return false
    }
    const now = try files.get()
    if (now.inCategory || now.trail.length !== parentTrail.length || !now.trail.every((id, at) => id === parentTrail[at]) || !(try samePreview(viewer, item, revision, grant))) return false
    try files.send({ type: "stagePreviewFile", file: exact, ticket: now.listing.ticket, trashing: operation === "TrashFile" }, "Phone")
    return true
  } catch () => false
  if (!applied) try say("Files could not confirm the action for this file", true)
}

function carryShown(fx: Shown.Effect): Job<Shown.Event, PreviewWorkspace | MediaHandoff | MailTarget | MessageTarget | Toasts | Said, [by: Shown.Actor]> {
  return match (fx) {
    when { tag: "Read", let ticket, let item, let revision }: answer("read", read(ticket, item, revision), { type: "contentRead", ticket, ok: false, pages: 0, why: "Fine", secret: false }, "Phone");
    when { tag: "Draw", let ticket, let item, let revision, let page }: answer("draw", drew(ticket, item, revision, page), { type: "drawn", ticket, ok: false, isolated: true, readOnly: true }, "Phone");
    // spec/app/files/preview.md, "Every viewer is closed exactly once: the step that ends it says so, and no other"
    when { tag: "Closed", let viewer, let item }: run(`closed ${viewer}`, effect {
      const holder = try Opened
      if ((try holder.content()).viewer === viewer) try holder.hold({ viewer: 0 })
      const current = try (try Shown.Machine).get()
      if (!Shown.showing(current) || current.item !== item) try toRecent({ type: "viewerClosed", key: item })
    }, "Phone");
    // spec/app/files/preview.md, "Open elsewhere hands the file over to read only"
    when { tag: "OpenElsewhere", let viewer, let item, let revision }: run("elsewhere", effect {
      const grant = try grantOf(item)
      const selection = try selectionOf(grant)
      if (Option.isNone(selection) || !(try samePreview(viewer, item, revision, grant))) return
      const docs = documents() catch () => undefined
      const result = docs === undefined ? undefined : tryPromise(() => docs.open(selection.value)) catch () => undefined
      if (result?.status !== "opened" && (try samePreview(viewer, item, revision, grant))) try say("Android could not open this file", true)
    }, "Phone");
    when { tag: "ShareFile", let viewer, let item, let revision }: run(`share ${viewer}`, shareViewed(viewer, item, revision), "Phone");
    when { tag: "ActOnStoredFile", let viewer, let item, let revision, let operation, let name }: run(`act on file ${viewer}`, actOnViewed(viewer, item, revision, operation, name), "Phone");
    when { tag: "RenamePicked", let viewer, let item, let revision, let name }: answer("rename picked", renamePicked(viewer, item, revision, name), { type: "pickedRenameFinished", viewer }, "Phone");
    when { tag: "Forget", let item }: run("forget", effect { try ignore((try Recent.Machine).send({ type: "forget", key: item }, "Owner")) }, "Phone");
    when { tag: "Lost", let item }: run("lost", toRecent({ type: "lapsed", key: item }), "Phone");
    when { tag: "SelectAgain", let item }: run("again", effect { try ignore((try Recent.Machine).send({ type: "openPicker", replacing: item }, "Owner")) }, "Phone");
    when { tag: "AskAlpha", let viewer, let item, let revision }: run("ask", askAbout(viewer, item, revision), "Phone");
    when { tag: "Transcribe" }: stop("transcribe");
    when { tag: "OfferPicture", let viewer, let item, let revision }: run(`offer picture ${viewer}`, offerPicture(viewer, item, revision), "Phone");
    when { tag: "OfferEmail", let ticket, let viewer, let item, let revision, let account }: answer("email", offerEmail(ticket, viewer, item, revision, account), { type: "answered", ticket, confirmed: false, known: false }, "Phone");
  }
}

// spec/app/files/recent.md, "Opening a row again asks the phone first: it opens, moves to the front and is the document open, or its access has ended and it must be selected again, or its provider cannot be reached and it stays"
effect function reached(ticket: number, key: number): Recent.Event!!(Documents | Opened | Recent.Machine) {
  const failed: Recent.Event = { type: "reached", ticket, ok: false, ended: false }
  return effect {
    const recent = try Recent.Machine
    const asked = (try recent.get()).asked
    const selection = try selectionOf(asked.key === key ? asked.grant : 0)
    if (Option.isNone(selection)) return { ...failed, ended: true }
    const docs = try documents()
    const described = try tryPromise(() => docs.describe(selection.value))
    const state = try recent.get()
    if (!Recent.canReached(state, ticket, "Phone") || !state.rows.some((row) => row.key === key && row.grant === asked.grant)) return failed
    const ended = described.status === "renamed-reselect" || described.status === "unavailable"
    if (asked.origin === "Picked") {
      const holder = try Opened
      const held = try holder.grant(asked.grant)
      if (Option.isSome(held)) {
        if (ended) try holder.rememberName(key, held.value.name)
        else if (described.status === "selected" && described.selectionId === selection.value) {
          try holder.give(asked.grant, pickedFacts(held.value, described))
        }
      }
    }
    return { ...failed, ended, ok: described.status === "selected" && described.selectionId === selection.value }
  } catch () => failed
}

// spec/app/files/recent.md, "A file opened from a folder is given access, listed first in place of its older row, and is the document open; the oldest row leaves a full list"
effect function reopened(key: number, grant: number): void!!(Files | Opened | Shown.Machine) {
  try ignore(effect {
    const given = try (try Opened).grant(grant)
    if (Option.isNone(given)) return
    let siblings: string[] = []
    if (given.value.storage !== undefined) {
      const { volume, path } = given.value.storage
      const reply = called("storageList", (plugin) => plugin.storageList({ volume, path: parentPath(path) })) catch () => undefined
      if (reply?.status === "ready") siblings = (reply.entries ?? []).map((one) => one.name)
    }
    try (try Shown.Machine).send({ type: "show", file: key, kind: kindOf(given.value.mimeType), revision: given.value.revision, siblings }, "Phone")
  })
}

// spec/app/files/recent.md, "An open picker closes once, and delivers a document only if it is the one whose choice counts"
effect function picked(ticket: number): Recent.Event!!(Documents | Opened | Recent.Machine) {
  const canceled: Recent.Event = { type: "pickerClosed", ticket, chose: false, keep: false }
  return effect {
    const docs = try documents()
    const selected = try (try Documents).pick()
    if (Option.isNone(selected)) return canceled
    const choice = try tryPromise(() => docs.describe(selected.value))
    const s = try (try Recent.Machine).get()
    if (s.live !== ticket || choice.status !== "selected" || !choice.name) {
      try ignore(tryPromise(() => docs.forget(selected.value)))
      return canceled
    }
    const issued = s.issued + 1
    try (try Opened).give(issued, pickedFacts({
      selection: selected.value, key: issued, name: choice.name, mimeType: "application/octet-stream",
    }, choice))
    return { ...canceled, chose: true, keep: true }
  } catch () => canceled
}

function carryRecent(fx: Recent.Effect): Job<Recent.Event, Files | Documents | Opened | Recent.Machine | Shown.Machine, [by: Recent.Actor]> {
  return match (fx) {
    // spec/app/files/recent.md, "Access is held by a row or by the document open, and what a step leaves unheld is given up in that step"
    when { tag: "Release", let grant }: run(`release ${grant}`, ignore(effect {
      const given = try (try Opened).take(grant)
      if (Option.isSome(given)) {
        const docs = try documents()
        try tryPromise(() => docs.forget(given.value.selection as SelectionId))
      }
    }), "Phone");
    when { tag: "Reach", let ticket, let key }: answer("reach", reached(ticket, key), { type: "reached", ticket, ok: false, ended: false }, "Phone");
    when { tag: "Open", let key, let grant }: run(`open ${key}`, reopened(key, grant), "Phone");
    when { tag: "AskPicker", let ticket }: answer(`picker ${ticket}`, picked(ticket), { type: "pickerClosed", ticket, chose: false, keep: false }, "Phone");
  }
}

// spec/app/files/preview.md, "A restart closes the viewer and reports an insert cut off as unknown, so no answer from before it is taken"
// spec/app/platform/index.md, "A state kept in a shape an earlier build wrote is read in today's shape, with what the owner kept in it"
/** A viewer kept while it inserted into mail itself, or before it offered an item or renamed one: read without that mail, offering and renaming nothing. */
function storedPreview(key: string, start = Shown.initial) {
  const { offered, renaming } = Shown.initial
  return Layer.provide(Shown.stored(key, start), filledStore(key, ({ inserted: _inserted, email: _email, account: _account, draft: _draft, ...kept }) => ({ offered, renaming, ...kept }), Shown.parseState))
}
const previewing = reacting({ ...Shown, stored: storedPreview }, { keep: 1, open: [{ type: "restart" }, "Phone"], carry: carryShown })

// spec/app/files/recent.md, "A restart ends the folder session, closes the pickers, the viewer and the opening under way, and keeps the list"
const recenting = reacting(Recent, { keep: 1, open: [{ type: "restart" }, "Phone"], carry: carryRecent })

// spec/app/files/preview.md, "The owner closes the viewer, and so does leaving the screen or the phone locking"
const hiding = following(Browser.Machine, (s) => s.open && Browser.allowed(s), Shown.Machine, (open): Shown.Event | undefined => (open ? undefined : { type: "hidden" }), "Phone")

// spec/app/files/recent.md, "Back, or the phone locking, withdraws the picker, and its late choice is dropped"
const hidePicker = following(Browser.Machine, (s) => s.open, Recent.Machine, (open): Recent.Event | undefined => (open ? undefined : { type: "cancelPicker" }), "Phone")

// spec/app/files/preview.md, "The file can change while it is shown: it is read again, its page drawn again within its new length, and an email handoff still reading the previous file is refused"
const revisions = started(effect {
  const browser = try Browser.Machine
  const machine = try Shown.Machine
  const recent = try Recent.Machine
  try Stream.runForEach(browser.changes, effect (shown) => {
    const viewer = try machine.get()
    if (!Shown.usable(viewer) || (try recent.get()).shown.origin !== "InFolder") return
    const listed = shown.items.find((item) => item.id === viewer.item) ?? shown.search.hits.find((item) => item.id === viewer.item)
    if (listed !== undefined && Shown.canChanged(viewer, listed.revision, "Phone")) {
      try ignore(machine.send({ type: "changed", revision: listed.revision }, "Phone"))
    }
  })
}, "the previewed file's revision")

// spec/app/files/recent.md, "The earlier Alpha's Recent is carried over once, while this one is still empty: each document it held access to becomes a row of its own, the newest first; one it held without access, and the document it had open, are not carried"; spec/app/platform/adoption.md, "A value is moved by copying it only where the new place is still empty, and its earlier place is cleared only once the new place holds a value"
const adopting = started(effect {
  const recent = try Recent.Machine
  const holder = try Opened
  const current = {
    effect read() {
      const s = try recent.get()
      return s.rows.length === 0 && s.issued === 0 ? Option.none<ReadonlyArray<ReturnType<typeof earlierOf>[number]>>() : Option.some([])
    },
    effect write(rows: ReadonlyArray<ReturnType<typeof earlierOf>[number]>) {
      try recent.send({ type: "adopt", kept: rows.map((row) => row.selection) }, "Phone")
      for (const [at, row] of rows.entries()) try holder.give(at + 1, { selection: row.selection, key: at + 1, name: row.name, mimeType: row.mimeType, revision: row.at })
    },
    clear: () => Effect.void,
  }
  const earlier = try keptAt("alpha.files.recent.v1")
  const open = try keptAt("alpha.files.open.v1")
  const raw = earlier.read() catch () => Option.none<string>()
  const wasOpen = open.read() catch () => Option.none<string>()
  const adoption = try adopt(earlier, current, (value: string) => { const rows = earlierOf(value, Recent.limit); return rows.length === 0 ? Option.none() : Option.some(rows) })
  if (Option.isSome(raw) && earlierCleared(adoption)) {
    const kept = new Set(earlierOf(raw.value, Recent.limit).map((row) => row.selection))
    const docs = documents() catch () => undefined
    for (const selection of earlierHeld(raw.value, Option.getOrUndefined(wasOpen))) {
      if (docs !== undefined && !kept.has(selection)) try ignore(tryPromise(() => docs.forget(selection as SelectionId)))
    }
  }
  try ignore(open.clear())
}, "adopting")

/** The viewer and Recent, kept across restarts, over the documents the phone holds for Alpha. */
export const preview = Layer.provideMerge(together(previewing, recenting, hiding, hidePicker, revisions, adopting), opened)

// spec/app/files/preview.md, "A file that Files moved or put in the Trash closes its viewer"; spec/app/files/recent.md, "A file Files moved or the Trash took leaves the list, with the access no viewer holds"
/** Files or the Trash took `items` away: the viewer showing one closes, and Recent forgets each. */
export effect function taken(items: ReadonlyArray<number>): void!!(Shown.Machine | Recent.Machine) {
  for (const key of items) {
    try ignore((try Shown.Machine).send({ type: "gone", file: key }, "Phone"))
    try toRecent({ type: "gone", key })
  }
}
