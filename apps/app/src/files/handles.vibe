// spec/app/files/shared.md, "A file has a number, a name, a revision that changes whenever the file does, a kind, its size, and the storage volume it is on"
import * as KeyValueStore from "effect/persistence/KeyValueStore"

/** A place of the phone's storage: a volume's root where `path` is empty, or a file or folder under it. */
export interface Spot {
  readonly volume: string
  readonly path: string
}

/**
 * The numbers Files gives the volumes, files and folders of the phone's storage, which names each by its volume's id
 * and its path from the volume's root. A spot keeps its number for good, across restarts, so a number Files kept
 * still names the place it named; a moved file is a new spot.
 */
export service Handles {
  of(spot: Spot): number!!
  spot(handle: number): Option.Option<Spot>!!
  /** Give the number of a volume's root the name the phone shows for that volume. */
  name(handle: number, label: string): void!!
  /** What the owner calls a number: its volume's name at a volume's root, else the last step of its path. */
  label(handle: number): Option.Option<string>!!
}

module text {
  /** A place of the phone's storage, as the store keeps it. */
  export interface Kept {
    readonly volume: string
    readonly path: string
  }
  /** @throws {never} */
  export function keyed(spot: Kept): string {
    return JSON.stringify([spot.volume, spot.path])
  }
  /** What the store kept: the spots in the order they were numbered, from 1. @throws {never} */
  export function kept(raw: string | undefined): Kept[] {
    if (raw === undefined) return []
    try {
      const found: unknown = JSON.parse(raw)
      return Array.isArray(found) ? found.filter((one): one is Kept => typeof one?.volume === "string" && typeof one?.path === "string") : []
    } catch {
      return []
    }
  }
}
import { keyed, kept } from text

const key = "alpha/files/handles@1"

/** The numbers, kept in the store as the list of spots in the order they were given. */
export const handles = Layer.effect(Handles, effect {
  const store = try KeyValueStore.KeyValueStore
  const spots = kept(store.get(key) catch () => undefined)
  const numbers = new Map(spots.map((spot, at) => [keyed(spot), at + 1]))
  const names = new Map<number, string>()
  return {
    effect of(spot: Spot): number!! {
      const known = numbers.get(keyed(spot))
      if (known !== undefined) return known
      spots.push({ volume: spot.volume, path: spot.path })
      numbers.set(keyed(spot), spots.length)
      try ignore(store.set(key, JSON.stringify(spots)))
      return spots.length
    },
    spot: (handle: number) => sync(() => Option.fromNullishOr(spots[handle - 1])),
    name: (handle: number, label: string) => sync(() => { names.set(handle, label) }),
    label: (handle: number) => sync(() => {
      const named = names.get(handle)
      if (named !== undefined) return Option.some(named)
      const spot = spots[handle - 1]
      return spot === undefined ? Option.none<string>() : Option.some(spot.path.slice(spot.path.lastIndexOf("/") + 1))
    }),
  }
})
