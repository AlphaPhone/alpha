// spec/app/files/trash.md, "The owner opens a listed Trash item's details and can restore or ask to erase that same item"
export interface TrashItemFacts {
  readonly location: string
  readonly directory: boolean
  readonly mimeType: string
  readonly bytes: number
}

/** Native metadata, keyed by the same permanent mark as the Trash's rules. */
export service TrashFacts {
  rows(): ReadonlyMap<number, TrashItemFacts>!!
  hold(items: ReadonlyMap<number, TrashItemFacts>): void!!
}

export const trashFacts = Layer.sync(TrashFacts, () => {
  let held: ReadonlyMap<number, TrashItemFacts> = new Map()
  return {
    rows: () => sync(() => held),
    hold: (items: ReadonlyMap<number, TrashItemFacts>) => sync(() => { held = items }),
  }
})
