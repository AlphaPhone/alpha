// spec/kit/read.md, "Story: Read from outside"

module web {
  type Call = (options: unknown) => unknown
  interface Handle { remove(): unknown }
  interface Capacitor {
    readonly Plugins?: Record<string, Record<string, unknown> | undefined>
    readonly PluginHeaders?: ReadonlyArray<{ readonly name: string }>
  }
  const capacitor = () => (globalThis as { Capacitor?: Capacitor }).Capacitor
  /** Whether the host registered `plugin`: its header, which Android writes for each plugin of this build. @throws {never} */
  export function registered(plugin: string): boolean {
    return capacitor()?.PluginHeaders?.some((header) => header.name === plugin) ?? capacitor()?.Plugins?.[plugin] !== undefined
  }
  /** @throws {never} */
  export function method(plugin: string, name: string): ((options: unknown) => Promise<unknown>) | undefined {
    const found = capacitor()?.Plugins?.[plugin]
    const call = found?.[name]
    // The objects Android injects answer `addListener` with a handle and every other method with a promise; a proxy of @capacitor/core answers both with promises.
    return typeof call === "function" ? (options: unknown) => Promise.resolve().then(() => (call as Call).call(found, options)) : undefined
  }
  /** @throws {never} */
  export function subscribe(plugin: string, event: string, heard: (data: unknown) => void): Promise<() => Promise<void>> | undefined {
    const found = capacitor()?.Plugins?.[plugin]
    const add = found?.addListener
    if (typeof add !== "function") return undefined
    return Promise.resolve().then(() => (add as (event: string, heard: (data: unknown) => void) => Handle | Promise<Handle>).call(found, event, heard))
      .then((handle) => async () => { await handle.remove() })
  }
  /** The `code` Capacitor gives a rejection. @throws {never} */
  export function codeOf(cause: unknown): string | undefined {
    const code = typeof cause === "object" && cause !== null && "code" in cause ? cause.code : undefined
    return typeof code === "string" ? code : undefined
  }
}
import { codeOf, method, registered, subscribe } from web

/** A plugin's call failed: `code` is what the plugin rejected it with, or "UNIMPLEMENTED" where the plugin or the method is not there, as in a browser. */
export error BridgeFailed { plugin: string; method: string; code: string | undefined; cause: unknown }

/**
 * The one door to Android: every Capacitor plugin is reached through it, by the name its `@CapacitorPlugin` gives, and
 * what comes back is untrusted until the service that asked has decoded it with its schema. Only the phone's platform
 * layers use it; areas use those services.
 */
export service Bridge {
  /** Whether the host registered `plugin` in this build: what a capability of the phone is told by. */
  has(plugin: string): boolean!!
  call(plugin: string, method: string, options: unknown): unknown!BridgeFailed
  /** Hear each `event` of `plugin` from now until the scope closes. A plugin does not keep what it emitted before: listen first, then make the call that causes the events. */
  heard(plugin: string, event: string, hear: (data: unknown) => void): void!BridgeFailed!Scope.Scope
}

const missing = "UNIMPLEMENTED"

/** Capacitor's bridge, on the phone. */
export const capacitorBridge = Layer.succeed(Bridge, {
  has: (plugin: string) => sync(() => registered(plugin)),
  effect call(plugin: string, name: string, options: unknown) {
    const found = method(plugin, name)
    if (found === undefined) throw new BridgeFailed({ plugin, method: name, code: missing, cause: "missing" })
    return try tryPromise({ try: () => found(options), catch: (cause) => new BridgeFailed({ plugin, method: name, code: codeOf(cause), cause }) })
  },
  effect heard(plugin: string, event: string, hear: (data: unknown) => void) {
    const remove = try tryPromise({
      try: () => subscribe(plugin, event, hear) ?? Promise.reject(new Error("missing")),
      catch: (cause) => new BridgeFailed({ plugin, method: event, code: missing, cause }),
    })
    try addFinalizer(() => ignore(tryPromise(() => remove())))
  },
})
