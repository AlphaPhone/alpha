// spec/app/notes/recording.md, "Story: Record a voice note"; spec/app/notes/microphone.md, "Story: Allow the microphone for a voice note"; spec/app/notes/voice.md, "Story: Listen to a voice note"
import type { NotesTrashRecordingCleanup } from "@elizaos/plugin-notes-client"
import type { Command } from "../../gen/app__notes__recording.effect.vibe"
import type { Grant } from "../../gen/kit__permission.ts"
import { fresh } from "../runtime/attempts.vibe"
import { registered } from "./device.vibe"
import { type SavedNoteWindow, readSavedNote } from "./voice.vibe"
import { browserNoteDevice, browserNotesSupported } from "./noteBrowser.vibe"

module native {
  import { type PluginListenerHandle, registerPlugin } from "@capacitor/core"
  import type { NotesTrashRecordingCleanup } from "@elizaos/plugin-notes-client"
  import type { Command } from "../../gen/app__notes__recording.effect.vibe"

  export type Earlier = "records" | "trash" | "folders"

  export interface NotesPlugin {
    permission(): Promise<unknown>
    requestMicrophone(): Promise<unknown>
    status(): Promise<unknown>
    start(input: { readonly ownerDigest: string; readonly folderId?: string }): Promise<unknown>
    command(input: { readonly recordingId: string; readonly command: Command }): Promise<unknown>
    retain(input: { readonly recordingId: string; readonly noteId: string }): Promise<unknown>
    discard(input: { readonly recordingId: string }): Promise<void>
    describe(input: { readonly audioId: string }): Promise<unknown>
    play(input: { readonly audioId: string; readonly noteId: string; readonly offsetMs: number }): Promise<unknown>
    halt(): Promise<unknown>
    purge(input: NotesTrashRecordingCleanup): Promise<unknown>
    consumeOpen(): Promise<unknown>
    previousExists(): Promise<unknown>
    share(input: { readonly channel: "Email" | "Messages"; readonly title: string; readonly text: string }): Promise<unknown>
    settings(): Promise<unknown>
    readPrevious(input: { readonly area: Earlier }): Promise<unknown>
    addListener(event: "recordingChanged" | "openRequested", received: (value: unknown) => void): Promise<PluginListenerHandle>
  }

  let made: NotesPlugin | undefined
  /** Alpha's registered device recorder. @throws {never} */
  export function client(): NotesPlugin {
    return (made ??= registerPlugin<NotesPlugin>("AlphaNotes"))
  }

  /** The credential-free binding the device journal uses for this agent owner. */
  export async function ownerDigest(id: string): Promise<string> {
    const bytes = new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(id)))
    return Array.from(bytes, (one) => one.toString(16).padStart(2, "0")).join("")
  }
}
import { type Earlier, type NotesPlugin, client, ownerDigest } from native
export { ownerDigest }
export const transcriptWindowMs = 25000

const Segment = Schema.Struct({ segmentId: Schema.NonEmptyString, durationMs: Schema.Int, text: Schema.optionalKey(Schema.String) })
const TapeReply = Schema.Struct({
  state: Schema.Literals(["idle", "recording", "paused", "stopped"]),
  recordingId: Schema.optionalKey(Schema.NonEmptyString),
  recovered: Schema.optionalKey(Schema.Boolean),
  binding: Schema.optionalKey(Schema.Struct({ ownerDigest: Schema.NonEmptyString, folderId: Schema.NullOr(Schema.String) })),
  stopReason: Schema.optionalKey(Schema.String),
  canonicalSavePending: Schema.optionalKey(Schema.Boolean),
  durationMs: Schema.optionalKey(Schema.Int),
  segments: Schema.optionalKey(Schema.Array(Segment)),
  peak: Schema.optionalKey(Schema.Number),
})
const Permission = Schema.Struct({ grant: Schema.String })
const RecordedReply = Schema.Struct({ audioId: Schema.NonEmptyString, noteId: Schema.NonEmptyString, durationMs: Schema.Int })
const Heard = Schema.Struct({ text: Schema.String.check(Schema.isMaxLength(8000)), local: Schema.Literal(true) })
const Played = Schema.Struct({ ok: Schema.Boolean })
const Offered = Schema.Struct({ open: Schema.Boolean })
const EarlierPresence = Schema.Struct({ present: Schema.Boolean })
const EarlierText = Schema.Struct({ text: Schema.NullOr(Schema.String) })
export type Tape = typeof TapeReply.Type
export type Recorded = typeof RecordedReply.Type

export error RecordingUnavailable

/** Audio custody and microphone permission belong to the device hosting Notes. */
export service NoteDevice {
  readonly available: boolean
  readonly onWeb: boolean
  readonly canPlay: boolean
  readonly canTranscribe: boolean
  readonly changed: Stream.Stream<Tape>
  readonly openAsked: Stream.Stream<void>
  permission(): Grant!!
  request(): Grant!!
  status(ownerDigest?: string): Tape!RecordingUnavailable
  retire(): void!!
  start(ownerDigest: string, folderId?: string): Tape!RecordingUnavailable
  command(recordingId: string, command: Command): Tape!RecordingUnavailable
  retain(recordingId: string, noteId: string): Recorded!RecordingUnavailable
  discard(recordingId: string): void!RecordingUnavailable
  describe(audioId: string): Recorded!RecordingUnavailable
  transcribe(window: SavedNoteWindow): string!RecordingUnavailable
  play(audioId: string, noteId: string, offsetMs: number): boolean!!
  halt(): boolean!!
  purge(receipt: NotesTrashRecordingCleanup): boolean!!
  consumeOpen(): boolean!!
  previousExists(): boolean!!
  share(channel: "Email" | "Messages", title: string, text: string): void!!
  settings(): void!!
  earlier(area: Earlier): (string | null)!RecordingUnavailable
}

const absent = () => new RecordingUnavailable()
const noTape = (): Tape => ({ state: "idle" })

export const noteDevice = Layer.sync(NoteDevice, () => {
  const api = registered("AlphaNotes") ? client() : undefined
  const canTranscribe = api !== undefined && registered("AlphaVoiceCloud")
  const purges = Semaphore.makeUnsafe(1)
  const browser = api === undefined && browserNotesSupported() ? browserNoteDevice() : undefined
  const available = api !== undefined || browser?.available === true
  const web = <A>(call: () => Promise<A>) => tryPromise({ try: call, catch: absent })
  const asked = <A>(call: (native: NotesPlugin) => Promise<A>) => api === undefined ? Effect.fail(absent()) : tryPromise({ try: () => call(api), catch: absent })
  const decoded = <A>(schema: Schema.Decoder<A>, raw: unknown) => mapError(Schema.decodeUnknownEffect(schema)(raw), absent)
  const read = <A>(schema: Schema.Decoder<A>, call: (native: NotesPlugin) => Promise<unknown>) => flatMap(asked(call), (raw) => decoded(schema, raw))
  const granted = (raw: Effect.Effect<{ readonly grant: string }, RecordingUnavailable>) => Effect.map(
    Effect.orElseSucceed(raw, () => ({ grant: "prompt" })),
    ({ grant }): Grant => grant === "granted" ? "Granted" : grant === "denied" ? "Denied" : "Unasked",
  )
  const nativeChanged = api === undefined ? Stream.empty : Stream.callback<Tape>((queue) => acquireRelease(
    promise(() => api.addListener("recordingChanged", (raw) => {
      const report = Schema.decodeUnknownOption(TapeReply)(raw)
      if (Option.isSome(report)) Queue.offerUnsafe(queue, report.value)
    })),
    (listener) => promise(() => listener.remove()),
  ))
  const changed = browser === undefined ? nativeChanged : Stream.callback<Tape>((queue) => acquireRelease(
    sync(() => browser.observe((report) => { Queue.offerUnsafe(queue, report) })),
    (remove) => sync(remove),
  ))
  const openAsked = api === undefined ? Stream.empty : Stream.callback<void>((queue) => acquireRelease(
    promise(() => api.addListener("openRequested", () => { Queue.offerUnsafe(queue, undefined) })),
    (listener) => promise(() => listener.remove()),
  ))
  return {
    available, onWeb: browser !== undefined, canPlay: api !== undefined || browser !== undefined, canTranscribe, changed, openAsked,
    permission: () => granted(browser === undefined ? read(Permission, (native) => native.permission()) : web(() => browser.permission())),
    request: () => granted(browser === undefined ? read(Permission, (native) => native.requestMicrophone()) : web(() => browser.request())),
    status: (ownerDigest?: string) => browser !== undefined ? web(() => browser.status(ownerDigest))
      : api !== undefined ? read(TapeReply, (native) => native.status()) : succeed(noTape()),
    retire: () => sync(() => browser?.retire()),
    start: (ownerDigest: string, folderId?: string) => browser === undefined
      ? read(TapeReply, (native) => native.start({ ownerDigest, ...(folderId === undefined ? {} : { folderId }) }))
      : web(() => browser.start(ownerDigest, folderId)),
    command: (recordingId: string, command: Command) => browser === undefined
      ? read(TapeReply, (native) => native.command({ recordingId, command }))
      : web(() => browser.command(recordingId, command)),
    retain: (recordingId: string, noteId: string) => browser === undefined
      ? read(RecordedReply, (native) => native.retain({ recordingId, noteId }))
      : web(() => browser.retain(recordingId, noteId)),
    discard: (recordingId: string) => browser === undefined
      ? asked((native) => native.discard({ recordingId }))
      : web(() => browser.discard(recordingId)),
    describe: (audioId: string) => browser === undefined
      ? read(RecordedReply, (native) => native.describe({ audioId }))
      : tryPromise({ try: () => browser.describe(audioId), catch: absent }),
    effect transcribe(window: SavedNoteWindow) {
      if (!canTranscribe) throw new RecordingUnavailable()
      const requestId = `notes-${fresh()}`
      const raw = try tryPromise({ try: (signal) => readSavedNote(window, requestId, signal), catch: absent })
      return (try decoded(Heard, raw)).text
    },
    play: (audioId: string, noteId: string, offsetMs: number) => browser === undefined
      ? Effect.catch(Effect.map(read(Played, (native) => native.play({ audioId, noteId, offsetMs })), ({ ok }) => ok), () => succeed(false))
      : Effect.orElseSucceed(tryPromise(() => browser.play(audioId, noteId, offsetMs)), () => false),
    halt: () => browser === undefined
      ? Effect.catch(Effect.map(read(Played, (native) => native.halt()), ({ ok }) => ok), () => succeed(false))
      : sync(() => browser.halt()),
    purge: (receipt: NotesTrashRecordingCleanup) => Semaphore.withPermit(purges, effect {
      const result = asked((native) => native.purge(receipt)) catch () => undefined
      return typeof result === "object" && result !== null && "status" in result && result.status === "purged"
        && "audioId" in result && result.audioId === receipt.audioId
        && "noteId" in result && result.noteId === receipt.noteId
        && "operationId" in result && result.operationId === receipt.operationId
    }),
    consumeOpen: () => Effect.catch(Effect.map(read(Offered, (native) => native.consumeOpen()), ({ open }) => open), () => succeed(false)),
    share: (channel: "Email" | "Messages", title: string, text: string) => ignore(asked((native) => native.share({ channel, title, text }))),
    settings: () => ignore(asked((native) => native.settings())),
    previousExists: () => Effect.catch(Effect.map(read(EarlierPresence, (native) => native.previousExists()), ({ present }) => present), () => succeed(false)),
    earlier: (area: Earlier) => api !== undefined ? Effect.map(read(EarlierText, (native) => native.readPrevious({ area })), (read) => read.text) : succeed(null),
  }
})
