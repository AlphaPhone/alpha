// spec/kit/attempt.md, "Story: Do something outside, once"
import { Bridge } from "./bridge.vibe"

/** The secure store refused, or there is none, as in a browser. `code` is the store's own word for why, such as `invalid_input`. */
export error VaultFailed { slot: string; code: string | undefined; cause: unknown }

/**
 * Secrets, in the phone's secure store: never in the KeyValueStore, never in a machine's state, and redacted so that
 * no log shows them. The agent's launch token and the cloud's device key never come here: they stay in native code.
 */
export service Vault {
  read(slot: string): Option.Option<Redacted.Redacted<string>>!VaultFailed
  write(slot: string, secret: Redacted.Redacted<string>): void!VaultFailed
  remove(slot: string): void!VaultFailed
}

/** What `ElizaSecureStore` answers: it resolves every call, and says in `ok` and `error` how it went. */
schema Kept { readonly ok: boolean; readonly value?: string; readonly error?: string }

const plugin = "ElizaSecureStore"

/** The phone's secure store, through the `ElizaSecureStore` plugin of eliza's Android package: Android Keystore, with the slots its host allows. */
export const capacitorVault = Layer.effect(Vault, effect {
  const bridge = try Bridge
  effect function kept(slot: string, method: string, options: object): Kept!VaultFailed {
    const said = bridge.call(plugin, method, { ...options, key: slot }) catch effect (cause) => { throw new VaultFailed({ slot, code: cause.code, cause }) }
    return Schema.decodeUnknownEffect(Kept)(said) catch effect (cause) => { throw new VaultFailed({ slot, code: undefined, cause }) }
  }
  effect function done(slot: string, method: string, options: object): void!VaultFailed {
    const answer = try kept(slot, method, options)
    if (!answer.ok) throw new VaultFailed({ slot, code: answer.error, cause: answer.error })
  }
  return {
    effect read(slot: string) {
      const answer = try kept(slot, "get", {})
      if (answer.ok && answer.value !== undefined) return Option.some(Redacted.make(answer.value))
      if (answer.error === "not_found") return Option.none()
      throw new VaultFailed({ slot, code: answer.error, cause: answer.error })
    },
    write: (slot: string, secret: Redacted.Redacted<string>) => done(slot, "set", { value: Redacted.value(secret) }),
    remove: (slot: string) => done(slot, "remove", {}),
  }
})

const none = (slot: string) => Effect.fail(new VaultFailed({ slot, code: undefined, cause: "no secure store in a browser" }))

/** A browser keeps no secrets: every slot is refused, and the area shows that it cannot. */
export const browserVault = Layer.succeed(Vault, { read: none, write: none, remove: none })
