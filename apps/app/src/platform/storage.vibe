// spec/platform/index.md, "Story: Keep my phone's state across restarts"
// Durable machine state is kept with each generated module's `stored(key)` layer over Effect's KeyValueStore.
// Keys are namespaced per owner so a reset or a different owner never reads another's state.
import * as KeyValueStore from "effect/persistence/KeyValueStore"

/** The namespace every stored machine key of this owner starts with. */
export function ownerKey(owner: string, key: string): string {
  return `alpha/${owner}/${key}`
}

/** Owner-private storage: the WebView's storage, which Android keeps in the app's private data. */
export const browserStore = KeyValueStore.layerStorage(() => globalThis.localStorage)

/** Storage that forgets, for tests and stories. */
export const memoryStore = KeyValueStore.layerMemory
