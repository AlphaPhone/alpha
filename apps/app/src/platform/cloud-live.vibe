// spec/platform/index.md, "Story: Use Eliza Cloud's managed services when signed in"; spec/platform/index.md, "A 401 ends the session; every other refusal is Cloud unavailable with its status"; spec/platform/index.md, "Only a route the Cloud client lists is requested"; spec/platform/index.md, "The phone's key stays with native, and a leaving screen cancels only its own call"; spec/platform/index.md, "A request that needs the session is sent only while the owner is signed in"; spec/platform/index.md, "A refusal carries a wait only when the resident answered 429 with a whole number of seconds"; spec/platform/index.md, "A refusal carries the allowance reset Cloud named, only while it lies ahead"
import { createCloudClient, lookupPath, type HttpMethod } from "@elizaos/cloud"
import { cloudClient as nativeCloudClient, cloudPlugin } from "@elizaos/os-bridges"
import type { CloudClient as NativeCloud, CloudPath, EnvironmentName } from "@elizaos/os-bridges"
import { adviceOf, cloudOutcomeOf, resetCarried, routeAdmitted } from "../../gen/platform.effect.vibe"
import { Build } from "./build.vibe"
import { Cloud, CloudSignedOut, CloudUnavailable } from "./cloud.vibe"
import { CloudServices } from "./cloud-services.vibe"
import { buildCloudEnvironment, cloudAuthorityOf, environmentName } from "./build-live.vibe"
import { nativeCloudFetch, resetAtOf, retryAfterSecondsOf, textOf } from "./cloud-fetch.ts"
import { parsedJson } from "./native-capacitor.ts"
import { ResidentRefusal } from "./native.schema.vibe"
import type { CloudAuthority } from "./build-flags.ts"

const verbs = { GET: "Get", POST: "Post", PATCH: "Patch", DELETE: "Delete" } as const satisfies Record<string, HttpMethod>

const signedOutFailures = new Set(["sign-in-required", "reauth-required"])

/** What a native Cloud refusal means: signed out where native needs a session it does not have, unavailable otherwise. */
export function nativeFailureOf(cause: unknown): CloudUnavailable | CloudSignedOut {
  const failure = typeof cause === "object" && cause !== null && "failure" in cause && typeof cause.failure === "string" ? cause.failure : "network"
  return signedOutFailures.has(failure)
    ? new CloudSignedOut()
    : new CloudUnavailable({ status: 0, code: failure, message: "Cloud could not be reached." })
}

/** The Cloud and CloudServices services over the native Cloud plugin `native`, for the Cloud at `authority` in the native environment `environment`. */
export function cloudOver(native: NativeCloud, authority: CloudAuthority, environment: "production" | "staging" = "production") {
  const named = environment as EnvironmentName
  const cloud: Cloud.Shape = {
    base: authority.api,
    effect json(method: "GET" | "POST" | "PUT" | "PATCH" | "DELETE", path: string, body?: unknown) {
      const url = Effect.try(() => new URL(path, authority.api)) catch () => undefined
      const listed = method !== "PUT" && url !== undefined && url.origin === authority.api && lookupPath(verbs[method], url.pathname).tag === "Listed"
      if (url === undefined || !routeAdmitted(listed, !path.startsWith("//"))) {
        throw new CloudUnavailable({ status: 0, code: "NoRoute", message: "Only managed Cloud services are available." })
      }
      const reply = try tryPromise({
        try: (signal) => native.request({
          method: method === "PUT" ? "PATCH" : method,
          path: url.pathname as CloudPath,
          ...(url.search === "" ? {} : { query: Object.fromEntries(url.searchParams) }),
          ...(body === undefined ? {} : { body }),
          environment: named,
          signal,
        }),
        catch: nativeFailureOf,
      })
      const data = reply.body.length === 0 ? null : parsedJson(textOf(reply.body)) ?? null
      const outcome = cloudOutcomeOf(reply.status)
      if (outcome === "CloudSignedOutNow") throw new CloudSignedOut()
      if (outcome === "CloudDown") {
        const said = Schema.decodeUnknownEffect(ResidentRefusal)(data) catch () => undefined
        const now = try Clock.currentTimeMillis
        const wait = retryAfterSecondsOf(reply.retryAfter, now)
        const advice = adviceOf(reply.status, wait !== undefined, wait ?? 0)
        const reset = resetAtOf(data)
        throw new CloudUnavailable({
          status: reply.status,
          message: said?.message ?? said?.error ?? `Cloud request failed (HTTP ${reply.status}).`,
          ...(said?.error === undefined ? {} : { code: said.error }),
          ...(advice.tag === "WaitSeconds" ? { retryAfter: advice.seconds } : {}),
          ...(resetCarried(reset !== undefined, reset ?? 0, now) ? { resetAt: reset } : {}),
        })
      }
      return data
    },
  }
  const services: CloudServices.Shape = {
    client: createCloudClient({ baseUrl: authority.api, credential: () => undefined, fetch: nativeCloudFetch(native, authority.api, named) }),
    authority,
    openExternal: (url: string) => tryPromise({ try: () => native.openExternal({ url, environment: named }), catch: () => new CloudUnavailable({ status: 0, code: "link-refused", message: "Can’t open page" }) }),
  }
  return Layer.merge(Layer.succeed(Cloud, cloud), Layer.succeed(CloudServices, services))
}

/** The Cloud this build talks to, through the agent service's `ElizaCloud` plugin, every request naming the build's environment. */
export const cloudLive = Layer.unwrap(effect {
  const build = try Build
  const environment = buildCloudEnvironment(build.info)
  return cloudOver(nativeCloudClient(cloudPlugin()), cloudAuthorityOf(environment), environmentName(environment))
})
