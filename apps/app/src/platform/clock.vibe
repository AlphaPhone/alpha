// spec/app/workflows/clock.md, "Story: Review, then hand over to Clock"; spec/app/workflows/clock.md, "Story: Know what happened"
import type { ClockRequest, ClockStatus } from "@elizaos/os/bridges/definitions/system"
import { registered } from "./device.vibe"

module held {
  import type { SystemClient } from "@elizaos/os/bridges/system"

  let system: Promise<SystemClient> | undefined
  /** eliza's client of `ElizaSystem`, loaded at first use, once the phone's host is up. */
  export function systemOf(): Promise<SystemClient> {
    return (system ??= import("@elizaos/os/bridges/system").then((bridge) => bridge.System))
  }
}
import { systemOf } from held

export type { ClockRequest, ClockStatus }

/**
 * Android's Clock, which owns the alarms, through eliza's client of `ElizaSystem`: whether this phone has a Clock to
 * hand a request to, and the one handoff of a reviewed request, answered only with whether Clock opened.
 */
export service PhoneClock {
  readonly present: boolean
  /** Hand `request` to Clock once; `unknown` where no answer can be trusted. */
  open(request: ClockRequest): ClockStatus!!
}

const plugin = "ElizaSystem"

/** On the phone: eliza's `System.openClock`, where the host registered its system plugin. */
export const phoneClock = Layer.sync(PhoneClock, () => ({
  present: registered(plugin),
  open: (request: ClockRequest) => Effect.orElseSucceed(tryPromise(async () => (await (await systemOf()).openClock(request)).status), (): ClockStatus => "unknown"),
}))

/** In a browser: no Clock to hand anything to. */
export const browserClock = Layer.succeed(PhoneClock, {
  present: false,
  open: () => succeed<ClockStatus>("unavailable"),
})
