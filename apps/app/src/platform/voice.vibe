// spec/app/voice/index.md, "Story: Hold a spoken conversation"; spec/app/voice/index.md, "The speech pipeline warms on startup, foreground return and account readiness without opening the microphone"; spec/app/voice/index.md, "Starting asks for the microphone the first time, opens it once it is allowed, and holds the speech engine while talking"
import { parseVoiceTranscriptEnvelope } from "@elizaos/agent"
import { type CloudStreamingSpeech, createCloudStreamingSpeech, type CredentialId, type EnvironmentName } from "@elizaos/os-bridges"
import { fresh } from "../runtime/attempts.vibe"
import { Agent } from "./agent.vibe"
import { registered } from "./device.vibe"
import { ask } from "./remote.vibe"

export type VoiceGrant = "granted" | "denied" | "prompt"

export type VoiceEvent =
  | { readonly kind: "speechStart"; readonly session: number }
  | { readonly kind: "speechEnd"; readonly session: number; readonly text: string }
  | { readonly kind: "bargeIn"; readonly session: number; readonly echo: boolean }
  | { readonly kind: "ended"; readonly session: number; readonly reason: string }
  | { readonly kind: "recordingStopped"; readonly ticket: number; readonly recorded: boolean }

export type ReadingEvent = { readonly kind: "ready" | "ended"; readonly ok: boolean }

export interface SpeechStatus {
  readonly ready: boolean
  readonly ttsReady: boolean
  readonly liveCapture: boolean
}

export interface RecordedClip {
  readonly recordingId: string
}

/** Who the phone's sign-in says holds its Cloud key: an account, by the id of its key, no one, or unknown where it could not be read. */
export type CloudSignIn =
  | { readonly kind: "signedIn"; readonly credential: string }
  | { readonly kind: "signedOut" }
  | { readonly kind: "unknown" }

interface LiveCapture {
  readonly session: number
  readonly captureId: string
  readonly preview: VoicePreview | undefined
  stopPreview: (() => void) | undefined
  phase: "Opening" | "Listening" | "Cancelling" | "Retired"
  requested: boolean
  openingStop: Promise<{ captureId: string; serverClosed: boolean }> | undefined
  echoCancelled: boolean
}

interface DictationClip extends RecordedClip {
  readonly started: number
  state: "recording" | "recorded" | "failed"
  durationMs?: number
}

const recordedClip = Schema.Struct({
  recordingId: Schema.NonEmptyString, status: Schema.Literal("recorded"),
  durationMs: Schema.Int.check(Schema.makeFilter((duration) => duration >= 0)),
})
const recordingStop = Schema.Union([
  recordedClip,
  Schema.Struct({ recordingId: Schema.NonEmptyString, status: Schema.Literal("failed") }),
])
type RecordingStop = typeof recordingStop.Type

module capacitor {
  import { registerPlugin } from "@capacitor/core"
  import type { ElizaCloudSpeechPlugin } from "@elizaos/os-bridges"
  import { type SignInClient, signInClient } from "@elizaos/os-bridges"

  export interface ListenerHandle { remove(): Promise<void> }

  /** One time window of a retained Notes recording. */
  export type SavedNoteWindow = { readonly recordingId: string; readonly noteId: string; readonly offsetMs: number; readonly durationMs: number }

  export interface LocalVoicePlugin {
    checkPermissions(): Promise<{ microphone?: string }>
    requestPermissions(): Promise<{ microphone?: string }>
    warmSpeechOutput(options: Record<string, never>): Promise<unknown>
    localSpeechStatus(options: { requestId: string; ttsOnly?: boolean }): Promise<{ ready?: boolean; ttsReady?: boolean }>
    holdSpeechEngine(options: Record<string, never>): Promise<{ held?: boolean }>
    releaseSpeechEngineHold(options: Record<string, never>): Promise<unknown>
    liveCaptureStatus(options: Record<string, never>): Promise<{ available?: boolean; nativeTransport?: boolean }>
    startLiveCapture(options: { captureId: string; nativeAsr: boolean; echoCancel: boolean; bargeIn: boolean; reopen: boolean }): Promise<{ captureId: string; nativeAsr: boolean; echoCancelled: boolean }>
    stopLiveCapture(options: { captureId: string; discard: boolean }): Promise<{ captureId: string; serverClosed: boolean }>
    synthesizeLocal(options: { requestId: string; text: string; append?: boolean; replace?: boolean }): Promise<{ playbackId?: string }>
    play(options: { playbackId: string; replace?: boolean }): Promise<unknown>
    setSpeechOutputMuted(options: { muted: boolean }): Promise<void>
    stopPlayback(options: { requestId?: string }): Promise<unknown>
    cancel(options: { requestId: string }): Promise<unknown>
    startRecording(options: Record<string, never>): Promise<{ recordingId?: string }>
    stopRecording(options: Record<string, never>): Promise<unknown>
    dictationForeground(options: Record<string, never>): Promise<{ available?: boolean }>
    cancelRecording(options: Record<string, never>): Promise<unknown>
    transcribeLocalRecording(options: { requestId: string; recordingId: string; automatic: boolean }): Promise<{ text?: string }>
    transcribeSavedNote(options: SavedNoteWindow & { readonly requestId: string }): Promise<unknown>
    transcribeVoicemail(options: { requestId: string; id: string }): Promise<unknown>
    cancelVoicemailTranscription(options: { requestId: string }): Promise<void>
    addListener(event: string, listener: (data: unknown) => void): Promise<ListenerHandle>
  }

  let made: LocalVoicePlugin | undefined
  /** @throws {never} */
  export function localPlugin(): LocalVoicePlugin {
    return (made ??= registerPlugin<LocalVoicePlugin>("AlphaVoiceCloud"))
  }

  /** Cancel and retire the same native request if its caller stops waiting. */
  export async function readSavedNote(input: SavedNoteWindow, requestId: string, signal: AbortSignal): Promise<unknown> {
    signal.throwIfAborted()
    const plugin = localPlugin()
    const cancel = () => { void plugin.cancel({ requestId }).catch(() => undefined) }
    signal.addEventListener("abort", cancel, { once: true })
    try {
      const result = await plugin.transcribeSavedNote({ ...input, requestId })
      signal.throwIfAborted()
      return result
    } finally {
      signal.removeEventListener("abort", cancel)
    }
  }

  export async function readVoicemail(id: string, requestId: string, signal: AbortSignal): Promise<string> {
    if (signal.aborted) return ""
    const plugin = localPlugin()
    const cancel = () => { void plugin.cancelVoicemailTranscription({ requestId }).catch(() => {}) }
    signal.addEventListener("abort", cancel, { once: true })
    try {
      const reply = await plugin.transcribeVoicemail({ id, requestId })
      return !signal.aborted && typeof reply === "object" && reply !== null && "text" in reply
        && typeof reply.text === "string" && reply.text.length <= 8_000 ? reply.text : ""
    } finally {
      signal.removeEventListener("abort", cancel)
    }
  }

  /** eliza's Cloud speech relay with the methods its TypeScript definition does not list yet: the warm-up and the timing records. */
  export interface CloudRelay extends ElizaCloudSpeechPlugin {
    prewarmCloudSpeech(options: { environment: string }): Promise<unknown>
    cloudStreamTiming(options: Record<string, never>): Promise<unknown>
  }

  let relay: CloudRelay | undefined
  /** @throws {never} */
  export function relayPlugin(): CloudRelay {
    return (relay ??= registerPlugin<CloudRelay>("ElizaCloudSpeech"))
  }

  let signIn: SignInClient | undefined
  /** eliza's client of the phone's sign-in, made once. @throws {never} */
  export function signInAccounts(): SignInClient {
    return (signIn ??= signInClient())
  }

  /** @throws {never} */
  export function makeAbort(): AbortController {
    return new AbortController()
  }

  /** @throws {never} */
  export function makeSessionGuard(current: () => number, expected: number): () => void {
    return () => {
      if (current() !== expected) throw new Error("session-changed")
    }
  }
}
import { type SavedNoteWindow, localPlugin, makeAbort, makeSessionGuard, readSavedNote, readVoicemail, relayPlugin, signInAccounts } from capacitor
export { type SavedNoteWindow, readSavedNote, signInAccounts }

export error VoiceBridgeFailed { method: string; cause: unknown }
/** Recognition ran on the confirmed clip, stayed in custody, or could not start. */
export type DictationAnswer =
  | { readonly kind: "recognized"; readonly text: string; readonly durationMs: number | undefined }
  | { readonly kind: "obscured" | "failed"; readonly durationMs: number | undefined }
  | { readonly kind: "lost" }

/** A preview outlet owned by one admitted microphone capture. */
export interface VoicePreview {
  readonly retired: AbortSignal
  show(text: string): void
  clear(): void
  retire(): void
}

export service VoiceBridge {
  available(): boolean!!
  checkPermission(): VoiceGrant!!
  requestPermission(): VoiceGrant!!
  prewarm(network: boolean): void!!Agent
  streamTimings(): unknown!!
  probeStatus(ttsOnly: boolean): SpeechStatus!!
  invalidateCache(): void!!
  /** Forget the Cloud key read for the account before, and the relay session made under it while none runs. */
  forgetAccount(): void!!
  holdEngine(): boolean!!
  releaseEngineHold(): void!!
  openMic(session: number, network: boolean, preview?: VoicePreview): boolean!VoiceBridgeFailed!Agent
  closeMic(session: number): void!VoiceBridgeFailed
  awaitSpeechOutputWarmup(session: number): void!!
  playSentence(session: number, turn: number, text: string, append: boolean): void!VoiceBridgeFailed
  setSpeakerMuted(session: number, muted: boolean): boolean!!
  hush(turn: number): void!!
  canRead(): boolean!!
  readAloud(ticket: number, text: string, stillCurrent?: () => boolean!!): Stream.Stream<ReadingEvent>
  silenceReading(ticket: number): boolean!!
  shut(session: number): boolean!!
  readonly events: Stream.Stream<VoiceEvent>
  account(): CloudSignIn!!
  /** Each sign-in on the phone that settles on an account. */
  readonly signIns: Stream.Stream<void>
  startRecording(ticket: number): RecordedClip!VoiceBridgeFailed
  dictationForeground(): boolean!!
  transcribe(ticket: number, network: boolean, automatic: boolean): DictationAnswer!!
  /** Cancel the recording, optionally after rechecking which recorder still owns it, and report native confirmation. */
  abandon(ticket: number, isCurrent?: () => boolean!!): boolean!!
}

const LOCAL_PLUGIN = "AlphaVoiceCloud"

/** The installed phone has Alpha's on-device speech bridge. */
export function recognizesVoicemail(): boolean {
  return registered(LOCAL_PLUGIN)
}

/** The selected provider row is decoded and recognized on the phone, without sending it audio. */
export effect function transcribeVoicemail(id: string): string!VoiceBridgeFailed {
  const requestId = `voicemail-${fresh()}`
  return try tryPromise({
    try: (signal) => readVoicemail(id, requestId, signal),
    catch: (cause) => new VoiceBridgeFailed({ method: "transcribeVoicemail", cause }),
  })
}
const CLOUD_STREAM_PLUGIN = "ElizaCloudSpeech"
const SIGN_IN_PLUGIN = "ElizaSignIn"
/** The cloud the phone signs in to, whose account the relay speaks for. */
export const CLOUD_ENVIRONMENT = "production" as EnvironmentName
/** How long a background call to the relay, a warm-up or its timing records, may run before it is dropped. */
const RELAY_WARMUP_BOUND = "5 seconds"
const LOCAL_OUTPUT_WARMUP_BOUND = "10 seconds"

function parseGrant(raw: string | undefined): VoiceGrant {
  return raw === "granted" ? "granted" : raw === "denied" ? "denied" : "prompt"
}

function asRecord(value: unknown): Record<string, unknown> | undefined {
  return typeof value === "object" && value !== null ? (value as Record<string, unknown>) : undefined
}

/** Whether the native speech request says a call owns the audio path. */
export function interruptedByCall(cause: unknown): boolean {
  const data = asRecord(cause)
  return data?.code === "call-active" || data?.reason === "call-active"
}

function asString(value: unknown): string {
  return typeof value === "string" ? value : ""
}

function captureEvent(raw: unknown, capture: LiveCapture | undefined): { data: Record<string, unknown>; live: LiveCapture } | undefined {
  const data = asRecord(raw)
  if (capture === undefined || capture.phase !== "Listening" || data === undefined || data.captureId !== capture.captureId) return undefined
  return { data, live: capture }
}

function retireNativePreview(capture: LiveCapture): void {
  const stop = capture.stopPreview
  capture.stopPreview = undefined
  stop?.()
  capture.preview?.retire()
}

effect function hearNativePreview(capture: LiveCapture, current: () => boolean, lifetime: Scope.Scope): void!!Agent {
  const preview = capture.preview
  if (preview === undefined) return
  const heard = (try Agent).feed("voice")
  let turn: { readonly id: string; sequence: number; open: boolean } | undefined
  const listen = Stream.runForEach(heard, (event) => sync(() => {
    if (!current()) return
    const words = parseVoiceTranscriptEnvelope({ type: "event", event }, capture.captureId)
    if (words === undefined) return
    if (words.kind === "speechStart") {
      if (turn?.id !== words.turnId) {
        preview.clear()
        turn = { id: words.turnId, sequence: 0, open: true }
      }
      return
    }
    if (turn === undefined) turn = { id: words.turnId, sequence: 0, open: words.kind === "partial" }
    if (turn.id !== words.turnId || !turn.open) return
    if (words.kind !== "partial") {
      turn.open = false
      preview.clear()
      return
    }
    if (capture.phase !== "Listening" || words.seq <= turn.sequence) return
    turn.sequence = words.seq
    preview.show(words.text)
  }))
  const retired = Effect.callback<void>((resume) => {
    const stop = () => resume(Effect.void)
    if (preview.retired.aborted) { stop(); return }
    preview.retired.addEventListener("abort", stop, { once: true })
    return sync(() => preview.retired.removeEventListener("abort", stop))
  })
  const owned = Effect.raceFirst(Effect.ignore(listen), retired)
  uninterruptible {
    const fiber = try Effect.forkIn(Effect.ensuring(owned, sync(() => preview.retire())), lifetime, { uninterruptible: false })
    capture.stopPreview = () => { fiber.interruptUnsafe() }
  }
}

function makeNativeEvents(
  subscribers: Set<(event: VoiceEvent) => void>,
  currentCapture: () => LiveCapture | undefined,
  stoppedRecording: (stopped: RecordingStop) => void,
): Stream.Stream<VoiceEvent> {
  return Stream.callback<VoiceEvent>((queue) => effect {
    const forward = (event: VoiceEvent) => { Queue.offerUnsafe(queue, event) }
    subscribers.add(forward)
    const handles: Array<{ remove(): Promise<void> }> = []
    if (registered(LOCAL_PLUGIN)) {
      const plugin = localPlugin()
      const register = (name: string, map: (data: Record<string, unknown>, live: LiveCapture) => ReadonlyArray<VoiceEvent>) =>
        Effect.orElseSucceed(
          tryPromise(() => plugin.addListener(name, (raw) => {
            const event = captureEvent(raw, currentCapture())
            if (event !== undefined) for (const item of map(event.data, event.live)) forward(item)
          })),
          () => undefined,
        )
      const attached = try Effect.all([
        Effect.orElseSucceed(tryPromise(() => plugin.addListener("recordingStopped", (raw) => {
          const stopped = Schema.decodeUnknownOption(recordingStop)(raw)
          if (Option.isSome(stopped)) stoppedRecording(stopped.value)
        })), () => undefined),
        register("liveCaptureTranscript", (data, live) => {
          const { session } = live
          const failure = asString(data.error)
          if (failure !== "") {
            retireNativePreview(live)
            return [{ kind: "ended", session, reason: failure }]
          }
          const text = asString(asRecord(data.final)?.text).trim()
          if (text === "") {
            live.preview?.clear()
            return []
          }
          retireNativePreview(live)
          return [{ kind: "speechStart", session }, { kind: "speechEnd", session, text }]
        }),
        register("liveCaptureBargeIn", (_data, { session, echoCancelled }) => {
          return [{ kind: "bargeIn", session, echo: !echoCancelled }]
        }),
        register("liveCaptureEnded", (data, live) => {
          retireNativePreview(live)
          return [{ kind: "ended", session: live.session, reason: asString(data.error) || "ended" }]
        }),
      ], { concurrency: "unbounded" })
      for (const one of attached) if (one !== undefined) handles.push(one)
    }
    try addFinalizer(() => effect {
      subscribers.delete(forward)
      for (const one of handles) try ignore(tryPromise(() => one.remove()))
    })
  })
}

/** The id of the key the phone's sign-in holds for the cloud now: the relay speaks only for that key, and refuses any other. */
effect function signedInKey(accounts: ReturnType<typeof signInAccounts>): CredentialId!VoiceBridgeFailed {
  const status = try tryPromise({
    try: () => accounts.status({ environment: CLOUD_ENVIRONMENT }),
    catch: (cause) => new VoiceBridgeFailed({ method: "status", cause }),
  })
  if (status.account.kind !== "signedIn") throw new VoiceBridgeFailed({ method: "status", cause: "signed-out" })
  return status.account.credentialId
}

/** Who the phone's sign-in says holds its Cloud key now, or unknown where there is no sign-in to ask or it did not answer in time. */
function signedInAccount(): CloudSignIn!! {
  return registered(SIGN_IN_PLUGIN)
    ? Effect.orElseSucceed(
      Effect.map(timeout(tryPromise(() => signInAccounts().status({ environment: CLOUD_ENVIRONMENT })), RELAY_WARMUP_BOUND), (status): CloudSignIn =>
        status.account.kind === "signedIn" ? { kind: "signedIn", credential: status.account.credentialId } : { kind: "signedOut" }),
      (): CloudSignIn => ({ kind: "unknown" }))
    : succeed<CloudSignIn>({ kind: "unknown" })
}

/** Each sign-in the phone settles on an account, as eliza's sign-in client hears it. */
function settledSignIns(): Stream.Stream<void> {
  return Stream.callback<void>((queue) => effect {
    if (!registered(SIGN_IN_PLUGIN)) return
    const handle = try Effect.orElseSucceed(tryPromise(() => signInAccounts().addListener("signInSettled", (receipt) => {
      if (receipt.verdict.kind === "SignedInAs") Queue.offerUnsafe(queue, undefined)
    })), () => undefined)
    try addFinalizer(() => handle === undefined ? Effect.void : ignore(tryPromise(() => handle.remove())))
  })
}

export const phoneVoiceBridge = Layer.effect(VoiceBridge, effect {
  const lifetime = try Effect.scope
  let cachedStatus: SpeechStatus | undefined
  let statusFlight: Deferred.Deferred<SpeechStatus> | undefined
  let activeSession = 0
  let nativeCapture: LiveCapture | undefined
  let cloudStream: CloudStreamingSpeech | undefined
  let cloudKey: CredentialId | undefined
  let accountEpoch = 0
  let cloudCapture: { close(): Promise<void>; cancel(): Promise<void> } | undefined
  let cloudPreview: { readonly session: number; readonly outlet: VoicePreview | undefined } | undefined
  let cloudSpeechAbort: AbortController | undefined
  let activePlaybackRequest: string | undefined
  const speakerLock = try Semaphore.make(1)
  let localSpeakerOwner: number | undefined
  const recordingLock = try Semaphore.make(1)
  let recording: DictationClip | undefined
  let openingRecording: Map<string, RecordingStop> | undefined
  let retiredRecording = 0
  const readings = new Map<number, { readonly id: string; readonly stopped: Deferred.Deferred<boolean> }>()
  let stoppedThrough = 0
  const eventSubscribers = new Set<(event: VoiceEvent) => void>()

  const publish = (event: VoiceEvent) => {
    for (const emit of eventSubscribers) emit(event)
  }

  function stoppedRecording(stopped: RecordingStop): void {
    const clip = recording
    if (clip?.recordingId !== stopped.recordingId) {
      if (openingRecording !== undefined && !openingRecording.has(stopped.recordingId)) openingRecording.set(stopped.recordingId, stopped)
      return
    }
    if (clip.started <= retiredRecording || clip.state !== "recording") return
    clip.state = stopped.status
    if (stopped.status === "recorded") clip.durationMs = stopped.durationMs
    publish({ kind: "recordingStopped", ticket: clip.started, recorded: stopped.status === "recorded" })
  }

  effect function probeStatus(ttsOnly: boolean): SpeechStatus!! {
    if (cachedStatus !== undefined && (!ttsOnly ? cachedStatus.ready : cachedStatus.ttsReady || cachedStatus.ready)) {
      return cachedStatus
    }
    if (statusFlight !== undefined) return try Deferred.await(statusFlight)
    const absent: SpeechStatus = { ready: false, ttsReady: false, liveCapture: false }
    if (!registered(LOCAL_PLUGIN)) {
      cachedStatus = absent
      return absent
    }
    const flight = try Deferred.make<SpeechStatus>()
    statusFlight = flight
    return try ensuring(effect {
      const plugin = localPlugin()
      const [localResult, liveResult] = try Effect.all([
        Effect.orElseSucceed(tryPromise(() => plugin.localSpeechStatus({ requestId: fresh(), ttsOnly })), () => ({ ready: false, ttsReady: false })),
        Effect.orElseSucceed(tryPromise(() => plugin.liveCaptureStatus({})), () => ({ available: false, nativeTransport: false })),
      ], { concurrency: "unbounded" })
      const status: SpeechStatus = {
        ready: localResult.ready === true,
        ttsReady: localResult.ttsReady === true || localResult.ready === true,
        liveCapture: liveResult.available === true && liveResult.nativeTransport === true,
      }
      cachedStatus = status
      try Deferred.succeed(flight, status)
      return status
    }, effect {
      statusFlight = undefined
      try Deferred.succeed(flight, absent)
    })
  }

  effect function prewarm(network: boolean): void!!Agent {
    const warmDevice = registered(LOCAL_PLUGIN)
      ? Effect.all([
        ignore(tryPromise(() => localPlugin().warmSpeechOutput({}))),
        Effect.asVoid(probeStatus(true)),
      ], { concurrency: "unbounded" })
      : Effect.void
    const warmCloud = network
      ? ignore(ask(Agent, HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post("/api/cloud/warm"), {}), Schema.Unknown))
      : Effect.void
    if (network && registered(CLOUD_STREAM_PLUGIN)) {
      const relay = relayPlugin()
      const accounts = signInAccounts()
      const epoch = accountEpoch
      fork.detached ignore(timeout(Effect.all([
        effect { const read = signedInKey(accounts) catch () => undefined; if (epoch === accountEpoch) cloudKey = read },
        ignore(tryPromise(() => relay.prewarmCloudSpeech({ environment: CLOUD_ENVIRONMENT }))),
      ], { concurrency: "unbounded" }), RELAY_WARMUP_BOUND))
    }
    try Effect.all([warmDevice, warmCloud], { concurrency: "unbounded" })
  }

  // spec/app/voice/index.md, "Speaker mute is offered after the current speech bridge confirms gain control"
  effect function restoreLocalOutput(retiring: (owner: number) => boolean): boolean!! {
    return try speakerLock.withPermit(Effect.uninterruptible(effect {
      if (localSpeakerOwner === undefined || !retiring(localSpeakerOwner)) return true
      const restored = effect {
        try tryPromise(() => localPlugin().setSpeechOutputMuted({ muted: false }))
        return true
      } catch () => false
      if (restored) localSpeakerOwner = undefined
      return restored
    }))
  }

  function clearCloudPreview(session: number): void {
    if (cloudPreview?.session !== session) return
    const closing = cloudPreview
    cloudPreview = undefined
    closing.outlet?.retire()
  }

  effect function openMic(session: number, network: boolean, preview?: VoicePreview): boolean!VoiceBridgeFailed!Agent {
    const reopen = activeSession === session
    activeSession = session
    if (network && registered(CLOUD_STREAM_PLUGIN)) {
      const currentSession = session
      const stream = cloudStream ?? createCloudStreamingSpeech({
        environment: CLOUD_ENVIRONMENT,
        credentialId: cloudKey ?? (try signedInKey(signInAccounts())),
        assertCurrent: makeSessionGuard(() => activeSession, currentSession),
        // The SDK invokes this only for the active speech generation of its current capture.
        onInterim: (text) => {
          const current = cloudPreview
          if (activeSession !== currentSession || current?.session !== currentSession) return
          current.outlet?.show(text)
        },
      }, relayPlugin())
      if (activeSession !== currentSession) throw new VoiceBridgeFailed({ method: "startCloudSpeech", cause: "session-changed" })
      cloudStream = stream
      clearCloudPreview(currentSession)
      const previewOwner = { session: currentSession, outlet: preview }
      cloudPreview = previewOwner
      const abort = makeAbort()
      const capture = tryPromise({
        try: () => stream.listen({
          signal: abort.signal,
          onSpeechStart: () => publish({ kind: "speechStart", session: currentSession }),
          onSpeechEnd: () => undefined,
          onSegment: (text) => {
            if (cloudPreview === previewOwner) preview?.clear()
            if (text !== null && text !== "") publish({ kind: "speechEnd", session: currentSession, text })
          },
          onEnd: (cause) => {
            if (cloudPreview === previewOwner) clearCloudPreview(currentSession)
            publish({ kind: "ended", session: currentSession, reason: cause === undefined ? "ended" : interruptedByCall(cause) ? "call-active" : "error" })
          },
        }),
        catch: (cause) => new VoiceBridgeFailed({ method: "startCloudSpeech", cause }),
      }) catch effect (failure) => {
        if (cloudPreview === previewOwner) clearCloudPreview(currentSession)
        cloudStream = undefined
        cloudKey = undefined
        throw failure
      }
      cloudCapture = capture
      return capture.fullDuplex
    }
    if (!registered(LOCAL_PLUGIN)) throw new VoiceBridgeFailed({ method: "startLiveCapture", cause: "no-voice-plugin" })
    const live = tryPromise(() => localPlugin().liveCaptureStatus({})) catch () => undefined
    if (live?.available !== true || live.nativeTransport !== true) {
      throw new VoiceBridgeFailed({ method: "startLiveCapture", cause: "resident-speech-transport-unavailable" })
    }
    if (!(try restoreLocalOutput((owner) => owner !== session))) {
      throw new VoiceBridgeFailed({ method: "startLiveCapture", cause: "speaker-reset-unconfirmed" })
    }
    if (activeSession !== session) throw new VoiceBridgeFailed({ method: "startLiveCapture", cause: "session-changed" })
    if (nativeCapture !== undefined) retireNativePreview(nativeCapture)
    const capture: LiveCapture = {
      session, captureId: fresh(), preview, stopPreview: undefined, phase: "Opening",
      requested: false, openingStop: undefined, echoCancelled: false,
    }
    nativeCapture = capture
    const start = effect {
      try hearNativePreview(capture, () => nativeCapture === capture && activeSession === session
        && (capture.phase === "Opening" || capture.phase === "Listening") && capture.stopPreview !== undefined, lifetime)
      if (nativeCapture !== capture || capture.phase !== "Opening" || activeSession !== session) {
        throw new VoiceBridgeFailed({ method: "startLiveCapture", cause: "session-changed" })
      }
      return try tryPromise({
        try: () => {
          const requested = localPlugin().startLiveCapture({
            captureId: capture.captureId, nativeAsr: true, echoCancel: true, bargeIn: true, reopen,
          })
          capture.requested = true
          return requested
        },
        catch: (cause) => new VoiceBridgeFailed({ method: "startLiveCapture", cause }),
      })
    }
    const started = onInterrupt(start, () => Effect.ignore(stopCapture(capture, true))) catch effect (failure) => {
      retireNativePreview(capture)
      if (nativeCapture === capture && capture.phase === "Opening") nativeCapture = undefined
      throw failure
    }
    if (capture.phase !== "Opening") throw new VoiceBridgeFailed({ method: "startLiveCapture", cause: "session-changed" })
    if (started.captureId !== capture.captureId || started.nativeAsr !== true || nativeCapture !== capture || activeSession !== session) {
      retireNativePreview(capture)
      try ignore(tryPromise(() => localPlugin().stopLiveCapture({ captureId: capture.captureId, discard: true })))
      if (nativeCapture === capture) nativeCapture = undefined
      throw new VoiceBridgeFailed({ method: "startLiveCapture", cause: "resident-speech-capture-refused" })
    }
    capture.echoCancelled = started.echoCancelled === true
    capture.phase = "Listening"
    return capture.echoCancelled
  }

  effect function stopCapture(capture: LiveCapture, discard: boolean): void!VoiceBridgeFailed {
    const opening = capture.phase === "Opening" || capture.phase === "Cancelling"
    capture.phase = opening ? "Cancelling" : "Retired"
    retireNativePreview(capture)
    if (capture.requested) {
      let observed = capture.openingStop
      const request = tryPromise({
        try: () => {
          if (!opening) return localPlugin().stopLiveCapture({ captureId: capture.captureId, discard })
          const attempt = capture.openingStop ??= localPlugin().stopLiveCapture({ captureId: capture.captureId, discard: true })
          observed = attempt
          return attempt
        },
        catch: (cause) => new VoiceBridgeFailed({ method: "stopLiveCapture", cause }),
      })
      const stopped = request catch effect (failure) => {
        if (opening && capture.openingStop === observed) capture.openingStop = undefined
        throw failure
      }
      if (stopped.captureId !== capture.captureId || stopped.serverClosed !== true) {
        if (opening && capture.openingStop === observed) capture.openingStop = undefined
        throw new VoiceBridgeFailed({ method: "stopLiveCapture", cause: "not-closed" })
      }
    }
    if (nativeCapture === capture) nativeCapture = undefined
  }

  effect function stopNativeCapture(session: number, discard: boolean): void!VoiceBridgeFailed {
    const capture = nativeCapture
    if (capture?.session === session) try stopCapture(capture, discard)
  }

  effect function closeMic(session: number): void!VoiceBridgeFailed {
    clearCloudPreview(session)
    if (cloudCapture !== undefined) {
      const cap = cloudCapture
      cloudCapture = undefined
      try tryPromise({ try: () => cap.close(), catch: (cause) => new VoiceBridgeFailed({ method: "closeCloudSpeech", cause }) })
      return
    }
    try stopNativeCapture(session, false)
  }

  effect function awaitSpeechOutputWarmup(session: number): void!! {
    const warming = statusFlight
    if (warming !== undefined && activeSession === session && cloudStream === undefined) {
      try ignore(timeout(Deferred.await(warming), LOCAL_OUTPUT_WARMUP_BOUND))
    }
  }

  effect function playSentence(session: number, _turn: number, text: string, append: boolean): void!VoiceBridgeFailed {
    if (activeSession !== session) return
    if (cloudStream !== undefined) {
      const stream = cloudStream
      const abort = makeAbort()
      cloudSpeechAbort = abort
      try tryPromise({
        try: () => stream.speak(text, abort.signal, () => undefined),
        catch: (cause) => new VoiceBridgeFailed({ method: "speakCloudSpeech", cause }),
      })
      return
    }
    if (!registered(LOCAL_PLUGIN)) throw new VoiceBridgeFailed({ method: "synthesizeLocal", cause: "no-voice-plugin" })
    const requestId = fresh()
    activePlaybackRequest = requestId
    const prepared = try tryPromise({
      try: () => localPlugin().synthesizeLocal({ requestId, text, append, replace: !append }),
      catch: (cause) => new VoiceBridgeFailed({ method: "synthesizeLocal", cause }),
    })
    if (activeSession === session && activePlaybackRequest === requestId && prepared.playbackId !== undefined && prepared.playbackId !== "") {
      const playbackId = prepared.playbackId
      try tryPromise({
        try: () => localPlugin().play({ playbackId, replace: !append }),
        catch: (cause) => new VoiceBridgeFailed({ method: "play", cause }),
      })
    }
  }

  effect function setSpeakerMuted(session: number, muted: boolean): boolean!! {
    if (session !== activeSession) return false
    const cloud = cloudStream
    if (cloud !== undefined) {
      const set = effect {
        try tryPromise(() => cloud.setOutputMuted(muted))
        return activeSession === session && cloudStream === cloud
      } catch () => false
      return set
    }
    if (!registered(LOCAL_PLUGIN)) return false
    return try speakerLock.withPermit(Effect.uninterruptible(effect {
      if (activeSession !== session || cloudStream !== undefined) return false
      if (muted) localSpeakerOwner = session
      const set = effect {
        try tryPromise(() => localPlugin().setSpeechOutputMuted({ muted }))
        return true
      } catch () => false
      if (set && !muted) localSpeakerOwner = undefined
      return set && activeSession === session
    }))
  }

  effect function hush(_turn: number): void!! {
    cloudSpeechAbort?.abort()
    cloudSpeechAbort = undefined
    if (!registered(LOCAL_PLUGIN)) return
    const requestId = activePlaybackRequest
    activePlaybackRequest = undefined
    try ignore(tryPromise(() => localPlugin().stopPlayback(requestId === undefined ? {} : { requestId })))
  }

  // spec/app/voice/output.md, "A reading waiting behind earlier audio is prepared once that audio is confirmed stopped; if it cannot be confirmed, reading aloud closes until Alpha restarts"
  effect function silenceReading(ticket: number): boolean!! {
    stoppedThrough = Math.max(stoppedThrough, ticket)
    const current = readings.get(ticket)
    if (current === undefined) return true
    const plugin = localPlugin()
    const confirmed = effect {
      try tryPromise(() => plugin.cancel({ requestId: current.id }))
      try tryPromise(() => plugin.stopPlayback({ requestId: current.id }))
      return true
    } catch () => false
    if (confirmed) {
      readings.delete(ticket)
      try Deferred.succeed(current.stopped, false)
    }
    return confirmed
  }

  // spec/app/voice/output.md, "Only the current reading's audio plays, and it ends once, as its own answer says"
  function readAloud(ticket: number, text: string, stillCurrent?: () => boolean!!): Stream.Stream<ReadingEvent> {
    return Stream.callback<ReadingEvent>((queue) => effect {
      if (!registered(LOCAL_PLUGIN) || !(try restoreLocalOutput(() => true)) || ticket <= stoppedThrough ||
        (stillCurrent !== undefined && !(try stillCurrent()))) {
        Queue.offerUnsafe(queue, { kind: "ready", ok: false })
        Queue.endUnsafe(queue)
        return
      }
      const plugin = localPlugin()
      const id = fresh()
      const stopped = try Deferred.make<boolean>()
      readings.set(ticket, { id, stopped })
      try addFinalizer(() => ignore(silenceReading(ticket)))
      let playbackId: string | undefined
      for (const [event, ok] of [["playbackEnded", true], ["playbackFailed", false], ["playbackStopped", false]] as const) {
        const listener = tryPromise(() => plugin.addListener(event, (data) => {
          if (playbackId === undefined || typeof data !== "object" || data === null || !("playbackId" in data) || data.playbackId !== playbackId) return
          runFork(Deferred.succeed(stopped, ok))
        })) catch () => undefined
        if (listener === undefined) {
          Queue.offerUnsafe(queue, { kind: "ready", ok: false })
          Queue.endUnsafe(queue)
          return
        }
        try addFinalizer(() => ignore(tryPromise(() => listener.remove())))
      }
      const playing = effect {
        const prepared = try tryPromise(() => plugin.synthesizeLocal({ requestId: id, text, replace: false }))
        const playback = prepared.playbackId
        if (!playback || readings.get(ticket)?.id !== id || (stillCurrent !== undefined && !(try stillCurrent()))) return false
        playbackId = playback
        try tryPromise(() => plugin.play({ playbackId: playback, replace: false }))
        return true
      } catch () => false
      Queue.offerUnsafe(queue, { kind: "ready", ok: playing })
      if (playing) Queue.offerUnsafe(queue, { kind: "ended", ok: try Deferred.await(stopped) })
      Queue.endUnsafe(queue)
    })
  }

  effect function shut(session: number): boolean!! {
    clearCloudPreview(session)
    if (activeSession === session) activeSession = 0
    cloudSpeechAbort?.abort()
    cloudSpeechAbort = undefined
    let confirmed = true
    if (cloudCapture !== undefined) {
      const cap = cloudCapture
      cloudCapture = undefined
      confirmed = (try (tryPromise(() => cap.cancel()) |> Effect.as(%, true) |> Effect.orElseSucceed(%, () => false))) && confirmed
    }
    if (cloudStream !== undefined) {
      const stream = cloudStream
      cloudStream = undefined
      confirmed = (try (tryPromise(() => stream.stop()) |> Effect.as(%, true) |> Effect.orElseSucceed(%, () => false))) && confirmed
    }
    if (registered(LOCAL_PLUGIN)) {
      const req = activePlaybackRequest
      activePlaybackRequest = undefined
      const stopPlay = try (tryPromise(() => localPlugin().stopPlayback(req === undefined ? {} : { requestId: req })) |> Effect.as(%, true) |> Effect.orElseSucceed(%, () => false))
      const stopCap = try (stopNativeCapture(session, true) |> Effect.as(%, true) |> Effect.orElseSucceed(%, () => false))
      const restored = try restoreLocalOutput((owner) => owner === session)
      confirmed = stopPlay && stopCap && restored && confirmed
    }
    return confirmed
  }

  return {
    available: () => sync(() => registered(LOCAL_PLUGIN) || registered(CLOUD_STREAM_PLUGIN)),
    checkPermission: () => registered(LOCAL_PLUGIN)
      ? Effect.orElseSucceed(Effect.map(tryPromise(() => localPlugin().checkPermissions()), (res) => parseGrant(res.microphone)), (): VoiceGrant => "prompt")
      : succeed<VoiceGrant>("granted"),
    requestPermission: () => registered(LOCAL_PLUGIN)
      ? Effect.orElseSucceed(Effect.map(tryPromise(() => localPlugin().requestPermissions()), (res) => parseGrant(res.microphone)), (): VoiceGrant => "denied")
      : succeed<VoiceGrant>("granted"),
    prewarm,
    streamTimings: () => registered(CLOUD_STREAM_PLUGIN)
      ? Effect.orElseSucceed(timeout(tryPromise(() => relayPlugin().cloudStreamTiming({})), RELAY_WARMUP_BOUND), (): unknown => undefined)
      : succeed<unknown>(undefined),
    probeStatus,
    invalidateCache: () => sync(() => {
      cachedStatus = undefined
      cloudKey = undefined
    }),
    forgetAccount: () => sync(() => {
      clearCloudPreview(activeSession)
      if (nativeCapture !== undefined) {
        if (nativeCapture.phase === "Opening") nativeCapture.phase = "Cancelling"
        else if (nativeCapture.phase === "Listening") nativeCapture.phase = "Retired"
        retireNativePreview(nativeCapture)
      }
      accountEpoch += 1
      cloudKey = undefined
      if (activeSession === 0) cloudStream = undefined
    }),
    holdEngine: () => registered(LOCAL_PLUGIN)
      ? Effect.orElseSucceed(Effect.map(tryPromise(() => localPlugin().holdSpeechEngine({})), (res) => res.held === true), () => false)
      : succeed(false),
    releaseEngineHold: () => registered(LOCAL_PLUGIN)
      ? ignore(tryPromise(() => localPlugin().releaseSpeechEngineHold({})))
      : Effect.void,
    openMic,
    closeMic,
    awaitSpeechOutputWarmup,
    playSentence,
    setSpeakerMuted,
    hush,
    canRead: () => sync(() => registered(LOCAL_PLUGIN)),
    readAloud,
    silenceReading,
    shut,
    events: makeNativeEvents(eventSubscribers, () => nativeCapture, stoppedRecording),
    account: signedInAccount, signIns: settledSignIns(),
    effect startRecording(ticket: number): RecordedClip!VoiceBridgeFailed {
      if (!registered(LOCAL_PLUGIN)) throw new VoiceBridgeFailed({ method: "startRecording", cause: "no-voice-plugin" })
      return try recordingLock.withPermits(1)(Effect.uninterruptible(effect {
        if (ticket <= retiredRecording) throw new VoiceBridgeFailed({ method: "startRecording", cause: "recording-retired" })
        const opening = new Map<string, RecordingStop>()
        openingRecording = opening
        return try ensuring(effect {
          const started = try tryPromise({
            try: () => localPlugin().startRecording({}),
            catch: (cause) => new VoiceBridgeFailed({ method: "startRecording", cause }),
          })
          if (ticket <= retiredRecording || typeof started.recordingId !== "string" || started.recordingId === "") {
            try ignore(tryPromise(() => localPlugin().cancelRecording({})))
            throw new VoiceBridgeFailed({ method: "startRecording", cause: "no-active-recording" })
          }
          const clip: DictationClip = { recordingId: started.recordingId, started: ticket, state: "recording" }
          recording = clip
          const stopped = opening.get(clip.recordingId)
          if (stopped !== undefined) stoppedRecording(stopped)
          return clip
        }, sync(() => { openingRecording = undefined }))
      }))
    },
    dictationForeground: () => registered(LOCAL_PLUGIN)
      ? Effect.orElseSucceed(Effect.map(tryPromise(() => localPlugin().dictationForeground({})), (result) => result.available === true), () => false)
      : succeed(false),
    effect transcribe(ticket: number, _network: boolean, automatic: boolean): DictationAnswer!! {
      if (!registered(LOCAL_PLUGIN)) return { kind: "lost" }
      const clip = try recordingLock.withPermits(1)(Effect.uninterruptible(effect {
        const current = recording
        if (current === undefined || current.started > ticket || ticket <= retiredRecording) return undefined
        if (current.state === "recording") {
          const raw = tryPromise(() => localPlugin().stopRecording({})) catch () => undefined
          const stopped = Schema.decodeUnknownOption(recordedClip)(raw)
          if (current.state === "recording" && Option.isSome(stopped) && stopped.value.recordingId === current.recordingId) {
            current.state = "recorded"
            current.durationMs = stopped.value.durationMs
          }
        }
        if (current.state !== "recorded") {
          recording = undefined
          try ignore(tryPromise(() => localPlugin().cancelRecording({})))
          return undefined
        }
        return current
      }))
      if (clip === undefined || ticket <= retiredRecording || recording !== clip) return { kind: "lost" }
      const result = tryPromise({
        try: () => localPlugin().transcribeLocalRecording({ requestId: fresh(), recordingId: clip.recordingId, automatic }),
        catch: (cause): "obscured" | "failed" => asRecord(cause)?.code === "dictation-obscured" ? "obscured" : "failed",
      }) catch (kind) => kind
      return typeof result === "string" ? { kind: result, durationMs: clip.durationMs } : { kind: "recognized", text: result.text ?? "", durationMs: clip.durationMs }
    },
    effect abandon(ticket: number, isCurrent?: () => boolean!!): boolean!! {
      if (isCurrent === undefined) retiredRecording = Math.max(retiredRecording, ticket)
      if (!registered(LOCAL_PLUGIN)) return false
      return try recordingLock.withPermits(1)(Effect.uninterruptible(effect {
        if (isCurrent !== undefined && !(try isCurrent())) return false
        const clip = recording
        if (clip !== undefined && clip.started > ticket) return false
        if (clip === undefined && isCurrent === undefined) return true
        if (isCurrent === undefined) recording = undefined
        const confirmed = effect { try tryPromise(() => localPlugin().cancelRecording({})); return true } catch () => false
        if (confirmed) {
          retiredRecording = Math.max(retiredRecording, ticket)
          recording = undefined
        }
        return confirmed
      }))
    },
  }
})

export const browserVoiceBridge = Layer.effect(VoiceBridge, effect {
  let warmedCloud = false
  return {
    available: () => succeed(false),
    checkPermission: () => succeed<VoiceGrant>("granted"),
    requestPermission: () => succeed<VoiceGrant>("granted"),
    effect prewarm(network: boolean): void!!Agent {
      if (!network || warmedCloud) return
      warmedCloud = true
      try ignore(ask(Agent, HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post("/api/cloud/warm"), {}), Schema.Unknown))
    },
    streamTimings: () => succeed<unknown>(undefined),
    probeStatus: () => succeed<SpeechStatus>({ ready: false, ttsReady: false, liveCapture: false }),
    invalidateCache: () => sync(() => { warmedCloud = false }),
    forgetAccount: () => sync(() => { warmedCloud = false }),
    holdEngine: () => succeed(false),
    releaseEngineHold: () => Effect.void,
    openMic: () => Effect.fail(new VoiceBridgeFailed({ method: "openMic", cause: "browser-no-native-voice" })),
    closeMic: () => Effect.void,
    awaitSpeechOutputWarmup: () => Effect.void,
    playSentence: () => Effect.void,
    setSpeakerMuted: () => succeed(false),
    hush: () => Effect.void,
    canRead: () => succeed(false),
    readAloud: () => Stream.succeed<ReadingEvent>({ kind: "ready", ok: false }),
    silenceReading: () => succeed(true),
    shut: () => succeed(true),
    events: Stream.empty,
    account: () => succeed<CloudSignIn>({ kind: "unknown" }),
    signIns: Stream.empty,
    startRecording: () => Effect.fail(new VoiceBridgeFailed({ method: "startRecording", cause: "browser-no-native-voice" })),
    dictationForeground: () => succeed(false),
    transcribe: () => succeed<DictationAnswer>({ kind: "lost" }),
    abandon: () => succeed(false),
  }
})
