// spec/platform/index.md, "Story: Talk to the resident agent"; spec/platform/index.md, "A request carries only the device headers the resident reads, each one bounded line"
// The on-device agent's local API, through @elizaos/agent/client: one owner, one deployment identity.

/** The resident is not running and did not start in time. */
export error ResidentUnavailable { state: "stopped" | "starting"; reason?: string }
/** The resident answered with a refusal; `retryAfter` is in seconds where it gave one. */
export error ResidentRefused { status: number; code?: string; message: string; retryAfter?: number }

/** A JSON answer of the resident. */
export interface ResidentAnswer { readonly status: number; readonly data: unknown }

/** Device headers a request carries to the resident, such as `x-eliza-device-capabilities`; names match without regard to case. */
export type ResidentHeaders = { readonly [name: string]: string }

/** The resident agent's local API. */
export service Resident {
  /** The resident's state as it reports it now. */
  status(): ("stopped" | "starting" | "running")!!
  /** Start the resident where it is stopped, and wait until it runs. */
  ensureRunning(): void!ResidentUnavailable
  /** One JSON request carrying `headers`; its data is untrusted until a schema decodes it. */
  json(method: "GET" | "POST" | "PUT" | "PATCH" | "DELETE", path: string, body?: unknown, headers?: ResidentHeaders): (ResidentAnswer)!(ResidentUnavailable | ResidentRefused)
  /** A streamed POST carrying `headers`, such as a chat turn: the response body, chunk by chunk. */
  stream(path: string, body: unknown, headers?: ResidentHeaders): Stream.Stream<Uint8Array, ResidentUnavailable | ResidentRefused>
}
