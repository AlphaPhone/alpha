// spec/app/shell/index.md, "Phone and Messages exist only on an Alpha image, and Contacts only where that image admits it"
import { Bridge } from "./bridge.vibe"

module web {
  /** @throws {never} */
  export function zoom(scale: number): void {
    document.documentElement.style.fontSize = `${scale * 100}%`
  }
}
import { zoom } from web

/** What this phone admits: an Alpha image's apps, and Contacts where the image grants them. */
export schema Capabilities { readonly image: boolean; readonly contacts: boolean }

/** A hardware or gesture button the system hands to the launcher. */
export type Button = "back" | "home"

/** The phone itself: what it admits, its text size, and the Back and Home it hands to Alpha. */
export service Device {
  capabilities(): Capabilities!!
  setTextScale(scale: number): void!!
  readonly buttons: Stream.Stream<Button>
}

const nothing: Capabilities = { image: false, contacts: false }

/** The phone, through its plugins; a plugin that fails is a capability the phone does not admit, and is logged. */
export const capacitorDevice = Layer.effect(Device, effect {
  const bridge = try Bridge
  return {
    effect capabilities() {
      return effect {
        return try Schema.decodeUnknownEffect(Capabilities)(try bridge.call("DeviceApps", "platformCapabilities", {}))
      } catch effect (cause) => {
        try logWarning("capabilities unread", cause)
        return nothing
      }
    },
    effect setTextScale(scale: number) {
      bridge.call("AlphaDevice", "setTextScale", { scale }) catch effect (cause) => { try logWarning("text scale not set", cause) }
    },
    buttons: Stream.merge(
      Stream.as(bridge.listen("App", "backButton"), "back" as const),
      Stream.as(bridge.listen("AlphaDevice", "home"), "home" as const),
    ) |> Stream.catch(%, (cause) => Stream.fromEffectDrain(logWarning("buttons unheard", cause))),
  }
})

/** A browser: no Alpha image, its root text size as the scale, and no buttons beyond its own. */
export const browserDevice = Layer.succeed(Device, {
  effect capabilities() { return nothing },
  effect setTextScale(scale: number) { zoom(scale) },
  buttons: Stream.never,
})
