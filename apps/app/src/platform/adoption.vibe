// spec/app/platform/adoption.md, "Story: Keep what the earlier Alpha kept"; spec/app/platform/adoption.md, "A value is moved by copying it only where the new place is still empty, and its earlier place is cleared only once the new place holds a value"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { type Adoption, adoptionOf, earlierCleared } from "../../gen/app__platform__adoption.effect.vibe"
import { type Slot, Vault } from "./vault.vibe"

module earlier {
  import { registerPlugin } from "@capacitor/core"

  /** The earlier Alpha's own connection plugin, which the Alpha APK keeps only so its encrypted slots can be read and cleared (`AlphaConnectionPlugin.java`). */
  export interface Connection {
    secureRead(options: { slot: string }): Promise<{ value?: string | null }>
    secureCompareExchange(options: { slot: string; expectedValue: string; value: null }): Promise<{ status: "saved" | "conflict" }>
  }
  let made: Connection | undefined
  /** @throws {never} */
  export function connection(): Connection {
    return (made ??= registerPlugin<Connection>("AlphaConnection"))
  }
}
import { connection } from earlier

/** A place a value is kept: what it holds now, keeping a value there, and clearing it. Each fails where the place cannot be reached. */
export interface Place<A> {
  read(): Option.Option<A>!unknown
  write(value: A): void!unknown
  clear(): void!unknown
}

/**
 * Move what `earlier` holds into `current`, as `copy` reads it, only where `current` holds nothing yet, and clear
 * `earlier` once `current` holds a value. A value that could not be read, copied or written stays where it was, for
 * a later reading to move. How it went.
 */
export effect function adopt<A, B>(earlier: Place<A>, current: Place<B>, copy: (value: A) => Option.Option<B>): Adoption!! {
  const before = earlier.read() catch () => Option.none<A>()
  if (Option.isNone(before)) return adoptionOf(false, false, false)
  const now = current.read() catch () => undefined
  const currentHeld = now !== undefined && Option.isSome(now)
  const value = now === undefined || currentHeld ? Option.none<B>() : copy(before.value)
  const copied = Option.isSome(value) && (effect { try current.write(value.value); return true } catch () => false)
  const adoption = adoptionOf(true, currentHeld, copied)
  if (earlierCleared(adoption)) try ignore(earlier.clear())
  return adoption
}

/** What the page's storage keeps under `key`: where the earlier Alpha kept preferences and places, and this one keeps each machine's state. */
export effect function keptAt(key: string): Place<string>!!KeyValueStore.KeyValueStore {
  const store = try KeyValueStore.KeyValueStore
  return {
    effect read() {
      const found = try store.get(key)
      return found === undefined ? Option.none() : Option.some(found)
    },
    write: (value: string) => store.set(key, value),
    clear: () => store.remove(key),
  }
}

/** A place the earlier Alpha only kept things in: nothing new is ever written there. */
export error EarlierOnly { place: string }

/**
 * What the earlier Alpha kept in its connection plugin's encrypted slot `slot`, as one text: read, and cleared only
 * while it still holds the value last read from it, so a value written there since is never lost. On a page that is
 * no phone, or a phone without that plugin, the slot fails to read and its value stays for a later reading.
 */
export function earlierSlot(slot: string): Place<string> {
  let seen: string | undefined
  return {
    effect read() {
      const said = try tryPromise(() => connection().secureRead({ slot }))
      seen = typeof said.value === "string" ? said.value : undefined
      return seen === undefined ? Option.none() : Option.some(seen)
    },
    write: () => Effect.fail(new EarlierOnly({ place: slot })),
    effect clear() {
      const expectedValue = seen
      if (expectedValue === undefined) return
      try tryPromise(() => connection().secureCompareExchange({ slot, expectedValue, value: null }))
    },
  }
}

/** What the phone's secure store keeps in `slot`. */
export effect function vaulted(slot: Slot): Place<Redacted.Redacted<string>>!!Vault {
  const vault = try Vault
  return { read: () => vault.read(slot), write: (secret: Redacted.Redacted<string>) => vault.write(slot, secret), clear: () => vault.remove(slot) }
}
