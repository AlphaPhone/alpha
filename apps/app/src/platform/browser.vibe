// spec/app/browser/index.md, "The Browser holds its open tabs, which are private, the one shown, their native tabs, the saved session and its writer, and what covers the page"
import { BrowserPage, type DeviceOperation } from "@elizaos/agent"
import type { BrowserTabHostListener, BrowserTabSelection, BrowserTabSession } from "@elizaos/os-bridges"
import { type Found, type Front, handed } from "../../gen/app__browser__reading.effect.vibe"
import { registered } from "./device.vibe"
import { WebFrames, type FrameEvent } from "./browserWeb.vibe"

module held {
  import type { BrowserPageGuard, BrowserTabHostListener, BrowserTabHostPlugin, BrowserTabPresentation } from "@elizaos/os-bridges"
  import { BrowserTabSession } from "@elizaos/os-bridges"
  import { plugin as capacitorPlugin } from "./capacitor.ts"

  /** A place of Alpha's on the page, rounded by `cornerRadius`. */
  type HostRect = { readonly x: number; readonly y: number; readonly width: number; readonly height: number; readonly cornerRadius: number }

  /**
   * Alpha's `AlphaBrowser`: eliza's tab host, the read of the page it presents for one chat turn (`AlphaBrowserPlugin.pageContext`),
   * and a failed page opened in another browser at the HTTPS address the host named (`AlphaBrowserPlugin.openFailedPage`).
   */
  export type AlphaTabHost = BrowserTabHostPlugin & {
    /**
     * Draws a tab's page above Alpha, or below it (`below-host`), where Alpha's WebView draws its controls over the page and
     * `hostRects` are their places, in the page's own pixels: a touch there is Alpha's, anywhere else the page's
     * (`AlphaBrowserPlugin.present`, `TabInputRouter`).
     */
    present(options: BrowserTabPresentation | (Extract<BrowserTabPresentation, { readonly id: string }> & { readonly layer: "below-host"; readonly hostRects: readonly HostRect[] })): Promise<void>
    pageContext(options: BrowserPageGuard): Promise<unknown>
    openFailedPage(options: BrowserPageGuard): Promise<void>
    setDesktopSite(options: { readonly session: string; readonly id: string; readonly enabled: boolean }): Promise<unknown>
    addListener(event: "showDownloads", listener: (raw: unknown) => void): Promise<BrowserTabHostListener>
  }

  let made: AlphaTabHost | undefined
  let front: { readonly session: string; readonly id: string | null } | undefined
  /**
   * eliza's client of Alpha's tab host, made once: Capacitor registers a plugin a single time for the life of the page.
   * It remembers the tab the host last drew, as the host does, once the host took it.
   * @throws {never}
   */
  export function client(name: string): AlphaTabHost {
    if (made !== undefined) return made
    const plugin = capacitorPlugin<AlphaTabHost>(name)
    made = new Proxy(plugin, {
      get: (target, key) => key === "present"
        ? (options: Parameters<BrowserTabHostPlugin["present"]>[0]) => target.present(options).then(() => { front = { session: options.session, id: options.id } })
        : Reflect.get(target, key),
    })
    return made
  }
  /** The tab the host draws for `session`, as it last took it. @throws {never} */
  export function presented(session: string): string | undefined {
    return front?.session === session ? front.id ?? undefined : undefined
  }
  /** eliza's record of the tabs one launch of the Browser holds, which takes each event of the tab host only once and in order. @throws {never} */
  export function session(): BrowserTabSession {
    return new BrowserTabSession()
  }
}
import { type AlphaTabHost, client, presented, session } from held

/** The tab host refused, broke or is absent: `method` is the plugin's method, `cause` what it said. */
export error TabHostFailed { method: string; cause: unknown }

/** One thing the tab host told the page, as it said it: what the session takes is decided by `BrowserTabSession`. */
export type Told =
  | { readonly kind: "state"; readonly raw: unknown }
  | { readonly kind: "opened"; readonly raw: unknown }
  | { readonly kind: "closed"; readonly raw: unknown }
  | { readonly kind: "found"; readonly raw: unknown }
  | { readonly kind: "showDownloads"; readonly raw: unknown }
  | FrameEvent

/**
 * The phone's web pages in native tabs: eliza's client of Alpha's `AlphaBrowser` tab host and the session that holds
 * this launch's tabs, or none where the page is no phone or its host did not register the plugin. `told` says each
 * event the host sends.
 */
export service TabHost {
  readonly plugin: Option.Option<AlphaTabHost>
  readonly session: BrowserTabSession
  readonly told: Stream.Stream<Told>
  readonly web?: WebFrames
  /** Wait until the native state listener that will report the load is installed. */
  observing(): boolean!!
}

// spec/app/files/index.md, "Another area opens Files at Downloads: the Download folder of the main volume where the phone has one, else the Downloads category; the owner's own move to the top, a volume or a category ends that walk"
/** Open the retained Files area when the owner chooses Show in Files in the phone's Browser Downloads. */
export service BrowserDownloadsHandoff {
  open(): void!!
}

// spec/app/inbox/message.md, "Only an https link without credentials in it can be reviewed and opened; any other link stays text"
/** Opens a link the owner confirmed in Inbox while the same message and grant are current. */
export service InboxBrowserLinks {
  open(href: string, current: Effect.Effect<boolean>): boolean!!
}

/** A page the agent's reply asked the Browser to open: eliza's typed open, at once when the owner's whole message asked for it (`atOnce`), else after the owner's Open on the Browser's card. */
export interface AgentPage {
  readonly operation: Extract<DeviceOperation, { readonly type: "browser_navigate" }>
  readonly atOnce: boolean
}

// spec/app/browser/index.md, "Story: Let the agent open a page"; spec/app/browser/index.md, "A page the owner's whole message asked for opens at once, typed or spoken, and any other page waits for the owner's Open"
/** Hand a page the agent asked for to the Browser, which opens it at once or shows it on its card for the owner's Open while `current` says the request that asked for it is still the owner's latest: whether the Browser took it. */
export service AgentPages {
  open(page: AgentPage, current: Effect.Effect<boolean>): boolean!!
}

/** One call of the tab host, failing with `TabHostFailed` where it refused, broke, or there is none. */
export effect function hosted<A>(method: string, call: (plugin: AlphaTabHost, session: string) => Promise<A>): A!TabHostFailed!TabHost {
  const { plugin, session } = try TabHost
  if (Option.isNone(plugin)) throw new TabHostFailed({ method, cause: "no tab host" })
  return try tryPromise({ try: () => call(plugin.value, session.session), catch: (cause) => new TabHostFailed({ method, cause }) })
}

const name = "AlphaBrowser"
const listenerTimeout = 3000

/** The phone: eliza's client of `AlphaBrowser` where the host registered it, and its events. */
export const phoneTabHost = Layer.effect(TabHost, effect {
  if (!registered(name)) return { plugin: Option.none(), session: session(), told: Stream.empty, observing: () => succeed(false) }
  const plugin = client(name)
  const events = try PubSub.unbounded<Told>()
  const ready = try Deferred.make<boolean>()
  let listening = false
  const emit = (kind: Exclude<Told["kind"], FrameEvent["kind"]>) => (raw: unknown) => {
    PubSub.publishUnsafe(events, { kind, raw })
  }
  const attach = (subscribe: () => Promise<BrowserTabHostListener>, tracksState: boolean) => effect {
    const acquire = tryPromise(async (signal: AbortSignal): Promise<BrowserTabHostListener> => {
      const handle = await subscribe()
      if (signal.aborted) await Promise.resolve(handle.remove()).catch(() => undefined)
      return handle
    })
    const handle = acquireRelease(
      Effect.interruptible(Effect.timeout(acquire, listenerTimeout)),
      (one) => effect {
        if (tracksState) listening = false
        try ignore(Effect.interruptible(Effect.timeout(tryPromise(async () => { await one.remove() }), listenerTimeout)))
      },
    ) catch () => undefined
    if (tracksState) {
      listening = handle !== undefined
      try Deferred.succeed(ready, listening)
    }
  }
  try Effect.all([
    attach(() => plugin.addListener("stateChanged", emit("state")), true),
    attach(() => plugin.addListener("tabOpened", emit("opened")), false),
    attach(() => plugin.addListener("tabClosed", emit("closed")), false),
    attach(() => plugin.addListener("findResult", emit("found")), false),
    attach(() => plugin.addListener("showDownloads", emit("showDownloads")), false),
  ], { concurrency: "unbounded" })
  return {
    plugin: Option.some(plugin),
    session: session(),
    told: Stream.fromPubSub(events),
    observing: () => listening ? succeed(true) : Effect.map(Effect.orElseSucceed(Effect.timeout(Deferred.await(ready), listenerTimeout), () => false), (installed) => installed && listening),
  }
})

/** The enclosing browser owns opaque frames and says when a requested frame has loaded. */
export const browserTabHost = Layer.effect(TabHost, effect {
  const events = try Queue.unbounded<Told>()
  const web = try sync(() => new WebFrames((receipt) => { Queue.offerUnsafe(events, receipt) }))
  return { plugin: Option.none(), session: session(), told: Stream.fromQueue(events), web, observing: () => succeed(true) }
})

/** The page a question takes with it: the tab in front as the agent's observation names it, and what was read of its page. */
export type PageInFront = { readonly selection: BrowserTabSelection; readonly page: BrowserPage }

const readPage = Schema.decodeUnknownOption(BrowserPage, { onExcessProperty: "error" })
const pageWait = "1500 millis"

function frontOf(host: TabHost.Shape, id: string | undefined): Front {
  if (id === undefined || !host.session.has(id)) return "NoTab"
  if (host.session.isPrivate(id)) return "PrivateTab"
  if (host.session.pageBinding(id) === undefined) return "NotLoaded"
  return host.session.pageBinding(id, { https: true }) === undefined ? "NotSecure" : "Committed"
}

function foundOf(page: BrowserPage | undefined): Found {
  if (page === undefined) return "Failed"
  if (!("withheld" in page)) return "Visible"
  return page.withheld === "unreadable" ? "Unreadable" : "Sensitive"
}

// spec/app/browser/reading.md, "A question asked while Browser is the open screen reads the tab in front once, only when it is a normal tab whose HTTPS page has committed and Browser page for Alpha is on"; spec/app/browser/reading.md, "The read hands over the text the owner can see, at most 6,000 characters, with the page's address and title, or its address and title alone where this phone cannot read the page"; spec/app/browser/reading.md, "A page that may hold a password, a payment or a code hands over nothing, nor does a read that failed or came too late"
/** The page in front for one question asked at `now`, read by the tab host without a review, or none where the reading rules hand nothing over. */
export effect function pageInFront(onBrowser: boolean, allowed: boolean, now: number): (PageInFront | undefined)!!TabHost {
  const host = try TabHost
  if (Option.isNone(host.plugin)) return undefined
  const id = presented(host.session.session)
  const front = frontOf(host, id)
  const binding = id === undefined ? undefined : host.session.pageBinding(id, { https: true })
  const selection = id === undefined ? undefined : host.session.selection(id)
  if (binding === undefined || selection === undefined || handed(onBrowser, allowed, front, "Visible") === "NoPage") return undefined
  const plugin = host.plugin.value
  const asked = Effect.orElseSucceed(tryPromise(() => plugin.pageContext(host.session.guard(binding))), (): unknown => undefined)
  const read = try Effect.timeoutOption(asked, pageWait)
  const answer = Option.isNone(read) ? undefined : read.value
  const page = typeof answer === "object" && answer !== null ? Option.getOrUndefined(readPage({ ...answer, tabId: selection.id, revision: selection.revision, capturedAt: Math.trunc(now) })) : undefined
  const found: Found = Option.isNone(read) ? "Late" : foundOf(page)
  if (page === undefined || handed(onBrowser, allowed, front, found) === "NoPage") return undefined
  return { selection, page }
}
