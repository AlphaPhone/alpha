// spec/app/notes/transfer.md, "Story: Import and export a text file"
import { registered } from "./device.vibe"

module checked {
  import { plugin as capacitorPlugin } from "./capacitor.ts"

  export interface Android {
    pick(input: { readonly importing: boolean; readonly title: string }): Promise<unknown>
    write(input: { readonly handle: string; readonly text: string }): Promise<unknown>
  }

  /** @throws {never} */
  export function client(): Android {
    return capacitorPlugin<Android>("AlphaNoteDocuments")
  }
}
import { type Android, client } from checked

module browser {
  import { downloadCopy, releasePreview } from "./browser-library.ts"

  /** Create a browser download URL for the exact text, or `undefined` when unavailable. @throws {never} */
  export function startDownloadText(name: string, text: string): string | undefined {
    try {
      return downloadCopy(name, new Blob([text], { type: "text/plain;charset=utf-8" }))
    } catch { return undefined }
  }

  /** Release the download preview URL. @throws {never} */
  export function revokeDownloadText(url: string): void {
    releasePreview(url)
  }
}
import { revokeDownloadText, startDownloadText } from browser

/** Ask the browser to save the exact text and release its blob URL through Effect. It does not report the disk outcome. */
export function downloadText(name: string, text: string): boolean {
  const url = startDownloadText(name, text)
  if (url === undefined) return false
  Effect.runFork(ensuring(sleep("1 minute"), sync(() => revokeDownloadText(url))))
  return true
}

const Result = Schema.Struct({
  status: Schema.Literals(["picked", "cancelled", "unavailable", "unreadable", "exported", "unverified", "failed"]),
  text: Schema.optionalKey(Schema.String),
  handle: Schema.optionalKey(Schema.NonEmptyString),
})
export type DocumentResult = typeof Result.Type

export service NoteDocuments {
  readonly available: boolean
  pick(importing: boolean, title: string): DocumentResult!!
  write(handle: string, text: string): DocumentResult!!
}

const unavailable: DocumentResult = { status: "unavailable" }
const unverified: DocumentResult = { status: "unverified" }

export const noteDocuments = Layer.sync(NoteDocuments, () => {
  const api = registered("AlphaNoteDocuments") ? client() : undefined
  const answered = (call: (api: Android) => Promise<unknown>, onFailure: DocumentResult) => api === undefined ? succeed(unavailable) : Effect.catch(
    flatMap(tryPromise(() => call(api)), Schema.decodeUnknownEffect(Result)),
    () => succeed(onFailure),
  )
  return {
    available: api !== undefined,
    pick: (importing: boolean, title: string) => answered((native) => native.pick({ importing, title }), unavailable),
    write: (handle: string, text: string) => answered((native) => native.write({ handle, text }), unverified),
  }
})
