// spec/kit/read.md, "Story: Read from outside"
import * as KeyValueStore from "effect/persistence/KeyValueStore"
import { type Install, install } from "../runtime/attempts.vibe"
import { type Time, timeOver } from "../runtime/time.vibe"
import { type Agent, agentAt, relayedAgent } from "./agent.vibe"
import { capacitorBridge } from "./bridge.vibe"
import { type Cloud, absentCloud, cloudAt } from "./cloud.vibe"
import { Device, browserDevice, capacitorDevice } from "./device.vibe"
import { type Vault, browserVault, capacitorVault } from "./vault.vibe"

module web {
  /** @throws {never} */
  export const storage = (): Storage => localStorage
}
import { storage } from web

/** Every service of the world outside Alpha. Areas reach the world only through these. */
export type Platform = KeyValueStore.KeyValueStore | Time | Install | Agent | Cloud | Device | Vault

/** Alpha's time and its installation's name, which every platform has: over the store, and over the phone that says when the page woke. */
export const grounded = Layer.merge(install, Layer.unwrap(effect { return timeOver((try Device).resumed) }))

const store = KeyValueStore.layerStorage(storage)

/** The phone: each service through its Capacitor plugin, with the agent's token and the cloud's key kept in native code. */
export function phonePlatform(): Layer.Layer<Platform> {
  return Layer.provideMerge(grounded, Layer.provide(Layer.mergeAll(store, capacitorDevice, capacitorVault, relayedAgent, absentCloud), capacitorBridge))
}

/** A page that is no phone: `agent` and `cloud` as they are reached from it, and no image, plugins or secrets. */
export function pagePlatform(agent: Layer.Layer<Agent>, cloud: Layer.Layer<Cloud>): Layer.Layer<Platform> {
  return Layer.provideMerge(grounded, Layer.mergeAll(store, browserDevice, browserVault, agent, cloud))
}

/** A browser page: the agent and the cloud at the page's own `/agent` and `/cloud`, which the dev server answers. */
export function browserPlatform(origin: string): Layer.Layer<Platform> {
  return pagePlatform(Layer.provide(agentAt(`${origin}/agent`), FetchHttpClient.layer), Layer.provide(cloudAt(`${origin}/cloud`), FetchHttpClient.layer))
}
