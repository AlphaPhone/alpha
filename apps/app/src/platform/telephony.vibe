// spec/app/shell/index.md, "Phone and Messages exist only on an Alpha image, and Contacts only where that image admits it"
import type { DeferredDeletionsClient, StagedDeletion } from "@elizaos/os-bridges"
import type { AddressBookClient, ContactNamesClient, NameSurface } from "@elizaos/os-bridges"
import type { MessagesClient, MmsBinding, MmsSendResult, OperationId } from "@elizaos/os-bridges"
import type { PhoneClient, PhoneNumber } from "@elizaos/os-bridges"

module held {
  import { registerPlugin } from "@capacitor/core"
  import { Schema, Semaphore } from "effect"
  import { createDeferredDeletions, type ActionJournalPlugin, type StagedDeletion } from "@elizaos/os-bridges"
  import { rejectionCode } from "@elizaos/os-bridges"
  import { addressBookPlugin, createAddressBookClient, createContactNames } from "@elizaos/os-bridges"
  import { messagesClient, type MessagesNativePlugin } from "@elizaos/os-bridges"
  import { parseMmsSendResult, type MmsBinding, type OperationId } from "@elizaos/os-bridges"
  import { phoneClient, type PhoneNativePlugin, type PhoneNumber } from "@elizaos/os-bridges"

  type OwnerDialPlugin = PhoneNativePlugin & {
    classifyDialNumber(input: { number: PhoneNumber }): Promise<unknown>
    ownerDialScreen(input: { number: PhoneNumber }): Promise<unknown>
  }
  const DialKind = Schema.Literals(["emergency", "ordinary", "unknown"])
  export type AndroidDialKind = typeof DialKind.Type

  const dialKind = Schema.decodeUnknownSync(Schema.Struct({ kind: DialKind }))
  const dialResult = Schema.decodeUnknownSync(Schema.Struct({
    status: Schema.Literals(["handed-off", "unavailable", "cancelled", "failed"]),
    target: Schema.Literal("dialer"),
    handler: Schema.NullOr(Schema.String),
    message: Schema.String,
  }))

  async function classifyDialNumber(phone: OwnerDialPlugin, number: PhoneNumber): Promise<AndroidDialKind> {
    return dialKind(await phone.classifyDialNumber({ number })).kind
  }

  async function ownerDialScreen(phone: OwnerDialPlugin, number: PhoneNumber): Promise<boolean> {
    return dialResult(await phone.ownerDialScreen({ number })).status === "handed-off"
  }

  const receiptKinds = { MessageRecord: "message", VoicemailRecord: "voicemail", ContactRecord: "contact" } as const
  type RecordReceiptKey = { readonly kind: typeof receiptKinds[keyof typeof receiptKinds]; readonly id: string }
  type Journal = ActionJournalPlugin & { telephonyDeletionReceipt(key: RecordReceiptKey): Promise<unknown> }
  export type TelephonyDeletionPhase = "deleted" | "undone" | "conflict" | "unknown"

  async function deletionReceipt(journal: Journal, staged: StagedDeletion): Promise<TelephonyDeletionPhase | undefined> {
    if (staged.kind !== "MessageRecord" && staged.kind !== "VoicemailRecord" && staged.kind !== "ContactRecord") return undefined
    const kind = receiptKinds[staged.kind]
    const received = await journal.telephonyDeletionReceipt({ kind, id: staged.id })
    if (typeof received !== "object" || received === null || !("kind" in received) || received.kind !== kind
      || !("id" in received) || received.id !== staged.id || !("phase" in received)) return undefined
    const { phase } = received
    return phase === "deleted" || phase === "undone" || phase === "conflict" || phase === "unknown" ? phase : undefined
  }

  function make() {
    const journal = registerPlugin<Journal>("ElizaActionJournal")
    const nativePhone = registerPlugin<OwnerDialPlugin & MessagesNativePlugin>("ElizaTelephony")
    const addressBook = addressBookPlugin()
    return {
      deletions: createDeferredDeletions(journal),
      deletionReceipt: (staged: StagedDeletion) => deletionReceipt(journal, staged),
      phone: phoneClient(nativePhone, journal),
      classifyDialNumber: (number: PhoneNumber) => classifyDialNumber(nativePhone, number),
      ownerDialScreen: (number: PhoneNumber) => ownerDialScreen(nativePhone, number),
      messages: messagesClient(nativePhone, journal),
      async mmsReceipt(binding: MmsBinding, operation: OperationId, hash: string) {
        const raw = await nativePhone.mmsSendResult({ operationId: operation })
        return parseMmsSendResult(raw, binding, operation, hash)
      },
      contacts: createAddressBookClient({ install: "WritingInstall", plugin: addressBook, journal }),
      addressBookRead: Semaphore.makeUnsafe(1),
      names: createContactNames(addressBook),
    }
  }
  let made: ReturnType<typeof make> | undefined
  /** eliza's clients of the image's telephony and contacts plugins, made once: Capacitor registers a plugin a single time for the life of the page. @throws {never} */
  export function clients() {
    return (made ??= make())
  }
  /** The code a plugin rejected a call with, or none for an answer that never came. @throws {never} */
  export function codeOf(cause: unknown): string | undefined {
    return rejectionCode(cause)
  }
  /** The tag of eliza's typed refusal, such as `RecentCallsRefused`. @throws {never} */
  export function tagOf(cause: unknown): string {
    return typeof cause === "object" && cause !== null && "_tag" in cause && typeof cause._tag === "string" ? cause._tag : ""
  }
}
import { clients, codeOf, tagOf, type AndroidDialKind, type TelephonyDeletionPhase } from held
import { registered } from "./device.vibe"

/** eliza's clients of an Alpha image's telephony: calls, the call log and voicemail; conversations and sends; the address book. */
export interface TelephonyClients {
  readonly phone: PhoneClient
  classifyDialNumber(number: PhoneNumber): Promise<AndroidDialKind>
  ownerDialScreen(number: PhoneNumber): Promise<boolean>
  readonly messages: MessagesClient
  /** Reads the native record and checks it against the original review digest, without the picture bytes. */
  mmsReceipt(binding: MmsBinding, operation: OperationId, hash: string): Promise<MmsSendResult | undefined>
  readonly contacts: AddressBookClient
  readonly addressBookRead: Semaphore.Semaphore
  readonly names: ContactNamesClient
  readonly deletions: DeferredDeletionsClient
  deletionReceipt(staged: StagedDeletion): Promise<TelephonyDeletionPhase | undefined>
}

/** Phone, Messages and Contacts are not on this phone: nothing reached its native side. */
export error TelephonyAbsent { method: string }

/**
 * The phone refused, or did not answer. `code` is the plugin's own word where it gave one, and `tag` the name of
 * eliza's typed refusal; with neither, the answer was lost and the phone may have acted.
 */
export error TelephonyRefused { method: string; code: string | undefined; tag: string; cause: unknown }

/** The phone's telephony, through eliza's clients of the image's plugins; absent off the image. */
export service Telephony {
  clients(): TelephonyClients!TelephonyAbsent
}

/** The contacts' names for `numbers`, as the phone names a number for `surface`; a number it cannot name, or a phone that cannot be asked, has none. */
export effect function namesOf(surface: NameSurface, numbers: ReadonlyArray<string>): ReadonlyMap<string, string>!!Telephony {
  const asked = [...new Set(numbers.filter((number) => number !== ""))]
  if (asked.length === 0) return new Map()
  const named = telephony("names", (c) => c.names.resolve({ surface, numbers: asked })) catch () => []
  return new Map(named.flatMap((one) => (one.name === null ? [] : [[one.number, one.name as string] as const])))
}

/** One call of eliza's clients: refused before the phone where there is no image, and typed where the phone refused. */
export effect function telephony<A>(method: string, run: (clients: TelephonyClients) => Promise<A>): A!(TelephonyAbsent | TelephonyRefused)!Telephony {
  const found = try (try Telephony).clients()
  return try nativeCall(method, () => run(found))
}

effect function nativeCall<A>(method: string, call: () => Promise<A>): A!TelephonyRefused {
  return try tryPromise({
    try: call,
    catch: (cause) => new TelephonyRefused({ method, code: codeOf(cause), tag: tagOf(cause), cause }),
  })
}

/** The address book keeps one read ticket, shared by list, card and number searches. A new read waits until the outstanding native answer settles. */
export effect function readAddressBook<A>(method: string, read: (book: AddressBookClient) => Promise<A>): A!(TelephonyAbsent | TelephonyRefused)!Telephony {
  const clients = try (try Telephony).clients()
  return try clients.addressBookRead.withPermit(Effect.uninterruptible(nativeCall(method, () => read(clients.contacts))))
}

/** On an Alpha image: eliza's own clients of `ElizaTelephony`, `ElizaContacts` and `ElizaActionJournal`, which the image's host registers. */
export const phoneTelephony = Layer.succeed(Telephony, {
  clients: (): TelephonyClients!TelephonyAbsent => registered("ElizaTelephony") ? sync(() => clients()) : Effect.fail(new TelephonyAbsent({ method: "clients" })),
})

/** In a browser there is no image: every call is refused before anything is asked. */
export const browserTelephony = Layer.succeed(Telephony, {
  clients: () => Effect.fail(new TelephonyAbsent({ method: "clients" })),
})
