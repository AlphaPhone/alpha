// spec/app/settings/passwords.md, "Story: Use my saved passwords only after Android unlocks them"
import type { PasswordsStatus } from "@elizaos/os/bridges/definitions/passwords"
import type { Answer, Autofill, Entry, Reason, Task } from "../../gen/app__settings__passwords.ts"

module held {
  import { createPasswordsClient } from "@elizaos/os/bridges/passwords"

  let made: ReturnType<typeof createPasswordsClient> | undefined
  /** eliza's client of the `ElizaPasswords` plugin, made once; it refuses any answer that carries a password. @throws {never} */
  export function client(): ReturnType<typeof createPasswordsClient> {
    return (made ??= createPasswordsClient())
  }
  /** The vault's error code, where the plugin gave one. @throws {never} */
  export function codeOf(cause: unknown): string | undefined {
    if (typeof cause !== "object" || cause === null) return undefined
    if ("code" in cause && typeof cause.code === "string") return cause.code
    return "cause" in cause ? codeOf(cause.cause) : undefined
  }
}
import { client, codeOf } from held

/** How the vault is, as the plugin reports it. */
export interface VaultState {
  readonly available: boolean
  readonly reason: Reason
  readonly locked: boolean
  readonly damaged: boolean
  readonly autofill: Autofill
}

/** Alpha's password vault, in native code: entries come back without their passwords, and every password stays there. */
export service Passwords {
  state(): VaultState!!
  /** The entries, or none where the vault would not list them. */
  list(): Option.Option<ReadonlyArray<Entry>>!!
  run(task: Task, id: string, revision: number): Answer!!
}

const reasons: Readonly<Record<NonNullable<PasswordsStatus["reason"]>, Reason>> = {
  "no-screen-lock": "NoScreenLock", unsupported: "Unsupported", "not-admitted": "NotAdmitted", "device-locked": "DeviceLocked",
  "legacy-authorization-required": "LegacyAuthorization", "legacy-key-unavailable": "LegacyKey",
}

function autofillOf(status: PasswordsStatus): Autofill {
  if (status.autofill.supported === false) return "AutofillUnsupported"
  return status.autofill.selected === "this-app" ? "AutofillThisApp" : status.autofill.selected === "other" ? "AutofillOther" : status.autofill.selected === "none" ? "AutofillNone" : "AutofillUnread"
}

function answerOf(cause: unknown): Answer {
  const code = codeOf(cause)
  return code === "locked" ? "WasLocked" : code === "key-invalidated" ? "KeyInvalidated" : code === "conflict" ? "Conflicted" : "Refused"
}

const missing: VaultState = { available: false, reason: "BridgeMissing", locked: true, damaged: false, autofill: "AutofillUnsupported" }

effect function stateOf(): VaultState!! {
  return effect {
    const status = try tryPromise(() => client().status())
    return { available: status.available, reason: status.reason === undefined ? "NoReason" : reasons[status.reason], locked: status.locked, damaged: false, autofill: autofillOf(status) }
  } catch (cause) => (codeOf(cause) === "key-invalidated" ? { ...missing, available: true, reason: "NoReason", damaged: true } : missing)
}

function work(task: Task, id: string, revision: number): () => Promise<unknown> {
  const vault = client()
  return match (task) {
    when "Unlocking": () => vault.unlock();
    when "Locking": () => vault.lock();
    when "Editing": () => vault.openEditor(id === "" ? undefined : { entryId: id, expectedRevision: revision });
    when "Removing": () => vault.remove(id, revision);
    when "Revealing": () => vault.reveal(id, revision);
    when "Copying": () => vault.copy(id, revision);
    when "Resetting": () => vault.reset();
    when "OpeningAutofill": () => vault.openAutofillSettings();
    when "NoTask": () => Promise.resolve();
  }
}

/** On the phone: eliza's client of the `ElizaPasswords` plugin. */
export const phonePasswords = Layer.succeed(Passwords, {
  state: stateOf,
  list: () => Effect.map(Effect.option(tryPromise(() => client().list())), Option.map((entries) => entries.map((entry): Entry => ({ id: entry.id, label: entry.label, username: entry.username, sites: entry.bindings.map((binding) => binding.display), revision: entry.revision })))),
  effect run(task: Task, id: string, revision: number): Answer!! {
    return effect {
      try tryPromise(work(task, id, revision))
      return "Done" as Answer
    } catch (cause) => answerOf(cause)
  },
})

/** A browser has no vault. */
export const browserPasswords = Layer.succeed(Passwords, {
  state: () => succeed(missing),
  list: () => succeed(Option.none<ReadonlyArray<Entry>>()),
  run: () => succeed<Answer>("Refused"),
})
