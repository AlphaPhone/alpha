// spec/app/settings/carrier.md, "Story: Read what my carrier needs to activate a SIM"
import type { Field, Kind, Status } from "../../gen/app__settings__carrier.ts"

module held {
  import { registerPlugin } from "@capacitor/core"

  export interface CarrierPlugin {
    read(): Promise<unknown>
    readEid(): Promise<unknown>
    openSettings(input: { page: "sim" | "apn" }): Promise<{ status: "opened"; specific: boolean }>
  }

  interface Clipboard {
    copyText(input: { text: string }): Promise<void>
  }

  let made: CarrierPlugin | undefined
  let clipboard: Clipboard | undefined
  /** The plugin, registered once for the life of the page. @throws {never} */
  export function plugin(): CarrierPlugin {
    return (made ??= registerPlugin<CarrierPlugin>("AlphaCarrierSetup"))
  }
  /** Put one reviewed carrier identifier on the Android clipboard while Alpha is foreground. */
  export function copied(text: string): Promise<void> {
    return (clipboard ??= registerPlugin<Clipboard>("AlphaDevice")).copyText({ text })
  }
}
import { copied, plugin } from held

const FieldStatus = Schema.Literals(["available", "permission-denied", "unavailable", "unsupported", "not-read"])
const ReportedSchema = Schema.Struct({ status: FieldStatus, value: Schema.optionalKey(Schema.String) })
type Reported = typeof ReportedSchema.Type
const Subscription = Schema.Struct({
  subscriptionId: Schema.Int, embedded: Schema.Boolean, slotIndex: Schema.optionalKey(Schema.Int),
  carrier: ReportedSchema, iccid: ReportedSchema, operator: ReportedSchema, operatorCode: ReportedSchema,
  name: Schema.optionalKey(ReportedSchema), dataState: Schema.optionalKey(ReportedSchema), networkType: Schema.optionalKey(ReportedSchema),
  dataEnabled: ReportedSchema, roaming: ReportedSchema, defaultData: Schema.optionalKey(Schema.Boolean),
})
const SetupSchema = Schema.Struct({
  canChooseSms: Schema.Boolean, smsRole: ReportedSchema, dialerRole: ReportedSchema, eid: ReportedSchema,
  hardware: Schema.Struct({ manufacturer: ReportedSchema, model: ReportedSchema, baseband: ReportedSchema, device: Schema.optionalKey(ReportedSchema), android: Schema.optionalKey(ReportedSchema) }),
  slots: Schema.Array(Schema.Struct({ slotIndex: Schema.Int, imei: ReportedSchema, simState: ReportedSchema })),
  subscriptions: Schema.Struct({ status: Schema.optionalKey(FieldStatus), items: Schema.Array(Subscription) }),
})
type Setup = typeof SetupSchema.Type

/** What one read of the carrier's identifiers found, and whether there is an eSIM and Alpha can take the SMS role. */
export interface Identifiers {
  readonly fields: ReadonlyArray<Field>
  readonly esim: boolean
  readonly smsChoice: boolean
}

/** The phone's modems, SIMs and their identifiers, read only when the owner asks. */
export service CarrierSetup {
  read(): Option.Option<Identifiers>!!
  readEid(): Field!!
  copy(text: string): boolean!!
}

/** Ask Alpha's carrier bridge for Android's SIMs or access point page. */
export effect function openCarrierSettings(page: "sim" | "apn"): ("exact" | "nearby" | "refused")!! {
  const result = tryPromise(() => plugin().openSettings({ page })) catch () => undefined
  return result?.status !== "opened" ? "refused" : result.specific === true ? "exact" : "nearby"
}

const statuses: Readonly<Record<Reported["status"], Status>> = { available: "Returned", "permission-denied": "AccessDenied", unavailable: "Missing", unsupported: "Unsupported", "not-read": "NotRead" }

function fieldOf(kind: Kind, index: number, reported: Reported): Field {
  const status = reported.value === undefined && reported.status === "available" ? "Missing" : statuses[reported.status]
  return { kind, index, status, value: status === "Returned" ? reported.value ?? "" : "" }
}

const unknown: Reported = { status: "unavailable" }
const reported = (value: string): Reported => ({ status: "available", value })

function fieldsOf(setup: Setup): ReadonlyArray<Field> {
  const sims = setup.subscriptions
  const count = sims.status === "available" ? reported(String(sims.items.length)) : { status: sims.status ?? "unavailable" } as const
  return [
    ...setup.slots.flatMap((slot) => [fieldOf("Imei", slot.slotIndex, slot.imei), fieldOf("SimState", slot.slotIndex, slot.simState)]),
    fieldOf("ActiveSims", 0, count),
    ...sims.items.flatMap((sim, index) => [
      fieldOf("SimType", index, reported(sim.embedded ? "eSIM" : "Physical SIM")),
      fieldOf("SimSlot", index, sim.slotIndex !== undefined && sim.slotIndex >= 0 ? reported(String(sim.slotIndex + 1)) : unknown),
      fieldOf("CarrierName", index, sim.carrier), fieldOf("SimName", index, sim.name ?? unknown), fieldOf("Iccid", index, sim.iccid),
      fieldOf("Operator", index, sim.operator), fieldOf("OperatorCode", index, sim.operatorCode), fieldOf("MobileData", index, sim.dataEnabled),
      fieldOf("DataState", index, sim.dataState ?? unknown), fieldOf("NetworkType", index, sim.networkType ?? unknown), fieldOf("Roaming", index, sim.roaming),
      fieldOf("DefaultData", index, sim.defaultData === undefined ? unknown : reported(sim.defaultData ? "Yes" : "No")),
    ]),
    fieldOf("SmsRole", 0, setup.smsRole), fieldOf("PhoneRole", 0, setup.dialerRole),
    fieldOf("Manufacturer", 0, setup.hardware.manufacturer), fieldOf("Model", 0, setup.hardware.model), fieldOf("DeviceName", 0, setup.hardware.device ?? unknown),
    fieldOf("AndroidVersion", 0, setup.hardware.android ?? unknown), fieldOf("Baseband", 0, setup.hardware.baseband),
  ]
}

/** On the phone: Alpha's `AlphaCarrierSetup` plugin. */
export const phoneCarrierSetup = Layer.succeed(CarrierSetup, {
  read: () => Effect.map(Effect.option(Effect.flatMap(tryPromise(() => plugin().read()), Schema.decodeUnknownEffect(SetupSchema))), Option.map((setup): Identifiers => ({
    fields: fieldsOf(setup),
    esim: setup.eid.status === "not-read" || setup.eid.status === "available" || setup.subscriptions.items.some((sim) => sim.embedded),
    smsChoice: setup.canChooseSms,
  }))),
  readEid: () => Effect.map(Effect.option(Effect.flatMap(tryPromise(() => plugin().readEid()), Schema.decodeUnknownEffect(ReportedSchema))), (eid) => (Option.isSome(eid) ? fieldOf("Imei", 0, eid.value) : fieldOf("Imei", -1, { status: "not-read" }))),
  copy: (text: string) => Effect.map(Effect.option(tryPromise(() => copied(text))), Option.isSome),
})

/** A browser has no carrier to read. */
export const browserCarrierSetup = Layer.succeed(CarrierSetup, {
  read: () => succeed(Option.none<Identifiers>()),
  readEid: () => succeed(fieldOf("Imei", -1, { status: "not-read" })),
  copy: () => succeed(false),
})
