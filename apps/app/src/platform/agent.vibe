// spec/kit/read.md, "Story: Read from outside"; spec/app/account/index.md, "Story: Have the agent running"; spec/app/platform/index.md, "Story: Talk to the resident agent"; spec/app/platform/index.md, "A request or stream Alpha stops waiting for is withdrawn from the phone, and may still have reached the agent"; spec/app/platform/feed.md, "Story: Follow what my agent does on my screen"
import { type RuntimeJsonBridge, type RuntimeRequestHeaders, type RuntimeStatus, type RuntimeStreamFrame, RuntimeRequestError, createRuntimeJsonClient } from "@elizaos/agent/client"
import { BridgeUnavailable } from "@elizaos/os/bridges/bridge"
import type { AgentEvent, AgentMethod, AgentRecoveryArchive, AgentRecoveryReview, AgentRoute, AgentStatus, AgentStreamData, AgentStreamEnd, AgentTopic, ElizaAgentPlugin } from "@elizaos/os/bridges/definitions/agent"
import { chunkTaken, deliveryOf, replied } from "../../gen/app__platform.effect.vibe"
import { Machine as Feed, type FrameKind, machine as feedMachine } from "../../gen/app__platform__feed.effect.vibe"
import { fresh } from "../runtime/attempts.vibe"
import { type Failure, type Listening, type Opened, type Remote, type Wired, Unreachable, Unsent, parsed, patience, refusal, remoteAt, sse } from "./remote.vibe"

module held {
  import { agentClient } from "@elizaos/os/bridges/agent"

  let made: ReturnType<typeof agentClient> | undefined
  /** eliza's client of the plugin, made once: Capacitor registers a plugin a single time for the life of the page. @throws {never} */
  export function client(): ReturnType<typeof agentClient> {
    return (made ??= agentClient())
  }
}
import { client } from held

/**
 * eliza's own client of its agent: `request(path, body?)` and `stream(path, body, signal?)`, which wait for an agent
 * that is starting. It is what eliza's `TurnController`, `readReplyStream`, `TaskLifecycle` and surface client of
 * `@elizaos/agent/client` take as their transport, so an area that talks to the agent in eliza's own protocol passes
 * it to them and restates none of their wire shapes.
 */
export type Runtime = ReturnType<typeof createRuntimeJsonClient>

/**
 * The resident agent's HTTP and event-stream API: eliza's agent. Areas read its routes with `ask(Agent, …)`,
 * `listen(Agent, …)` and `attempted(Agent, …)` of remote.vibe, and hand `runtime` to eliza's own clients.
 */
export interface Reached extends Remote {
  readonly runtime: Runtime
  /**
   * The agent's live events of `topic` for this page, as eliza's agent sends them: `view` the steps it takes on the
   * screen whose client id is `clientId`, each step's frame, and `voice` each transcript event, until the reader stops.
   * Nothing is replayed; a page that is no phone hears no feed.
   */
  feed(topic: AgentTopic, clientId?: string): Stream.Stream<unknown, Unsent>
  /** The agent as the phone's host runs it, which the account area starts, stops and brings back after a failure. */
  readonly life: Life
  /** This phone as a device the agent enrolled: what each request of eliza's client carries, and when a turn ended. */
  readonly device: Enrolled
}

/**
 * The phone's enrollment as eliza's client carries it: once the phone has enrolled, every request names it, so the
 * agent's turns may propose what the phone can do. `turned` says each time a message posted to a conversation has had
 * its whole answer, however it ended, so that the proposals of that turn are read.
 */
export interface Enrolled {
  carry(headers: RuntimeRequestHeaders): void
  readonly turned: Stream.Stream<void>
}

/**
 * The agent the phone runs, as eliza's agent service reports and controls it: its status and each change of it,
 * starting and stopping it, and the records a start that failed kept for the owner's review, archived on the token
 * that review gave. A page that is no phone reaches an agent it cannot start or stop: it reads that agent's health,
 * and refuses the rest unsent.
 */
export interface Life {
  status(): AgentStatus!(Unsent | Unreachable)
  /** Each status the host reports from now on, until the reader stops. */
  readonly changes: Stream.Stream<AgentStatus, Unsent>
  start(): AgentStatus!(Unsent | Unreachable)
  stop(): AgentStatus!(Unsent | Unreachable)
  review(): AgentRecoveryReview!(Unsent | Unreachable)
  archive(reviewToken: string): AgentRecoveryArchive!(Unsent | Unreachable)
}

export service Agent: Reached {}

/**
 * `schema`, where what it decodes is exactly eliza's exported type `Wire`: a variant or a field eliza adds, removes
 * or changes stops Alpha compiling, at the commit of eliza.lock.json, and not on a phone. Use it for every answer of
 * the agent or the cloud whose type eliza exports and whose schema it does not.
 */
export function wire<Wire>() {
  return <A extends Wire>(schema: Schema.Decoder<A> & ([Wire] extends [A] ? unknown : never)): Schema.Decoder<A> => schema
}

/** How long eliza's client waits for a stopped agent to run, between two looks at it, and for one answer. */
const waits = { startupTimeoutMs: 30_000, pollMs: 250, requestTimeoutMs: 10_000 }

schema Health { readonly ready: boolean }

function located(request: HttpClientRequest.HttpClientRequest): string {
  const query = UrlParams.toString(request.urlParams)
  return query === "" ? request.url : `${request.url}?${query}`
}

/** The JSON `request` carries, or nothing where it carries none; a body that is not JSON cannot be relayed. */
effect function carried(request: HttpClientRequest.HttpClientRequest): Option.Option<unknown>!Unsent {
  if (request.body._tag === "Empty") return Option.none()
  if (request.body._tag !== "Uint8Array") throw new Unsent({ cause: "only a JSON body is relayed" })
  return Option.some(parsed(new TextDecoder().decode(request.body.body)) catch effect (cause) => { throw new Unsent({ cause }) })
}

/** The headers `request` names, but those of its body: what eliza's client admits or refuses by its own rule. */
function named(request: HttpClientRequest.HttpClientRequest): RuntimeRequestHeaders {
  return Object.fromEntries(Object.entries(request.headers).filter(([name]) => name !== "content-type" && name !== "content-length"))
}

interface Plain { readonly path: string; readonly body?: unknown; readonly headers: RuntimeRequestHeaders }

/** `request` as eliza's client takes one, a path, a JSON body or none, and the headers it names: it carries only GET, and POST with a body. */
effect function plain(request: HttpClientRequest.HttpClientRequest): Option.Option<Plain>!! {
  const headers = named(request)
  if (request.method === "GET") return request.body._tag === "Empty" ? Option.some({ path: located(request), headers }) : Option.none()
  if (request.method !== "POST") return Option.none()
  const body = carried(request) catch () => Option.none<unknown>()
  return Option.map(body, (json) => ({ path: located(request), body: json, headers }))
}

/** What eliza's client refuses before it sends anything: a path or a header it does not admit. */
const refusedByTheClient = ["InvalidPath", "InvalidHeaders"]

module aborting {
  /** Once `signal` is aborted. @throws {never} */
  export function abortedBy(signal: AbortSignal | undefined): Promise<void> {
    if (signal === undefined) return new Promise<void>(() => {})
    if (signal.aborted) return Promise.resolve()
    return new Promise<void>((resolve) => signal.addEventListener("abort", () => resolve(), { once: true }))
  }
}
import { abortedBy } from aborting

/** One answer as eliza's client reads a stream: its head, each chunk, and how it ended, or nothing more once `signal` is aborted. */
function framed(opened: Opened!(Unsent | Unreachable)!Scope.Scope, signal?: AbortSignal): AsyncIterable<RuntimeStreamFrame> {
  const frames = Stream.unwrap(effect {
    const { status, headers, body } = try opened
    const head: RuntimeStreamFrame = { kind: "head", status, headers }
    return Stream.succeed(head)
      |> Stream.concat(%, Stream.map(body, (data): RuntimeStreamFrame => ({ kind: "chunk", data })))
      |> Stream.concat(%, Stream.succeed<RuntimeStreamFrame>({ kind: "end" }))
  })
  const withdrawn = promise(() => abortedBy(signal))
  return Stream.toAsyncIterable(Stream.interruptWhen(Stream.catch(frames, () => Stream.succeed<RuntimeStreamFrame>({ kind: "error" })), withdrawn))
}

module turning {
  /** Whether `path` posts a message to a conversation: a turn of the agent's. @throws {never} */
  export function isTurn(path: string): boolean {
    const [, api, conversations, id, messages, stream, ...rest] = path.split("?")[0].split("/")
    return api === "api" && conversations === "conversations" && id !== "" && id !== "messages" && messages === "messages" && (stream === undefined || stream === "stream") && rest.length === 0
  }

  /** `body` as it is read, saying `ended` once, when the reader finishes it, stops reading or it fails. @throws {never} */
  export function endingWith(body: AsyncIterable<Uint8Array>, ended: () => void): AsyncIterable<Uint8Array> {
    let said = false
    const once = () => {
      if (said) return
      said = true
      ended()
    }
    return {
      [Symbol.asyncIterator]() {
        const chunks = body[Symbol.asyncIterator]()
        return {
          async next() {
            const step = await chunks.next().catch((cause: unknown) => {
              once()
              throw cause
            })
            if (step.done === true) once()
            return step
          },
          async return() {
            once()
            return (await chunks.return?.()) ?? { done: true, value: undefined }
          },
        }
      },
    }
  }
}
import { endingWith, isTurn } from turning

const posted = (input: { readonly path: string; readonly body?: unknown }) =>
  input.body === undefined ? HttpClientRequest.post(input.path) : HttpClientRequest.bodyJsonUnsafe(HttpClientRequest.post(input.path), input.body)

/** `request` naming `headers`, which eliza's client admitted. */
const naming = (request: HttpClientRequest.HttpClientRequest, headers: RuntimeRequestHeaders | undefined) =>
  headers === undefined ? request : HttpClientRequest.setHeaders(request, headers)

/**
 * eliza's bridge to an agent that `direct` reaches over HTTP: it is running once its health route says it is ready,
 * and nothing on this side can start it.
 */
function httpBridge(direct: Wired): RuntimeJsonBridge {
  const status = (): Promise<RuntimeStatus> => runPromise(effect {
    return effect {
      const health = try Schema.decodeUnknownEffect(Health)(try direct.call(HttpClientRequest.get("/api/health")))
      return { available: true, state: health.ready ? "running" as const : "starting" as const }
    } catch () => ({ available: true, state: "starting" as const })
  })
  return {
    status,
    start: status,
    restart: status,
    request: (input) => runPromise(effect {
      const { status: answered, text: whole } = try direct.open(naming(input.method === "GET" ? HttpClientRequest.get(input.path) : posted(input), input.headers))
      const text = try timeout(whole, patience)
      return { status: answered, data: parsed(text) catch () => null }
    }),
    requestStream: (input, signal) => framed(direct.open(naming(posted(input), input.headers)), signal),
  }
}

/**
 * The agent through eliza's own runtime client over `bridge`, which waits for an agent that is starting and tells a
 * refusal from a failure. Every request that client cannot carry (a method other than GET and POST, a header, a
 * stream that is not a POST) goes to `direct`.
 */
function over(bridge: RuntimeJsonBridge, direct: Remote, feed: Reached["feed"], life: Life): Reached {
  const client = createRuntimeJsonClient({ bridge: () => bridge, ...waits })
  const turns = Effect.runSync(PubSub.unbounded<void>())
  const ended = () => { Effect.runFork(PubSub.publish(turns, undefined)) }
  let device: RuntimeRequestHeaders = {}
  const runtime: Runtime = {
    request: (path, body, headers) => {
      const answer = client.request(path, body, { ...device, ...headers })
      if (body !== undefined && isTurn(path)) void answer.then(ended, ended)
      return answer
    },
    stream: async (path, body, signal, headers) => {
      const opened = await client.stream(path, body, signal, { ...device, ...headers })
      return isTurn(path) ? { ...opened, body: endingWith(opened.body, ended) } : opened
    },
    refreshNativeAccount: () => client.refreshNativeAccount(),
    get requestBodyLimit() { return client.requestBodyLimit },
  }
  return {
    runtime,
    feed,
    life,
    device: { carry: (headers) => { device = headers }, turned: Stream.fromPubSub(turns) },
    effect call(request: HttpClientRequest.HttpClientRequest): unknown!Failure {
      const sent = try plain(request)
      if (Option.isNone(sent)) return try direct.call(request)
      return try tryPromise({
        try: () => runtime.request(sent.value.path, sent.value.body, sent.value.headers),
        catch: (cause): Failure => cause instanceof RuntimeRequestError ? refusal(cause.status, cause.retryAfter)
          : cause instanceof Error && refusedByTheClient.includes(cause.message) ? new Unsent({ cause })
          : new Unreachable({ cause }),
      })
    },
    events: (request: HttpClientRequest.HttpClientRequest, listening?: Listening) => direct.events(request, listening),
  }
}

/** A page that is no phone: the agent's feeds reach only the phone's own page. */
const unfed = (topic: AgentTopic) => Stream.fail(new Unsent({ cause: `no ${topic} feed reaches a page that is no phone` }))

/** The agent a page that is no phone reaches: running once its health route says it is ready, and started or stopped by nothing on this side. */
function reachedOnly(direct: Wired): Life {
  const refused = (what: string) => Effect.fail(new Unsent({ cause: `a page that is no phone cannot ${what} the agent` }))
  effect function status(): AgentStatus!(Unsent | Unreachable) {
    const ready = effect {
      return (try Schema.decodeUnknownEffect(Health)(try direct.call(HttpClientRequest.get("/api/health")))).ready
    } catch () => false
    return { available: true, state: ready ? "running" : "starting", epoch: 0, requestBodyLimit: 0 }
  }
  return {
    status,
    changes: Stream.empty,
    start: () => refused("start"),
    stop: () => refused("stop"),
    review: () => succeed<AgentRecoveryReview>({ kind: "unavailable" }),
    archive: () => succeed<AgentRecoveryArchive>({ kind: "unavailable" }),
  }
}

/** The agent over HTTP at `base`: in a browser the page's own `/agent`, which the dev server answers, adding the token the page never holds. */
export function agentAt(base: string) {
  return Layer.effect(Agent, effect {
    const direct = try remoteAt(base)
    return over(httpBridge(direct), direct, unfed, reachedOnly(direct))
  })
}

/** The codes `ElizaAgent` rejects a call with before it reaches the agent (`AgentPlugin.java`, `ChannelPolicy.FailCode`): the rest may have reached it. */
const unsent = ["RouteRefused", "TooLarge", "IdInUse", "TopicInUse", "Busy", "NotReady"]

function undelivered(cause: unknown): Unsent | Unreachable {
  const code = typeof cause === "object" && cause !== null && "code" in cause ? cause.code : undefined
  return cause instanceof BridgeUnavailable || (typeof code === "string" && unsent.includes(code)) ? new Unsent({ cause }) : new Unreachable({ cause })
}

const methods: ReadonlyArray<string> = ["GET", "POST", "PUT", "PATCH", "DELETE"] satisfies ReadonlyArray<AgentMethod>

/** `request` as the plugin reads one: a method, a path with its query, the headers it names, which the plugin's channel admits or refuses, and a JSON object or no body. */
effect function relayed(request: HttpClientRequest.HttpClientRequest): AgentRoute!Unsent {
  if (!methods.includes(request.method)) throw new Unsent({ cause: `the phone relays no ${request.method}` })
  const body = try carried(request)
  const headers = named(request)
  const route: AgentRoute = { method: request.method as AgentMethod, path: located(request), ...(Object.keys(headers).length === 0 ? {} : { headers }) }
  if (Option.isNone(body)) return route
  if (typeof body.value !== "object" || body.value === null || Array.isArray(body.value)) throw new Unsent({ cause: "only a JSON object is relayed" })
  return { ...route, body: body.value as Record<string, unknown> }
}

module web {
  /** @throws {never} */
  export function bytes(base64: string): Uint8Array {
    return Uint8Array.from(atob(base64), (one) => one.charCodeAt(0))
  }
}
import { bytes } from web

/**
 * One stream of the plugin as it arrives: `requestStream` under an id made here, heard as `streamData` and
 * `streamEnd`. The plugin keeps no event for a listener that comes late, so this hears first and asks second, and
 * aborts the stream when no one reads it any more.
 */
function streamed(plugin: ElizaAgentPlugin, route: AgentRoute): Stream.Stream<AgentStreamData | AgentStreamEnd, Unsent | Unreachable> {
  return Stream.callback<AgentStreamData | AgentStreamEnd, Unsent | Unreachable>((queue) => effect {
    const id = fresh()
    const heard = try tryPromise({
      try: () => Promise.all([
        plugin.addListener("streamData", (data) => { if (data.id === id) Queue.offerUnsafe(queue, data) }),
        plugin.addListener("streamEnd", (end) => {
          if (end.id !== id) return
          Queue.offerUnsafe(queue, end)
          Queue.endUnsafe(queue)
        }),
      ]),
      catch: undelivered,
    })
    try addFinalizer(() => ignore(tryPromise(async () => {
      await plugin.abort({ id })
      await Promise.all(heard.map((handle) => handle.remove()))
    })))
    try tryPromise({ try: () => plugin.requestStream({ ...route, id }), catch: undelivered })
  })
}

/**
 * The plugin's stream as one answer: its head, which comes first, and its chunks until it ends, two mebibytes at
 * most. A stream the plugin ended as `failed` before its head never reached the agent.
 */
effect function opened(plugin: ElizaAgentPlugin, route: AgentRoute): Opened!(Unsent | Unreachable)!Scope.Scope {
  const [first, rest] = try Stream.peel(streamed(plugin, route), Sink.head())
  const head = Option.getOrUndefined(first)
  if (head === undefined || !("status" in head)) {
    const ending = head?.kind === "failed" ? "RefusedByThePhone" : head?.kind === "aborted" ? "Withdrawn" : "Errored"
    if (deliveryOf(false, ending) === "NeverSent") throw new Unsent({ cause: head })
    throw new Unreachable({ cause: head ?? "the stream ended before its head" })
  }
  let held = 0
  const chunks = Stream.mapEffect(Stream.filter(rest, (frame) => frame.kind !== "end"), effect (frame): Uint8Array!Unreachable => {
    if (frame.kind !== "chunk") throw new Unreachable({ cause: frame })
    const chunk = bytes(frame.dataBase64)
    if (!chunkTaken(held, chunk.byteLength)) throw new Unreachable({ cause: "the answer grew past its limit" })
    held += chunk.byteLength
    return chunk
  })
  const body = Stream.mapError(chunks, (cause) => cause instanceof Unreachable ? cause : new Unreachable({ cause }))
  return { status: head.status, headers: head.headers, body, text: Stream.mkString(Stream.decodeText(body)) }
}

/** The plugin as a `Remote`, for what eliza's client does not carry. */
function plugged(plugin: ElizaAgentPlugin): Remote {
  return {
    effect call(request: HttpClientRequest.HttpClientRequest): unknown!Failure {
      const route = try relayed(request)
      const id = fresh()
      const asked = onInterrupt(tryPromise({ try: () => plugin.request({ ...route, id }), catch: undelivered }), () => ignore(tryPromise(() => plugin.abort({ id }))))
      const answered = timeout(asked, patience) catch effect (cause) => match (cause) {
        when Unsent: throw cause;
        default: throw new Unreachable({ cause });
      }
      if (!replied(answered.status)) throw refusal(answered.status, undefined)
      return answered.data
    },
    events(request: HttpClientRequest.HttpClientRequest, listening?: Listening) {
      return Stream.unwrap(effect {
        const { status, headers, body } = timeout(opened(plugin, try relayed(request)), patience) catch effect (cause) => match (cause) {
          when Unsent: throw cause;
          default: throw new Unreachable({ cause });
        }
        if (!replied(status)) throw refusal(status, headers["retry-after"])
        return sse(body, listening)
      })
    },
  }
}

/** The phone's agent as eliza's client knows one: stopped until it runs, and gone where it failed or the build has none. */
function statusOf(status: AgentStatus): RuntimeStatus {
  const state = status.state === "running" || status.state === "starting" ? status.state : "stopped"
  return { available: status.available && status.state !== "failed" && status.state !== "unavailable", state, requestBodyLimit: status.requestBodyLimit }
}

/** What eliza's client asks of a bridge, as the plugin reads it: the headers it admitted go with it. */
function routed(input: { readonly path: string; readonly method: "GET" | "POST"; readonly body?: unknown; readonly headers?: RuntimeRequestHeaders }): AgentRoute {
  return {
    method: input.method, path: input.path,
    ...(input.body === undefined ? {} : { body: input.body as Record<string, unknown> }),
    ...(input.headers === undefined || Object.keys(input.headers).length === 0 ? {} : { headers: input.headers }),
  }
}

/** eliza's bridge to the agent the phone runs, over eliza's own client of the `ElizaAgent` plugin, which decodes each answer. */
function pluginBridge(plugin: ElizaAgentPlugin): RuntimeJsonBridge {
  return {
    status: async () => statusOf(await plugin.getStatus()),
    start: async () => statusOf(await plugin.start()),
    restart: async () => statusOf(await plugin.restart()),
    request: (input) => plugin.request(routed(input)),
    requestStream: (input, signal) => framed(opened(plugin, routed(input)), signal),
  }
}

/** The agent the phone's host runs, through eliza's client of the `ElizaAgent` plugin. */
function hosted(plugin: ElizaAgentPlugin): Life {
  const asked = <A>(call: () => Promise<A>) => tryPromise({ try: call, catch: undelivered })
  return {
    status: () => asked(() => plugin.getStatus()),
    changes: Stream.callback<AgentStatus, Unsent>((queue) => effect {
      const listener = try tryPromise({ try: () => plugin.addListener("status", (status) => { Queue.offerUnsafe(queue, status) }), catch: (cause) => new Unsent({ cause }) })
      try addFinalizer(() => ignore(tryPromise(() => listener.remove())))
    }),
    start: () => asked(() => plugin.start()),
    stop: () => asked(() => plugin.stop()),
    review: () => asked(() => plugin.reviewRecovery()),
    archive: (reviewToken: string) => asked(() => plugin.archiveRecovery({ reviewToken })),
  }
}

schema ViewPayload { readonly clientId: string; readonly frame: Schema.Unknown }
/** A step the agent took on a screen, as eliza's agent publishes it on its `view` topic. */
schema ViewStep { readonly stream: "view-interact"; readonly payload: ViewPayload }
/** A transcript, as eliza's agent publishes it on its `voice` topic. */
schema Transcript { readonly stream: "voice-transcript" }

/** What one event of a feed of `topic` is for the screen `clientId` names: its kind, whether it is that screen's, and what the screen is given. */
function stepOf(topic: AgentTopic, clientId: string | undefined, event: Record<string, unknown>): { readonly kind: FrameKind; readonly forClient: boolean; readonly given: ReadonlyArray<unknown> } {
  if (topic === "view") {
    const step = Schema.decodeUnknownOption(ViewStep)(event)
    if (Option.isNone(step)) return { kind: "OtherFrame", forClient: false, given: [] }
    return { kind: "Step", forClient: step.value.payload.clientId === clientId, given: [step.value.payload.frame] }
  }
  return Option.isSome(Schema.decodeUnknownOption(Transcript)(event)) ? { kind: "Step", forClient: true, given: [event] } : { kind: "OtherFrame", forClient: false, given: [] }
}

type Heard = { readonly kind: "event"; readonly event: Record<string, unknown> } | { readonly kind: "end" }

/**
 * One live feed of the plugin under an id made here: the listener is registered first, the subscription asked for
 * once it is, and both are withdrawn when no one reads the feed any more. It ends where the phone ends it or refuses it.
 */
function fed(plugin: ElizaAgentPlugin, topic: AgentTopic, clientId: string | undefined): Stream.Stream<unknown, Unsent> {
  return Stream.unwrap(effect {
    provide feedMachine() {
      const feed = try Feed
      const id = fresh()
      const heard = Stream.callback<Heard>((queue) => effect {
        uninterruptible {
          const listener = tryPromise(() => plugin.addListener("agentEvent", (said: AgentEvent) => {
            if (said.id !== id) return
            Queue.offerUnsafe(queue, said.kind === "event" ? { kind: "event", event: said.event } : { kind: "end" })
          })) catch () => undefined
          feed.send({ type: "listenerResult", success: listener !== undefined }) catch () => undefined
          if (listener !== undefined) {
            try addFinalizer(() => effect {
              feed.send({ type: "close" }) catch () => undefined
              tryPromise(() => listener.remove()) catch () => undefined
              if ((try feed.get()).asked) tryPromise(() => plugin.unsubscribeEvents({ id })) catch () => undefined
            })
          }
        }
        if ((try feed.get()).phase !== "Subscribing") return Queue.endUnsafe(queue)
        const admitted = tryPromise(() => plugin.subscribeEvents({ id, topic, ...(clientId === undefined ? {} : { clientId }) })) catch () => undefined
        const after = feed.send({ type: "subscribeResult", success: admitted !== undefined, matching: admitted?.id === id }) catch () => undefined
        if (after?.phase !== "Ready") Queue.endUnsafe(queue)
      })
      effect function given(one: Heard): ReadonlyArray<unknown>!! {
        if (one.kind !== "event") return []
        const step = stepOf(topic, clientId, one.event)
        const after = feed.send({ type: "frame", ours: true, forClient: step.forClient, kind: step.kind }) catch () => undefined
        return after !== undefined && after.phase !== "Ended" && step.forClient ? step.given : []
      }
      return heard
        |> Stream.takeWhile(%, (one) => one.kind === "event")
        |> Stream.mapEffect(%, given)
        |> Stream.flatMap(%, (each) => Stream.fromIterable(each))
    }
  })
}

/**
 * The agent on the phone, through the `ElizaAgent` plugin of eliza's Android package, which holds the launch token
 * and checks each route against the host's list: eliza's `agentClient()` of `@elizaos/os/bridges/agent`.
 */
export const relayedAgent = Layer.sync(Agent, () => {
  const plugin = client()
  return over(pluginBridge(plugin), plugged(plugin), (topic: AgentTopic, clientId?: string) => fed(plugin, topic, clientId), hosted(plugin))
})
