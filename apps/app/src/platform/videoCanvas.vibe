// spec/app/photos/viewer.md, "Story: Edit a photo or trim a video"
module clips {
  import type { BrowserEditFrame } from "./photoCanvas.vibe"

  export type ClipTransform = { readonly start: number; readonly end: number; readonly turns: number; readonly crop: boolean }
  export type ClipSource = { readonly file: Blob; readonly duration: number; readonly width: number; readonly height: number }

  const bytesLimit = 104_857_600
  const maximumEdge = 1920
  const maximumDuration = 300
  const center = 1.3

  /** @throws {never} */
  export const clipRefusal = ({ file, duration, width, height }: ClipSource): "TooLarge" | "TooLong" | "NoEditor" | undefined =>
    file.size > bytesLimit || width * height > 32_000_000 ? "TooLarge" : duration > maximumDuration ? "TooLong" :
      typeof MediaRecorder === "undefined" || typeof AudioContext === "undefined" || typeof HTMLCanvasElement === "undefined" || typeof HTMLCanvasElement.prototype.captureStream !== "function" ? "NoEditor" : undefined

  function drawFrame(video: HTMLVideoElement, edit: ClipTransform) {
    const canvas = document.createElement("canvas")
    const divisor = edit.crop ? center : 1
    const width = video.videoWidth / divisor, height = video.videoHeight / divisor
    if (width < 1 || height < 1 || video.videoWidth * video.videoHeight > 32_000_000) throw new Error("Unsupported video dimensions.")
    const sideways = edit.turns % 2 === 1
    const scale = Math.min(1, maximumEdge / Math.max(width, height))
    canvas.width = Math.max(2, Math.round((sideways ? height : width) * scale / 2) * 2)
    canvas.height = Math.max(2, Math.round((sideways ? width : height) * scale / 2) * 2)
    const drawer = canvas.getContext("2d", { alpha: false })
    if (drawer === null) throw new Error("Video editing is unavailable.")
    const draw = () => {
      drawer.save()
      drawer.translate(canvas.width / 2, canvas.height / 2)
      drawer.rotate(edit.turns * Math.PI / 2)
      drawer.drawImage(video, (video.videoWidth - width) / 2, (video.videoHeight - height) / 2, width, height,
        -width * scale / 2, -height * scale / 2, width * scale, height * scale)
      drawer.restore()
    }
    draw()
    return { canvas, draw }
  }

  function waitFor(video: HTMLVideoElement, name: "loadeddata" | "seeked", start: () => void, signal: AbortSignal): Promise<void> {
    return new Promise((resolve, reject) => {
      const clean = () => {
        signal.removeEventListener("abort", aborted)
        video.removeEventListener(name, ready)
        video.removeEventListener("error", failed)
      }
      const ready = () => { clean(); resolve() }
      const failed = () => { clean(); reject(new Error("The video could not be decoded.")) }
      const aborted = () => { clean(); reject(signal.reason) }
      if (signal.aborted) { aborted(); return }
      signal.addEventListener("abort", aborted, { once: true })
      video.addEventListener(name, ready, { once: true })
      video.addEventListener("error", failed, { once: true })
      try { start() } catch (error) { clean(); reject(error) }
    })
  }

  function resume(audio: AudioContext, signal: AbortSignal): Promise<void> {
    return new Promise((resolve, reject) => {
      const aborted = () => reject(signal.reason)
      if (signal.aborted) { aborted(); return }
      signal.addEventListener("abort", aborted, { once: true })
      void audio.resume().then(resolve, reject).finally(() => signal.removeEventListener("abort", aborted))
    })
  }

  function record(video: HTMLVideoElement, stream: MediaStream, draw: () => void, edit: ClipTransform, signal: AbortSignal): Promise<{ file: Blob; duration: number }> {
    const recorder = new MediaRecorder(stream)
    return new Promise((resolve, reject) => {
      const chunks: Blob[] = []
      let bytes = 0, frame = 0, stopped = false, finished = false
      let reached = edit.start
      const cleanup = () => {
        if (typeof video.cancelVideoFrameCallback === "function") video.cancelVideoFrameCallback(frame)
        else cancelAnimationFrame(frame)
        video.pause()
        video.onended = null
        video.onerror = null
        recorder.ondataavailable = null
        recorder.onstop = null
        recorder.onerror = null
        signal.removeEventListener("abort", aborted)
      }
      const finish = (error?: unknown) => {
        if (finished) return
        finished = true
        cleanup()
        if (recorder.state !== "inactive") recorder.stop()
        const mime = (recorder.mimeType || chunks[0]?.type || "").split(";")[0] ?? ""
        if (error !== undefined) reject(error)
        else if (bytes === 0 || (mime !== "video/mp4" && mime !== "video/webm")) reject(new Error("The edited video could not be encoded."))
        else resolve({ file: new Blob(chunks, { type: mime }), duration: Math.max(.001, Math.min(edit.end, reached) - edit.start) })
      }
      const aborted = () => finish(signal.reason)
      const stop = () => {
        if (stopped) return
        stopped = true
        reached = video.currentTime
        video.pause()
        if (recorder.state !== "inactive") recorder.stop()
      }
      const next = () => {
        frame = typeof video.requestVideoFrameCallback === "function" ? video.requestVideoFrameCallback(paint) : requestAnimationFrame(paint)
      }
      const paint = () => {
        if (stopped || finished) return
        try {
          if (video.currentTime >= edit.end) { stop(); return }
          draw()
          next()
        } catch (error) { finish(error) }
      }
      recorder.ondataavailable = (event) => {
        bytes += event.data.size
        if (bytes > bytesLimit) { finish(new Error("The edited video exceeds 100 MB.")); return }
        if (event.data.size !== 0) chunks.push(event.data)
      }
      recorder.onstop = () => finish(stopped ? undefined : new Error("Video encoding stopped before the selected interval finished."))
      recorder.onerror = () => finish(new Error("Video encoding was interrupted."))
      video.onended = stop
      video.onerror = () => finish(new Error("Video playback was interrupted."))
      if (signal.aborted) { aborted(); return }
      signal.addEventListener("abort", aborted, { once: true })
      try {
        recorder.start(200)
        next()
        void video.play().catch(finish)
      } catch (error) { finish(error) }
    })
  }

  /** Decode, trim and encode locally while preserving the source audio. */
  export async function renderBrowserClip(source: ClipSource, edit: ClipTransform, cancellation: AbortSignal): Promise<BrowserEditFrame> {
    if (clipRefusal(source) !== undefined || ![edit.start, edit.end, source.duration].every(Number.isFinite) || edit.start < 0 || edit.end <= edit.start || edit.end > source.duration + .05 || ![0, 1, 2, 3].includes(edit.turns)) throw new Error("Choose a valid video range.")
    const signal = AbortSignal.any([cancellation, AbortSignal.timeout(Math.ceil((edit.end - edit.start) * 1000) + 30_000)])
    signal.throwIfAborted()
    const address = URL.createObjectURL(source.file)
    const video = document.createElement("video")
    let audio: AudioContext | undefined
    let stream: MediaStream | undefined
    try {
      video.src = address
      video.playsInline = true
      video.preload = "auto"
      const decoding = AbortSignal.any([signal, AbortSignal.timeout(15_000)])
      await waitFor(video, "loadeddata", () => video.load(), decoding)
      if (edit.start > 0) await waitFor(video, "seeked", () => { video.currentTime = edit.start }, decoding)
      const { canvas, draw } = drawFrame(video, edit)
      const still = document.createElement("canvas")
      const size = Math.min(1, 240 / Math.max(canvas.width, canvas.height))
      still.width = Math.max(1, Math.round(canvas.width * size))
      still.height = Math.max(1, Math.round(canvas.height * size))
      still.getContext("2d")?.drawImage(canvas, 0, 0, still.width, still.height)
      stream = canvas.captureStream(30)
      audio = new AudioContext()
      const destination = audio.createMediaStreamDestination()
      audio.createMediaElementSource(video).connect(destination)
      for (const track of destination.stream.getAudioTracks()) stream.addTrack(track)
      await resume(audio, decoding)
      const output = await record(video, stream, draw, edit, signal)
      return { ...output, width: canvas.width, height: canvas.height, thumbnail: still.toDataURL("image/jpeg", .78) }
    } finally {
      for (const track of stream?.getTracks() ?? []) track.stop()
      if (audio !== undefined) await audio.close().catch(() => undefined)
      video.pause()
      video.removeAttribute("src")
      video.load()
      URL.revokeObjectURL(address)
    }
  }
}
import { clipRefusal, renderBrowserClip, type ClipSource } from clips
export { clipRefusal, renderBrowserClip }
export type { ClipSource }
