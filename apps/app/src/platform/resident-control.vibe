// spec/platform/resident.md, "Story: Start my agent and keep it running"; spec/assistant/recovery.md, "Try again is offered while the resident is refused with nothing held, and starts it once per tap"; spec/platform/resident.md, "Story: Keep my agent with my current Cloud account"; spec/platform/resident.md, "A held start runs again only after the owner reviewed what the service kept and the service archived it"
import type { Resident as ResidentConnection } from "../../gen/platform__resident.ts"
import type { ResidentUnavailable } from "./resident.vibe"

/** The verified session a connection holds: its owner, its agent, its generation and the service launch it was verified under. */
export interface ResidentSession {
  readonly owner: string
  readonly agent: string
  readonly generation: number
  readonly epoch: number
}

/** What the renderer controls of its resident connection beyond requests: the session, account changes and stopping. */
export service ResidentControl {
  /** The connection as spec/platform/resident.md keeps it, then each change of it. */
  readonly changes: Stream.Stream<ResidentConnection>
  /** The verified session, where there is one. */
  session(): (ResidentSession | undefined)!!
  /** The owner's Cloud account changed: rebind the running agent under a new generation. */
  refreshAccount(): void!ResidentUnavailable
  /** Stops the agent and waits until the service confirms it stopped. */
  stop(): void!ResidentUnavailable
  /** Why the connection is refused, while it is. */
  refusal(): (StartRefusal | undefined)!!
  /** The owner's Try again: lets a refused agent with nothing held for review start again, and starts it; refused while a reviewable hold waits for the owner's review. */
  retry(): void!ResidentUnavailable
}

/** Why a start was refused: the resident did not verify the local owner, or it refused the start for another reason. */
export type StartRefusal = "OwnerUnverified" | "StartRefused"

/** What the agent service holds after a start it will not retry: a reviewable hold with its one-use token and how many interrupted requests it kept, or nothing to review. */
export type HeldRecovery =
  | { readonly reviewable: true; readonly reviewToken: string; readonly retainedCount: number }
  | { readonly reviewable: false }

/** The owner's guarded restart of an agent the service holds for review; nothing it kept is ever replayed. */
export service ResidentRecovery {
  /** Asks the service what it kept from the start it holds. */
  review(): HeldRecovery!!
  /** Archives what the owner reviewed under `reviewToken`, then starts the agent again; refused while nothing is held or the archive is not confirmed. */
  restart(reviewToken: string): void!ResidentUnavailable
}
