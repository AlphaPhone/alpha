// spec/app/settings/facts.md, "Story: See what the phone says"; spec/app/settings/android.md, "Story: Change what only Android can change"
import type { AndroidRoleStatus, DeviceSettingsStatus, NativeCrashEntry, SettingsHandoff, SystemFacts, SystemSettingsPage } from "@elizaos/os/bridges/definitions/system"
import type { LocationPermissionStatus } from "@elizaos/os/bridges/definitions/location"
import type { FilesAccess, StorageVolume } from "@elizaos/os/bridges/definitions/files"
import type { MirrorStatus } from "@elizaos/os/bridges/definitions/notices"
import type { LibraryScopeKind } from "@elizaos/os/bridges/definitions/media"
import type { Opened, Target } from "../../gen/app__settings__android.ts"
import type { Access, AccessGrant, Alert, Holder, Reading } from "../../gen/app__settings__facts.ts"
import type { Grant } from "../../gen/kit__permission.ts"
import { openCarrierSettings } from "./carrier.vibe"

module held {
  import { registerPlugin } from "@capacitor/core"
  import type { SystemClient } from "@elizaos/os/bridges/system"
  import { locationClient } from "@elizaos/os/bridges/location"
  import { wifiClient } from "@elizaos/os/bridges/wifi"
  import { filesClient } from "@elizaos/os/bridges/files"
  import { permittedPhotosClient } from "@elizaos/os/bridges/media"
  import { noticesClient } from "@elizaos/os/bridges/notices"

  interface SettingsHost {
    settingsFacts(): Promise<unknown>
    openSettings(input: { page: "screen-lock" | "all-files" }): Promise<{ status: "opened"; specific: boolean }>
  }

  let system: Promise<SystemClient> | undefined
  let location: ReturnType<typeof locationClient> | undefined
  let wifi: ReturnType<typeof wifiClient> | undefined
  let files: ReturnType<typeof filesClient> | undefined
  let photos: ReturnType<typeof permittedPhotosClient> | undefined
  let notices: ReturnType<typeof noticesClient> | undefined
  let host: SettingsHost | undefined
  /**
   * eliza's client of `ElizaSystem`, which its bridge makes as it loads: loaded at first use, once the phone's host is
   * up, since Capacitor binds a plugin to the platform it finds when the plugin is first registered.
   */
  export function systemOf(): Promise<SystemClient> {
    return (system ??= import("@elizaos/os/bridges/system").then((bridge) => bridge.System))
  }
  /** eliza's clients of the other plugins, each made once: Capacitor registers a plugin a single time for the life of the page. @throws {never} */
  export function locationOf(): ReturnType<typeof locationClient> {
    return (location ??= locationClient())
  }
  /** @throws {never} */
  export function wifiOf(): ReturnType<typeof wifiClient> {
    return (wifi ??= wifiClient())
  }
  /** @throws {never} */
  export function filesOf(): ReturnType<typeof filesClient> {
    return (files ??= filesClient())
  }
  /** @throws {never} */
  export function photosOf(): ReturnType<typeof permittedPhotosClient> {
    return (photos ??= permittedPhotosClient())
  }
  /** @throws {never} */
  export function noticesOf(): ReturnType<typeof noticesClient> {
    return (notices ??= noticesClient())
  }
  /** @throws {never} */
  export function hostOf(): SettingsHost {
    return (host ??= registerPlugin<SettingsHost>("AlphaDevice"))
  }
}
import { filesOf, hostOf, locationOf, noticesOf, photosOf, systemOf, wifiOf } from held

module web {
  /** The browser's own answer for `name`, or none where it has no such permission. */
  export async function asked(name: string): Promise<PermissionState | undefined> {
    if (typeof navigator === "undefined" || navigator.permissions === undefined) return undefined
    try {
      return (await navigator.permissions.query({ name: name as PermissionName })).state
    } catch {
      return undefined
    }
  }
}
import { asked } from web

/** What one reading of the phone found: each fact it could read with its value, each access it could read, and the roles. */
export interface PhoneReport {
  readonly readings: ReadonlyArray<Reading>
  readonly grants: ReadonlyArray<AccessGrant>
  readonly alerts: ReadonlyArray<Alert>
  readonly home: Holder
  readonly assistant: Holder
  readonly launcher: boolean
}

/** The phone's own settings, as Android reports them: its facts, its roles, its settings pages and the problem log it keeps. */
export service SystemSettings {
  /** What the phone reports now; what it could not read is left out, never guessed. */
  report(): PhoneReport!!
  /** Whether Android could check one permission under review. */
  access(access: Access): Option.Option<{ readonly grant: Grant; readonly on: boolean }>!!
  /** Android's dialog for the Home role; returns when it closes. Whether Alpha holds the role is read again, never taken from the dialog. */
  requestHome(): void!!
  /** Android's own page for `target`, for Alpha itself where the page is about Alpha. */
  open(target: Target, channel: string): Opened!!
  /** The problems the phone's log holds, each by its classes and reasons alone, or none where it could not be read. */
  problems(): Option.Option<ReadonlyArray<Problem>>!!
  /** Whether the phone cleared its problem log. */
  clearProblems(): boolean!!
}

/** One problem the phone recorded, by the fields a report may carry: when, where it came from, and its classes and reasons; never a message or a process name. */
export type Problem = Pick<NativeCrashEntry, "at" | "source" | "kind" | "errorClass" | "rootClass" | "reason" | "thread">

const problemOf = ({ at, source, kind, errorClass, rootClass, reason, thread }: NativeCrashEntry): Problem => ({ at, source, kind, errorClass, rootClass, reason, thread })

const empty: PhoneReport = { readings: [], grants: [], alerts: [], home: "NotAlpha", assistant: "NotAlpha", launcher: false }

function switched(facts: SystemFacts): ReadonlyArray<Reading> {
  const on = (value: boolean | undefined) => (value === undefined ? undefined : value ? "on" : "off")
  const read: ReadonlyArray<[Reading["fact"], string | undefined]> = [
    ["Wifi", on(facts.wifiEnabled ?? (facts.wifiActive === true ? true : undefined))],
    ["Bluetooth", on(facts.bluetoothEnabled)],
    ["MobileData", on(facts.mobileDataEnabled)],
    ["DeviceLocation", on(facts.locationEnabled)],
    ["Battery", facts.batteryPercent === undefined ? undefined : `${facts.batteryPercent}${facts.charging === true ? " charging" : ""}`],
    ["Sound", facts.interruptionFilter],
  ]
  return read.flatMap(([fact, value]) => (value === undefined ? [] : [{ fact, value }]))
}

function holderOf(roles: ReadonlyArray<AndroidRoleStatus>, name: AndroidRoleStatus["role"]): Holder {
  const role = roles.find((one) => one.role === name)
  if (role === undefined || !role.available) return "NoSuchRole"
  return role.held ? "Alpha" : role.holders.length > 0 ? "AnotherApp" : "NotAlpha"
}

function grantOf(state: PermissionState | LocationPermissionStatus["location"] | undefined, limited = false): Grant | undefined {
  if (state === undefined) return undefined
  return state === "granted" ? (limited ? "Limited" : "Granted") : state === "denied" ? "Denied" : "Unasked"
}

const settled = <A>(call: () => Promise<A>) => Effect.option(tryPromise(call))

/** The storage the primary volume reports, as used of total, only where Android reported a total and used is never above it. */
function storageOf(volumes: ReadonlyArray<StorageVolume> | undefined): Reading | undefined {
  const primary = volumes?.find((volume) => volume.primary)
  if (primary === undefined || primary.total <= 0 || primary.free < 0 || primary.free > primary.total) return undefined
  const gigabytes = (bytes: number) => `${Math.round(bytes / 1e8) / 10} GB`
  return { fact: "Storage", value: `${gigabytes(primary.total - primary.free)} of ${gigabytes(primary.total)}` }
}

function filesGrantOf(access: FilesAccess | undefined): Grant | undefined {
  return access === "granted" ? "Granted" : access === "denied" ? "Denied" : undefined
}

const HostFacts = Schema.Struct({
  androidRelease: Schema.optionalKey(Schema.NonEmptyString),
  permissions: Schema.optionalKey(Schema.Struct({
    Camera: Schema.optionalKey(Schema.Boolean),
    Microphone: Schema.optionalKey(Schema.Boolean),
    Calendar: Schema.optionalKey(Schema.Boolean),
  })),
})

const hostFacts = () => Effect.option(Effect.flatMap(tryPromise(() => hostOf().settingsFacts()), Schema.decodeUnknownEffect(HostFacts)))

function boolGrant(access: Access, allowed: boolean | undefined): AccessGrant[] {
  return allowed === undefined ? [] : [{ access, grant: allowed ? "Granted" : "Denied" }]
}

function photoGrant(scope: LibraryScopeKind): Grant {
  return scope === "full" ? "Granted" : scope === "denied" || scope === "owned" ? "Denied" : "Limited"
}

const streams: ReadonlyArray<[DeviceSettingsStatus["volumes"][number]["stream"], Reading["fact"]]> = [
  ["music", "MediaVolume"], ["ring", "RingVolume"], ["alarm", "AlarmVolume"],
]

function volumesOf(settings: DeviceSettingsStatus): ReadonlyArray<Reading> {
  return streams.flatMap(([stream, fact]) => {
    const volume = settings.volumes.find((one) => one.stream === stream)
    return volume === undefined || volume.max <= 0 || volume.current < 0 || volume.current > volume.max
      ? [] : [{ fact, value: `${Math.round(100 * volume.current / volume.max)}%` }]
  })
}

function mirrorWord(mirror: MirrorStatus): string {
  if (!mirror.enabled) return "off"
  if (mirror.paused) return "paused"
  if (!mirror.accessGranted) return "no access"
  return mirror.connected ? "on" : "waiting"
}

/** What the phone reports through its SDK plugins and Alpha's own build facts. */
effect function phoneReport(): PhoneReport!! {
  const [facts, status, build, located, stored, host, photo, delivery, deviceSettings, collection] = try.all [
    settled(async () => (await systemOf()).getSystemFacts()),
    settled(async () => (await systemOf()).getStatus()),
    settled(async () => (await systemOf()).getBuildInfo()),
    settled(() => locationOf().checkPermissions()),
    settled(() => filesOf().storageState()),
    hostFacts(),
    settled(() => photosOf().libraryAccess()),
    settled(() => noticesOf().delivery()),
    settled(async () => (await systemOf()).getDeviceSettings()),
    settled(() => noticesOf().mirrorStatus()),
  ]
  const settings = Option.getOrUndefined(host)
  const notices = Option.getOrUndefined(delivery)
  const alerts = notices?.channels.filter(({ id, name }) => id !== "" && name !== "").map(({ id, name, blocked, groupBlocked }) => ({ id, name, blocked: blocked || groupBlocked })) ?? []
  const allowedAlerts = notices !== undefined && notices.appEnabled && notices.permissionGranted
  const storage = Option.isSome(stored) ? storageOf(stored.value.volumes) : undefined
  const filesGrant = Option.isSome(stored) ? filesGrantOf(stored.value.access) : undefined
  const readings = [
    ...(Option.isSome(facts) ? switched(facts.value) : []),
    ...(Option.isSome(status) ? [{ fact: "Roles" as const, value: "" }] : []),
    ...(Option.isSome(build) && build.value.version !== "" ? [{ fact: "Versions" as const, value: build.value.version }] : []),
    ...(settings?.androidRelease === undefined ? [] : [{ fact: "AndroidVersion" as const, value: settings.androidRelease }]),
    ...(notices === undefined ? [] : [{ fact: "Alerts" as const, value: !allowedAlerts ? "off" : alerts.some(({ blocked }) => blocked) ? "some off" : "on" }]),
    ...(storage === undefined ? [] : [storage]),
  ]
  const location = Option.isSome(located) ? grantOf(located.value.location, located.value.accuracy === "approximate") : undefined
  const roles = Option.isSome(status) ? status.value.roles : []
  return {
    readings: [
      ...readings,
      ...(Option.isSome(deviceSettings) ? volumesOf(deviceSettings.value) : []),
      ...(Option.isSome(collection) ? [{ fact: "CollectionStatus" as const, value: mirrorWord(collection.value) }] : []),
    ],
    alerts,
    grants: [
      ...boolGrant("CameraAccess", settings?.permissions?.Camera),
      ...boolGrant("MicrophoneAccess", settings?.permissions?.Microphone),
      ...boolGrant("CalendarAccess", settings?.permissions?.Calendar),
      ...boolGrant("NotificationsAccess", notices === undefined ? undefined : allowedAlerts),
      ...(Option.isSome(photo) ? [{ access: "PhotosAccess" as const, grant: photoGrant(photo.value.scope) }] : []),
      ...(location === undefined ? [] : [{ access: "LocationAccess" as const, grant: location }]),
      ...(filesGrant === undefined ? [] : [{ access: "FilesAccess" as const, grant: filesGrant }]),
    ],
    home: Option.isSome(status) ? holderOf(roles, "home") : "NotAlpha",
    assistant: Option.isSome(status) ? holderOf(roles, "assistant") : "NotAlpha",
    launcher: Option.isSome(status) && Option.isSome(build) && build.value.launcher,
  }
}

const browserPermissions: Readonly<Partial<Record<Access, string>>> = { CameraAccess: "camera", MicrophoneAccess: "microphone", LocationAccess: "geolocation", NotificationsAccess: "notifications" }

const permission = (grant: Grant | undefined, on = true) => Option.map(Option.fromUndefinedOr(grant), (value) => ({ grant: value, on }))

effect function phoneAccess(access: Access) {
  switch (access) {
    case "LocationAccess": {
      const [located, facts] = try.all [settled(() => locationOf().checkPermissions()), settled(async () => (await systemOf()).getSystemFacts())]
      return Option.flatMap(located, (status) => permission(grantOf(status.location, status.accuracy === "approximate"), Option.getOrUndefined(facts)?.locationEnabled !== false))
    }
    case "PhotosAccess": return Option.map(try settled(() => photosOf().libraryAccess()), (status) => ({ grant: photoGrant(status.scope), on: true }))
    case "FilesAccess": return Option.flatMap(try settled(() => filesOf().storageState()), (status) => permission(filesGrantOf(status.access)))
    case "NotificationsAccess": return Option.map(try settled(() => noticesOf().delivery()), (status) => ({ grant: status.permissionGranted ? "Granted" as const : "Denied" as const, on: status.appEnabled }))
    default: {
      const permissions = Option.getOrUndefined(try hostFacts())?.permissions
      const seen = access === "CameraAccess" ? permissions?.Camera : access === "MicrophoneAccess" ? permissions?.Microphone : permissions?.Calendar
      return permission(seen === undefined ? undefined : seen ? "Granted" : "Denied")
    }
  }
}

effect function browserAccess(access: Access) {
  const name = browserPermissions[access]
  return name === undefined ? Option.none<{ readonly grant: Grant; readonly on: boolean }>() : permission(grantOf(try promise(() => asked(name))))
}

/** What a browser reports: no facts of a phone, and the browser's own answer for each access it knows. */
effect function browserReport(): PhoneReport!! {
  const grants: AccessGrant[] = []
  for (const access of ["CameraAccess", "MicrophoneAccess", "LocationAccess", "NotificationsAccess"] as const) {
    const seen = try browserAccess(access)
    if (Option.isSome(seen)) grants.push({ access, grant: seen.value.grant })
  }
  return { ...empty, grants }
}

/** Android's pages for each target, as eliza's client opens them; a target eliza has no page for opens none. */
const pages: Readonly<Partial<Record<Target, SystemSettingsPage>>> = {
  AccountsSync: "accounts", WifiNetworks: "wifi", BluetoothDevices: "bluetooth", MobileNetworks: "mobile", AirplaneMode: "airplane",
  DefaultApps: "default-apps", DisplaySettings: "display", Brightness: "display", SoundSettings: "sound", DoNotDisturb: "dnd",
  BatterySaver: "battery", AlphaAlerts: "notifications", AppPermissions: "privacy", LocationSettings: "location", AboutPhone: "about", DeveloperOptions: "developer",
}

function openedOf(handoff: Pick<SettingsHandoff, "outcome" | "specific">): Opened {
  return handoff.outcome !== "Opened" ? "NotAtAll" : handoff.specific ? "Exactly" : "Nearby"
}

effect function opening(target: Target, channel: string): Opened!! {
  return effect {
    if (target === "SimCards" || target === "AccessPointNames") {
      const opened = try openCarrierSettings(target === "SimCards" ? "sim" : "apn")
      return opened === "exact" ? "Exactly" : opened === "nearby" ? "Nearby" : "NotAtAll"
    }
    if (target === "ScreenLock" || target === "AllFilesAccess") {
      const reply = try tryPromise(() => hostOf().openSettings({ page: target === "ScreenLock" ? "screen-lock" : "all-files" }))
      return reply.status === "opened" ? reply.specific ? "Exactly" : "Nearby" : "NotAtAll"
    }
    if (target === "AlertChannel") {
      try tryPromise(() => noticesOf().openChannelSettings(channel))
      return "Exactly"
    }
    if (target === "NotificationAccess") {
      try tryPromise(() => noticesOf().openNotificationAccess())
      return "Exactly"
    }
    if (target === "PhotoPermissions") {
      try tryPromise(() => photosOf().openLibrarySettings())
      return "Exactly"
    }
    if (target === "InternetPanel") return (try tryPromise(() => wifiOf().openInternetPanel())) === "Opened" ? "Exactly" : "NotAtAll"
    const system = try tryPromise(() => systemOf())
    if (target === "AndroidHome") return openedOf(try tryPromise(() => system.openSettings()))
    const page = target === "WorkflowAlerts" ? "notifications" : pages[target]
    return page === undefined ? "NotAtAll" : openedOf(try tryPromise(() => system.openSettingsPage({ page })))
  } catch () => "NotAtAll"
}

/** The phone, through eliza's clients of its plugins. */
export const phoneSystemSettings = Layer.succeed(SystemSettings, {
  report: phoneReport,
  access: phoneAccess,
  requestHome: () => ignore(tryPromise(async () => (await systemOf()).requestRole({ role: "home" }))),
  open: opening,
  problems: () => Effect.map(settled(async () => (await systemOf()).crashLog()), Option.map((log) => log.entries.map(problemOf))),
  clearProblems: () => Effect.map(settled(async () => (await systemOf()).clearCrashLog()), Option.isSome),
})

/** A browser: none of the phone's facts, roles, pages or log. */
export const browserSystemSettings = Layer.succeed(SystemSettings, {
  report: browserReport,
  access: browserAccess,
  requestHome: () => Effect.void,
  open: () => succeed<Opened>("NotAtAll"),
  problems: () => succeed(Option.none<ReadonlyArray<Problem>>()),
  clearProblems: () => succeed(false),
})
