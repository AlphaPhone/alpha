// spec/app/settings/facts.md, "Story: See what the phone says"; spec/app/settings/android.md, "Story: Change what only Android can change"
import type { AndroidRoleStatus, SettingsHandoff, SystemFacts, SystemSettingsPage } from "@elizaos/os/bridges/definitions/system"
import type { LocationPermissionStatus } from "@elizaos/os/bridges/definitions/location"
import type { FilesAccess, StorageVolume } from "@elizaos/os/bridges/definitions/files"
import type { Opened, Target } from "../../gen/app__settings__android.ts"
import type { Access, AccessGrant, Holder, Reading } from "../../gen/app__settings__facts.ts"
import type { Grant } from "../../gen/kit__permission.ts"

module held {
  import { systemClient } from "@elizaos/os/bridges/system"
  import { locationClient } from "@elizaos/os/bridges/location"
  import { wifiClient } from "@elizaos/os/bridges/wifi"
  import { filesClient } from "@elizaos/os/bridges/files"

  let system: ReturnType<typeof systemClient> | undefined
  let location: ReturnType<typeof locationClient> | undefined
  let wifi: ReturnType<typeof wifiClient> | undefined
  let files: ReturnType<typeof filesClient> | undefined
  /** eliza's clients of the plugins, each made once: Capacitor registers a plugin a single time for the life of the page. @throws {never} */
  export function systemOf(): ReturnType<typeof systemClient> {
    return (system ??= systemClient())
  }
  /** @throws {never} */
  export function locationOf(): ReturnType<typeof locationClient> {
    return (location ??= locationClient())
  }
  /** @throws {never} */
  export function wifiOf(): ReturnType<typeof wifiClient> {
    return (wifi ??= wifiClient())
  }
  /** @throws {never} */
  export function filesOf(): ReturnType<typeof filesClient> {
    return (files ??= filesClient())
  }
}
import { filesOf, locationOf, systemOf, wifiOf } from held

module web {
  /** The browser's own answer for `name`, or none where it has no such permission. */
  export async function asked(name: string): Promise<PermissionState | undefined> {
    if (typeof navigator === "undefined" || navigator.permissions === undefined) return undefined
    try {
      return (await navigator.permissions.query({ name: name as PermissionName })).state
    } catch {
      return undefined
    }
  }
}
import { asked } from web

/** What one reading of the phone found: each fact it could read with its value, each access it could read, and the roles. */
export interface PhoneReport {
  readonly readings: ReadonlyArray<Reading>
  readonly grants: ReadonlyArray<AccessGrant>
  readonly home: Holder
  readonly assistant: Holder
  readonly launcher: boolean
}

/** The phone's own settings, as Android reports them: its facts, its roles, its settings pages and the problem log it keeps. */
export service SystemSettings {
  /** What the phone reports now; what it could not read is left out, never guessed. */
  report(): PhoneReport!!
  /** Android's dialog for the Home role; returns when it closes. Whether Alpha holds the role is read again, never taken from the dialog. */
  requestHome(): void!!
  /** Android's own page for `target`, for Alpha itself where the page is about Alpha. */
  open(target: Target, channel: number): Opened!!
  /** How many problems the phone's log holds, or none where it could not be read. */
  problems(): Option.Option<number>!!
  /** Whether the phone cleared its problem log. */
  clearProblems(): boolean!!
}

const empty: PhoneReport = { readings: [], grants: [], home: "NotAlpha", assistant: "NotAlpha", launcher: false }

function switched(facts: SystemFacts): ReadonlyArray<Reading> {
  const on = (value: boolean | undefined) => (value === undefined ? undefined : value ? "on" : "off")
  const read: ReadonlyArray<[Reading["fact"], string | undefined]> = [
    ["Wifi", on(facts.wifiEnabled ?? (facts.wifiActive === true ? true : undefined))],
    ["Bluetooth", on(facts.bluetoothEnabled)],
    ["MobileData", on(facts.mobileDataEnabled)],
    ["DeviceLocation", on(facts.locationEnabled)],
    ["Battery", facts.batteryPercent === undefined ? undefined : `${facts.batteryPercent}${facts.charging === true ? " charging" : ""}`],
    ["Sound", facts.interruptionFilter],
  ]
  return read.flatMap(([fact, value]) => (value === undefined ? [] : [{ fact, value }]))
}

function holderOf(roles: ReadonlyArray<AndroidRoleStatus>, name: AndroidRoleStatus["role"]): Holder {
  const role = roles.find((one) => one.role === name)
  if (role === undefined || !role.available) return "NoSuchRole"
  return role.held ? "Alpha" : role.holders.length > 0 ? "AnotherApp" : "NotAlpha"
}

function grantOf(state: PermissionState | LocationPermissionStatus["location"] | undefined, limited = false): Grant | undefined {
  if (state === undefined) return undefined
  return state === "granted" ? (limited ? "Limited" : "Granted") : state === "denied" ? "Denied" : "Unasked"
}

const settled = <A>(call: () => Promise<A>) => Effect.option(tryPromise(call))

/** The storage the primary volume reports, as used of total, only where Android reported a total and used is never above it. */
function storageOf(volumes: ReadonlyArray<StorageVolume> | undefined): Reading | undefined {
  const primary = volumes?.find((volume) => volume.primary)
  if (primary === undefined || primary.total <= 0 || primary.free < 0 || primary.free > primary.total) return undefined
  const gigabytes = (bytes: number) => `${Math.round(bytes / 1e8) / 10} GB`
  return { fact: "Storage", value: `${gigabytes(primary.total - primary.free)} of ${gigabytes(primary.total)}` }
}

function filesGrantOf(access: FilesAccess | undefined): Grant | undefined {
  return access === "granted" ? "Granted" : access === "denied" ? "Denied" : undefined
}

/** What the phone reports, through eliza's clients of `ElizaSystem` and `ElizaLocation`. */
effect function phoneReport(): PhoneReport!! {
  const system = systemOf()
  const facts = try settled(() => system.getSystemFacts())
  const status = try settled(() => system.getStatus())
  const build = try settled(() => system.getBuildInfo())
  const located = try settled(() => locationOf().checkPermissions())
  const stored = try settled(() => filesOf().storageState())
  const storage = Option.isSome(stored) ? storageOf(stored.value.volumes) : undefined
  const filesGrant = Option.isSome(stored) ? filesGrantOf(stored.value.access) : undefined
  const readings = [
    ...(Option.isSome(facts) ? switched(facts.value) : []),
    ...(Option.isSome(status) ? [{ fact: "Roles" as const, value: "" }] : []),
    ...(Option.isSome(build) ? [{ fact: "Versions" as const, value: build.value.version }] : []),
    ...(storage === undefined ? [] : [storage]),
  ]
  const location = Option.isSome(located) ? grantOf(located.value.location, located.value.accuracy === "approximate") : undefined
  const roles = Option.isSome(status) ? status.value.roles : []
  return {
    readings,
    grants: [
      ...(location === undefined ? [] : [{ access: "LocationAccess" as const, grant: location }]),
      ...(filesGrant === undefined ? [] : [{ access: "FilesAccess" as const, grant: filesGrant }]),
    ],
    home: Option.isSome(status) ? holderOf(roles, "home") : "NotAlpha",
    assistant: Option.isSome(status) ? holderOf(roles, "assistant") : "NotAlpha",
    launcher: Option.isSome(status) && Option.isSome(build) && build.value.launcher,
  }
}

/** What a browser reports: no facts of a phone, and the browser's own answer for each access it knows. */
effect function browserReport(): PhoneReport!! {
  const names: ReadonlyArray<[Access, string]> = [["CameraAccess", "camera"], ["MicrophoneAccess", "microphone"], ["LocationAccess", "geolocation"], ["NotificationsAccess", "notifications"]]
  const grants: AccessGrant[] = []
  for (const [access, name] of names) {
    const grant = grantOf(try promise(() => asked(name)))
    if (grant !== undefined) grants.push({ access, grant })
  }
  return { ...empty, grants }
}

/** Android's pages for each target, as eliza's client opens them; a target eliza has no page for opens none. */
const pages: Readonly<Partial<Record<Target, SystemSettingsPage>>> = {
  AccountsSync: "accounts", WifiNetworks: "wifi", BluetoothDevices: "bluetooth", MobileNetworks: "mobile", AirplaneMode: "airplane",
  DefaultApps: "default-apps", DisplaySettings: "display", Brightness: "display", SoundSettings: "sound", DoNotDisturb: "dnd",
  BatterySaver: "battery", NotificationAccess: "notifications", LocationSettings: "location", AboutPhone: "about", DeveloperOptions: "developer",
}

/** Alpha's own App info, which holds its alerts, permissions and access to photos and files. */
const alphasOwn: ReadonlyArray<Target> = ["AlphaAlerts", "WorkflowAlerts", "AppPermissions", "PhotoPermissions", "AllFilesAccess"]
const nearby: ReadonlyArray<Target> = ["MobileNetworks", "AirplaneMode", "DoNotDisturb"]

function openedOf(target: Target, handoff: Pick<SettingsHandoff, "outcome" | "specific">): Opened {
  if (handoff.outcome !== "Opened") return "NotAtAll"
  return handoff.specific || !nearby.includes(target) ? "Exactly" : "Nearby"
}

effect function opening(target: Target): Opened!! {
  const system = systemOf()
  const handed = effect {
    if (target === "AndroidHome") return try tryPromise(() => system.openSettings())
    if (target === "InternetPanel") return { outcome: try tryPromise(() => wifiOf().openInternetPanel()), specific: true }
    if (alphasOwn.includes(target)) {
      const { packageName } = try tryPromise(() => system.getStatus())
      const { outcome } = try tryPromise(() => system.openAppInfo({ packageName }))
      return { outcome, specific: true }
    }
    const page = pages[target]
    if (page === undefined) return { outcome: "Refused" as const, specific: false }
    return try tryPromise(() => system.openSettingsPage({ page }))
  } catch () => ({ outcome: "Refused" as const, specific: false })
  return openedOf(target, handed)
}

/** The phone, through eliza's clients of its plugins. */
export const phoneSystemSettings = Layer.succeed(SystemSettings, {
  report: phoneReport,
  requestHome: () => ignore(tryPromise(() => systemOf().requestRole({ role: "home" }))),
  open: (target: Target, _channel: number) => opening(target),
  problems: () => Effect.map(settled(() => systemOf().crashLog()), Option.map((log) => log.entries.length)),
  clearProblems: () => Effect.map(settled(() => systemOf().clearCrashLog()), Option.isSome),
})

/** A browser: none of the phone's facts, roles, pages or log. */
export const browserSystemSettings = Layer.succeed(SystemSettings, {
  report: browserReport,
  requestHome: () => Effect.void,
  open: () => succeed<Opened>("NotAtAll"),
  problems: () => succeed(Option.none<number>()),
  clearProblems: () => succeed(false),
})
