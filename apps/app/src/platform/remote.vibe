// spec/kit/read.md, "Story: Read from outside"; spec/kit/attempt.md, "A sent attempt ends as its own answer says, or as unknown when no answer can be trusted"; spec/app/platform/index.md, "A refusal carries a wait only when the other side answered 429 with a whole number of seconds, at most a day"; spec/app/platform/index.md, "Only a 2xx answer is the reply; every other status is a refusal"; spec/app/platform/index.md, "A refusal carries the time the other side named for its allowance to come back, and a reader takes it only while it lies ahead"
import * as Sse from "effect/encoding/Sse"
import { replied, resetAhead, waitAdvised } from "../../gen/app__platform.effect.vibe"
import { Attempts } from "../runtime/attempts.vibe"

/** The request provably never left Alpha: its route is not one the phone relays, or the bridge was busy or is not there. */
export error Unsent { cause: unknown }
/** The other side could not be reached, did not answer in time, or stopped mid-answer: it may have acted. */
export error Unreachable { cause: unknown }
/**
 * The other side answered with a status other than 2xx, how many seconds it asked Alpha to wait, where it asked, the
 * reason it named, where Alpha reads one, and when it said its allowance comes back, in epoch milliseconds, where it
 * named that.
 */
export error Refused { status: number; wait?: number; reason?: string; resetAt?: number }

module web {
  /** An instant `named` as epoch milliseconds or an ISO instant, as a whole number of milliseconds, where it is one. @throws {never} */
  function instantOf(named: unknown): number | undefined {
    const at = typeof named === "number" ? named : typeof named === "string" && named.trim() !== "" ? Date.parse(named) : Number.NaN
    return Number.isSafeInteger(at) && at > 0 ? at : undefined
  }
  /** The `resetAt` a refusal's body names at its top or under its `error`. @throws {never} */
  export function resetNamed(body: string | undefined): number | undefined {
    if (body === undefined || body === "") return undefined
    let read: unknown
    try {
      read = JSON.parse(body)
    } catch {
      return undefined
    }
    if (typeof read !== "object" || read === null) return undefined
    const error = (read as { error?: unknown }).error
    return instantOf((read as { resetAt?: unknown }).resetAt) ?? (typeof error === "object" && error !== null ? instantOf((error as { resetAt?: unknown }).resetAt) : undefined)
  }
}
import { resetNamed } from web

/**
 * The refusal of `status`, with the wait `said` gave where the platform's rule takes it: a `Retry-After` of whole
 * seconds, or seconds already read; with the `reason` the other side named, where it named one; and the reset its
 * `body` names, where it names one.
 */
export function refusal(status: number, said: string | number | undefined, reason?: string, body?: string): Refused {
  const seconds = typeof said === "number" ? said : said !== undefined && /^\d+$/.test(said.trim()) ? Number(said.trim()) : undefined
  const wait = seconds !== undefined && waitAdvised(status, Number.isSafeInteger(seconds), seconds) ? { wait: seconds } : {}
  const resetAt = resetNamed(body)
  return new Refused({ status, ...wait, ...(reason === undefined ? {} : { reason }), ...(resetAt === undefined ? {} : { resetAt }) })
}

/** When the allowance `refused` names comes back, where that is still after `now`. */
export function resetOf(refused: Refused, now: number): number | undefined {
  return refused.resetAt !== undefined && resetAhead(true, refused.resetAt, now) ? refused.resetAt : undefined
}

/** The other side answered 2xx with something that is not what was asked for. */
export error Garbled { cause: unknown }

export type Failure = Unsent | Unreachable | Refused | Garbled

/** What a listener asks of a stream beside its request. */
export interface Listening {
  /**
   * How long the stream may say nothing before it counts as unreachable. Give it for a stream that is an answer, such
   * as a reply being written. A feed has none: eliza's streams send no heartbeat, so a quiet feed and a dead one look alike.
   */
  readonly quiet?: Duration.Input
}

/** An HTTP service outside Alpha, such as the resident agent or the cloud. What it answers is untrusted until `ask` or `listen` has decoded it. */
export interface Remote {
  /** The JSON body of the answer to `request`: the whole of it within `patience`. */
  call(request: HttpClientRequest.HttpClientRequest): unknown!Failure
  /** The JSON data of each Server-Sent Event the answer to `request` streams: its head within `patience`. */
  events(request: HttpClientRequest.HttpClientRequest, listening?: Listening): Stream.Stream<unknown, Failure>
}

/** How long Alpha waits for an answer before the other side counts as unreachable. */
export const patience = "10 seconds"

/** How a write outside ended, as the kit's `A::conclude(attempt, confirmed, known)` takes it. */
export interface Outcome {
  readonly confirmed: boolean
  readonly known: boolean
}

/** The statuses that say the other side understood the request and did not do it. Every other one leaves it unknown: a 5xx, a timeout or a throttle can follow a write that took effect. */
const declined = [400, 401, 402, 403, 404, 405, 406, 409, 410, 411, 412, 413, 414, 415, 416, 417, 422, 426, 428, 431, 451]

/**
 * How a write that failed ended. It is known not to have happened only where it never left, or the other side said
 * it declined; an answer that came back 2xx and unreadable is a write that happened.
 */
export function outcomeOf(failure: Failure): Outcome {
  return match (failure) {
    when Unsent: { confirmed: false, known: true };
    when Refused: { confirmed: false, known: declined.includes(failure.status) };
    when Garbled: { confirmed: true, known: true };
    when Unreachable: { confirmed: false, known: false };
  }
}

/** `text` as JSON, untrusted; an empty body is `undefined`. */
export effect function parsed(text: string): unknown!Garbled {
  if (text === "") return undefined
  return try Effect.try({ try: (): unknown => JSON.parse(text), catch: (cause) => new Garbled({ cause }) })
}

/** The JSON data of each Server-Sent Event in `bytes`, which counts as unreachable once it has said nothing for `listening.quiet`. */
export function sse(bytes: Stream.Stream<Uint8Array, Failure>, listening: Listening = {}): Stream.Stream<unknown, Failure> {
  const heard = listening.quiet === undefined
    ? bytes
    : Stream.timeoutOrElse(bytes, { duration: listening.quiet, orElse: () => Stream.fail(new Unreachable({ cause: "the stream went quiet" })) })
  return heard
    |> Stream.decodeText(%)
    |> Stream.pipeThroughChannel(%, Sse.decode())
    |> Stream.mapError(%, (cause): Failure => match (cause) {
      when Unsent: cause;
      when Unreachable: cause;
      when Refused: cause;
      when Garbled: cause;
      default: new Unreachable({ cause });
    })
    |> Stream.mapEffect(%, (event) => parsed(event.data))
}

/** One answer of an HTTP service as it arrives: its head, and its body as it is written. */
export interface Opened {
  readonly status: number
  readonly headers: Readonly<Record<string, string>>
  /** The body as it is written, for a stream. */
  readonly body: Stream.Stream<Uint8Array, Unreachable>
  /** The whole body as text, which is empty where the answer has none. */
  readonly text: string!Unreachable
}

/** An HTTP service as a `Remote`, and each answer as it arrives, for a client that reads the bytes itself. */
export interface Wired extends Remote {
  /** The answer to `request`, whatever its status: its head within `patience`. */
  open(request: HttpClientRequest.HttpClientRequest): Opened!Unreachable
}

/** The service at `base`, reached through whatever `HttpClient` the platform gives: fetch in a browser, a fake in tests. */
export effect function remoteAt(base: string): Wired!!HttpClient.HttpClient {
  const client = HttpClient.mapRequest(try HttpClient.HttpClient, HttpClientRequest.prependUrl(base))
  effect function open(request: HttpClientRequest.HttpClientRequest): Opened!Unreachable {
    const response = timeout(client.execute(request), patience) catch effect (cause) => { throw new Unreachable({ cause }) }
    return {
      status: response.status, headers: response.headers,
      body: Stream.mapError(response.stream, (cause) => new Unreachable({ cause })),
      text: mapError(response.text, (cause) => new Unreachable({ cause })),
    }
  }
  effect function answered(request: HttpClientRequest.HttpClientRequest): Opened!(Unreachable | Refused) {
    const opened = try open(request)
    if (!replied(opened.status)) throw refusal(opened.status, opened.headers["retry-after"], undefined, try (opened.text |> timeout(%, patience) |> Effect.orElseSucceed(%, () => "")))
    return opened
  }
  return {
    open,
    effect call(request: HttpClientRequest.HttpClientRequest) {
      const whole = effect { return try (try answered(request)).text }
      const text = timeout(whole, patience) catch effect (cause) => match (cause) {
        when Refused: throw cause;
        default: throw new Unreachable({ cause });
      }
      return try parsed(text)
    },
    events(request: HttpClientRequest.HttpClientRequest, listening?: Listening) {
      return Stream.unwrap(effect { return sse((try answered(request)).body, listening) })
    },
  }
}

/** What `remote` answers to `request`, decoded by `schema`, which the asking area owns. */
export effect function ask<I, A>(remote: Context.Key<I, Remote>, request: HttpClientRequest.HttpClientRequest, schema: Schema.Decoder<A>): A!Failure!I {
  const body = try (try remote).call(request)
  return Schema.decodeUnknownEffect(schema)(body) catch effect (cause) => { throw new Garbled({ cause }) }
}

/** Each event `remote` streams in answer to `request`, decoded by `schema`, which the listening area owns. */
export function listen<I, A>(remote: Context.Key<I, Remote>, request: HttpClientRequest.HttpClientRequest, schema: Schema.Decoder<A>, listening?: Listening): Stream.Stream<A, Failure, I> {
  return Stream.unwrap(effect {
    const events = (try remote).events(request, listening)
    return Stream.mapEffect(events, (data) => Schema.decodeUnknownEffect(schema)(data) |> Effect.mapError(%, (cause) => new Garbled({ cause })))
  })
}

/**
 * Carry out the kit attempt `id` of the machine whose job this is: `request` to `remote`, once, under that attempt's
 * idempotency key, and how it ended. Every attempt of every area goes through here, so no area decides for itself
 * what a status means or what its key is.
 */
export effect function attempted<I>(remote: Context.Key<I, Remote>, request: HttpClientRequest.HttpClientRequest, id: number): Outcome!!(I | Attempts) {
  const key = try (try Attempts).key(id)
  return effect {
    try (try remote).call(HttpClientRequest.setHeader(request, "idempotency-key", key))
    return { confirmed: true, known: true }
  } catch (failure) => outcomeOf(failure)
}

/**
 * Carry out the kit attempt `id` as `attempted` does, where the request itself names the attempt's idempotency key, as
 * eliza's calendar routes ask in their body or query: `build` makes it from the key, and no header carries it. Beside
 * how it ended, the answer's body, untrusted, where it came, and the reason a refusal named, where it named one.
 */
export effect function attemptedWith<I>(remote: Context.Key<I, Remote>, build: (key: string) => HttpClientRequest.HttpClientRequest, id: number): (Outcome & { readonly body: unknown; readonly reason?: string })!!(I | Attempts) {
  const key = try (try Attempts).key(id)
  return effect {
    const body = try (try remote).call(build(key))
    return { confirmed: true, known: true, body }
  } catch (failure) => ({ ...outcomeOf(failure), body: undefined, ...(failure._tag === "Refused" && failure.reason !== undefined ? { reason: failure.reason } : {}) })
}
