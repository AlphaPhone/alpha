// spec/kit/read.md, "Story: Read from outside"
import * as Sse from "effect/encoding/Sse"

/** The other side could not be reached, or did not answer in time. */
export error Unreachable { cause: unknown }
/** The other side answered with a status other than 2xx. */
export error Refused { status: number }
/** The other side answered with something that is not what was asked for. */
export error Garbled { cause: unknown }

export type Failure = Unreachable | Refused | Garbled

/** An HTTP service outside Alpha, such as the resident agent or the cloud. What it answers is untrusted until `ask` or `listen` has decoded it. */
export interface Remote {
  /** The JSON body of the answer to `request`. */
  call(request: HttpClientRequest.HttpClientRequest): unknown!Failure
  /** The JSON data of each Server-Sent Event the answer to `request` streams. */
  events(request: HttpClientRequest.HttpClientRequest): Stream.Stream<unknown, Failure>
}

/** How long Alpha waits for an answer before the other side counts as unreachable. */
const patience = "10 seconds"

function ok(status: number) {
  return status >= 200 && status < 300
}

/** `text` as JSON, untrusted; an empty body is `undefined`. */
export effect function parsed(text: string): unknown!Garbled {
  if (text === "") return undefined
  return try Effect.try({ try: (): unknown => JSON.parse(text), catch: (cause) => new Garbled({ cause }) })
}

/** The service at `base`, reached through whatever `HttpClient` the platform gives: fetch in a browser, a fake in tests. */
export effect function remoteAt(base: string): Remote!!HttpClient.HttpClient {
  const client = HttpClient.mapRequest(try HttpClient.HttpClient, HttpClientRequest.prependUrl(base))
  effect function answered(request: HttpClientRequest.HttpClientRequest): HttpClientResponse.HttpClientResponse!(Unreachable | Refused) {
    const response = client.execute(request) catch effect (cause) => { throw new Unreachable({ cause }) }
    if (!ok(response.status)) throw new Refused({ status: response.status })
    return response
  }
  return {
    effect call(request: HttpClientRequest.HttpClientRequest) {
      const response = timeout(answered(request), patience) catch effect (cause) => match (cause) {
        when Refused: throw cause;
        default: throw new Unreachable({ cause });
      }
      return try parsed(response.text catch effect (cause) => { throw new Unreachable({ cause }) })
    },
    events(request: HttpClientRequest.HttpClientRequest) {
      return Stream.unwrap(effect {
        const response = try answered(request)
        return response.stream
          |> Stream.decodeText(%)
          |> Stream.pipeThroughChannel(%, Sse.decode())
          |> Stream.mapError(%, (cause) => new Unreachable({ cause }))
          |> Stream.mapEffect(%, (event) => parsed(event.data))
      })
    },
  }
}

/** What `remote` answers to `request`, decoded by `schema`, which the asking area owns. */
export effect function ask<I, A>(remote: Context.Key<I, Remote>, request: HttpClientRequest.HttpClientRequest, schema: Schema.Decoder<A>): A!Failure!I {
  const body = try (try remote).call(request)
  return Schema.decodeUnknownEffect(schema)(body) catch effect (cause) => { throw new Garbled({ cause }) }
}

/** Each event `remote` streams in answer to `request`, decoded by `schema`, which the listening area owns. */
export function listen<I, A>(remote: Context.Key<I, Remote>, request: HttpClientRequest.HttpClientRequest, schema: Schema.Decoder<A>): Stream.Stream<A, Failure, I> {
  return Stream.unwrap(effect {
    const events = (try remote).events(request)
    return Stream.mapEffect(events, (data) => Schema.decodeUnknownEffect(schema)(data) |> Effect.mapError(%, (cause) => new Garbled({ cause })))
  })
}
