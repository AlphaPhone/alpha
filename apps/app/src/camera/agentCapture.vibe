// spec/camera/agentCapture.md, "Story: Let the assistant take the photo I asked for"; spec/camera/viewfinder.md, "Another flow borrows the shutter only over the ready, idle preview: the assistant's photo, a scanned frame or a document page"
import { Machine as CaptureMachine, covered, type Capture, type Event as CaptureEvent, type Wanted, type WriteResult } from "../../gen/camera__agentCapture.effect.vibe"
import type { Camera } from "../../gen/camera__viewfinder.effect.vibe"
import { CameraBridge, CameraFailed } from "./bridge.vibe"
import { photoReceiptId } from "./bridge.schema.vibe"
import { CameraHandoffs } from "./handoffs.vibe"
import { PHOTO_NOT_TAKEN, cameraText } from "./messages.vibe"
import { PhotoStore } from "./photos.vibe"
import { Viewfinder } from "./viewfinder.vibe"

/** The receipt a requested photo answers with; the library id only for an assistant that offered `camera.capture-library-id.v1`. */
export interface CameraReceipt {
  readonly version: 1
  readonly kind: "camera_capture_photo"
  readonly operationId: string
  readonly mediaId: string
  readonly width: number
  readonly height: number
  readonly mime: "image/jpeg"
  readonly libraryId?: string
}

/** What a requested photo did: succeeded with its receipt, failed before any shutter, or unknown after one. */
export interface CaptureAttempt {
  readonly status: "succeeded" | "failed" | "unknown"
  readonly summary: string
  readonly receipt?: CameraReceipt
  readonly cancelledBeforeCapture?: true
}

/** How the assistant's request reached the phone. */
export interface CaptureRequest {
  readonly operationId: string
  readonly lens?: "front" | "back"
  /** Approved on its card. */
  readonly reviewed: boolean
  /** The owner's own words for this message ask for a photo now. */
  readonly ownerWords: boolean
  readonly offersLibraryId: boolean
}

/** The assistant's one Camera operation. */
export service AgentCamera {
  /** A new owner message: it may carry one direct capture again. */
  newMessage(): void!!
  capture(request: CaptureRequest): CaptureAttempt!!
  readonly changes: Stream.Stream<Capture>
}

const wantedOf = (lens: "front" | "back" | undefined): Wanted => lens === "front" ? "WantFront" : lens === "back" ? "WantBack" : "AnyLens"
const PANEL_CLEARS = "350 millis"

/** The requested-photo service: the capture Machine mirrors the visible Camera and runs the request through its checks. */
export const agentCamera = Layer.effect(AgentCamera, effect {
  const machine = try CaptureMachine
  const viewfinder = try Viewfinder
  const bridge = try CameraBridge
  const store = try PhotoStore
  const handoffs = try CameraHandoffs
  let flipping = false

  effect function send(event: CaptureEvent) {
    return machine.send(event) catch () => undefined
  }

  effect function mirror(before: Camera, after: Camera) {
    if (before.visible && !after.visible) try send({ type: "ownerLeaves" })
    if (!before.visible && after.visible) try send({ type: "ownerReturns" })
    if (before.chat !== after.chat) {
      if (after.chat === "ChatHidden") try send({ type: "ownerClosesChat" })
      else try send({ type: "ownerCoversChat", panel: after.chat === "ChatFull" ? "FullChat" : "SheetChat" })
    }
    if (before.landscape !== after.landscape) try send({ type: "rotate" })
    if (before.phase !== "PreviewReady" && after.phase === "PreviewReady") try send({ type: "previewReady" })
    if (before.phase === "PreviewStarting" && after.phase === "PreviewOff") try send({ type: "previewFails" })
    if (before.phase === "PreviewReady" && after.phase === "PreviewOff") try send({ type: "chatGraceReleases" })
    if (before.recording === "RecordingIdle" && after.recording !== "RecordingIdle") try send({ type: "ownerStartsRecording" })
    if (before.recording !== "RecordingIdle" && after.recording === "RecordingIdle") try send({ type: "ownerStopsRecording" })
    if (before.lens !== after.lens && !flipping) try send({ type: "ownerFlips" })
  }

  let last = try viewfinder.get()
  try forkDetach(Stream.runForEach(viewfinder.changes, (now) => effect {
    try mirror(last, now)
    last = now
  }))

  effect function failed(summary: string, cancelled = false): CaptureAttempt!! {
    return cancelled ? { status: "failed", summary, cancelledBeforeCapture: true } : { status: "failed", summary }
  }

  effect function shoot(request: CaptureRequest): CaptureAttempt!! {
    const outcome = try viewfinder.borrow((epoch) => effect {
      const armed = try send({ type: "shutter" })
      if (armed === undefined) {
        try send({ type: "recheckFails" })
        return try failed(covered(try machine.get()) ? "Camera viewfinder is covered" : "The camera changed, so no photo was taken.")
      }
      const shot = try exit(bridge.capturePhoto({ saveToGallery: !bridge.browser, thumbnailOnly: !bridge.browser, quality: 85 }))
      if (!Exit.isSuccess(shot)) {
        const failure = Cause.squash(shot.cause)
        const code = failure instanceof CameraFailed ? failure.code : ""
        const before = PHOTO_NOT_TAKEN.has(code)
        try send({ type: "written", result: before ? "NotTaken" : "WriteThrew", wrote: false })
        return before ? try failed(cameraText(failure instanceof CameraFailed ? failure : {}, "The photo couldn’t be taken. Try again."))
          : { status: "unknown", summary: "Save unconfirmed" } as CaptureAttempt
      }
      const photo = shot.value
      const kept = bridge.browser && photo.base64 !== undefined
        ? (store.keepCapture(request.operationId, photo.base64) catch () => undefined)
        : undefined
      const mediaId = bridge.browser ? kept?.id : photoReceiptId(photo.path, false)
      if (mediaId === undefined) {
        try send({ type: "written", result: "SavedWithoutId", wrote: true })
        return { status: "unknown", summary: "Saved" } as CaptureAttempt
      }
      const result: WriteResult = "SavedWithId"
      const after = try send({ type: "written", result, wrote: true })
      const libraryId = after?.libraryIdShared === true ? (store.read(mediaId, false) catch () => undefined)?.id : undefined
      const receipt: CameraReceipt = {
        version: 1, kind: "camera_capture_photo", operationId: request.operationId, mediaId, width: Math.round(photo.width), height: Math.round(photo.height), mime: "image/jpeg",
        ...(libraryId === undefined ? {} : { libraryId }),
      }
      return { status: "succeeded", summary: "Saved", receipt } as CaptureAttempt
    })
    if (outcome.status === "done") return outcome.value
    try send({ type: "recheckFails" })
    return try failed(outcome.status === "closed" ? "Camera closed" : "Camera busy")
  }

  effect function run(request: CaptureRequest): CaptureAttempt!! {
    const before = try viewfinder.get()
    if (before.visible && before.recording !== "RecordingIdle") return try failed("Recording — no photo")
    const asked = try send({ type: "ask", wanted: wantedOf(request.lens), reviewed: request.reviewed, ownerWords: request.ownerWords, offersLibraryId: request.offersLibraryId })
    if (asked === undefined || asked.outcome === "Failed") {
      const scene = try viewfinder.get()
      return try failed(!scene.visible ? "Open Camera first" : scene.recording !== "RecordingIdle" ? "Recording — no photo" : asked === undefined ? "Camera busy" : "Camera busy")
    }
    try viewfinder.hold(true)
    if (asked.request === "Revealing") {
      if (asked.chat === "NoChat") try handoffs.hideConversation()
      try sleep(PANEL_CLEARS)
      try send({ type: "panelCleared" })
      const revealed = try send({ type: "revealed" })
      if (revealed === undefined) {
        try send({ type: "revealFails" })
        return try failed("Camera closed")
      }
    }
    if ((try machine.get()).request === "Queued") {
      const scene = try viewfinder.get()
      if (scene.phase === "PreviewOff") try viewfinder.retry()
      const settled = try viewfinder.settled()
      if (settled.phase === "PreviewReady") try send({ type: "previewReady" })
      else try send({ type: "previewFails" })
    }
    const armed = try machine.get()
    if (armed.request !== "Armed") return try failed("The screen changed before the photo. Ask again.")
    if (armed.refusedByRecording) {
      try send({ type: "recheckFails" })
      return try failed("Recording — no photo")
    }
    const scene = try viewfinder.get()
    if (scene.phase !== "PreviewReady") {
      try send({ type: "recheckFails" })
      return try failed(scene.notice === "CameraNotice" ? "Camera access is off. Allow camera access, then ask again." : "Camera unavailable")
    }
    if (request.lens !== undefined && (scene.lens === "FrontLens" ? "front" : "back") !== request.lens) {
      flipping = true
      const ok = try ensuring(viewfinder.flipTo(request.lens), sync(() => {
        flipping = false
      }))
      const flipped = try send({ type: "flipForRequest", ok })
      if (!ok || flipped === undefined || flipped.request !== "Armed") return try failed("Couldn’t switch camera, so no photo was taken.")
    }
    return try shoot(request)
  }

  return {
    effect newMessage() {
      try send({ type: "newMessage" })
    },
    effect capture(request: CaptureRequest) {
      return try ensuring(
        onInterrupt(run(request), () => effect {
          const now = try machine.get()
          if (now.request !== "Writing") try send({ type: "abort" })
        }),
        effect {
          const now = try machine.get()
          if (now.request === "Revealing") try send({ type: "revealFails" })
          else if (now.request === "Queued" || now.request === "Armed") try send({ type: "recheckFails" })
          try viewfinder.hold(false)
        },
      ) catch () => ({ status: "failed", summary: "The screen changed before the photo. Ask again." }) as CaptureAttempt
    },
    changes: machine.changes,
  }
})
