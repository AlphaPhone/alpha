// spec/camera/media.md, "Story: Ask Alpha about the photo I am looking at"; spec/camera/media.md, "Story: Send a photo only as a reviewed copy"; spec/camera/scanDialogs.md, "Story: Review the text I scanned before anything is saved"

/** A photo reviewed for the conversation that asked about it. */
export interface PhotoAttachment {
  readonly conversation: string
  readonly mediaId: string
  readonly revision: string
  readonly image: string
}

/** One frame and the owner's question, for the composer's own review. */
export interface FrameQuestion {
  readonly question: string
  readonly image: Blob
}

/** A Calendar form built from scanned text; Calendar's own review and Save stay the only write. */
export interface ScannedEvent {
  readonly creationId: string
  readonly title: string
  readonly date: string
  readonly time: string
  readonly minutes: number
  readonly allDay: boolean
  readonly location: string
  readonly notes: string
  readonly repeat: "none" | "daily" | "weekdays" | "weekly"
}

/** Exact reviewed bytes for a fresh email draft or a Messages picture. */
export interface ReviewedFile {
  readonly name: string
  readonly mimeType: string
  readonly size: number
  readonly sha256: string
  readonly dataBase64: string
}

/** Where Camera and Photos hand reviewed work to other areas; each area that receives it provides its port, and an unprovided port refuses. */
export service CameraHandoffs {
  /** The conversation the composer shows now, or "" with none. */
  conversation(): string!!
  /** Attach a reviewed photo to the conversation it was asked from; false when that conversation is no longer the composer's. */
  attachPhoto(attachment: PhotoAttachment): boolean!!
  /** Open the composer's review of a frame question. */
  askAboutFrame(question: FrameQuestion): boolean!!
  /** Save reviewed scanned text as a new note under `id`; true only once the note is committed. */
  saveScannedNote(text: string, id: string): boolean!!
  /** Open Calendar's form for a scanned event. */
  reviewScannedEvent(event: ScannedEvent): boolean!!
  /** Put a reviewed file into a fresh email draft; false when nothing was inserted. */
  emailFile(file: ReviewedFile): boolean!!
  /** Offer a reviewed picture to Messages; false when Messages is not on this image. */
  messagePicture(file: ReviewedFile): boolean!!
  /** Close a conversation that covers Camera's viewfinder, so the owner sees what a requested photo takes. */
  hideConversation(): void!!
  /** Open another app's screen, such as Photos after a capture. */
  open(app: "camera" | "photos" | "inbox" | "messages" | "calendar" | "notes" | "browser", route?: string): void!!
  static readonly defaultValue = () => ({
    conversation: () => succeed(""),
    attachPhoto: () => succeed(false),
    askAboutFrame: () => succeed(false),
    saveScannedNote: () => succeed(false),
    reviewScannedEvent: () => succeed(false),
    emailFile: () => succeed(false),
    messagePicture: () => succeed(false),
    hideConversation: () => succeed(undefined),
    open: () => succeed(undefined),
  })
}
