/** Alpha's sentence for a failed camera call: the sentence for its native code, else `fallback`. */
export function cameraText(failure: NativeFailed | NativeUnavailable | { readonly code?: string }, fallback: string): string {
  const code = "code" in failure ? failure.code : undefined
  return (code !== undefined && CAMERA_CAPTURE_CODES.get(code)) || fallback
}

/** Alpha's sentence for a Photos bridge refusal or result message, else `fallback`; the bridge's own words are never shown. */
export function photosText(message: string | undefined, fallback: string): string {
  return (message !== undefined && PHOTOS_MESSAGES.get(message.trim())) || fallback
}

/** The one line under a Camera access notice: why access is needed, or what went wrong, and the way on. */
export function accessDetail(kind: "CameraNotice" | "MicrophoneNotice" | "UnavailableNotice", browser: boolean): string {
  if (kind === "UnavailableNotice") return "The camera didn’t start. If another app is using it, close that app, then tap Retry."
  const allow = browser ? "Allow it for this page in your browser, then tap Retry" : "Tap Allow to turn it on in Settings"
  return kind === "CameraNotice"
    ? `Alpha needs camera access to take photos and videos. ${allow}.`
    : `Videos record sound with the microphone. ${allow}, or record without sound.`
}

function clock(seconds: number): string {
  const whole = Math.max(0, Math.floor(Number.isFinite(seconds) ? seconds : 0))
  return `${Math.floor(whole / 60)}:${String(whole % 60).padStart(2, "0")}`
}

const whole = (value: number) => Math.max(0, Math.floor(Number.isFinite(value) ? value : 0))

/** The recording timer: elapsed time, and the time left once the length or the estimated size limit is within a minute. */
export function recordingLabel(duration: number, fileSize: number, limits: { readonly maxDuration: number; readonly maxFileSize: number }): string {
  const elapsed = whole(duration), recorded = whole(fileSize)
  if (!showsTimeLeft(elapsed, recorded, limits.maxDuration, limits.maxFileSize)) return clock(elapsed)
  return `${clock(elapsed)} · ${clock(secondsLeft(elapsed, recorded, limits.maxDuration, limits.maxFileSize))} left`
}

/** Minutes and tenths for the trim timeline, rounded to tenths first so the seconds never read 60. */
export function videoClock(seconds: number): string {
  const tenths = Math.max(0, Math.round((Number.isFinite(seconds) ? seconds : 0) * 10))
  const minutes = Math.floor(tenths / 600), rest = tenths % 600
  return `${minutes}:${String(Math.floor(rest / 10)).padStart(2, "0")}.${rest % 10}`
}

/** "12 MB", "850 KB": a size for the viewer's details, empty when unknown. */
export function formatBytes(size: number | undefined): string {
  if (size === undefined || !Number.isFinite(size) || size <= 0) return ""
  const units = ["B", "KB", "MB", "GB"]
  let value = size, unit = 0
  while (value >= 1000 && unit < units.length - 1) {
    value /= 1000
    unit++
  }
  return `${value >= 10 || unit === 0 ? Math.round(value) : value.toFixed(1)} ${units[unit]}`
}

/** A readable local title for a scan PDF, without filename separators. */
export function scanExportTitle(kind: string, date: Date): string {
  return `Alpha ${kind} ${new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit" }).format(date).replaceAll(":", ".")}`
}
