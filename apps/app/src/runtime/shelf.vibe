// spec/app/shell/index.md, "Story: Move between Home and the apps"
import {
  type Shelf,
  createBoundedCache,
  createShelf,
} from "./store.ts"

export { type Shelf, createBoundedCache, createShelf }

/**
 * Provides a scoped `Shelf<T>` under `tag` whose state is created freshly for each runtime and automatically reset
 * when the runtime scope closes.
 */
export function scopedShelf<I, T>(tag: Context.Key<I, Shelf<T>>, initial: () => T): Layer.Layer<I> {
  return Layer.effect(tag, effect {
    const shelf = createShelf(initial(), { reset: initial })
    try Effect.addFinalizer(() => sync(() => { shelf.reset() }))
    return shelf
  })
}
