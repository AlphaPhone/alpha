// spec/app/shell/index.md, "Story: Move between Home and the apps"
import { type Whole, whole } from "./reactor.vibe"

/**
 * The root runtime of `layer`, the platform and the resident machines, from launch to exit, and the runtime of each
 * area over it. An area's runtime shares the root's services and its memory of what is built: a layer both name is
 * built once, so no machine is opened a second time. `over` builds an area's runtime closed over the root when its
 * screen is first loaded; `dispose` closes every area's runtime and then the root.
 */
export function rooted<R, E>(layer: Layer.Layer<R, E>) {
  const runtime = ManagedRuntime.make(layer)
  const context = Layer.effectContext(runtime.contextEffect)
  const areas: Array<ManagedRuntime.ManagedRuntime<never, unknown>> = []
  return {
    runtime,
    over<I, AE>(area: Layer.Layer<I, AE, R | I | Whole>): ManagedRuntime.ManagedRuntime<I | R, E | AE> {
      const made = ManagedRuntime.make(Layer.provideMerge(whole(area), context) as Layer.Layer<I | R, E | AE>, { memoMap: runtime.memoMap })
      areas.push(made)
      return made
    },
    dispose: (): Promise<void> => runPromise(effect {
      for (const area of areas.splice(0)) try area.disposeEffect
      try runtime.disposeEffect
    }),
  }
}
