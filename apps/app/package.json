{
  "name": "@alphacompute/alphaphone-app",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm -s tokens && vite --host 127.0.0.1",
    "start": "pnpm -s build && vite preview --host 127.0.0.1",
    "check": "node ../../vendor/eliza/vibestack/spec.ts check",
    "gen": "node ../../vendor/eliza/vibestack/spec.ts gen",
    "accept": "node ../../vendor/eliza/vibestack/spec.ts accept",
    "tokens": "node ../../vendor/eliza/vibestack/spec.ts tokens build",
    "stories": "node ../../vendor/eliza/vibestack/spec.ts stories gen --check",
    "storybook": "pnpm -s tokens && storybook dev --no-open",
    "build": "vibelang && pnpm -s tokens && vite build",
    "test": "pnpm -s tokens && pnpm -s stories && vitest run",
    "test:browser": "vitest run --project browser",
    "lint": "pnpm -s tokens && node ../../vendor/eliza/vibestack/spec.ts tokens check && eslint src/web",
    "typecheck": "vibelang --noEmit -p ."
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@effect/platform-browser": "4.1.1",
    "@elizaos/agent": "workspace:*",
    "@elizaos/cloud": "workspace:*",
    "@elizaos/core": "workspace:*",
