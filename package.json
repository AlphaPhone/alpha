{
  "name": "@alphacompute/alphaphone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@alphacompute/alphaphone-app",
    "check": "turbo run check --filter=@alphacompute/alphaphone-app",
    "gen": "turbo run gen --filter=@alphacompute/alphaphone-app",
    "build": "turbo run build --filter=@alphacompute/alphaphone-app && node scripts/write-build-flags.ts web-dist",
    "build:upstream": "node scripts/build-upstream.ts",
    "build:upstream:app-tests": "pnpm -s build:upstream @elizaos/plugin-maps",
    "build:test-mocks": "ELIZA_DEV_ALLOW_TEST_MOCKS=1 turbo run build --filter=@alphacompute/alphaphone-app && ELIZA_DEV_ALLOW_TEST_MOCKS=1 node scripts/write-build-flags.ts web-dist",
    "test": "pnpm -s build:upstream:app-tests && turbo run test --filter=@alphacompute/alphaphone-app --filter=@alphacompute/alpha-cloud",
    "test:root": "node --conditions=eliza-source --import vibelang/register scripts/run-root-tests.ts",
    "typecheck": "turbo run typecheck --filter=@alphacompute/alphaphone-app --filter=@alphacompute/alpha-cloud",
    "lint": "turbo run lint --filter=@alphacompute/alphaphone-app",
    "verify": "pnpm -s cloud:deployment:check && pnpm -s test:root && pnpm -s licenses:check && pnpm -s build:upstream:app-tests && turbo run check typecheck test lint --filter=@alphacompute/alphaphone-app --filter=@alphacompute/alpha-cloud && pnpm -s build && pnpm -s audit:bundle",
    "audit:bundle": "node scripts/audit-production-bundle.ts web-dist",
    "android:sync": "pnpm -s build && cap sync android && node scripts/android-gzip-assets.ts protect",
    "android:host": "node --conditions=eliza-source --import vibelang/register scripts/android-host.ts",
    "android:build": "node --conditions=eliza-source --import vibelang/register scripts/build-android.ts",
    "android:build:inputs": "node scripts/android-build-preflight.ts --report",
    "android:build:local": "node scripts/android-build-preflight.ts && pnpm -s agent:build-embedding-host && pnpm -s agent:build-workflow-worker && pnpm -s agent:bundle && pnpm -s agent:stage-android && pnpm -s licenses:packaged-runtime && pnpm -s android:build",
    "android:build:fast": "node --conditions=eliza-source --import vibelang/register scripts/build-android-fast.ts",
    "android:verify": "node --conditions=eliza-source --import vibelang/register scripts/verify-apks.ts",
    "android:deps:check": "node scripts/gradle-verification.ts --check",
    "android:deps:write-verification": "node scripts/gradle-verification.ts --write",
    "test:android:instrumentation": "node --conditions=eliza-source --import vibelang/register scripts/android-instrumentation.ts",
    "aosp:stage": "node --conditions=eliza-source --import vibelang/register scripts/stage-aosp.ts",
    "agent:bundle": "pnpm -s build:upstream @elizaos/os @elizaos/plugin-calendar && node --conditions=eliza-source --import vibelang/register scripts/build-agent-bundle.ts",
    "agent:build-workflow-worker": "node --conditions=eliza-source --import vibelang/register scripts/build-workflow-worker.ts",
    "agent:stage-android": "node --conditions=eliza-source --import vibelang/register scripts/stage-agent-runtime.ts",
    "agent:build-embedding-host": "node scripts/build-embedding-host.ts",
    "licenses:check": "node --conditions=eliza-source --import vibelang/register scripts/generate-licenses.ts --check",
    "licenses:packaged-runtime": "node scripts/generate-licenses.ts --packaged-runtime",
    "upstream:verify": "node --conditions=eliza-source --import vibelang/register scripts/verify-upstream.ts",
    "cloud:deployment": "pnpm --filter @alphacompute/alpha-cloud -s deployment",
    "cloud:deployment:check": "pnpm --filter @alphacompute/alpha-cloud -s deployment:check",
    "cloud:runtime-config": "pnpm --filter @alphacompute/alpha-cloud -s runtime-config",
    "cloud:worker": "node scripts/cloud-worker.ts",
    "cloud:local": "node scripts/local-cloud.ts",
    "dev:cloud": "node scripts/dev-cloud.ts",
    "test:browser": "pnpm -s build:upstream:app-tests && turbo run test:browser --filter=@alphacompute/alphaphone-app",
    "test:browser:production": "pnpm -s gen && playwright test --project=production",
    "test:browser:legacy": "playwright test --project=chromium"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@effect/platform-node": "4.1.1",
    "@elizaos/agent": "workspace:*",
    "@elizaos/os": "workspace:*",
    "@elizaos/plugin-browser": "workspace:*",
    "@elizaos/plugin-calendar": "workspace:*",
    "@elizaos/plugin-files": "workspace:*",
    "@elizaos/plugin-inbox": "workspace:*",
    "@elizaos/plugin-local-inference": "workspace:*",
    "@elizaos/plugin-maps": "workspace:*",
    "@elizaos/plugin-notes": "workspace:*",
    "@elizaos/plugin-personal-assistant": "workspace:*",
    "@elizaos/plugin-workflow": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/node": "catalog:",
    "effect": "4.1.1",
    "json5": "2.2.3",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vibelang": "0.0.13",
    "vibelang-runtime": "0.0.13",
    "vibestack": "workspace:*",
    "vite": "catalog:",
    "yaml": "2.9.1"
  }
}
