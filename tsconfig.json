{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "lib": ["es2024", "dom", "dom.iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "types": ["node"],
    "customConditions": ["eliza-source"]
  },
  "include": ["scripts/**/*.ts", "capacitor.config.ts", "playwright.config.ts"],
  "exclude": ["scripts/fixtures/**"]
}
