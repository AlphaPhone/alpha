<?xml version="1.0" encoding="utf-8"?>
<!-- Alpha's own wording and look for its password vault screens: the unlock prompt, the fill picker,
     the save prompt, the editor, a revealed password and the Autofill offer. Alpha's classes
     (PasswordFillActivity, PasswordSaveActivity, PasswordEditor, SecretSurfaces, PasswordUnlock,
     AlphaPasswordsPlugin) read only these names. eliza_passwords.xml points the shared module's
     names at them, so the shared Autofill service Alpha declares (its component name is the one
     Android keeps selected) offers Alpha's wording too. -->
<resources>
    <string name="alpha_passwords_service_label">Alpha Phone passwords</string>
    <string name="alpha_passwords_unlock_title">Unlock Alpha passwords</string>
    <string name="alpha_passwords_unlock_subtitle">Confirm it’s you to use the passwords saved in Alpha</string>
    <string name="alpha_passwords_fill_offer">Fill with a password saved in Alpha</string>
    <string name="alpha_passwords_fill_title">Choose a saved sign-in</string>
    <string name="alpha_passwords_fill_for">Sign-ins for %1$s</string>
    <string name="alpha_passwords_fill_none">Alpha has no sign-ins saved for %1$s</string>
    <string name="alpha_passwords_cancel">Cancel</string>
    <string name="alpha_passwords_save_title">Save this password in Alpha?</string>
    <string name="alpha_passwords_update_title">Update the saved password?</string>
    <string name="alpha_passwords_save">Save</string>
    <string name="alpha_passwords_not_now">Not now</string>
    <string name="alpha_passwords_saved">Password saved in Alpha</string>
    <string name="alpha_passwords_no_username">No username</string>
    <string name="alpha_passwords_hide">Hide</string>
    <string name="alpha_passwords_copied">Password copied. Alpha clears it from the clipboard shortly.</string>
    <string name="alpha_passwords_unavailable">Passwords aren’t available right now</string>
    <string name="alpha_passwords_no_screen_lock">Set a screen lock to use the passwords saved in Alpha</string>
    <string name="alpha_passwords_save_failed">The password wasn’t saved</string>
    <string name="alpha_passwords_editor_title">Add password</string>
    <string name="alpha_passwords_editor_edit_title">Edit password</string>
    <string name="alpha_passwords_editor_keep_password">Leave blank to keep the current password</string>
    <string name="alpha_passwords_editor_also_used">Also used for: %1$s</string>
    <string name="alpha_passwords_editor_changed">This password changed while you were editing. Reload to see the latest.</string>
    <string name="alpha_passwords_editor_changed_retry">A saved password changed. Tap Save to check again.</string>
    <string name="alpha_passwords_editor_gone">This password is no longer saved.</string>
    <string name="alpha_passwords_editor_reload">Reload</string>
    <string name="alpha_passwords_editor_same_title">This sign-in is already saved</string>
    <string name="alpha_passwords_editor_same_message">“%1$s” has the same website or app and username.</string>
    <string name="alpha_passwords_editor_update_existing">Update that one</string>
    <string name="alpha_passwords_editor_keep_separate">Keep both</string>
    <string name="alpha_passwords_editor_back">Back</string>
    <string name="alpha_passwords_editor_label">Name</string>
    <string name="alpha_passwords_editor_website">Website (exact HTTPS origin)</string>
    <string name="alpha_passwords_editor_username">Username</string>
    <string name="alpha_passwords_editor_password">Password</string>
    <string name="alpha_passwords_editor_generate">Generate password</string>
    <string name="alpha_passwords_editor_invalid">Check the fields. The website must be an exact HTTPS address with no path.</string>
    <string name="alpha_passwords_editor_too_long">Use %1$d characters or fewer. Nothing was entered.</string>

    <!-- Floating light/dark sheet for the fill picker and save prompt. -->
    <style name="AlphaPasswords.Theme.Dialog" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
        <item name="android:windowMinWidthMajor">60%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>
