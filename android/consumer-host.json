{
  "schema": 2,
  "installedIdentities": [
    {
      "appId": "ai.elizaresearch.alphaphone",
      "updateManifestUrl": "https://github.com/eliza-research/alphaphone/releases/download/app-stable/alpha-update-stable.json"
    }
  ],
  "description": "Alpha's Android host profile (schema 2). The upstream generator (@elizaos/os/build generateAndroidHost, vendor/eliza/packages/os) owns the Gradle setup, toolchain, variants, signing and version policy and writes the build files into android/ (node scripts/android-host.ts). This file supplies only Alpha's identity inputs, os modules, consumer modules, dependencies, admission and installed-data compatibility names. References use the consumer and dependencies (node_modules) roots; upstream native sources are named by os module.",
  "profile": {
    "schema": 2,
    "sdk": {
      "min": 29,
      "target": 36,
      "compile": 36
    },
    "releaseMinify": true,
    "kotlin": false,
    "nativeLibraries": "extract-16k",
    "manifest": {
      "root": "consumer",
      "path": "android/app/src/main/AndroidManifest.xml"
    },
    "flavors": [
      {
        "name": "launcher",
        "manifest": {
          "root": "consumer",
          "path": "android/app/src/launcher/AndroidManifest.xml"
        }
      }
    ],
    "osModules": [
      {
        "module": "agent-service"
      },
      {
        "module": "runtime-files"
      },
      {
        "module": "local-inference"
      },
      {
        "module": "sign-in"
      },
      {
        "module": "secure-store"
      },
      {
        "module": "system"
      },
      {
        "module": "camera"
      },
      {
        "module": "browser-surface"
      },
      {
        "module": "calendar"
      },
      {
        "module": "contacts"
      },
      {
        "module": "reminders"
      },
      {
        "module": "action-journal"
      },
      {
        "module": "notifications"
      },
      {
        "module": "messages"
      },
      {
        "module": "phone"
      },
      {
        "module": "passwords"
      },
      {
        "module": "media"
      },
      {
        "module": "filesystem"
      },
      {
        "module": "location"
      },
      {
        "module": "wifi"
      },
      {
        "module": "network-policy"
      }
    ],
    "modules": [
      {
        "name": "capacitor-android",
        "source": {
          "root": "dependencies",
          "path": "@capacitor/android/capacitor"
        }
      },
      {
        "name": "local-speech",
        "source": {
          "root": "consumer",
          "path": "android/local-speech"
        }
      },
      {
        "name": "sense",
        "source": {
          "root": "consumer",
          "path": "android/sense"
        },
        "appDependency": false
      },
      {
        "name": "sense-speech",
        "source": {
          "root": "consumer",
          "path": "android/sense-speech"
        },
        "appDependency": false
      },
      {
        "name": "notification-fixture",
        "source": {
          "root": "consumer",
          "path": "android/notification-fixture"
        },
        "appDependency": false
      },
      {
        "name": "video-fixture",
        "source": {
          "root": "consumer",
          "path": "android/video-fixture"
        },
        "appDependency": false
      }
    ],
    "dependencies": [
      {
        "configuration": "implementation",
        "coordinate": "androidx.credentials:credentials:1.6.0"
      },
      {
        "configuration": "implementation",
        "coordinate": "androidx.credentials:credentials-play-services-auth:1.6.0"
      },
      {
        "configuration": "implementation",
        "coordinate": "com.google.android.libraries.identity.googleid:googleid:1.1.1"
      },
      {
        "configuration": "implementation",
        "coordinate": "androidx.browser:browser:1.9.0"
      },
      {
        "configuration": "implementation",
        "coordinate": "com.squareup.okhttp3:okhttp:5.3.2"
      },
      {
        "configuration": "implementation",
        "coordinate": "androidx.media3:media3-transformer:1.11.1"
      },
      {
        "configuration": "implementation",
        "coordinate": "androidx.media3:media3-effect:1.11.1"
      },
      {
        "configuration": "implementation",
        "coordinate": "androidx.work:work-runtime:2.11.0"
      },
      {
        "configuration": "implementation",
        "module": "androidx.webkit:webkit",
        "toolchainVersion": "androidxWebkitVersion"
      },
      {
        "configuration": "implementation",
        "module": "androidx.appcompat:appcompat",
        "toolchainVersion": "androidxAppCompatVersion"
      },
      {
        "configuration": "implementation",
        "module": "androidx.core:core-splashscreen",
        "toolchainVersion": "coreSplashScreenVersion"
      },
      {
        "configuration": "androidTestImplementation",
        "coordinate": "androidx.test:runner:1.6.2"
      },
      {
        "configuration": "androidTestImplementation",
        "coordinate": "androidx.test.ext:junit:1.3.0"
      },
      {
        "configuration": "androidTestImplementation",
        "coordinate": "androidx.test.espresso:espresso-core:3.7.0"
      },
      {
        "configuration": "androidTestImplementation",
        "coordinate": "androidx.test.espresso:espresso-accessibility:3.7.0"
      },
      {
        "configuration": "androidTestImplementation",
        "coordinate": "androidx.test.uiautomator:uiautomator:2.3.0"
      },
      {
        "configuration": "testImplementation",
        "coordinate": "junit:junit:4.13.2"
      },
      {
        "configuration": "testImplementation",
        "coordinate": "org.robolectric:robolectric:4.16.1"
      }
    ],
    "androidResources": {
      "noCompress": [
        "gguf",
        "lex"
      ]
    },
    "buildConfigFields": [
      {
        "name": "AOSP_BUILD",
        "type": "boolean",
        "value": false
      },
      {
        "name": "ELIZA_CHROMIUM_PACKAGE_NAME",
        "type": "String",
        "value": ""
      },
      {
        "name": "ELIZA_CHROMIUM_CERT_SHA256",
        "type": "String",
        "value": ""
      }
    ],
    "buildTypes": {
      "release": {
        "abiFilters": [
          "arm64-v8a"
        ],
        "shrinkResources": true,
        "proguardFiles": [
          {
            "root": "consumer",
            "path": "android/app/proguard-rules.pro"
          }
        ]
      }
    },
    "signing": {
      "storeFile": "ELIZAOS_KEYSTORE_PATH",
      "storePassword": "ELIZAOS_KEYSTORE_PASSWORD",
      "keyAlias": "ELIZAOS_KEY_ALIAS",
      "keyPassword": "ELIZAOS_KEY_PASSWORD"
    },
    "versionOverride": {
      "versionCode": "ELIZAOS_VERSION_CODE",
      "versionName": "ELIZAOS_VERSION_NAME"
    },
    "admission": [
      {
        "name": "checkHostIdentity",
        "command": [
          "node",
          "scripts/android-host.ts",
          "--check-identity"
        ],
        "directory": {
          "root": "consumer",
          "path": "."
        }
      },
      {
        "name": "verifyCloudDeployment",
        "command": [
          "node",
          "--conditions=eliza-source",
          "--import",
          "vibelang/register",
          "cloud/src/cli.vibe",
          "deployment",
          "--check"
        ],
        "directory": {
          "root": "consumer",
          "path": "."
        }
      }
    ],
    "generatedSources": [
      {
        "sourceSet": "main",
        "kind": "java",
        "path": "generated/local-agent/java"
      }
    ],
    "assetFiles": [
      {
        "source": {
          "root": "consumer",
          "path": ".eliza/generated-android/owner-routes.json"
        },
        "name": "owner-routes.json"
      }
    ],
    "appScripts": [
      {
        "root": "consumer",
        "path": "android/app/product.gradle"
      }
    ],
    "agentService": {
      "notification": {
        "smallIcon": "notification_icon",
        "color": "0xff0000ff",
        "channel": "Alpha",
        "strings": {
          "channelName": "alpha_runtime_channel_name",
          "channelDescription": "alpha_runtime_channel_description",
          "title": "alpha_runtime_title",
          "running": "alpha_runtime_running",
          "starting": "alpha_runtime_starting",
          "stopped": "alpha_runtime_stopped",
          "assetError": "alpha_runtime_asset_error",
          "missingFiles": "alpha_runtime_missing_files",
          "spawnFailed": "alpha_runtime_spawn_failed",
          "restartBlocked": "alpha_runtime_restart_blocked",
          "runningDetail": "alpha_runtime_running_detail",
          "startingDetail": "alpha_runtime_starting_detail",
          "bootstrapDetail": "alpha_runtime_bootstrap_detail",
          "extractFailedDetail": "alpha_runtime_extract_failed_detail",
          "spawnFailedDetail": "alpha_runtime_spawn_failed_detail",
          "stopFailedDetail": "alpha_runtime_stop_failed_detail",
          "missingFilesDetail": "alpha_runtime_missing_files_detail",
          "genericDetail": "alpha_runtime_generic_detail"
        },
        "stopAction": false
      },
      "launchHook": {
        "class": "AlphaLocalAgentPlugin",
        "method": "configureEnvironment"
      }
    }
  },
  "residentSockets": {
    "agent": "ai.alphacompute.alphaphone.agent.v1",
    "inference": "ai.alphacompute.alphaphone.inference.v1",
    "secureStore": "ai.alphacompute.alphaphone.secure-store"
  }
}
