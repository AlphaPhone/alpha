# Alpha Cloud env file template: names only, no values.
#
# Copy it OUTSIDE the checkout, one per environment, and make it private:
#   mkdir -p ~/.config/alpha-cloud && cp cloud/alpha-cloud.env.example ~/.config/alpha-cloud/staging.env
#   chmod 600 ~/.config/alpha-cloud/staging.env
# Fill in the provider values below. Then run
#   bun run cloud:worker -- secrets --environment staging --env-file ~/.config/alpha-cloud/staging.env
# which adds every internal secret (Steward keys, JWT, entitlement signing key, CRON_SECRET, ...) once and
# reports anything still missing. The tool refuses a file inside the checkout or readable by others.
# Never commit a filled-in copy. docs/runbooks/alpha-cloud-deploy.md says where each value comes from.

# Databases (two separate Postgres databases)
DATABASE_URL=
STEWARD_DATABASE_URL=
# Filled after `database-identity` reports them and you have checked them (runbook step 4)
DATABASE_IDENTITY_EXPECTED_CLUSTER_SHA256=
DATABASE_IDENTITY_EXPECTED_AUTHORITY_SHA256=

# Redis REST (Upstash)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# AI inference and voice
CEREBRAS_API_KEY=
# optional:
OPENROUTER_API_KEY=
CARTESIA_API_KEY=
CARTESIA_STT_USD_PER_CREDIT=

# Sign-in email
RESEND_API_KEY=

# Google (sign-in, Gmail/Calendar connector, Maps)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# optional:
STEWARD_GOOGLE_NATIVE_CLIENT_IDS=
GOOGLE_MAPS_API_KEY=

# Stripe (test keys for staging, live keys for production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRODUCT_ID=
STRIPE_PLUS_MONTHLY_PRICE_ID=
STRIPE_PRO_PRODUCT_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
# optional:
STRIPE_PUBLISHABLE_KEY=

# Terms and Privacy shown on the in-app sign-in screen (one line of JSON each, at most 5120 bytes)
CLOUD_PUBLIC_SERVICE_TERMS_JSON=
CLOUD_PUBLIC_SERVICE_PRIVACY_JSON=
