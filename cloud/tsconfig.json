{
  "compilerOptions": {
    "target": "es2023",
    "jsx": "react-jsx",
    "module": "nodenext",
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "customConditions": ["eliza-source"],
    "rootDir": ".",
    "rootDirs": [".", ".vibe/declarations"],
    "plugins": [{
      "name": "@effect/language-service",
      "diagnosticSeverity": { "unstableApiUsage": "suggestion" }
    }]
  },
  "include": ["src", "test", "generated/*.ts", "*.config.ts"],
  "vibe": { "sidecarDir": ".vibe/declarations" }
}
