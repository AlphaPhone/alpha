  ensures (inv(m) ==> canGoBack(m) ==> stepYourLocationIsReused(m, "goBack", goBack(m).state, goBack(m).out))
  ensures (inv(m) ==> canGoBack(m) ==> stepSettingsOnlyAfterNo(m, goBack(m).state, goBack(m).out))
  ensures (inv(m) ==> canGoBack(m) ==> stepReturnGoesToTheEventMapsCameFrom(m, goBack(m).state, goBack(m).out))
  ensures (inv(m) ==> canGoBack(m) ==> stepTheRevisionChangesOnlyWithWhatIsShown(m, goBack(m).state))
  ensures (inv(m) ==> canGoBack(m) ==> stepTheAgentNeverMakesAndroidAsk(m, "goBack", goBack(m).state, goBack(m).out))
  ensures (inv(m) ==> canGoBack(m) ==> stepARerouteNeedsAFixThatGuides(m, "goBack", goBack(m).state))
