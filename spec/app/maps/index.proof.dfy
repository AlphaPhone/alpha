lemma namePlace_ensures(m: Maps, name: string)
  ensures (inv(m) ==> canNamePlace(m, name) ==> alwaysTheSheetFitsTheMode(namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> alwaysDirectionsAreForThePlace(namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> alwaysARouteBelongsToThePlace(namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> alwaysTheCardShowsARealPlace(namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> alwaysNavigationKeepsItsDirections(namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> alwaysResultsAnswerTheQuery(namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> alwaysSavedPlacesAreDistinctAndNamed(namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> alwaysRoutesNeedTheProvider(namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> alwaysGuidanceHoldsTheLocation(namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> alwaysFindingWaitsForGuidance(namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> alwaysAReadAnswersAQuestion(namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> alwaysAQuestionIsAboutWhatIsShown(namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> alwaysTheTripKeepsItsRules(namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> alwaysTheConnectionKeepsItsRules(namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> stepBackLeavesOneMode(m, "namePlace", namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> stepSavedPlacesAreKeptOnThePhone(m, "namePlace", namePlace(m, name).state, namePlace(m, name).out))
  ensures (inv(m) ==> canNamePlace(m, name) ==> stepOnlyThePlaceShownIsHandedOn(m, namePlace(m, name).state, namePlace(m, name).out))
  ensures (inv(m) ==> canNamePlace(m, name) ==> stepRoutesAreForThePlaceShown(m, namePlace(m, name).state, namePlace(m, name).out))
  ensures (inv(m) ==> canNamePlace(m, name) ==> stepScreenOffOnlyForThisJourney(m, namePlace(m, name).state, namePlace(m, name).out))
  ensures (inv(m) ==> canNamePlace(m, name) ==> stepGuidanceEndsOnlyWhenTold(m, "namePlace", namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> stepOnlyTheOwnerStartsGuidance(m, "namePlace", namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> stepAnotherAccountHidesTheLast(m, "namePlace", namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> stepSettingsOnlyAfterNo(m, namePlace(m, name).state, namePlace(m, name).out))
  ensures (inv(m) ==> canNamePlace(m, name) ==> stepReturnGoesToTheEventMapsCameFrom(m, namePlace(m, name).state, namePlace(m, name).out))
  ensures (inv(m) ==> canNamePlace(m, name) ==> stepEachReadIsSentOnce(m, namePlace(m, name).state, namePlace(m, name).out))
  ensures (inv(m) ==> canNamePlace(m, name) ==> stepAChangeVoidsTheQuestion(m, namePlace(m, name).state))
  ensures (inv(m) ==> canNamePlace(m, name) ==> stepNoPlaceToTheAgentWithoutApproval(m, "namePlace", namePlace(m, name).state, namePlace(m, name).out))
{
  if inv(m) && canNamePlace(m, name) {
    app__maps__places_lawNamingSavesOnce_ensures(m.saved, m.place, name);
  }
}

