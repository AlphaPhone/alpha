{
  if inv(m) && canLocationFix(m, session, fix) {
    if m.link.locator.Finder? {
      if m.directions {
        LocationFixFinderDirections(m, session, fix);
      } else {
        LocationFixFinderOther(m, session, fix);
      }
    } else {
      if app__maps__navigation_followFix(m.trip, m.trip.journey, fix).guidance.Arrived? {
        LocationFixGuideArrived(m, session, fix);
      } else {
        LocationFixGuideGoing(m, session, fix);
      }
    }
  }
}

