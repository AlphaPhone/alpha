lemma AnswerCoverageResent(m: Maps, ticket: int, ok: bool, covered: bool, google: bool, offer: app__maps__navigation_Offer)
  requires inv(m) && canAnswerCoverage(m, ticket, ok, covered, google, offer)
  requires m.waitingProvider && app__maps__connection_working(app__maps__connection_answerCoverage(m.link, ticket, ok, covered, google, offer)) && !app__maps__connection_holding(app__maps__connection_answerCoverage(m.link, ticket, ok, covered, google, offer)) && m.place == 0
