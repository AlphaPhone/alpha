{
  var r := locationFix(m, session, fix);
  StepArrivalFilter(m, "locationFix", r.state, r.out);
  app__maps__connection_takeFix_ensures(m.link, session);
  var link := app__maps__connection_takeFix(m.link, session);
  app__maps__navigation_followFix_ensures(m.trip, m.trip.journey, fix);
  app__maps__connection_stopLocating_ensures(link);
  if m.trip.away {
    OneTellArrival(r.out, 1);
  } else {
    NoTellArrival(r.out);
  }
}

