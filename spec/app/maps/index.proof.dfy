  ensures (inv(m) ==> canUseMyLocation(m) ==> stepSettingsOnlyAfterNo(m, useMyLocation(m).state, useMyLocation(m).out))
  ensures (inv(m) ==> canUseMyLocation(m) ==> stepReturnGoesToTheEventMapsCameFrom(m, useMyLocation(m).state, useMyLocation(m).out))
  ensures (inv(m) ==> canUseMyLocation(m) ==> stepTheRevisionChangesOnlyWithWhatIsShown(m, useMyLocation(m).state))
  ensures (inv(m) ==> canUseMyLocation(m) ==> stepTheAgentNeverMakesAndroidAsk(m, "useMyLocation", useMyLocation(m).state, useMyLocation(m).out))
  ensures (inv(m) ==> canUseMyLocation(m) ==> stepARerouteNeedsAFixThatGuides(m, "useMyLocation", useMyLocation(m).state))
  ensures (inv(m) ==> canUseMyLocation(m) ==> stepEachReadIsSentOnce(m, useMyLocation(m).state, useMyLocation(m).out))
  ensures (inv(m) ==> canUseMyLocation(m) ==> stepAChangeVoidsTheQuestion(m, useMyLocation(m).state))
  ensures (inv(m) ==> canUseMyLocation(m) ==> stepNoPlaceToTheAgentWithoutApproval(m, "useMyLocation", useMyLocation(m).state, useMyLocation(m).out))

{
  if inv(m) && canUseMyLocation(m) {
    if reusesTheFix(m) {
      UseMyLocationReuse(m);
    } else if kit__permission_allows(m.link.location) {
      UseMyLocationAllowed(m);
    } else {
      UseMyLocationNotAllowed(m);
    }
  }
}

