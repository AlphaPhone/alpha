  StepArrivalFilter(m, "goBack", r.state, r.out);
  NoTellArrival(r.out);
  var dropped := m.(question := Question.NoQuestion, review := kit__review_dismiss(m.review));
  app__maps__navigation_endGuidance_ensures(dropped.trip);
  if dropped.link.locator.Guide? {
    app__maps__connection_stopLocating_ensures(dropped.link);
  }
}

