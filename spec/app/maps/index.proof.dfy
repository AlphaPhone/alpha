  ensures (inv(m) ==> canGoBack(m) ==> stepNoPlaceToTheAgentWithoutApproval(m, "goBack", goBack(m).state, goBack(m).out))

{
  if inv(m) && canGoBack(m) {
    if !m.trip.guidance.Stopped? {
      GoBackGuiding(m);
    } else if m.renaming || choosingStart(m) {
      GoBackSimple(m);
    } else if ((((m.place != 0) && !(m.directions)) && (m.fromEvent > 0)) && !(m.searching)) && m.trip.guidance.Stopped? {
      GoBackFromEvent(m);
    } else if m.directions {
      GoBackDirections(m);
    } else {
      GoBackPlaceOrSearch(m);
    }
  }
}

