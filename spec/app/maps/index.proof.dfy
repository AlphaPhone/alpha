lemma StepArrivalFilter(before: Maps, via: string, after: Maps, out: seq<Effect>)
  ensures stepArrivalAwayIsToldOnce(before, via, after, out) == ((|ProofLib.Filter((e: Effect) => e.TellArrival?, out)| <= 1) && !((exists e :: e in out && !((if e.TellArrival? then ((((via == "locationFix") && before.trip.away) && after.trip.guidance.Arrived?) && (e.place == before.place)) else true)))))
{
}

lemma NoTellArrival(out: seq<Effect>)
  requires forall i :: 0 <= i < |out| ==> !out[i].TellArrival?
  ensures |ProofLib.Filter((e: Effect) => e.TellArrival?, out)| == 0
{
  ProofLib.FilterNone((e: Effect) => e.TellArrival?, out);
}

lemma OneTellArrival(out: seq<Effect>, i: int)
  requires 0 <= i < |out| && out[i].TellArrival?
  requires forall j :: 0 <= j < |out| && j != i ==> !out[j].TellArrival?
  ensures |ProofLib.Filter((e: Effect) => e.TellArrival?, out)| == 1
{
  ProofLib.FilterOne((e: Effect) => e.TellArrival?, out, i);
}

lemma RecentSearchesFilter(m: Maps)
  ensures alwaysRecentSearchesAreFiveAtMost(m) == (((|m.recent| <= 5) && !(("" in m.recent))) && !((exists q :: q in m.recent && !((|ProofLib.Filter((r: string) => (r == q), m.recent)| == 1)))))
{
}

lemma RememberedFilter(recent: seq<string>, query: string)
  ensures remembered(recent, query) == (var local_1 := ([query] + ProofLib.Filter((q: string) => (q != query), recent)); if (|local_1| > 5) then if ((0 <= 5) && (5 < |local_1|)) then (local_1[0..5] + local_1[(5 + 1)..]) else local_1 else local_1)
{
}

lemma FilterLenLeq(p: string -> bool, xs: seq<string>)
  ensures |ProofLib.Filter(p, xs)| <= |xs|
  decreases |xs|
{
  if |xs| == 0 {
    ProofLib.FilterNil(p, xs);
  } else {
    ProofLib.FilterCons(p, xs);
    FilterLenLeq(p, xs[1..]);
  }
}

lemma RememberedKeepsRecent(recent: seq<string>, query: string)
  requires query != ""
  requires |recent| <= 5 && !(("" in recent))
  requires !((exists q :: q in recent && !((|ProofLib.Filter((r: string) => (r == q), recent)| == 1))))
  ensures |remembered(recent, query)| <= 5
  ensures !(("" in remembered(recent, query)))
  ensures !((exists q :: q in remembered(recent, query) && !((|ProofLib.Filter((r: string) => (r == q), remembered(recent, query))| == 1))))
{
  RememberedFilter(recent, query);
  var id := (x: string) => x;
  assert ProofLib.DistinctBy(recent, id) by {
    forall i, j | 0 <= i < |recent| && 0 <= j < |recent| && i != j
      ensures id(recent[i]) != id(recent[j])
    {
      assert recent[i] in recent;
      assert |ProofLib.Filter((r: string) => (r == recent[i]), recent)| == 1;
      ProofLib.FilterCountOneIffUnique((r: string) => (r == recent[i]), recent, id, i);
    }
  }
  var neq := (q: string) => (q != query);
  var f := ProofLib.Filter(neq, recent);
  ProofLib.FilterKeepsDistinctBy(neq, recent, id);
  FilterLenLeq(neq, recent);
  forall x
    ensures x in f <==> x in recent && x != query
  {
    ProofLib.FilterMember(neq, recent, x);
  }
  var kept := [query] + f;
  assert ProofLib.Distinct(kept) by {
    forall i, j | 0 <= i < j < |kept|
      ensures kept[i] != kept[j]
    {
      if i == 0 {
        assert kept[j] == f[j - 1];
      } else {
        assert kept[i] == f[i - 1] && kept[j] == f[j - 1];
        assert id(f[i - 1]) != id(f[j - 1]);
      }
    }
  }
  var res := remembered(recent, query);
  if |kept| > 5 {
    assert |kept| == 6;
    assert kept[6..] == [];
    assert res == kept[0..5];
  } else {
    assert res == kept;
  }
  assert ProofLib.Distinct(res);
  assert !(("" in res));
  forall q | q in res
    ensures |ProofLib.Filter((r: string) => (r == q), res)| == 1
  {
    ProofLib.FilterDistinctCountOne((r: string) => (r == q), res, q);
  }
}

