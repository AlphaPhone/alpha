<?xml version='1.0' encoding='utf-8'?>
<resources>
    <!-- Hardware invocation belongs to the Cloud-first image too, independently of the
         optional offline listener. These are defaults; saved user settings remain authoritative. -->
    <string name="config_defaultAssistant" translatable="false">ai.alphacompute.alphaphone</string>
    <integer name="config_longPressOnPowerBehavior">5</integer>
    <bool name="config_longPressOnPowerForAssistantSettingAvailable">true</bool>
    <!-- Retain a hardware route to shutdown/restart while long-press opens Alpha. -->
    <integer name="config_keyChordPowerVolumeUp">2</integer>
    <color name="config_defaultNotificationColor">#FF0000FF</color>
    <integer name="config_defaultNightMode">2</integer>
    <!-- Three-button navigation (Back, Home, Recents) by default. Android's own navigation-mode
         overlays and dimensions apply; the owner can still choose gestures in Settings. -->
    <integer name="config_navBarInteractionMode">0</integer>
</resources>
